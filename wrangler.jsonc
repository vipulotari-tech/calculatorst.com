{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "calculatorst",
  "compatibility_date": "2026-08-27",
  "main": "./worker.js",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "404-page",
    "binding": "ASSETS"
  },
  "routes": [
    { "pattern": "calculatorst.com/*", "zone_name": "calculatorst.com" },
    { "pattern": "www.calculatorst.com/*", "zone_name": "calculatorst.com" }
  ],
  "observability": {
    "enabled": true
  }
}
