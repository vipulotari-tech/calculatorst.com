---
import "../styles/global.css";
import BackToTop from "../components/BackToTop.astro";
import CookieConsent from "../components/CookieConsent.astro";

interface Props {
  title?: string;
  description?: string;
  canonical?: string;
  noindex?: boolean;
  ogImage?: string;
  ogImageAlt?: string;
  datePublished?: string;
  dateModified?: string;
}

const {
  title = "Calculator Street — Free Construction & Home Improvement Calculators",
  description = "Free, fast, and accurate calculators for decking, roofing, gravel, concrete, fencing, pavers and mulch. Built for US homeowners and DIY pros — mobile-friendly, private, and offline-ready.",
  canonical: canonicalProp,
  noindex = false,
  ogImage: ogImageProp,
  ogImageAlt: ogImageAltProp,
  datePublished,
  dateModified,
} = Astro.props;

const site = Astro.site?.toString() ?? "https://calculatorst.com";
const siteNoSlash = site.replace(/\/$/, "");
const canonicalUrl = canonicalProp
  ? new URL(canonicalProp, site).href
  : new URL(Astro.url.pathname, site).href;

// OG image — per-page 1200×630 PNG for CTR; fallback to global og.png
const ogImage = new URL(ogImageProp ?? "/og.png", site).href;
const ogImageAlt = ogImageAltProp ?? "Calculator Street — Construction & Home Improvement Calculators";

const websiteSchema: any = {
  "@context": "https://schema.org",
  "@type": "WebSite",
  name: "Calculator Street",
  alternateName: "CalculatorSt.com",
  url: siteNoSlash + "/",
  description: description,
  inLanguage: "en-US",
  potentialAction: {
    "@type": "SearchAction",
    target: `${siteNoSlash}/calculators/?q={search_term_string}`,
    "query-input": "required name=search_term_string",
  },
};

const organizationSchema: any = {
  "@context": "https://schema.org",
  "@type": "Organization",
  name: "Calculator Street",
  url: siteNoSlash + "/",
  logo: new URL("/favicon.svg", site).href,
  sameAs: [
    "https://github.com/calculatorst",
    "https://x.com/calculatorst"
  ],
};

// WebPage schema for richer results + E-E-A-T dates
const webPageSchema: any = (!noindex && canonicalUrl) ? {
  "@context": "https://schema.org",
  "@type": "WebPage",
  name: title,
  description: description,
  url: canonicalUrl,
  isPartOf: { "@id": siteNoSlash + "/#website" },
  inLanguage: "en-US",
  ...(datePublished ? { datePublished } : {}),
  ...(dateModified ? { dateModified } : { dateModified: new Date().toISOString().split("T")[0] }),
  author: { "@type": "Person", name: "Vipul Otari", url: siteNoSlash + "/about/" },
  publisher: { "@type": "Organization", name: "Calculator Street", logo: { "@type": "ImageObject", url: new URL("/favicon.svg", site).href } },
  breadcrumb: { "@id": canonicalUrl + "#breadcrumb" },
} : null;
---

<!doctype html>
<html lang="en-US">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="color-scheme" content="light dark" />
    <meta name="theme-color" content="#fafafa" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#0a0a0a" media="(prefers-color-scheme: dark)" />
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    <meta name="generator" content={Astro.generator} />
    <link rel="canonical" href={canonicalUrl} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" sizes="32x32" />

    <!-- Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="preload"
      as="style"
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&family=JetBrains+Mono:wght@400&display=swap"
    />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&family=JetBrains+Mono:wght@400&display=swap"
    />

    <title>{title}</title>

    <!-- Google tag (gtag.js) -->
    <script is:inline async src="https://www.googletagmanager.com/gtag/js?id=G-7RX7TP3LKB"></script>
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      // EU User Consent — default denied until user accepts via banner
      gtag('consent', 'default', { ad_storage: 'denied', analytics_storage: 'denied', ad_user_data: 'denied', ad_personalization: 'denied', wait_for_update: 500 });
      gtag('js', new Date());
      gtag('config', 'G-7RX7TP3LKB');
    </script>

    <!-- Open Graph -->
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:alt" content={ogImageAlt} />
    <meta property="og:site_name" content="Calculator Street" />
    <meta property="og:locale" content="en_US" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <meta name="twitter:image:alt" content={ogImageAlt} />

    <!-- Structured Data: WebSite + Organization + WebPage -->
    <script type="application/ld+json" set:html={JSON.stringify(websiteSchema)} is:inline />
    <script type="application/ld+json" set:html={JSON.stringify(organizationSchema)} is:inline />
    {webPageSchema && <script type="application/ld+json" set:html={JSON.stringify(webPageSchema)} is:inline />}

    <!-- Theme — no FOUC -->
    <script is:inline>
      (function () {
        try {
          const stored = localStorage.getItem("theme");
          const prefersDark = window.matchMedia("(prefers-color-scheme: dark)").matches;
          const shouldDark = stored ? stored === "dark" : prefersDark;
          document.documentElement.classList.toggle("dark", shouldDark);
        } catch {}
      })();
    </script>
  </head>
  <body class="min-h-screen bg-canvas-soft text-ink antialiased selection:bg-primary selection:text-on-primary dark:bg-canvas-soft dark:text-ink">
    <a
      href="#main"
      class="sr-only focus:not-sr-only focus:fixed focus:left-4 focus:top-4 focus:z-[100] focus:rounded-sm focus:bg-primary focus:px-3 focus:py-2 focus:text-sm focus:font-medium focus:text-on-primary focus:outline-none focus-visible:ring-2 focus-visible:ring-link"
    >
      Skip to content
    </a>
    <slot />
    <BackToTop />
    <CookieConsent />

    <!-- Theme persistence helper -->
    <script is:inline>
      // Expose helper for toggle buttons
      window.__setTheme = function (mode) {
        try {
          localStorage.setItem("theme", mode);
          document.documentElement.classList.toggle("dark", mode === "dark");
        } catch {}
      };
      // Listen for system changes when no explicit preference
      try {
        const mq = window.matchMedia("(prefers-color-scheme: dark)");
        mq.addEventListener("change", (e) => {
          if (!localStorage.getItem("theme")) {
            document.documentElement.classList.toggle("dark", e.matches);
          }
        });
      } catch {}
    </script>
  </body>
</html>
