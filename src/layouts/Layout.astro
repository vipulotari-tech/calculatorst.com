---
import "../styles/global.css";
import BackToTop from "../components/BackToTop.astro";
import CookieConsent from "../components/CookieConsent.astro";

interface Props {
  title?: string;
  description?: string;
  canonical?: string;
  noindex?: boolean;
  ogImage?: string;
  ogImageAlt?: string;
  datePublished?: string;
  dateModified?: string;
}

const {
  title = "Calculator Street — Free Construction & Home Improvement Calculators",
  description = "Free, fast, and accurate calculators for decking, roofing, gravel, concrete, fencing, pavers and mulch. Built for US homeowners and DIY pros — mobile-friendly, private, and secure.",
  canonical: canonicalProp,
  noindex = false,
  ogImage: ogImageProp,
  ogImageAlt: ogImageAltProp,
  datePublished,
  dateModified,
} = Astro.props;

const site = Astro.site?.toString() ?? "https://calculatorst.com";
const siteNoSlash = site.replace(/\/$/, "");
const canonicalUrl = canonicalProp
  ? new URL(canonicalProp, site).href
  : new URL(Astro.url.pathname, site).href;

// Search result pages (?q=) are thin duplicates — noindex them so Google
// doesn't waste crawl budget, but still allow crawl (don't block via robots.txt).
// This prevents GSC "Blocked by robots.txt" for /calculators/?q=... while
// keeping them out of the index. Also handles junk template leakage like
// ?q=<JS template> which should never be indexed.
const hasSearchQuery = Astro.url.searchParams.has("q");
const isSearchResultPage = hasSearchQuery && (
  Astro.url.pathname === "/calculators/" ||
  Astro.url.pathname === "/calculators" ||
  Astro.url.pathname === "/"
);
const junkTemplatePattern = /\$\{|\%24\%7B|\%7Bencode/i;
const rawQ = Astro.url.searchParams.get("q") ?? "";
const isJunkQ = junkTemplatePattern.test(rawQ) || rawQ.includes("{search_term_string}");
const effectiveNoindex = noindex || isSearchResultPage || isJunkQ;

const ogImage = new URL(ogImageProp ?? "/og.png", site).href;
const ogImageAlt = ogImageAltProp ?? "Calculator Street — Construction & Home Improvement Calculators";

const websiteSchema: any = {
  "@context": "https://schema.org",
  "@type": "WebSite",
  "@id": siteNoSlash + "/#website",
  name: "Calculator Street",
  alternateName: "CalculatorSt.com",
  url: siteNoSlash + "/",
  description: description,
  inLanguage: "en-US",
  potentialAction: {
    "@type": "SearchAction",
    target: `${siteNoSlash}/calculators/?q={search_term_string}`,
    "query-input": "required name=search_term_string",
  },
};

const organizationSchema: any = {
  "@context": "https://schema.org",
  "@type": "Organization",
  name: "Calculator Street",
  url: siteNoSlash + "/",
  logo: new URL("/favicon.svg", site).href,
  sameAs: [
    "https://github.com/vipulotari-tech/calculatorst.com"
  ],
};

const webPageSchema: any = (!effectiveNoindex && canonicalUrl) ? {
  "@context": "https://schema.org",
  "@type": "WebPage",
  name: title,
  description: description,
  url: canonicalUrl,
  isPartOf: { "@id": siteNoSlash + "/#website" },
  inLanguage: "en-US",
  ...(datePublished ? { datePublished } : {}),
  ...(dateModified ? { dateModified } : {}),
  author: { "@type": "Person", name: "Vipul Otari", url: siteNoSlash + "/about/" },
  publisher: { "@type": "Organization", name: "Calculator Street", logo: { "@type": "ImageObject", url: new URL("/favicon.svg", site).href } },
} : null;
---

<!doctype html>
<html lang="en-US">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
        <meta name="description" content={description} />
    {effectiveNoindex && <meta name="robots" content="noindex, nofollow" />}
    <!-- Fallback for static prerender: search result pages (?q) are served as static HTML.
         This inline script ensures Googlebot sees noindex after JS execution even when
         the prerendered HTML didn't include it. Also cleans junk template leakage. -->
    <script is:inline>
      (function(){
        try {
          var url = new URL(window.location.href);
          var q = url.searchParams.get('q');
          var hasQ = url.searchParams.has('q');
          var isSearchPage = hasQ && (url.pathname === '/calculators/' || url.pathname === '/calculators' || url.pathname === '/');
          // Detect junk template leakage: ?q=<JS template> etc.
          var decodedQ = q ? (function(v){ try{ return decodeURIComponent(v); }catch(e){ return v; } })(q) : "";
          var isJunk = decodedQ && (decodedQ.indexOf('$' + '{') !== -1 || decodedQ.indexOf('encodeURIComponent') !== -1 || decodedQ.indexOf('{search_term_string}') !== -1);
          if (isJunk) {
            // Clean URL: remove junk q and replace history before Google indexes it
            url.searchParams.delete('q');
            history.replaceState(null, '', url.toString());
            hasQ = false; isSearchPage = false; q = null;
          }
          if ((hasQ && isSearchPage) || isJunk) {
            if (!document.querySelector('meta[name="robots"][content*="noindex"]')) {
              var m = document.createElement('meta');
              m.name = 'robots';
              m.content = 'noindex, nofollow';
              document.head.appendChild(m);
            }
            // Also ensure canonical points to clean URL (already set server-side via pathname)
          }
        } catch(e){}
      })();
    </script>
    <meta name="generator" content={Astro.generator} />
    <link rel="canonical" href={canonicalUrl} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" sizes="32x32" />

    <title>{title}</title>

    <!-- Google tag (gtag.js) with Google Consent Mode v2 -->
    <script is:inline async src="https://www.googletagmanager.com/gtag/js?id=G-7RX7TP3LKB"></script>
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      // Initialize with all storage denied by default for proper consent compliance
      gtag('consent', 'default', {
        ad_storage: 'denied',
        analytics_storage: 'denied',
        ad_user_data: 'denied',
        ad_personalization: 'denied'
      });
      // Restore consent on subsequent navigations BEFORE config sends page_view
      // This fixes the bug where returning users with accepted consent still sent denied page_views
      try {
        const saved = localStorage.getItem('cookieConsent');
        if (saved === 'accepted') {
          gtag('consent', 'update', {
            ad_storage: 'granted',
            analytics_storage: 'granted',
            ad_user_data: 'granted',
            ad_personalization: 'granted'
          });
        }
      } catch {}
      gtag('js', new Date());
      gtag('config', 'G-7RX7TP3LKB', {
        anonymize_ip: true,
        send_page_view: true
      });
    </script>

    <!-- Open Graph -->
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:alt" content={ogImageAlt} />
    <meta property="og:site_name" content="Calculator Street" />
    <meta property="og:locale" content="en_US" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <meta name="twitter:image:alt" content={ogImageAlt} />

    <!-- Structured Data -->
    <script type="application/ld+json" set:html={JSON.stringify(websiteSchema)} is:inline />
    <script type="application/ld+json" set:html={JSON.stringify(organizationSchema)} is:inline />
    {webPageSchema && <script type="application/ld+json" set:html={JSON.stringify(webPageSchema)} is:inline />}

      </head>
  <body class="min-h-screen bg-background text-foreground antialiased selection:bg-foreground selection:text-background">
    <a
      href="#main"
      class="sr-only focus:not-sr-only focus:fixed focus:left-4 focus:top-4 focus:z-[100] focus:rounded-lg focus:bg-foreground focus:px-3 focus:py-2 focus:text-sm focus:font-medium focus:text-background focus:outline-none focus-visible:ring-2 focus-visible:ring-ring"
    >
      Skip to content
    </a>
    <slot />
    <BackToTop />
    <CookieConsent />

  </body>
</html>
