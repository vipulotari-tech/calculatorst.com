---
---

<footer class="border-t border-hairline bg-canvas" aria-labelledby="footer-heading">
  <h2 id="footer-heading" class="sr-only">Footer</h2>
  <div class="mx-auto max-w-[1400px] px-6 py-12 sm:py-16 max-md:px-4">
    <div class="grid gap-10 sm:grid-cols-2 lg:grid-cols-[1.4fr_1fr_1fr_1fr]">
      <!-- Brand -->
      <div>
        <a href="/" class="inline-flex items-center gap-2.5 rounded-sm focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-link" aria-label="Calculator Street home">
          <span class="flex h-7 w-7 items-center justify-center overflow-hidden rounded-[6px] bg-[#0a0a0a] shadow-sm ring-1 ring-black/10" aria-hidden="true"><svg xmlns="http://www.w3.org/2000/svg" width="28" height="28" viewBox="0 0 32 32" class="h-7 w-7"><rect width="32" height="32" rx="8" fill="#0a0a0a"/><g transform="translate(6 6) rotate(-6 16 12)"><rect x="0" y="0" width="20" height="20" rx="3" fill="white"/><rect x="2.5" y="2.5" width="15" height="4.5" rx="1" fill="#dbeafe"/><g fill="#1f2937"><rect x="2.5" y="8.5" width="3.2" height="2.2" rx="0.6"/><rect x="6.7" y="8.5" width="3.2" height="2.2" rx="0.6"/><rect x="10.9" y="8.5" width="3.2" height="2.2" rx="0.6"/><rect x="2.5" y="11.3" width="3.2" height="2.2" rx="0.6"/><rect x="6.7" y="11.3" width="3.2" height="2.2" rx="0.6"/><rect x="10.9" y="11.3" width="3.2" height="2.2" rx="0.6"/><rect x="2.5" y="14.1" width="3.2" height="2.2" rx="0.6"/><rect x="6.7" y="14.1" width="3.2" height="2.2" rx="0.6"/><rect x="10.9" y="14.1" width="3.2" height="2.2" rx="0.6"/></g></g></svg></span>
          <span class="text-[15px] font-semibold tracking-[-0.02em] text-ink">Calculator Street</span>
        </a>
        <p class="mt-3 max-w-[320px] text-sm leading-5 text-body [text-wrap:pretty]">
          Free construction & home improvement calculators — fast, private and mobile-friendly. Built with Astro and Tailwind CSS v4.
        </p>
        <div class="mt-4 flex gap-2">
          <a href="#" class="inline-flex h-8 w-8 items-center justify-center rounded-sm border border-hairline bg-canvas text-mute transition-colors hover:bg-canvas-soft hover:text-ink focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-link" aria-label="GitHub">
            <svg width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true"><path d="M8 1.5a6.5 6.5 0 0 0-2.05 12.66c.32.06.44-.14.44-.31v-1.1C4.67 13.13 4.1 11.96 4.1 11.96c-.29-.74-.7-.94-.7-.94-.58-.39.04-.38.04-.38.64.04.98.66.98.66.57.97 1.5.69 1.86.53.06-.41.22-.69.4-.85-1.43-.16-2.93-.71-2.93-3.18 0-.7.25-1.27.66-1.72-.07-.16-.29-.81.06-1.69 0 0 .54-.17 1.77.66a6.1 6.1 0 0 1 3.22 0c1.23-.83 1.77-.66 1.77-.66.35.88.13 1.53.06 1.69.41.45.66 1.02.66 1.72 0 2.47-1.5 3.02-2.94 3.18.23.2.44.59.44 1.19v1.77c0 .17.11.37.44.31A6.5 6.5 0 0 0 8 1.5Z" fill="currentColor"></path></svg>
          </a>
          <a href="#" class="inline-flex h-8 w-8 items-center justify-center rounded-sm border border-hairline bg-canvas text-mute transition-colors hover:bg-canvas-soft hover:text-ink focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-link" aria-label="X (Twitter)">
            <svg width="14" height="14" viewBox="0 0 16 16" fill="none" aria-hidden="true"><path d="M12.5 3L4.2 12.5M12.5 12.5L4.2 3" stroke="currentColor" stroke-width="1.4" stroke-linecap="round"></path><path d="M8 3.2C8 3.2 6.5 5.5 5 8c1.5 2.5 3 4.8 3 4.8s1.5-2.3 3-4.8c-1.5-2.5-3-4.8-3-4.8Z" stroke="currentColor" stroke-width="1.1" stroke-linejoin="round"></path></svg>
          </a>
          <a href="mailto:hello@calculatorst.com" class="inline-flex h-8 w-8 items-center justify-center rounded-sm border border-hairline bg-canvas text-mute transition-colors hover:bg-canvas-soft hover:text-ink focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-link" aria-label="Email us">
            <svg width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true"><path d="M3 5.5l5 3 5-3M3 11.5h10a1 1 0 0 0 1-1V5a1 1 0 0 0-1-1H3a1 1 0 0 0-1 1v5.5a1 1 0 0 0 1 1Z" stroke="currentColor" stroke-width="1.25" stroke-linecap="round" stroke-linejoin="round"></path></svg>
          </a>
        </div>
      </div>

      <!-- Calculators -->
      <div>
        <h3 class="font-mono text-caption font-medium tracking-widest text-mute">CALCULATORS</h3>
        <ul class="mt-3 space-y-2 text-sm" role="list">
          <li><a href="/gravel-calculator/" class="text-body transition-colors hover:text-ink focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-link">Gravel Calculator</a></li>
          <li><a href="/concrete-slab-calculator/" class="text-body transition-colors hover:text-ink focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-link">Concrete Slab Calculator</a></li>
          <li><a href="/fence-cost-calculator/" class="text-body transition-colors hover:text-ink focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-link">Fence Cost Calculator</a></li>
          <li><a href="/deck-material-calculator/" class="text-body transition-colors hover:text-ink focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-link">Deck Material Calculator</a></li>
          <li><a href="/calculators/" class="text-body transition-colors hover:text-ink focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-link">View all →</a></li>
        </ul>
      </div>

      <!-- Resources -->
      <div>
        <h3 class="font-mono text-caption font-medium tracking-widest text-mute">CLUSTERS</h3>
        <ul class="mt-3 space-y-2 text-sm" role="list">
          <li><a href="/construction/gravel/" class="text-body transition-colors hover:text-ink focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-link">Gravel Calculators</a></li>
          <li><a href="/construction/concrete/" class="text-body transition-colors hover:text-ink focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-link">Concrete Calculators</a></li>
          <li><a href="/construction/roofing/" class="text-body transition-colors hover:text-ink focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-link">Roofing Calculators</a></li>
          <li><a href="/construction/landscaping/" class="text-body transition-colors hover:text-ink focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-link">Landscaping Calculators</a></li>
        </ul>
      </div>

      <!-- Company -->
      <div>
        <h3 class="font-mono text-caption font-medium tracking-widest text-mute">COMPANY</h3>
        <ul class="mt-3 space-y-2 text-sm" role="list">
          <li><a href="/about/" class="text-body transition-colors hover:text-ink focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-link">About</a></li>
          <li><a href="/contact/" class="text-body transition-colors hover:text-ink focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-link">Contact</a></li>
          <li><a href="/privacy/" class="text-body transition-colors hover:text-ink focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-link">Privacy</a></li>
          <li><a href="/terms/" class="text-body transition-colors hover:text-ink focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-link">Terms</a></li>
          <li><a href="/disclaimer/" class="text-body transition-colors hover:text-ink focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-link">Disclaimer</a></li>
        </ul>
      </div>
    </div>

    <div class="mt-10 flex flex-col gap-3 border-t border-hairline pt-6 sm:flex-row sm:items-center sm:justify-between">
      <p class="font-mono text-caption leading-4 text-mute">
        © 2026 Calculator Street. Built with Astro &amp; Tailwind CSS v4. No cookies. No trackers.
      </p>
      <p class="font-mono text-caption leading-4 text-mute">
        Crafted for speed · <span translate="no">calculatorst.com</span>
      </p>
    </div>
  </div>
</footer>
