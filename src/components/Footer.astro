---
import { hubCalculators, hubCategories } from "../data/hubCalculators";
const popular = [
  "fence-calculator",
  "concrete-calculator",
  "roof-pitch-calculator",
  "gravel-calculator",
  "deck-calculator",
].map(s => hubCalculators.find(c => c.slug === s)).filter(Boolean) as typeof hubCalculators;
---

<footer class="border-t border-border bg-background" aria-labelledby="footer-heading">
  <h2 id="footer-heading" class="sr-only">Footer</h2>
  <div class="mx-auto max-w-[1200px] px-4 sm:px-6 py-12 sm:py-16">
    <div class="grid gap-10 sm:grid-cols-2 lg:grid-cols-[1.4fr_1fr_1.2fr_1fr]">
      <div class="space-y-4">
        <a href="/" class="group inline-flex items-center gap-2.5 rounded-sm focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring" aria-label="Calculator Street home">
          <span class="flex h-7 w-7 items-center justify-center overflow-hidden rounded-lg bg-foreground shadow-sm" aria-hidden="true">
            <svg xmlns="http://www.w3.org/2000/svg" width="32" height="32" viewBox="0 0 32 32" class="h-7 w-7"><rect width="32" height="32" rx="8" fill="currentColor" class="text-foreground"/><g transform="translate(6 6) rotate(-6 16 12)"><rect x="0" y="0" width="20" height="20" rx="3" fill="currentColor" class="text-background"/><rect x="2.5" y="2.5" width="15" height="4.5" rx="1" fill="currentColor" class="text-primary/20"/><g fill="currentColor" class="text-foreground"><rect x="2.5" y="8.5" width="3.2" height="2.2" rx="0.6"/><rect x="6.7" y="8.5" width="3.2" height="2.2" rx="0.6"/><rect x="10.9" y="8.5" width="3.2" height="2.2" rx="0.6"/><rect x="2.5" y="11.3" width="3.2" height="2.2" rx="0.6"/><rect x="6.7" y="11.3" width="3.2" height="2.2" rx="0.6"/><rect x="10.9" y="11.3" width="3.2" height="2.2" rx="0.6"/><rect x="2.5" y="14.1" width="3.2" height="2.2" rx="0.6"/><rect x="6.7" y="14.1" width="3.2" height="2.2" rx="0.6"/><rect x="10.9" y="14.1" width="3.2" height="2.2" rx="0.6"/></g></g></svg>
          </span>
          <span class="text-[14px] font-semibold tracking-[-0.02em] text-foreground">Calculator Street</span>
          <span class="hidden sm:inline-flex items-center rounded-full border border-border bg-muted px-2 py-0.5 font-mono text-[10px] tracking-wide text-muted-foreground">EST. 2026</span>
        </a>
        <p class="max-w-[320px] text-[13px] leading-[22px] text-muted-foreground [text-wrap:pretty]">Free construction & home improvement calculators — fast, private and mobile-friendly.</p>
        <div class="inline-flex items-center gap-2 rounded-full border border-border bg-muted px-2.5 py-1"><span class="h-1.5 w-1.5 rounded-full bg-emerald-500"></span><span class="font-mono text-[11px] tracking-wide text-muted-foreground">Private by design</span></div>
        <div class="flex gap-2 pt-1">
          <a href="https://github.com/calculatorst" target="_blank" rel="noopener" class="inline-flex h-8 w-8 items-center justify-center rounded-lg border border-border bg-muted text-muted-foreground transition-colors hover:bg-foreground hover:text-background hover:border-foreground" aria-label="GitHub"><svg width="14" height="14" viewBox="0 0 16 16" fill="none" aria-hidden="true"><path d="M8 1.5a6.5 6.5 0 0 0-2.05 12.66c.32.06.44-.14.44-.31v-1.1C4.67 13.13 4.1 11.96 4.1 11.96c-.29-.74-.7-.94-.7-.94-.58-.39.04-.38.04-.38.64.04.98.66.98.66.57.97 1.5.69 1.86.53.06-.41.22-.69.4-.85-1.43-.16-2.93-.71-2.93-3.18 0-.7.25-1.27.66-1.72-.07-.16-.29-.81.06-1.69 0 0 .54-.17 1.77.66a6.1 6.1 0 0 1 3.22 0c1.23-.83 1.77-.66 1.77-.66.35.88.13 1.53.06 1.69.41.45.66 1.02.66 1.72 0 2.47-1.5 3.02-2.94 3.18.23.2.44.59.44 1.19v1.77c0 .17.11.37.44.31A6.5 6.5 0 0 0 8 1.5Z" fill="currentColor"/></svg></a>
          <a href="https://x.com/calculatorst" target="_blank" rel="noopener" class="inline-flex h-8 w-8 items-center justify-center rounded-lg border border-border bg-muted text-muted-foreground transition-colors hover:bg-foreground hover:text-background hover:border-foreground" aria-label="X"><svg width="12" height="12" viewBox="0 0 16 16" fill="none" aria-hidden="true"><path d="M12.5 3L4.2 12.5M12.5 12.5L4.2 3" stroke="currentColor" stroke-width="1.4" stroke-linecap="round"/></svg></a>
          <a href="mailto:hello@calculatorst.com" class="inline-flex h-8 w-8 items-center justify-center rounded-lg border border-border bg-muted text-muted-foreground transition-colors hover:bg-foreground hover:text-background hover:border-foreground" aria-label="Email"><svg width="14" height="14" viewBox="0 0 16 16" fill="none" aria-hidden="true"><path d="M3 5.5l5 3 5-3M3 11.5h10a1 1 0 0 0 1-1V5a1 1 0 0 0-1-1H3a1 1 0 0 0-1 1v5.5a1 1 0 0 0 1 1Z" stroke="currentColor" stroke-width="1.25" stroke-linecap="round" stroke-linejoin="round"/></svg></a>
        </div>
      </div>

      <div>
        <h3 class="flex items-center gap-2 font-mono text-[11px] font-medium tracking-[0.14em] uppercase text-muted-foreground"><span class="h-px w-6 bg-border"></span> Popular</h3>
        <ul class="mt-4 space-y-2.5 text-[13px]" role="list">
          {popular.map((c) => <li><a href={`/${c.slug}/`} class="text-muted-foreground transition-colors hover:text-foreground focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring">{c.h1}</a></li>)}
          <li><a href="/calculators/" class="inline-flex items-center gap-1 rounded-lg px-2.5 py-1 text-[12px] font-medium text-muted-foreground transition-colors hover:bg-muted hover:text-foreground">View all calculators →</a></li>
        </ul>
      </div>

      <div>
        <h3 class="flex items-center gap-2 font-mono text-[11px] font-medium tracking-[0.14em] uppercase text-muted-foreground"><span class="h-px w-6 bg-border"></span> Categories</h3>
        <ul class="mt-4 space-y-2 text-[13px]" role="list">
          {hubCategories.map((cat) => <li><a href={`/construction/${cat.slug}/`} class="text-muted-foreground transition-colors hover:text-foreground focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring">{cat.name} <span class="font-mono text-[11px] text-muted-foreground/60">({cat.count})</span></a></li>)}
          <li><a href="/construction/" class="inline-flex items-center gap-1 rounded-lg px-2.5 py-1 text-[12px] font-medium text-muted-foreground transition-colors hover:bg-muted hover:text-foreground">All categories →</a></li>
        </ul>
      </div>

      <div>
        <h3 class="flex items-center gap-2 font-mono text-[11px] font-medium tracking-[0.14em] uppercase text-muted-foreground"><span class="h-px w-6 bg-border"></span> Company</h3>
        <ul class="mt-4 space-y-2.5 text-[13px]" role="list">
          <li><a href="/about/" class="text-muted-foreground transition-colors hover:text-foreground">About</a></li>
          <li><a href="/contact/" class="text-muted-foreground transition-colors hover:text-foreground">Contact</a></li>
          <li><a href="/privacy/" class="text-muted-foreground transition-colors hover:text-foreground">Privacy</a></li>
          <li><a href="/terms/" class="text-muted-foreground transition-colors hover:text-foreground">Terms</a></li>
          <li><a href="/disclaimer/" class="text-muted-foreground transition-colors hover:text-foreground">Disclaimer</a></li>
          <li><a href="/sitemap.xml" class="text-muted-foreground transition-colors hover:text-foreground">Sitemap</a></li>
        </ul>
      </div>
    </div>
    <div class="mt-12 border-t border-border pt-8">
      <div class="flex flex-col items-center gap-5">
        <div class="flex items-center gap-3" aria-hidden="true"><span class="h-px w-10 bg-border sm:w-16"></span><span class="flex h-6 w-6 items-center justify-center rounded-full border border-border bg-muted text-[10px] text-muted-foreground">✦</span><span class="h-px w-10 bg-border sm:w-16"></span></div>
        <div class="text-center"><p class="font-mono text-[11px] tracking-[0.14em] uppercase text-muted-foreground">© 2026 Calculator Street</p><p class="mt-1.5 font-mono text-[11px] leading-5 text-muted-foreground">Built with <span class="font-medium text-foreground">Astro</span> & <span class="font-medium text-foreground">Tailwind CSS v4</span> <span class="mx-1.5 text-border">·</span> Private by design <span class="mx-1.5 text-border">·</span> <a href="/privacy/" class="underline underline-offset-2 decoration-border hover:decoration-foreground/40 transition-colors">Google may use cookies for ads</a></p></div>
        <p class="font-mono text-[10px] tracking-[0.12em] uppercase text-muted-foreground/50">Precision · Speed · Privacy</p>
      </div>
    </div>
  </div>
</footer>
