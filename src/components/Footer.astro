---
import { hubCalculators, hubCategories } from "../data/hubCalculators";
const popular = [
  "fence-calculator",
  "concrete-calculator",
  "roof-pitch-calculator",
  "gravel-calculator",
  "deck-calculator",
].map(s => hubCalculators.find(c => c.slug === s)).filter(Boolean) as typeof hubCalculators;
