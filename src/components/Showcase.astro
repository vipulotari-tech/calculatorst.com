---
---

<!-- Light band — why calculatorsT -->
<section id="guides" class="border-y border-hairline bg-canvas-soft" aria-labelledby="why-heading">
  <div class="mx-auto max-w-[1400px] px-6 py-16 sm:py-20 lg:py-24 max-md:px-4">
    <div class="grid gap-10 lg:grid-cols-2 lg:gap-12">
      <div>
        <p class="font-mono text-caption font-medium tracking-widest text-mute">WHY CALCULATORST</p>
        <h2 id="why-heading" class="mt-2 text-display-lg font-semibold tracking-[-0.04em] text-ink [text-wrap:balance]">
          Built like a developer tool. Simple like a utility.
        </h2>
        <p class="mt-3 max-w-[560px] text-body-md leading-6 text-body [text-wrap:pretty]">
          No ads, no trackers, no cookie banners. Every calculator is static, shareable, and
          instantaneous — modeled after Vercel’s crisp, minimal surface system.
        </p>

        <dl class="mt-8 grid gap-6 sm:grid-cols-2">
          <div class="rounded-md border border-hairline bg-canvas p-4 shadow-card">
            <dt class="flex items-center gap-2 text-sm font-semibold tracking-[-0.02em] text-ink">
              <span class="inline-flex h-6 w-6 items-center justify-center rounded-sm bg-canvas-soft ring-1 ring-hairline" aria-hidden="true">
                <svg width="12" height="12" viewBox="0 0 16 16" fill="none"><path d="M8 3.5v9M3.5 8h9" stroke="currentColor" stroke-width="1.3" stroke-linecap="round"></path></svg>
              </span>
              Instant answers
            </dt>
            <dd class="mt-1.5 text-sm leading-5 text-body">Calculations run on-device. Type and see results — no round-trip, no loading spinner.</dd>
          </div>
          <div class="rounded-md border border-hairline bg-canvas p-4 shadow-card">
            <dt class="flex items-center gap-2 text-sm font-semibold tracking-[-0.02em] text-ink">
              <span class="inline-flex h-6 w-6 items-center justify-center rounded-sm bg-canvas-soft ring-1 ring-hairline" aria-hidden="true">
                <svg width="12" height="12" viewBox="0 0 16 16" fill="none"><path d="M5 8l2 2 4-4" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"></path></svg>
              </span>
              Shareable links
            </dt>
            <dd class="mt-1.5 text-sm leading-5 text-body">Inputs encode in the URL. Copy, paste, and the recipient sees the same numbers.</dd>
          </div>
          <div class="rounded-md border border-hairline bg-canvas p-4 shadow-card">
            <dt class="flex items-center gap-2 text-sm font-semibold tracking-[-0.02em] text-ink">
              <span class="inline-flex h-6 w-6 items-center justify-center rounded-sm bg-canvas-soft ring-1 ring-hairline" aria-hidden="true">
                <svg width="12" height="12" viewBox="0 0 16 16" fill="none"><path d="M8 3a3 3 0 0 0-3 3c0 2 3 4.5 3 4.5S11 8 11 6a3 3 0 0 0-3-3Z" stroke="currentColor" stroke-width="1.2"></path></svg>
              </span>
              Private by default
            </dt>
            <dd class="mt-1.5 text-sm leading-5 text-body">Nothing leaves your browser. No accounts, no tracking — just math.</dd>
          </div>
          <div class="rounded-md border border-hairline bg-canvas p-4 shadow-card">
            <dt class="flex items-center gap-2 text-sm font-semibold tracking-[-0.02em] text-ink">
              <span class="inline-flex h-6 w-6 items-center justify-center rounded-sm bg-canvas-soft ring-1 ring-hairline" aria-hidden="true">
                <svg width="12" height="12" viewBox="0 0 16 16" fill="none"><path d="M3 8h10M8 3v10" stroke="currentColor" stroke-width="1.3" stroke-linecap="round"></path></svg>
              </span>
              Keyboard first
            </dt>
            <dd class="mt-1.5 text-sm leading-5 text-body">Full keyboard support, focus rings, and <span translate="no">⌘&nbsp;K</span> everywhere.</dd>
          </div>
        </dl>
      </div>

      <!-- Right: minimal comparison table — ex-data-table-cell style -->
      <div class="rounded-lg border border-hairline bg-canvas p-6 shadow-float sm:p-7">
        <div class="flex items-center justify-between">
          <h3 class="text-display-sm font-semibold tracking-[-0.03em] text-ink">At a glance</h3>
          <span class="rounded-full bg-canvas-soft px-2.5 py-1 font-mono text-[11px] tracking-wide text-mute ring-1 ring-hairline">Updated weekly</span>
        </div>

        <div class="mt-6 overflow-hidden rounded-md border border-hairline">
          <table class="w-full text-left">
            <thead class="bg-canvas-soft">
              <tr class="border-b border-hairline">
                <th scope="col" class="px-3 py-2.5 font-mono text-[11px] font-medium tracking-widest text-mute">FEATURE</th>
                <th scope="col" class="px-3 py-2.5 font-mono text-[11px] font-medium tracking-widest text-mute">CALCULATORST</th>
                <th scope="col" class="px-3 py-2.5 font-mono text-[11px] font-medium tracking-widest text-mute">TYPICAL</th>
              </tr>
            </thead>
            <tbody class="divide-y divide-hairline bg-canvas text-sm">
              <tr>
                <td class="px-3 py-2.5 font-medium text-ink">Load time</td>
                <td class="px-3 py-2.5 tabular-nums text-body">&lt;100 ms</td>
                <td class="px-3 py-2.5 tabular-nums text-mute">1–3 s</td>
              </tr>
              <tr>
                <td class="px-3 py-2.5 font-medium text-ink">Ads / trackers</td>
                <td class="px-3 py-2.5 text-body">None</td>
                <td class="px-3 py-2.5 text-mute">Heavy</td>
              </tr>
              <tr>
                <td class="px-3 py-2.5 font-medium text-ink">Offline</td>
                <td class="px-3 py-2.5 text-body">Yes</td>
                <td class="px-3 py-2.5 text-mute">Rarely</td>
              </tr>
              <tr>
                <td class="px-3 py-2.5 font-medium text-ink">Shareable URL</td>
                <td class="px-3 py-2.5 text-body">Yes</td>
                <td class="px-3 py-2.5 text-mute">Often not</td>
              </tr>
            </tbody>
          </table>
        </div>

        <div class="mt-4 rounded-sm border border-hairline bg-canvas-soft-2 p-3">
          <p class="font-mono text-caption leading-4 text-body">
            <span class="font-medium text-ink">Tip:</span> Bookmark any result — the URL restores every field.
          </p>
        </div>

        <div class="mt-5 flex gap-2">
          <a href="#calculators" class="inline-flex flex-1 items-center justify-center rounded-pill bg-primary px-4 py-2.5 text-sm font-medium text-on-primary hover:bg-[#242424] focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-link">Try a calculator</a>
          <a href="#about" class="inline-flex items-center justify-center rounded-pill border border-hairline bg-canvas px-4 py-2.5 text-sm font-medium text-ink hover:bg-canvas-soft focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-link">How we build</a>
        </div>
      </div>
    </div>
  </div>
</section>

<!-- Dark band — polarity-flipped -->
<section id="about" class="bg-primary text-on-primary" aria-labelledby="dark-heading">
  <div class="mx-auto max-w-[1400px] px-6 py-16 sm:py-20 lg:py-24 max-md:px-4">
    <div class="grid gap-10 lg:grid-cols-[1.05fr_0.95fr] lg:gap-12">
      <div>
        <p class="font-mono text-caption font-medium tracking-widest text-white/50">ABOUT THE STACK</p>
        <h2 id="dark-heading" class="mt-2 text-display-lg font-semibold tracking-[-0.04em] text-white [text-wrap:balance]">
          Static-first. No bloat. No dark patterns.
        </h2>
        <p class="mt-3 max-w-[560px] text-body-md leading-6 text-white/70 [text-wrap:pretty]">
          Built with Astro’s island-free defaults and Tailwind CSS v4 — minimal JavaScript, excellent Core Web Vitals, and a calm, ink-on-white aesthetic inspired by Vercel.
        </p>

        <ul class="mt-8 space-y-3 font-mono text-sm leading-5 text-white/70" role="list">
          <li class="flex gap-3">
            <span class="mt-1 h-1.5 w-1.5 shrink-0 rounded-full bg-cyan" aria-hidden="true"></span>
            <span><span class="font-medium text-white">Zero client JS</span> for calculators — pure HTML + instant on-input math.</span>
          </li>
          <li class="flex gap-3">
            <span class="mt-1 h-1.5 w-1.5 shrink-0 rounded-full bg-violet" aria-hidden="true"></span>
            <span><span class="font-medium text-white">Tailwind v4</span> via <span translate="no">@tailwindcss/vite</span> — <span translate="no">@import &quot;tailwindcss&quot;</span> + <span translate="no">@theme</span> tokens only.</span>
          </li>
          <li class="flex gap-3">
            <span class="mt-1 h-1.5 w-1.5 shrink-0 rounded-full bg-highlight-pink" aria-hidden="true"></span>
            <span><span class="font-medium text-white">Accessible by default</span> — semantic HTML, keyboard, focus-visible, and soft contrast.</span>
          </li>
        </ul>

        <div class="mt-8 flex flex-wrap gap-3">
          <a href="#calculators" class="inline-flex items-center justify-center rounded-pill bg-canvas px-5 py-2.5 text-sm font-medium text-primary hover:bg-white focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-white">Start calculating</a>
          <a href="#" class="inline-flex items-center justify-center rounded-pill border border-white/15 bg-white/5 px-5 py-2.5 text-sm font-medium text-white hover:bg-white/10 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-white">Read design notes</a>
        </div>
      </div>

      <!-- Code mockup — dark band echo -->
      <div class="rounded-lg border border-white/10 bg-white/[0.06] p-5 sm:p-6 shadow-modal">
        <div class="flex items-center justify-between">
          <span class="font-mono text-[11px] tracking-widest text-white/40">STACK</span>
          <span class="font-mono text-[11px] text-white/30">Astro 7 · Tailwind 4</span>
        </div>
        <pre class="mt-4 overflow-x-auto rounded-md border border-white/10 bg-primary p-4 font-mono text-code leading-5 text-white/90"><code><span class="text-white/40">// astro.config.mjs — minimal</span>
import tailwindcss from "<span class="text-cyan">@tailwindcss/vite</span>";

export default defineConfig(&#123;
  vite: &#123; plugins: [tailwindcss()] &#125;
&#125;);

<span class="text-white/40">/* global.css — Tailwind v4 */</span>
@import "<span class="text-cyan">tailwindcss</span>";
@theme &#123;
  --color-primary: <span class="text-highlight-pink">#171717</span>;
  --color-canvas-soft: <span class="text-cyan">#fafafa</span>;
  --font-sans: <span class="text-violet">Inter</span>, system-ui;
&#125;</code></pre>
        <p class="mt-3 font-mono text-caption leading-4 text-white/40">
          No extra dependencies. No client islands. Just Astro + Tailwind and crisp, semantic HTML.
        </p>
      </div>
    </div>
  </div>
</section>

<!-- Logo strip — minimal social proof -->
<section class="border-y border-hairline bg-canvas" aria-label="Trusted by">
  <div class="mx-auto max-w-[1400px] px-6 py-6 max-md:px-4">
    <div class="flex flex-wrap items-center justify-between gap-4">
      <p class="font-mono text-caption tracking-wide text-mute">Trusted for quick checks — no signup, no spam.</p>
      <div class="flex flex-wrap items-center gap-x-6 gap-y-2 font-mono text-caption tracking-widest text-mute" aria-hidden="true">
        <span>★ 4.9/5</span>
        <span class="h-3 w-px bg-hairline" aria-hidden="true"></span>
        <span>12K weekly users</span>
        <span class="h-3 w-px bg-hairline" aria-hidden="true"></span>
        <span>&lt;100 ms</span>
      </div>
    </div>
  </div>
</section>
