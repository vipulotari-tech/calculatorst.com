---
import Layout from "../layouts/Layout.astro";
import Breadcrumbs from "./Breadcrumbs.astro";
import RelatedCalculators from "./RelatedCalculators.astro";
import FAQ from "./FAQ.astro";
import AdPlaceholder from "./AdPlaceholder.astro";

interface BreadcrumbItem {
  label: string;
  href?: string;
}
interface Related {
  title: string;
  href: string;
  desc?: string;
}
interface QA {
  q: string;
  a: string;
}
interface Props {
  title: string;
  description: string;
  h1: string;
  intro: string;
  breadcrumbs: BreadcrumbItem[];
  related?: Related[];
  faq?: QA[];
  canonical?: string;
  ogImage?: string;
  datePublished?: string;
  dateModified?: string;
  noindex?: boolean;
}

const { title, description, h1, intro, breadcrumbs, related = [], faq = [], canonical, ogImage, datePublished, dateModified, noindex } = Astro.props;

const site = Astro.site?.toString() ?? "https://calculatorst.com";
const siteNoSlash = site.replace(/\/$/, "");
const canonicalUrl = canonical ? new URL(canonical, site).href : new URL(Astro.url.pathname, site).href;

const softwareSchema: any = {
  "@context": "https://schema.org",
  "@type": "SoftwareApplication",
  name: h1,
  description: description,
  applicationCategory: "UtilitiesApplication",
  applicationSubCategory: "Calculator",
  operatingSystem: "Web",
  isAccessibleForFree: true,
  offers: { "@type": "Offer", price: "0", priceCurrency: "USD" },
  url: canonicalUrl,
  author: { "@type": "Person", name: "Vipul Otari", url: siteNoSlash + "/author/vipul-otari/" },
  publisher: { "@type": "Organization", name: "Calculator Street", logo: { "@type": "ImageObject", url: new URL("/favicon.svg", site).href } },
  featureList: "Free in-browser calculation with input and result explanations",
};



---

<Layout title={title} description={description} canonical={canonical} ogImage={ogImage} datePublished={datePublished} dateModified={dateModified} noindex={noindex}>
  <slot name="header" />
  <main id="main" tabindex="-1" class="w-full">
    <div class="mx-auto max-w-[1200px] px-4 sm:px-6 py-4">
      <Breadcrumbs items={breadcrumbs} />
    </div>

    <section class="mx-auto max-w-[1200px] px-4 sm:px-6 pb-8">
      <div class="mx-auto max-w-[820px]">
        <h1 class="text-display-lg font-semibold tracking-[-0.04em] text-foreground [text-wrap:balance] sm:text-display-xl sm:tracking-[-0.05em]">
          {h1}
        </h1>
        <p class="mt-3 max-w-[680px] text-body-md leading-6 text-muted-foreground [text-wrap:pretty]">{intro}</p>
      </div>

      <div class="mx-auto mt-8 max-w-[820px]">
        <slot name="calculator" />
      </div>

      <div class="mx-auto mt-6 max-w-[820px]">
        <AdPlaceholder label="Advertisement — after results" height="h-[120px]" />
      </div>

      <div class="mx-auto mt-10 max-w-[820px] space-y-12">
        <slot />

        {related.length > 0 && <RelatedCalculators calculators={related} />}

        {faq.length > 0 && <FAQ items={faq} />}

        <script type="application/ld+json" set:html={JSON.stringify(softwareSchema)} is:inline />

        <!-- Author attribution (factual, not verified claims) -->
        <div class="rounded-xl border border-border bg-card p-5">
          <div class="flex items-start gap-3">
            <span class="flex h-10 w-10 shrink-0 items-center justify-center rounded-full bg-foreground text-background text-sm font-semibold" aria-hidden="true">VO</span>
            <div class="min-w-0 flex-1">
              <p class="text-sm font-medium text-foreground">
                Written by <a href="/author/vipul-otari/" class="underline underline-offset-2 decoration-border hover:decoration-foreground/40">Vipul Otari</a>
                <span class="font-normal text-muted-foreground">· Author</span>
              </p>
              <p class="mt-1 text-xs leading-5 text-muted-foreground">
                Formulas and examples are documented on this page with cited sources. Every calculation runs 100% in your browser — no data is sent to any server. {dateModified ? `Last updated: ${dateModified}.` : ''} See <a href="/about/" class="underline text-foreground">how this site is built</a>.
              </p>
            </div>
          </div>
        </div>

        <div class="rounded-xl border border-border bg-card p-5">
          <p class="font-mono text-[11px] font-medium tracking-[0.1em] uppercase text-muted-foreground">About Calculator Street</p>
          <p class="mt-2 text-[13px] leading-5 text-muted-foreground [text-wrap:pretty]">
            Built by <a href="/author/vipul-otari/" class="font-medium text-foreground underline underline-offset-2 decoration-border hover:decoration-foreground/40 transition-colors">Vipul Otari</a> for US homeowners &amp; contractors. Calculator inputs are processed in your browser. Estimates depend on your measurements, product specifications and the assumptions shown on this page. Confirm order quantities with your supplier and structural requirements with your project designer. {dateModified && `Page updated: ${dateModified}.`}
          </p>
          <div class="mt-3 flex flex-wrap gap-2 font-mono text-[11px] text-muted-foreground">
            <span>Free</span><span class="text-border">·</span><span>In-browser</span><span class="text-border">·</span><span>Mobile-friendly</span><span class="text-border">·</span><span>Formula shown</span>
          </div>
        </div>
      </div>
    </section>
  </main>
  <slot name="footer" />
</Layout>

<script>
  import { initLegacyValidation } from '../lib/legacy-validation';
  initLegacyValidation();
  document.addEventListener('astro:page-load', initLegacyValidation);
</script>
