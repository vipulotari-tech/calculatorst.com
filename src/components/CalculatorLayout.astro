---
import Layout from "../layouts/Layout.astro";
import Breadcrumbs from "./Breadcrumbs.astro";
import RelatedCalculators from "./RelatedCalculators.astro";
import FAQ from "./FAQ.astro";
import AdPlaceholder from "./AdPlaceholder.astro";

interface BreadcrumbItem {
  label: string;
  href?: string;
}
interface Related {
  title: string;
  href: string;
  desc?: string;
}
interface QA {
  q: string;
  a: string;
}
interface Props {
  title: string;
  description: string;
  h1: string;
  intro: string;
  breadcrumbs: BreadcrumbItem[];
  related?: Related[];
  faq?: QA[];
  canonical?: string;
  ogImage?: string;
  datePublished?: string;
  dateModified?: string;
}

const { title, description, h1, intro, breadcrumbs, related = [], faq = [], canonical, ogImage, datePublished, dateModified } = Astro.props;

const site = Astro.site?.toString() ?? "https://calculatorst.com";
const siteNoSlash = site.replace(/\/$/, "");
const canonicalUrl = canonical ? new URL(canonical, site).href : new URL(Astro.url.pathname, site).href;

// SoftwareApplication + HowTo + ItemList support via JSON-LD injection in page
const softwareSchema: any = {
  "@context": "https://schema.org",
  "@type": "SoftwareApplication",
  name: h1,
  description: description,
  applicationCategory: "UtilitiesApplication",
  applicationSubCategory: "Calculator",
  operatingSystem: "Web",
  isAccessibleForFree: true,
  offers: { "@type": "Offer", price: "0", priceCurrency: "USD" },
  url: canonicalUrl,
  author: { "@type": "Organization", name: "Calculator Street", url: siteNoSlash + "/" },
  publisher: { "@type": "Organization", name: "Calculator Street", logo: { "@type": "ImageObject", url: new URL("/favicon.svg", site).href } },
  featureList: "US customary + metric units, waste & cost, in-browser calculation, no data leaving device",
};

// HowTo schema for "How it works" steps — helps E-E-A-T and rich results
const howToSchema: any = {
  "@context": "https://schema.org",
  "@type": "HowTo",
  name: `How to use the ${h1}`,
  description: intro,
  step: [
    { "@type": "HowToStep", name: "Measure area", text: "Measure length, width and depth of your project area in feet or inches." },
    { "@type": "HowToStep", name: "Enter inputs", text: `Enter dimensions into the ${h1} and choose material/unit.` },
    { "@type": "HowToStep", name: "Add waste & price", text: "Add waste percentage (5-10% rectangle, 10-15% complex) and optional price per unit." },
    { "@type": "HowToStep", name: "Get results", text: "Read volume, weight and cost instantly and copy/share results." },
  ],
  totalTime: "PT2M",
  tool: { "@type": "HowToTool", name: h1 },
};
---

<Layout title={title} description={description} canonical={canonical} ogImage={ogImage} datePublished={datePublished} dateModified={dateModified}>
  <slot name="header" />
  <main id="main" tabindex="-1" class="w-full">
    <!-- Top breadcrumb -->
    <div class="mx-auto max-w-[1400px] px-6 py-4 max-md:px-4">
      <Breadcrumbs items={breadcrumbs} />
    </div>

    <!-- H1 + intro + calculator -->
    <section class="mx-auto max-w-[1400px] px-6 pb-8 max-md:px-4">
      <div class="mx-auto max-w-[900px]">
        <h1 class="text-display-lg font-semibold tracking-[-0.04em] text-ink [text-wrap:balance] sm:text-display-xl sm:tracking-[-0.05em]">
          {h1}
        </h1>
        <p class="mt-3 max-w-[720px] text-body-md leading-6 text-body [text-wrap:pretty]">{intro}</p>
      </div>

      <!-- Calculator slot — visually prominent, above fold -->
      <div class="mx-auto mt-8 max-w-[900px]">
        <slot name="calculator" />
      </div>

      <!-- Ad placeholder after results -->
      <div class="mx-auto mt-6 max-w-[900px]">
        <AdPlaceholder label="Advertisement — after results" height="h-[120px]" />
      </div>

      <!-- Supporting content -->
      <div class="mx-auto mt-10 max-w-[900px] space-y-12">
        <slot />

        {related.length > 0 && <RelatedCalculators calculators={related} />}

        {faq.length > 0 && <FAQ items={faq} />}

        <script type="application/ld+json" set:html={JSON.stringify(softwareSchema)} is:inline />
        <script type="application/ld+json" set:html={JSON.stringify(howToSchema)} is:inline />

        <div class="rounded-lg border border-hairline bg-canvas p-6 dark:bg-canvas">
          <p class="font-mono text-caption font-medium tracking-widest text-mute">ABOUT CALCULATOR STREET</p>
          <p class="mt-2 text-sm leading-6 text-body [text-wrap:pretty]">
            Built by <a href="/about/" class="font-medium text-ink underline hover:text-link">Vipul Otari</a> for US homeowners &amp; contractors. Every tool runs 100% in your browser — no backend, no tracking, no data leaving your device. Verified against <a href="https://www.txdot.gov/manuals/brg/offpeo5.html" target="_blank" rel="noopener" class="text-link underline hover:text-link-deep">TxDOT</a> &amp; <a href="https://www.cpsc.gov/safety-education/safety-guides/playgrounds" target="_blank" rel="noopener" class="text-link underline hover:text-link-deep">CPSC</a> specs. Last updated: {dateModified ?? "2026-08-28"}.
          </p>
          <div class="mt-3 flex flex-wrap gap-2 font-mono text-[11px] text-mute">
            <span>Free</span><span class="text-hairline">·</span><span>Fast</span><span class="text-hairline">·</span><span>Mobile-friendly</span><span class="text-hairline">·</span><span>US units</span><span class="text-hairline">·</span><span>Reviewed</span>
          </div>
        </div>
      </div>
    </section>
  </main>
  <slot name="footer" />
</Layout>
