---
---

<section
  class="relative isolate overflow-hidden border-b border-hairline bg-canvas"
  aria-labelledby="hero-heading"
>
  <!-- Mesh gradient — hero atmospheric backdrop (hero scale only, never icon scale) -->
  <div class="pointer-events-none absolute inset-0 mesh-gradient opacity-[0.9]" aria-hidden="true"></div>
  <!-- Subtle grid hairline overlay -->
  <div
    class="pointer-events-none absolute inset-0 opacity-[0.04]"
    style="background-image: linear-gradient(#171717 1px, transparent 1px), linear-gradient(90deg, #171717 1px, transparent 1px); background-size: 32px 32px;"
    aria-hidden="true"
  >
  </div>

  <div class="relative mx-auto max-w-[1400px] px-6 py-16 sm:py-20 lg:px-6 lg:py-24 max-md:px-4">
    <!-- Eyebrow badge — banner-marketing -->
    <div class="mb-6 flex justify-center">
      <a
        href="#calculators"
        class="inline-flex items-center gap-2 rounded-full border border-hairline bg-canvas-soft px-3 py-1 text-sm text-body shadow-card transition-colors hover:bg-canvas hover:shadow-card-hover focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-link"
      >
        <span class="inline-flex items-center gap-1.5">
          <span class="h-2 w-2 animate-pulse rounded-full bg-success" aria-hidden="true"></span>
          <span class="font-mono text-[11px] font-medium tracking-wide text-body">NEW</span>
        </span>
        <span class="hidden h-3 w-px bg-hairline sm:block" aria-hidden="true"></span>
        <span class="text-sm">12 new calculators added this month…</span>
        <svg
          width="14"
          height="14"
          viewBox="0 0 16 16"
          fill="none"
          aria-hidden="true"
          class="text-mute"
        >
          <path d="M6 3l5 5-5 5" stroke="currentColor" stroke-width="1.3" stroke-linecap="round"
          ></path>
        </svg>
      </a>
    </div>

    <!-- Headline + lead — display-xl, sentence-case period-terminated -->
    <div class="mx-auto max-w-[720px] text-center">
      <h1
        id="hero-heading"
        class="text-display-xl font-semibold tracking-[-0.05em] text-ink [text-wrap:balance]"
      >
        Fast, accurate calculators for everything.
      </h1>
      <p class="mx-auto mt-4 max-w-[560px] text-body-lg leading-7 text-body [text-wrap:pretty]">
        A minimal, privacy-friendly collection — finance, health, math &amp; conversions. No ads, no
        tracking, just instant answers.
      </p>

      <!-- CTA row — pill 100px marketing scale -->
      <div class="mt-8 flex flex-col items-center justify-center gap-3 sm:flex-row">
        <a
          href="#calculators"
          class="inline-flex h-11 items-center justify-center gap-1.5 rounded-pill bg-primary px-6 text-sm font-medium text-on-primary shadow-card transition duration-200 hover:bg-[#242424] hover:shadow-float focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-link focus-visible:ring-offset-2 focus-visible:ring-offset-canvas"
        >
          Explore calculators
          <svg width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true">
            <path d="M6 3l5 5-5 5" stroke="currentColor" stroke-width="1.4" stroke-linecap="round"
            ></path>
          </svg>
        </a>
        <a
          href="#categories"
          class="inline-flex h-11 items-center justify-center rounded-pill border border-hairline bg-canvas px-6 text-sm font-medium text-ink shadow-card transition duration-200 hover:bg-canvas-soft hover:shadow-card-hover focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-link focus-visible:ring-offset-2 focus-visible:ring-offset-canvas"
        >
          <svg width="14" height="14" viewBox="0 0 16 16" fill="none" aria-hidden="true">
            <path
              d="M2 5h12M2 8h12M2 11h12"
              stroke="currentColor"
              stroke-width="1.3"
              stroke-linecap="round"></path>
          </svg>
          Browse categories
        </a>
      </div>

      <!-- Trust microcopy — caption-mono -->
      <p class="mt-4 font-mono text-caption tracking-wide text-mute">
        Free &middot; No sign-up &middot; Works offline &middot; <span translate="no">GDPR</span> friendly
      </p>
    </div>

    <!-- Code editor mockup — proof of aesthetic (pricing-card chrome reference) -->
    <div class="mx-auto mt-12 max-w-[920px] sm:mt-16">
      <div
        class="overflow-hidden rounded-lg border border-hairline bg-primary shadow-float"
        role="region"
        aria-label="Example calculation preview"
      >
        <!-- window chrome -->
        <div class="flex items-center justify-between border-b border-white/10 bg-primary px-4 py-2.5">
          <div class="flex items-center gap-1.5" aria-hidden="true">
            <span class="h-3 w-3 rounded-full bg-white/15"></span>
            <span class="h-3 w-3 rounded-full bg-white/15"></span>
            <span class="h-3 w-3 rounded-full bg-white/15"></span>
          </div>
          <span class="font-mono text-[11px] tracking-wide text-white/60">mortgage — live</span>
          <span class="hidden font-mono text-[11px] text-white/40 sm:inline">⌘&nbsp;K to search</span>
        </div>

        <div class="grid gap-0 md:grid-cols-[1.15fr_0.85fr]">
          <!-- Left: inputs -->
          <div class="border-white/10 p-5 sm:p-6 md:border-r">
            <p class="font-mono text-[11px] tracking-widest text-white/40">INPUTS</p>
            <div class="mt-4 grid gap-3.5">
              <!-- Use real form controls for a11y though static mock -->
              <label class="block">
                <span class="font-mono text-xs text-white/60">Loan amount</span>
                <div
                  class="mt-1.5 flex items-center gap-2 rounded-sm border border-white/10 bg-white/[0.06] px-3 py-2.5"
                >
                  <span class="font-mono text-xs text-white/40">$</span>
                  <span class="tabular-nums font-mono text-sm text-white">425,000</span>
                  <span class="ml-auto font-mono text-[11px] text-white/30">USD</span>
                </div>
              </label>
              <div class="grid grid-cols-2 gap-3">
                <label class="block">
                  <span class="font-mono text-xs text-white/60">Interest</span>
                  <div
                    class="mt-1.5 flex items-center gap-2 rounded-sm border border-white/10 bg-white/[0.06] px-3 py-2.5"
                  >
                    <span class="font-mono text-sm tabular-nums text-white">6.5</span>
                    <span class="font-mono text-xs text-white/40">%</span>
                  </div>
                </label>
                <label class="block">
                  <span class="font-mono text-xs text-white/60">Term</span>
                  <div
                    class="mt-1.5 flex items-center gap-2 rounded-sm border border-white/10 bg-white/[0.06] px-3 py-2.5"
                  >
                    <span class="font-mono text-sm tabular-nums text-white">30</span>
                    <span class="font-mono text-xs text-white/40">years</span>
                  </div>
                </label>
              </div>
              <div class="mt-1 flex items-center gap-2 font-mono text-[11px] text-white/50">
                <span class="h-1.5 w-1.5 rounded-full bg-cyan" aria-hidden="true"></span>
                Updated instantly — no page reload.
              </div>
            </div>
          </div>

          <!-- Right: result -->
          <div class="bg-white/[0.03] p-5 sm:p-6">
            <p class="font-mono text-[11px] tracking-widest text-white/40">MONTHLY PAYMENT</p>
            <p class="mt-3 font-semibold tabular-nums tracking-[-0.03em] text-white">
              <span class="text-3xl sm:text-[36px]">$2,686</span>
              <span class="text-lg font-medium text-white/60">.54</span>
            </p>
            <p class="mt-1 font-mono text-xs tabular-nums text-white/50">
              $967,394 total &middot; 2.28&times; principal
            </p>

            <div class="mt-5 space-y-2 rounded-md border border-white/10 bg-white/[0.04] p-3">
              <div class="flex justify-between font-mono text-xs">
                <span class="text-white/50">Principal</span>
                <span class="tabular-nums text-white">$1,520 / mo</span>
              </div>
              <div class="flex justify-between font-mono text-xs">
                <span class="text-white/50">Interest</span>
                <span class="tabular-nums text-white">$1,166 / mo</span>
              </div>
              <div class="h-px bg-white/10" aria-hidden="true"></div>
              <div class="flex justify-between font-mono text-xs">
                <span class="text-white/50">Payoff</span>
                <span class="tabular-nums text-white">May 2056</span>
              </div>
            </div>

            <div class="mt-4 flex gap-2">
              <span
                class="inline-flex items-center rounded-full bg-white px-2.5 py-1 font-mono text-[11px] font-medium text-primary"
                >Copied link</span
              >
              <span class="inline-flex items-center font-mono text-[11px] text-white/40"
                >Share &middot; Embed &middot; Print</span
              >
            </div>
          </div>
        </div>
      </div>

      <p class="mt-3 text-center font-mono text-caption text-mute">
        Every calculator follows the same minimal interaction — type, see result, copy.
      </p>
    </div>
  </div>
</section>
