---
---

<section
  class="relative isolate overflow-hidden border-b border-border bg-background"
  aria-labelledby="hero-heading"
>
  <div class="pointer-events-none absolute inset-0 mesh-gradient opacity-[0.9]" aria-hidden="true"></div>
  <div
    class="pointer-events-none absolute inset-0 opacity-[0.02] dark:opacity-[0.03]"
    style="background-image: linear-gradient(rgba(128,128,128,0.08) 1px, transparent 1px), linear-gradient(90deg, rgba(128,128,128,0.08) 1px, transparent 1px); background-size: 32px 32px;"
    aria-hidden="true"
  ></div>

  <div class="relative mx-auto max-w-[1200px] px-4 sm:px-6 py-16 sm:py-20 lg:py-24">
    <div class="mb-6 flex justify-center">
      <a
        href="#calculators"
        class="inline-flex items-center gap-2 rounded-lg border border-border bg-muted px-3 py-1 text-[13px] text-muted-foreground shadow-card transition-colors hover:bg-card hover:shadow-card-hover focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring"
      >
        <span class="inline-flex items-center gap-1.5">
          <span class="h-2 w-2 animate-pulse rounded-full bg-emerald-500" aria-hidden="true"></span>
          <span class="font-mono text-[11px] font-medium tracking-wide text-muted-foreground">NEW</span>
        </span>
        <span class="hidden h-3 w-px bg-border sm:block" aria-hidden="true"></span>
        <span class="text-[13px]">12 new calculators added this month…</span>
        <svg width="14" height="14" viewBox="0 0 16 16" fill="none" aria-hidden="true" class="text-muted-foreground">
          <path d="M6 3l5 5-5 5" stroke="currentColor" stroke-width="1.3" stroke-linecap="round" />
        </svg>
      </a>
    </div>

    <div class="mx-auto max-w-[680px] text-center">
      <h1 id="hero-heading" class="text-display-xl font-semibold tracking-[-0.05em] text-foreground [text-wrap:balance]">
        Fast, accurate calculators for everything.
      </h1>
      <p class="mx-auto mt-4 max-w-[520px] text-body-lg leading-7 text-muted-foreground [text-wrap:pretty]">
        A minimal, privacy-friendly collection — finance, health, math &amp; conversions. No ads, no tracking, just instant answers.
      </p>

      <div class="mt-8 flex flex-col items-center justify-center gap-3 sm:flex-row">
        <a
          href="#calculators"
          class="inline-flex h-11 items-center justify-center gap-1.5 rounded-lg bg-foreground px-6 text-[13px] font-medium text-background shadow-card transition duration-200 hover:opacity-90 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring focus-visible:ring-offset-2 focus-visible:ring-offset-background"
        >
          Explore calculators
          <svg width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true">
            <path d="M6 3l5 5-5 5" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" />
          </svg>
        </a>
        <a
          href="#categories"
          class="inline-flex h-11 items-center justify-center rounded-lg border border-border bg-card px-6 text-[13px] font-medium text-foreground shadow-card transition duration-200 hover:bg-muted hover:shadow-card-hover focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring focus-visible:ring-offset-2 focus-visible:ring-offset-background"
        >
          <svg width="14" height="14" viewBox="0 0 16 16" fill="none" aria-hidden="true">
            <path d="M2 5h12M2 8h12M2 11h12" stroke="currentColor" stroke-width="1.3" stroke-linecap="round" />
          </svg>
          Browse categories
        </a>
      </div>

      <p class="mt-4 font-mono text-caption tracking-wide text-muted-foreground/60">
        Free &middot; No sign-up &middot; Works offline &middot; <span translate="no">GDPR</span> friendly
      </p>
    </div>

    <div class="mx-auto mt-12 max-w-[860px] sm:mt-16">
      <div
        class="overflow-hidden rounded-xl border border-border bg-card shadow-float"
        role="region"
        aria-label="Example calculation preview"
      >
        <div class="flex items-center justify-between border-b border-border bg-muted/50 px-4 py-2.5">
          <div class="flex items-center gap-1.5" aria-hidden="true">
            <span class="h-3 w-3 rounded-full bg-border"></span>
            <span class="h-3 w-3 rounded-full bg-border"></span>
            <span class="h-3 w-3 rounded-full bg-border"></span>
          </div>
          <span class="font-mono text-[11px] tracking-wide text-muted-foreground">mortgage — live</span>
          <span class="hidden font-mono text-[11px] text-muted-foreground/60 sm:inline">⌘K to search</span>
        </div>

        <div class="grid gap-0 md:grid-cols-[1.15fr_0.85fr]">
          <div class="border-border p-5 sm:p-6 md:border-r">
            <p class="font-mono text-[11px] tracking-widest text-muted-foreground/60">INPUTS</p>
            <div class="mt-4 grid gap-3.5">
              <label class="block">
                <span class="font-mono text-[12px] text-muted-foreground/70">Loan amount</span>
                <div class="mt-1.5 flex items-center gap-2 rounded-lg border border-border bg-muted/50 px-3 py-2.5">
                  <span class="font-mono text-[12px] text-muted-foreground/60">$</span>
                  <span class="tabular-nums font-mono text-[14px] text-foreground">425,000</span>
                  <span class="ml-auto font-mono text-[11px] text-muted-foreground/40">USD</span>
                </div>
              </label>
              <div class="grid grid-cols-2 gap-3">
                <label class="block">
                  <span class="font-mono text-[12px] text-muted-foreground/70">Interest</span>
                  <div class="mt-1.5 flex items-center gap-2 rounded-lg border border-border bg-muted/50 px-3 py-2.5">
                    <span class="font-mono text-[14px] tabular-nums text-foreground">6.5</span>
                    <span class="font-mono text-[12px] text-muted-foreground/60">%</span>
                  </div>
                </label>
                <label class="block">
                  <span class="font-mono text-[12px] text-muted-foreground/70">Term</span>
                  <div class="mt-1.5 flex items-center gap-2 rounded-lg border border-border bg-muted/50 px-3 py-2.5">
                    <span class="font-mono text-[14px] tabular-nums text-foreground">30</span>
                    <span class="font-mono text-[12px] text-muted-foreground/60">years</span>
                  </div>
                </label>
              </div>
              <div class="mt-1 flex items-center gap-2 font-mono text-[11px] text-muted-foreground/60">
                <span class="h-1.5 w-1.5 rounded-full bg-emerald-500" aria-hidden="true"></span>
                Updated instantly — no page reload.
              </div>
            </div>
          </div>

          <div class="bg-muted/30 p-5 sm:p-6">
            <p class="font-mono text-[11px] tracking-widest text-muted-foreground/60">MONTHLY PAYMENT</p>
            <p class="mt-3 font-semibold tabular-nums tracking-[-0.03em] text-foreground">
              <span class="text-3xl sm:text-[36px]">$2,686</span>
              <span class="text-lg font-medium text-muted-foreground/60">.54</span>
            </p>
            <p class="mt-1 font-mono text-[12px] tabular-nums text-muted-foreground/60">
              $967,394 total &middot; 2.28× principal
            </p>

            <div class="mt-5 space-y-2 rounded-lg border border-border bg-muted/50 p-3">
              <div class="flex justify-between font-mono text-[12px]">
                <span class="text-muted-foreground/60">Principal</span>
                <span class="tabular-nums text-foreground">$1,520 / mo</span>
              </div>
              <div class="flex justify-between font-mono text-[12px]">
                <span class="text-muted-foreground/60">Interest</span>
                <span class="tabular-nums text-foreground">$1,166 / mo</span>
              </div>
              <div class="h-px bg-border" aria-hidden="true"></div>
              <div class="flex justify-between font-mono text-[12px]">
                <span class="text-muted-foreground/60">Payoff</span>
                <span class="tabular-nums text-foreground">May 2056</span>
              </div>
            </div>

            <div class="mt-4 flex gap-2">
              <span class="inline-flex items-center rounded-full bg-foreground px-2.5 py-1 font-mono text-[11px] font-medium text-background">Copied link</span>
              <span class="inline-flex items-center font-mono text-[11px] text-muted-foreground/60">Share &middot; Embed &middot; Print</span>
            </div>
          </div>
        </div>
      </div>

      <p class="mt-3 text-center font-mono text-caption text-muted-foreground/60">
        Every calculator follows the same minimal interaction — type, see result, copy.
      </p>
    </div>
  </div>
</section>
