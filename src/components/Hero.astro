---
// Luxury AI / Premium Tech Hero — Construction & Home Improvement
// Tailwind CSS v4 — sleek light + premium dark, glassmorphism search
---

<section
  class="relative isolate overflow-hidden border-b border-hairline bg-[#FCFCF9] dark:bg-[#0A0A0B]"
  aria-labelledby="hero-heading"
>
  <!-- Premium ambient gradients -->
  <div class="pointer-events-none absolute inset-0" aria-hidden="true">
    <div class="absolute inset-0 bg-[radial-gradient(60%_80%_at_20%_0%,rgba(120,119,198,0.08),transparent_60%),radial-gradient(50%_60%_at_80%_20%,rgba(255,119,98,0.06),transparent_60%)] dark:bg-[radial-gradient(60%_80%_at_20%_0%,rgba(120,119,198,0.15),transparent_60%),radial-gradient(50%_60%_at_80%_20%,rgba(255,119,98,0.08),transparent_60%)]"></div>
    <div class="absolute inset-0 bg-[linear-gradient(to_right,rgba(0,0,0,0.04)_1px,transparent_1px),linear-gradient(to_bottom,rgba(0,0,0,0.04)_1px,transparent_1px)] bg-[size:32px_32px] dark:bg-[linear-gradient(to_right,rgba(255,255,255,0.04)_1px,transparent_1px),linear-gradient(to_bottom,rgba(255,255,255,0.04)_1px,transparent_1px)] [mask-image:radial-gradient(ellipse_80%_50%_at_50%_0%,#000_70%,transparent_110%)]"></div>
    <!-- subtle aurora mesh -->
    <div class="absolute -top-24 left-1/2 h-[600px] w-[1200px] -translate-x-1/2 bg-[radial-gradient(ellipse_at_center,rgba(120,119,198,0.10),transparent_70%)] blur-[40px] dark:bg-[radial-gradient(ellipse_at_center,rgba(120,119,198,0.18),transparent_70%)]"></div>
  </div>

  <div class="relative mx-auto max-w-[1120px] px-4 sm:px-6 py-[56px] sm:py-[72px] lg:py-[88px]">
    <!-- Eyebrow -->
    <div class="flex justify-center">
      <p class="inline-flex items-center gap-2.5 font-mono text-[11px] font-medium tracking-[0.22em] text-zinc-500 dark:text-zinc-400">
        <span class="h-px w-6 bg-zinc-300 dark:bg-zinc-700" aria-hidden="true"></span>
        CONSTRUCTION & HOME IMPROVEMENT
        <span class="h-px w-6 bg-zinc-300 dark:bg-zinc-700" aria-hidden="true"></span>
      </p>
    </div>

    <!-- Headline -->
    <div class="mx-auto mt-6 max-w-[820px] text-center">
      <h1
        id="hero-heading"
        class="text-[32px] font-[620] leading-[0.95] tracking-[-0.04em] sm:text-[48px] lg:text-[56px] [text-wrap:balance]"
      >
        <span class="bg-gradient-to-b from-zinc-900 to-zinc-600 bg-clip-text text-transparent dark:from-white dark:to-zinc-400">Construction &amp; Home</span><br />
        <span class="bg-gradient-to-b from-zinc-900 to-zinc-600 bg-clip-text text-transparent dark:from-white dark:to-zinc-400">Improvement Calculators</span>
      </h1>

      <!-- Expanded Premium Subheadline -->
      <p class="mx-auto mt-5 max-w-[720px] text-[15px] leading-[1.7] font-[450] tracking-[-0.01em] text-zinc-600 dark:text-zinc-400 [text-wrap:pretty] sm:text-[17px] sm:leading-[1.7]">
        Precision-engineered intelligence for the built environment.<br class="hidden sm:block" />
        <span class="text-zinc-900 dark:text-zinc-200">201 professional-grade calculators</span> unifying material takeoffs, dimensional analysis, and cost forecasting
        — with <span class="font-medium text-zinc-900 dark:text-zinc-100">live, unit-aware computation</span>, waste optimization, and verified construction formulas for decisions you can build on.
      </p>
      <p class="mx-auto mt-3 hidden max-w-[680px] text-[13px] leading-5 text-zinc-500 dark:text-zinc-500 sm:block">
        Concrete &bull; Roofing &bull; Framing &bull; Gravel &bull; Excavation &bull; Flooring &bull; Decking &bull; Asphalt — every result validated for US customary &amp; metric.
      </p>
    </div>

    <!-- Glassmorphism Search -->
    <div class="mx-auto mt-9 max-w-[640px]">
      <form role="search" aria-label="Search calculators" class="group relative" onsubmit="return false">
        <div class="pointer-events-none absolute -inset-[1px] rounded-[16px] bg-gradient-to-b from-zinc-200 to-zinc-100 opacity-80 blur-[1px] group-focus-within:from-violet-200 group-focus-within:to-indigo-200 dark:from-zinc-800 dark:to-zinc-900 dark:group-focus-within:from-violet-900/40 dark:group-focus-within:to-indigo-900/40" aria-hidden="true"></div>
        <div class="relative flex items-center gap-3 rounded-[14px] border border-zinc-200/70 bg-white/80 px-4 py-3 shadow-[0_2px_16px_rgba(0,0,0,0.06),0_1px_2px_rgba(0,0,0,0.04)] backdrop-blur-xl transition-all group-focus-within:border-violet-300 group-focus-within:bg-white group-focus-within:shadow-[0_8px_32px_rgba(99,102,241,0.12)] dark:border-zinc-800 dark:bg-zinc-900/70 dark:group-focus-within:border-violet-800 dark:group-focus-within:bg-zinc-900">
          <!-- search icon -->
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" aria-hidden="true" class="shrink-0 text-zinc-400 dark:text-zinc-500">
            <path d="M21 21l-4.3-4.3m1.8-5.2a7.5 7.5 0 11-15 0 7.5 7.5 0 0115 0z" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" />
          </svg>
          <input
            id="hero-search"
            type="search"
            placeholder="Search for a calculator..."
            autocomplete="off"
            class="h-7 w-full bg-transparent text-[15px] font-[450] tracking-[-0.01em] text-zinc-900 placeholder:text-zinc-400 focus:outline-none dark:text-white dark:placeholder:text-zinc-600"
            aria-label="Search for a calculator"
          />
          <span class="hidden shrink-0 items-center gap-1 rounded-md border border-zinc-200 bg-zinc-50 px-1.5 py-1 font-mono text-[11px] font-medium leading-none tracking-wide text-zinc-500 dark:border-zinc-700 dark:bg-zinc-800 dark:text-zinc-400 sm:inline-flex" aria-hidden="true">
            <span class="text-[10px]">⌘</span>K
          </span>
        </div>
      </form>

      <!-- Tags -->
      <div class="mt-4 flex flex-wrap items-center justify-center gap-2">
        <span class="font-mono text-[11px] tracking-wide text-zinc-500 dark:text-zinc-500">Try —</span>
        <a href="/concrete-slab-calculator/" class="inline-flex items-center rounded-full border border-zinc-200 bg-white px-3 py-1.5 text-[13px] font-[500] tracking-[-0.01em] text-zinc-700 shadow-sm transition hover:border-zinc-300 hover:bg-zinc-50 hover:text-zinc-900 dark:border-zinc-800 dark:bg-zinc-900 dark:text-zinc-300 dark:hover:border-zinc-700 dark:hover:bg-zinc-800 dark:hover:text-white">Concrete Slab</a>
        <a href="/roof-pitch-calculator/" class="inline-flex items-center rounded-full border border-zinc-200 bg-white px-3 py-1.5 text-[13px] font-[500] tracking-[-0.01em] text-zinc-700 shadow-sm transition hover:border-zinc-300 hover:bg-zinc-50 hover:text-zinc-900 dark:border-zinc-800 dark:bg-zinc-900 dark:text-zinc-300 dark:hover:border-zinc-700 dark:hover:bg-zinc-800 dark:hover:text-white">Roof Pitch</a>
        <a href="/gravel-calculator/" class="inline-flex items-center rounded-full border border-zinc-200 bg-white px-3 py-1.5 text-[13px] font-[500] tracking-[-0.01em] text-zinc-700 shadow-sm transition hover:border-zinc-300 hover:bg-zinc-50 hover:text-zinc-900 dark:border-zinc-800 dark:bg-zinc-900 dark:text-zinc-300 dark:hover:border-zinc-700 dark:hover:bg-zinc-800 dark:hover:text-white">Gravel</a>
        <a href="/fence-cost-calculator/" class="inline-flex items-center rounded-full border border-zinc-200 bg-white px-3 py-1.5 text-[13px] font-[500] tracking-[-0.01em] text-zinc-700 shadow-sm transition hover:border-zinc-300 hover:bg-zinc-50 hover:text-zinc-900 dark:border-zinc-800 dark:bg-zinc-900 dark:text-zinc-300 dark:hover:border-zinc-700 dark:hover:bg-zinc-800 dark:hover:text-white">Fence</a>
        <a href="/deck-material-calculator/" class="inline-flex items-center rounded-full border border-zinc-200 bg-white px-3 py-1.5 text-[13px] font-[500] tracking-[-0.01em] text-zinc-700 shadow-sm transition hover:border-zinc-300 hover:bg-zinc-50 hover:text-zinc-900 dark:border-zinc-800 dark:bg-zinc-900 dark:text-zinc-300 dark:hover:border-zinc-700 dark:hover:bg-zinc-800 dark:hover:text-white">Deck</a>
      </div>
    </div>

    <!-- Bottom trust bar -->
    <div class="mt-7 flex justify-center">
      <p class="inline-flex flex-wrap items-center justify-center gap-x-3 gap-y-1 rounded-full border border-zinc-200/60 bg-white/60 px-4 py-2 font-mono text-[11px] tracking-wide text-zinc-500 shadow-sm backdrop-blur dark:border-zinc-800 dark:bg-zinc-900/60 dark:text-zinc-400">
        <span class="inline-flex items-center gap-1.5"><span class="h-1.5 w-1.5 rounded-full bg-emerald-500" aria-hidden="true"></span> Free</span>
        <span class="h-3 w-px bg-zinc-200 dark:bg-zinc-700" aria-hidden="true"></span>
        <span>No sign-up</span>
        <span class="h-3 w-px bg-zinc-200 dark:bg-zinc-700" aria-hidden="true"></span>
        <span>US units</span>
        <span class="h-3 w-px bg-zinc-200 dark:bg-zinc-700" aria-hidden="true"></span>
        <span class="inline-flex items-center gap-1">Works offline <span class="h-1 w-1 rounded-full bg-zinc-300 dark:bg-zinc-600" aria-hidden="true"></span> 201 tools</span>
      </p>
    </div>
  </div>
</section>

<script is:inline>
  (() => {
    const input = document.getElementById('hero-search');
    if (!input) return;
    // Focus with ⌘K / Ctrl+K — matches existing site search pattern
    document.addEventListener('keydown', (e) => {
      if ((e.metaKey || e.ctrlKey) && e.key.toLowerCase() === 'k') {
        e.preventDefault();
        input.focus();
      }
    });
    // Minimal client search — redirect to /calculators/?q= or filter if present
    input.addEventListener('keydown', (e) => {
      if (e.key === 'Enter') {
        const q = input.value.trim();
        if (!q) return;
        window.location.href = `/calculators/?q=${encodeURIComponent(q)}`;
      }
    });
  })();
</script>
