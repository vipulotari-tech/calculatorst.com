---
interface Props {
  variant: string;
}
const { variant } = Astro.props;
---

{variant === "gravel" && (
  <figure class="overflow-hidden rounded-lg border border-border bg-card shadow-card">
    <div class="bg-muted px-4 py-2 flex items-center justify-between border-b border-border">
      <span class="font-mono text-[11px] tracking-widest text-muted-foreground">VISUAL GUIDE — HOW TO MEASURE</span>
      <span class="font-mono text-[11px] text-muted-foreground">Top view + cross-section</span>
    </div>
    <div class="grid md:grid-cols-2 gap-0 divide-y md:divide-y-0 md:divide-x divide-hairline">
      <!-- Top view -->
      <div class="p-5 bg-card">
        <p class="text-center font-mono text-[11px] tracking-wide text-muted-foreground mb-3">TOP VIEW — rectangular area</p>
        <svg viewBox="0 0 360 220" class="w-full h-auto" role="img" aria-labelledby="gravel-top-title">
          <title id="gravel-top-title">Gravel area top view - length and width</title>
          <!-- background grid -->
          <rect x="0" y="0" width="360" height="220" rx="8" fill="var(--color-background)" stroke="var(--color-border)"/>
          <!-- yard -->
          <rect x="40" y="40" width="240" height="120" rx="6" fill="var(--color-card)" stroke="var(--color-foreground)" stroke-width="1.5"/>
          <rect x="40" y="40" width="240" height="120" rx="6" fill="none" stroke="#0070f3" stroke-width="1" stroke-dasharray="6 4" opacity="0.5"/>
          <!-- gravel texture dots -->
          <g fill="var(--color-muted-foreground)" opacity="0.35">
            <circle cx="60" cy="65" r="1.5"/><circle cx="90" cy="80" r="1.2"/><circle cx="120" cy="70" r="1.5"/><circle cx="150" cy="85" r="1.2"/><circle cx="180" cy="65" r="1.5"/><circle cx="210" cy="75" r="1.2"/><circle cx="240" cy="90" r="1.5"/><circle cx="70" cy="100" r="1.2"/><circle cx="110" cy="110" r="1.5"/><circle cx="140" cy="95" r="1.2"/><circle cx="170" cy="115" r="1.5"/><circle cx="200" cy="105" r="1.2"/><circle cx="230" cy="120" r="1.5"/><circle cx="80" cy="135" r="1.2"/><circle cx="130" cy="140" r="1.5"/><circle cx="190" cy="130" r="1.2"/>
          </g>
          <!-- dimension Length top -->
          <line x1="40" y1="22" x2="280" y2="22" stroke="var(--color-foreground)" stroke-width="1"/>
          <polygon points="40,22 48,18 48,26" fill="var(--color-foreground)"/><polygon points="280,22 272,18 272,26" fill="var(--color-foreground)"/>
          <rect x="135" y="6" width="50" height="16" rx="8" fill="var(--color-card)" stroke="var(--color-border)"/><text x="160" y="17" text-anchor="middle" font-size="10" font-family="Geist Mono,monospace" fill="var(--color-foreground)" font-weight="600">Length</text>
          <!-- dimension Width left -->
          <line x1="22" y1="40" x2="22" y2="160" stroke="var(--color-foreground)" stroke-width="1"/>
          <polygon points="22,40 18,48 26,48" fill="var(--color-foreground)"/><polygon points="22,160 18,152 26,152" fill="var(--color-foreground)"/>
          <g transform="rotate(-90 22 100)"><rect x="-10" y="92" width="52" height="16" rx="8" fill="var(--color-card)" stroke="var(--color-border)"/><text x="16" y="103" text-anchor="middle" font-size="10" font-family="Geist Mono,monospace" fill="var(--color-foreground)" font-weight="600">Width</text></g>
          <!-- labels inside -->
          <text x="160" y="105" text-anchor="middle" font-size="11" font-family="Geist, sans-serif" fill="var(--color-muted-foreground)" font-weight="500">Gravel Area</text>
          <text x="160" y="120" text-anchor="middle" font-size="10" font-family="Geist Mono,monospace" fill="var(--color-muted-foreground)" >L × W</text>
          <!-- compass -->
          <g transform="translate(310 160)">
            <circle cx="0" cy="0" r="14" fill="var(--color-card)" stroke="var(--color-border)"/><text x="0" y="4" text-anchor="middle" font-size="8" fill="var(--color-foreground)" font-weight="700">N</text><path d="M0 -8 L2 -2 L0 -4 L-2 -2 Z" fill="#ee0000"/>
          </g>
        </svg>
        <p class="mt-2 text-center font-mono text-[11px] text-muted-foreground">Measure longest × widest. For L-shape split into 2 rectangles.</p>
      </div>
      <!-- Cross section -->
      <div class="p-5 bg-card">
        <p class="text-center font-mono text-[11px] tracking-wide text-muted-foreground mb-3">CROSS-SECTION — depth & layers</p>
        <svg viewBox="0 0 360 220" class="w-full h-auto" role="img" aria-labelledby="gravel-side-title">
          <title id="gravel-side-title">Gravel depth cross section</title>
          <rect x="0" y="0" width="360" height="220" rx="8" fill="var(--color-background)" stroke="var(--color-border)"/>
          <!-- ground -->
          <rect x="40" y="160" width="280" height="6" rx="2" fill="#1f1f1f"/>
          <text x="180" y="178" text-anchor="middle" font-size="9" font-family="Geist Mono,monospace" fill="var(--color-muted-foreground)">Compacted subgrade</text>
          <!-- fabric -->
          <line x1="40" y1="148" x2="320" y2="148" stroke="#0070f3" stroke-width="1.5" stroke-dasharray="4 3"/><text x="325" y="152" font-size="8" fill="#0070f3" font-family="Geist Mono,monospace">Fabric</text>
          <!-- gravel layer -->
          <rect x="40" y="110" width="280" height="38" rx="2" fill="#d8ccf1" stroke="#7928ca" stroke-width="1.2"/>
          <rect x="40" y="110" width="280" height="38" rx="2" fill="none" stroke="white" stroke-dasharray="0" opacity="0.2"/>
          <g fill="#4c2889" opacity="0.25">
            <circle cx="60" cy="125" r="3"/><circle cx="85" cy="135" r="2.5"/><circle cx="110" cy="120" r="3"/><circle cx="135" cy="130" r="2.5"/><circle cx="160" cy="125" r="3"/><circle cx="185" cy="135" r="2.5"/><circle cx="210" cy="122" r="3"/><circle cx="235" cy="132" r="2.5"/><circle cx="260" cy="126" r="3"/><circle cx="285" cy="133" r="2.5"/>
          </g>
          <text x="180" y="133" text-anchor="middle" font-size="11" font-weight="600" fill="#4c2889" font-family="Geist, sans-serif">Gravel</text>
          <!-- depth arrow -->
          <line x1="325" y1="110" x2="325" y2="148" stroke="var(--color-foreground)" stroke-width="1"/>
          <polygon points="325,110 322,118 328,118" fill="var(--color-foreground)"/><polygon points="325,148 322,140 328,140" fill="var(--color-foreground)"/>
          <rect x="330" y="122" width="22" height="14" rx="7" fill="var(--color-foreground)"/><text x="341" y="132" text-anchor="middle" font-size="8" fill="var(--color-card)" font-family="Geist Mono,monospace" font-weight="600">D</text>
          <!-- base layer hints -->
          <rect x="40" y="85" width="280" height="18" rx="2" fill="#ffefcf" stroke="#ab570a" stroke-dasharray="4 4" opacity="0.9"/><text x="180" y="97" text-anchor="middle" font-size="8" fill="#ab570a" font-family="Geist Mono,monospace">Optional base (driveway) — 4-6"</text>
        </svg>
        <p class="mt-2 text-center font-mono text-[11px] text-muted-foreground">Depth in inches ÷ 12 = feet. Add 10% waste for compaction.</p>
      </div>
    </div>
    <figcaption class="px-4 py-2 bg-background border-t border-border font-mono text-[11px] leading-4 text-muted-foreground">Top view + cross-section — measure your area correctly the first time.</figcaption>
  </figure>
  <figure class="mt-4 overflow-hidden rounded-lg border border-border bg-card shadow-card">
    <div class="bg-muted px-3 py-2 border-b border-border"><span class="font-mono text-[11px] tracking-widest text-muted-foreground">REAL PHOTO — GRAVEL YARD</span></div>
    <img src="https://images.unsplash.com/photo-1504307651254-35680f356dfd?w=800&q=80&auto=format&fit=crop" alt="Gravel yard with different aggregates stockpiled" class="w-full h-[220px] object-cover" loading="lazy" decoding="async" />
    <figcaption class="px-3 py-2 bg-background border-t border-border font-mono text-[11px] text-muted-foreground">Bulk gravel at quarry scale house — same material you calculate. Verify density with supplier ticket.</figcaption>
  </figure>
)}

{variant === "concrete" && (
  <figure class="overflow-hidden rounded-lg border border-border bg-card shadow-card">
    <div class="bg-muted px-4 py-2 flex items-center justify-between border-b border-border">
      <span class="font-mono text-[11px] tracking-widest text-muted-foreground">VISUAL GUIDE — SLAB ANATOMY</span>
      <span class="font-mono text-[11px] text-muted-foreground">Plan + isometric</span>
    </div>
    <div class="grid md:grid-cols-2 gap-0 divide-y md:divide-y-0 md:divide-x divide-hairline">
      <div class="p-5">
        <p class="text-center font-mono text-[11px] tracking-wide text-muted-foreground mb-3">TOP VIEW — length × width</p>
        <svg viewBox="0 0 360 220" class="w-full h-auto" role="img" aria-labelledby="conc-top">
          <title id="conc-top">Concrete slab top view</title>
          <rect x="0" y="0" width="360" height="220" rx="8" fill="var(--color-background)" stroke="var(--color-border)"/>
          <rect x="50" y="45" width="220" height="110" rx="4" fill="var(--color-card)" stroke="var(--color-foreground)" stroke-width="1.5"/>
          <rect x="50" y="45" width="220" height="110" rx="4" fill="none" stroke="var(--color-border)" stroke-dasharray="8 6"/>
          <!-- rebar grid -->
          <g stroke="#d3e5ff" stroke-width="0.8">
            <line x1="70" y1="45" x2="70" y2="155"/><line x1="90" y1="45" x2="90" y2="155"/><line x1="110" y1="45" x2="110" y2="155"/><line x1="130" y1="45" x2="130" y2="155"/><line x1="150" y1="45" x2="150" y2="155"/><line x1="170" y1="45" x2="170" y2="155"/><line x1="190" y1="45" x2="190" y2="155"/><line x1="210" y1="45" x2="210" y2="155"/><line x1="230" y1="45" x2="230" y2="155"/><line x1="250" y1="45" x2="250" y2="155"/>
            <line x1="50" y1="65" x2="270" y2="65"/><line x1="50" y1="85" x2="270" y2="85"/><line x1="50" y1="105" x2="270" y2="105"/><line x1="50" y1="125" x2="270" y2="125"/><line x1="50" y1="145" x2="270" y2="145"/>
          </g>
          <circle cx="70" cy="65" r="1.5" fill="#0070f3"/><circle cx="130" cy="105" r="1.5" fill="#0070f3"/><circle cx="210" cy="125" r="1.5" fill="#0070f3"/>
          <!-- dimensions -->
          <line x1="50" y1="22" x2="270" y2="22" stroke="var(--color-foreground)" stroke-width="1"/><polygon points="50,22 58,18 58,26" fill="var(--color-foreground)"/><polygon points="270,22 262,18 262,26" fill="var(--color-foreground)"/>
          <rect x="135" y="6" width="50" height="16" rx="8" fill="var(--color-card)" stroke="var(--color-border)"/><text x="160" y="17" text-anchor="middle" font-size="10" font-family="Geist Mono,monospace" fill="var(--color-foreground)" font-weight="600">Length</text>
          <line x1="22" y1="45" x2="22" y2="155" stroke="var(--color-foreground)" stroke-width="1"/><polygon points="22,45 18,53 26,53" fill="var(--color-foreground)"/><polygon points="22,155 18,147 26,147" fill="var(--color-foreground)"/>
          <g transform="rotate(-90 22 100)"><rect x="-8" y="92" width="52" height="16" rx="8" fill="var(--color-card)" stroke="var(--color-border)"/><text x="18" y="103" text-anchor="middle" font-size="10" font-family="Geist Mono,monospace" fill="var(--color-foreground)" font-weight="600">Width</text></g>
          <text x="160" y="102" text-anchor="middle" font-size="10" fill="var(--color-muted-foreground)" font-family="Geist,sans-serif">Slab — forms + rebar</text>
          <text x="160" y="118" text-anchor="middle" font-size="9" fill="var(--color-muted-foreground)" font-family="Geist Mono,monospace">Add 5-10% waste</text>
        </svg>
      </div>
      <div class="p-5">
        <p class="text-center font-mono text-[11px] tracking-wide text-muted-foreground mb-3">ISOMETRIC — thickness</p>
        <svg viewBox="0 0 360 220" class="w-full h-auto" role="img" aria-labelledby="conc-iso">
          <title id="conc-iso">Concrete slab thickness isometric</title>
          <rect x="0" y="0" width="360" height="220" rx="8" fill="var(--color-background)" stroke="var(--color-border)"/>
          <!-- isometric slab -->
          <path d="M70 120 L220 70 L300 90 L150 140 Z" fill="var(--color-card)" stroke="var(--color-foreground)" stroke-width="1.3"/>
          <path d="M70 120 L70 145 L150 165 L150 140 Z" fill="var(--color-muted)" stroke="var(--color-foreground)" stroke-width="1.2"/>
          <path d="M150 140 L150 165 L300 115 L300 90 Z" fill="var(--color-background)" stroke="var(--color-foreground)" stroke-width="1.2"/>
          <path d="M70 145 L150 165 L300 115" fill="none" stroke="var(--color-border)" stroke-width="1"/>
          <!-- thickness -->
          <line x1="310" y1="90" x2="310" y2="115" stroke="#ee0000" stroke-width="1.5"/>
          <polygon points="310,90 307,98 313,98" fill="#ee0000"/><polygon points="310,115 307,107 313,107" fill="#ee0000"/>
          <rect x="318" y="96" width="32" height="14" rx="7" fill="#ee0000"/><text x="334" y="106" text-anchor="middle" font-size="8" fill="var(--color-card)" font-family="Geist Mono,monospace" font-weight="700">4"</text>
          <text x="185" y="115" text-anchor="middle" font-size="11" fill="var(--color-foreground)" font-weight="600" font-family="Geist,sans-serif">1.48 yd³</text>
          <text x="185" y="130" text-anchor="middle" font-size="9" fill="var(--color-muted-foreground)" font-family="Geist Mono,monospace">for 12×10 ft @ 4"</text>
          <g transform="translate(40 180)">
            <rect x="0" y="0" width="10" height="10" rx="2" fill="var(--color-card)" stroke="var(--color-foreground)"/><line x1="2" y1="5" x2="8" y2="5" stroke="#0070f3" stroke-width="0.8"/><line x1="5" y1="2" x2="5" y2="8" stroke="#0070f3" stroke-width="0.8"/><text x="14" y="9" font-size="9" fill="var(--color-muted-foreground)" font-family="Geist,sans-serif">Rebar / wire mesh</text>
          </g>
        </svg>
        <p class="mt-2 text-center font-mono text-[11px] text-muted-foreground">4" patio, 6" driveway. 27 ft³ = 1 yd³.</p>
      </div>
    </div>
    <figcaption class="px-4 py-2 bg-background border-t border-border font-mono text-[11px] text-muted-foreground">Plan + isometric views — thickness arrow and rebar grid show how much concrete you need.</figcaption>
  </figure>
  <!-- Hybrid: Real photo + 3D -->
  <div class="mt-4 grid md:grid-cols-2 gap-4">
    <figure class="overflow-hidden rounded-lg border border-border bg-card shadow-card">
      <div class="bg-muted px-3 py-2 border-b border-border"><span class="font-mono text-[11px] tracking-widest text-muted-foreground">REAL PHOTO — POUR IN PROGRESS</span></div>
      <img src="https://images.unsplash.com/photo-1487958449943-2429e8be8625?w=800&q=80&auto=format&fit=crop" alt="Concrete slab being poured with wooden forms and rebar" class="w-full h-[240px] object-cover" loading="lazy" decoding="async" />
      <figcaption class="px-3 py-2 bg-background border-t border-border font-mono text-[11px] text-muted-foreground">Wooden forms + rebar before pour — forms define Length×Width, screed defines thickness.</figcaption>
    </figure>
    <div class="overflow-hidden rounded-lg border border-border bg-card shadow-card">
      <div class="bg-muted px-3 py-2 border-b border-border flex justify-between"><span class="font-mono text-[11px] tracking-widest text-muted-foreground">3D MODEL — ROTATE & ZOOM</span><span class="font-mono text-[10px] text-muted-foreground">WebGL</span></div>
      <model-viewer src="https://modelviewer.dev/shared-assets/models/Astronaut.glb" poster="https://images.unsplash.com/photo-1487958449943-2429e8be8625?w=800&q=80&auto=format&fit=crop" alt="3D concrete slab model — replace with slab.glb" ar camera-controls touch-action="pan-y" auto-rotate shadow-intensity="0.8" environment-image="neutral" style="width:100%; height:240px; background:var(--color-background);" loading="lazy" reveal="interaction"></model-viewer>
      <div class="px-3 py-2 bg-background border-t border-border font-mono text-[11px] text-muted-foreground">Demo model — swap <span class="text-foreground font-medium">/public/models/slab.glb</span> for your custom slab. Drag to rotate.</div>
    </div>
  </div>
  <script is:inline type="module" src="https://ajax.googleapis.com/ajax/libs/model-viewer/4.0.0/model-viewer.min.js"></script>
)}

{variant === "pea" && (
  <figure class="overflow-hidden rounded-lg border border-border bg-card shadow-card">
    <div class="bg-muted px-4 py-2 border-b border-border"><span class="font-mono text-[11px] tracking-widest text-muted-foreground">VISUAL GUIDE — PEA GRAVEL</span></div>
    <div class="p-5">
      <svg viewBox="0 0 700 180" class="w-full h-auto" role="img" aria-labelledby="pea-title">
        <title id="pea-title">Pea gravel sizes and coverage</title>
        <rect x="0" y="0" width="700" height="180" rx="8" fill="var(--color-background)" stroke="var(--color-border)"/>
        <!-- 3 circles showing size -->
        <g transform="translate(60 90)">
          <circle cx="0" cy="0" r="28" fill="#d8ccf1" stroke="#7928ca"/><circle cx="-8" cy="-6" r="8" fill="var(--color-card)" opacity="0.6"/><text x="0" y="45" text-anchor="middle" font-size="10" fill="var(--color-muted-foreground)" font-weight="600">3/8" Pea</text><text x="0" y="58" text-anchor="middle" font-size="9" fill="var(--color-muted-foreground)" font-family="Geist Mono,monospace">Path/Patios</text>
        </g>
        <g transform="translate(230 90)">
          <circle cx="0" cy="0" r="18" fill="#aaffec" stroke="#29bc9b"/><circle cx="-5" cy="-4" r="5" fill="var(--color-card)" opacity="0.6"/><text x="0" y="45" text-anchor="middle" font-size="10" fill="var(--color-muted-foreground)" font-weight="600">3/4" Crushed</text><text x="0" y="58" text-anchor="middle" font-size="9" fill="var(--color-muted-foreground)" font-family="Geist Mono,monospace">Driveway</text>
        </g>
        <g transform="translate(400 90)">
          <rect x="-30" y="-22" width="60" height="44" rx="6" fill="var(--color-card)" stroke="var(--color-foreground)"/><g fill="var(--color-muted-foreground)" opacity="0.2"><circle cx="-12" cy="-8" r="4"/><circle cx="8" cy="-5" r="3"/><circle cx="-5" cy="10" r="4"/><circle cx="12" cy="8" r="3"/></g><text x="0" y="45" text-anchor="middle" font-size="10" fill="var(--color-muted-foreground)" font-weight="600">Yard @ 3"</text><text x="0" y="58" text-anchor="middle" font-size="9" fill="var(--color-muted-foreground)" font-family="Geist Mono,monospace">~80 ft² / ton</text>
        </g>
        <g transform="translate(560 90)">
          <rect x="-40" y="-30" width="80" height="60" rx="8" fill="#ffefcf" stroke="#ab570a"/><text x="0" y="-8" text-anchor="middle" font-size="10" fill="#ab570a" font-weight="700">1.35 t/yd³</text><text x="0" y="8" text-anchor="middle" font-size="10" fill="var(--color-muted-foreground)">Pea density</text><text x="0" y="22" text-anchor="middle" font-size="9" fill="var(--color-muted-foreground)" font-family="Geist Mono,monospace">2700 lb / yd³</text>
        </g>
        <line x1="140" y1="60" x2="160" y2="60" stroke="var(--color-border)" stroke-width="1" marker-end="url(#arrow)"/><line x1="310" y1="60" x2="330" y2="60" stroke="var(--color-border)" stroke-width="1"/><line x1="480" y1="60" x2="500" y2="60" stroke="var(--color-border)" stroke-width="1"/>
        <defs><marker id="arrow" viewBox="0 0 10 10" refX="5" refY="5" markerWidth="6" markerHeight="6" orient="auto-start-reverse"><path d="M 0 0 L 10 5 L 0 10 z" fill="#ebebeb"/></marker></defs>
      </svg>
      <p class="mt-2 text-center font-mono text-[11px] text-muted-foreground">Pea is rounded & smooth — rakes needed. Crushed locks together.</p>
    </div>
  </figure>
  <figure class="mt-4 overflow-hidden rounded-lg border border-border bg-card shadow-card">
    <div class="bg-muted px-3 py-2 border-b border-border"><span class="font-mono text-[11px] tracking-widest text-muted-foreground">REAL PHOTO — PEA GRAVEL PATH</span></div>
    <img src="https://images.unsplash.com/photo-1558618666-fcd25c85cd64?w=800&q=80&auto=format&fit=crop" alt="Pea gravel garden path between pavers" class="w-full h-[220px] object-cover" loading="lazy" decoding="async" />
    <figcaption class="px-3 py-2 bg-background border-t border-border font-mono text-[11px] text-muted-foreground">Rounded pea — soft underfoot but needs edging to hold.</figcaption>
  </figure>
)}

{variant === "driveway" && (
  <figure class="overflow-hidden rounded-lg border border-border bg-card shadow-card">
    <div class="bg-muted px-4 py-2 border-b border-border"><span class="font-mono text-[11px] tracking-widest text-muted-foreground">VISUAL GUIDE — DRIVEWAY LAYERS</span></div>
    <svg viewBox="0 0 700 190" class="w-full h-auto p-5 bg-card" role="img" aria-labelledby="drv-title">
      <title id="drv-title">Driveway layers cross section</title>
      <rect x="0" y="0" width="700" height="190" rx="8" fill="var(--color-background)" stroke="var(--color-border)"/>
      <rect x="40" y="140" width="620" height="8" rx="2" fill="#1f1f1f"/>
      <rect x="40" y="110" width="620" height="30" rx="2" fill="#d3e5ff" stroke="#0070f3"/><text x="350" y="130" text-anchor="middle" font-size="11" fill="#0761d1" font-weight="600">Base — 4-6" crushed #57 + fines (compacted)</text>
      <rect x="40" y="85" width="620" height="25" rx="2" fill="#d8ccf1" stroke="#7928ca"/><text x="350" y="102" text-anchor="middle" font-size="11" fill="#4c2889" font-weight="600">Top — 2-3" pea / #8 (decorative)</text>
      <line x1="665" y1="85" x2="665" y2="140" stroke="var(--color-foreground)" stroke-width="1"/><polygon points="665,85 662,93 668,93" fill="var(--color-foreground)"/><polygon points="665,140 662,132 668,132" fill="var(--color-foreground)"/><rect x="672" y="104" width="20" height="14" rx="7" fill="var(--color-foreground)"/><text x="682" y="114" text-anchor="middle" font-size="8" fill="var(--color-card)" font-weight="700">6"</text>
      <!-- car -->
      <g transform="translate(350 55)"><rect x="-30" y="-10" width="60" height="14" rx="6" fill="var(--color-foreground)"/><circle cx="-18" cy="8" r="5" fill="#333" stroke="white"/><circle cx="18" cy="8" r="5" fill="#333" stroke="white"/></g>
    </svg>
