---
---

<section id="categories" class="border-b border-hairline bg-canvas-soft" aria-labelledby="categories-heading">
  <div class="mx-auto max-w-[1400px] px-6 py-16 sm:py-20 lg:py-24 max-md:px-4">
    <div class="mx-auto max-w-[720px] text-center">
      <p
        class="font-mono text-caption font-medium tracking-widest text-mute"
        aria-hidden="true"
      >
        CATEGORIES
      </p>
      <h2
        id="categories-heading"
        class="mt-2 text-display-lg font-semibold tracking-[-0.04em] text-ink [text-wrap:balance]"
      >
        Every everyday calculation, neatly grouped.
      </h2>
      <p class="mx-auto mt-3 max-w-[560px] text-body-md leading-6 text-body [text-wrap:pretty]">
        Browse by topic. Each category has its own index, search, and offline-ready pages — all built
        for speed and clarity.
      </p>
    </div>

    <ul
      class="mt-10 grid gap-4 sm:gap-5 md:grid-cols-3"
      role="list"
      aria-label="Calculator categories"
    >
      <!-- Finance -->
      <li
        class="group flex flex-col rounded-lg border border-hairline bg-canvas p-6 shadow-card transition duration-200 hover:shadow-card-hover focus-within:shadow-float"
      >
        <div
          class="inline-flex h-8 w-8 items-center justify-center rounded-sm border border-hairline bg-canvas-soft text-ink"
          aria-hidden="true"
        >
          <svg width="16" height="16" viewBox="0 0 16 16" fill="none">
            <path
              d="M3 6.5h10M5 6.5V12M8 6.5V12M11 6.5V12M4 3.5h8a1 1 0 0 1 1 1v8a1 1 0 0 1-1 1H4a1 1 0 0 1-1-1v-8a1 1 0 0 1 1-1Z"
              stroke="currentColor"
              stroke-width="1.25"
              stroke-linecap="round"></path>
          </svg>
        </div>
        <h3 class="mt-4 text-display-sm font-semibold tracking-[-0.03em] text-ink">Finance</h3>
        <p class="mt-1.5 line-clamp-2 text-sm leading-5 text-body">
          Mortgages, loans, interest, and ROI — with clear amortization and shareable links.
        </p>
        <ul class="mt-4 flex flex-wrap gap-1.5" aria-label="Popular finance calculators">
          <li
            class="rounded-full bg-canvas-soft px-2.5 py-1 font-mono text-[11px] tracking-wide text-body ring-1 ring-hairline"
          >
            Mortgage
          </li>
          <li
            class="rounded-full bg-canvas-soft px-2.5 py-1 font-mono text-[11px] tracking-wide text-body ring-1 ring-hairline"
          >
            Loan
          </li>
          <li
            class="rounded-full bg-canvas-soft px-2.5 py-1 font-mono text-[11px] tracking-wide text-body ring-1 ring-hairline"
          >
            Compound
          </li>
        </ul>
        <a
          href="#calculators"
          class="mt-5 inline-flex items-center gap-1 text-sm font-medium text-ink transition-colors hover:text-link focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-link"
        >
          Explore finance
          <svg width="14" height="14" viewBox="0 0 16 16" fill="none" aria-hidden="true" class="transition-transform group-hover:translate-x-0.5"
            ><path d="M6 3l5 5-5 5" stroke="currentColor" stroke-width="1.3" stroke-linecap="round"
            ></path></svg
          >
        </a>
      </li>

      <!-- Health -->
      <li
        class="group flex flex-col rounded-lg border border-hairline bg-canvas p-6 shadow-card transition duration-200 hover:shadow-card-hover focus-within:shadow-float"
      >
        <div
          class="inline-flex h-8 w-8 items-center justify-center rounded-sm border border-hairline bg-canvas-soft text-ink"
          aria-hidden="true"
        >
          <svg width="16" height="16" viewBox="0 0 16 16" fill="none">
            <path
              d="M8 13L3.5 8.5a3 3 0 0 1 4.2-4.2L8 4.6l.3-.3A3 3 0 1 1 12.5 8.5L8 13Z"
              stroke="currentColor"
              stroke-width="1.25"
              stroke-linecap="round"
              stroke-linejoin="round"></path>
          </svg>
        </div>
        <h3 class="mt-4 text-display-sm font-semibold tracking-[-0.03em] text-ink">Health</h3>
        <p class="mt-1.5 line-clamp-2 text-sm leading-5 text-body">
          BMI, calories, body fat, and pregnancy — private, on-device, no data leaving your browser.
        </p>
        <ul class="mt-4 flex flex-wrap gap-1.5" aria-label="Popular health calculators">
          <li
            class="rounded-full bg-canvas-soft px-2.5 py-1 font-mono text-[11px] tracking-wide text-body ring-1 ring-hairline"
          >
            BMI
          </li>
          <li
            class="rounded-full bg-canvas-soft px-2.5 py-1 font-mono text-[11px] tracking-wide text-body ring-1 ring-hairline"
          >
            Calorie
          </li>
          <li
            class="rounded-full bg-canvas-soft px-2.5 py-1 font-mono text-[11px] tracking-wide text-body ring-1 ring-hairline"
          >
            Dog Toxicity
          </li>
        </ul>
        <a
          href="#calculators"
          class="mt-5 inline-flex items-center gap-1 text-sm font-medium text-ink transition-colors hover:text-link focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-link"
        >
          Explore health
          <svg width="14" height="14" viewBox="0 0 16 16" fill="none" aria-hidden="true" class="transition-transform group-hover:translate-x-0.5"
            ><path d="M6 3l5 5-5 5" stroke="currentColor" stroke-width="1.3" stroke-linecap="round"
            ></path></svg
          >
        </a>
      </li>

      <!-- Math & Conversions -->
      <li
        class="group flex flex-col rounded-lg border border-hairline bg-canvas p-6 shadow-card transition duration-200 hover:shadow-card-hover focus-within:shadow-float"
      >
        <div
          class="inline-flex h-8 w-8 items-center justify-center rounded-sm border border-hairline bg-canvas-soft text-ink"
          aria-hidden="true"
        >
          <svg width="16" height="16" viewBox="0 0 16 16" fill="none">
            <path
              d="M4 3.5h8M4 8h8M4 12.5h8M6 3.5v9M10 3.5v9"
              stroke="currentColor"
              stroke-width="1.25"
              stroke-linecap="round"></path>
          </svg>
        </div>
        <h3 class="mt-4 text-display-sm font-semibold tracking-[-0.03em] text-ink">
          Math &amp; Conversions
        </h3>
        <p class="mt-1.5 line-clamp-2 text-sm leading-5 text-body">
          Percentages, dates, units, and building trades — for quick field checks and study.
        </p>
        <ul class="mt-4 flex flex-wrap gap-1.5" aria-label="Popular math calculators">
          <li
            class="rounded-full bg-canvas-soft px-2.5 py-1 font-mono text-[11px] tracking-wide text-body ring-1 ring-hairline"
          >
            Percentage
          </li>
          <li
            class="rounded-full bg-canvas-soft px-2.5 py-1 font-mono text-[11px] tracking-wide text-body ring-1 ring-hairline"
          >
            Paver Sand
          </li>
          <li
            class="rounded-full bg-canvas-soft px-2.5 py-1 font-mono text-[11px] tracking-wide text-body ring-1 ring-hairline"
          >
            Mortar Mix
          </li>
        </ul>
        <a
          href="#calculators"
          class="mt-5 inline-flex items-center gap-1 text-sm font-medium text-ink transition-colors hover:text-link focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-link"
        >
          Explore math
          <svg width="14" height="14" viewBox="0 0 16 16" fill="none" aria-hidden="true" class="transition-transform group-hover:translate-x-0.5"
            ><path d="M6 3l5 5-5 5" stroke="currentColor" stroke-width="1.3" stroke-linecap="round"
            ></path></svg
          >
        </a>
      </li>
    </ul>

    <!-- Tab pill row — secondary navigation affordance -->
    <div class="mt-8 flex flex-wrap justify-center gap-2">
      <span
        class="inline-flex items-center rounded-pill-sm bg-canvas px-4 py-1.5 text-sm text-ink ring-1 ring-hairline"
        aria-current="true">All</span
      >
      <a
        href="#calculators"
        class="inline-flex items-center rounded-pill-sm bg-canvas px-4 py-1.5 text-sm text-body ring-1 ring-hairline transition-colors hover:bg-canvas-soft hover:text-ink focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-link"
        >Finance</a
      >
      <a
        href="#calculators"
        class="inline-flex items-center rounded-pill-sm bg-canvas px-4 py-1.5 text-sm text-body ring-1 ring-hairline transition-colors hover:bg-canvas-soft hover:text-ink focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-link"
        >Health</a
      >
      <a
        href="#calculators"
        class="inline-flex items-center rounded-pill-sm bg-canvas px-4 py-1.5 text-sm text-body ring-1 ring-hairline transition-colors hover:bg-canvas-soft hover:text-ink focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-link"
        >Math</a
      >
      <a
        href="#calculators"
        class="inline-flex items-center rounded-pill-sm bg-canvas px-4 py-1.5 text-sm text-body ring-1 ring-hairline transition-colors hover:bg-canvas-soft hover:text-ink focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-link"
        >Construction</a
      >
      <a
        href="#calculators"
        class="inline-flex items-center rounded-pill-sm bg-canvas px-4 py-1.5 text-sm text-body ring-1 ring-hairline transition-colors hover:bg-canvas-soft hover:text-ink focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-link"
        >Pets</a
      >
    </div>
  </div>
</section>
