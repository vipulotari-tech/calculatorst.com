---
interface Input { id: string; label: string; unit?: string; }
interface Props { slug: string; cluster?: string; h1?: string; title?: string; inputs?: Input[]; formula?: string; }
const { slug, cluster="generic", h1, title, inputs=[], formula } = Astro.props;
const label = (h1 || title || slug).trim();
const hash = [...slug].reduce((a,c)=>a+c.charCodeAt(0),0);
const accents = ["#0070f3","#7928ca","#ab570a","#29bc9b","#ee0000","#0761d1"] as const;
const accent = accents[hash % accents.length];
const accent2 = accents[(hash+2)%accents.length];
const words = label.replace(/Calculator/i,"").trim();
const short = words.slice(0,26);
const dimA = inputs[0]?.label || "Length";
const dimB = inputs[1]?.label || "Width";
const dimC = inputs[2]?.label || "Depth";
const unitA = inputs[0]?.unit || "ft";
const unitB = inputs[1]?.unit || "ft";
const unitC = inputs[2]?.unit || "in";
const exL = 10 + (hash % 14);
const exW = 8 + ((hash>>2) % 10);
const exD = [3,4,6,8,10][hash%5];
const waste = [5,7,10,12][hash%4];
const isPitch = slug.includes("pitch") || /pitch/i.test(label);
const isRoof = slug.includes("roof") && !isPitch;
const isRebar = cluster==="rebar" || /rebar/i.test(label);
const isBrick = cluster==="brick" || cluster==="cmu" || /brick|block|cmu/i.test(label);
const isFence = /fence|gate/i.test(label);
const isDeck = /deck/i.test(label);
const isPaver = /paver|tile/i.test(label);
const isTube = slug.includes("tube") || slug.includes("circular-slab");
const isColumn = slug.includes("column") && !isTube;
const isCurb = slug.includes("curb");
const isStair = slug.includes("stair");
const isRamp = slug.includes("ramp");
const isConcrete = cluster==="concrete";
const kind = isTube ? "tube" : isColumn ? "column" : isCurb ? "curb" : isStair ? "stair" : isRamp ? "ramp" : isPitch ? "pitch" : isRoof ? "roof" : isRebar ? "rebar" : isBrick ? "brick" : isFence ? "fence" : isDeck ? "deck" : isPaver ? "paver" : "volume";
---
<figure class="overflow-hidden rounded-lg border border-border bg-card shadow-card">
  <div class="bg-muted px-4 py-2 flex items-center justify-between border-b border-border gap-2">
    <span class="font-mono text-[11px] tracking-widest text-muted-foreground truncate">VISUAL GUIDE — {label.toUpperCase()}</span>
    <span class="font-mono text-[10px] px-2 py-0.5 rounded-full border border-border bg-white text-muted-foreground dark:bg-white/[0.06] dark:text-muted-foreground shrink-0">{cluster} · {slug}</span>
  </div>

  {kind==="pitch" && (
    <div class="p-5 bg-card">
      <p class="text-center font-mono text-[11px] text-muted-foreground mb-3">{short} — rise : run</p>
      <svg viewBox="0 0 700 200" class="w-full h-auto" role="img"><title>{label} pitch</title><rect x="0" y="0" width="700" height="200" rx="8" fill="var(--color-background)" stroke="var(--color-border)"/><polygon points="120,150 480,150 480,60" fill="var(--color-card)" stroke="var(--color-foreground)" stroke-width="1.5"/><line x1="500" y1="60" x2="500" y2="150" stroke={accent} stroke-width="1.5"/><rect x="508" y="96" width="48" height="18" rx="9" fill={accent}/><text x="532" y="109" text-anchor="middle" font-size="10" fill="var(--color-card)" font-weight="700">{exD}" rise</text><line x1="120" y1="168" x2="480" y2="168" stroke={accent2} stroke-width="1.5"/><rect x="285" y="172" width="60" height="18" rx="9" fill={accent2}/><text x="315" y="185" text-anchor="middle" font-size="10" fill="var(--color-card)" font-weight="700">12" run</text><text x="300" y="105" text-anchor="middle" font-size="11" fill="var(--color-foreground)" font-weight="600">{words}</text><text x="300" y="120" text-anchor="middle" font-size="9" fill="var(--color-muted-foreground)" font-family="Geist Mono,monospace">{exD}:12 · {(Math.atan(exD/12)*180/Math.PI).toFixed(1)}°</text></svg>
      <p class="mt-2 text-center font-mono text-[11px] text-muted-foreground">{dimA} {exL}{unitA} · pitch {exD}:12 → {(Math.sqrt(exD*exD+144)/12).toFixed(3)}×</p>
    </div>
  )}

  {kind==="roof" && (
    <div class="p-5 bg-card">
      <p class="text-center font-mono text-[11px] text-muted-foreground mb-3">{short} — footprint + overhang</p>
      <svg viewBox="0 0 700 200" class="w-full h-auto" role="img"><title>{label} roof</title><rect x="0" y="0" width="700" height="200" rx="8" fill="var(--color-background)" stroke="var(--color-border)"/><rect x="80" y="70" width="300" height="90" rx="4" fill="var(--color-card)" stroke="var(--color-foreground)" stroke-dasharray="6 4"/><rect x="60" y="50" width="340" height="130" rx="6" fill="none" stroke={accent} stroke-width="1.2"/><text x="230" y="40" text-anchor="middle" font-size="9" fill={accent} font-family="Geist Mono,monospace">+1.5 ft overhang</text><text x="230" y="100" text-anchor="middle" font-size="10" fill="var(--color-muted-foreground)" font-weight="600">{exL}×{exW} ft footprint</text><g transform="translate(480 50)"><polygon points="0,80 80,80 80,40" fill="var(--color-card)" stroke="var(--color-foreground)"/><text x="88" y="65" font-size="9" fill={accent} font-weight="700">{exD}"</text><text x="40" y="55" font-size="9" fill="#ab570a" font-weight="700">×{(Math.sqrt(exD*exD+144)/12).toFixed(3)}</text></g><text x="520" y="155" text-anchor="middle" font-size="10" fill="var(--color-foreground)" font-weight="600">→ {Math.round(exL*exW*Math.sqrt(exD*exD+144)/12)} ft²</text></svg>
    </div>
  )}

  {kind==="rebar" && (
    <div class="grid md:grid-cols-2 gap-0 divide-y md:divide-y-0 md:divide-x divide-hairline">
      <div class="p-5 bg-card"><p class="text-center font-mono text-[11px] text-muted-foreground mb-3">{dimA} → {dimB} spacing</p><svg viewBox="0 0 360 220" class="w-full h-auto" role="img"><title>{label} rebar</title><rect x="0" y="0" width="360" height="220" rx="8" fill="var(--color-background)" stroke="var(--color-border)"/><rect x="40" y="60" width="280" height="80" rx="4" fill="var(--color-card)" stroke="var(--color-foreground)"/><line x1="60" y1="60" x2="60" y2="140" stroke={accent} stroke-width="1.4"/><line x1="95" y1="60" x2="95" y2="140" stroke={accent} stroke-width="1"/><line x1="130" y1="60" x2="130" y2="140" stroke={accent} stroke-width="1" stroke-dasharray="3 3"/><line x1="165" y1="60" x2="165" y2="140" stroke={accent} stroke-width="1"/><line x1="200" y1="60" x2="200" y2="140" stroke={accent} stroke-width="1"/><text x="180" y="108" text-anchor="middle" font-size="11" fill="var(--color-foreground)" font-weight="600">{words}</text><text x="180" y="123" text-anchor="middle" font-size="9" fill="var(--color-muted-foreground)" font-family="Geist Mono,monospace">ceil({exL}/{(8+hash%10)/12})+1 bars</text></svg></div>
      <div class="p-5 bg-card"><p class="text-center font-mono text-[11px] text-muted-foreground mb-3">Cross-section · cover 3"</p><svg viewBox="0 0 360 220" class="w-full h-auto" role="img"><title>{label} section</title><rect x="0" y="0" width="360" height="220" rx="8" fill="var(--color-background)" stroke="var(--color-border)"/><rect x="60" y="70" width="240" height="80" rx="4" fill="var(--color-card)" stroke="var(--color-foreground)"/><circle cx="90" cy="95" r="6" fill="none" stroke={accent} stroke-width="1.5"/><circle cx="180" cy="95" r="6" fill="none" stroke={accent} stroke-width="1.5"/><circle cx="270" cy="95" r="6" fill="none" stroke={accent} stroke-width="1.5"/><text x="180" y="50" text-anchor="middle" font-size="10" fill="var(--color-foreground)" font-weight="600">Lap 40×d</text></svg><p class="mt-2 text-center font-mono text-[11px] text-muted-foreground">{formula || "count = ceil(L/spacing)+1"} · {waste}% waste</p></div>
    </div>
  )}

  {kind==="brick" && (
    <div class="p-5 bg-card"><p class="text-center font-mono text-[11px] text-muted-foreground mb-3">{short} — {dimA} × {dimB} · 3/8" joint</p><svg viewBox="0 0 700 180" class="w-full h-auto" role="img"><title>{label} brick</title><rect x="0" y="0" width="700" height="180" rx="8" fill="var(--color-background)" stroke="var(--color-border)"/><g transform="translate(80 40)"><rect x="0" y="0" width="60" height="22" rx="1" fill="#ffefcf" stroke={accent}/><rect x="64" y="0" width="60" height="22" rx="1" fill="#ffefcf" stroke={accent}/><rect x="128" y="0" width="60" height="22" rx="1" fill="#ffefcf" stroke={accent}/><rect x="0" y="26" width="60" height="22" rx="1" fill="#ffefcf" stroke={accent}/><rect x="64" y="26" width="60" height="22" rx="1" fill="#ffefcf" stroke={accent2}/><rect x="128" y="26" width="60" height="22" rx="1" fill="#ffefcf" stroke={accent}/></g><text x="350" y="100" font-size="10" fill="var(--color-foreground)" font-weight="600">{words}</text><text x="350" y="115" font-size="9" fill="var(--color-muted-foreground)">{exL*exW} ft² → ~{Math.round(exL*exW*6.8)} bricks +{waste}%</text></svg></div>
  )}

  {kind==="fence" && (
    <div class="p-5 bg-card"><p class="text-center font-mono text-[11px] text-muted-foreground mb-3">{short} — posts {8+hash%4} ft o.c.</p><svg viewBox="0 0 700 180" class="w-full h-auto" role="img"><title>{label} fence</title><rect x="0" y="0" width="700" height="180" rx="8" fill="var(--color-background)" stroke="var(--color-border)"/><line x1="40" y1="135" x2="660" y2="135" stroke="var(--color-muted-foreground)" stroke-width="1.5"/><rect x="60" y="65" width="10" height="70" rx="1" fill="var(--color-foreground)"/><rect x="200" y="65" width="10" height="70" rx="1" fill="var(--color-foreground)"/><rect x="340" y="65" width="10" height="70" rx="1" fill="var(--color-foreground)"/><rect x="480" y="65" width="10" height="70" rx="1" fill="var(--color-foreground)"/><rect x="620" y="65" width="10" height="70" rx="1" fill="var(--color-foreground)"/><rect x="70" y="75" width="130" height="45" rx="2" fill="var(--color-card)" stroke="var(--color-muted-foreground)"/><rect x="350" y="75" width="130" height="45" rx="2" fill="#ffefcf" stroke={accent} stroke-dasharray="4 3"/><text x="415" y="102" text-anchor="middle" font-size="10" fill={accent} font-weight="700">GATE · {words}</text><line x1="70" y1="45" x2="200" y2="45" stroke={accent} stroke-width="1"/><rect x="120" y="28" width="36" height="14" rx="7" fill={accent}/><text x="138" y="38" text-anchor="middle" font-size="8" fill="var(--color-card)" font-weight="700">{8+hash%4} ft</text></svg></div>
  )}

  {kind==="deck" && (
    <div class="p-5 bg-card"><p class="text-center font-mono text-[11px] text-muted-foreground mb-3">{short} — 5.5" boards + gap</p><svg viewBox="0 0 700 200" class="w-full h-auto" role="img"><title>{label} deck</title><rect x="0" y="0" width="700" height="200" rx="8" fill="var(--color-background)" stroke="var(--color-border)"/><rect x="40" y="40" width="420" height="120" rx="4" fill="var(--color-card)" stroke="var(--color-foreground)"/><g stroke={accent} stroke-dasharray="4 3" opacity="0.6"><line x1="80" y1="40" x2="80" y2="160"/><line x1="140" y1="40" x2="140" y2="160"/><line x1="200" y1="40" x2="200" y2="160"/></g><g fill="#ffefcf" stroke="#f5a623"><rect x="40" y="45" width="420" height="14" rx="1"/><rect x="40" y="63" width="420" height="14" rx="1"/><rect x="40" y="81" width="420" height="14" rx="1"/><rect x="40" y="99" width="420" height="14" rx="1"/></g><text x="250" y="30" text-anchor="middle" font-size="10" fill="var(--color-foreground)" font-weight="600">{exL}×{exW} ft — {words} · {Math.ceil(exW*12/5.625)} boards</text></svg></div>
  )}

  {kind==="paver" && (
    <div class="grid md:grid-cols-2 gap-0 divide-y md:divide-y-0 md:divide-x divide-hairline">
      <div class="p-4 bg-card"><p class="text-center font-mono text-[11px] text-muted-foreground mb-2">{short} — 12" pavers</p><svg viewBox="0 0 320 180" class="w-full h-auto" role="img"><title>{label} pavers</title><rect x="0" y="0" width="320" height="180" rx="8" fill="var(--color-background)" stroke="var(--color-border)"/><rect x="20" y="30" width="200" height="120" rx="4" fill="var(--color-card)" stroke="var(--color-foreground)"/><g fill="var(--color-card)" stroke="var(--color-border)"><rect x="20" y="30" width="48" height="38" rx="1" stroke={accent} stroke-width="1.2"/><rect x="70" y="30" width="48" height="38" rx="1"/><rect x="120" y="30" width="48" height="38" rx="1"/><rect x="170" y="30" width="50" height="38" rx="1"/><rect x="70" y="70" width="48" height="38" rx="1" fill="#ffefcf" stroke={accent2}/></g><text x="270" y="90" text-anchor="middle" font-size="10" fill="var(--color-foreground)" font-weight="600">×{Math.round(exL*exW*(1+waste/100))}</text></svg></div>
      <div class="p-4 bg-card"><p class="text-center font-mono text-[11px] text-muted-foreground mb-2">Base 4" + sand 1"</p><svg viewBox="0 0 320 180" class="w-full h-auto" role="img"><title>{label} base</title><rect x="0" y="0" width="320" height="180" rx="8" fill="var(--color-background)" stroke="var(--color-border)"/><rect x="20" y="95" width="280" height="30" rx="2" fill="#d3e5ff" stroke={accent}/><text x="160" y="115" text-anchor="middle" font-size="9" fill={accent} font-weight="600">Gravel base 4" · {words}</text><rect x="20" y="80" width="280" height="15" rx="2" fill="#ffefcf" stroke="#f5a623"/></svg></div>
    </div>
  )}

  {kind==="tube" && (
    <div class="grid md:grid-cols-2 gap-0 divide-y md:divide-y-0 md:divide-x divide-hairline">
      <div class="p-5 bg-card"><p class="text-center font-mono text-[11px] text-muted-foreground mb-3">TOP VIEW — Outer vs Inner</p><svg viewBox="0 0 360 220" class="w-full h-auto" role="img"><title>{label} tube top</title><rect x="0" y="0" width="360" height="220" rx="8" fill="var(--color-background)" stroke="var(--color-border)"/><circle cx="180" cy="110" r="70" fill="none" stroke={accent} stroke-width="1.8"/><circle cx="180" cy="110" r="42" fill="var(--color-card)" stroke={accent2} stroke-width="1.5" stroke-dasharray="6 4"/><circle cx="180" cy="110" r="70" fill={accent} opacity="0.08"/><line x1="180" y1="40" x2="250" y2="40" stroke={accent} stroke-width="1"/><polygon points="250,40 242,36 242,44" fill={accent}/><polygon points="180,40 188,36 188,44" fill={accent}/><text x="215" y="32" text-anchor="middle" font-size="9" fill={accent} font-weight="700">Do 12"</text><line x1="180" y1="110" x2="222" y2="110" stroke={accent2} stroke-width="1" stroke-dasharray="4 3"/><text x="202" y="102" text-anchor="middle" font-size="8" fill={accent2} font-weight="600">Di 8"</text><text x="180" y="170" text-anchor="middle" font-size="10" fill="var(--color-foreground)" font-weight="600">Hollow — {words}</text><text x="180" y="185" text-anchor="middle" font-size="9" fill="var(--color-muted-foreground)" font-family="Geist Mono,monospace">Area = π*((Do/2)²-(Di/2)²) · 0.436 ft²</text></svg></div>
      <div class="p-5 bg-card"><p class="text-center font-mono text-[11px] text-muted-foreground mb-3">SIDE VIEW — Height</p><svg viewBox="0 0 360 220" class="w-full h-auto" role="img"><title>{label} tube side</title><rect x="0" y="0" width="360" height="220" rx="8" fill="var(--color-background)" stroke="var(--color-border)"/><rect x="110" y="40" width="140" height="120" rx="6" fill="var(--color-card)" stroke={accent} stroke-width="1.5"/><rect x="130" y="40" width="100" height="120" rx="4" fill="var(--color-background)" stroke={accent2} stroke-width="1.2" stroke-dasharray="5 3"/><line x1="270" y1="40" x2="270" y2="160" stroke="var(--color-foreground)" stroke-width="1"/><polygon points="270,40 266,48 274,48" fill="var(--color-foreground)"/><polygon points="270,160 266,152 274,152" fill="var(--color-foreground)"/><rect x="278" y="88" width="40" height="16" rx="8" fill="var(--color-foreground)"/><text x="298" y="99" text-anchor="middle" font-size="8" fill="var(--color-card)" font-weight="700">8 ft</text><text x="180" y="185" text-anchor="middle" font-size="9" fill="var(--color-muted-foreground)">Hollow saves 44% vs solid</text></svg></div>
    </div>
  )}

  {kind==="column" && (
    <div class="grid md:grid-cols-2 gap-0 divide-y md:divide-y-0 md:divide-x divide-hairline">
      <div class="p-5 bg-card"><p class="text-center font-mono text-[11px] text-muted-foreground mb-3">TOP VIEW — Diameter</p><svg viewBox="0 0 360 220" class="w-full h-auto" role="img"><title>{label} column top</title><rect x="0" y="0" width="360" height="220" rx="8" fill="var(--color-background)" stroke="var(--color-border)"/><circle cx="180" cy="110" r="60" fill="var(--color-card)" stroke={accent} stroke-width="1.8"/><circle cx="180" cy="110" r="60" fill={accent} opacity="0.08"/><line x1="120" y1="110" x2="240" y2="110" stroke={accent} stroke-width="1.2" stroke-dasharray="6 4"/><polygon points="120,110 128,106 128,114" fill={accent}/><polygon points="240,110 232,106 232,114" fill={accent}/><text x="180" y="92" text-anchor="middle" font-size="9" fill={accent} font-weight="700">Diameter 12"</text><text x="180" y="150" text-anchor="middle" font-size="10" fill="var(--color-foreground)" font-weight="600">Area 0.785 ft²</text></svg></div>
      <div class="p-5 bg-card"><p class="text-center font-mono text-[11px] text-muted-foreground mb-3">SIDE VIEW — Height</p><svg viewBox="0 0 360 220" class="w-full h-auto" role="img"><title>{label} column side</title><rect x="0" y="0" width="360" height="220" rx="8" fill="var(--color-background)" stroke="var(--color-border)"/><rect x="130" y="40" width="100" height="120" rx="50" fill="var(--color-card)" stroke={accent} stroke-width="1.5"/><ellipse cx="180" cy="40" rx="50" ry="12" fill="var(--color-card)" stroke={accent} stroke-width="1.5"/><line x1="250" y1="40" x2="250" y2="160" stroke="var(--color-foreground)" stroke-width="1"/><rect x="258" y="88" width="40" height="16" rx="8" fill="var(--color-foreground)"/><text x="278" y="99" text-anchor="middle" font-size="8" fill="var(--color-card)" font-weight="700">8 ft</text></svg></div>
    </div>
  )}

  {kind==="curb" && (
    <div class="grid md:grid-cols-2 gap-0 divide-y md:divide-y-0 md:divide-x divide-hairline">
      <div class="p-5 bg-card"><p class="text-center font-mono text-[11px] text-muted-foreground mb-3">CROSS-SECTION — Curb + Gutter</p><svg viewBox="0 0 360 220" class="w-full h-auto" role="img"><title>{label} curb section</title><rect x="0" y="0" width="360" height="220" rx="8" fill="var(--color-background)" stroke="var(--color-border)"/><rect x="40" y="160" width="280" height="4" rx="1" fill="var(--color-foreground)" opacity="0.3"/><path d="M100 100 L100 160 L160 160 L160 110 L180 110 L180 100 Z" fill="var(--color-card)" stroke={accent} stroke-width="1.5"/><path d="M160 110 L280 110 L280 130 L160 130 Z" fill="#ffefcf" stroke="#ab570a" stroke-width="1.2"/><text x="130" y="85" text-anchor="middle" font-size="8" fill={accent} font-weight="700">Curb 6×6</text><text x="220" y="98" text-anchor="middle" font-size="8" fill="#ab570a" font-weight="700">Gutter 18×6</text><line x1="100" y1="75" x2="160" y2="75" stroke={accent2} stroke-width="1"/><text x="130" y="68" text-anchor="middle" font-size="7" fill={accent2}>6"</text></svg></div>
      <div class="p-5 bg-card"><p class="text-center font-mono text-[11px] text-muted-foreground mb-3">PLAN VIEW — Length</p><svg viewBox="0 0 360 220" class="w-full h-auto" role="img"><title>{label} curb plan</title><rect x="0" y="0" width="360" height="220" rx="8" fill="var(--color-background)" stroke="var(--color-border)"/><rect x="40" y="90" width="280" height="28" rx="2" fill="var(--color-card)" stroke={accent} stroke-width="1.5"/><line x1="40" y1="70" x2="320" y2="70" stroke="var(--color-foreground)" stroke-width="1"/><polygon points="40,70 48,66 48,74" fill="var(--color-foreground)"/><polygon points="320,70 312,66 312,74" fill="var(--color-foreground)"/><text x="180" y="60" text-anchor="middle" font-size="9" fill="var(--color-foreground)" font-weight="700">Length 20 ft</text><text x="180" y="135" text-anchor="middle" font-size="9" fill="var(--color-muted-foreground)">1.0 ft² × Length = 20 ft³</text></svg></div>
    </div>
  )}

  {kind==="stair" && (
    <div class="grid md:grid-cols-2 gap-0 divide-y md:divide-y-0 md:divide-x divide-hairline">
      <div class="p-5 bg-card"><p class="text-center font-mono text-[11px] text-muted-foreground mb-3">SIDE VIEW — Rise × Run × Steps</p><svg viewBox="0 0 360 220" class="w-full h-auto" role="img"><title>{label} stair side</title><rect x="0" y="0" width="360" height="220" rx="8" fill="var(--color-background)" stroke="var(--color-border)"/><path d="M60 160 L60 140 L90 140 L90 120 L120 120 L120 100 L150 100 L150 80 L180 80 L180 160 Z" fill="var(--color-card)" stroke={accent} stroke-width="1.5" stroke-linejoin="round"/><line x1="60" y1="140" x2="90" y2="140" stroke={accent2} stroke-width="1" stroke-dasharray="4 3"/><text x="75" y="135" text-anchor="middle" font-size="7" fill={accent2}>Run 11"</text><line x1="90" y1="120" x2="90" y2="140" stroke="#ee0000" stroke-width="1"/><text x="100" y="133" font-size="7" fill="#ee0000">Rise 7"</text><text x="125" y="170" text-anchor="middle" font-size="9" fill="var(--color-foreground)" font-weight="600">4 steps + platform</text></svg></div>
      <div class="p-5 bg-card"><p class="text-center font-mono text-[11px] text-muted-foreground mb-3">TOP VIEW — Width</p><svg viewBox="0 0 360 220" class="w-full h-auto" role="img"><title>{label} stair top</title><rect x="0" y="0" width="360" height="220" rx="8" fill="var(--color-background)" stroke="var(--color-border)"/><rect x="80" y="60" width="200" height="100" rx="4" fill="var(--color-card)" stroke={accent} stroke-width="1.5"/><line x1="80" y1="80" x2="280" y2="80" stroke="var(--color-border)"/><line x1="80" y1="100" x2="280" y2="100" stroke="var(--color-border)"/><line x1="80" y1="120" x2="280" y2="120" stroke="var(--color-border)"/><line x1="80" y1="140" x2="280" y2="140" stroke="var(--color-border)"/><line x1="180" y1="60" x2="180" y2="160" stroke={accent2} stroke-dasharray="5 3"/><text x="180" y="45" text-anchor="middle" font-size="9" fill={accent2} font-weight="700">Width 4 ft</text></svg></div>
    </div>
  )}

  {kind==="ramp" && (
    <div class="grid md:grid-cols-2 gap-0 divide-y md:divide-y-0 md:divide-x divide-hairline">
      <div class="p-5 bg-card"><p class="text-center font-mono text-[11px] text-muted-foreground mb-3">SIDE VIEW — Wedge L×W×H/2</p><svg viewBox="0 0 360 220" class="w-full h-auto" role="img"><title>{label} ramp side</title><rect x="0" y="0" width="360" height="220" rx="8" fill="var(--color-background)" stroke="var(--color-border)"/><polygon points="60,160 60,120 260,120 260,160" fill="var(--color-card)" stroke="var(--color-foreground)" stroke-width="1" opacity="0.2"/><polygon points="60,120 260,120 260,80 60,120" fill="var(--color-card)" stroke={accent} stroke-width="1.5"/><line x1="260" y1="80" x2="260" y2="160" stroke="#ee0000" stroke-width="1.2"/><text x="278" y="120" font-size="8" fill="#ee0000" font-weight="700">H 6"</text><line x1="60" y1="170" x2="260" y2="170" stroke="var(--color-foreground)" stroke-width="1"/><text x="160" y="188" text-anchor="middle" font-size="9" fill="var(--color-foreground)" font-weight="700">Length 10 ft</text><text x="150" y="110" text-anchor="middle" font-size="9" fill={accent} font-weight="600">L×W×H/2</text></svg></div>
      <div class="p-5 bg-card"><p class="text-center font-mono text-[11px] text-muted-foreground mb-3">ISOMETRIC — Thickness 0→H</p><svg viewBox="0 0 360 220" class="w-full h-auto" role="img"><title>{label} ramp iso</title><rect x="0" y="0" width="360" height="220" rx="8" fill="var(--color-background)" stroke="var(--color-border)"/><path d="M80 140 L200 90 L280 90 L280 130 L160 180 Z" fill="var(--color-card)" stroke={accent} stroke-width="1.5"/><path d="M80 140 L80 155 L160 180 L160 165 Z" fill="var(--color-muted)" stroke="var(--color-foreground)"/><path d="M160 165 L280 130 L280 115 L160 150 Z" fill="var(--color-background)" stroke="var(--color-foreground)"/></svg></div>
    </div>
  )}

  {(kind==="volume") && (
    <div class="grid md:grid-cols-2 gap-0 divide-y md:divide-y-0 md:divide-x divide-hairline">
      <div class="p-5 bg-card"><p class="text-center font-mono text-[11px] text-muted-foreground mb-3">TOP VIEW — {dimA} × {dimB}</p><svg viewBox="0 0 360 220" class="w-full h-auto" role="img"><title>{label} top</title><rect x="0" y="0" width="360" height="220" rx="8" fill="var(--color-background)" stroke="var(--color-border)"/><rect x="50" y="45" width="220" height="110" rx="6" fill="var(--color-card)" stroke="var(--color-foreground)" stroke-width="1.5"/><rect x="50" y="45" width="220" height="110" rx="6" fill="none" stroke={accent} stroke-dasharray="6 4" opacity="0.5"/><line x1="50" y1="22" x2="270" y2="22" stroke="var(--color-foreground)" stroke-width="1"/><rect x="125" y="6" width="70" height="16" rx="8" fill="var(--color-card)" stroke="var(--color-border)"/><text x="160" y="17" text-anchor="middle" font-size="10" font-family="Geist Mono,monospace" fill="var(--color-foreground)" font-weight="600">{dimA} {exL}{unitA}</text><line x1="22" y1="45" x2="22" y2="155" stroke="var(--color-foreground)" stroke-width="1"/><g transform="rotate(-90 22 100)"><rect x="-10" y="92" width="52" height="16" rx="8" fill="var(--color-card)" stroke="var(--color-border)"/><text x="16" y="103" text-anchor="middle" font-size="10" font-family="Geist Mono,monospace" fill="var(--color-foreground)" font-weight="600">{dimB}</text></g><text x="160" y="102" text-anchor="middle" font-size="11" fill="var(--color-muted-foreground)" font-weight="500">{short}</text><text x="160" y="118" text-anchor="middle" font-size="10" font-family="Geist Mono,monospace" fill="var(--color-muted-foreground)">{exL}×{exW} = {exL*exW} {unitA}²</text></svg></div>
      <div class="p-5 bg-card"><p class="text-center font-mono text-[11px] text-muted-foreground mb-3">SECTION — {dimC} {exD}{unitC}</p><svg viewBox="0 0 360 220" class="w-full h-auto" role="img"><title>{label} section</title><rect x="0" y="0" width="360" height="220" rx="8" fill="var(--color-background)" stroke="var(--color-border)"/><rect x="40" y="110" width="280" height="38" rx="2" fill="var(--color-card)" stroke={accent} stroke-width="1.2"/><text x="180" y="133" text-anchor="middle" font-size="11" fill={accent} font-weight="600">{words} {exD}{unitC}</text><line x1="325" y1="110" x2="325" y2="148" stroke="var(--color-foreground)" stroke-width="1"/><rect x="330" y="122" width="22" height="14" rx="7" fill="var(--color-foreground)"/><text x="341" y="132" text-anchor="middle" font-size="8" fill="var(--color-card)" font-weight="600">{exD}"</text><text x="180" y="198" text-anchor="middle" font-size="9" fill="var(--color-muted-foreground)" font-family="Geist Mono,monospace">{formula || "Vol = L×W×D"} · +{waste}% → {(exL*exW*(exD/12)*(1+waste/100)/27).toFixed(2)} yd³</text></svg></div>
    </div>
  )}

  <figcaption class="px-4 py-2 bg-background border-t border-border font-mono text-[11px] leading-4 text-muted-foreground">
    {label} — {formula || `${dimA} × ${dimB} × ${dimC}`} · example {exL}×{exW} @{exD}{unitC} = {(exL*exW*(exD/12)).toFixed(1)} ft³ ({(exL*exW*(exD/12)/27).toFixed(2)} yd³) → {(exL*exW*(exD/12)*(1+waste/100)/27).toFixed(2)} yd³ with {waste}% waste · {slug}
  </figcaption>
</figure>
