    </div>
  </div>

  <details class="mt-3 rounded-lg border border-border bg-muted/20 px-3 py-2">
    <summary class="cursor-pointer text-xs font-medium text-foreground">Formula used by this calculator</summary>
    <p class="mt-2 font-mono text-[11px] leading-5 text-muted-foreground">{formula}</p>
  </details>
</figure>

<script>
  function initPriorityRichDiagrams() {
    document.querySelectorAll<HTMLElement>("[data-priority-rich-diagram]").forEach((figure) => {
      if (figure.dataset.initialized) return;
      figure.dataset.initialized = "true";
      const slug = figure.dataset.prioritySlug;
      if (!slug) return;
      const root = figure.closest<HTMLElement>(`[data-calculator-slug="${slug}"]`);
      if (!root) return;
      const form = root.querySelector<HTMLFormElement>(`#${slug}-form`);
      if (!form) return;

      const unitText = (input: HTMLInputElement) => {
        const select = root.querySelector<HTMLSelectElement>(`#${input.id}-unit`);
        if (select) return select.options[select.selectedIndex]?.text?.trim() ?? select.value;
        const wrap = input.parentElement;
        const staticUnit = wrap?.querySelector("span");
        return staticUnit?.textContent?.trim() ?? "";
      };

      const cleanLabel = (field: HTMLElement) => {
        const label = field.querySelector("label > span span")?.textContent ?? field.querySelector("label")?.textContent ?? "Measurement";
        return label.replace(/\(optional\)/gi, "").replace(/\s+/g, " ").trim().slice(0, 42);
      };

      const activeMeasurements = () => {
        const firstSection = form.querySelector<HTMLElement>("div.space-y-3");
        if (!firstSection) return [];
        return Array.from(firstSection.querySelectorAll<HTMLElement>(".calc-field:not([hidden])"))
          .map((field) => {
            const input = field.querySelector<HTMLInputElement>('input[type="number"]');
            if (!input) return null;
            const raw = input.value.trim();
            const value = raw === "" ? "—" : raw;
            const unit = unitText(input);
            return { label: cleanLabel(field), value: unit ? `${value} ${unit}` : value };
          })
          .filter((x): x is {label:string;value:string} => Boolean(x))
          .slice(0, 4);
      };

      const activeMode = () => {
        const firstSection = form.querySelector<HTMLElement>("div.space-y-3");
        const select = firstSection?.querySelector<HTMLSelectElement>("select");
        if (!select) return "";
        return select.options[select.selectedIndex]?.text?.trim() ?? "";
      };

      const set = (selector: string, text: string) => {
        figure.querySelectorAll<SVGTextElement | HTMLElement>(selector).forEach((el) => { el.textContent = text; });
      };

      const update = () => {
        const values = activeMeasurements();
        for (let i=0;i<4;i++) {
          const item = values[i];
          const text = item ? `${item.label}: ${item.value}` : "";
          set(`[data-live-value="${i}"]`, text);
          if (i < 3) set(`[data-priority-card="${i}"]`, text || "—");
        }
        const summary = values.slice(0,3).map((x)=>x.value).filter(Boolean).join(" × ");
        set("[data-priority-summary]", summary || "Use the active fields above");
        const mode = activeMode();
        if (mode) set("[data-priority-mode]", mode);
      };

      root.addEventListener("input", update);
      root.addEventListener("change", update);
      form.addEventListener("reset", () => setTimeout(update, 0));
      update();
      setTimeout(update, 0);
    });
  }

  initPriorityRichDiagrams();
  document.addEventListener("astro:page-load", initPriorityRichDiagrams);
</script>
