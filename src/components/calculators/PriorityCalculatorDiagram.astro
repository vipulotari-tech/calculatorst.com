      <p class="mt-0.5 font-mono font-medium text-foreground tabular-nums" data-priority-card="0">—</p>
    </div>
    <div class="rounded-md border border-border bg-muted/30 px-3 py-2 text-xs">
      <p class="text-muted-foreground">Input 2</p>
