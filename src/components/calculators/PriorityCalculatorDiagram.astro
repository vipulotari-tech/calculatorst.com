          {[127,162,197,232,267].map((y)=><line x1="78" y1={y} x2="578" y2={y} stroke="var(--color-border)" stroke-width="1.2"/>)}
          {[130,205,280,355,430,505].map((x)=><line x1={x} y1="92" x2={x} y2="127" stroke={kind==="brick" ? "#b45309" : "#64748b"} stroke-width="1"/>)}
          {[92,167,242,317,392,467,542].map((x)=><line x1={x} y1="127" x2={x} y2="162" stroke={kind==="brick" ? "#b45309" : "#64748b"} stroke-width="1"/>)}
          <line x1="78" y1="72" x2="578" y2="72" stroke="#2563eb" stroke-width="1.5" marker-start={`url(#${slug}-arrow-start)`} marker-end={`url(#${slug}-arrow-end)`}/>
          <text x="328" y="62" text-anchor="middle" font-size="12" font-weight="700" fill="#1d4ed8" data-live-value="0">Wall length</text>
          <line x1="58" y1="92" x2="58" y2="302" stroke="#2563eb" stroke-width="1.5" marker-start={`url(#${slug}-arrow-start)`} marker-end={`url(#${slug}-arrow-end)`}/>
          <text x="42" y="197" text-anchor="middle" font-size="12" font-weight="700" fill="#1d4ed8" transform="rotate(-90 42 197)" data-live-value="1">Wall height</text>
          <text x="645" y="148" text-anchor="middle" font-size="11" fill="var(--color-muted-foreground)" data-live-value="2">Unit size</text>
          <text x="645" y="174" text-anchor="middle" font-size="11" fill="var(--color-muted-foreground)" data-live-value="3">Joint / allowance</text>
        </>
