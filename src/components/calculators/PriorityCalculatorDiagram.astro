          <text x="380" y="297" text-anchor="middle" font-size="12" font-weight="700" fill="#1d4ed8" data-live-value="0">Length / base</text>
          <line x1="560" y1="112" x2="560" y2="260" stroke="#2563eb" stroke-width="1.5" marker-start={`url(#${slug}-arrow-start)`} marker-end={`url(#${slug}-arrow-end)`}/>
