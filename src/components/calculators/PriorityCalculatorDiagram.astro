---
interface FieldMeta {
  id: string;
  label: string;
  unit?: string;
  options?: { value: number; label: string }[];
}

interface Props {
  slug: string;
  fields: FieldMeta[];
  formula: string;
}

const { slug, fields, formula } = Astro.props;
const kind =
  slug === "paint-calculator" ? "paint" :
  slug === "gravel-calculator" ? "aggregate" :
  slug === "mulch-calculator" ? "mulch" :
  slug === "roofing-calculator" ? "roof" :
  slug === "roof-pitch-calculator" ? "roofPitch" :
  slug === "flooring-calculator" ? "flooring" :
  slug === "carpet-calculator" ? "carpet" :
  slug === "tile-calculator" ? "tile" :
  slug === "concrete-slab-calculator" ? "slab" :
  slug === "drywall-calculator" ? "drywall" :
  slug === "fence-calculator" ? "fence" :
  slug === "deck-calculator" ? "deck" :
  slug === "paver-calculator" ? "paver" :
  slug === "asphalt-calculator" ? "asphalt" :
  slug === "brick-calculator" ? "brick" :
  slug === "concrete-block-calculator" ? "cmu" :
  slug === "rebar-calculator" ? "rebar" :
  slug === "excavation-calculator" ? "excavation" :
  slug === "earthwork-calculator" ? "earthwork" :
  "generic";

const titleMap: Record<string,string> = {
  paint: "Live paint measurement diagram",
  aggregate: "Live gravel layer diagram",
  mulch: "Live mulch bed diagram",
  roof: "Live roofing geometry diagram",
  roofPitch: "Live roof pitch diagram",
  flooring: "Live flooring layout diagram",
  carpet: "Live carpet roll layout diagram",
  tile: "Live tile layout diagram",
  slab: "Live concrete slab diagram",
  drywall: "Live drywall room diagram",
  fence: "Live fence layout diagram",
  deck: "Live deck framing diagram",
  paver: "Live paver system diagram",
  asphalt: "Live asphalt section diagram",
  brick: "Live brick wall diagram",
  cmu: "Live concrete block wall diagram",
  rebar: "Live rebar grid diagram",
  excavation: "Live excavation section diagram",
  earthwork: "Live earthwork volume diagram",
};
const title = titleMap[kind] ?? "Live project diagram";
---

<figure
  class="calc-project-diagram rounded-xl border border-border bg-card p-4 sm:p-5"
  data-project-diagram
  data-priority-rich-diagram
  data-priority-kind={kind}
  data-priority-slug={slug}
  data-fields={JSON.stringify(fields)}
>
  <div class="flex flex-wrap items-start justify-between gap-2">
    <div>
      <h3 class="text-xs font-mono font-semibold uppercase tracking-wider text-foreground">{title}</h3>
      <p class="mt-1 max-w-[660px] text-[11px] leading-5 text-muted-foreground">
        Technical plan, elevation, or cross-section view tied to the visible calculator measurements. Schematic only — not to scale.
      </p>
    </div>
    <span class="rounded-full border border-border bg-muted px-2 py-1 font-mono text-[10px] text-muted-foreground">LIVE INPUT GUIDE</span>
  </div>

  <div class="mt-4 overflow-hidden rounded-xl border border-border bg-background">
    <svg viewBox="0 0 760 390" class="h-auto w-full" role="img" aria-labelledby={`${slug}-priority-title ${slug}-priority-desc`}>
      <title id={`${slug}-priority-title`}>{title}</title>
      <desc id={`${slug}-priority-desc`}>A responsive technical construction diagram whose labels update from the active calculator inputs.</desc>
      <defs>
        <marker id={`${slug}-arrow-start`} markerWidth="8" markerHeight="8" refX="1" refY="4" orient="auto"><path d="M8 0 L0 4 L8 8 Z" fill="#2563eb"/></marker>
        <marker id={`${slug}-arrow-end`} markerWidth="8" markerHeight="8" refX="7" refY="4" orient="auto"><path d="M0 0 L8 4 L0 8 Z" fill="#2563eb"/></marker>
        <pattern id={`${slug}-speckle`} width="18" height="18" patternUnits="userSpaceOnUse">
          <rect width="18" height="18" fill="var(--color-muted)" opacity=".68"/>
          <circle cx="4" cy="5" r="1.1" fill="var(--color-muted-foreground)" opacity=".28"/>
          <circle cx="13" cy="11" r=".8" fill="var(--color-muted-foreground)" opacity=".22"/>
        </pattern>
        <pattern id={`${slug}-soil`} width="14" height="14" patternUnits="userSpaceOnUse" patternTransform="rotate(22)">
          <rect width="14" height="14" fill="var(--color-muted)" opacity=".2"/>
          <line x1="0" y1="0" x2="0" y2="14" stroke="var(--color-muted-foreground)" stroke-width="1" opacity=".24"/>
        </pattern>
      </defs>
      <rect width="760" height="390" fill="var(--color-background)"/>
      <text x="28" y="30" font-size="13" font-weight="700" fill="var(--color-foreground)">{title}</text>
      <text x="732" y="30" text-anchor="end" font-size="11" fill="var(--color-muted-foreground)" data-priority-mode>Current calculator inputs</text>

      {kind === "paint" && (
        <>
          <text x="42" y="62" font-size="11" font-weight="700" fill="var(--color-foreground)">ROOM WALL ELEVATION</text>
          <rect x="76" y="92" width="400" height="190" fill="var(--color-card)" stroke="var(--color-foreground)" stroke-width="2"/>
          <rect x="118" y="170" width="66" height="112" fill="var(--color-background)" stroke="var(--color-muted-foreground)" stroke-width="1.5"/>
          <rect x="260" y="130" width="110" height="72" fill="var(--color-background)" stroke="var(--color-muted-foreground)" stroke-width="1.5"/>
          <path d="M76 92 H476" stroke="#2563eb" stroke-width="1.7"/>
          <line x1="76" y1="74" x2="476" y2="74" stroke="#2563eb" stroke-width="1.6" marker-start={`url(#${slug}-arrow-start)`} marker-end={`url(#${slug}-arrow-end)`}/>
          <text x="276" y="64" text-anchor="middle" font-size="12" font-weight="700" fill="#1d4ed8" data-live-value="0">Length</text>
          <line x1="54" y1="92" x2="54" y2="282" stroke="#2563eb" stroke-width="1.6" marker-start={`url(#${slug}-arrow-start)`} marker-end={`url(#${slug}-arrow-end)`}/>
          <text x="38" y="187" text-anchor="middle" font-size="12" font-weight="700" fill="#1d4ed8" transform="rotate(-90 38 187)" data-live-value="2">Height</text>
          <g transform="translate(520 95)">
            <rect width="150" height="155" rx="10" fill="var(--color-muted)" opacity=".3" stroke="var(--color-border)"/>
            <path d="M35 50 h80 l-10 75 h-60 z" fill="var(--color-card)" stroke="var(--color-foreground)" stroke-width="2"/>
            <path d="M43 50 q32 -25 64 0" fill="none" stroke="var(--color-foreground)" stroke-width="2"/>
            <text x="75" y="143" text-anchor="middle" font-size="11" fill="var(--color-muted-foreground)">Paint quantity follows net area</text>
          </g>
        </>
      )}

      {["aggregate","mulch","asphalt"].includes(kind) && (
        <>
          <text x="42" y="62" font-size="11" font-weight="700" fill="var(--color-foreground)">TOP VIEW</text>
          <rect x="78" y="96" width="390" height="164" rx="5" fill="var(--color-card)" stroke="var(--color-foreground)" stroke-width="2"/>
          <line x1="78" y1="77" x2="468" y2="77" stroke="#2563eb" stroke-width="1.6" marker-start={`url(#${slug}-arrow-start)`} marker-end={`url(#${slug}-arrow-end)`}/>
          <text x="273" y="67" text-anchor="middle" font-size="12" font-weight="700" fill="#1d4ed8" data-live-value="0">Length</text>
          <line x1="58" y1="96" x2="58" y2="260" stroke="#2563eb" stroke-width="1.6" marker-start={`url(#${slug}-arrow-start)`} marker-end={`url(#${slug}-arrow-end)`}/>
          <text x="42" y="178" text-anchor="middle" font-size="12" font-weight="700" fill="#1d4ed8" transform="rotate(-90 42 178)" data-live-value="1">Width</text>
          <text x="515" y="62" font-size="11" font-weight="700" fill="var(--color-foreground)">CROSS SECTION</text>
          <rect x="520" y="112" width="190" height="44" fill={kind==="asphalt" ? "var(--color-foreground)" : `url(#${slug}-speckle)`} opacity={kind==="asphalt" ? ".72" : "1"} stroke="var(--color-foreground)" stroke-width="2"/>
          <rect x="520" y="156" width="190" height="44" fill={kind==="mulch" ? "#d6a75f" : `url(#${slug}-speckle)`} opacity=".7" stroke="var(--color-muted-foreground)" stroke-width="1"/>
          <rect x="520" y="200" width="190" height="42" fill={`url(#${slug}-soil)`}/>
          <line x1="728" y1="112" x2="728" y2="156" stroke="#2563eb" stroke-width="1.6" marker-start={`url(#${slug}-arrow-start)`} marker-end={`url(#${slug}-arrow-end)`}/>
          <text x="718" y="178" text-anchor="end" font-size="12" font-weight="700" fill="#1d4ed8" data-live-value="2">Depth</text>
          <text x="614" y="268" text-anchor="middle" font-size="10.5" fill="var(--color-muted-foreground)">{kind==="asphalt" ? "Compacted asphalt over base" : kind==="mulch" ? "Mulch layer over soil" : "Placed aggregate layer"}</text>
        </>
      )}

      {["roof","roofPitch"].includes(kind) && (
        <>
          <text x="42" y="62" font-size="11" font-weight="700" fill="var(--color-foreground)">ROOF SECTION</text>
          <path d="M80 260 L285 104 L490 260" fill="none" stroke="var(--color-foreground)" stroke-width="3"/>
          <line x1="80" y1="260" x2="490" y2="260" stroke="var(--color-muted-foreground)" stroke-width="1.5"/>
          <line x1="285" y1="104" x2="285" y2="260" stroke="#2563eb" stroke-width="1.4" stroke-dasharray="5 4"/>
          <line x1="285" y1="280" x2="490" y2="280" stroke="#2563eb" stroke-width="1.5" marker-start={`url(#${slug}-arrow-start)`} marker-end={`url(#${slug}-arrow-end)`}/>
          <text x="388" y="300" text-anchor="middle" font-size="12" font-weight="700" fill="#1d4ed8" data-live-value="0">Run / span</text>
          <text x="300" y="183" font-size="12" font-weight="700" fill="#1d4ed8" data-live-value="1">Rise / pitch</text>
          <text x="385" y="154" text-anchor="middle" font-size="12" font-weight="700" fill="#1d4ed8" data-live-value="2">Rafter / length</text>
          <g transform="translate(540 96)">
            <rect width="150" height="160" rx="10" fill="var(--color-muted)" opacity=".25" stroke="var(--color-border)"/>
            <path d="M20 105 L75 52 L130 105" fill="none" stroke="var(--color-foreground)" stroke-width="2.5"/>
            <line x1="75" y1="52" x2="75" y2="105" stroke="#2563eb" stroke-dasharray="4 4"/>
            <text x="75" y="135" text-anchor="middle" font-size="11" fill="var(--color-muted-foreground)">Pitch controls surface multiplier</text>
          </g>
        </>
      )}

      {kind === "flooring" && (
        <>
          <text x="42" y="62" font-size="11" font-weight="700" fill="var(--color-foreground)">ROOM PLAN / PLANK LAYOUT</text>
          <rect x="78" y="90" width="500" height="205" rx="4" fill="var(--color-card)" stroke="var(--color-foreground)" stroke-width="2"/>
          {[112,146,180,214,248].map((y)=><line x1="78" y1={y} x2="578" y2={y} stroke="#b7791f" stroke-width="1.2"/>)}
          {[180,318,456].map((x)=><line x1={x} y1="90" x2={x} y2="295" stroke="var(--color-border)" stroke-width="1"/>)}
          <line x1="78" y1="70" x2="578" y2="70" stroke="#2563eb" stroke-width="1.5" marker-start={`url(#${slug}-arrow-start)`} marker-end={`url(#${slug}-arrow-end)`}/>
          <text x="328" y="60" text-anchor="middle" font-size="12" font-weight="700" fill="#1d4ed8" data-live-value="0">Length</text>
          <line x1="58" y1="90" x2="58" y2="295" stroke="#2563eb" stroke-width="1.5" marker-start={`url(#${slug}-arrow-start)`} marker-end={`url(#${slug}-arrow-end)`}/>
          <text x="42" y="193" text-anchor="middle" font-size="12" font-weight="700" fill="#1d4ed8" transform="rotate(-90 42 193)" data-live-value="1">Width</text>
          <text x="635" y="154" text-anchor="middle" font-size="11" fill="var(--color-muted-foreground)" data-live-value="2">Coverage/package</text>
        </>
      )}

      {kind === "carpet" && (
        <>
          <text x="42" y="62" font-size="11" font-weight="700" fill="var(--color-foreground)">ROLL STRIP LAYOUT</text>
          <rect x="78" y="92" width="430" height="200" fill="var(--color-card)" stroke="var(--color-foreground)" stroke-width="2"/>
          {[150,222,294,366,438].map((x)=><line x1={x} y1="92" x2={x} y2="292" stroke="#7c3aed" stroke-width="1.4" stroke-dasharray="6 4"/>)}
          <line x1="78" y1="72" x2="508" y2="72" stroke="#2563eb" stroke-width="1.5" marker-start={`url(#${slug}-arrow-start)`} marker-end={`url(#${slug}-arrow-end)`}/>
          <text x="293" y="62" text-anchor="middle" font-size="12" font-weight="700" fill="#1d4ed8" data-live-value="0">Room length</text>
          <line x1="58" y1="92" x2="58" y2="292" stroke="#2563eb" stroke-width="1.5" marker-start={`url(#${slug}-arrow-start)`} marker-end={`url(#${slug}-arrow-end)`}/>
          <text x="42" y="192" text-anchor="middle" font-size="12" font-weight="700" fill="#1d4ed8" transform="rotate(-90 42 192)" data-live-value="1">Room width</text>
          <g transform="translate(555 105)">
            <path d="M0 0 h95 v135 h-95 z" fill="var(--color-muted)" opacity=".3" stroke="var(--color-border)"/>
            <path d="M14 18 h68 v70 h-68 z" fill="#ddd6fe" stroke="#7c3aed"/>
            <path d="M14 88 q34 34 68 0" fill="#ede9fe" stroke="#7c3aed"/>
            <text x="48" y="121" text-anchor="middle" font-size="10.5" fill="var(--color-muted-foreground)" data-live-value="2">Roll width</text>
          </g>
        </>
      )}

      {["tile","paver"].includes(kind) && (
        <>
          <text x="42" y="62" font-size="11" font-weight="700" fill="var(--color-foreground)">{kind==="tile" ? "TILE GRID / JOINTS" : "PAVER FIELD / JOINTS"}</text>
          <rect x="80" y="92" width="430" height="205" fill="var(--color-card)" stroke="var(--color-foreground)" stroke-width="2"/>
          {[134,188,242,296,350,404,458].map((x)=><line x1={x} y1="92" x2={x} y2="297" stroke="var(--color-border)" stroke-width="1.2"/>)}
          {[133,174,215,256].map((y)=><line x1="80" y1={y} x2="510" y2={y} stroke="var(--color-border)" stroke-width="1.2"/>)}
          <rect x="242" y="174" width="54" height="41" fill={kind==="tile" ? "#dbeafe" : "#ffedd5"} stroke={kind==="tile" ? "#2563eb" : "#c2410c"} stroke-width="1.5"/>
          <line x1="80" y1="72" x2="510" y2="72" stroke="#2563eb" stroke-width="1.5" marker-start={`url(#${slug}-arrow-start)`} marker-end={`url(#${slug}-arrow-end)`}/>
          <text x="295" y="62" text-anchor="middle" font-size="12" font-weight="700" fill="#1d4ed8" data-live-value="0">Surface length</text>
          <line x1="58" y1="92" x2="58" y2="297" stroke="#2563eb" stroke-width="1.5" marker-start={`url(#${slug}-arrow-start)`} marker-end={`url(#${slug}-arrow-end)`}/>
          <text x="42" y="195" text-anchor="middle" font-size="12" font-weight="700" fill="#1d4ed8" transform="rotate(-90 42 195)" data-live-value="1">Surface width</text>
          <text x="608" y="140" text-anchor="middle" font-size="11" fill="var(--color-muted-foreground)" data-live-value="2">Unit size</text>
          <text x="608" y="165" text-anchor="middle" font-size="11" fill="var(--color-muted-foreground)" data-live-value="3">Joint / allowance</text>
        </>
      )}

      {kind === "slab" && (
        <>
          <text x="42" y="62" font-size="11" font-weight="700" fill="var(--color-foreground)">SLAB PLAN</text>
          <rect x="82" y="100" width="380" height="160" fill={`url(#${slug}-speckle)`} stroke="var(--color-foreground)" stroke-width="2"/>
          <line x1="82" y1="80" x2="462" y2="80" stroke="#2563eb" stroke-width="1.5" marker-start={`url(#${slug}-arrow-start)`} marker-end={`url(#${slug}-arrow-end)`}/>
          <text x="272" y="70" text-anchor="middle" font-size="12" font-weight="700" fill="#1d4ed8" data-live-value="0">Length / diameter</text>
          <line x1="62" y1="100" x2="62" y2="260" stroke="#2563eb" stroke-width="1.5" marker-start={`url(#${slug}-arrow-start)`} marker-end={`url(#${slug}-arrow-end)`}/>
          <text x="46" y="180" text-anchor="middle" font-size="12" font-weight="700" fill="#1d4ed8" transform="rotate(-90 46 180)" data-live-value="1">Width</text>
          <text x="520" y="62" font-size="11" font-weight="700" fill="var(--color-foreground)">EDGE SECTION</text>
          <path d="M530 128 H700 V172 H675 V222 H555 V172 H530 Z" fill={`url(#${slug}-speckle)`} stroke="var(--color-foreground)" stroke-width="2"/>
          <line x1="720" y1="128" x2="720" y2="172" stroke="#2563eb" stroke-width="1.5" marker-start={`url(#${slug}-arrow-start)`} marker-end={`url(#${slug}-arrow-end)`}/>
          <text x="708" y="193" text-anchor="end" font-size="11.5" font-weight="700" fill="#1d4ed8" data-live-value="2">Thickness</text>
          <text x="615" y="248" text-anchor="middle" font-size="10.5" fill="var(--color-muted-foreground)">Optional thickened edge shown schematically</text>
        </>
      )}

      {kind === "drywall" && (
        <>
          <text x="42" y="62" font-size="11" font-weight="700" fill="var(--color-foreground)">ROOM ENVELOPE</text>
          <path d="M90 268 V108 H390 V268" fill="none" stroke="var(--color-foreground)" stroke-width="2.5"/>
          <path d="M390 108 L500 72 V232 L390 268" fill="var(--color-card)" stroke="var(--color-foreground)" stroke-width="2"/>
          <rect x="132" y="162" width="66" height="106" fill="var(--color-background)" stroke="var(--color-muted-foreground)" stroke-width="1.2"/>
          <rect x="260" y="138" width="92" height="62" fill="var(--color-background)" stroke="var(--color-muted-foreground)" stroke-width="1.2"/>
          <line x1="90" y1="86" x2="390" y2="86" stroke="#2563eb" stroke-width="1.5" marker-start={`url(#${slug}-arrow-start)`} marker-end={`url(#${slug}-arrow-end)`}/>
          <text x="240" y="76" text-anchor="middle" font-size="12" font-weight="700" fill="#1d4ed8" data-live-value="0">Room length</text>
          <line x1="68" y1="108" x2="68" y2="268" stroke="#2563eb" stroke-width="1.5" marker-start={`url(#${slug}-arrow-start)`} marker-end={`url(#${slug}-arrow-end)`}/>
          <text x="52" y="188" text-anchor="middle" font-size="12" font-weight="700" fill="#1d4ed8" transform="rotate(-90 52 188)" data-live-value="2">Wall height</text>
          <g transform="translate(555 115)">
            <rect width="120" height="154" fill="var(--color-card)" stroke="var(--color-foreground)" stroke-width="2"/>
            <line x1="0" y1="51" x2="120" y2="51" stroke="var(--color-border)"/>
            <line x1="0" y1="102" x2="120" y2="102" stroke="var(--color-border)"/>
            <text x="60" y="178" text-anchor="middle" font-size="10.5" fill="var(--color-muted-foreground)" data-live-value="3">Sheet coverage</text>
          </g>
        </>
      )}

      {kind === "fence" && (
        <>
          <text x="42" y="62" font-size="11" font-weight="700" fill="var(--color-foreground)">FENCE ELEVATION</text>
          <line x1="70" y1="282" x2="690" y2="282" stroke="var(--color-muted-foreground)" stroke-width="1.5"/>
          {[90,220,350,480,610].map((x)=><rect x={x} y="105" width="12" height="177" rx="2" fill="var(--color-foreground)"/>)}
          {[110,240,370,500].map((x)=><rect x={x} y="125" width="110" height="132" fill="var(--color-card)" stroke="var(--color-muted-foreground)"/>)}
          <rect x="370" y="125" width="110" height="132" fill="#dbeafe" stroke="#2563eb" stroke-dasharray="5 4"/>
          <line x1="90" y1="82" x2="220" y2="82" stroke="#2563eb" stroke-width="1.5" marker-start={`url(#${slug}-arrow-start)`} marker-end={`url(#${slug}-arrow-end)`}/>
          <text x="155" y="72" text-anchor="middle" font-size="12" font-weight="700" fill="#1d4ed8" data-live-value="1">Post spacing</text>
          <line x1="50" y1="105" x2="50" y2="282" stroke="#2563eb" stroke-width="1.5" marker-start={`url(#${slug}-arrow-start)`} marker-end={`url(#${slug}-arrow-end)`}/>
          <text x="34" y="194" text-anchor="middle" font-size="12" font-weight="700" fill="#1d4ed8" transform="rotate(-90 34 194)" data-live-value="2">Fence height</text>
          <text x="385" y="325" text-anchor="middle" font-size="12" font-weight="700" fill="#1d4ed8" data-live-value="0">Total run</text>
        </>
      )}

      {kind === "deck" && (
        <>
          <text x="42" y="62" font-size="11" font-weight="700" fill="var(--color-foreground)">DECK PLAN / BOARD + JOIST LAYOUT</text>
          <rect x="82" y="92" width="500" height="210" fill="var(--color-card)" stroke="var(--color-foreground)" stroke-width="2"/>
          {[120,160,200,240,280].map((y)=><line x1="82" y1={y} x2="582" y2={y} stroke="#b7791f" stroke-width="1.2"/>)}
          {[130,205,280,355,430,505].map((x)=><line x1={x} y1="92" x2={x} y2="302" stroke="#2563eb" stroke-width="1" stroke-dasharray="5 4"/>)}
          <line x1="82" y1="72" x2="582" y2="72" stroke="#2563eb" stroke-width="1.5" marker-start={`url(#${slug}-arrow-start)`} marker-end={`url(#${slug}-arrow-end)`}/>
          <text x="332" y="62" text-anchor="middle" font-size="12" font-weight="700" fill="#1d4ed8" data-live-value="0">Deck length</text>
          <line x1="62" y1="92" x2="62" y2="302" stroke="#2563eb" stroke-width="1.5" marker-start={`url(#${slug}-arrow-start)`} marker-end={`url(#${slug}-arrow-end)`}/>
          <text x="46" y="197" text-anchor="middle" font-size="12" font-weight="700" fill="#1d4ed8" transform="rotate(-90 46 197)" data-live-value="1">Deck width</text>
          <text x="643" y="150" text-anchor="middle" font-size="11" fill="var(--color-muted-foreground)" data-live-value="2">Board / spacing</text>
        </>
      )}

      {["brick","cmu"].includes(kind) && (
        <>
