      {["excavation","earthwork"].includes(kind) && (
        <>
          <text x="42" y="62" font-size="11" font-weight="700" fill="var(--color-foreground)">{kind==="excavation" ? "EXCAVATION SECTION" : "CUT / FILL EARTHWORK SECTION"}</text>
