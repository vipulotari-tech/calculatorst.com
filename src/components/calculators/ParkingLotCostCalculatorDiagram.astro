---
const slug = "parking-lot-cost-calculator";
---

<figure
  class="calc-project-diagram rounded-xl border border-border bg-card p-4 sm:p-5"
  data-project-diagram
  data-parking-lot-cost-rich-diagram
>
  <div class="flex flex-wrap items-start justify-between gap-2">
    <div>
      <h3 class="text-xs font-mono font-semibold uppercase tracking-wider text-foreground">Live parking-lot cost diagram</h3>
      <p class="mt-1 max-w-[720px] text-[11px] leading-5 text-muted-foreground">
        Paved area, compacted asphalt quantity, quote basis, material subtotal, tax, trucking, fixed paving cost, and entered-scope total update from the calculator inputs. Planning estimate only.
      </p>
    </div>
    <span class="rounded-full border border-border bg-muted px-2 py-1 font-mono text-[10px] text-muted-foreground">LIVE COST BUILDUP</span>
  </div>

  <div class="mt-4 overflow-hidden rounded-xl border border-border bg-background">
    <svg
      viewBox="0 0 760 525"
      class="h-auto w-full"
      role="img"
      aria-labelledby={`${slug}-cost-title ${slug}-cost-desc`}
    >
      <title id={`${slug}-cost-title`}>Live parking lot asphalt cost diagram</title>
      <desc id={`${slug}-cost-desc`}>
        Parking-lot plan, asphalt cross-section, material quantity, quote basis, and a cost buildup from asphalt material through tax, trucking, labor or equipment, and total.
      </desc>

      <defs>
        <marker id="parking-cost-arrow-start" markerWidth="8" markerHeight="8" refX="1" refY="4" orient="auto">
          <path d="M8 0 L0 4 L8 8 Z" fill="#2563eb" />
        </marker>
        <marker id="parking-cost-arrow-end" markerWidth="8" markerHeight="8" refX="7" refY="4" orient="auto">
          <path d="M0 0 L8 4 L0 8 Z" fill="#2563eb" />
        </marker>
        <pattern id="parking-cost-asphalt" width="18" height="18" patternUnits="userSpaceOnUse">
          <rect width="18" height="18" fill="var(--color-foreground)" opacity=".84" />
          <circle cx="4" cy="5" r="1.1" fill="var(--color-background)" opacity=".28" />
          <circle cx="13" cy="11" r=".9" fill="var(--color-background)" opacity=".24" />
          <circle cx="8" cy="15" r=".7" fill="var(--color-background)" opacity=".22" />
        </pattern>
        <pattern id="parking-cost-base" width="22" height="15" patternUnits="userSpaceOnUse">
          <circle cx="5" cy="9" r="2.8" fill="none" stroke="var(--color-muted-foreground)" stroke-width="1" opacity=".30" />
          <circle cx="15" cy="6" r="2.2" fill="none" stroke="var(--color-muted-foreground)" stroke-width="1" opacity=".26" />
          <circle cx="20" cy="13" r="2.5" fill="none" stroke="var(--color-muted-foreground)" stroke-width="1" opacity=".24" />
        </pattern>
      </defs>

      <rect width="760" height="525" fill="var(--color-background)" />
      <text x="28" y="30" font-size="13" font-weight="700" fill="var(--color-foreground)">Parking-lot asphalt quantity + cost</text>
      <text x="732" y="30" text-anchor="end" font-size="11" fill="var(--color-muted-foreground)" data-parking-cost-size>20 ft × 10 ft · 3 in</text>

      <text x="42" y="63" font-size="11" font-weight="700" fill="var(--color-foreground)">PAVED FOOTPRINT</text>
      <rect x="84" y="105" width="332" height="166" rx="6" fill="url(#parking-cost-asphalt)" stroke="var(--color-foreground)" stroke-width="2" />

      <g stroke="var(--color-background)" stroke-width="2" opacity=".72">
        <line x1="106" y1="113" x2="106" y2="166" />
        <line x1="150" y1="113" x2="150" y2="166" />
        <line x1="194" y1="113" x2="194" y2="166" />
        <line x1="238" y1="113" x2="238" y2="166" />
        <line x1="282" y1="113" x2="282" y2="166" />
        <line x1="326" y1="113" x2="326" y2="166" />
        <line x1="370" y1="113" x2="370" y2="166" />
        <line x1="106" y1="210" x2="106" y2="263" />
        <line x1="150" y1="210" x2="150" y2="263" />
        <line x1="194" y1="210" x2="194" y2="263" />
        <line x1="238" y1="210" x2="238" y2="263" />
        <line x1="282" y1="210" x2="282" y2="263" />
        <line x1="326" y1="210" x2="326" y2="263" />
        <line x1="370" y1="210" x2="370" y2="263" />
        <line x1="94" y1="188" x2="406" y2="188" stroke-dasharray="8 8" opacity=".5" />
      </g>

      <line x1="84" y1="84" x2="416" y2="84" stroke="#2563eb" stroke-width="1.7" marker-start="url(#parking-cost-arrow-start)" marker-end="url(#parking-cost-arrow-end)" />
      <text x="250" y="73" text-anchor="middle" font-size="12.5" font-weight="700" fill="#1d4ed8" data-parking-cost-length>Length = 20 ft</text>

      <line x1="61" y1="105" x2="61" y2="271" stroke="#2563eb" stroke-width="1.7" marker-start="url(#parking-cost-arrow-start)" marker-end="url(#parking-cost-arrow-end)" />
      <text x="43" y="188" text-anchor="middle" font-size="12.5" font-weight="700" fill="#1d4ed8" transform="rotate(-90 43 188)" data-parking-cost-width>Width = 10 ft</text>
      <text x="250" y="294" text-anchor="middle" font-size="11" fill="var(--color-muted-foreground)" data-parking-cost-area>200 ft² paved area</text>

      <text x="492" y="63" font-size="11" font-weight="700" fill="var(--color-foreground)">COMPACTED LAYER</text>
      <rect x="503" y="208" width="205" height="45" fill="url(#parking-cost-base)" stroke="var(--color-border)" stroke-width="1.1" />
      <rect x="503" y="165" width="205" height="43" fill="url(#parking-cost-asphalt)" stroke="var(--color-foreground)" stroke-width="2" data-parking-cost-layer />
      <text x="605" y="190" text-anchor="middle" font-size="11.5" font-weight="700" fill="var(--color-background)">ASPHALT</text>
      <text x="605" y="235" text-anchor="middle" font-size="10.5" fill="var(--color-muted-foreground)">Prepared base / subgrade</text>

      <line x1="724" y1="165" x2="724" y2="208" stroke="#2563eb" stroke-width="1.7" marker-start="url(#parking-cost-arrow-start)" marker-end="url(#parking-cost-arrow-end)" data-parking-cost-depth-arrow />
      <line x1="710" y1="165" x2="731" y2="165" stroke="#2563eb" stroke-width="1.05" stroke-dasharray="4 4" data-parking-cost-depth-top />
      <line x1="710" y1="208" x2="731" y2="208" stroke="#2563eb" stroke-width="1.05" stroke-dasharray="4 4" />
      <text x="707" y="151" text-anchor="end" font-size="12.5" font-weight="700" fill="#1d4ed8" data-parking-cost-depth>Thickness = 3 in</text>

      <text x="605" y="276" text-anchor="middle" font-size="10.8" fill="var(--color-muted-foreground)" data-parking-cost-density>Density = 145 lb/ft³</text>
      <text x="605" y="295" text-anchor="middle" font-size="11.8" font-weight="700" fill="#1d4ed8" data-parking-cost-quantity>0.76 yd³ · 1.5 US tons</text>

      <rect x="28" y="320" width="704" height="58" rx="10" fill="var(--color-muted)" opacity=".23" stroke="var(--color-border)" />
      <text x="45" y="341" font-size="10.8" font-weight="700" fill="var(--color-foreground)">COST FORMULA</text>
      <text x="45" y="363" font-size="12.2" font-weight="700" fill="var(--color-foreground)" data-parking-cost-formula>
        Material = quantity × quote; total = material + tax + trucking + labor/equipment
      </text>

      <text x="45" y="403" font-size="10.8" font-weight="700" fill="var(--color-foreground)">ENTERED-SCOPE COST BUILDUP</text>
      <rect x="45" y="414" width="500" height="24" rx="6" fill="var(--color-muted)" opacity=".30" />
      <rect x="45" y="414" width="320" height="24" rx="6" fill="var(--color-foreground)" opacity=".58" data-parking-cost-material-bar />
      <rect x="365" y="414" width="45" height="24" fill="var(--color-foreground)" opacity=".43" data-parking-cost-tax-bar />
      <rect x="410" y="414" width="45" height="24" fill="var(--color-foreground)" opacity=".30" data-parking-cost-delivery-bar />
      <rect x="455" y="414" width="90" height="24" rx="6" fill="var(--color-foreground)" opacity=".18" data-parking-cost-labor-bar />

      <text x="45" y="453" font-size="10.5" fill="var(--color-muted-foreground)" data-parking-cost-breakdown>
        Material $0 + tax $0 + trucking $0 + labor/equipment $0
      </text>

      <g transform="translate(571 397)">
        <rect width="161" height="72" rx="11" fill="var(--color-muted)" opacity=".23" stroke="var(--color-border)" />
        <text x="14" y="22" font-size="10" font-weight="700" fill="var(--color-foreground)">ENTERED-SCOPE TOTAL</text>
        <text x="14" y="50" font-size="20" font-weight="700" fill="#1d4ed8" data-parking-cost-total>$0.00</text>
        <text x="14" y="65" font-size="9.8" fill="var(--color-muted-foreground)" data-parking-cost-basis>$0 / US ton</text>
      </g>

      <text x="45" y="491" font-size="10.3" fill="var(--color-muted-foreground)">
        Excludes unentered scope such as base work, milling, striping, drainage and permits.
      </text>
    </svg>
  </div>

  <dl class="mt-3 grid gap-2 text-xs sm:grid-cols-6">
    <div class="rounded-md border border-border bg-muted/30 px-3 py-2">
      <dt class="text-muted-foreground">Paved area</dt>
      <dd class="mt-0.5 font-mono font-medium text-foreground tabular-nums" data-parking-cost-card-area>200 ft²</dd>
    </div>
    <div class="rounded-md border border-border bg-muted/30 px-3 py-2">
      <dt class="text-muted-foreground">Order volume</dt>
      <dd class="mt-0.5 font-mono font-medium text-foreground tabular-nums" data-parking-cost-card-volume>0.76 yd³</dd>
    </div>
    <div class="rounded-md border border-border bg-muted/30 px-3 py-2">
      <dt class="text-muted-foreground">Asphalt to order</dt>
      <dd class="mt-0.5 font-mono font-medium text-foreground tabular-nums" data-parking-cost-card-tons>1.5 US tons</dd>
    </div>
    <div class="rounded-md border border-border bg-muted/30 px-3 py-2">
      <dt class="text-muted-foreground">Material</dt>
      <dd class="mt-0.5 font-mono font-medium text-foreground tabular-nums" data-parking-cost-card-material>$0.00</dd>
    </div>
    <div class="rounded-md border border-border bg-muted/30 px-3 py-2">
      <dt class="text-muted-foreground">Fixed extras</dt>
      <dd class="mt-0.5 font-mono font-medium text-foreground tabular-nums" data-parking-cost-card-fixed>$0.00</dd>
    </div>
    <div class="rounded-md border border-border bg-muted/30 px-3 py-2">
      <dt class="text-muted-foreground">Total</dt>
      <dd class="mt-0.5 font-mono font-medium text-foreground tabular-nums" data-parking-cost-card-total>$0.00</dd>
    </div>
  </dl>
</figure>

<script>
  function initParkingLotCostRichDiagrams() {
    document.querySelectorAll<HTMLElement>("[data-parking-lot-cost-rich-diagram]").forEach((figure) => {
      if (figure.dataset.initialized) return;
      figure.dataset.initialized = "true";

      const root = figure.closest<HTMLElement>('[data-calculator-slug="parking-lot-cost-calculator"]');
      if (!root) return;
      const form = root.querySelector<HTMLFormElement>("#parking-lot-cost-calculator-form");
      if (!form) return;

      const input = (id: string) => root.querySelector<HTMLInputElement>("#parking-lot-cost-calculator-" + id);
      const unit = (id: string) => root.querySelector<HTMLSelectElement>("#parking-lot-cost-calculator-" + id + "-unit");

      const unitText = (id: string) => {
        const select = unit(id);
        if (select) return select.options[select.selectedIndex]?.text?.trim() || select.value;
        const el = input(id);
        const staticUnit = el?.parentElement?.querySelector("span");
        return staticUnit?.textContent?.trim() || "";
      };

      const displayValue = (id: string) => {
        const raw = input(id)?.value?.trim() ?? "";
        if (!raw) return "—";
        const n = Number(raw);
        const shown = Number.isFinite(n) ? String(Number(n.toFixed(4))) : raw;
        const label = unitText(id);
        return label ? shown + " " + label : shown;
      };

      const lengthToFeet = (id: string) => {
        const n = Number(input(id)?.value);
        if (!Number.isFinite(n)) return Number.NaN;
        const factors: Record<string, number> = {
          ft: 1,
          in: 1 / 12,
          yd: 3,
          m: 1 / 0.3048,
          cm: 1 / 30.48,
          mm: 1 / 304.8,
        };
        return n * (factors[unit(id)?.value ?? "ft"] ?? 1);
      };

      const numberValue = (id: string, fallback = 0) => {
        const n = Number(input(id)?.value);
        return Number.isFinite(n) ? n : fallback;
      };

      const fmt = (n: number, digits = 2) =>
        Number.isFinite(n)
          ? new Intl.NumberFormat("en-US", { maximumFractionDigits: digits }).format(n)
          : "—";

      const money = (n: number) =>
        Number.isFinite(n)
          ? new Intl.NumberFormat("en-US", { style: "currency", currency: "USD", maximumFractionDigits: 2 }).format(n)
          : "—";

      const setText = (selector: string, text: string) => {
        figure.querySelectorAll<SVGTextElement | HTMLElement>(selector).forEach((el) => {
          el.textContent = text;
        });
      };

      const setBar = (selector: string, x: number, width: number) => {
        const el = figure.querySelector<SVGRectElement>(selector);
        if (!el) return;
        el.setAttribute("x", String(x));
        el.setAttribute("width", String(Math.max(0, width)));
      };

      const updateLayer = (depthFt: number) => {
        const baseY = 208;
        const height = Number.isFinite(depthFt) && depthFt > 0
          ? Math.max(20, Math.min(75, depthFt * 130))
          : 32;
        const topY = baseY - height;

        const layer = figure.querySelector<SVGRectElement>("[data-parking-cost-layer]");
        layer?.setAttribute("y", String(topY));
        layer?.setAttribute("height", String(height));

        const arrow = figure.querySelector<SVGLineElement>("[data-parking-cost-depth-arrow]");
        arrow?.setAttribute("y1", String(topY));

        const guide = figure.querySelector<SVGLineElement>("[data-parking-cost-depth-top]");
        guide?.setAttribute("y1", String(topY));
        guide?.setAttribute("y2", String(topY));

        const label = figure.querySelector<SVGTextElement>("[data-parking-cost-depth]");
        label?.setAttribute("y", String(Math.max(100, topY - 12)));
      };

      const update = () => {
        const lengthFt = lengthToFeet("length");
        const widthFt = lengthToFeet("width");
        const depthFt = lengthToFeet("depth");
        const density = Math.max(0, numberValue("density", 0));
        const allowance = Math.max(0, numberValue("waste", 0));
        const price = Math.max(0, numberValue("price", 0));
        const delivery = Math.max(0, numberValue("delivery", 0));
        const labor = Math.max(0, numberValue("labor", 0));
        const taxRate = Math.max(0, numberValue("tax", 0));
        const priceUnit = unit("price")?.value ?? "USD/ton";

        const valid = [lengthFt, widthFt, depthFt, density].every((v) => Number.isFinite(v) && v > 0);
        const areaFt2 = valid ? lengthFt * widthFt : Number.NaN;
        const netFt3 = valid ? lengthFt * widthFt * depthFt : Number.NaN;
        const orderFt3 = Number.isFinite(netFt3) ? netFt3 * (1 + allowance / 100) : Number.NaN;
        const orderYd3 = orderFt3 / 27;
        const tons = orderFt3 * density / 2000;
        const materialBasis = priceUnit === "USD/yd3" ? orderYd3 : tons;
        const materials = Number.isFinite(materialBasis) ? materialBasis * price : Number.NaN;
        const taxAmount = materials * taxRate / 100;
        const fixed = delivery + labor;
        const total = materials + taxAmount + fixed;

        updateLayer(depthFt);

        setText("[data-parking-cost-size]", displayValue("length") + " × " + displayValue("width") + " · " + displayValue("depth"));
        setText("[data-parking-cost-length]", "Length = " + displayValue("length"));
        setText("[data-parking-cost-width]", "Width = " + displayValue("width"));
        setText("[data-parking-cost-area]", fmt(areaFt2) + " ft² paved area");
        setText("[data-parking-cost-depth]", "Thickness = " + displayValue("depth"));
        setText("[data-parking-cost-density]", "Density = " + displayValue("density"));
        setText("[data-parking-cost-quantity]", fmt(orderYd3) + " yd³ · " + fmt(tons) + " US tons");

        const quoteName = priceUnit === "USD/yd3" ? "$/yd³" : "$/US ton";
        setText(
          "[data-parking-cost-formula]",
          "Material = " + fmt(materialBasis) + " × " + money(price) + " " + quoteName + "; total = material + tax + trucking + labor/equipment"
        );
        setText(
          "[data-parking-cost-breakdown]",
          "Material " + money(materials) + " + tax " + money(taxAmount) + " + trucking " + money(delivery) + " + labor/equipment " + money(labor)
        );
        setText("[data-parking-cost-total]", money(total));
        setText("[data-parking-cost-basis]", money(price) + " / " + (priceUnit === "USD/yd3" ? "yd³" : "US ton"));

        const barWidth = 500;
        const denominator = total > 0 ? total : 1;
        const materialW = barWidth * Math.max(0, materials) / denominator;
        const taxW = barWidth * Math.max(0, taxAmount) / denominator;
        const deliveryW = barWidth * delivery / denominator;
        const laborW = barWidth * labor / denominator;
        let x = 45;
        setBar("[data-parking-cost-material-bar]", x, materialW); x += materialW;
        setBar("[data-parking-cost-tax-bar]", x, taxW); x += taxW;
        setBar("[data-parking-cost-delivery-bar]", x, deliveryW); x += deliveryW;
        setBar("[data-parking-cost-labor-bar]", x, laborW);

        setText("[data-parking-cost-card-area]", fmt(areaFt2) + " ft²");
        setText("[data-parking-cost-card-volume]", fmt(orderYd3) + " yd³");
        setText("[data-parking-cost-card-tons]", fmt(tons) + " US tons");
        setText("[data-parking-cost-card-material]", money(materials));
        setText("[data-parking-cost-card-fixed]", money(fixed));
        setText("[data-parking-cost-card-total]", money(total));
      };

      root.addEventListener("input", update);
      root.addEventListener("change", update);
      root.addEventListener("calculator-state-restored", update);
      form.addEventListener("reset", () => setTimeout(update, 0));

      update();
      queueMicrotask(update);
      requestAnimationFrame(update);
      setTimeout(update, 0);
    });
  }

  initParkingLotCostRichDiagrams();
  document.addEventListener("astro:page-load", initParkingLotCostRichDiagrams);
</script>
