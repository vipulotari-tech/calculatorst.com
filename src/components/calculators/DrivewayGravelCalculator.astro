---
---

<div id="driveway-calc" class="rounded-xl border border-hairline bg-canvas p-5 shadow-card sm:p-7">
  <form id="d-form" novalidate class="space-y-6">
    <div class="space-y-3">
      <div>
        <p class="font-mono text-[11px] font-semibold uppercase tracking-widest text-mute">1. Driveway footprint</p>
        <p class="mt-1 text-xs leading-5 text-mute">Measure the main rectangle once. Add an apron, turnout or parking pad as extra area instead of multiplying the same layer blindly.</p>
      </div>
      <div class="grid gap-4 sm:grid-cols-3">
        <label class="block">
          <span class="text-sm font-medium text-ink">Driveway length</span>
          <div class="mt-1.5 flex">
            <input id="d-len" type="number" inputmode="decimal" min="0" step="any" value="50" class="h-11 w-full rounded-l-lg border border-hairline bg-canvas px-3 text-sm focus:border-link focus:outline-none focus:ring-2 focus:ring-link/20" aria-describedby="d-len-error" required />
            <select id="d-len-unit" aria-label="Driveway length unit" class="h-11 shrink-0 rounded-r-lg border border-l-0 border-hairline bg-canvas-soft px-2 text-sm"><option value="ft">ft</option><option value="yd">yd</option><option value="m">m</option></select>
          </div>
          <span id="d-len-error" class="mt-1 hidden text-xs text-error" role="alert"></span>
        </label>
        <label class="block">
          <span class="text-sm font-medium text-ink">Driveway width</span>
          <div class="mt-1.5 flex">
            <input id="d-wid" type="number" inputmode="decimal" min="0" step="any" value="12" class="h-11 w-full rounded-l-lg border border-hairline bg-canvas px-3 text-sm focus:border-link focus:outline-none focus:ring-2 focus:ring-link/20" aria-describedby="d-wid-error" required />
            <select id="d-wid-unit" aria-label="Driveway width unit" class="h-11 shrink-0 rounded-r-lg border border-l-0 border-hairline bg-canvas-soft px-2 text-sm"><option value="ft">ft</option><option value="yd">yd</option><option value="m">m</option></select>
          </div>
          <span id="d-wid-error" class="mt-1 hidden text-xs text-error" role="alert"></span>
        </label>
        <label class="block">
          <span class="text-sm font-medium text-ink">Extra apron / turnout area <span class="font-normal text-mute">(optional)</span></span>
          <div class="mt-1.5 flex">
            <input id="d-extra-area" type="number" inputmode="decimal" min="0" step="any" value="0" class="h-11 w-full rounded-l-lg border border-hairline bg-canvas px-3 text-sm" />
            <select id="d-extra-area-unit" aria-label="Additional area unit" class="h-11 shrink-0 rounded-r-lg border border-l-0 border-hairline bg-canvas-soft px-2 text-sm"><option value="ft2">ft²</option><option value="yd2">yd²</option><option value="m2">m²</option></select>
          </div>
        </label>
      </div>
      <div class="rounded-xl border border-hairline bg-canvas-soft-2 p-4">
        <label for="d-layout" class="block text-sm font-medium text-ink">Footprint layout</label>
        <select id="d-layout" class="mt-1.5 h-11 w-full rounded-lg border border-hairline bg-canvas px-3 text-sm sm:max-w-xl">
          <option value="rectangle" selected>Rectangle / straight driveway</option>
          <option value="lshape">L-shape — outer rectangle minus cutout</option>
          <option value="multi">Multiple rectangular sections</option>
        </select>
        <p class="mt-2 text-xs leading-5 text-mute">Use separate non-overlapping sections for parking pads, turnouts or widened areas. Keep the optional extra-area field for a measured area that does not need dimensions.</p>

        <div id="d-lshape-fields" class="mt-4 hidden grid gap-4 sm:grid-cols-2">
          <label class="block">
            <span class="text-xs font-medium text-ink">L-shape cutout length</span>
            <div class="mt-1 flex"><input id="d-cut-len" type="number" min="0" step="any" value="10" class="h-10 w-full rounded-l-lg border border-hairline bg-canvas px-3 text-sm"/><select id="d-cut-len-unit" class="h-10 rounded-r-lg border border-l-0 border-hairline bg-canvas-soft px-2 text-xs"><option value="ft">ft</option><option value="yd">yd</option><option value="m">m</option></select></div>
          </label>
          <label class="block">
            <span class="text-xs font-medium text-ink">L-shape cutout width</span>
            <div class="mt-1 flex"><input id="d-cut-wid" type="number" min="0" step="any" value="6" class="h-10 w-full rounded-l-lg border border-hairline bg-canvas px-3 text-sm"/><select id="d-cut-wid-unit" class="h-10 rounded-r-lg border border-l-0 border-hairline bg-canvas-soft px-2 text-xs"><option value="ft">ft</option><option value="yd">yd</option><option value="m">m</option></select></div>
          </label>
        </div>

        <div id="d-multi-fields" class="mt-4 hidden space-y-3">
          <div class="grid gap-4 rounded-lg border border-hairline bg-canvas p-3 sm:grid-cols-2">
            <label class="block"><span class="text-xs font-medium text-ink">Section 2 length</span><div class="mt-1 flex"><input id="d-s2-len" type="number" min="0" step="any" value="0" class="h-10 w-full rounded-l-lg border border-hairline bg-canvas px-3 text-sm"/><select id="d-s2-len-unit" class="h-10 rounded-r-lg border border-l-0 border-hairline bg-canvas-soft px-2 text-xs"><option value="ft">ft</option><option value="yd">yd</option><option value="m">m</option></select></div></label>
            <label class="block"><span class="text-xs font-medium text-ink">Section 2 width</span><div class="mt-1 flex"><input id="d-s2-wid" type="number" min="0" step="any" value="0" class="h-10 w-full rounded-l-lg border border-hairline bg-canvas px-3 text-sm"/><select id="d-s2-wid-unit" class="h-10 rounded-r-lg border border-l-0 border-hairline bg-canvas-soft px-2 text-xs"><option value="ft">ft</option><option value="yd">yd</option><option value="m">m</option></select></div></label>
          </div>
          <div class="grid gap-4 rounded-lg border border-hairline bg-canvas p-3 sm:grid-cols-2">
            <label class="block"><span class="text-xs font-medium text-ink">Section 3 length</span><div class="mt-1 flex"><input id="d-s3-len" type="number" min="0" step="any" value="0" class="h-10 w-full rounded-l-lg border border-hairline bg-canvas px-3 text-sm"/><select id="d-s3-len-unit" class="h-10 rounded-r-lg border border-l-0 border-hairline bg-canvas-soft px-2 text-xs"><option value="ft">ft</option><option value="yd">yd</option><option value="m">m</option></select></div></label>
            <label class="block"><span class="text-xs font-medium text-ink">Section 3 width</span><div class="mt-1 flex"><input id="d-s3-wid" type="number" min="0" step="any" value="0" class="h-10 w-full rounded-l-lg border border-hairline bg-canvas px-3 text-sm"/><select id="d-s3-wid-unit" class="h-10 rounded-r-lg border border-l-0 border-hairline bg-canvas-soft px-2 text-xs"><option value="ft">ft</option><option value="yd">yd</option><option value="m">m</option></select></div></label>
          </div>
        </div>
      </div>

      <div class="grid gap-4 sm:grid-cols-2">
      <div id="d-build-field" class="w-full min-w-0 max-w-none sm:max-w-2xl" style="width:100%;min-width:0;max-width:100%;">
        <label for="d-build" class="block w-full text-sm font-medium text-ink">Driveway build</label>
        <select
          id="d-build"
          aria-describedby="d-build-help"
          class="mt-1.5 block h-12 w-full min-w-0 max-w-full rounded-xl border-2 border-hairline bg-canvas px-4 text-sm font-semibold text-ink shadow-sm focus:border-link focus:outline-none focus:ring-4 focus:ring-link/10"
          style="display:block;width:100%;min-width:0;max-width:100%;"
        >
          <option value="surface">Surface only (1 layer)</option>
          <option value="two" selected>Base + surface (2 layers)</option>
          <option value="three">Sub-base + base + surface (3 layers)</option>
        </select>
        <p id="d-build-help" class="mt-2 block w-full max-w-none text-xs leading-5 text-mute" style="width:100%;max-width:100%;">Two-layer build: calculate the base course and surface course separately.</p>
      </div>

      <div class="w-full min-w-0 sm:max-w-2xl">
        <label for="d-output-system" class="block text-sm font-medium text-ink">Primary result units</label>
        <select id="d-output-system" class="mt-1.5 h-12 w-full rounded-xl border-2 border-hairline bg-canvas px-4 text-sm font-semibold text-ink">
          <option value="us" selected>US customary — yd³, US tons, ft²</option>
          <option value="metric">Metric — m³, tonnes, m²</option>
        </select>
        <p class="mt-2 text-xs leading-5 text-mute">Input units can still be mixed. This changes the primary result display and supplier table.</p>
      </div>
      </div>

      <div id="d-live-preview" class="rounded-xl border border-hairline bg-canvas-soft-2 p-4">
        <div class="flex flex-wrap items-center justify-between gap-2">
          <div><p class="font-mono text-[10px] font-semibold uppercase tracking-widest text-mute">Live driveway preview</p><p id="d-preview-footprint" class="mt-1 text-sm font-semibold text-ink">Rectangle · 50 × 12 ft</p></div>
          <p id="d-preview-area" class="font-mono text-xs text-mute">600 ft²</p>
        </div>
        <div class="mt-4 overflow-hidden rounded-lg border border-hairline bg-canvas">
          <div id="d-preview-surface" class="flex min-h-10 items-center justify-between gap-3 border-b border-hairline px-3 py-2"><span class="text-xs font-semibold text-ink">Surface</span><span id="d-preview-surface-value" class="font-mono text-[10px] text-mute">2 in · Crushed stone</span></div>
          <div id="d-preview-base" class="flex min-h-12 items-center justify-between gap-3 border-b border-hairline bg-canvas-soft px-3 py-2"><span class="text-xs font-semibold text-ink">Base</span><span id="d-preview-base-value" class="font-mono text-[10px] text-mute">4 in · Road base</span></div>
          <div id="d-preview-subbase" class="hidden min-h-12 items-center justify-between gap-3 px-3 py-2"><span class="text-xs font-semibold text-ink">Sub-base</span><span id="d-preview-subbase-value" class="font-mono text-[10px] text-mute">4 in · Road base</span></div>
        </div>
      </div>
    </div>

    <div class="space-y-3">
      <div>
        <p class="font-mono text-[11px] font-semibold uppercase tracking-widest text-mute">2. Layer-by-layer material</p>
        <p class="mt-1 text-xs leading-5 text-mute">Each course keeps its own depth, density, compaction allowance, waste and price. Density presets are editable planning values—not product guarantees.</p>
      </div>

      <div id="d-layer-subbase" class="d-layer-card hidden rounded-xl border border-hairline bg-canvas-soft-2 p-4" data-layer="subbase">
        <div class="flex flex-col gap-1 sm:flex-row sm:items-center sm:justify-between">
          <div><p class="text-sm font-semibold text-ink">Sub-base / bottom layer</p><p class="text-xs text-mute">Optional coarse foundation layer.</p><p id="d-subbase-allowance-summary" class="mt-1 font-mono text-[10px] text-mute">0% compaction allowance · 10% waste</p></div>
          <span id="d-subbase-index" class="font-mono text-[11px] text-mute">Layer 1</span>
        </div>
        <div class="mt-4 grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
          <label class="block"><span class="text-xs font-medium text-ink">Installed depth</span><div class="mt-1 flex"><input id="d-subbase-depth" type="number" min="0" step="any" value="4" class="h-10 w-full rounded-l-lg border border-hairline bg-canvas px-3 text-sm"/><select id="d-subbase-depth-unit" class="h-10 rounded-r-lg border border-l-0 border-hairline bg-canvas-soft px-2 text-xs"><option value="in">in</option><option value="ft">ft</option><option value="cm">cm</option><option value="mm">mm</option></select></div></label>
          <label class="block"><span class="text-xs font-medium text-ink">Material preset</span><select id="d-subbase-material" data-density-target="d-subbase-density" data-density-unit-target="d-subbase-density-unit" class="d-material mt-1 h-10 w-full rounded-lg border border-hairline bg-canvas px-2 text-xs"><option value="1.50" selected>Crusher run / road base ~1.50 t/yd³</option><option value="1.40">Crushed stone / #57 ~1.40</option><option value="1.60">Limestone ~1.60</option><option value="1.42">Granite gravel ~1.42</option><option value="1.35">Pea gravel ~1.35</option><option value="1.33">River rock ~1.33</option><option value="custom">Custom density</option></select></label>
          <label class="block"><span class="text-xs font-medium text-ink">Bulk density <span class="font-normal text-mute">· choose Custom to edit</span></span><div class="mt-1 flex"><input id="d-subbase-density" type="number" min="0.01" step="any" readonly aria-readonly="true" value="1.50" class="h-10 w-full rounded-l-lg border border-hairline bg-canvas px-3 text-sm"/><select id="d-subbase-density-unit" disabled class="h-10 disabled:cursor-not-allowed disabled:opacity-60 rounded-r-lg border border-l-0 border-hairline bg-canvas-soft px-2 text-xs"><option value="ton/yd3">t/yd³</option><option value="lb/ft3">lb/ft³</option><option value="kg/m3">kg/m³</option></select></div></label>
          <label class="block"><span class="text-xs font-medium text-ink">Price</span><div class="mt-1 flex"><span class="flex h-10 items-center rounded-l-lg border border-hairline bg-canvas-soft px-2 text-xs text-mute">$</span><input id="d-subbase-price" type="number" min="0" step="any" value="0" class="h-10 w-full border-y border-hairline bg-canvas px-2 text-sm"/><select id="d-subbase-price-basis" class="h-10 rounded-r-lg border border-hairline bg-canvas-soft px-2 text-xs"><option value="ton">/ton</option><option value="yd3">/yd³</option></select></div></label>
        </div>
        <details class="mt-3 rounded-lg border border-hairline bg-canvas">
          <summary class="cursor-pointer px-3 py-2 text-xs font-medium text-ink">Advanced layer allowances</summary>
          <div class="grid gap-3 border-t border-hairline p-3 sm:grid-cols-2 lg:grid-cols-4">
            <label class="block"><span class="text-xs text-mute">Loose-to-placed / compaction allowance</span><div class="mt-1 flex"><input id="d-subbase-compaction" type="number" min="0" max="100" value="0" class="h-9 w-full rounded-l-md border border-hairline bg-canvas px-2 text-sm"/><span class="flex h-9 items-center rounded-r-md border border-l-0 border-hairline bg-canvas-soft px-2 text-xs">%</span></div></label>
            <label class="block"><span class="text-xs text-mute">Ordering waste / contingency</span><div class="mt-1 flex"><input id="d-subbase-waste" type="number" min="0" max="100" value="10" class="h-9 w-full rounded-l-md border border-hairline bg-canvas px-2 text-sm"/><span class="flex h-9 items-center rounded-r-md border border-l-0 border-hairline bg-canvas-soft px-2 text-xs">%</span></div></label>
            <label class="block d-subbase-bulk-ordering"><span class="text-xs text-mute">Supplier order increment</span><div class="mt-1 flex"><input id="d-subbase-increment" type="number" min="0" step="any" value="0" class="h-9 w-full rounded-l-md border border-hairline bg-canvas px-2 text-sm"/><span class="flex h-9 items-center rounded-r-md border border-l-0 border-hairline bg-canvas-soft px-2 text-xs">ton</span></div><span class="mt-1 block text-[10px] text-mute">0 = no rounding</span></label>
            <label class="block d-subbase-bulk-ordering"><span class="text-xs text-mute">Supplier minimum order</span><div class="mt-1 flex"><input id="d-subbase-minimum" type="number" min="0" step="any" value="0" class="h-9 w-full rounded-l-md border border-hairline bg-canvas px-2 text-sm"/><span class="flex h-9 items-center rounded-r-md border border-l-0 border-hairline bg-canvas-soft px-2 text-xs">ton</span></div><span class="mt-1 block text-[10px] text-mute">0 = no minimum</span></label>
          </div>
        </details>
      </div>

      <div id="d-layer-base" class="d-layer-card rounded-xl border border-hairline bg-canvas-soft-2 p-4" data-layer="base">
        <div class="flex flex-col gap-1 sm:flex-row sm:items-center sm:justify-between">
          <div><p class="text-sm font-semibold text-ink">Base course</p><p class="text-xs text-mute">Structural gravel course below the surface.</p><p id="d-base-allowance-summary" class="mt-1 font-mono text-[10px] text-mute">0% compaction allowance · 10% waste</p></div>
          <span id="d-base-index" class="font-mono text-[11px] text-mute">Layer 1</span>
        </div>
        <div class="mt-4 grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
          <label class="block"><span class="text-xs font-medium text-ink">Installed depth</span><div class="mt-1 flex"><input id="d-base-depth" type="number" min="0" step="any" value="4" class="h-10 w-full rounded-l-lg border border-hairline bg-canvas px-3 text-sm"/><select id="d-base-depth-unit" class="h-10 rounded-r-lg border border-l-0 border-hairline bg-canvas-soft px-2 text-xs"><option value="in">in</option><option value="ft">ft</option><option value="cm">cm</option><option value="mm">mm</option></select></div></label>
          <label class="block"><span class="text-xs font-medium text-ink">Material preset</span><select id="d-base-material" data-density-target="d-base-density" data-density-unit-target="d-base-density-unit" class="d-material mt-1 h-10 w-full rounded-lg border border-hairline bg-canvas px-2 text-xs"><option value="1.50" selected>Crusher run / road base ~1.50 t/yd³</option><option value="1.40">Crushed stone / #57 ~1.40</option><option value="1.60">Limestone ~1.60</option><option value="1.42">Granite gravel ~1.42</option><option value="1.35">Pea gravel ~1.35</option><option value="1.33">River rock ~1.33</option><option value="custom">Custom density</option></select></label>
          <label class="block"><span class="text-xs font-medium text-ink">Bulk density <span class="font-normal text-mute">· choose Custom to edit</span></span><div class="mt-1 flex"><input id="d-base-density" type="number" min="0.01" step="any" readonly aria-readonly="true" value="1.50" class="h-10 w-full rounded-l-lg border border-hairline bg-canvas px-3 text-sm"/><select id="d-base-density-unit" disabled class="h-10 disabled:cursor-not-allowed disabled:opacity-60 rounded-r-lg border border-l-0 border-hairline bg-canvas-soft px-2 text-xs"><option value="ton/yd3">t/yd³</option><option value="lb/ft3">lb/ft³</option><option value="kg/m3">kg/m³</option></select></div></label>
          <label class="block"><span class="text-xs font-medium text-ink">Price</span><div class="mt-1 flex"><span class="flex h-10 items-center rounded-l-lg border border-hairline bg-canvas-soft px-2 text-xs text-mute">$</span><input id="d-base-price" type="number" min="0" step="any" value="0" class="h-10 w-full border-y border-hairline bg-canvas px-2 text-sm"/><select id="d-base-price-basis" class="h-10 rounded-r-lg border border-hairline bg-canvas-soft px-2 text-xs"><option value="ton">/ton</option><option value="yd3">/yd³</option></select></div></label>
        </div>
        <details class="mt-3 rounded-lg border border-hairline bg-canvas">
          <summary class="cursor-pointer px-3 py-2 text-xs font-medium text-ink">Advanced layer allowances</summary>
          <div class="grid gap-3 border-t border-hairline p-3 sm:grid-cols-2 lg:grid-cols-4">
            <label class="block"><span class="text-xs text-mute">Loose-to-placed / compaction allowance</span><div class="mt-1 flex"><input id="d-base-compaction" type="number" min="0" max="100" value="0" class="h-9 w-full rounded-l-md border border-hairline bg-canvas px-2 text-sm"/><span class="flex h-9 items-center rounded-r-md border border-l-0 border-hairline bg-canvas-soft px-2 text-xs">%</span></div></label>
            <label class="block"><span class="text-xs text-mute">Ordering waste / contingency</span><div class="mt-1 flex"><input id="d-base-waste" type="number" min="0" max="100" value="10" class="h-9 w-full rounded-l-md border border-hairline bg-canvas px-2 text-sm"/><span class="flex h-9 items-center rounded-r-md border border-l-0 border-hairline bg-canvas-soft px-2 text-xs">%</span></div></label>
            <label class="block d-base-bulk-ordering"><span class="text-xs text-mute">Supplier order increment</span><div class="mt-1 flex"><input id="d-base-increment" type="number" min="0" step="any" value="0" class="h-9 w-full rounded-l-md border border-hairline bg-canvas px-2 text-sm"/><span class="flex h-9 items-center rounded-r-md border border-l-0 border-hairline bg-canvas-soft px-2 text-xs">ton</span></div><span class="mt-1 block text-[10px] text-mute">0 = no rounding</span></label>
            <label class="block d-base-bulk-ordering"><span class="text-xs text-mute">Supplier minimum order</span><div class="mt-1 flex"><input id="d-base-minimum" type="number" min="0" step="any" value="0" class="h-9 w-full rounded-l-md border border-hairline bg-canvas px-2 text-sm"/><span class="flex h-9 items-center rounded-r-md border border-l-0 border-hairline bg-canvas-soft px-2 text-xs">ton</span></div><span class="mt-1 block text-[10px] text-mute">0 = no minimum</span></label>
          </div>
        </details>
      </div>

      <div id="d-layer-surface" class="d-layer-card rounded-xl border border-hairline bg-canvas-soft-2 p-4" data-layer="surface">
        <div class="flex flex-col gap-1 sm:flex-row sm:items-center sm:justify-between">
          <div><p class="text-sm font-semibold text-ink">Surface course</p><p class="text-xs text-mute">Top layer or refresh material.</p><p id="d-surface-allowance-summary" class="mt-1 font-mono text-[10px] text-mute">0% compaction allowance · 10% waste</p></div>
          <span id="d-surface-index" class="font-mono text-[11px] text-mute">Layer 2</span>
        </div>
        <div class="mt-4 grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
          <label class="block"><span class="text-xs font-medium text-ink">Installed depth</span><div class="mt-1 flex"><input id="d-surface-depth" type="number" min="0" step="any" value="2" class="h-10 w-full rounded-l-lg border border-hairline bg-canvas px-3 text-sm"/><select id="d-surface-depth-unit" class="h-10 rounded-r-lg border border-l-0 border-hairline bg-canvas-soft px-2 text-xs"><option value="in">in</option><option value="ft">ft</option><option value="cm">cm</option><option value="mm">mm</option></select></div></label>
          <label class="block"><span class="text-xs font-medium text-ink">Material preset</span><select id="d-surface-material" data-density-target="d-surface-density" data-density-unit-target="d-surface-density-unit" class="d-material mt-1 h-10 w-full rounded-lg border border-hairline bg-canvas px-2 text-xs"><option value="1.50">Crusher run / road base ~1.50 t/yd³</option><option value="1.40" selected>Crushed stone / #57 ~1.40</option><option value="1.60">Limestone ~1.60</option><option value="1.42">Granite gravel ~1.42</option><option value="1.35">Pea gravel ~1.35</option><option value="1.33">River rock ~1.33</option><option value="custom">Custom density</option></select></label>
          <label class="block"><span class="text-xs font-medium text-ink">Bulk density <span class="font-normal text-mute">· choose Custom to edit</span></span><div class="mt-1 flex"><input id="d-surface-density" type="number" min="0.01" step="any" readonly aria-readonly="true" value="1.40" class="h-10 w-full rounded-l-lg border border-hairline bg-canvas px-3 text-sm"/><select id="d-surface-density-unit" disabled class="h-10 disabled:cursor-not-allowed disabled:opacity-60 rounded-r-lg border border-l-0 border-hairline bg-canvas-soft px-2 text-xs"><option value="ton/yd3">t/yd³</option><option value="lb/ft3">lb/ft³</option><option value="kg/m3">kg/m³</option></select></div></label>
          <label id="d-surface-bulk-price-field" class="block"><span class="text-xs font-medium text-ink">Bulk price</span><div class="mt-1 flex"><span class="flex h-10 items-center rounded-l-lg border border-hairline bg-canvas-soft px-2 text-xs text-mute">$</span><input id="d-surface-price" type="number" min="0" step="any" value="0" class="h-10 w-full border-y border-hairline bg-canvas px-2 text-sm"/><select id="d-surface-price-basis" class="h-10 rounded-r-lg border border-hairline bg-canvas-soft px-2 text-xs"><option value="ton">/ton</option><option value="yd3">/yd³</option></select></div></label>
        </div>
        <div class="mt-4 grid gap-4 rounded-lg border border-hairline bg-canvas p-3 sm:grid-cols-3">
          <label class="block">
            <span class="text-xs font-medium text-ink">Surface supply</span>
            <select id="d-surface-supply" class="mt-1 h-10 w-full rounded-lg border border-hairline bg-canvas px-2 text-xs">
              <option value="bulk" selected>Bulk aggregate</option>
              <option value="bags">Bagged aggregate</option>
            </select>
          </label>
          <label id="d-surface-bag-weight-field" class="hidden block">
            <span class="text-xs font-medium text-ink">Bag net weight</span>
            <div class="mt-1 flex"><input id="d-surface-bag-weight" type="number" min="0.01" step="any" value="50" class="h-10 w-full rounded-l-lg border border-hairline bg-canvas px-3 text-sm"/><span class="flex h-10 items-center rounded-r-lg border border-l-0 border-hairline bg-canvas-soft px-2 text-xs">lb</span></div>
          </label>
          <label id="d-surface-bag-price-field" class="hidden block">
            <span class="text-xs font-medium text-ink">Price per bag</span>
            <div class="mt-1 flex"><span class="flex h-10 items-center rounded-l-lg border border-hairline bg-canvas-soft px-2 text-xs">$</span><input id="d-surface-bag-price" type="number" min="0" step="any" value="0" class="h-10 w-full rounded-r-lg border border-l-0 border-hairline bg-canvas px-3 text-sm"/></div>
          </label>
        </div>

        <details class="mt-3 rounded-lg border border-hairline bg-canvas">
          <summary class="cursor-pointer px-3 py-2 text-xs font-medium text-ink">Advanced layer allowances</summary>
          <div class="grid gap-3 border-t border-hairline p-3 sm:grid-cols-2 lg:grid-cols-4">
            <label class="block"><span class="text-xs text-mute">Loose-to-placed / compaction allowance</span><div class="mt-1 flex"><input id="d-surface-compaction" type="number" min="0" max="100" value="0" class="h-9 w-full rounded-l-md border border-hairline bg-canvas px-2 text-sm"/><span class="flex h-9 items-center rounded-r-md border border-l-0 border-hairline bg-canvas-soft px-2 text-xs">%</span></div></label>
            <label class="block"><span class="text-xs text-mute">Ordering waste / contingency</span><div class="mt-1 flex"><input id="d-surface-waste" type="number" min="0" max="100" value="10" class="h-9 w-full rounded-l-md border border-hairline bg-canvas px-2 text-sm"/><span class="flex h-9 items-center rounded-r-md border border-l-0 border-hairline bg-canvas-soft px-2 text-xs">%</span></div></label>
            <label class="block d-surface-bulk-ordering"><span class="text-xs text-mute">Supplier order increment</span><div class="mt-1 flex"><input id="d-surface-increment" type="number" min="0" step="any" value="0" class="h-9 w-full rounded-l-md border border-hairline bg-canvas px-2 text-sm"/><span class="flex h-9 items-center rounded-r-md border border-l-0 border-hairline bg-canvas-soft px-2 text-xs">ton</span></div><span class="mt-1 block text-[10px] text-mute">0 = no rounding</span></label>
            <label class="block d-surface-bulk-ordering"><span class="text-xs text-mute">Supplier minimum order</span><div class="mt-1 flex"><input id="d-surface-minimum" type="number" min="0" step="any" value="0" class="h-9 w-full rounded-l-md border border-hairline bg-canvas px-2 text-sm"/><span class="flex h-9 items-center rounded-r-md border border-l-0 border-hairline bg-canvas-soft px-2 text-xs">ton</span></div><span class="mt-1 block text-[10px] text-mute">0 = no minimum</span></label>
          </div>
        </details>
      </div>
    </div>

    <div class="space-y-3">
      <div>
        <p class="font-mono text-[11px] font-semibold uppercase tracking-widest text-mute">3. Geotextile & edging</p>
        <p class="mt-1 text-xs leading-5 text-mute">Optional project materials are included in the BOM and entered-scope cost. For irregular footprints, use a custom edging length.</p>
      </div>
      <div class="grid gap-4 lg:grid-cols-2">
        <div class="rounded-xl border border-hairline bg-canvas-soft-2 p-4">
          <label class="flex items-center gap-2 text-sm font-semibold text-ink"><input id="d-geo-enabled" type="checkbox" class="h-4 w-4"/> Include geotextile fabric</label>
          <div id="d-geo-fields" class="mt-4 grid gap-3 opacity-50 sm:grid-cols-2">
            <label class="block"><span class="text-xs text-mute">Overlap / seam allowance</span><div class="mt-1 flex"><input id="d-geo-overlap" type="number" min="0" max="100" value="10" disabled class="h-9 w-full rounded-l-md border border-hairline bg-canvas px-2 text-sm"/><span class="flex h-9 items-center rounded-r-md border border-l-0 border-hairline bg-canvas-soft px-2 text-xs">%</span></div></label>
            <label class="block"><span class="text-xs text-mute">Price per roll</span><div class="mt-1 flex"><span class="flex h-9 items-center rounded-l-md border border-hairline bg-canvas-soft px-2 text-xs">$</span><input id="d-geo-price" type="number" min="0" value="0" disabled class="h-9 w-full rounded-r-md border border-l-0 border-hairline bg-canvas px-2 text-sm"/></div></label>
            <label class="block"><span class="text-xs text-mute">Roll width</span><div class="mt-1 flex"><input id="d-geo-roll-width" type="number" min="0.01" value="12.5" disabled class="h-9 w-full rounded-l-md border border-hairline bg-canvas px-2 text-sm"/><span class="flex h-9 items-center rounded-r-md border border-l-0 border-hairline bg-canvas-soft px-2 text-xs">ft</span></div></label>
            <label class="block"><span class="text-xs text-mute">Roll length</span><div class="mt-1 flex"><input id="d-geo-roll-length" type="number" min="0.01" value="300" disabled class="h-9 w-full rounded-l-md border border-hairline bg-canvas px-2 text-sm"/><span class="flex h-9 items-center rounded-r-md border border-l-0 border-hairline bg-canvas-soft px-2 text-xs">ft</span></div></label>
          </div>
        </div>

        <div class="rounded-xl border border-hairline bg-canvas-soft-2 p-4">
          <label for="d-edging-mode" class="block text-sm font-semibold text-ink">Driveway edging</label>
          <select id="d-edging-mode" class="mt-1.5 h-10 w-full rounded-lg border border-hairline bg-canvas px-2 text-xs">
            <option value="none" selected>No edging</option>
            <option value="sides">Both long sides of primary driveway</option>
            <option value="perimeter">Primary rectangle perimeter</option>
            <option value="custom">Custom measured edging length</option>
          </select>
          <div id="d-edging-fields" class="mt-4 hidden grid gap-3 sm:grid-cols-2">
            <label class="block"><span class="text-xs text-mute">Edging length</span><div class="mt-1 flex"><input id="d-edging-length" type="number" min="0" step="any" value="100" class="h-9 w-full rounded-l-md border border-hairline bg-canvas px-2 text-sm"/><span class="flex h-9 items-center rounded-r-md border border-l-0 border-hairline bg-canvas-soft px-2 text-xs">ft</span></div></label>
            <label class="block"><span class="text-xs text-mute">Price per ft</span><div class="mt-1 flex"><span class="flex h-9 items-center rounded-l-md border border-hairline bg-canvas-soft px-2 text-xs">$</span><input id="d-edging-price" type="number" min="0" value="0" class="h-9 w-full rounded-r-md border border-l-0 border-hairline bg-canvas px-2 text-sm"/></div></label>
          </div>
          <p id="d-edging-help" class="mt-2 text-[10px] leading-4 text-mute">For L-shapes or multiple sections, choose Custom and enter the measured exposed edge length.</p>
        </div>
      </div>
    </div>

    <details open class="rounded-xl border border-hairline bg-canvas">
      <summary class="cursor-pointer px-4 py-3 text-sm font-medium text-ink">4. Truck payload, delivery &amp; project cost</summary>
      <div class="grid gap-4 border-t border-hairline p-4 sm:grid-cols-2 lg:grid-cols-4">
        <label class="block"><span class="text-xs font-medium text-ink">Truck payload capacity</span><div class="mt-1 flex"><input id="d-truck-capacity" type="number" min="0.01" step="any" value="20" class="h-10 w-full rounded-l-lg border border-hairline bg-canvas px-3 text-sm"/><select id="d-truck-capacity-unit" class="h-10 rounded-r-lg border border-l-0 border-hairline bg-canvas-soft px-2 text-xs"><option value="ton">US ton</option><option value="tonne">tonne</option></select></div></label>
        <label class="block"><span class="text-xs font-medium text-ink">Delivery / trucking total</span><div class="mt-1 flex"><span class="flex h-10 items-center rounded-l-lg border border-hairline bg-canvas-soft px-2 text-xs">$</span><input id="d-delivery" type="number" min="0" step="any" value="0" class="h-10 w-full rounded-r-lg border border-l-0 border-hairline bg-canvas px-3 text-sm"/></div></label>
        <label class="block"><span class="text-xs font-medium text-ink">Material tax</span><div class="mt-1 flex"><input id="d-tax" type="number" min="0" max="100" step="any" value="0" class="h-10 w-full rounded-l-lg border border-hairline bg-canvas px-3 text-sm"/><span class="flex h-10 items-center rounded-r-lg border border-l-0 border-hairline bg-canvas-soft px-2 text-xs">%</span></div></label>
        <div class="flex items-end"><p class="text-xs leading-5 text-mute">Truck count is based on entered usable payload only. Confirm legal axle limits, truck bed volume, access and supplier minimums.</p></div>
      </div>
    </details>

    <div>
      <span id="d-form-error" class="mb-3 hidden rounded-lg border border-error/30 bg-error/5 px-3 py-2 text-sm text-error" role="alert"></span>
      <p id="d-recalc-note" class="mb-3 hidden text-xs font-medium text-mute" role="status">Inputs changed. Calculate again to refresh the order plan.</p>
      <div class="flex flex-wrap gap-2">
        <button id="d-calculate" type="submit" class="h-11 rounded-lg bg-primary px-6 text-sm font-medium text-on-primary hover:bg-primary focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-link">Calculate driveway gravel</button>
        <button type="reset" id="d-reset" class="h-11 rounded-lg border border-hairline bg-canvas px-5 text-sm font-medium text-ink hover:bg-canvas-soft">Reset</button>
      </div>
    </div>
  </form>

  <div id="d-results" class="mt-7 hidden space-y-4" aria-live="polite">
    <div class="rounded-xl border border-hairline bg-canvas-soft-2 p-5">
      <p class="font-mono text-[11px] tracking-widest text-mute">SUPPLIER-READY DRIVEWAY ORDER PLAN</p>
      <div class="mt-2 flex flex-wrap items-baseline gap-x-3 gap-y-1">
        <span class="text-3xl font-semibold tracking-[-0.04em] text-ink"><span id="d-total-tons">—</span> <span id="d-primary-weight-unit">US tons</span></span>
        <span class="font-mono text-sm text-body"><span id="d-total-yd3">—</span> <span id="d-primary-volume-unit">yd³</span> supplier order</span>
      </div>
      <p class="mt-1 font-mono text-xs text-mute"><span id="d-area">—</span> <span id="d-primary-area-unit">ft²</span> footprint · <span id="d-secondary-summary">—</span></p>

      <div class="mt-4 grid gap-3 sm:grid-cols-2 lg:grid-cols-5">
        <div class="rounded-lg border border-hairline bg-canvas p-3"><p class="font-mono text-[11px] text-mute">Installed volume</p><p class="mt-1 text-sm font-semibold text-ink"><span id="d-installed-yd3">—</span> <span id="d-installed-unit">yd³</span></p></div>
        <div class="rounded-lg border border-hairline bg-canvas p-3"><p class="font-mono text-[11px] text-mute">Supplier rounding overage</p><p class="mt-1 text-sm font-semibold text-ink"><span id="d-rounding-overage">—</span> <span id="d-rounding-unit">US tons</span></p></div>
        <div class="rounded-lg border border-hairline bg-canvas p-3"><p class="font-mono text-[11px] text-mute">Separate-product truck loads</p><p class="mt-1 text-sm font-semibold text-ink"><span id="d-loads">—</span></p><p class="font-mono text-[11px] text-mute">bulk layers only · <span id="d-load-capacity">—</span></p></div>
        <div class="rounded-lg border border-hairline bg-canvas p-3"><p class="font-mono text-[11px] text-mute">Materials + project extras</p><p class="mt-1 text-sm font-semibold text-ink" id="d-material-cost">—</p></div>
        <div class="rounded-lg border border-hairline bg-canvas p-3"><p class="font-mono text-[11px] text-mute">Entered-scope total</p><p class="mt-1 text-sm font-semibold text-ink" id="d-total-cost">—</p><p class="font-mono text-[11px] text-mute">materials + tax + delivery</p></div>
      </div>
    </div>

    <div class="overflow-x-auto rounded-xl border border-hairline bg-canvas" role="region" aria-label="Driveway gravel layer order summary" tabindex="0">
      <table class="w-full min-w-[980px] text-left text-sm">
        <thead class="bg-canvas-soft font-mono text-[11px] text-mute">
          <tr>
            <th class="px-3 py-2">LAYER / PRODUCT</th>
            <th id="d-th-installed" class="px-3 py-2">INSTALLED yd³</th>
            <th id="d-th-required" class="px-3 py-2">REQUIRED yd³</th>
            <th id="d-th-supplier" class="px-3 py-2">SUPPLIER ORDER</th>
            <th class="px-3 py-2">DENSITY</th>
            <th class="px-3 py-2">DELIVERY / PACKAGE</th>
            <th class="px-3 py-2">MATERIAL COST</th>
          </tr>
        </thead>
        <tbody id="d-layer-results" class="divide-y divide-hairline"></tbody>
      </table>
    </div>

    <div id="d-ancillary-results" class="hidden grid gap-3 sm:grid-cols-2">
      <div id="d-geo-result-card" class="hidden rounded-xl border border-hairline bg-canvas p-4"><p class="font-mono text-[10px] uppercase tracking-widest text-mute">Geotextile</p><p id="d-geo-result" class="mt-1 text-sm font-semibold text-ink">—</p></div>
      <div id="d-edging-result-card" class="hidden rounded-xl border border-hairline bg-canvas p-4"><p class="font-mono text-[10px] uppercase tracking-widest text-mute">Edging</p><p id="d-edging-result" class="mt-1 text-sm font-semibold text-ink">—</p></div>
    </div>

    <div class="overflow-x-auto rounded-xl border border-hairline bg-canvas" role="region" aria-label="Driveway supplier bill of materials" tabindex="0">
      <div class="border-b border-hairline bg-canvas-soft px-4 py-3"><p class="text-sm font-semibold text-ink">Supplier bill of materials</p><p class="mt-1 text-xs text-mute">Order quantities reflect bag rounding, supplier increments/minimums and optional project extras.</p></div>
      <table class="w-full min-w-[720px] text-left text-sm">
        <thead class="font-mono text-[11px] text-mute"><tr><th class="px-3 py-2">ITEM</th><th class="px-3 py-2">ORDER QUANTITY</th><th class="px-3 py-2">NOTES</th><th class="px-3 py-2">COST</th></tr></thead>
        <tbody id="d-bom-results" class="divide-y divide-hairline"></tbody>
      </table>
    </div>

    <div class="flex flex-wrap gap-2">
      <button type="button" id="d-copy" class="h-10 rounded-lg border border-hairline bg-canvas px-4 text-xs font-medium text-ink hover:bg-canvas-soft">Copy supplier summary</button>
      <button type="button" id="d-share" class="h-10 rounded-lg border border-hairline bg-canvas px-4 text-xs font-medium text-ink hover:bg-canvas-soft">Copy share link</button>
      <button type="button" id="d-download-report" class="h-10 rounded-lg border border-hairline bg-canvas px-4 text-xs font-medium text-ink hover:bg-canvas-soft">Download report</button>
      <button type="button" id="d-download-bom" class="h-10 rounded-lg border border-hairline bg-canvas px-4 text-xs font-medium text-ink hover:bg-canvas-soft">Download BOM CSV</button>
      <button type="button" id="d-print" class="h-10 rounded-lg border border-hairline bg-canvas px-4 text-xs font-medium text-ink hover:bg-canvas-soft">Print / Save PDF</button>
    </div>
    <p id="d-copy-status" class="text-xs text-mute" role="status" aria-live="polite"></p>
  </div>
</div>

<script>
  import {
    areaToFt2,
    calculateDrivewayGravel,
    lengthToFeet,
    type DensityUnit,
    type PriceBasis,
    type SupplyMode,
    type DrivewayFootprintSectionInput,
  } from "../../lib/calculations/driveway-gravel";

  const YD3_TO_M3 = 0.764554857984;
  const SHORT_TON_TO_TONNE = 0.90718474;

  const $ = <T extends HTMLElement>(id: string) => document.getElementById(id) as T | null;
  const form = $<HTMLFormElement>("d-form");
  const results = $<HTMLDivElement>("d-results");
  let hasCalculated = false;
  let lastCalculation: ReturnType<typeof calculateDrivewayGravel> | null = null;

  function num(id: string, fallback = 0) {
    const value = Number(($<HTMLInputElement>(id)?.value ?? "").trim());
    return Number.isFinite(value) ? value : fallback;
  }
  function selected(id: string) {
    return $<HTMLSelectElement>(id)?.value ?? "";
  }
  function checked(id: string) {
    return Boolean($<HTMLInputElement>(id)?.checked);
  }
  function fmt(value: number, digits = 2) {
    if (!Number.isFinite(value)) return "—";
    return new Intl.NumberFormat("en-US", { maximumFractionDigits: digits, minimumFractionDigits: 0 }).format(value);
  }
  function money(value: number) {
    return new Intl.NumberFormat("en-US", { style: "currency", currency: "USD" }).format(value);
  }
  function setText(id: string, value: string) {
    const el = $(id);
    if (el) el.textContent = value;
  }
  function showError(id: string, message: string) {
    const el = $(id);
    if (!el) return;
    el.textContent = message;
    el.classList.remove("hidden");
  }
  function clearErrors() {
    ["d-len-error", "d-wid-error", "d-form-error"].forEach((id) => {
      const el = $(id);
      if (!el) return;
      el.textContent = "";
      el.classList.add("hidden");
    });
  }
  function invalidateResults() {
    if (!results || !hasCalculated) return;
    results.classList.add("hidden");
    $("d-recalc-note")?.classList.remove("hidden");
    setText("d-copy-status", "");
  }
  function materialName(prefix: string) {
    const select = $<HTMLSelectElement>(`d-${prefix}-material`);
    const text = select?.selectedOptions?.[0]?.textContent?.trim() ?? prefix;
    return text.replace(/\s*~.*$/, "").trim();
  }
  function updateLayoutVisibility() {
    const layout = selected("d-layout");
    $("d-lshape-fields")?.classList.toggle("hidden", layout !== "lshape");
    $("d-multi-fields")?.classList.toggle("hidden", layout !== "multi");
  }
  function updateLayerVisibility() {
    const build = selected("d-build");
    $("d-layer-subbase")?.classList.toggle("hidden", build !== "three");
    $("d-layer-base")?.classList.toggle("hidden", build === "surface");
    const helper = $("d-build-help");
    if (build === "surface") {
      setText("d-surface-index", "Layer 1");
      if (helper) helper.textContent = "Surface refresh: calculate one top course only.";
    } else if (build === "three") {
      setText("d-subbase-index", "Layer 1");
      setText("d-base-index", "Layer 2");
      setText("d-surface-index", "Layer 3");
      if (helper) helper.textContent = "Three-layer build: sub-base, base and surface are calculated independently.";
    } else {
      setText("d-base-index", "Layer 1");
      setText("d-surface-index", "Layer 2");
      if (helper) helper.textContent = "Two-layer build: calculate the base course and surface course separately.";
    }

    const previewBase = $("d-preview-base");
    const previewSubbase = $("d-preview-subbase");
    previewBase?.classList.toggle("hidden", build === "surface");
    previewBase?.classList.toggle("flex", build !== "surface");
    previewSubbase?.classList.toggle("hidden", build !== "three");
    previewSubbase?.classList.toggle("flex", build === "three");
  }
  function setDensityControlState(select: HTMLSelectElement) {
    const densityId = select.dataset.densityTarget;
    const unitId = select.dataset.densityUnitTarget;
    if (!densityId || !unitId) return;
    const densityInput = $<HTMLInputElement>(densityId);
    const unitSelect = $<HTMLSelectElement>(unitId);
    const custom = select.value === "custom";
    if (densityInput) {
      densityInput.readOnly = !custom;
      densityInput.setAttribute("aria-readonly", String(!custom));
      densityInput.classList.toggle("opacity-70", !custom);
    }
    if (unitSelect) {
      unitSelect.disabled = !custom;
      unitSelect.classList.toggle("cursor-not-allowed", !custom);
    }
    if (!custom) {
      if (densityInput) densityInput.value = select.value;
      if (unitSelect) unitSelect.value = "ton/yd3";
    }
  }
  function updateAllowanceSummary(prefix: string) {
    setText(
      `d-${prefix}-allowance-summary`,
      `${fmt(num(`d-${prefix}-compaction`), 1)}% compaction allowance · ${fmt(num(`d-${prefix}-waste`), 1)}% waste`,
    );
  }
  function updateAllAllowanceSummaries() {
    ["subbase", "base", "surface"].forEach(updateAllowanceSummary);
  }
  function updateSurfaceSupply() {
    const bags = selected("d-surface-supply") === "bags";
    $("d-surface-bag-weight-field")?.classList.toggle("hidden", !bags);
    $("d-surface-bag-price-field")?.classList.toggle("hidden", !bags);
    $("d-surface-bulk-price-field")?.classList.toggle("hidden", bags);
    document.querySelectorAll<HTMLElement>(".d-surface-bulk-ordering").forEach((el) => el.classList.toggle("hidden", bags));
  }
  function updateGeoState() {
    const enabled = checked("d-geo-enabled");
    $("d-geo-fields")?.classList.toggle("opacity-50", !enabled);
    ["d-geo-overlap", "d-geo-price", "d-geo-roll-width", "d-geo-roll-length"].forEach((id) => {
      const el = $<HTMLInputElement>(id);
      if (el) el.disabled = !enabled;
    });
  }
  function primaryDimensionsFt() {
    return {
      lengthFt: lengthToFeet(Math.max(0, num("d-len")), selected("d-len-unit") || "ft"),
      widthFt: lengthToFeet(Math.max(0, num("d-wid")), selected("d-wid-unit") || "ft"),
    };
  }
  function updateEdgingState() {
    const mode = selected("d-edging-mode");
    const fields = $("d-edging-fields");
    fields?.classList.toggle("hidden", mode === "none");
    const lengthInput = $<HTMLInputElement>("d-edging-length");
    if (!lengthInput || mode === "none") return;
    const { lengthFt, widthFt } = primaryDimensionsFt();
    if (mode === "sides") {
      lengthInput.value = String(lengthFt * 2);
      lengthInput.readOnly = true;
    } else if (mode === "perimeter") {
      lengthInput.value = String((lengthFt + widthFt) * 2);
      lengthInput.readOnly = true;
    } else {
      lengthInput.readOnly = false;
    }
  }
  function previewAreaFt2() {
    try {
      const { lengthFt, widthFt } = primaryDimensionsFt();
      let area = lengthFt * widthFt;
      const layout = selected("d-layout");
      if (layout === "lshape") {
        area -= lengthToFeet(num("d-cut-len"), selected("d-cut-len-unit")) * lengthToFeet(num("d-cut-wid"), selected("d-cut-wid-unit"));
      } else if (layout === "multi") {
        for (const p of ["s2", "s3"]) {
          const l = num(`d-${p}-len`);
          const w = num(`d-${p}-wid`);
          if (l > 0 && w > 0) area += lengthToFeet(l, selected(`d-${p}-len-unit`)) * lengthToFeet(w, selected(`d-${p}-wid-unit`));
        }
      }
      area += areaToFt2(num("d-extra-area"), selected("d-extra-area-unit") || "ft2");
      return Math.max(0, area);
    } catch {
      return 0;
    }
  }
  function updatePreview() {
    const layout = selected("d-layout");
    const layoutLabel = layout === "lshape" ? "L-shape" : layout === "multi" ? "Multiple sections" : "Rectangle";
    const len = num("d-len");
    const wid = num("d-wid");
    setText("d-preview-footprint", `${layoutLabel} · primary ${fmt(len, 1)} ${selected("d-len-unit")} × ${fmt(wid, 1)} ${selected("d-wid-unit")}`);
    const areaFt2 = previewAreaFt2();
    setText("d-preview-area", selected("d-output-system") === "metric" ? `${fmt(areaFt2 * 0.09290304, 1)} m²` : `${fmt(areaFt2, 1)} ft²`);

    for (const prefix of ["subbase", "base", "surface"]) {
      const depth = fmt(num(`d-${prefix}-depth`), 1);
      const depthUnit = selected(`d-${prefix}-depth-unit`);
      const supply = prefix === "surface" && selected("d-surface-supply") === "bags" ? " · bagged" : "";
      setText(`d-preview-${prefix}-value`, `${depth} ${depthUnit} · ${materialName(prefix)}${supply}`);
    }
  }
  function refreshDerivedUi() {
    updateLayoutVisibility();
    updateLayerVisibility();
    updateSurfaceSupply();
    updateGeoState();
    updateEdgingState();
    updateAllAllowanceSummaries();
    updatePreview();
  }
  function truckCapacityTons() {
    const value = num("d-truck-capacity", 20);
    return selected("d-truck-capacity-unit") === "tonne" ? value / SHORT_TON_TO_TONNE : value;
  }
  function layer(prefix: string, label: string, enabled: boolean) {
    const supplyMode: SupplyMode = prefix === "surface" ? (selected("d-surface-supply") as SupplyMode) : "bulk";
    return {
      id: prefix,
      label,
      enabled,
      depthFt: lengthToFeet(num(`d-${prefix}-depth`), selected(`d-${prefix}-depth-unit`)),
      densityValue: num(`d-${prefix}-density`),
      densityUnit: selected(`d-${prefix}-density-unit`) as DensityUnit,
      compactionPct: num(`d-${prefix}-compaction`),
      wastePct: num(`d-${prefix}-waste`),
      price: num(`d-${prefix}-price`),
      priceBasis: selected(`d-${prefix}-price-basis`) as PriceBasis,
      supplyMode,
      bagWeightLb: prefix === "surface" ? num("d-surface-bag-weight", 50) : undefined,
      bagPrice: prefix === "surface" ? num("d-surface-bag-price") : undefined,
      supplierIncrementTons: num(`d-${prefix}-increment`),
      supplierMinimumTons: num(`d-${prefix}-minimum`),
    };
  }
  function footprintSections(primaryLengthFt: number, primaryWidthFt: number) {
    const layout = selected("d-layout");
    const sections: DrivewayFootprintSectionInput[] = [
      { id: "primary", label: "Primary driveway", enabled: true, lengthFt: primaryLengthFt, widthFt: primaryWidthFt, operation: "add" },
    ];
    if (layout === "lshape") {
      const cutLengthFt = lengthToFeet(num("d-cut-len"), selected("d-cut-len-unit"));
      const cutWidthFt = lengthToFeet(num("d-cut-wid"), selected("d-cut-wid-unit"));
      if (!(cutLengthFt > 0) || !(cutWidthFt > 0) || cutLengthFt >= primaryLengthFt || cutWidthFt >= primaryWidthFt) {
        throw new Error("L-shape cutout must be greater than zero and smaller than the primary driveway in both directions.");
      }
      sections.push({ id: "cutout", label: "L-shape cutout", enabled: true, lengthFt: cutLengthFt, widthFt: cutWidthFt, operation: "subtract" });
    } else if (layout === "multi") {
      for (const p of ["s2", "s3"]) {
        const rawL = num(`d-${p}-len`);
        const rawW = num(`d-${p}-wid`);
        if ((rawL > 0) !== (rawW > 0)) throw new Error(`${p === "s2" ? "Section 2" : "Section 3"} needs both length and width.`);
        if (rawL > 0 && rawW > 0) {
          sections.push({
            id: p,
            label: p === "s2" ? "Section 2" : "Section 3",
            enabled: true,
            lengthFt: lengthToFeet(rawL, selected(`d-${p}-len-unit`)),
            widthFt: lengthToFeet(rawW, selected(`d-${p}-wid-unit`)),
            operation: "add",
          });
        }
      }
    }
    return sections;
  }
  function serializeState() {
    const state: Record<string, string | boolean> = {};
    form?.querySelectorAll<HTMLInputElement | HTMLSelectElement>("input[id^='d-'], select[id^='d-']").forEach((el) => {
      if (el instanceof HTMLInputElement && el.type === "checkbox") state[el.id] = el.checked;
      else state[el.id] = el.value;
    });
    return state;
  }
  function hydrateState() {
    try {
      const token = new URL(window.location.href).searchParams.get("dg");
      if (!token) return;
      const state = JSON.parse(atob(token)) as Record<string, string | boolean>;
      for (const [id, value] of Object.entries(state)) {
        const el = document.getElementById(id);
        if (el instanceof HTMLInputElement && el.type === "checkbox") el.checked = Boolean(value);
        else if (el instanceof HTMLInputElement || el instanceof HTMLSelectElement) el.value = String(value);
      }
    } catch {
      // Ignore malformed shared state and retain safe defaults.
    }
  }
  function shareUrl() {
    const url = new URL(window.location.href);
    url.searchParams.set("dg", btoa(JSON.stringify(serializeState())));
    url.hash = "";
    return url.toString();
  }
  function downloadBlob(filename: string, content: string, type = "text/plain;charset=utf-8") {
    const blob = new Blob([content], { type });
    const url = URL.createObjectURL(blob);
    const link = document.createElement("a");
    link.href = url;
    link.download = filename;
    document.body.appendChild(link);
    link.click();
    link.remove();
    URL.revokeObjectURL(url);
  }
  function csvCell(value: string) {
    return `"${value.replace(/"/g, '""')}"`;
  }
  function renderCalculation(calculation: ReturnType<typeof calculateDrivewayGravel>, shouldScroll = true) {
    const metric = selected("d-output-system") === "metric";
    const supplierWeight = metric ? calculation.supplierOrderTons * SHORT_TON_TO_TONNE : calculation.supplierOrderTons;
    const supplierVolume = metric ? calculation.supplierOrderYd3 * YD3_TO_M3 : calculation.supplierOrderYd3;
    const installedVolume = metric ? calculation.installedM3 : calculation.installedYd3;
    const area = metric ? calculation.areaM2 : calculation.areaFt2;
    const rounding = metric ? calculation.supplierRoundingOverageTons * SHORT_TON_TO_TONNE : calculation.supplierRoundingOverageTons;

    setText("d-total-tons", fmt(supplierWeight));
    setText("d-primary-weight-unit", metric ? "tonnes" : "US tons");
    setText("d-total-yd3", fmt(supplierVolume));
    setText("d-primary-volume-unit", metric ? "m³" : "yd³");
    setText("d-area", fmt(area, 1));
    setText("d-primary-area-unit", metric ? "m²" : "ft²");
    setText("d-secondary-summary", metric
      ? `required ${fmt(calculation.tonnes)} tonnes · ${fmt(calculation.kilograms, 0)} kg`
      : `required ${fmt(calculation.tons)} US tons · ${fmt(calculation.pounds, 0)} lb`);
    setText("d-installed-yd3", fmt(installedVolume));
    setText("d-installed-unit", metric ? "m³" : "yd³");
    setText("d-rounding-overage", fmt(rounding));
    setText("d-rounding-unit", metric ? "tonnes" : "US tons");
    setText("d-loads", String(calculation.truckLoads));
    const payloadValue = num("d-truck-capacity", 20);
    const payloadUnit = selected("d-truck-capacity-unit") === "tonne" ? "tonnes payload" : "US tons payload";
    setText("d-load-capacity", `${fmt(payloadValue, 1)} ${payloadUnit}`);
    setText("d-material-cost", calculation.materialCost > 0 ? money(calculation.materialCost) : "—");
    setText("d-total-cost", calculation.totalCost > 0 ? money(calculation.totalCost) : "—");

    setText("d-th-installed", metric ? "INSTALLED m³" : "INSTALLED yd³");
    setText("d-th-required", metric ? "REQUIRED m³" : "REQUIRED yd³");
    setText("d-th-supplier", metric ? "SUPPLIER ORDER (METRIC)" : "SUPPLIER ORDER");

    const body = $<HTMLTableSectionElement>("d-layer-results");
    if (body) {
      body.innerHTML = calculation.layers.map((row) => {
        const installed = metric ? row.installedM3 : row.installedYd3;
        const required = metric ? row.orderM3 : row.orderYd3;
        const supplierTons = metric ? row.supplierOrderTons * SHORT_TON_TO_TONNE : row.supplierOrderTons;
        const supplierVol = metric ? row.supplierOrderYd3 * YD3_TO_M3 : row.supplierOrderYd3;
        const overage = metric ? row.supplierRoundingOverageTons * SHORT_TON_TO_TONNE : row.supplierRoundingOverageTons;
        const densityMetric = row.densityTonYd3 * 907.18474 / YD3_TO_M3;
        const packageText = row.supplyMode === "bags"
          ? `${row.bags} bags × ${fmt(row.bagWeightLb, 0)} lb`
          : `${row.truckLoads} load${row.truckLoads === 1 ? "" : "s"} · final ${fmt(metric ? row.finalLoadTons * SHORT_TON_TO_TONNE : row.finalLoadTons)} ${metric ? "t" : "US t"}`;
        const supplierText = row.supplyMode === "bags"
          ? `${fmt(supplierTons)} ${metric ? "t" : "US t"} eq. · ${fmt(supplierVol)} ${metric ? "m³" : "yd³"}`
          : `${fmt(supplierTons)} ${metric ? "t" : "US t"} · ${fmt(supplierVol)} ${metric ? "m³" : "yd³"}`;
        return `
          <tr>
            <td class="px-3 py-2"><span class="font-medium text-ink">${row.label}</span><span class="mt-0.5 block text-[10px] text-mute">${materialName(row.id)}</span></td>
            <td class="px-3 py-2 font-mono tabular-nums">${fmt(installed)}</td>
            <td class="px-3 py-2 font-mono tabular-nums">${fmt(required)}</td>
            <td class="px-3 py-2 font-mono tabular-nums">${supplierText}${overage > 0.0001 ? `<span class="mt-0.5 block text-[10px] text-mute">+${fmt(overage)} ${metric ? "t" : "US t"} package/rounding overage</span>` : ""}</td>
            <td class="px-3 py-2 font-mono tabular-nums">${metric ? `${fmt(densityMetric, 0)} kg/m³` : `${fmt(row.densityTonYd3)} t/yd³`}</td>
            <td class="px-3 py-2 font-mono tabular-nums">${packageText}</td>
            <td class="px-3 py-2 font-mono tabular-nums">${row.materialCost > 0 ? money(row.materialCost) : "—"}</td>
          </tr>`;
      }).join("");
    }

    const geoCard = $("d-geo-result-card");
    const edgingCard = $("d-edging-result-card");
    geoCard?.classList.toggle("hidden", !calculation.geotextile.enabled);
    edgingCard?.classList.toggle("hidden", !calculation.edging.enabled);
    $("d-ancillary-results")?.classList.toggle("hidden", !calculation.geotextile.enabled && !calculation.edging.enabled);
    if (calculation.geotextile.enabled) {
      setText("d-geo-result", metric
        ? `${fmt(calculation.geotextile.requiredAreaM2, 1)} m² · ${calculation.geotextile.rolls} roll${calculation.geotextile.rolls === 1 ? "" : "s"}`
        : `${fmt(calculation.geotextile.requiredAreaFt2, 1)} ft² · ${calculation.geotextile.rolls} roll${calculation.geotextile.rolls === 1 ? "" : "s"}`);
    }
    if (calculation.edging.enabled) {
      setText("d-edging-result", metric
        ? `${fmt(calculation.edging.lengthM, 1)} m · ${calculation.edging.cost > 0 ? money(calculation.edging.cost) : "cost not entered"}`
        : `${fmt(calculation.edging.lengthFt, 1)} ft · ${calculation.edging.cost > 0 ? money(calculation.edging.cost) : "cost not entered"}`);
    }

    const bomRows: string[][] = calculation.layers.map((row) => {
      const quantity = row.supplyMode === "bags"
        ? `${row.bags} × ${fmt(row.bagWeightLb, 0)} lb bags`
        : `${fmt(row.supplierOrderTons)} US tons / ${fmt(row.supplierOrderYd3)} yd³`;
      const notes = row.supplyMode === "bags"
        ? `Required ${fmt(row.tons)} US tons equivalent`
        : `Required ${fmt(row.tons)} US tons; ${row.truckLoads} truck load${row.truckLoads === 1 ? "" : "s"}${row.supplierRoundingOverageTons > 0 ? `; +${fmt(row.supplierRoundingOverageTons)} US tons supplier rounding` : ""}`;
      return [`${row.label} — ${materialName(row.id)}`, quantity, notes, row.materialCost > 0 ? money(row.materialCost) : ""];
    });
    if (calculation.geotextile.enabled) {
      bomRows.push(["Geotextile fabric", `${calculation.geotextile.rolls} roll${calculation.geotextile.rolls === 1 ? "" : "s"}`, `${fmt(calculation.geotextile.requiredAreaFt2, 1)} ft² incl. overlap`, calculation.geotextile.cost > 0 ? money(calculation.geotextile.cost) : ""]);
    }
    if (calculation.edging.enabled) {
      bomRows.push(["Driveway edging", `${fmt(calculation.edging.lengthFt, 1)} ft`, "Entered/calculated exposed edge length", calculation.edging.cost > 0 ? money(calculation.edging.cost) : ""]);
    }
    if (calculation.delivery > 0) bomRows.push(["Delivery / trucking", "1 entered total", "Project delivery allowance", money(calculation.delivery)]);

    const bomBody = $<HTMLTableSectionElement>("d-bom-results");
    if (bomBody) {
      bomBody.innerHTML = bomRows.map((row) => `<tr>${row.map((cell, index) => `<td class="px-3 py-2 ${index === 0 ? "font-medium text-ink" : "font-mono tabular-nums"}">${cell || "—"}</td>`).join("")}</tr>`).join("");
    }

    const summaryLines = [
      "DRIVEWAY GRAVEL SUPPLIER SUMMARY",
      `Footprint: ${fmt(calculation.areaFt2, 1)} ft² / ${fmt(calculation.areaM2, 1)} m²`,
      ...calculation.layers.map((row) => row.supplyMode === "bags"
        ? `${row.label} — ${materialName(row.id)}: ${row.bags} × ${fmt(row.bagWeightLb, 0)} lb bags (required ${fmt(row.tons)} US tons eq.)`
        : `${row.label} — ${materialName(row.id)}: required ${fmt(row.tons)} US tons; supplier order ${fmt(row.supplierOrderTons)} US tons / ${fmt(row.supplierOrderYd3)} yd³; ${row.truckLoads} load(s)`),
      calculation.geotextile.enabled ? `Geotextile: ${fmt(calculation.geotextile.requiredAreaFt2, 1)} ft², ${calculation.geotextile.rolls} roll(s)` : "",
      calculation.edging.enabled ? `Edging: ${fmt(calculation.edging.lengthFt, 1)} ft` : "",
      `Supplier order total: ${fmt(calculation.supplierOrderTons)} US tons equivalent / ${fmt(calculation.supplierOrderYd3)} yd³ equivalent`,
      `Supplier/package rounding overage: ${fmt(calculation.supplierRoundingOverageTons)} US tons`,
      `Bulk truck loads: ${calculation.truckLoads}`,
      calculation.materialCost > 0 ? `Materials + project extras: ${money(calculation.materialCost)}` : "",
      calculation.totalCost > 0 ? `Entered-scope total: ${money(calculation.totalCost)}` : "",
      "Confirm supplier density, product gradation, legal payload, bed volume, minimums and project specifications before ordering.",
    ].filter(Boolean);

    if (results) {
      results.dataset.summary = summaryLines.join("\n");
      results.dataset.bomCsv = [
        ["Item", "Order quantity", "Notes", "Cost"],
        ...bomRows,
      ].map((row) => row.map(csvCell).join(",")).join("\n");
    }

    hasCalculated = true;
    lastCalculation = calculation;
    $("d-recalc-note")?.classList.add("hidden");
    results?.classList.remove("hidden");
    if (shouldScroll) results?.scrollIntoView({ behavior: "smooth", block: "nearest" });
  }

  if (form && results) {
    hydrateState();

    document.querySelectorAll<HTMLSelectElement>(".d-material").forEach((select) => {
      select.addEventListener("change", () => {
        setDensityControlState(select);
        refreshDerivedUi();
        invalidateResults();
      });
      setDensityControlState(select);
    });

    $<HTMLSelectElement>("d-build")?.addEventListener("change", () => {
      refreshDerivedUi();
      invalidateResults();
    });
    $<HTMLSelectElement>("d-layout")?.addEventListener("change", () => {
      refreshDerivedUi();
      invalidateResults();
    });
    $<HTMLSelectElement>("d-surface-supply")?.addEventListener("change", () => {
      refreshDerivedUi();
      invalidateResults();
    });
    $<HTMLInputElement>("d-geo-enabled")?.addEventListener("change", () => {
      refreshDerivedUi();
      invalidateResults();
    });
    $<HTMLSelectElement>("d-edging-mode")?.addEventListener("change", () => {
      refreshDerivedUi();
      invalidateResults();
    });
    $<HTMLSelectElement>("d-output-system")?.addEventListener("change", () => {
      updatePreview();
      if (lastCalculation && hasCalculated) renderCalculation(lastCalculation, false);
    });

    form.addEventListener("input", (event) => {
      const target = event.target as HTMLElement | null;
      if (target?.id?.endsWith("-compaction") || target?.id?.endsWith("-waste")) {
        const prefix = target.id.split("-")[1];
        if (prefix) updateAllowanceSummary(prefix);
      }
      if (target?.id !== "d-output-system") {
        updateEdgingState();
        updatePreview();
        invalidateResults();
      }
    });
    form.addEventListener("change", (event) => {
      const target = event.target as HTMLElement | null;
      if (!target || target.id === "d-output-system" || target.classList.contains("d-material")) return;
      updateEdgingState();
      updatePreview();
      invalidateResults();
    });

    refreshDerivedUi();

    const runCalculation = () => {
      clearErrors();

      const lengthValue = num("d-len", Number.NaN);
      const widthValue = num("d-wid", Number.NaN);
      let valid = true;
      if (!(lengthValue > 0)) { showError("d-len-error", "Enter a driveway length greater than zero."); valid = false; }
      if (!(widthValue > 0)) { showError("d-wid-error", "Enter a driveway width greater than zero."); valid = false; }
      if (!valid) return;

      try {
        const primaryLengthFt = lengthToFeet(lengthValue, selected("d-len-unit"));
        const primaryWidthFt = lengthToFeet(widthValue, selected("d-wid-unit"));
        const build = selected("d-build");
        const edgingMode = selected("d-edging-mode");

        const calculation = calculateDrivewayGravel({
          lengthFt: primaryLengthFt,
          widthFt: primaryWidthFt,
          extraAreaFt2: areaToFt2(num("d-extra-area"), selected("d-extra-area-unit")),
          sections: footprintSections(primaryLengthFt, primaryWidthFt),
          layers: [
            layer("subbase", "Sub-base", build === "three"),
            layer("base", "Base course", build !== "surface"),
            layer("surface", "Surface course", true),
          ],
          truckCapacityTons: truckCapacityTons(),
          delivery: num("d-delivery"),
          taxPct: num("d-tax"),
          geotextile: {
            enabled: checked("d-geo-enabled"),
            overlapPct: num("d-geo-overlap"),
            rollWidthFt: num("d-geo-roll-width"),
            rollLengthFt: num("d-geo-roll-length"),
            pricePerRoll: num("d-geo-price"),
          },
          edging: {
            enabled: edgingMode !== "none",
            lengthFt: num("d-edging-length"),
            pricePerFt: num("d-edging-price"),
          },
        });

        renderCalculation(calculation);
      } catch (error) {
        showError("d-form-error", error instanceof Error ? error.message : "Check the entered values and try again.");
      }
    };

    form.addEventListener("submit", (event) => {
      event.preventDefault();
      runCalculation();
    });
    $("d-calculate")?.addEventListener("click", (event) => {
      event.preventDefault();
      runCalculation();
    });

    form.addEventListener("reset", () => {
      hasCalculated = false;
      lastCalculation = null;
      clearErrors();
      results.classList.add("hidden");
      setText("d-copy-status", "");
      $("d-recalc-note")?.classList.add("hidden");
      setTimeout(() => {
        document.querySelectorAll<HTMLSelectElement>(".d-material").forEach(setDensityControlState);
        refreshDerivedUi();
      }, 0);
    });

    $("d-copy")?.addEventListener("click", async () => {
      const summary = results.dataset.summary ?? "";
      if (!summary) return;
      try {
        await navigator.clipboard.writeText(summary);
        setText("d-copy-status", "Supplier summary copied.");
      } catch {
        setText("d-copy-status", "Copy was blocked by the browser. Select the results and copy manually.");
      }
    });
    $("d-share")?.addEventListener("click", async () => {
      try {
        await navigator.clipboard.writeText(shareUrl());
        setText("d-copy-status", "Share link copied with the current calculator inputs.");
      } catch {
        setText("d-copy-status", "Share-link copy was blocked by the browser.");
      }
    });
    $("d-download-report")?.addEventListener("click", () => {
      const summary = results.dataset.summary ?? "";
      if (summary) downloadBlob("driveway-gravel-order-plan.txt", summary + "\n");
    });
    $("d-download-bom")?.addEventListener("click", () => {
      const csv = results.dataset.bomCsv ?? "";
      if (csv) downloadBlob("driveway-gravel-bom.csv", csv + "\n", "text/csv;charset=utf-8");
    });
    $("d-print")?.addEventListener("click", () => window.print());
  }
</script>
