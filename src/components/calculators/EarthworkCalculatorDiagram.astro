---
const slug = "earthwork-calculator";
---

<figure
  class="calc-project-diagram rounded-xl border border-border bg-card p-4 sm:p-5"
  data-project-diagram
  data-earthwork-rich-diagram
  data-kind="earthwork"
>
  <div class="flex flex-wrap items-start justify-between gap-2">
    <div>
      <h3 class="text-xs font-mono font-semibold uppercase tracking-wider text-foreground">Live earthwork volume diagram</h3>
      <p class="mt-1 max-w-[720px] text-[11px] leading-5 text-muted-foreground">
        Bank volume, swell to loose material, shrink to compacted material, and the dimension or known-volume source update directly from the calculator inputs.
      </p>
    </div>
    <span class="rounded-full border border-border bg-muted px-2 py-1 font-mono text-[10px] text-muted-foreground">BANK → LOOSE / COMPACTED</span>
  </div>

  <div class="mt-4 overflow-hidden rounded-xl border border-border bg-background">
    <svg viewBox="0 0 760 500" class="h-auto w-full" role="img" aria-labelledby="earthwork-diagram-title earthwork-diagram-desc">
      <title id="earthwork-diagram-title">Live earthwork bank, loose, and compacted volume diagram</title>
      <desc id="earthwork-diagram-desc">
        Earthwork diagram showing dimensional bank volume or known bank volume, plus material swell to loose volume and shrink to compacted equivalent.
      </desc>

      <defs>
        <marker id="earth-arrow-end" markerWidth="8" markerHeight="8" refX="7" refY="4" orient="auto">
          <path d="M0 0 L8 4 L0 8 Z" fill="#2563eb"/>
        </marker>
        <pattern id="earth-pattern" width="20" height="16" patternUnits="userSpaceOnUse">
          <path d="M0 12 L5 8 L9 12 L14 6 L20 11" fill="none" stroke="var(--color-muted-foreground)" stroke-width="1" opacity=".34"/>
        </pattern>
      </defs>

      <text x="30" y="30" font-size="13" font-weight="700" fill="var(--color-foreground)">Bank quantity source</text>
      <text x="730" y="30" text-anchor="end" font-size="11" fill="var(--color-muted-foreground)" data-earth-source-label>100 ft × 50 ft × 2 ft</text>

      <g data-earth-dimension-view>
        <path d="M86 112 L355 112 L428 160 L159 160 Z" fill="var(--color-muted)" opacity=".18" stroke="var(--color-foreground)" stroke-width="1.5"/>
        <path d="M159 160 L428 160 L428 275 L159 275 Z" fill="url(#earth-pattern)" stroke="var(--color-foreground)" stroke-width="1.5"/>
        <path d="M86 112 L159 160 L159 275 L86 225 Z" fill="var(--color-muted)" opacity=".22" stroke="var(--color-foreground)" stroke-width="1.2"/>

        <text x="259" y="99" text-anchor="middle" font-size="12" font-weight="700" fill="#1d4ed8" data-earth-length>Length = 100 ft</text>
        <text x="114" y="145" font-size="11.5" font-weight="700" fill="#1d4ed8" transform="rotate(-32 114 145)" data-earth-width>Width = 50 ft</text>
        <text x="446" y="218" text-anchor="middle" font-size="11.5" font-weight="700" fill="#1d4ed8" transform="rotate(-90 446 218)" data-earth-depth>Depth = 2 ft</text>
        <text x="294" y="221" text-anchor="middle" font-size="12.5" font-weight="700" fill="var(--color-foreground)" data-earth-bank-ft3>10,000 ft³</text>
        <text x="294" y="242" text-anchor="middle" font-size="10.5" fill="var(--color-muted-foreground)">in-place bank volume</text>
      </g>

      <g data-earth-known-view style="display:none">
        <rect x="105" y="112" width="310" height="163" rx="14" fill="url(#earth-pattern)" stroke="var(--color-foreground)" stroke-width="1.6"/>
        <text x="260" y="173" text-anchor="middle" font-size="11" fill="var(--color-muted-foreground)">Known in-place bank volume</text>
        <text x="260" y="205" text-anchor="middle" font-size="24" font-weight="700" fill="#1d4ed8" data-earth-known-volume>100 ft³</text>
        <text x="260" y="231" text-anchor="middle" font-size="10.5" fill="var(--color-muted-foreground)">No geometry inferred</text>
      </g>

      <g transform="translate(500 94)">
        <rect x="0" y="0" width="220" height="190" rx="14" fill="var(--color-muted)" opacity=".18" stroke="var(--color-border)"/>
        <text x="18" y="26" font-size="10.5" font-weight="700" fill="var(--color-foreground)">VOLUME STATES</text>

        <text x="18" y="60" font-size="11" fill="var(--color-muted-foreground)">Bank</text>
        <text x="202" y="60" text-anchor="end" font-size="16" font-weight="700" fill="var(--color-foreground)" data-earth-bank>370.37 yd³</text>

        <line x1="18" y1="76" x2="202" y2="76" stroke="var(--color-border)"/>

        <text x="18" y="103" font-size="11" fill="var(--color-muted-foreground)">Loose after swell</text>
        <text x="202" y="103" text-anchor="end" font-size="16" font-weight="700" fill="#1d4ed8" data-earth-loose>444.44 yd³</text>

        <text x="18" y="127" font-size="10.5" fill="var(--color-muted-foreground)" data-earth-swell>+20% swell</text>

        <line x1="18" y1="143" x2="202" y2="143" stroke="var(--color-border)"/>

        <text x="18" y="169" font-size="11" fill="var(--color-muted-foreground)">Compacted equivalent</text>
        <text x="202" y="169" text-anchor="end" font-size="16" font-weight="700" fill="#1d4ed8" data-earth-compacted>333.33 yd³</text>
        <text x="18" y="187" font-size="10.5" fill="var(--color-muted-foreground)" data-earth-shrink>−10% shrink</text>
      </g>

      <line x1="472" y1="317" x2="676" y2="317" stroke="#2563eb" stroke-width="1.6" marker-end="url(#earth-arrow-end)"/>
      <text x="574" y="305" text-anchor="middle" font-size="10.5" fill="var(--color-muted-foreground)">material-state conversion</text>

      <rect x="30" y="342" width="700" height="65" rx="10" fill="var(--color-muted)" opacity=".22" stroke="var(--color-border)"/>
      <text x="48" y="365" font-size="10.5" font-weight="700" fill="var(--color-foreground)">EARTHWORK FORMULA</text>
      <text x="48" y="388" font-size="12.5" font-weight="700" fill="var(--color-foreground)" data-earth-formula>Bank = L × W × D</text>
      <text x="712" y="378" text-anchor="end" font-size="11.5" font-weight="700" fill="#1d4ed8">Loose = bank × (1 + swell)</text>
      <text x="712" y="397" text-anchor="end" font-size="11.5" font-weight="700" fill="#1d4ed8">Compacted = bank × (1 − shrink)</text>

      <g transform="translate(30 430)">
        <rect x="0" y="0" width="216" height="48" rx="10" fill="var(--color-muted)" opacity=".18" stroke="var(--color-border)"/>
        <text x="14" y="19" font-size="10" fill="var(--color-muted-foreground)">Bank volume</text>
        <text x="14" y="37" font-size="12" font-weight="700" fill="var(--color-foreground)" data-earth-card-bank>370.37 yd³</text>
      </g>
      <g transform="translate(272 430)">
        <rect x="0" y="0" width="216" height="48" rx="10" fill="var(--color-muted)" opacity=".18" stroke="var(--color-border)"/>
        <text x="14" y="19" font-size="10" fill="var(--color-muted-foreground)">Loose volume</text>
        <text x="14" y="37" font-size="12" font-weight="700" fill="var(--color-foreground)" data-earth-card-loose>444.44 yd³</text>
      </g>
      <g transform="translate(514 430)">
        <rect x="0" y="0" width="216" height="48" rx="10" fill="var(--color-muted)" opacity=".18" stroke="var(--color-border)"/>
        <text x="14" y="19" font-size="10" fill="var(--color-muted-foreground)">Compacted equivalent</text>
        <text x="14" y="37" font-size="12" font-weight="700" fill="var(--color-foreground)" data-earth-card-compacted>333.33 yd³</text>
      </g>
    </svg>
  </div>

  <p class="mt-3 text-[11px] leading-5 text-muted-foreground">
    Swell and shrink are material/project inputs, not universal soil constants. Average-depth geometry is a preliminary quantity method for reasonably uniform areas.
  </p>
</figure>

<script>
  function initEarthworkRichDiagrams() {
    document.querySelectorAll<HTMLElement>("[data-earthwork-rich-diagram]").forEach((figure) => {
      if (figure.dataset.initialized) return;
      figure.dataset.initialized = "true";

      const root = figure.closest<HTMLElement>('[data-calculator-slug="earthwork-calculator"]');
      if (!root) return;
      const form = root.querySelector<HTMLFormElement>("#earthwork-calculator-form");
      if (!form) return;

      const input = (id: string) => root.querySelector<HTMLInputElement>("#earthwork-calculator-" + id);
      const select = (id: string) => root.querySelector<HTMLSelectElement>("#earthwork-calculator-" + id);
      const unit = (id: string) => root.querySelector<HTMLSelectElement>("#earthwork-calculator-" + id + "-unit");

      const unitText = (id: string) => {
        const u = unit(id);
        return u ? (u.options[u.selectedIndex]?.text?.trim() || u.value) : "";
      };

      const displayValue = (id: string) => {
        const raw = input(id)?.value?.trim() ?? "";
        if (!raw) return "—";
        const n = Number(raw);
        const shown = Number.isFinite(n) ? String(Number(n.toFixed(4))) : raw;
        const label = unitText(id);
        return label ? shown + " " + label : shown;
      };

      const feet = (id: string) => {
        const n = Number(input(id)?.value);
        if (!Number.isFinite(n)) return Number.NaN;
        const factors: Record<string, number> = { ft: 1, in: 1 / 12, yd: 3, m: 1 / 0.3048, cm: 1 / 30.48, mm: 1 / 304.8 };
        return n * (factors[unit(id)?.value ?? "ft"] ?? 1);
      };

      const volumeFt3 = (id: string) => {
        const n = Number(input(id)?.value);
        if (!Number.isFinite(n)) return Number.NaN;
        const u = unit(id)?.value ?? "ft3";
        const factors: Record<string, number> = {
          ft3: 1, "ft³": 1,
          yd3: 27, "yd³": 27,
          in3: 1 / 1728, "in³": 1 / 1728,
          m3: 35.3146667215, "m³": 35.3146667215,
          cm3: 0.0000353146667215, "cm³": 0.0000353146667215,
          L: 0.0353146667215, l: 0.0353146667215
        };
        return n * (factors[u] ?? 1);
      };

      const num = (id: string, fallback = 0) => {
        const n = Number(input(id)?.value);
        return Number.isFinite(n) ? n : fallback;
      };

      const fmt = (value: number, digits = 2) =>
        Number.isFinite(value) ? String(Number(value.toFixed(digits))) : "—";

      const fmtInt = (value: number) =>
        Number.isFinite(value) ? Math.round(value).toLocaleString("en-US") : "—";

      const setText = (selector: string, text: string) => {
        figure.querySelectorAll<SVGTextElement | HTMLElement>(selector).forEach((el) => {
          el.textContent = text;
        });
      };

      const setVisible = (selector: string, visible: boolean) => {
        figure.querySelectorAll<SVGElement | HTMLElement>(selector).forEach((el) => {
          (el as HTMLElement).style.display = visible ? "" : "none";
        });
      };

      const update = () => {
        const mode = Math.round(Number(select("mode")?.value ?? "0"));
        const knownMode = mode === 1;
        const L = feet("length");
        const W = feet("width");
        const D = feet("depth");
        const knownFt3 = volumeFt3("volume");
        const swell = Math.max(0, num("swell", 0));
        const shrink = Math.max(0, Math.min(99.999, num("shrink", 0)));

        const bankFt3 = knownMode
          ? (Number.isFinite(knownFt3) && knownFt3 >= 0 ? knownFt3 : 0)
          : ([L, W, D].every(v => Number.isFinite(v) && v >= 0) ? L * W * D : 0);

        const bankYd3 = bankFt3 / 27;
        const looseYd3 = bankYd3 * (1 + swell / 100);
        const compactedYd3 = bankYd3 * (1 - shrink / 100);

        setVisible("[data-earth-dimension-view]", !knownMode);
        setVisible("[data-earth-known-view]", knownMode);

        setText(
          "[data-earth-source-label]",
          knownMode ? "Known bank volume = " + displayValue("volume")
            : displayValue("length") + " × " + displayValue("width") + " × " + displayValue("depth")
        );
        setText("[data-earth-length]", "Length = " + displayValue("length"));
        setText("[data-earth-width]", "Width = " + displayValue("width"));
        setText("[data-earth-depth]", "Depth = " + displayValue("depth"));
        setText("[data-earth-bank-ft3]", fmtInt(bankFt3) + " ft³");
        setText("[data-earth-known-volume]", displayValue("volume"));
        setText("[data-earth-bank]", fmt(bankYd3) + " yd³");
        setText("[data-earth-loose]", fmt(looseYd3) + " yd³");
        setText("[data-earth-compacted]", fmt(compactedYd3) + " yd³");
        setText("[data-earth-swell]", "+" + fmt(swell) + "% swell");
        setText("[data-earth-shrink]", "−" + fmt(shrink) + "% shrink");
        setText("[data-earth-formula]", knownMode ? "Bank = entered in-place volume" : "Bank = L × W × D");
        setText("[data-earth-card-bank]", fmt(bankYd3) + " yd³");
        setText("[data-earth-card-loose]", fmt(looseYd3) + " yd³");
        setText("[data-earth-card-compacted]", fmt(compactedYd3) + " yd³");
      };

      root.addEventListener("input", update);
      root.addEventListener("change", update);
      root.addEventListener("calculator-state-restored", update);
      form.addEventListener("reset", () => setTimeout(update, 0));

      update();
      queueMicrotask(update);
      requestAnimationFrame(update);
      setTimeout(update, 0);
    });
  }

  initEarthworkRichDiagrams();
  document.addEventListener("astro:page-load", initEarthworkRichDiagrams);
</script>
