---
const slug = "gravel-calculator";
---

<figure
  class="calc-project-diagram rounded-xl border border-border bg-card p-4 sm:p-5"
  data-project-diagram
  data-gravel-rich-diagram
>
  <div class="flex flex-wrap items-start justify-between gap-2">
    <div>
      <h3 class="text-xs font-mono font-semibold uppercase tracking-wider text-foreground">Live gravel project diagram</h3>
      <p class="mt-1 max-w-[660px] text-[11px] leading-5 text-muted-foreground">
        Plan, cross-section, and known-volume views update from the active gravel inputs. Schematic only — not to scale.
      </p>
    </div>
    <span class="rounded-full border border-border bg-muted px-2 py-1 font-mono text-[10px] text-muted-foreground">LIVE INPUT GUIDE</span>
  </div>

  <div class="mt-4 overflow-hidden rounded-xl border border-border bg-background">
    <svg viewBox="0 0 760 445" class="h-auto w-full" role="img" aria-labelledby={`${slug}-gravel-title ${slug}-gravel-desc`}>
      <title id={`${slug}-gravel-title`}>Live gravel calculator project diagram</title>
      <desc id={`${slug}-gravel-desc`}>
        Technical gravel quantity diagrams for length by width by depth, known area by depth, and known volume modes, including separate compaction and waste allowances.
      </desc>

      <defs>
        <marker id="gravel-arrow-start" markerWidth="8" markerHeight="8" refX="1" refY="4" orient="auto">
          <path d="M8 0 L0 4 L8 8 Z" fill="#2563eb"/>
        </marker>
        <marker id="gravel-arrow-end" markerWidth="8" markerHeight="8" refX="7" refY="4" orient="auto">
          <path d="M0 0 L8 4 L0 8 Z" fill="#2563eb"/>
        </marker>
        <pattern id="gravel-stones" width="24" height="18" patternUnits="userSpaceOnUse">
          <rect width="24" height="18" fill="var(--color-muted)" opacity=".48"/>
          <ellipse cx="5" cy="8" rx="3.4" ry="2.6" fill="none" stroke="var(--color-muted-foreground)" stroke-width="1" opacity=".55"/>
          <ellipse cx="14" cy="5" rx="2.8" ry="2.2" fill="none" stroke="var(--color-muted-foreground)" stroke-width="1" opacity=".48"/>
          <ellipse cx="20" cy="12" rx="3.6" ry="2.7" fill="none" stroke="var(--color-muted-foreground)" stroke-width="1" opacity=".5"/>
          <ellipse cx="10" cy="15" rx="2.4" ry="1.9" fill="none" stroke="var(--color-muted-foreground)" stroke-width=".9" opacity=".42"/>
        </pattern>
        <pattern id="gravel-soil" width="14" height="14" patternUnits="userSpaceOnUse" patternTransform="rotate(20)">
          <rect width="14" height="14" fill="var(--color-muted)" opacity=".2"/>
          <line x1="0" y1="0" x2="0" y2="14" stroke="var(--color-muted-foreground)" stroke-width="1" opacity=".24"/>
        </pattern>
      </defs>

      <rect width="760" height="445" fill="var(--color-background)"/>
      <text x="28" y="30" font-size="13" font-weight="700" fill="var(--color-foreground)" data-gravel-mode-name>Length × width × depth</text>
      <text x="732" y="30" text-anchor="end" font-size="11" fill="var(--color-muted-foreground)" data-gravel-material-name>Crushed stone</text>

      <!-- Mode 0: dimensions -->
      <g data-gravel-mode="0">
        <text x="42" y="62" font-size="11" font-weight="700" fill="var(--color-foreground)">TOP VIEW (PLACED AREA)</text>
        <rect x="88" y="104" width="365" height="158" rx="5" fill="url(#gravel-stones)" stroke="var(--color-foreground)" stroke-width="2"/>
        <line x1="88" y1="84" x2="453" y2="84" stroke="#2563eb" stroke-width="1.7" marker-start="url(#gravel-arrow-start)" marker-end="url(#gravel-arrow-end)"/>
        <line x1="88" y1="90" x2="88" y2="104" stroke="#2563eb" stroke-width="1.1" stroke-dasharray="4 4"/>
        <line x1="453" y1="90" x2="453" y2="104" stroke="#2563eb" stroke-width="1.1" stroke-dasharray="4 4"/>
        <text x="270" y="74" text-anchor="middle" font-size="13" font-weight="700" fill="#1d4ed8" data-gravel-length>Length = 20 ft</text>

        <line x1="66" y1="104" x2="66" y2="262" stroke="#2563eb" stroke-width="1.7" marker-start="url(#gravel-arrow-start)" marker-end="url(#gravel-arrow-end)"/>
        <line x1="72" y1="104" x2="88" y2="104" stroke="#2563eb" stroke-width="1.1" stroke-dasharray="4 4"/>
        <line x1="72" y1="262" x2="88" y2="262" stroke="#2563eb" stroke-width="1.1" stroke-dasharray="4 4"/>
        <text x="48" y="183" text-anchor="middle" font-size="13" font-weight="700" fill="#1d4ed8" transform="rotate(-90 48 183)" data-gravel-width>Width = 10 ft</text>

        <text x="507" y="62" font-size="11" font-weight="700" fill="var(--color-foreground)">CROSS SECTION</text>
        <rect x="520" y="122" width="190" height="54" fill="url(#gravel-stones)" stroke="var(--color-foreground)" stroke-width="2"/>
        <rect x="520" y="176" width="190" height="52" fill="url(#gravel-soil)"/>
        <line x1="728" y1="122" x2="728" y2="176" stroke="#2563eb" stroke-width="1.7" marker-start="url(#gravel-arrow-start)" marker-end="url(#gravel-arrow-end)"/>
        <line x1="710" y1="122" x2="734" y2="122" stroke="#2563eb" stroke-width="1.1" stroke-dasharray="4 4"/>
        <line x1="710" y1="176" x2="734" y2="176" stroke="#2563eb" stroke-width="1.1" stroke-dasharray="4 4"/>
        <text x="716" y="196" text-anchor="end" font-size="12" font-weight="700" fill="#1d4ed8" data-gravel-depth>Placed depth = 4 in</text>
        <text x="615" y="213" text-anchor="middle" font-size="10.5" fill="var(--color-muted-foreground)">Prepared subgrade / base context</text>
      </g>

      <!-- Mode 1: known area -->
      <g data-gravel-mode="1" style="display:none">
        <text x="42" y="62" font-size="11" font-weight="700" fill="var(--color-foreground)">KNOWN SURFACE AREA</text>
        <rect x="94" y="102" width="350" height="170" rx="8" fill="url(#gravel-stones)" stroke="var(--color-foreground)" stroke-width="2"/>
        <path d="M118 128 C190 92 280 120 342 104 C392 92 425 130 420 177 C416 230 351 246 286 237 C221 229 174 263 126 228 C84 198 80 150 118 128 Z" fill="none" stroke="#2563eb" stroke-width="1.3" stroke-dasharray="6 4"/>
        <text x="269" y="181" text-anchor="middle" font-size="20" font-weight="700" fill="var(--color-foreground)" data-gravel-area>200 ft²</text>
        <text x="269" y="204" text-anchor="middle" font-size="11" fill="var(--color-muted-foreground)">Measured surface area</text>

        <text x="507" y="62" font-size="11" font-weight="700" fill="var(--color-foreground)">AREA × DEPTH SECTION</text>
        <rect x="520" y="122" width="190" height="54" fill="url(#gravel-stones)" stroke="var(--color-foreground)" stroke-width="2"/>
        <rect x="520" y="176" width="190" height="52" fill="url(#gravel-soil)"/>
        <line x1="728" y1="122" x2="728" y2="176" stroke="#2563eb" stroke-width="1.7" marker-start="url(#gravel-arrow-start)" marker-end="url(#gravel-arrow-end)"/>
        <text x="716" y="196" text-anchor="end" font-size="12" font-weight="700" fill="#1d4ed8" data-gravel-depth>Placed depth = 4 in</text>
        <text x="615" y="247" text-anchor="middle" font-size="10.5" fill="var(--color-muted-foreground)">Volume = known area × placed depth</text>
      </g>

      <!-- Mode 2: known volume -->
      <g data-gravel-mode="2" style="display:none">
        <text x="42" y="62" font-size="11" font-weight="700" fill="var(--color-foreground)">KNOWN VOLUME</text>
        <path d="M88 264 C105 194 150 130 230 111 C315 91 403 120 455 188 C479 220 472 249 458 264 Z" fill="url(#gravel-stones)" stroke="var(--color-foreground)" stroke-width="2"/>
        <line x1="88" y1="282" x2="458" y2="282" stroke="#2563eb" stroke-width="1.6" marker-start="url(#gravel-arrow-start)" marker-end="url(#gravel-arrow-end)"/>
        <text x="273" y="306" text-anchor="middle" font-size="12" font-weight="700" fill="#1d4ed8">Entered bulk volume</text>
        <text x="273" y="188" text-anchor="middle" font-size="21" font-weight="700" fill="var(--color-foreground)" data-gravel-volume>2 yd³</text>

        <g transform="translate(525 98)">
          <rect width="178" height="156" rx="10" fill="var(--color-muted)" opacity=".24" stroke="var(--color-border)"/>
          <path d="M28 111 H148 L137 54 H39 Z" fill="url(#gravel-stones)" stroke="var(--color-foreground)" stroke-width="2"/>
          <line x1="26" y1="126" x2="150" y2="126" stroke="#2563eb" stroke-width="1.4" marker-start="url(#gravel-arrow-start)" marker-end="url(#gravel-arrow-end)"/>
          <text x="89" y="146" text-anchor="middle" font-size="10.5" fill="var(--color-muted-foreground)">Known delivery / stockpile volume</text>
        </g>
      </g>

      <!-- Shared allowance and formula panel -->
      <rect x="28" y="318" width="704" height="101" rx="12" fill="var(--color-muted)" opacity=".23" stroke="var(--color-border)"/>
      <text x="46" y="343" font-size="11" font-weight="700" fill="var(--color-foreground)">ORDER FORMULA</text>
      <text x="46" y="368" font-size="16" font-weight="700" fill="var(--color-foreground)" data-gravel-formula>Order = measured volume × compaction factor × waste factor</text>
      <text x="46" y="394" font-size="11" fill="var(--color-muted-foreground)">Compaction and purchasing waste stay separate.</text>

      <line x1="434" y1="334" x2="434" y2="406" stroke="var(--color-border)"/>
      <text x="457" y="343" font-size="11" font-weight="700" fill="var(--color-foreground)">CURRENT ASSUMPTIONS</text>
      <text x="457" y="367" font-size="13" font-weight="700" fill="#1d4ed8" data-gravel-allowances>Compaction 0% · Waste 10%</text>
      <text x="457" y="391" font-size="11.5" fill="var(--color-muted-foreground)" data-gravel-density>Density 1.40 US tons/yd³</text>
    </svg>
  </div>

  <dl class="mt-3 grid gap-2 text-xs sm:grid-cols-3">
    <div class="rounded-md border border-border bg-muted/30 px-3 py-2">
      <dt class="text-muted-foreground">Measurement mode</dt>
      <dd class="mt-0.5 font-mono font-medium text-foreground" data-gravel-mode-card>Length × width × depth</dd>
    </div>
    <div class="rounded-md border border-border bg-muted/30 px-3 py-2">
      <dt class="text-muted-foreground">Measured geometry</dt>
      <dd class="mt-0.5 font-mono font-medium text-foreground tabular-nums" data-gravel-summary>20 ft × 10 ft × 4 in</dd>
    </div>
    <div class="rounded-md border border-border bg-muted/30 px-3 py-2">
      <dt class="text-muted-foreground">Material</dt>
      <dd class="mt-0.5 font-mono font-medium text-foreground" data-gravel-material-card>Crushed stone · 1.40 ton/yd³</dd>
    </div>
  </dl>
</figure>

<script>
  function initGravelRichDiagrams() {
    document.querySelectorAll<HTMLElement>("[data-gravel-rich-diagram]").forEach((figure) => {
      if (figure.dataset.initialized) return;
      figure.dataset.initialized = "true";

      const root = figure.closest<HTMLElement>('[data-calculator-slug="gravel-calculator"]');
      if (!root) return;
      const form = root.querySelector<HTMLFormElement>("#gravel-calculator-form");
      const mode = root.querySelector<HTMLSelectElement>("#gravel-calculator-mode");
      const material = root.querySelector<HTMLSelectElement>("#gravel-calculator-material");
      if (!form || !mode || !material) return;

      const input = (id: string) => root.querySelector<HTMLInputElement>(`#gravel-calculator-${id}`);
      const unit = (id: string) => root.querySelector<HTMLSelectElement>(`#gravel-calculator-${id}-unit`);

      const unitLabel = (id: string) => {
        const select = unit(id);
        return select ? (select.options[select.selectedIndex]?.text?.trim() || select.value) : "";
      };

      const value = (id: string) => {
        const raw = input(id)?.value?.trim() ?? "";
        if (!raw) return "—";
        const n = Number(raw);
        const shown = Number.isFinite(n) ? String(Number(n.toFixed(4))) : raw;
        const u = unitLabel(id);
        return u ? `${shown} ${u}` : shown;
      };

      const numberValue = (id: string, fallback = 0) => {
        const n = Number(input(id)?.value);
        return Number.isFinite(n) ? n : fallback;
      };

      const setText = (selector: string, text: string) => {
        figure.querySelectorAll<SVGTextElement | HTMLElement>(selector).forEach((el) => { el.textContent = text; });
      };

      const materialNames = ["Pea gravel", "Crushed stone", "River rock", "Limestone", "Granite", "Custom supplier density"];
      const presetDensity = [1.35, 1.40, 1.33, 1.60, 1.42];

      const update = () => {
        const m = Math.max(0, Math.min(2, Math.round(Number(mode.value) || 0)));
        figure.querySelectorAll<SVGGElement>("[data-gravel-mode]").forEach((group) => {
          group.style.display = group.dataset.gravelMode === String(m) ? "" : "none";
        });

        const modeName = mode.options[mode.selectedIndex]?.text?.trim() || "Gravel measurement";
        setText("[data-gravel-mode-name]", modeName);
        setText("[data-gravel-mode-card]", modeName);

        const matIndex = Math.max(0, Math.min(5, Math.round(Number(material.value) || 0)));
        const matName = materialNames[matIndex] ?? "Gravel";
        const density = matIndex === 5 ? numberValue("customDensity", 1.4) : (presetDensity[matIndex] ?? 1.4);
        setText("[data-gravel-material-name]", matName);
        setText("[data-gravel-density]", `Density ${density.toFixed(2)} US tons/yd³`);
        setText("[data-gravel-material-card]", `${matName} · ${density.toFixed(2)} ton/yd³`);

        const length = value("length");
        const width = value("width");
        const depth = value("depth");
        const area = value("area");
        const volume = value("volume");

        setText("[data-gravel-length]", `Length = ${length}`);
        setText("[data-gravel-width]", `Width = ${width}`);
        setText("[data-gravel-depth]", `Placed depth = ${depth}`);
        setText("[data-gravel-area]", area);
        setText("[data-gravel-volume]", volume);

        const compaction = Math.max(0, numberValue("compaction", 0));
        const waste = Math.max(0, numberValue("waste", 0));
        setText("[data-gravel-allowances]", `Compaction ${compaction}% · Waste ${waste}%`);

        const summary =
          m === 0 ? `${length} × ${width} × ${depth}` :
          m === 1 ? `${area} × ${depth}` :
          volume;
        setText("[data-gravel-summary]", summary);
      };

      root.addEventListener("input", update);
      root.addEventListener("change", update);\n      root.addEventListener("calculator-state-restored", update);
      form.addEventListener("reset", () => setTimeout(update, 0));
      update();
      setTimeout(update, 0);
    });
  }

  initGravelRichDiagrams();
  document.addEventListener("astro:page-load", initGravelRichDiagrams);
</script>
