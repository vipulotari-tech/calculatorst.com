---
const slug = "parking-lot-calculator";
---

<figure
  class="calc-project-diagram rounded-xl border border-border bg-card p-4 sm:p-5"
  data-project-diagram
  data-parking-lot-rich-diagram
>
  <div class="flex flex-wrap items-start justify-between gap-2">
    <div>
      <h3 class="text-xs font-mono font-semibold uppercase tracking-wider text-foreground">Live parking-lot asphalt diagram</h3>
      <p class="mt-1 max-w-[720px] text-[11px] leading-5 text-muted-foreground">
        Paved footprint, compacted asphalt layer, identical sections, density, allowance, cubic-yard order quantity, and estimated tons update from the calculator inputs. Schematic only — not a parking-layout design.
      </p>
    </div>
    <span class="rounded-full border border-border bg-muted px-2 py-1 font-mono text-[10px] text-muted-foreground">LIVE TAKEOFF</span>
  </div>

  <div class="mt-4 overflow-hidden rounded-xl border border-border bg-background">
    <svg
      viewBox="0 0 760 510"
      class="h-auto w-full"
      role="img"
      aria-labelledby={`${slug}-parking-title ${slug}-parking-desc`}
    >
      <title id={`${slug}-parking-title`}>Live parking lot asphalt quantity diagram</title>
      <desc id={`${slug}-parking-desc`}>
        Parking-lot plan and asphalt cross-section showing length, width, compacted thickness, paved area, material allowance, compacted density, order volume, and estimated asphalt tons.
      </desc>

      <defs>
        <marker id="parking-arrow-start" markerWidth="8" markerHeight="8" refX="1" refY="4" orient="auto">
          <path d="M8 0 L0 4 L8 8 Z" fill="#2563eb" />
        </marker>
        <marker id="parking-arrow-end" markerWidth="8" markerHeight="8" refX="7" refY="4" orient="auto">
          <path d="M0 0 L8 4 L0 8 Z" fill="#2563eb" />
        </marker>
        <pattern id="parking-asphalt-texture" width="18" height="18" patternUnits="userSpaceOnUse">
          <rect width="18" height="18" fill="var(--color-foreground)" opacity=".84" />
          <circle cx="4" cy="5" r="1.1" fill="var(--color-background)" opacity=".28" />
          <circle cx="13" cy="11" r=".9" fill="var(--color-background)" opacity=".24" />
          <circle cx="8" cy="15" r=".7" fill="var(--color-background)" opacity=".22" />
        </pattern>
        <pattern id="parking-base-texture" width="22" height="15" patternUnits="userSpaceOnUse">
          <circle cx="5" cy="9" r="2.8" fill="none" stroke="var(--color-muted-foreground)" stroke-width="1" opacity=".30" />
          <circle cx="15" cy="6" r="2.2" fill="none" stroke="var(--color-muted-foreground)" stroke-width="1" opacity=".26" />
          <circle cx="20" cy="13" r="2.5" fill="none" stroke="var(--color-muted-foreground)" stroke-width="1" opacity=".24" />
        </pattern>
      </defs>

      <rect width="760" height="510" fill="var(--color-background)" />
      <text x="28" y="30" font-size="13" font-weight="700" fill="var(--color-foreground)">Parking-lot paved footprint</text>
      <text x="732" y="30" text-anchor="end" font-size="11" fill="var(--color-muted-foreground)" data-parking-size>20 ft × 10 ft · 1 section</text>

      <text x="42" y="62" font-size="11" font-weight="700" fill="var(--color-foreground)">PLAN VIEW / PAVED AREA</text>
      <rect x="82" y="103" width="362" height="182" rx="6" fill="url(#parking-asphalt-texture)" stroke="var(--color-foreground)" stroke-width="2" />

      <g stroke="var(--color-background)" stroke-width="2" opacity=".74">
        <line x1="104" y1="112" x2="104" y2="171" />
        <line x1="151" y1="112" x2="151" y2="171" />
        <line x1="198" y1="112" x2="198" y2="171" />
        <line x1="245" y1="112" x2="245" y2="171" />
        <line x1="292" y1="112" x2="292" y2="171" />
        <line x1="339" y1="112" x2="339" y2="171" />
        <line x1="386" y1="112" x2="386" y2="171" />
        <line x1="104" y1="217" x2="104" y2="276" />
        <line x1="151" y1="217" x2="151" y2="276" />
        <line x1="198" y1="217" x2="198" y2="276" />
        <line x1="245" y1="217" x2="245" y2="276" />
        <line x1="292" y1="217" x2="292" y2="276" />
        <line x1="339" y1="217" x2="339" y2="276" />
        <line x1="386" y1="217" x2="386" y2="276" />
        <line x1="92" y1="194" x2="434" y2="194" stroke-dasharray="8 8" opacity=".55" />
      </g>

      <line x1="82" y1="82" x2="444" y2="82" stroke="#2563eb" stroke-width="1.7" marker-start="url(#parking-arrow-start)" marker-end="url(#parking-arrow-end)" />
      <line x1="82" y1="89" x2="82" y2="103" stroke="#2563eb" stroke-width="1.05" stroke-dasharray="4 4" />
      <line x1="444" y1="89" x2="444" y2="103" stroke="#2563eb" stroke-width="1.05" stroke-dasharray="4 4" />
      <text x="263" y="72" text-anchor="middle" font-size="13" font-weight="700" fill="#1d4ed8" data-parking-length>Length = 20 ft</text>

      <line x1="59" y1="103" x2="59" y2="285" stroke="#2563eb" stroke-width="1.7" marker-start="url(#parking-arrow-start)" marker-end="url(#parking-arrow-end)" />
      <line x1="66" y1="103" x2="82" y2="103" stroke="#2563eb" stroke-width="1.05" stroke-dasharray="4 4" />
      <line x1="66" y1="285" x2="82" y2="285" stroke="#2563eb" stroke-width="1.05" stroke-dasharray="4 4" />
      <text x="41" y="194" text-anchor="middle" font-size="13" font-weight="700" fill="#1d4ed8" transform="rotate(-90 41 194)" data-parking-width>Width = 10 ft</text>

      <text x="263" y="307" text-anchor="middle" font-size="11" fill="var(--color-muted-foreground)" data-parking-area>200 ft² total paved area</text>

      <text x="498" y="62" font-size="11" font-weight="700" fill="var(--color-foreground)">COMPACTED CROSS SECTION</text>
      <rect x="508" y="205" width="200" height="48" fill="url(#parking-base-texture)" stroke="var(--color-border)" stroke-width="1.2" />
      <rect x="508" y="156" width="200" height="49" fill="url(#parking-asphalt-texture)" stroke="var(--color-foreground)" stroke-width="2" data-parking-layer />
      <text x="608" y="184" text-anchor="middle" font-size="11.5" font-weight="700" fill="var(--color-background)">COMPACTED ASPHALT</text>
      <text x="608" y="235" text-anchor="middle" font-size="10.5" fill="var(--color-muted-foreground)">Prepared base / subgrade</text>

      <line x1="724" y1="156" x2="724" y2="205" stroke="#2563eb" stroke-width="1.7" marker-start="url(#parking-arrow-start)" marker-end="url(#parking-arrow-end)" data-parking-depth-arrow />
      <line x1="710" y1="156" x2="731" y2="156" stroke="#2563eb" stroke-width="1.05" stroke-dasharray="4 4" data-parking-depth-top />
      <line x1="710" y1="205" x2="731" y2="205" stroke="#2563eb" stroke-width="1.05" stroke-dasharray="4 4" />
      <text x="708" y="144" text-anchor="end" font-size="12.5" font-weight="700" fill="#1d4ed8" data-parking-depth>Thickness = 4 in</text>
      <text x="608" y="276" text-anchor="middle" font-size="10.8" fill="var(--color-muted-foreground)" data-parking-density>Density = 145 lb/ft³</text>

      <rect x="28" y="332" width="704" height="52" rx="10" fill="var(--color-muted)" opacity=".23" stroke="var(--color-border)" />
      <text x="45" y="353" font-size="10.8" font-weight="700" fill="var(--color-foreground)">QUANTITY FORMULA</text>
      <text x="45" y="373" font-size="12.5" font-weight="700" fill="var(--color-foreground)">Volume = length × width × compacted thickness × sections</text>
      <text x="712" y="364" text-anchor="end" font-size="12" font-weight="700" fill="#1d4ed8" data-parking-formula>20 × 10 × 0.333 × 1 = 66.67 ft³</text>

      <g transform="translate(28 405)">
        <rect width="166" height="78" rx="11" fill="var(--color-muted)" opacity=".23" stroke="var(--color-border)" />
        <text x="14" y="22" font-size="10" font-weight="700" fill="var(--color-foreground)">NET COMPACTED</text>
        <text x="14" y="49" font-size="18" font-weight="700" fill="var(--color-foreground)" data-parking-net>2.47 yd³</text>
        <text x="14" y="67" font-size="10.5" fill="var(--color-muted-foreground)" data-parking-net-ft3>66.67 ft³</text>
      </g>

      <g transform="translate(207 405)">
        <rect width="166" height="78" rx="11" fill="var(--color-muted)" opacity=".23" stroke="var(--color-border)" />
        <text x="14" y="22" font-size="10" font-weight="700" fill="var(--color-foreground)">ALLOWANCE</text>
        <text x="14" y="49" font-size="18" font-weight="700" fill="#1d4ed8" data-parking-allowance>10%</text>
        <text x="14" y="67" font-size="10.5" fill="var(--color-muted-foreground)">Applied once to volume</text>
      </g>

      <g transform="translate(386 405)">
        <rect width="166" height="78" rx="11" fill="var(--color-muted)" opacity=".23" stroke="var(--color-border)" />
        <text x="14" y="22" font-size="10" font-weight="700" fill="var(--color-foreground)">ORDER VOLUME</text>
        <text x="14" y="49" font-size="18" font-weight="700" fill="#1d4ed8" data-parking-order>2.72 yd³</text>
        <text x="14" y="67" font-size="10.5" fill="var(--color-muted-foreground)" data-parking-order-m3>2.08 m³</text>
      </g>

      <g transform="translate(565 405)">
        <rect width="167" height="78" rx="11" fill="var(--color-muted)" opacity=".23" stroke="var(--color-border)" />
        <text x="14" y="22" font-size="10" font-weight="700" fill="var(--color-foreground)">EST. ORDER WEIGHT</text>
        <text x="14" y="49" font-size="18" font-weight="700" fill="#1d4ed8" data-parking-tons>5.32 US tons</text>
        <text x="14" y="67" font-size="10.5" fill="var(--color-muted-foreground)" data-parking-pounds>10,633 lb</text>
      </g>
    </svg>
  </div>

  <dl class="mt-3 grid gap-2 text-xs sm:grid-cols-5">
    <div class="rounded-md border border-border bg-muted/30 px-3 py-2">
      <dt class="text-muted-foreground">Paved area</dt>
      <dd class="mt-0.5 font-mono font-medium text-foreground tabular-nums" data-parking-card-area>200 ft²</dd>
    </div>
    <div class="rounded-md border border-border bg-muted/30 px-3 py-2">
      <dt class="text-muted-foreground">Thickness</dt>
      <dd class="mt-0.5 font-mono font-medium text-foreground tabular-nums" data-parking-card-depth>4 in</dd>
    </div>
    <div class="rounded-md border border-border bg-muted/30 px-3 py-2">
      <dt class="text-muted-foreground">Sections</dt>
      <dd class="mt-0.5 font-mono font-medium text-foreground tabular-nums" data-parking-card-sections>1</dd>
    </div>
    <div class="rounded-md border border-border bg-muted/30 px-3 py-2">
      <dt class="text-muted-foreground">Order volume</dt>
      <dd class="mt-0.5 font-mono font-medium text-foreground tabular-nums" data-parking-card-order>2.72 yd³</dd>
    </div>
    <div class="rounded-md border border-border bg-muted/30 px-3 py-2">
      <dt class="text-muted-foreground">Estimated weight</dt>
      <dd class="mt-0.5 font-mono font-medium text-foreground tabular-nums" data-parking-card-tons>5.32 US tons</dd>
    </div>
  </dl>
</figure>

<script>
  function initParkingLotRichDiagrams() {
    document.querySelectorAll<HTMLElement>("[data-parking-lot-rich-diagram]").forEach((figure) => {
      if (figure.dataset.initialized) return;
      figure.dataset.initialized = "true";

      const root = figure.closest<HTMLElement>('[data-calculator-slug="parking-lot-calculator"]');
      if (!root) return;
      const form = root.querySelector<HTMLFormElement>("#parking-lot-calculator-form");
      if (!form) return;

      const input = (id: string) => root.querySelector<HTMLInputElement>("#parking-lot-calculator-" + id);
      const unit = (id: string) => root.querySelector<HTMLSelectElement>("#parking-lot-calculator-" + id + "-unit");

      const unitText = (id: string) => {
        const select = unit(id);
        if (select) return select.options[select.selectedIndex]?.text?.trim() || select.value;
        const el = input(id);
        const staticUnit = el?.parentElement?.querySelector("span");
        return staticUnit?.textContent?.trim() || "";
      };

      const displayValue = (id: string) => {
        const raw = input(id)?.value?.trim() ?? "";
        if (!raw) return "—";
        const n = Number(raw);
        const shown = Number.isFinite(n) ? String(Number(n.toFixed(4))) : raw;
        const label = unitText(id);
        return label ? shown + " " + label : shown;
      };

      const lengthToFeet = (id: string) => {
        const n = Number(input(id)?.value);
        if (!Number.isFinite(n)) return Number.NaN;
        const factors: Record<string, number> = {
          ft: 1,
          in: 1 / 12,
          yd: 3,
          m: 1 / 0.3048,
          cm: 1 / 30.48,
          mm: 1 / 304.8,
        };
        return n * (factors[unit(id)?.value ?? "ft"] ?? 1);
      };

      const densityToLbFt3 = () => {
        const n = Number(input("density")?.value);
        if (!Number.isFinite(n)) return Number.NaN;
        const densityUnit = unit("density")?.value ?? "lb/ft3";
        if (densityUnit === "kg/m3") return n * 2.20462262185 / 35.3146667215;
        if (densityUnit === "ton/yd3") return n * 2000 / 27;
        return n;
      };

      const numberValue = (id: string, fallback = 0) => {
        const n = Number(input(id)?.value);
        return Number.isFinite(n) ? n : fallback;
      };

      const fmt = (n: number, digits = 2) =>
        Number.isFinite(n)
          ? new Intl.NumberFormat("en-US", { maximumFractionDigits: digits }).format(n)
          : "—";

      const setText = (selector: string, text: string) => {
        figure.querySelectorAll<SVGTextElement | HTMLElement>(selector).forEach((el) => {
          el.textContent = text;
        });
      };

      const updateLayer = (depthFt: number) => {
        const baseY = 205;
        const height = Number.isFinite(depthFt) && depthFt > 0
          ? Math.max(20, Math.min(78, depthFt * 120))
          : 32;
        const topY = baseY - height;

        const layer = figure.querySelector<SVGRectElement>("[data-parking-layer]");
        layer?.setAttribute("y", String(topY));
        layer?.setAttribute("height", String(height));

        const arrow = figure.querySelector<SVGLineElement>("[data-parking-depth-arrow]");
        arrow?.setAttribute("y1", String(topY));

        const guide = figure.querySelector<SVGLineElement>("[data-parking-depth-top]");
        guide?.setAttribute("y1", String(topY));
        guide?.setAttribute("y2", String(topY));

        const label = figure.querySelector<SVGTextElement>("[data-parking-depth]");
        label?.setAttribute("y", String(Math.max(100, topY - 12)));
      };

      const update = () => {
        const lengthFt = lengthToFeet("length");
        const widthFt = lengthToFeet("width");
        const depthFt = lengthToFeet("depth");
        const sections = Math.max(0, Math.round(numberValue("quantity", 1)));
        const allowance = Math.max(0, numberValue("waste", 0));
        const density = densityToLbFt3();

        const valid = [lengthFt, widthFt, depthFt, density].every((v) => Number.isFinite(v) && v > 0) && sections > 0;
        const areaFt2 = valid ? lengthFt * widthFt * sections : Number.NaN;
        const netFt3 = valid ? lengthFt * widthFt * depthFt * sections : Number.NaN;
        const orderFt3 = Number.isFinite(netFt3) ? netFt3 * (1 + allowance / 100) : Number.NaN;
        const netYd3 = netFt3 / 27;
        const orderYd3 = orderFt3 / 27;
        const orderM3 = orderFt3 * Math.pow(0.3048, 3);
        const pounds = orderFt3 * density;
        const tons = pounds / 2000;

        updateLayer(depthFt);

        setText("[data-parking-size]", displayValue("length") + " × " + displayValue("width") + " · " + sections + " " + (sections === 1 ? "section" : "sections"));
        setText("[data-parking-length]", "Length = " + displayValue("length"));
        setText("[data-parking-width]", "Width = " + displayValue("width"));
        setText("[data-parking-area]", fmt(areaFt2) + " ft² total paved area");
        setText("[data-parking-depth]", "Thickness = " + displayValue("depth"));
        setText("[data-parking-density]", "Density = " + displayValue("density"));

        setText(
          "[data-parking-formula]",
          valid
            ? fmt(lengthFt) + " × " + fmt(widthFt) + " × " + fmt(depthFt, 3) + " × " + sections + " = " + fmt(netFt3) + " ft³"
            : "Enter valid parking-lot dimensions"
        );

        setText("[data-parking-net]", fmt(netYd3) + " yd³");
        setText("[data-parking-net-ft3]", fmt(netFt3) + " ft³");
        setText("[data-parking-allowance]", fmt(allowance) + "%");
        setText("[data-parking-order]", fmt(orderYd3) + " yd³");
        setText("[data-parking-order-m3]", fmt(orderM3) + " m³");
        setText("[data-parking-tons]", fmt(tons) + " US tons");
        setText("[data-parking-pounds]", fmt(pounds, 0) + " lb");

        setText("[data-parking-card-area]", fmt(areaFt2) + " ft²");
        setText("[data-parking-card-depth]", displayValue("depth"));
        setText("[data-parking-card-sections]", String(sections));
        setText("[data-parking-card-order]", fmt(orderYd3) + " yd³");
        setText("[data-parking-card-tons]", fmt(tons) + " US tons");
      };

      root.addEventListener("input", update);
      root.addEventListener("change", update);
      root.addEventListener("calculator-state-restored", update);
      form.addEventListener("reset", () => setTimeout(update, 0));

      update();
      queueMicrotask(update);
      requestAnimationFrame(update);
      setTimeout(update, 0);
    });
  }

  initParkingLotRichDiagrams();
  document.addEventListener("astro:page-load", initParkingLotRichDiagrams);
</script>
