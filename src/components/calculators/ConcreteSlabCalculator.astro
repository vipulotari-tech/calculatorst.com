---
---

<div id="concrete-calc" class="rounded-lg border border-hairline bg-canvas p-5 shadow-card sm:p-6">
  <form id="c-form" novalidate class="space-y-5">
    <div class="grid gap-4 sm:grid-cols-3">
      <label class="block"><span class="text-sm font-medium text-ink">Length</span><div class="mt-1.5 flex"><input id="c-len" type="number" min="0" step="any" placeholder="12" class="h-11 w-full rounded-l-sm border border-hairline bg-canvas px-3 text-sm" required/><select id="c-len-unit" class="h-11 rounded-r-sm border border-l-0 border-hairline bg-canvas-soft px-2 text-sm"><option value="ft">ft</option><option value="in">in</option><option value="m">m</option></select></div><span id="c-len-error" class="mt-1 hidden text-xs text-error" role="alert"></span></label>
      <label class="block"><span class="text-sm font-medium text-ink">Width</span><div class="mt-1.5 flex"><input id="c-wid" type="number" min="0" step="any" placeholder="10" class="h-11 w-full rounded-l-sm border border-hairline bg-canvas px-3 text-sm" required/><select id="c-wid-unit" class="h-11 rounded-r-sm border border-l-0 border-hairline bg-canvas-soft px-2 text-sm"><option value="ft">ft</option><option value="m">m</option></select></div><span id="c-wid-error" class="mt-1 hidden text-xs text-error" role="alert"></span></label>
      <label class="block"><span class="text-sm font-medium text-ink">Thickness</span><div class="mt-1.5 flex"><input id="c-thick" type="number" min="0" step="any" placeholder="4" class="h-11 w-full rounded-l-sm border border-hairline bg-canvas px-3 text-sm" required/><select id="c-thick-unit" class="h-11 rounded-r-sm border border-l-0 border-hairline bg-canvas-soft px-2 text-sm"><option value="in" selected>in</option><option value="ft">ft</option><option value="cm">cm</option></select></div><span id="c-thick-error" class="mt-1 hidden text-xs text-error" role="alert"></span></label>
    </div>
    <div class="grid gap-4 sm:grid-cols-3">
      <label class="block"><span class="text-sm font-medium text-ink">Number of slabs</span><input id="c-num" type="number" min="1" step="1" value="1" class="mt-1.5 h-11 w-full rounded-sm border border-hairline bg-canvas px-3 text-sm"/></label>
      <label class="block"><span class="text-sm font-medium text-ink">Waste %</span><div class="mt-1.5 flex"><input id="c-waste" type="number" min="0" max="30" value="10" class="h-11 w-full rounded-l-sm border border-hairline bg-canvas px-3 text-sm"/><span class="flex h-11 items-center rounded-r-sm border border-l-0 border-hairline bg-canvas-soft px-3 text-sm text-mute">%</span></div></label>
      <label class="block"><span class="text-sm font-medium text-ink">Price</span><div class="mt-1.5 flex"><span class="flex h-11 items-center rounded-l-sm border border-hairline bg-canvas-soft px-2 text-sm text-mute">$</span><input id="c-price" type="number" min="0" step="any" placeholder="140" class="h-11 w-full border-y border-hairline bg-canvas px-3 text-sm"/><select id="c-price-unit" class="h-11 rounded-r-sm border border-hairline bg-canvas-soft px-2 text-xs"><option value="yd">/ yd³</option><option value="bag80">/ 80lb bag</option></select></div></label>
    </div>
    <div class="flex gap-2"><button type="submit" class="h-11 rounded-sm bg-primary px-6 text-sm font-medium text-on-primary">Calculate</button><button type="reset" id="c-reset" class="h-11 rounded-sm border border-hairline bg-canvas px-6 text-sm font-medium text-ink">Reset</button><span class="hidden items-center font-mono text-xs text-mute sm:inline-flex">US customary + metric supported.</span></div>
  </form>
  <div id="c-results" class="mt-6 hidden" aria-live="polite">
    <div class="rounded-lg border border-hairline bg-canvas-soft-2 p-5">
      <p class="font-mono text-[11px] tracking-widest text-mute">CONCRETE SLAB ESTIMATE</p>
      <p class="mt-1 text-2xl font-semibold tracking-[-0.03em] text-ink"><span id="c-yd3" class="tabular-nums">—</span> yd³ <span class="text-sm font-medium text-body">· <span id="c-ft3">—</span> ft³</span></p>
      <p class="font-mono text-xs tabular-nums text-body"><span id="c-sqft">—</span> ft² · <span id="c-yd3w">—</span> yd³ with waste</p>
      <div class="mt-4 grid gap-3 rounded-md border border-hairline bg-canvas p-3 sm:grid-cols-3">
        <div><p class="font-mono text-[11px] text-mute">80-lb bags</p><p id="c-b80" class="text-sm font-semibold tabular-nums text-ink">—</p><p class="font-mono text-xs text-mute">0.60 ft³ / 0.022 yd³</p></div>
        <div><p class="font-mono text-[11px] text-mute">60-lb bags</p><p id="c-b60" class="text-sm font-semibold tabular-nums text-ink">—</p><p class="font-mono text-xs text-mute">0.45 ft³</p></div>
        <div><p class="font-mono text-[11px] text-mute">40-lb bags</p><p id="c-b40" class="text-sm font-semibold tabular-nums text-ink">—</p><p class="font-mono text-xs text-mute">0.30 ft³</p></div>
      </div>
      <div class="mt-3 flex items-center justify-between rounded-md border border-hairline bg-canvas p-3">
        <p class="font-mono text-[11px] text-mute">Est. cost</p><p id="c-cost" class="text-sm font-semibold text-ink">—</p>
      </div>
    </div>
  </div>
</div>
<script is:inline>
(()=>{const $=id=>document.getElementById(id);const f=$("c-form"),r=$("c-results");function toFeet(v,u){if(u==="ft")return v;if(u==="in")return v/12;if(u==="m")return v*3.28084;if(u==="cm")return v*0.0328084;return v;}
function fmt(n,d=2){return new Intl.NumberFormat("en-US",{maximumFractionDigits:d,minimumFractionDigits:d===0?0:2}).format(n);}
function show(id,msg){const e=$(id);e.textContent=msg;e.classList.remove("hidden");}
function clear(){["c-len-error","c-wid-error","c-thick-error"].forEach(id=>{const e=$(id);e.textContent="";e.classList.add("hidden");});}
f.addEventListener("submit",e=>{e.preventDefault();clear();const L=parseFloat($("c-len").value),W=parseFloat($("c-wid").value),T=parseFloat($("c-thick").value),num=parseInt($("c-num").value)||1,waste=parseFloat($("c-waste").value)||0,price=parseFloat($("c-price").value);let ok=true;if(!(L>0)){show("c-len-error","Please enter a valid length.");ok=false;}if(!(W>0)){show("c-wid-error","Please enter a valid width.");ok=false;}if(!(T>0)){show("c-thick-error","Thickness must be greater than 0.");ok=false;}if(!ok)return;
const Lf=toFeet(L,$("c-len-unit").value),Wf=toFeet(W,$("c-wid-unit").value),Tf=toFeet(T,$("c-thick-unit").value);const sqft=Lf*Wf*num,cuFt=sqft*Tf,cuYd=cuFt/27,w=1+waste/100;const cuFtW=cuFt*w,cuYdW=cuYd*w;
$("c-sqft").textContent=fmt(sqft,1);$("c-ft3").textContent=fmt(cuFt);$("c-yd3").textContent=fmt(cuYd);$("c-yd3w").textContent=fmt(cuYdW);
const b80=Math.ceil(cuFtW/0.60),b60=Math.ceil(cuFtW/0.45),b40=Math.ceil(cuFtW/0.30);
$("c-b80").textContent=String(b80);$("c-b60").textContent=String(b60);$("c-b40").textContent=String(b40);
let cost="—";if(isFinite(price)&&price>0){const unit=$("c-price-unit").value;const c=unit==="yd"?cuYdW*price:b80*price;cost=new Intl.NumberFormat("en-US",{style:"currency",currency:"USD"}).format(c);}
$("c-cost").textContent=cost;r.classList.remove("hidden");r.scrollIntoView({behavior:"smooth",block:"nearest"});
});$("c-reset").addEventListener("click",()=>{clear();r.classList.add("hidden");});})();
</script>
