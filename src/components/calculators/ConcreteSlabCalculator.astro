---
---

<div id="concrete-calc" class="rounded-lg border border-hairline bg-canvas p-5 shadow-card dark:bg-canvas sm:p-6">
  <form id="c-form" novalidate class="space-y-5">
    <div class="grid gap-4 sm:grid-cols-3">
      <label class="block"><span class="text-sm font-medium text-ink">Length</span><div class="mt-1.5 flex"><input id="c-len" name="length" type="number" inputmode="decimal" min="0" step="any" placeholder="12" class="h-11 w-full rounded-l-sm border border-hairline bg-canvas px-3 text-sm focus:border-link focus:outline-none focus:ring-2 focus:ring-link/20" required aria-describedby="c-len-error"/><select id="c-len-unit" class="h-11 shrink-0 rounded-r-sm border border-l-0 border-hairline bg-canvas-soft px-2 text-sm focus:outline-none"><option value="ft">ft</option><option value="in">in</option><option value="yd">yd</option><option value="m">m</option></select></div><span id="c-len-error" class="mt-1 hidden text-xs text-error" role="alert"></span></label>
      <label class="block"><span class="text-sm font-medium text-ink">Width</span><div class="mt-1.5 flex"><input id="c-wid" name="width" type="number" inputmode="decimal" min="0" step="any" placeholder="10" class="h-11 w-full rounded-l-sm border border-hairline bg-canvas px-3 text-sm focus:border-link focus:outline-none focus:ring-2 focus:ring-link/20" required aria-describedby="c-wid-error"/><select id="c-wid-unit" class="h-11 shrink-0 rounded-r-sm border border-l-0 border-hairline bg-canvas-soft px-2 text-sm focus:outline-none"><option value="ft">ft</option><option value="in">in</option><option value="yd">yd</option><option value="m">m</option></select></div><span id="c-wid-error" class="mt-1 hidden text-xs text-error" role="alert"></span></label>
      <label class="block"><span class="text-sm font-medium text-ink">Thickness</span><div class="mt-1.5 flex"><input id="c-thick" name="thickness" type="number" inputmode="decimal" min="0" step="any" placeholder="4" class="h-11 w-full rounded-l-sm border border-hairline bg-canvas px-3 text-sm focus:border-link focus:outline-none focus:ring-2 focus:ring-link/20" required aria-describedby="c-thick-error"/><select id="c-thick-unit" class="h-11 shrink-0 rounded-r-sm border border-l-0 border-hairline bg-canvas-soft px-2 text-sm focus:outline-none"><option value="in" selected>in</option><option value="ft">ft</option><option value="cm">cm</option><option value="m">m</option></select></div><span id="c-thick-error" class="mt-1 hidden text-xs text-error" role="alert"></span></label>
    </div>
    <div class="grid gap-4 sm:grid-cols-3">
      <label class="block"><span class="text-sm font-medium text-ink">Number of slabs</span><input id="c-num" type="number" inputmode="numeric" min="1" step="1" value="1" class="mt-1.5 h-11 w-full rounded-sm border border-hairline bg-canvas px-3 text-sm focus:border-link focus:outline-none focus:ring-2 focus:ring-link/20"/></label>
      <label class="block"><span class="text-sm font-medium text-ink">Waste %</span><div class="mt-1.5 flex"><input id="c-waste" type="number" inputmode="decimal" min="0" max="50" step="1" value="10" class="h-11 w-full rounded-l-sm border border-hairline bg-canvas px-3 text-sm focus:border-link focus:outline-none focus:ring-2 focus:ring-link/20"/><span class="flex h-11 items-center rounded-r-sm border border-l-0 border-hairline bg-canvas-soft px-3 text-sm text-mute">%</span></div></label>
      <label class="block"><span class="text-sm font-medium text-ink">Price</span><div class="mt-1.5 flex"><span class="flex h-11 items-center rounded-l-sm border border-hairline bg-canvas-soft px-2 text-sm text-mute">$</span><input id="c-price" type="number" inputmode="decimal" min="0" step="any" placeholder="140" class="h-11 w-full border-y border-hairline bg-canvas px-3 text-sm focus:outline-none"/><select id="c-price-unit" class="h-11 shrink-0 rounded-r-sm border border-hairline bg-canvas-soft px-2 text-xs focus:outline-none"><option value="yd">/ yd³</option><option value="bag80">/ 80lb bag</option></select></div></label>
    </div>
    <div class="flex flex-wrap gap-2"><button type="submit" class="inline-flex h-11 items-center justify-center rounded-sm bg-primary px-6 text-sm font-medium text-on-primary transition hover:bg-[#242424] dark:hover:bg-white dark:hover:text-black focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-link dark:bg-primary">Calculate</button><button type="reset" id="c-reset" class="inline-flex h-11 items-center justify-center rounded-sm border border-hairline bg-canvas px-6 text-sm font-medium text-ink transition hover:bg-canvas-soft focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-link">Reset</button><span class="hidden items-center font-mono text-xs text-mute sm:inline-flex">US customary + metric supported.</span></div>
  </form>
  <div id="c-results" class="mt-6 hidden" aria-live="polite">
    <div class="rounded-lg border border-hairline bg-canvas-soft-2 p-5 dark:bg-white/[0.04]">
      <p class="font-mono text-[11px] tracking-widest text-mute">CONCRETE SLAB ESTIMATE</p>
      <p class="mt-1 text-2xl font-semibold tracking-[-0.03em] text-ink"><span id="c-yd3" class="tabular-nums">—</span> yd³ <span class="text-sm font-medium text-body">· <span id="c-ft3">—</span> ft³</span></p>
      <p class="font-mono text-xs tabular-nums text-body"><span id="c-sqft">—</span> ft² · <span id="c-yd3w">—</span> yd³ with waste</p>
      <div class="mt-4 grid gap-3 rounded-md border border-hairline bg-canvas p-3 dark:bg-canvas sm:grid-cols-3">
        <div><p class="font-mono text-[11px] text-mute">80-lb bags</p><p id="c-b80" class="text-sm font-semibold tabular-nums text-ink">—</p><p class="font-mono text-xs text-mute">0.60 ft³ / 0.022 yd³</p></div>
        <div><p class="font-mono text-[11px] text-mute">60-lb bags</p><p id="c-b60" class="text-sm font-semibold tabular-nums text-ink">—</p><p class="font-mono text-xs text-mute">0.45 ft³</p></div>
        <div><p class="font-mono text-[11px] text-mute">40-lb bags</p><p id="c-b40" class="text-sm font-semibold tabular-nums text-ink">—</p><p class="font-mono text-xs text-mute">0.30 ft³</p></div>
      </div>
      <div class="mt-3 flex items-center justify-between rounded-md border border-hairline bg-canvas p-3 dark:bg-canvas">
        <p class="font-mono text-[11px] text-mute">Est. cost</p><p id="c-cost" class="text-sm font-semibold text-ink">—</p>
      </div>
    </div>
  </div>
</div>
<script is:inline>
(() => {
  const $ = (id) => document.getElementById(id);
  const form = $("c-form");
  const results = $("c-results");
  function toFeet(v, u) {
    if (u === "ft") return v;
    if (u === "in") return v / 12;
    if (u === "yd") return v * 3;
    if (u === "m") return v * 3.28084;
    if (u === "cm") return v * 0.0328084;
    return v;
  }
  function fmt(n, dec = 2) {
    if (!isFinite(n)) return "—";
    return new Intl.NumberFormat("en-US", {
      maximumFractionDigits: dec,
      minimumFractionDigits: dec === 0 ? 0 : dec === 2 ? 2 : 0,
    }).format(n);
  }
  function show(id, msg) {
    const e = $(id);
    if (!e) return;
    e.textContent = msg;
    e.classList.remove("hidden");
  }
  function clear() {
    ["c-len-error", "c-wid-error", "c-thick-error"].forEach((id) => {
      const e = $(id);
      if (e) { e.textContent = ""; e.classList.add("hidden"); }
    });
  }
  if (!form || !results) return;
  form.addEventListener("submit", (e) => {
    e.preventDefault();
    clear();
    const L = parseFloat($("c-len").value);
    const W = parseFloat($("c-wid").value);
    const T = parseFloat($("c-thick").value);
    const num = parseInt($("c-num").value) || 1;
    const waste = parseFloat($("c-waste").value) || 0;
    const price = parseFloat($("c-price").value);
    let ok = true;
    if (!(L > 0)) { show("c-len-error", "Please enter a valid length."); ok = false; }
    if (!(W > 0)) { show("c-wid-error", "Please enter a valid width."); ok = false; }
    if (!(T > 0)) { show("c-thick-error", "Thickness must be greater than 0."); ok = false; }
    if (!ok) return;
    const Lf = toFeet(L, $("c-len-unit").value);
    const Wf = toFeet(W, $("c-wid-unit").value);
    const Tf = toFeet(T, $("c-thick-unit").value);
    const sqft = Lf * Wf * num;
    const cuFt = sqft * Tf;
    const cuYd = cuFt / 27;
    const w = 1 + waste / 100;
    const cuFtW = cuFt * w;
    const cuYdW = cuYd * w;
    $("c-sqft").textContent = fmt(sqft, 1);
    $("c-ft3").textContent = fmt(cuFt);
    $("c-yd3").textContent = fmt(cuYd);
    $("c-yd3w").textContent = fmt(cuYdW);
    const b80 = Math.ceil(cuFtW / 0.60);
    const b60 = Math.ceil(cuFtW / 0.45);
    const b40 = Math.ceil(cuFtW / 0.30);
    $("c-b80").textContent = String(b80);
    $("c-b60").textContent = String(b60);
    $("c-b40").textContent = String(b40);
    let cost = "—";
    if (isFinite(price) && price > 0) {
      const unit = $("c-price-unit").value;
      const c = unit === "yd" ? cuYdW * price : b80 * price;
      cost = new Intl.NumberFormat("en-US", { style: "currency", currency: "USD" }).format(c);
    }
    $("c-cost").textContent = cost;
    results.classList.remove("hidden");
    results.scrollIntoView({ behavior: "smooth", block: "nearest" });
  });
  $("c-reset")?.addEventListener("click", () => {
    clear();
    results.classList.add("hidden");
  });
})();
</script>
