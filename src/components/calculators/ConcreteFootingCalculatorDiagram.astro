---
const slug = "concrete-footing-calculator";
---

<figure
  class="calc-project-diagram rounded-xl border border-border bg-card p-4 sm:p-5"
  data-project-diagram
  data-concrete-footing-rich-diagram
  data-kind="concreteFooting"
>
  <div class="flex flex-wrap items-start justify-between gap-2">
    <div>
      <h3 class="text-xs font-mono font-semibold uppercase tracking-wider text-foreground">Live concrete footing diagram</h3>
      <p class="mt-1 max-w-[720px] text-[11px] leading-5 text-muted-foreground">
        Plan and cross-section views follow the selected strip, square pad, rectangular pad, or round footing and update from the active dimensions. Schematic only — use project plans for structural sizing and reinforcement.
      </p>
    </div>
    <span class="rounded-full border border-border bg-muted px-2 py-1 font-mono text-[10px] text-muted-foreground">LIVE INPUT GUIDE</span>
  </div>

  <div class="mt-4 overflow-hidden rounded-xl border border-border bg-background">
    <svg
      viewBox="0 0 760 520"
      class="h-auto w-full"
      role="img"
      aria-labelledby="concrete-footing-calculator-diagram-title concrete-footing-calculator-diagram-desc"
    >
      <title id="concrete-footing-calculator-diagram-title">Live concrete footing calculator diagram</title>
      <desc id="concrete-footing-calculator-diagram-desc">
        Technical plan and cross-section schematic for strip, square, rectangular, and round concrete footings with live dimensions, quantity, volume, and material allowance.
      </desc>

      <defs>
        <marker id="footing-arrow-start" markerWidth="8" markerHeight="8" refX="1" refY="4" orient="auto">
          <path d="M8 0 L0 4 L8 8 Z" fill="#2563eb" />
        </marker>
        <marker id="footing-arrow-end" markerWidth="8" markerHeight="8" refX="7" refY="4" orient="auto">
          <path d="M0 0 L8 4 L0 8 Z" fill="#2563eb" />
        </marker>
        <pattern id="footing-concrete" width="18" height="18" patternUnits="userSpaceOnUse">
          <rect width="18" height="18" fill="var(--color-muted)" opacity=".58" />
          <circle cx="4" cy="5" r="1.15" fill="var(--color-muted-foreground)" opacity=".3" />
          <circle cx="14" cy="11" r=".9" fill="var(--color-muted-foreground)" opacity=".24" />
          <circle cx="8" cy="16" r=".7" fill="var(--color-muted-foreground)" opacity=".22" />
        </pattern>
        <pattern id="footing-soil" width="18" height="14" patternUnits="userSpaceOnUse">
          <path d="M0 12 L8 6 M8 14 L16 6 M14 14 L18 10" fill="none" stroke="var(--color-muted-foreground)" stroke-width=".8" opacity=".22" />
        </pattern>
      </defs>

      <text x="28" y="31" font-size="13" font-weight="700" fill="var(--color-foreground)" data-footing-shape-title>Strip / continuous footing</text>
      <text x="732" y="31" text-anchor="end" font-size="11" fill="var(--color-muted-foreground)" data-footing-quantity-label>1 footing</text>

      <text x="42" y="66" font-size="11" font-weight="700" fill="var(--color-foreground)">TOP VIEW (PLAN)</text>

      <g data-footing-plan-shape="0">
        <rect x="92" y="132" width="350" height="92" rx="3" fill="url(#footing-concrete)" stroke="var(--color-foreground)" stroke-width="2" />
        <line x1="92" y1="108" x2="442" y2="108" stroke="#2563eb" stroke-width="1.7" marker-start="url(#footing-arrow-start)" marker-end="url(#footing-arrow-end)" />
        <line x1="92" y1="114" x2="92" y2="132" stroke="#2563eb" stroke-width="1.1" stroke-dasharray="4 4" />
        <line x1="442" y1="114" x2="442" y2="132" stroke="#2563eb" stroke-width="1.1" stroke-dasharray="4 4" />
        <text x="267" y="98" text-anchor="middle" font-size="13" font-weight="700" fill="#1d4ed8" data-footing-length>Length = 20 ft</text>

        <line x1="68" y1="132" x2="68" y2="224" stroke="#2563eb" stroke-width="1.7" marker-start="url(#footing-arrow-start)" marker-end="url(#footing-arrow-end)" />
        <line x1="74" y1="132" x2="92" y2="132" stroke="#2563eb" stroke-width="1.1" stroke-dasharray="4 4" />
        <line x1="74" y1="224" x2="92" y2="224" stroke="#2563eb" stroke-width="1.1" stroke-dasharray="4 4" />
        <text x="50" y="178" text-anchor="middle" font-size="13" font-weight="700" fill="#1d4ed8" transform="rotate(-90 50 178)" data-footing-width>Width = 12 in</text>

        <line x1="267" y1="143" x2="267" y2="213" stroke="var(--color-muted-foreground)" stroke-width="1.1" stroke-dasharray="7 5" opacity=".6" />
        <text x="276" y="174" font-size="10.5" fill="var(--color-muted-foreground)">centerline run</text>
      </g>

      <g data-footing-plan-shape="1" style="display:none">
        <rect x="165" y="105" width="205" height="205" rx="3" fill="url(#footing-concrete)" stroke="var(--color-foreground)" stroke-width="2" />
        <line x1="165" y1="87" x2="370" y2="87" stroke="#2563eb" stroke-width="1.7" marker-start="url(#footing-arrow-start)" marker-end="url(#footing-arrow-end)" />
        <line x1="165" y1="93" x2="165" y2="105" stroke="#2563eb" stroke-width="1.1" stroke-dasharray="4 4" />
        <line x1="370" y1="93" x2="370" y2="105" stroke="#2563eb" stroke-width="1.1" stroke-dasharray="4 4" />
        <text x="267.5" y="78" text-anchor="middle" font-size="13" font-weight="700" fill="#1d4ed8" data-footing-square-side>Side = 24 in</text>
      </g>

      <g data-footing-plan-shape="2" style="display:none">
        <rect x="112" y="124" width="310" height="154" rx="3" fill="url(#footing-concrete)" stroke="var(--color-foreground)" stroke-width="2" />
        <line x1="112" y1="101" x2="422" y2="101" stroke="#2563eb" stroke-width="1.7" marker-start="url(#footing-arrow-start)" marker-end="url(#footing-arrow-end)" />
        <line x1="112" y1="107" x2="112" y2="124" stroke="#2563eb" stroke-width="1.1" stroke-dasharray="4 4" />
        <line x1="422" y1="107" x2="422" y2="124" stroke="#2563eb" stroke-width="1.1" stroke-dasharray="4 4" />
        <text x="267" y="91" text-anchor="middle" font-size="13" font-weight="700" fill="#1d4ed8" data-footing-pad-length>Length = 30 in</text>

        <line x1="88" y1="124" x2="88" y2="278" stroke="#2563eb" stroke-width="1.7" marker-start="url(#footing-arrow-start)" marker-end="url(#footing-arrow-end)" />
        <line x1="94" y1="124" x2="112" y2="124" stroke="#2563eb" stroke-width="1.1" stroke-dasharray="4 4" />
        <line x1="94" y1="278" x2="112" y2="278" stroke="#2563eb" stroke-width="1.1" stroke-dasharray="4 4" />
        <text x="70" y="201" text-anchor="middle" font-size="13" font-weight="700" fill="#1d4ed8" transform="rotate(-90 70 201)" data-footing-pad-width>Width = 24 in</text>
      </g>

      <g data-footing-plan-shape="3" style="display:none">
        <circle cx="267" cy="197" r="104" fill="url(#footing-concrete)" stroke="var(--color-foreground)" stroke-width="2" />
        <line x1="163" y1="197" x2="371" y2="197" stroke="#2563eb" stroke-width="1.7" marker-start="url(#footing-arrow-start)" marker-end="url(#footing-arrow-end)" />
        <circle cx="267" cy="197" r="3" fill="var(--color-foreground)" />
        <text x="267" y="177" text-anchor="middle" font-size="13" font-weight="700" fill="#1d4ed8" data-footing-diameter>Diameter = 24 in</text>
      </g>

      <text x="267" y="327" text-anchor="middle" font-size="11" fill="var(--color-muted-foreground)" data-footing-plan-summary>20 ft² footprint per run</text>

      <text x="505" y="66" font-size="11" font-weight="700" fill="var(--color-foreground)">CROSS SECTION</text>
      <g>
        <rect x="510" y="108" width="218" height="180" fill="url(#footing-soil)" opacity=".75" />
        <line x1="510" y1="108" x2="728" y2="108" stroke="var(--color-muted-foreground)" stroke-width="1.2" stroke-dasharray="6 5" />
        <text x="519" y="100" font-size="10" fill="var(--color-muted-foreground)">grade / excavation</text>

        <rect x="536" y="160" width="166" height="86" rx="2" fill="url(#footing-concrete)" stroke="var(--color-foreground)" stroke-width="2" />
        <text x="619" y="207" text-anchor="middle" font-size="11" font-weight="600" fill="var(--color-foreground)">CONCRETE FOOTING</text>

        <line x1="718" y1="160" x2="718" y2="246" stroke="#2563eb" stroke-width="1.7" marker-start="url(#footing-arrow-start)" marker-end="url(#footing-arrow-end)" />
        <line x1="702" y1="160" x2="724" y2="160" stroke="#2563eb" stroke-width="1.1" stroke-dasharray="4 4" />
        <line x1="702" y1="246" x2="724" y2="246" stroke="#2563eb" stroke-width="1.1" stroke-dasharray="4 4" />
        <text x="708" y="151" text-anchor="end" font-size="12" font-weight="700" fill="#1d4ed8" data-footing-depth>Depth = 12 in</text>

        <line x1="536" y1="270" x2="702" y2="270" stroke="#2563eb" stroke-width="1.7" marker-start="url(#footing-arrow-start)" marker-end="url(#footing-arrow-end)" />
        <line x1="536" y1="248" x2="536" y2="276" stroke="#2563eb" stroke-width="1.1" stroke-dasharray="4 4" />
        <line x1="702" y1="248" x2="702" y2="276" stroke="#2563eb" stroke-width="1.1" stroke-dasharray="4 4" />
        <text x="619" y="290" text-anchor="middle" font-size="12" font-weight="700" fill="#1d4ed8" data-footing-cross-width>Width = 12 in</text>
      </g>

      <rect x="494" y="314" width="238" height="70" rx="10" fill="var(--color-muted)" opacity=".23" stroke="var(--color-border)" />
      <text x="510" y="337" font-size="10.5" fill="var(--color-muted-foreground)">Net concrete before allowance</text>
      <text x="510" y="361" font-size="15" font-weight="700" fill="#1d4ed8" data-footing-net-volume>20 ft³ total</text>
      <text x="510" y="378" font-size="10.5" fill="var(--color-muted-foreground)" data-footing-order-volume>Order target: 0.81 yd³ with 10% allowance</text>

      <rect x="28" y="402" width="704" height="88" rx="12" fill="var(--color-muted)" opacity=".23" stroke="var(--color-border)" />
      <text x="46" y="426" font-size="11" font-weight="700" fill="var(--color-foreground)">FOOTING VOLUME FORMULA</text>
      <text x="46" y="452" font-size="16" font-weight="700" fill="var(--color-foreground)" data-footing-formula>V = L × W × D × Q</text>
      <text x="46" y="475" font-size="10.5" fill="var(--color-muted-foreground)">Allowance is applied after geometric volume and quantity.</text>
      <line x1="434" y1="416" x2="434" y2="478" stroke="var(--color-border)" />
      <text x="454" y="426" font-size="11" font-weight="700" fill="var(--color-foreground)">CURRENT TAKEOFF</text>
      <text x="454" y="452" font-size="12.5" font-weight="700" fill="#1d4ed8" data-footing-dimensions>20 ft × 12 in × 12 in</text>
      <text x="454" y="475" font-size="10.5" fill="var(--color-muted-foreground)" data-footing-allowance>1 run · allowance 10%</text>
    </svg>
  </div>

  <dl class="calc-project-diagram-values mt-3 grid gap-2 text-xs sm:grid-cols-4">
    <div class="rounded-md border border-border bg-muted/30 px-3 py-2">
      <dt class="text-muted-foreground">Footprint / cross-section</dt>
      <dd class="mt-0.5 font-mono font-medium text-foreground tabular-nums" data-footing-card-area>20 ft²</dd>
    </div>
    <div class="rounded-md border border-border bg-muted/30 px-3 py-2">
      <dt class="text-muted-foreground">Per footing / run</dt>
      <dd class="mt-0.5 font-mono font-medium text-foreground tabular-nums" data-footing-card-per>20 ft³</dd>
    </div>
    <div class="rounded-md border border-border bg-muted/30 px-3 py-2">
      <dt class="text-muted-foreground">Net total</dt>
      <dd class="mt-0.5 font-mono font-medium text-foreground tabular-nums" data-footing-card-total>20 ft³</dd>
    </div>
    <div class="rounded-md border border-border bg-muted/30 px-3 py-2">
      <dt class="text-muted-foreground">Order target</dt>
      <dd class="mt-0.5 font-mono font-medium text-foreground tabular-nums" data-footing-card-order>0.81 yd³</dd>
    </div>
  </dl>
</figure>

<script>
  function initConcreteFootingRichDiagrams() {
    document.querySelectorAll<HTMLElement>("[data-concrete-footing-rich-diagram]").forEach((figure) => {
      if (figure.dataset.initialized) return;
      figure.dataset.initialized = "true";

      const root = figure.closest<HTMLElement>('[data-calculator-slug="concrete-footing-calculator"]');
      if (!root) return;
      const form = root.querySelector<HTMLFormElement>("#concrete-footing-calculator-form");
      if (!form) return;

      const input = (id: string) => root.querySelector<HTMLInputElement>("#concrete-footing-calculator-" + id);
      const select = (id: string) => root.querySelector<HTMLSelectElement>("#concrete-footing-calculator-" + id);
      const unit = (id: string) => root.querySelector<HTMLSelectElement>("#concrete-footing-calculator-" + id + "-unit");

      const numberValue = (id: string, fallback = 0) => {
        const n = Number(input(id)?.value);
        return Number.isFinite(n) ? n : fallback;
      };

      const displayValue = (id: string) => {
        const el = input(id);
        const raw = el?.value?.trim() ?? "";
        if (!raw) return "—";
        const n = Number(raw);
        const shown = Number.isFinite(n) ? String(Number(n.toFixed(4))) : raw;
        const u = unit(id);
        const label = u ? (u.options[u.selectedIndex]?.text?.trim() || u.value) : "";
        return label ? shown + " " + label : shown;
      };

      const feet = (id: string) => {
        const n = Number(input(id)?.value);
        if (!Number.isFinite(n)) return Number.NaN;
        const factors: Record<string, number> = {
          ft: 1,
          in: 1 / 12,
          yd: 3,
          m: 1 / 0.3048,
          cm: 1 / 30.48,
          mm: 1 / 304.8,
        };
        return n * (factors[unit(id)?.value ?? "ft"] ?? 1);
      };

      const fmt = (value: number, digits = 2) =>
        Number.isFinite(value) ? String(Number(value.toFixed(digits))) : "—";

      const setText = (selector: string, value: string) => {
        figure.querySelectorAll<SVGTextElement | HTMLElement>(selector).forEach((el) => {
          el.textContent = value;
        });
      };

      const setVisible = (selector: string, visible: boolean) => {
        figure.querySelectorAll<SVGElement | HTMLElement>(selector).forEach((el) => {
          (el as HTMLElement).style.display = visible ? "" : "none";
        });
      };

      const update = () => {
        const shape = Math.max(0, Math.min(3, Math.round(Number(select("footingShape")?.value ?? "0"))));
        const quantity = Math.max(0, Math.round(numberValue("quantity", 1)));
        const allowance = Math.max(0, numberValue("waste", 0));
        const depthFt = feet("depth");

        const names = [
          "Strip / continuous footing",
          "Square isolated pad",
          "Rectangular isolated pad",
          "Round / circular footing",
        ];
        const singular = shape === 0 ? "run" : "footing";
        const plural = shape === 0 ? "runs" : "footings";

        let area = 0;
        let perVolume = 0;
        let dimensions = "";
        let crossWidth = "";
        let planSummary = "";
        let formula = "";

        if (shape === 0) {
          const lengthFt = feet("length");
          const widthFt = feet("width");
          area = Number.isFinite(lengthFt) && lengthFt > 0 && Number.isFinite(widthFt) && widthFt > 0 ? lengthFt * widthFt : 0;
          perVolume = area > 0 && Number.isFinite(depthFt) && depthFt > 0 ? area * depthFt : 0;
          dimensions = displayValue("length") + " × " + displayValue("width") + " × " + displayValue("depth");
          crossWidth = "Width = " + displayValue("width");
          planSummary = fmt(area) + " ft² footprint per run";
          formula = "V = L × W × D × Q";
          setText("[data-footing-length]", "Length = " + displayValue("length"));
          setText("[data-footing-width]", "Width = " + displayValue("width"));
        } else if (shape === 1) {
          const sideFt = feet("sideWidth");
          area = Number.isFinite(sideFt) && sideFt > 0 ? sideFt * sideFt : 0;
          perVolume = area > 0 && Number.isFinite(depthFt) && depthFt > 0 ? area * depthFt : 0;
          dimensions = displayValue("sideWidth") + " × " + displayValue("sideWidth") + " × " + displayValue("depth");
          crossWidth = "Side = " + displayValue("sideWidth");
          planSummary = fmt(area) + " ft² footprint per footing";
          formula = "V = S² × D × Q";
          setText("[data-footing-square-side]", "Side = " + displayValue("sideWidth"));
        } else if (shape === 2) {
          const padLengthFt = feet("padLength");
          const padWidthFt = feet("padWidth");
          area = Number.isFinite(padLengthFt) && padLengthFt > 0 && Number.isFinite(padWidthFt) && padWidthFt > 0 ? padLengthFt * padWidthFt : 0;
          perVolume = area > 0 && Number.isFinite(depthFt) && depthFt > 0 ? area * depthFt : 0;
          dimensions = displayValue("padLength") + " × " + displayValue("padWidth") + " × " + displayValue("depth");
          crossWidth = "Width = " + displayValue("padWidth");
          planSummary = fmt(area) + " ft² footprint per footing";
          formula = "V = L × W × D × Q";
          setText("[data-footing-pad-length]", "Length = " + displayValue("padLength"));
          setText("[data-footing-pad-width]", "Width = " + displayValue("padWidth"));
        } else {
          const diameterFt = feet("diameter");
          area = Number.isFinite(diameterFt) && diameterFt > 0 ? Math.PI * (diameterFt / 2) ** 2 : 0;
          perVolume = area > 0 && Number.isFinite(depthFt) && depthFt > 0 ? area * depthFt : 0;
          dimensions = "Ø " + displayValue("diameter") + " × " + displayValue("depth");
          crossWidth = "Diameter = " + displayValue("diameter");
          planSummary = fmt(area) + " ft² circular footprint";
          formula = "V = π × (D ÷ 2)² × Depth × Q";
          setText("[data-footing-diameter]", "Diameter = " + displayValue("diameter"));
        }

        const totalCuFt = perVolume * quantity;
        const orderYd3 = totalCuFt * (1 + allowance / 100) / 27;

        for (let i = 0; i < 4; i += 1) {
          setVisible('[data-footing-plan-shape="' + i + '"]', i === shape);
        }

        setText("[data-footing-shape-title]", names[shape] ?? "Concrete footing");
        setText("[data-footing-quantity-label]", quantity + " " + (quantity === 1 ? singular : plural));
        setText("[data-footing-depth]", "Depth = " + displayValue("depth"));
        setText("[data-footing-cross-width]", crossWidth);
        setText("[data-footing-plan-summary]", planSummary);
        setText("[data-footing-formula]", formula);
        setText("[data-footing-dimensions]", dimensions);
        setText("[data-footing-allowance]", quantity + " " + (quantity === 1 ? singular : plural) + " · allowance " + fmt(allowance) + "%");

        setText("[data-footing-net-volume]", fmt(totalCuFt) + " ft³ total");
        setText("[data-footing-order-volume]", "Order target: " + fmt(orderYd3) + " yd³ with " + fmt(allowance) + "% allowance");

        setText("[data-footing-card-area]", fmt(area) + " ft²");
        setText("[data-footing-card-per]", fmt(perVolume) + " ft³");
        setText("[data-footing-card-total]", fmt(totalCuFt) + " ft³");
        setText("[data-footing-card-order]", fmt(orderYd3) + " yd³");
      };

      root.addEventListener("input", update);
      root.addEventListener("change", update);
      root.addEventListener("calculator-state-restored", update);
      form.addEventListener("reset", () => setTimeout(update, 0));

      update();
      queueMicrotask(update);
      requestAnimationFrame(update);
      setTimeout(update, 0);
    });
  }

  initConcreteFootingRichDiagrams();
  document.addEventListener("astro:page-load", initConcreteFootingRichDiagrams);
</script>
