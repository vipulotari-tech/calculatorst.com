---
const slug = "crushed-stone-calculator";
---

<figure
  class="rounded-xl border border-border bg-card p-4 sm:p-5"
  data-crushed-stone-diagram
  aria-labelledby="crushed-stone-diagram-heading"
>
  <div class="flex flex-wrap items-start justify-between gap-2">
    <div>
      <h3 id="crushed-stone-diagram-heading" class="text-xs font-mono font-semibold uppercase tracking-wider text-foreground">
        Live crushed-stone measurement diagram
      </h3>
      <p class="mt-1 text-xs leading-5 text-muted-foreground">
        Switch between dimensions, known area, and known volume. Values follow the visible inputs; schematic only, not to scale.
      </p>
    </div>
    <span class="rounded-full border border-border bg-muted px-2 py-1 font-mono text-[10px] text-muted-foreground">LIVE INPUT GUIDE</span>
  </div>

  <div class="mt-4 overflow-x-auto rounded-xl border border-border bg-background">
    <svg viewBox="0 0 720 315" class="h-auto w-full min-w-[520px]" role="img"
      aria-labelledby="crushed-stone-svg-title crushed-stone-svg-desc">
      <title id="crushed-stone-svg-title">Crushed stone measurement modes</title>
      <desc id="crushed-stone-svg-desc">
        Mode-specific crushed stone project geometry. Rectangular measurements show length, width, and layer thickness;
        known-area mode shows area and thickness; known-volume mode shows an aggregate stockpile.
        Live quantities and density are repeated in accessible text below.
      </desc>
      <defs>
        <pattern id="crushed-stone-aggregate-texture" patternUnits="userSpaceOnUse" width="26" height="20">
          <rect width="26" height="20" fill="var(--color-muted)" opacity=".55"/>
          <path d="M1 6l5-4 5 4-2 5-6 1ZM14 2l5 1 4 5-4 4-7-3ZM10 13l5-3 5 4-4 5-6-1Z"
            fill="none" stroke="var(--color-muted-foreground)" stroke-width="1" opacity=".65"/>
        </pattern>
        <marker id="crushed-stone-arrow" viewBox="0 0 10 10" refX="5" refY="5"
          markerWidth="6" markerHeight="6" orient="auto-start-reverse">
          <path d="M0 0L10 5L0 10Z" fill="#2563eb"/>
        </marker>
      </defs>
      <rect x="1" y="1" width="718" height="313" rx="12" fill="var(--color-background)" stroke="var(--color-border)"/>
      <text x="26" y="33" font-size="14" font-weight="700" fill="var(--color-foreground)" data-stone-svg-mode-title>
        Length × width × depth
      </text>

      <g data-stone-mode="0">
        <text x="38" y="63" font-size="11" font-weight="700" fill="var(--color-muted-foreground)">RECTANGULAR STONE BED · ISOMETRIC</text>
        <polygon points="130,109 430,109 512,159 212,159" fill="url(#crushed-stone-aggregate-texture)" stroke="var(--color-foreground)" stroke-width="2"/>
        <polygon points="212,159 512,159 512,223 212,223" fill="url(#crushed-stone-aggregate-texture)" stroke="var(--color-foreground)" stroke-width="2"/>
        <polygon points="130,109 212,159 212,223 130,173" fill="var(--color-muted)" stroke="var(--color-foreground)" stroke-width="2"/>
        <line x1="130" y1="88" x2="430" y2="88" stroke="#2563eb" stroke-width="2"
          marker-start="url(#crushed-stone-arrow)" marker-end="url(#crushed-stone-arrow)"/>
        <text x="280" y="78" text-anchor="middle" font-size="13" font-weight="700" fill="#2563eb" data-stone-length>Length: 20 ft</text>
        <line x1="449" y1="102" x2="529" y2="151" stroke="#2563eb" stroke-width="2"
          marker-start="url(#crushed-stone-arrow)" marker-end="url(#crushed-stone-arrow)"/>
        <text x="539" y="107" font-size="12" font-weight="700" fill="#2563eb" data-stone-width>Width: 10 ft</text>
        <line x1="543" y1="160" x2="543" y2="222" stroke="#2563eb" stroke-width="2"
          marker-start="url(#crushed-stone-arrow)" marker-end="url(#crushed-stone-arrow)"/>
        <text x="556" y="197" font-size="12" font-weight="700" fill="#2563eb" data-stone-depth>Depth: 4 in</text>
        <text x="360" y="251" text-anchor="middle" font-size="11" fill="var(--color-muted-foreground)">Length × width × placed depth = measured stone volume</text>
      </g>

      <g data-stone-mode="1" style="display:none">
        <text x="38" y="63" font-size="11" font-weight="700" fill="var(--color-muted-foreground)">KNOWN AREA + STONE LAYER DEPTH</text>
        <path d="M70 117L170 94L314 114L341 204L208 235L73 213Z"
          fill="url(#crushed-stone-aggregate-texture)" stroke="var(--color-foreground)" stroke-width="2"/>
        <text x="204" y="154" font-size="19" text-anchor="middle" font-weight="700" fill="var(--color-foreground)" data-stone-area>200 ft²</text>
        <text x="204" y="178" font-size="12" text-anchor="middle" fill="var(--color-muted-foreground)">Known surface area</text>
        <text x="425" y="89" font-size="12" font-weight="700" fill="var(--color-foreground)">CROSS-SECTION</text>
        <rect x="415" y="132" width="206" height="66" fill="url(#crushed-stone-aggregate-texture)"
          stroke="var(--color-foreground)" stroke-width="2"/>
        <rect x="415" y="198" width="206" height="30" fill="var(--color-muted)" opacity=".5"/>
        <line x1="643" y1="132" x2="643" y2="198" stroke="#2563eb" stroke-width="2"
          marker-start="url(#crushed-stone-arrow)" marker-end="url(#crushed-stone-arrow)"/>
        <text x="615" y="250" text-anchor="end" font-size="12" font-weight="700" fill="#2563eb" data-stone-area-depth>Depth: 4 in</text>
        <text x="204" y="257" font-size="11" text-anchor="middle" fill="var(--color-muted-foreground)">Area × depth = volume</text>
      </g>

      <g data-stone-mode="2" style="display:none">
        <text x="38" y="63" font-size="11" font-weight="700" fill="var(--color-muted-foreground)">EXISTING / QUOTED AGGREGATE VOLUME</text>
        <path d="M87 229C119 206 140 137 204 118C272 97 308 157 354 184C384 203 403 224 415 229Z"
          fill="url(#crushed-stone-aggregate-texture)" stroke="var(--color-foreground)" stroke-width="2"/>
        <line x1="81" y1="235" x2="422" y2="235" stroke="#2563eb" stroke-width="2"/>
        <text x="251" y="192" font-size="21" text-anchor="middle" font-weight="700" fill="var(--color-foreground)" data-stone-volume>2 yd³</text>
        <text x="251" y="257" font-size="11" text-anchor="middle" fill="var(--color-muted-foreground)">No length / width / depth assumption</text>
        <rect x="464" y="104" width="197" height="125" rx="10" fill="var(--color-muted)" opacity=".35" stroke="var(--color-border)"/>
        <text x="562" y="141" font-size="12" text-anchor="middle" font-weight="700" fill="var(--color-foreground)">Known volume</text>
        <text x="562" y="168" font-size="12" text-anchor="middle" fill="var(--color-muted-foreground)">Convert to yd³</text>
        <text x="562" y="193" font-size="12" text-anchor="middle" fill="var(--color-muted-foreground)">then apply allowance</text>
      </g>

      <rect x="24" y="272" width="672" height="28" rx="7" fill="var(--color-muted)" opacity=".4"/>
      <text x="360" y="291" text-anchor="middle" font-size="12" font-weight="600" fill="var(--color-foreground)">
        Measured volume → add purchasing allowance once → order volume × density = US tons
      </text>
    </svg>
  </div>

  <dl class="mt-3 grid gap-2 text-xs sm:grid-cols-2 xl:grid-cols-4" aria-live="polite">
    <div class="rounded-lg border border-border bg-muted/30 px-3 py-2">
      <dt class="text-muted-foreground">Active measurement</dt>
      <dd class="mt-1 break-words font-mono font-semibold text-foreground" data-stone-geometry>20 ft × 10 ft × 4 in</dd>
    </div>
    <div class="rounded-lg border border-border bg-muted/30 px-3 py-2">
      <dt class="text-muted-foreground">Measured volume · before allowance</dt>
      <dd class="mt-1 font-mono font-semibold tabular-nums text-foreground" data-stone-net>2.469 yd³</dd>
    </div>
    <div class="rounded-lg border border-border bg-muted/30 px-3 py-2">
      <dt class="text-muted-foreground">Order volume · includes allowance</dt>
      <dd class="mt-1 font-mono font-semibold tabular-nums text-foreground" data-stone-order>2.716 yd³</dd>
    </div>
    <div class="rounded-lg border border-border bg-muted/30 px-3 py-2">
      <dt class="text-muted-foreground">Estimated order weight</dt>
      <dd class="mt-1 font-mono font-semibold tabular-nums text-foreground" data-stone-weight>4.074 US tons</dd>
    </div>
  </dl>
  <figcaption class="mt-3 text-xs leading-5 text-muted-foreground">
    Visual values use the selected units. Density must match the material's moisture and loose or compacted condition.
    This diagram does not apply a separate compaction factor.
  </figcaption>
</figure>

<script>
  function initCrushedStoneDiagrams() {
    document.querySelectorAll<HTMLElement>("[data-crushed-stone-diagram]").forEach((figure) => {
      if (figure.dataset.initialized === "true") return;
      const root = figure.closest<HTMLElement>('[data-calculator-slug="crushed-stone-calculator"]');
      if (!root) return;
      figure.dataset.initialized = "true";

      const control = (id: string) => root.querySelector<HTMLInputElement | HTMLSelectElement>("#crushed-stone-calculator-" + id);
      const unit = (id: string) => root.querySelector<HTMLSelectElement>("#crushed-stone-calculator-" + id + "-unit")?.value || "";
      const read = (id: string) => {
        const raw = control(id)?.value ?? "";
        return raw.trim() === "" ? Number.NaN : Number(raw);
      };
      const display = (id: string) => {
        const input = control(id);
        const number = input?.value.trim() || "—";
        const selected = root.querySelector<HTMLSelectElement>("#crushed-stone-calculator-" + id + "-unit");
        const label = selected?.selectedOptions[0]?.textContent?.trim() || unit(id);
        return number + (label ? " " + label : "");
      };
      const feet = (value: number, u: string) => {
        if (u === "in") return value / 12;
        if (u === "yd") return value * 3;
        if (u === "m") return value / 0.3048;
        if (u === "cm") return value / 30.48;
        if (u === "mm") return value / 304.8;
        return value;
      };
      const squareFeet = (value: number, u: string) => u === "m2" ? value * 10.7639104167 : u === "yd2" ? value * 9 : value;
      const cubicFeet = (value: number, u: string) => u === "m3" ? value * 35.3146667215 : u === "yd3" ? value * 27 : value;
      const fmt = (value: number, digits = 3) =>
        Number.isFinite(value) && value >= 0 ? value.toLocaleString("en-US", { maximumFractionDigits: digits }) : "—";
      const set = (selector: string, value: string) => {
        const element = figure.querySelector<HTMLElement>(selector);
        if (element) element.textContent = value;
      };

      const update = () => {
        const rawMode = read("mode");
        const mode = Number.isFinite(rawMode) ? Math.min(2, Math.max(0, Math.round(rawMode))) : 0;
        figure.querySelectorAll<SVGGElement>("[data-stone-mode]").forEach((group) => {
          group.style.display = group.dataset.stoneMode === String(mode) ? "" : "none";
        });

        const modeNames = ["Length × width × depth", "Known area × depth", "Known volume"];
        set("[data-stone-svg-mode-title]", modeNames[mode]);
        set("[data-stone-length]", "Length: " + display("length"));
        set("[data-stone-width]", "Width: " + display("width"));
        set("[data-stone-depth]", "Depth: " + display("depth"));
        set("[data-stone-area]", display("area"));
        set("[data-stone-area-depth]", "Depth: " + display("depth"));
        set("[data-stone-volume]", display("volume"));

        const geometry = mode === 0
          ? display("length") + " × " + display("width") + " × " + display("depth")
          : mode === 1
            ? display("area") + " × " + display("depth")
            : display("volume");
        set("[data-stone-geometry]", geometry);

        const depth = feet(read("depth"), unit("depth"));
        const measuredFt3 = mode === 0
          ? feet(read("length"), unit("length")) * feet(read("width"), unit("width")) * depth
          : mode === 1
            ? squareFeet(read("area"), unit("area")) * depth
            : cubicFeet(read("volume"), unit("volume"));
        const allowance = read("waste");
        const density = read("density");
        const valid = Number.isFinite(measuredFt3) && measuredFt3 >= 0
          && Number.isFinite(allowance) && allowance >= 0 && allowance <= 100
          && Number.isFinite(density) && density > 0;
        const netYd3 = valid ? measuredFt3 / 27 : Number.NaN;
        const orderYd3 = valid ? netYd3 * (1 + allowance / 100) : Number.NaN;
        set("[data-stone-net]", fmt(netYd3) + (valid ? " yd³" : ""));
        set("[data-stone-order]", fmt(orderYd3) + (valid ? " yd³ (" + fmt(allowance, 1) + "% allowance)" : ""));
        set("[data-stone-weight]", fmt(orderYd3 * density) + (valid ? " US tons" : ""));
      };

      root.addEventListener("input", update);
      root.addEventListener("change", update);
      root.addEventListener("calculator-state-restored", update);
      update();
      queueMicrotask(update);
      requestAnimationFrame(update);
      setTimeout(update, 0);
    });
  }
  document.addEventListener("astro:page-load", initCrushedStoneDiagrams);
  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", initCrushedStoneDiagrams, { once: true });
  } else {
    initCrushedStoneDiagrams();
  }
</script>
