---
interface InputField {
  id: string;
  label: string;
  placeholder?: string;
  defaultValue?: string | number;
  min?: number;
  max?: number;
  required?: boolean;
  unit?: string;
  units?: string[];
}
interface Props {
  id: string;
  inputs: InputField[];
  formulaKey: string;
  resultTitle?: string;
  wasteDefault?: number;
  priceDefault?: boolean;
}

const { id, inputs, formulaKey, resultTitle = "ESTIMATE", wasteDefault = 10, priceDefault = true } = Astro.props;
const formId = `${id}-form`;
const resultsId = `${id}-results`;
---

<div id={id} class="rounded-xl border border-border bg-card p-5 shadow-card sm:p-6">
  <form id={formId} novalidate class="space-y-5">
    <div class="grid gap-4 sm:grid-cols-3">
      {inputs.map((inp) => (
        <label class="block">
          <span class="text-[13px] font-medium text-foreground">{inp.label}</span>
          <div class="mt-1.5 flex">
            <input
              id={`${id}-${inp.id}`}
              type="number"
              inputmode="decimal"
              min={inp.min ?? 0}
              max={inp.max}
              step="any"
              placeholder={inp.placeholder}
              value={inp.defaultValue}
              required={inp.required}
              aria-describedby={`${id}-${inp.id}-error`}
              class="h-11 w-full rounded-l-lg border border-border bg-muted/50 px-3 text-[14px] text-foreground placeholder:text-muted-foreground/50 focus:border-ring focus:outline-none focus:ring-2 focus:ring-ring/20 transition-colors"
            />
            {inp.units ? (
              <select id={`${id}-${inp.id}-unit`} class="h-11 shrink-0 rounded-r-lg border border-l-0 border-border bg-muted px-2.5 text-[13px] text-foreground focus:outline-none focus:ring-2 focus:ring-ring/20">
                {inp.units.map((u) => <option value={u} selected={u===inp.unit}>{u}</option>)}
              </select>
            ) : inp.unit ? (
              <span class="flex h-11 items-center rounded-r-lg border border-l-0 border-border bg-muted px-3 text-[13px] text-muted-foreground">{inp.unit}</span>
            ) : null}
          </div>
          <span id={`${id}-${inp.id}-error`} class="mt-1 hidden text-xs text-destructive" role="alert"></span>
        </label>
      ))}
    </div>

    <div class="grid gap-4 sm:grid-cols-3">
      <label class="block">
        <span class="text-[13px] font-medium text-foreground">Waste / Overage</span>
        <div class="mt-1.5 flex">
          <input id={`${id}-waste`} type="number" inputmode="decimal" min="0" max="50" step="1" value={wasteDefault} class="h-11 w-full rounded-l-lg border border-border bg-muted/50 px-3 text-[14px] text-foreground focus:border-ring focus:outline-none focus:ring-2 focus:ring-ring/20 transition-colors" />
          <span class="flex h-11 items-center rounded-r-lg border border-l-0 border-border bg-muted px-3 text-[13px] text-muted-foreground">%</span>
        </div>
      </label>
      {priceDefault && (
        <label class="block">
          <span class="text-[13px] font-medium text-foreground">Price (optional)</span>
          <div class="mt-1.5 flex">
            <span class="flex h-11 items-center rounded-l-lg border border-border bg-muted px-2.5 text-[13px] text-muted-foreground">$</span>
            <input id={`${id}-price`} type="number" inputmode="decimal" min="0" step="any" placeholder="e.g. 45" class="h-11 w-full border-y border-border bg-muted/50 px-3 text-[14px] text-foreground placeholder:text-muted-foreground/50 focus:outline-none focus:ring-2 focus:ring-ring/20 transition-colors" />
            <select id={`${id}-price-unit`} class="h-11 shrink-0 rounded-r-lg border border-l-0 border-border bg-muted px-2 text-[12px] text-foreground focus:outline-none focus:ring-2 focus:ring-ring/20">
              <option value="unit">/ unit</option>
              <option value="yd">/ yd³</option>
              <option value="ton">/ ton</option>
            </select>
          </div>
        </label>
      )}
      <div class="flex items-end"><p class="font-mono text-[11px] leading-4 text-muted-foreground">US units default — metric where useful. Waste included in totals.</p></div>
    </div>

    <div class="flex flex-wrap gap-2">
      <button type="submit" class="inline-flex h-11 items-center justify-center rounded-lg bg-foreground px-6 text-[13px] font-medium text-background transition-opacity hover:opacity-90 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring">Calculate</button>
      <button type="reset" id={`${id}-reset`} class="inline-flex h-11 items-center justify-center rounded-lg border border-border bg-muted px-6 text-[13px] font-medium text-foreground transition-colors hover:bg-muted/80 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring">Reset</button>
      <span class="inline-flex items-center font-mono text-[11px] text-muted-foreground">Enter dimensions → Calculate.</span>
    </div>
  </form>

  <div id={resultsId} class="mt-6 hidden" aria-live="polite">
    <div class="rounded-xl border border-border bg-muted/30 p-5">
      <p class="font-mono text-[11px] font-medium tracking-[0.1em] uppercase text-muted-foreground">{resultTitle}</p>
      <div id={`${id}-primary`} class="mt-2 text-2xl font-semibold tracking-[-0.03em] text-foreground tabular-nums">—</div>
      <div id={`${id}-secondary`} class="mt-1 font-mono text-[12px] tabular-nums text-muted-foreground">—</div>
      <div id={`${id}-breakdown`} class="mt-4 grid gap-3 rounded-lg border border-border bg-muted/50 p-3 sm:grid-cols-3 text-[13px]"></div>
      <p id={`${id}-cost`} class="mt-3 text-[13px] font-semibold text-foreground">—</p>
      <p class="mt-2 font-mono text-[11px] leading-4 text-muted-foreground">Estimate only — verify with supplier, plans or professional for final order.</p>
    </div>
  </div>
</div>

<script is:inline define:vars={{ id, inputs, formulaKey }}>
(() => {
  const $ = (s) => document.getElementById(s);
  const form = $(`${id}-form`);
  const results = $(`${id}-results`);
  if (!form || !results) return;

  function toFeet(v, u) {
    if (!isFinite(v)) return NaN;
    if (u === "ft") return v;
    if (u === "in") return v / 12;
    if (u === "yd") return v * 3;
    if (u === "m") return v * 3.28084;
    if (u === "cm") return v * 0.0328084;
    if (u === "mm") return v * 0.00328084;
    // for direct ft2/yd3 etc fallback
    return v;
  }
  function toInches(v,u){ return toFeet(v,u)*12; }
  function volToCuFt(v,u){
    if (!isFinite(v)) return NaN;
    if (u==="yd3"||u==="yd³"||u==="cuyd") return v*27;
    if (u==="m3"||u==="m³") return v*35.3147;
    if (u==="ft3"||u==="ft³") return v;
    if (u==="in3"||u==="in³") return v/1728;
    if (u==="liter"||u==="l") return v*0.0353147;
    if (u==="gallon"||u==="gal") return v*0.133681;
    return v;
  }
  function toSqFt(v,u){
    if (u==="sqft"||u==="ft2"||u==="ft²") return v;
    if (u==="sqyd"||u==="yd2") return v*9;
    if (u==="sqm"||u==="m2"||u==="m²") return v*10.7639;
    if (u==="sqin"||u==="in2") return v/144;
    return v;
  }
  function fmt(n, dec=2) {
    if (!isFinite(n)) return "—";
    return new Intl.NumberFormat("en-US", { maximumFractionDigits: dec, minimumFractionDigits: dec===0?0:dec===2?2:0 }).format(n);
  }
  function fmtCurrency(n){ return new Intl.NumberFormat("en-US",{style:"currency",currency:"USD"}).format(n); }
  function getUnit(key){
    const sel = $(`${id}-${key}-unit`);
    if (sel) return sel.value;
    const inp = inputs.find(i=>i.id===key);
    return inp?.unit || "ft";
  }
  function showError(field, msg) {
    const el = $(`${id}-${field}-error`);
    if (!el) return;
    el.textContent = msg;
    el.classList.remove("hidden");
  }
  function clearErrors() {
    inputs.forEach(inp => {
      const el = $(`${id}-${inp.id}-error`);
      if (el) { el.textContent=""; el.classList.add("hidden"); }
    });
  }

  const slug = id;
  const is = (s)=> slug.includes(s);
  const eq = (s)=> slug===s;

  form.addEventListener("submit", (e) => {
    e.preventDefault();
    clearErrors();
    const vals = {};
    let valid = true;
    inputs.forEach(inp => {
      const v = parseFloat($(`${id}-${inp.id}`).value);
      vals[inp.id] = v;
      if (inp.required && !(v>0)) {
        showError(inp.id, `Please enter a valid ${inp.label.toLowerCase()}.`);
        valid = false;
      }
    });
    if (!valid) return;

    const waste = parseFloat($(`${id}-waste`).value) || 0;
    const price = parseFloat($(`${id}-price`)?.value);
    const priceUnit = $(`${id}-price-unit`)?.value;
    const wasteF = 1 + waste/100;

    let primary = "—", secondary = "—", breakdown = "", costText = "—";

    try {
      // ===== CONCRETE COLUMN (cylinder) =====
      if (eq("concrete-column-calculator")) {
        const D=vals["diameter"], Du=getUnit("diameter"), H=vals["height"], Hu=getUnit("height"), cnt=vals["count"]||1;
        const Df=toFeet(D,Du), Hf=toFeet(H,Hu);
        const r=Df/2, area=Math.PI*r*r, cuFt=area*Hf*(cnt||1), cuYd=cuFt/27, cuFtW=cuFt*wasteF, cuYdW=cuYd*wasteF;
        const b80=Math.ceil(cuFtW/0.60), b60=Math.ceil(cuFtW/0.45), b40=Math.ceil(cuFtW/0.30);
        primary=`${fmt(cuYdW)} yd³`;
        secondary=`${fmt(cuFtW)} ft³ • ${fmt(area,3)} ft² cross-section • ${cnt||1} col`;
        breakdown=`<div><p class="font-mono text-[11px] text-muted-foreground">Cubic yards</p><p class="font-semibold tabular-nums">${fmt(cuYd)} → ${fmt(cuYdW)} w/ ${waste}%</p></div><div><p class="font-mono text-[11px] text-muted-foreground">Cubic feet</p><p class="font-semibold tabular-nums">${fmt(cuFt)} → ${fmt(cuFtW)}</p></div><div><p class="font-mono text-[11px] text-muted-foreground">Bags (80lb)</p><p class="font-semibold">${b80} (60lb: ${b60})</p></div>`;
        if(isFinite(price)&&price>0){
          const c= priceUnit==="ton" ? cuYdW*2.025*price : cuYdW*price;
          const lbl=priceUnit==="ton"?"/ton":"/yd³";
          costText=`${fmtCurrency(c)} at ${fmt(price)}${lbl} incl. ${waste}%`;
        } else costText=`${b80} × 80lb bags (0.60 ft³ ea)`;

      // ===== CONCRETE CURB + GUTTER =====
      } else if (eq("concrete-curb-calculator")) {
        const L=vals["length"], Lu=getUnit("length"), cw=vals["curb_width"], cwu=getUnit("curb_width"), ch=vals["curb_height"], chu=getUnit("curb_height"), gw=vals["gutter_width"], gwu=getUnit("gutter_width"), gt=vals["gutter_thickness"], gtu=getUnit("gutter_thickness");
        const Lf=toFeet(L,Lu), cwf=toFeet(cw,cwu), chf=toFeet(ch,chu), gwf=toFeet(gw,gwu), gtf=toFeet(gt,gtu);
        const curbA=cwf*chf, gutA=gwf*gtf, totA=curbA+gutA, cuFt=Lf*totA, cuYd=cuFt/27, cuYdW=cuYd*wasteF, cuFtW=cuFt*wasteF;
        primary=`${fmt(cuYdW)} yd³`;
        secondary=`${fmt(cuFtW)} ft³ • curb ${fmt(curbA,3)} + gutter ${fmt(gutA,3)} ft²`;
        breakdown=`<div><p class="font-mono text-[11px] text-muted-foreground">Curb area</p><p class="font-semibold">${fmt(curbA,3)} ft²</p></div><div><p class="font-mono text-[11px] text-muted-foreground">Gutter area</p><p class="font-semibold">${fmt(gutA,3)} ft²</p></div><div><p class="font-mono text-[11px] text-muted-foreground">Volume</p><p class="font-semibold">${fmt(cuYd)} → ${fmt(cuYdW)} yd³</p></div>`;
        if(isFinite(price)&&price>0) costText=`${fmtCurrency(cuYdW*price)} at ${fmt(price)}/yd³`;

      // ===== CONCRETE STAIR =====
      } else if (eq("concrete-stair-calculator")) {
        const W=vals["width"], Wu=getUnit("width"), rise=vals["rise"], ru=getUnit("rise"), run=vals["run"], runu=getUnit("run"), steps=vals["steps"]||1, plat=vals["platform_depth"]||0, platu=getUnit("platform_depth");
        const Wf=toFeet(W,Wu), Rise=toFeet(rise,ru), Run=toFeet(run,runu);
        const per=Run*Rise*Wf, stepsCuFt=per*(steps||1);
        const platDf=plat?toFeet(plat,platu):0;
        const platformCuFt=platDf>0?platDf*Wf*Run:0;
        const cuFt=stepsCuFt+platformCuFt, cuYd=cuFt/27, cuFtW=cuFt*wasteF, cuYdW=cuYd*wasteF;
        primary=`${fmt(cuYdW)} yd³`;
        secondary=`${fmt(cuFtW)} ft³ • ${fmt(per,3)} ft³ per step × ${steps}${platformCuFt>0?` + platform ${fmt(platformCuFt,2)} ft³`:""}`;
        breakdown=`<div><p class="font-mono text-[11px] text-muted-foreground">Per step</p><p class="font-semibold">${fmt(per,3)} ft³</p></div><div><p class="font-mono text-[11px] text-muted-foreground">Steps</p><p class="font-semibold">${fmt(stepsCuFt,2)} ft³</p></div><div><p class="font-mono text-[11px] text-muted-foreground">Platform</p><p class="font-semibold">${fmt(platformCuFt,2)} ft³</p></div><div><p class="font-mono text-[11px] text-muted-foreground">Total w/ ${waste}%</p><p class="font-semibold">${fmt(cuYdW)} yd³</p></div>`;
        if(isFinite(price)&&price>0) costText=`${fmtCurrency(cuYdW*price)} at ${fmt(price)}/yd³`;

      // ===== CONCRETE RAMP (triangular prism) =====
      } else if (eq("concrete-ramp-calculator")) {
        const L=vals["length"], Lu=getUnit("length"), W=vals["width"], Wu=getUnit("width"), H=vals["height"]||vals["depth"], Hu=getUnit("height")||getUnit("depth");
        const Lf=toFeet(L,Lu), Wf=toFeet(W,Wu), Hf=toFeet(H,Hu);
        const cuFt=(Lf*Wf*Hf)/2, cuYd=cuFt/27, cuYdW=cuYd*wasteF;
        primary=`${fmt(cuYdW)} yd³`;
        secondary=`${fmt(cuFt*wasteF)} ft³ • wedge ${(fmt(Lf*Wf*Hf,2))} ft³ /2`;
        breakdown=`<div><p class="font-mono text-[11px] text-muted-foreground">Raw</p><p class="font-semibold">${fmt(cuYd)} yd³</p></div><div><p class="font-mono text-[11px] text-muted-foreground">With ${waste}%</p><p class="font-semibold">${fmt(cuYdW)} yd³</p></div><div><p class="font-mono text-[11px] text-muted-foreground">Formula</p><p class="font-semibold">L×W×H/2</p></div>`;
        if(isFinite(price)&&price>0) costText=`${fmtCurrency(cuYdW*price)} at ${fmt(price)}/yd³`;

      // ===== CONCRETE TUBE / CIRCULAR SLAB (hollow cylinder) =====
      } else if (eq("concrete-tube-calculator") || eq("circular-slab-tube-calculator")) {
        const od=vals["outer_diameter"], odu=getUnit("outer_diameter"), idv=vals["inner_diameter"]||0, idu=getUnit("inner_diameter"), h=vals["height"], hu=getUnit("height"), qty=vals["quantity"]||1;
        const Do=toFeet(od,odu), Di=toFeet(idv,idu), Hf=toFeet(h,hu);
        const Ro=Do/2, Ri=Di/2;
        const outerArea=Math.PI*Ro*Ro, innerArea=Di>0?Math.PI*Ri*Ri:0, area=Math.max(0,outerArea-innerArea);
        const cuFt=area*Hf*(qty||1), cuYd=cuFt/27, cuFtW=cuFt*wasteF, cuYdW=cuYd*wasteF;
        const isHollow = Di>0 && innerArea>0;
        primary=`${fmt(cuYdW)} yd³`;
        secondary=`${fmt(cuFtW)} ft³ • ${isHollow?`hollow ${fmt(area,3)} ft² (outer ${fmt(outerArea,3)} - inner ${fmt(innerArea,3)})`:`solid ${fmt(area,3)} ft²`} × ${fmt(Hf,2)} ft${qty>1?` × ${qty}`:""}`;
        breakdown=`<div><p class="font-mono text-[11px] text-muted-foreground">Outer area</p><p class="font-semibold">${fmt(outerArea,3)} ft²</p></div><div><p class="font-mono text-[11px] text-muted-foreground">${isHollow?"Inner area":"Solid"}</p><p class="font-semibold">${isHollow?fmt(innerArea,3)+" ft²":"—"}</p></div><div><p class="font-mono text-[11px] text-muted-foreground">Volume w/ ${waste}%</p><p class="font-semibold">${fmt(cuYdW)} yd³</p></div>`;
        if(isFinite(price)&&price>0){
          const c=priceUnit==="ton"?cuYdW*2.025*price:cuYdW*price;
          const lbl=priceUnit==="ton"?"/ton":"/yd³";
          costText=`${fmtCurrency(c)} at ${fmt(price)}${lbl}`;
        } else {
          const b80=Math.ceil(cuFtW/0.60);
          costText=`${b80} × 80lb bags (0.60 ft³ ea)`;
        }

      // ===== SLAB / GRAVEL / ASPHALT THICKNESS (Volume / Area) =====
      } else if (eq("slab-thickness-calculator") || eq("gravel-depth-calculator") || eq("asphalt-thickness-calculator")) {
        const L=vals["length"], Lu=getUnit("length"), W=vals["width"], Wu=getUnit("width"), Vol=vals["volume"], Vu=getUnit("volume");
        const Lf=toFeet(L,Lu), Wf=toFeet(W,Wu), area=Lf*Wf;
        let cuFt=volToCuFt(Vol,Vu);
        // if volume given as tons for asphalt, convert tons→yd→cuFt
        if (Vu==="ton" || priceUnit==="ton") { /* Vu is volume selector; if tons, treat as weight */ }
        const thickFt= area>0 ? cuFt/area : 0, thickIn=thickFt*12;
        primary=`${fmt(thickIn,2)} in`;
        secondary=`${fmt(thickFt,3)} ft • area ${fmt(area,1)} ft² • vol ${fmt(cuFt)} ft³`;
        breakdown=`<div><p class="font-mono text-[11px] text-muted-foreground">Area</p><p class="font-semibold">${fmt(area,1)} ft²</p></div><div><p class="font-mono text-[11px] text-muted-foreground">Volume</p><p class="font-semibold">${fmt(cuFt)} ft³ (${fmt(cuFt/27)} yd³)</p></div><div><p class="font-mono text-[11px] text-muted-foreground">Thickness</p><p class="font-semibold">${fmt(thickIn,2)} in</p></div>`;

      } else if (eq("surface-area-calculator")) {
        const L=vals["length"], Lu=getUnit("length"), W=vals["width"], Wu=getUnit("width");
        const area=toFeet(L,Lu)*toFeet(W,Wu);
        const areaW=area*wasteF;
        primary=`${fmt(areaW,1)} ft²`;
        secondary=`${fmt(area,1)} ft² + ${waste}% → ${fmt(areaW,1)} ft²`;
        breakdown=`<div><p class="font-mono text-[11px] text-muted-foreground">Area</p><p class="font-semibold">${fmt(area,1)} ft²</p></div><div><p class="font-mono text-[11px] text-muted-foreground">With waste</p><p class="font-semibold">${fmt(areaW,1)} ft²</p></div>`;
        if(isFinite(price)&&price>0) costText=`${fmtCurrency(areaW*price)} at ${fmt(price)}/ft²`;

      } else if (eq("cut-and-fill-calculator")) {
        const cut=vals["cut"], cutU=getUnit("cut"), fill=vals["fill"], fillU=getUnit("fill");
        const cutYd=volToCuFt(cut,cutU)/27, fillYd=volToCuFt(fill,fillU)/27;
        const cutLoose=cutYd*1.2, balance=cutLoose-fillYd;
        primary=`${fmt(balance,2)} yd³ balance`;
        secondary=`cut ${fmt(cutYd)} → loose ${fmt(cutLoose)} • fill ${fmt(fillYd)}`;
        breakdown=`<div><p class="font-mono text-[11px] text-muted-foreground">Cut (bank)</p><p class="font-semibold">${fmt(cutYd)} yd³</p></div><div><p class="font-mono text-[11px] text-muted-foreground">Fill</p><p class="font-semibold">${fmt(fillYd)} yd³</p></div><div><p class="font-mono text-[11px] text-muted-foreground">Balance</p><p class="font-semibold">${balance>0?"+":""}${fmt(balance)} yd³ ${balance>0?"(export)":"(import)"}</p></div>`;

      } else if (eq("trench-backfill-calculator")) {
        const L=vals["length"], Lu=getUnit("length"), W=vals["width"], Wu=getUnit("width"), D=vals["depth"], Du=getUnit("depth"), pd=vals["pipe_diameter"], pdu=getUnit("pipe_diameter");
        const Lf=toFeet(L,Lu), Wf=toFeet(W,Wu), Df=toFeet(D,Du), pdf=toFeet(pd,pdu);
        const cuFt=Lf*Wf*Df, cuYd=cuFt/27, r=pdf/2, pipeFt=Math.PI*r*r*Lf, pipeYd=pipeFt/27, back=cuYd-pipeYd, backW=back*wasteF;
        primary=`${fmt(backW,2)} yd³ backfill`;
        secondary=`trench ${fmt(cuYd)} - pipe ${fmt(pipeYd)} = ${fmt(back)} yd³`;
        breakdown=`<div><p class="font-mono text-[11px] text-muted-foreground">Trench</p><p class="font-semibold">${fmt(cuYd)} yd³</p></div><div><p class="font-mono text-[11px] text-muted-foreground">Pipe</p><p class="font-semibold">${fmt(pipeYd)} yd³</p></div><div><p class="font-mono text-[11px] text-muted-foreground">Backfill w/ ${waste}%</p><p class="font-semibold">${fmt(backW)} yd³</p></div>`;

      // ===== BRICK / CMU / MASONRY =====
      } else if (is("brick") || is("masonry") || is("cmu") || is("concrete-block")) {
        const slugCat = slug;
        // weight variant
        if (slug.includes("weight")) {
          const wl=vals["wall_length"], wlu=getUnit("wall_length"), wh=vals["wall_height"], whu=getUnit("wall_height"), uw=vals["unit_weight"]||4.3;
          const area=toFeet(wl,wlu)*toFeet(wh,whu);
          // need count via brick size; fallback 7 per ft2 for brick, 1.125 for CMU
          const isCMU=slug.includes("cmu")||slug.includes("block");
          const per=isCMU?1.125:6.8;
          const count=Math.ceil(area*per), countW=Math.ceil(count*wasteF);
          const w=vals["unit_weight"]|| (isCMU? 35 : 4.3);
          const lb=count*w, lbW=countW*w;
          primary=`${fmt(lbW,0)} lb`;
          secondary=`${fmt(lbW/2000,2)} tons • ${fmt(count)} → ${fmt(countW)} units w/ ${waste}%`;
