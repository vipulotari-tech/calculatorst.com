---
import { getModelForSlug } from "../../lib/calculator-registry";
import { unitLabels } from "../../lib/calculator-math";
import type { Field } from "../../lib/calculator-types";
import ProjectDiagram from "./ProjectDiagram.astro";
import ConcreteCalculatorDiagram from "./ConcreteCalculatorDiagram.astro";
import ConcreteVolumeDiagram from "./ConcreteVolumeDiagram.astro";
import PaintCalculatorDiagram from "./PaintCalculatorDiagram.astro";
import GravelCalculatorDiagram from "./GravelCalculatorDiagram.astro";
import GravelWeightCalculatorDiagram from "./GravelWeightCalculatorDiagram.astro";
import MulchProjectDiagram from "./MulchProjectDiagram.astro";
import RoofingCalculatorDiagram from "./RoofingCalculatorDiagram.astro";
import RoofingShingleCalculatorDiagram from "./RoofingShingleCalculatorDiagram.astro";
import RoofPitchCalculatorDiagram from "./RoofPitchCalculatorDiagram.astro";
import FlooringCalculatorDiagram from "./FlooringCalculatorDiagram.astro";
import CarpetCalculatorDiagram from "./CarpetCalculatorDiagram.astro";
import TileCalculatorDiagram from "./TileCalculatorDiagram.astro";
import DrywallCalculatorDiagram from "./DrywallCalculatorDiagram.astro";
import ConcreteSlabCalculatorDiagram from "./ConcreteSlabCalculatorDiagram.astro";
import ConcreteFootingCalculatorDiagram from "./ConcreteFootingCalculatorDiagram.astro";
import SlabThicknessCalculatorDiagram from "./SlabThicknessCalculatorDiagram.astro";
import FenceCalculatorDiagram from "./FenceCalculatorDiagram.astro";
import DeckCalculatorDiagram from "./DeckCalculatorDiagram.astro";
import PaverCalculatorDiagram from "./PaverCalculatorDiagram.astro";
import AsphaltCalculatorDiagram from "./AsphaltCalculatorDiagram.astro";
import AsphaltThicknessCalculatorDiagram from "./AsphaltThicknessCalculatorDiagram.astro";
import ParkingLotCalculatorDiagram from "./ParkingLotCalculatorDiagram.astro";
import ParkingLotCostCalculatorDiagram from "./ParkingLotCostCalculatorDiagram.astro";
import RoadBaseCalculatorDiagram from "./RoadBaseCalculatorDiagram.astro";
import SurfaceAreaCalculatorDiagram from "./SurfaceAreaCalculatorDiagram.astro";
import ConstructionMaterialCostCalculatorDiagram from "./ConstructionMaterialCostCalculatorDiagram.astro";
import BrickCalculatorDiagram from "./BrickCalculatorDiagram.astro";
import ConcreteBlockCalculatorDiagram from "./ConcreteBlockCalculatorDiagram.astro";
import RebarCalculatorDiagram from "./RebarCalculatorDiagram.astro";
import ExcavationCalculatorDiagram from "./ExcavationCalculatorDiagram.astro";
import EarthworkCalculatorDiagram from "./EarthworkCalculatorDiagram.astro";
import FramingCalculatorDiagram from "./FramingCalculatorDiagram.astro";

interface Props {
  id: string; // The slug, e.g. "concrete-calculator"
  resultTitle?: string;
  wasteDefault?: number;
}

const { id, resultTitle } = Astro.props;
const slug = id;
const model = getModelForSlug(slug);
const fields = model.fields;

// Server-render the initial visibility of mode-gated fields so hidden inputs
// do not flash before the client script applies the same rules.
function fieldVisible(f: Field, all: Field[]): boolean {
  const vw = f.visibleWhen;
  if (!vw || !vw.field) return true;
  const ctrl = all.find((x) => x.id === vw.field);
  const ctrlValue = ctrl?.value ?? ctrl?.min ?? 0;
  if (vw.equals !== undefined) return ctrlValue === vw.equals;
  return (vw.in ?? []).includes(ctrlValue);
}

const measurements = fields.filter((f) =>
  (!f.group || f.group === "Measurements")
  && !(slug === "concrete-waste-calculator" && ["multiPourVolume", "multiPourCount"].includes(f.id))
);
const assumptions = fields.filter((f) => f.group === "Material & assumptions");
const costs = fields.filter((f) => f.group === "Cost");
const diagramFields = fields
  .filter((field) =>
    !field.options
    && (
      field.dimension === "length"
      || (["concrete-weight-calculator", "concrete-cost-calculator"].includes(slug) && field.dimension === "area")
      || ["pitch", "rise", "run", "spacing"].includes(field.id)
    )
  )
  .map((field) => ({ id: field.id, label: field.label, unit: field.unit }));
---

<div
  id={slug}
  data-calculator-slug={slug}
  class="rounded-xl border border-border bg-card p-5 shadow-card sm:p-7"
>
  <form id={`${slug}-form`} novalidate class="space-y-6">
    <!-- Section 1: Dimensions & Measurements -->
    <div class="space-y-3">
      <h3 class="text-xs font-mono font-semibold uppercase tracking-wider text-muted-foreground">
        1. Measurements & Dimensions
      </h3>
      <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
        {measurements.map((field) => (
                  <div class="calc-field" id={`${slug}-field-${field.id}`} hidden={!fieldVisible(field, model.fields)}>
                  <label class="block space-y-1.5" for={`${slug}-${field.id}`}>
            <span class="text-[13px] font-medium text-foreground flex items-center justify-between">
              <span>{field.label} {field.optional && <span class="text-xs text-muted-foreground font-normal">(optional)</span>}</span>
            </span>
            <div class="flex rounded-lg shadow-sm">
              {field.options ? (
                <select
                  id={`${slug}-${field.id}`}
                  name={field.id}
                  required={!field.optional}
                  aria-describedby={`${slug}-${field.id}-err${field.help ? ` ${slug}-${field.id}-help` : ""}`}
                  class="calc-input h-11 w-full rounded-lg border border-border bg-muted/40 px-3.5 text-[14px] text-foreground focus:border-ring focus:bg-background focus:outline-none focus:ring-2 focus:ring-ring/20 transition-all font-mono cursor-pointer"
                >
                  {field.options.map((opt) => (
                    <option value={opt.value} selected={opt.value === field.value}>
                      {opt.label}
                    </option>
                  ))}
                </select>
              ) : (
                <>
              <input
                id={`${slug}-${field.id}`}
                name={field.id}
                type="number"
                inputmode="decimal"
                step={field.integer ? "1" : "any"}
                min={field.min ?? 0}
                max={field.max}
                value={field.value ?? ""}
                placeholder={field.help ? field.label : ""}
                required={!field.optional}
                aria-describedby={`${slug}-${field.id}-err${field.help ? ` ${slug}-${field.id}-help` : ""}`}
                class="calc-input h-11 w-full rounded-l-lg border border-border bg-muted/40 px-3.5 text-[14px] text-foreground placeholder:text-muted-foreground/50 focus:border-ring focus:bg-background focus:outline-none focus:ring-2 focus:ring-ring/20 transition-all font-mono"
              />
              {field.units && field.units.length > 1 ? (
                <select
                  id={`${slug}-${field.id}-unit`}
                  aria-label={`${field.label} unit`}
                  name={`${field.id}_unit`}
                  class="calc-unit-select h-11 shrink-0 rounded-r-lg border border-l-0 border-border bg-muted px-3 text-[13px] font-medium text-foreground focus:outline-none focus:ring-2 focus:ring-ring/20 cursor-pointer"
                >
                  {field.units.map((u) => (
                    <option value={u} selected={u === field.unit}>
                      {unitLabels[u] ?? u}
                    </option>
                  ))}
                </select>
              ) : field.unit ? (
                <span class="flex h-11 shrink-0 items-center rounded-r-lg border border-l-0 border-border bg-muted px-3.5 text-[13px] font-medium text-muted-foreground select-none">
                  {unitLabels[field.unit] ?? field.unit}
                </span>
              ) : null}
                </>
              )}
            </div>
            {field.help && (
              <p id={`${slug}-${field.id}-help`} class="text-[11px] text-muted-foreground leading-normal">{field.help}</p>
            )}
            <span id={`${slug}-${field.id}-err`} class="hidden text-xs text-destructive font-medium" role="alert"></span>
          </label>
                    </div>
                  ))}
      </div>
    </div>

    {slug === "concrete-waste-calculator" && (
      <section class="concrete-waste-multipour rounded-lg border border-border bg-muted/20 p-4" hidden>
        <div class="flex flex-col gap-2 sm:flex-row sm:items-start sm:justify-between">
          <div>
            <h3 class="text-xs font-mono font-semibold uppercase tracking-wider text-foreground">Multi-pour schedule</h3>
            <p class="mt-1 text-[11px] leading-5 text-muted-foreground">Combine rectangular pours, round piers/footings, and already-known volumes into one supplier order. The allowance is applied once to the combined net volume.</p>
          </div>
          <button type="button" class="multi-pour-add inline-flex h-9 items-center justify-center rounded-lg border border-border bg-background px-3 text-xs font-medium text-foreground hover:bg-muted/60 focus:outline-none focus-visible:ring-2 focus-visible:ring-ring">+ Add pour</button>
        </div>
        <div class="multi-pour-rows mt-4 space-y-3"></div>
        <div class="mt-4 flex flex-wrap items-center justify-between gap-2 rounded-lg border border-border bg-card px-3 py-2 text-xs">
          <span class="text-muted-foreground">Combined net concrete</span>
          <strong class="multi-pour-total font-mono text-foreground">—</strong>
        </div>
        <input id={`${slug}-multiPourVolume`} name="multiPourVolume" type="hidden" value="1" />
        <input id={`${slug}-multiPourCount`} name="multiPourCount" type="hidden" value="1" />
        <span id={`${slug}-multiPourVolume-err`} class="hidden text-xs text-destructive font-medium" role="alert"></span>
      </section>
    )}

    <!-- Section 2: Material & Assumptions (if any) -->
    {assumptions.length > 0 && (
      <details class="group rounded-lg border border-border bg-muted/20">
        <summary class="flex min-h-11 cursor-pointer list-none items-center justify-between gap-3 px-4 py-3 text-left focus:outline-none focus-visible:ring-2 focus-visible:ring-ring">
          <span>
            <span class="block text-xs font-mono font-semibold uppercase tracking-wider text-foreground">{slug === "concrete-waste-calculator" ? "Supplier & order settings" : "Advanced material assumptions"}</span>
            <span class="mt-0.5 block text-[11px] leading-4 text-muted-foreground">{slug === "concrete-waste-calculator" ? "Supplier increment, minimum, truck capacity, short-load rule, pour rate and bag yield." : "Waste, density, package yield and other editable material assumptions."}</span>
          </span>
          <span aria-hidden="true" class="text-muted-foreground transition-transform group-open:rotate-180">⌄</span>
        </summary>
        <div class="grid gap-4 border-t border-border px-4 py-4 sm:grid-cols-2 lg:grid-cols-3">
          {assumptions.map((field) => (
                    <div class="calc-field" id={`${slug}-field-${field.id}`} hidden={!fieldVisible(field, model.fields)}>
                    <label class="block space-y-1.5" for={`${slug}-${field.id}`}>
              <span class="text-[13px] font-medium text-foreground flex items-center justify-between">
                <span>{field.label} {field.optional && <span class="text-xs text-muted-foreground font-normal">(optional)</span>}</span>
              </span>
              <div class="flex rounded-lg shadow-sm">
                {field.options ? (
                  <select
                    id={`${slug}-${field.id}`}
                    name={field.id}
                    required={!field.optional}
                    aria-describedby={`${slug}-${field.id}-err${field.help ? ` ${slug}-${field.id}-help` : ""}`}
                    class="calc-input h-11 w-full rounded-lg border border-border bg-muted/40 px-3.5 text-[14px] text-foreground focus:border-ring focus:bg-background focus:outline-none focus:ring-2 focus:ring-ring/20 transition-all font-mono cursor-pointer"
                  >
                    {field.options.map((opt) => (
                      <option value={opt.value} selected={opt.value === field.value}>
                        {opt.label}
                      </option>
                    ))}
                  </select>
                ) : (
                  <>
                <input
                  id={`${slug}-${field.id}`}
                  name={field.id}
                  type="number"
                  inputmode="decimal"
                  step={field.integer ? "1" : "any"}
                  min={field.min ?? 0}
                  max={field.max}
                  value={field.value ?? ""}
                  placeholder={field.label}
                  required={!field.optional}
                  aria-describedby={`${slug}-${field.id}-err${field.help ? ` ${slug}-${field.id}-help` : ""}`}
                  class="calc-input h-11 w-full rounded-l-lg border border-border bg-muted/40 px-3.5 text-[14px] text-foreground placeholder:text-muted-foreground/50 focus:border-ring focus:bg-background focus:outline-none focus:ring-2 focus:ring-ring/20 transition-all font-mono"
                />
                {field.units && field.units.length > 1 ? (
                  <select
                    id={`${slug}-${field.id}-unit`}
                    aria-label={`${field.label} unit`}
                    name={`${field.id}_unit`}
                    class="calc-unit-select h-11 shrink-0 rounded-r-lg border border-l-0 border-border bg-muted px-3 text-[13px] font-medium text-foreground focus:outline-none focus:ring-2 focus:ring-ring/20 cursor-pointer"
                  >
                    {field.units.map((u) => (
                      <option value={u} selected={u === field.unit}>
                        {unitLabels[u] ?? u}
                      </option>
                    ))}
                  </select>
                ) : field.unit ? (
                  <span class="flex h-11 shrink-0 items-center rounded-r-lg border border-l-0 border-border bg-muted px-3.5 text-[13px] font-medium text-muted-foreground select-none">
                    {unitLabels[field.unit] ?? field.unit}
                  </span>
                ) : null}
                  </>
                )}
              </div>
              {field.help && (
                <p id={`${slug}-${field.id}-help`} class="text-[11px] text-muted-foreground leading-normal">{field.help}</p>
              )}
              <span id={`${slug}-${field.id}-err`} class="hidden text-xs text-destructive font-medium" role="alert"></span>
            </label>
                      </div>
                    ))}
        </div>
      </details>
    )}

    <!-- Section 3: Cost Estimation (if any) -->
    {costs.length > 0 && (
      <details class="group rounded-lg border border-border bg-muted/20">
        <summary class="flex min-h-11 cursor-pointer list-none items-center justify-between gap-3 px-4 py-3 text-left focus:outline-none focus-visible:ring-2 focus-visible:ring-ring">
          <span>
            <span class="block text-xs font-mono font-semibold uppercase tracking-wider text-foreground">Cost & project extras</span>
            <span class="mt-0.5 block text-[11px] leading-4 text-muted-foreground">Optional pricing and project-cost inputs. Leave defaults unchanged for a quantity-only estimate.</span>
          </span>
          <span aria-hidden="true" class="text-muted-foreground transition-transform group-open:rotate-180">⌄</span>
        </summary>
        <div class="grid gap-4 border-t border-border px-4 py-4 sm:grid-cols-2 lg:grid-cols-3">
          {costs.map((field) => (
                    <div class="calc-field" id={`${slug}-field-${field.id}`} hidden={!fieldVisible(field, model.fields)}>
                    <label class="block space-y-1.5" for={`${slug}-${field.id}`}>
              <span class="text-[13px] font-medium text-foreground flex items-center justify-between">
                <span>{field.label} {field.optional && <span class="text-xs text-muted-foreground font-normal">(optional)</span>}</span>
              </span>
              <div class="flex rounded-lg shadow-sm">
                {field.options ? (
                  <select
                    id={`${slug}-${field.id}`}
                    name={field.id}
                    required={!field.optional}
                    aria-describedby={`${slug}-${field.id}-err${field.help ? ` ${slug}-${field.id}-help` : ""}`}
                    class="calc-input h-11 w-full rounded-lg border border-border bg-muted/40 px-3.5 text-[14px] text-foreground focus:border-ring focus:bg-background focus:outline-none focus:ring-2 focus:ring-ring/20 transition-all font-mono cursor-pointer"
                  >
                    {field.options.map((opt) => (
                      <option value={opt.value} selected={opt.value === field.value}>
                        {opt.label}
                      </option>
                    ))}
                  </select>
                ) : (
                  <>
                <input
                  id={`${slug}-${field.id}`}
                  name={field.id}
                  type="number"
                  inputmode="decimal"
                  step="any"
                  min={field.min ?? 0}
                  max={field.max}
                  value={field.value ?? ""}
                  placeholder="0.00"
                  required={!field.optional}
                  aria-describedby={`${slug}-${field.id}-err${field.help ? ` ${slug}-${field.id}-help` : ""}`}
                  class="calc-input h-11 w-full rounded-l-lg border border-border bg-muted/40 px-3.5 text-[14px] text-foreground placeholder:text-muted-foreground/50 focus:border-ring focus:bg-background focus:outline-none focus:ring-2 focus:ring-ring/20 transition-all font-mono"
                />
                {field.units && field.units.length > 1 ? (
                  <select
                    id={`${slug}-${field.id}-unit`}
                    aria-label={`${field.label} unit`}
                    name={`${field.id}_unit`}
                    class="calc-unit-select h-11 shrink-0 rounded-r-lg border border-l-0 border-border bg-muted px-3 text-[13px] font-medium text-foreground focus:outline-none focus:ring-2 focus:ring-ring/20 cursor-pointer"
                  >
                    {field.units.map((u) => (
                      <option value={u} selected={u === field.unit}>
                        {unitLabels[u] ?? u}
                      </option>
                    ))}
                  </select>
                ) : field.unit ? (
                  <span class="flex h-11 shrink-0 items-center rounded-r-lg border border-l-0 border-border bg-muted px-3.5 text-[13px] font-medium text-muted-foreground select-none">
                    {unitLabels[field.unit] ?? field.unit}
                  </span>
                ) : null}
                  </>
                )}
              </div>
              {field.help && (
                <p id={`${slug}-${field.id}-help`} class="text-[11px] text-muted-foreground leading-normal">{field.help}</p>
              )}
              <span id={`${slug}-${field.id}-err`} class="hidden text-xs text-destructive font-medium" role="alert"></span>
            </label>
                      </div>
                    ))}
        </div>
      </details>
    )}

    <!-- Form Actions -->
    <div class="flex flex-wrap items-center justify-between gap-3 pt-4 border-t border-border">
      <div class="flex items-center gap-2">
        <button
          type="submit"
          class="calc-calc-btn inline-flex h-11 items-center justify-center rounded-lg bg-foreground px-5 text-[13px] font-medium text-background transition-opacity hover:opacity-90 focus:outline-none focus-visible:ring-2 focus-visible:ring-ring cursor-pointer"
        >
          Calculate
        </button>
        <button
          type="button"
          class="calc-reset-btn inline-flex h-11 items-center justify-center rounded-lg border border-border bg-background px-4 text-[13px] font-medium text-muted-foreground hover:bg-muted/60 hover:text-foreground transition-colors focus:outline-none focus-visible:ring-2 focus-visible:ring-ring cursor-pointer"
        >
          Reset
        </button>
      </div>
      <div class="flex items-center gap-2">
        <button
          type="button"
          aria-label="Copy Result"
          class="calc-copy-btn inline-flex h-11 items-center justify-center rounded-lg border border-border bg-background px-3.5 text-[13px] font-medium text-foreground hover:bg-muted/50 transition-colors gap-1.5 focus:outline-none focus-visible:ring-2 focus-visible:ring-ring cursor-pointer"
        >
          <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-copy shrink-0"><rect width="14" height="14" x="8" y="8" rx="2" ry="2"/><path d="M4 16c-1.1 0-2-.9-2-2V4c0-1.1.9-2 2-2h10c1.1 0 2 .9 2 2"/></svg>
          <span class="copy-status" role="status">Copy Result</span>
        </button>
        <button
          type="button"
          aria-label="Share this calculation"
          class="calc-share-btn inline-flex h-11 items-center justify-center rounded-lg border border-border bg-background px-3.5 text-[13px] font-medium text-foreground hover:bg-muted/50 transition-colors gap-1.5 focus:outline-none focus-visible:ring-2 focus-visible:ring-ring cursor-pointer"
        >
          <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="shrink-0"><circle cx="18" cy="5" r="3"/><circle cx="6" cy="12" r="3"/><circle cx="18" cy="19" r="3"/><path d="m8.6 13.5 6.8 4"/><path d="m15.4 6.5-6.8 4"/></svg>
          <span class="share-status" role="status">Share</span>
        </button>
        <button
          type="button"
          aria-label={slug === "concrete-waste-calculator" ? "Print or save calculation as PDF" : "Print calculation results"}
          class="calc-print-btn inline-flex h-11 items-center justify-center rounded-lg border border-border bg-background px-3.5 text-[13px] font-medium text-foreground hover:bg-muted/50 transition-colors gap-1.5 focus:outline-none focus-visible:ring-2 focus-visible:ring-ring cursor-pointer"
        >
          <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="shrink-0"><path d="M6 9V2h12v7"/><path d="M6 18H4a2 2 0 0 1-2-2v-5a2 2 0 0 1 2-2h16a2 2 0 0 1 2 2v5a2 2 0 0 1-2 2h-2"/><rect x="6" y="14" width="12" height="8"/></svg>
          <span>{slug === "concrete-waste-calculator" ? "Print / Save PDF" : "Print"}</span>
        </button>
        {slug === "concrete-waste-calculator" && (
          <button
            type="button"
            aria-label="Download concrete order plan PDF"
            class="calc-pdf-btn inline-flex h-11 items-center justify-center rounded-lg border border-border bg-background px-3.5 text-[13px] font-medium text-foreground hover:bg-muted/50 transition-colors gap-1.5 focus:outline-none focus-visible:ring-2 focus-visible:ring-ring cursor-pointer"
            disabled
          >
            <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="shrink-0"><path d="M12 3v12"/><path d="m7 10 5 5 5-5"/><path d="M5 21h14"/></svg>
            <span>Download PDF</span>
          </button>
        )}
      </div>
    </div>
  </form>

  {(diagramFields.length >= 2 || slug === "construction-material-cost-calculator") && (
    <div class="mt-6">
      {slug === "concrete-calculator"
        ? <ConcreteCalculatorDiagram />
        : slug === "concrete-volume-calculator"
          ? <ConcreteVolumeDiagram />
          : slug === "paint-calculator"
            ? <PaintCalculatorDiagram />
            : slug === "gravel-calculator"
              ? <GravelCalculatorDiagram />
              : slug === "gravel-weight-calculator"
                ? <GravelWeightCalculatorDiagram />
              : slug === "mulch-calculator"
                ? <MulchProjectDiagram />
                : slug === "framing-calculator"
                  ? <FramingCalculatorDiagram />
                : slug === "roofing-calculator"
                  ? <RoofingCalculatorDiagram />
                  : slug === "roofing-shingle-calculator"
                    ? <RoofingShingleCalculatorDiagram />
                  : slug === "roof-pitch-calculator"
                    ? <RoofPitchCalculatorDiagram />
                    : slug === "flooring-calculator"
                      ? <FlooringCalculatorDiagram />
                      : slug === "carpet-calculator"
                        ? <CarpetCalculatorDiagram />
                        : slug === "tile-calculator"
                          ? <TileCalculatorDiagram />
                          : slug === "drywall-calculator"
                            ? <DrywallCalculatorDiagram />
                            : slug === "concrete-slab-calculator"
                              ? <ConcreteSlabCalculatorDiagram />
                              : slug === "concrete-footing-calculator"
                                ? <ConcreteFootingCalculatorDiagram />
                              : slug === "slab-thickness-calculator"
                                ? <SlabThicknessCalculatorDiagram />
                              : slug === "fence-calculator"
                                ? <FenceCalculatorDiagram />
                                : slug === "deck-calculator"
                                  ? <DeckCalculatorDiagram />
                                  : slug === "paver-calculator"
                                    ? <PaverCalculatorDiagram />
                                    : slug === "asphalt-calculator"
                                      ? <AsphaltCalculatorDiagram />
                                      : slug === "asphalt-thickness-calculator"
                                        ? <AsphaltThicknessCalculatorDiagram />
                                        : slug === "parking-lot-calculator"
                                          ? <ParkingLotCalculatorDiagram />
                                          : slug === "parking-lot-cost-calculator"
                                            ? <ParkingLotCostCalculatorDiagram />
                                            : slug === "road-base-calculator"
                                              ? <RoadBaseCalculatorDiagram />
                                              : slug === "surface-area-calculator"
                                                ? <SurfaceAreaCalculatorDiagram />
                                                : slug === "construction-material-cost-calculator"
                                                  ? <ConstructionMaterialCostCalculatorDiagram />
                                      : slug === "brick-calculator"
                                        ? <BrickCalculatorDiagram />
                                        : slug === "concrete-block-calculator"
                                          ? <ConcreteBlockCalculatorDiagram />
                                          : slug === "rebar-calculator"
                                            ? <RebarCalculatorDiagram />
                                            : slug === "excavation-calculator"
                                              ? <ExcavationCalculatorDiagram />
                                              : slug === "earthwork-calculator"
                                                ? <EarthworkCalculatorDiagram />
                                                : <ProjectDiagram slug={slug} fields={diagramFields} />}
    </div>
  )}

  <section class="calc-print-summary hidden" aria-label="Printable estimate summary">
    <div class="border-b border-border pb-4">
      <p class="font-mono text-[11px] font-semibold uppercase tracking-wider text-muted-foreground">Calculator Street — Project Estimate</p>
      <h2 class="mt-1 text-xl font-semibold text-foreground">{resultTitle || "Construction estimate"}</h2>
      <p class="calc-print-generated mt-1 text-xs text-muted-foreground"></p>
    </div>
    <div class="mt-4">
      <h3 class="text-sm font-semibold text-foreground">Project inputs</h3>
      <dl class="calc-print-inputs mt-2 grid grid-cols-2 gap-x-6 gap-y-1 text-xs"></dl>
    </div>
    <p class="mt-4 border-t border-border pt-3 text-[11px] leading-5 text-muted-foreground">
      Planning estimate only. Confirm field measurements, supplier yields and prices before ordering. Structural requirements, code compliance and project-specific design remain outside this material estimate.
    </p>
  </section>

  <!-- Output Results Panel -->
  <p class="calc-status mt-4 text-sm text-muted-foreground" role="status" aria-live="polite"></p>
  <div class="calc-results-panel mt-6 space-y-5 rounded-xl border border-border/80 bg-muted/20 p-5 sm:p-6">
    <!-- Primary Output Hero Card -->
    <div class="rounded-xl border border-border bg-card p-5 shadow-xs">
      <span class="text-xs font-mono font-medium uppercase tracking-wider text-muted-foreground block result-hero-title">
        {resultTitle || "ESTIMATED QUANTITY"}
      </span>
      <div class="mt-2 flex flex-wrap items-baseline gap-2.5">
        <span class="result-primary text-3xl sm:text-4xl font-bold font-mono tracking-tight text-foreground">
          --
        </span>
        <span class="result-primary-unit text-base sm:text-lg font-medium text-muted-foreground font-mono">
        </span>
      </div>
      <p class="result-secondary mt-1.5 text-xs sm:text-sm text-muted-foreground font-mono">
        Enter dimensions above to calculate
      </p>
    </div>

    <!-- Secondary Result Metrics Grid -->
    <div class="result-rows-grid grid gap-3 sm:grid-cols-2 lg:grid-cols-3">
    </div>

    <details class="calc-estimate-worksheet rounded-lg border border-border bg-card p-4">
      <summary class="cursor-pointer select-none text-xs font-mono font-semibold uppercase tracking-wider text-foreground focus:outline-none focus-visible:ring-2 focus-visible:ring-ring">
        Quantity &amp; cost worksheet
      </summary>
      <p class="mt-2 text-xs leading-5 text-muted-foreground">
        A compact estimate table using only outputs this calculator actually computes. Whole-item rows stay rounded as shown above.
      </p>
      <div class="mt-3 overflow-x-auto" role="region" aria-label="Estimate worksheet" tabindex="0">
        <table class="w-full min-w-[420px] text-left text-xs">
          <thead class="border-b border-border text-muted-foreground">
            <tr><th scope="col" class="py-2 pr-4 font-medium">Item</th><th scope="col" class="py-2 pr-4 font-medium">Quantity</th><th scope="col" class="py-2 font-medium">Unit</th></tr>
          </thead>
          <tbody class="calc-estimate-worksheet-body divide-y divide-border"></tbody>
        </table>
      </div>
    </details>

    <!-- Step-by-Step Mathematical Derivation Card -->
    <div class="rounded-lg border border-border bg-card p-4 space-y-2.5">
      <div class="flex flex-col gap-2 sm:flex-row sm:items-start sm:justify-between">
        <span class="text-xs font-mono font-semibold uppercase tracking-wider text-foreground">
          Calculation Breakdown & Steps
        </span>
        <span class="text-[11px] font-mono text-muted-foreground">Formula: {model.formula}</span>
      </div>
      <ol class="result-steps-list list-decimal pl-5 space-y-1 text-xs text-muted-foreground font-mono leading-relaxed">
        <li>Enter values to see step-by-step substitution.</li>
      </ol>
      <ul class="result-notes-list list-disc pl-4 text-sm text-muted-foreground"></ul>
      {model.assumptions.length > 0 && (
        <div class="pt-2 border-t border-border/60 text-[11px] text-muted-foreground space-y-1">
          <p class="font-medium text-foreground">Engineering Assumptions:</p>
          <ul class="list-disc pl-4 space-y-0.5">
            {model.assumptions.map((a) => <li>{a}</li>)}
          </ul>
        </div>
      )}
    </div>
  </div>
</div>

<script>
  import { getModelForSlug } from "../../lib/calculator-registry";
  import { readInputs, fmt, unitLabels } from "../../lib/calculator-math";
  import type { Field } from "../../lib/calculator-types";

  function initCalculators() {
    const calcElements = document.querySelectorAll<HTMLElement>("[data-calculator-slug]");

    calcElements.forEach((root) => {
      const slug = root.dataset.calculatorSlug;
      if (!slug || root.dataset.initialized) return;
      const calculatorSlug = slug;
      root.dataset.initialized = 'true';

      const model = getModelForSlug(calculatorSlug);
      const form = root.querySelector<HTMLFormElement>(`#${slug}-form`);
      const primaryValEl = root.querySelector<HTMLElement>(".result-primary");
      const primaryUnitEl = root.querySelector<HTMLElement>(".result-primary-unit");
      const secondaryEl = root.querySelector<HTMLElement>(".result-secondary");
      const rowsGridEl = root.querySelector<HTMLElement>(".result-rows-grid");
      const stepsListEl = root.querySelector<HTMLElement>(".result-steps-list");
      const copyBtn = root.querySelector<HTMLButtonElement>(".calc-copy-btn");
      const copyStatus = root.querySelector<HTMLElement>(".copy-status");
      const shareBtn = root.querySelector<HTMLButtonElement>(".calc-share-btn");
      const shareStatus = root.querySelector<HTMLElement>(".share-status");
      const printBtn = root.querySelector<HTMLButtonElement>(".calc-print-btn");
      const pdfBtn = root.querySelector<HTMLButtonElement>(".calc-pdf-btn");
      const resetBtn = root.querySelector<HTMLButtonElement>(".calc-reset-btn");
      const status = root.querySelector<HTMLElement>('.calc-status');
      const notesList = root.querySelector<HTMLElement>('.result-notes-list');
      const printInputs = root.querySelector<HTMLElement>('.calc-print-inputs');
      const printGenerated = root.querySelector<HTMLElement>('.calc-print-generated');
      const worksheetBody = root.querySelector<HTMLTableSectionElement>('.calc-estimate-worksheet-body');

      if (!form || !primaryValEl || !rowsGridEl || !stepsListEl) return;
            const targetPrimaryValEl = primaryValEl;
            const targetRowsGridEl = rowsGridEl;
            const targetStepsListEl = stepsListEl;

            const multiPourPanel = root.querySelector<HTMLElement>(".concrete-waste-multipour");
            const multiPourRows = root.querySelector<HTMLElement>(".multi-pour-rows");
            const multiPourAdd = root.querySelector<HTMLButtonElement>(".multi-pour-add");
            const multiPourTotal = root.querySelector<HTMLElement>(".multi-pour-total");
            const multiPourVolume = form.querySelector<HTMLInputElement>(`#${slug}-multiPourVolume`);
            const multiPourCount = form.querySelector<HTMLInputElement>(`#${slug}-multiPourCount`);
            let multiPourSerial = 0;

            type MultiPourKind = "rect" | "round" | "known";
            type MultiPourState = {
              kind: MultiPourKind;
              a: string;
              aUnit: string;
              b: string;
              bUnit: string;
              c: string;
              cUnit: string;
              qty: string;
            };

            const defaultMultiPour = (): MultiPourState => ({
              kind: "rect",
              a: "10",
              aUnit: "ft",
              b: "10",
              bUnit: "ft",
              c: "4",
              cUnit: "in",
              qty: "1",
            });

            const lengthToFeet = (value: number, unit: string) =>
              unit === "in" ? value / 12
              : unit === "yd" ? value * 3
              : unit === "m" ? value / 0.3048
              : unit === "cm" ? value / 30.48
              : unit === "mm" ? value / 304.8
              : value;

            const volumeToFt3 = (value: number, unit: string) =>
              unit === "yd3" ? value * 27
              : unit === "m3" ? value / (0.3048 ** 3)
              : value;

            function multiPourStateFromCard(card: HTMLElement): MultiPourState {
              const kind = (card.querySelector<HTMLSelectElement>("[data-mp-kind]")?.value as MultiPourKind) || "rect";
              const groupSelector = kind === "round" ? "[data-mp-round]" : kind === "known" ? "[data-mp-known]" : "[data-mp-rect]";
              const read = (selector: string) => card.querySelector<HTMLInputElement | HTMLSelectElement>(`${groupSelector} ${selector}`)?.value ?? "";
              return {
                kind,
                a: read("[data-mp-a]"),
                aUnit: read("[data-mp-a-unit]") || (kind === "known" ? "yd3" : "ft"),
                b: read("[data-mp-b]"),
                bUnit: read("[data-mp-b-unit]") || "ft",
                c: read("[data-mp-c]"),
                cUnit: read("[data-mp-c-unit]") || "in",
                qty: card.querySelector<HTMLInputElement>("[data-mp-qty]")?.value || "1",
              };
            }

            function multiPourFt3(data: MultiPourState) {
              const a = Number(data.a);
              const b = Number(data.b);
              const c = Number(data.c);
              const qty = Number(data.qty);
              if (!Number.isFinite(a) || a <= 0 || !Number.isFinite(qty) || qty < 1 || !Number.isInteger(qty)) return Number.NaN;
              if (data.kind === "known") return volumeToFt3(a, data.aUnit) * qty;
              if (!Number.isFinite(b) || b <= 0) return Number.NaN;
              if (data.kind === "round") {
                const diameter = lengthToFeet(a, data.aUnit);
                const depth = lengthToFeet(b, data.bUnit);
                return Math.PI * (diameter / 2) ** 2 * depth * qty;
              }
              if (!Number.isFinite(c) || c <= 0) return Number.NaN;
              return lengthToFeet(a, data.aUnit) * lengthToFeet(b, data.bUnit) * lengthToFeet(c, data.cUnit) * qty;
            }

            function updateMultiPourCard(card: HTMLElement) {
              const data = multiPourStateFromCard(card);
              card.querySelectorAll<HTMLElement>("[data-mp-rect]").forEach(el => { el.hidden = data.kind !== "rect"; });
              card.querySelectorAll<HTMLElement>("[data-mp-round]").forEach(el => { el.hidden = data.kind !== "round"; });
              card.querySelectorAll<HTMLElement>("[data-mp-known]").forEach(el => { el.hidden = data.kind !== "known"; });
              const subtotal = card.querySelector<HTMLElement>("[data-mp-subtotal]");
              const ft3 = multiPourFt3(data);
              if (subtotal) subtotal.textContent = Number.isFinite(ft3) ? `${fmt(ft3 / 27)} yd³` : "Check inputs";
            }

            function syncMultiPourSchedule(dispatch = true) {
              if (!multiPourRows || !multiPourVolume || !multiPourCount) return;
              const cards = [...multiPourRows.querySelectorAll<HTMLElement>("[data-mp-row]")];
              const schedule = cards.map(multiPourStateFromCard);
              const volumes = schedule.map(multiPourFt3);
              const valid = schedule.length > 0 && volumes.every(v => Number.isFinite(v) && v > 0);
              const totalFt3 = valid ? volumes.reduce((sum, value) => sum + value, 0) : Number.NaN;
              multiPourVolume.value = valid ? String(totalFt3) : "";
              multiPourCount.value = String(schedule.length || 1);
              root.dataset.multiPourSchedule = JSON.stringify(schedule);
              if (multiPourTotal) multiPourTotal.textContent = valid ? `${fmt(totalFt3 / 27)} yd³ · ${fmt(totalFt3 / (1 / 0.3048) ** 3)} m³` : "Complete every visible pour";
              cards.forEach(updateMultiPourCard);
              if (dispatch) multiPourVolume.dispatchEvent(new Event("input", { bubbles: true }));
            }

            function createMultiPourCard(data: MultiPourState = defaultMultiPour()) {
              if (!multiPourRows) return;
              const index = ++multiPourSerial;
              const card = document.createElement("div");
              card.dataset.mpRow = "true";
              card.className = "rounded-lg border border-border bg-card p-3";
              card.innerHTML = `
                <div class="flex flex-wrap items-center justify-between gap-2">
                  <label class="text-xs font-medium text-foreground" for="${slug}-mp-kind-${index}">Pour type</label>
                  <div class="flex items-center gap-2">
                    <span data-mp-subtotal class="font-mono text-xs text-muted-foreground">—</span>
                    <button type="button" data-mp-remove class="rounded-md border border-border px-2 py-1 text-[11px] text-muted-foreground hover:text-foreground">Remove</button>
                  </div>
                </div>
                <select id="${slug}-mp-kind-${index}" data-mp-kind class="mt-2 h-10 w-full rounded-lg border border-border bg-muted/30 px-3 text-sm text-foreground">
                  <option value="rect">Rectangular slab / wall / footing</option>
                  <option value="round">Round pier / footing</option>
                  <option value="known">Known net volume</option>
                </select>
                <div class="mt-3 grid gap-3 sm:grid-cols-2 lg:grid-cols-4">
                  <label data-mp-rect class="text-[11px] text-muted-foreground">Length
                    <span class="mt-1 flex"><input data-mp-a type="number" step="any" min="0" class="h-10 min-w-0 flex-1 rounded-l-lg border border-border bg-muted/30 px-2 font-mono text-sm text-foreground"><select data-mp-a-unit class="h-10 rounded-r-lg border border-l-0 border-border bg-muted px-2 text-xs"><option>ft</option><option>in</option><option>yd</option><option>m</option><option>cm</option><option>mm</option></select></span>
                  </label>
                  <label data-mp-rect class="text-[11px] text-muted-foreground">Width
                    <span class="mt-1 flex"><input data-mp-b type="number" step="any" min="0" class="h-10 min-w-0 flex-1 rounded-l-lg border border-border bg-muted/30 px-2 font-mono text-sm text-foreground"><select data-mp-b-unit class="h-10 rounded-r-lg border border-l-0 border-border bg-muted px-2 text-xs"><option>ft</option><option>in</option><option>yd</option><option>m</option><option>cm</option><option>mm</option></select></span>
                  </label>
                  <label data-mp-rect class="text-[11px] text-muted-foreground">Thickness / depth
                    <span class="mt-1 flex"><input data-mp-c type="number" step="any" min="0" class="h-10 min-w-0 flex-1 rounded-l-lg border border-border bg-muted/30 px-2 font-mono text-sm text-foreground"><select data-mp-c-unit class="h-10 rounded-r-lg border border-l-0 border-border bg-muted px-2 text-xs"><option>in</option><option>ft</option><option>yd</option><option>m</option><option>cm</option><option>mm</option></select></span>
                  </label>

                  <label data-mp-round hidden class="text-[11px] text-muted-foreground">Diameter
                    <span class="mt-1 flex"><input data-mp-a type="number" step="any" min="0" class="h-10 min-w-0 flex-1 rounded-l-lg border border-border bg-muted/30 px-2 font-mono text-sm text-foreground"><select data-mp-a-unit class="h-10 rounded-r-lg border border-l-0 border-border bg-muted px-2 text-xs"><option>in</option><option>ft</option><option>yd</option><option>m</option><option>cm</option><option>mm</option></select></span>
                  </label>
                  <label data-mp-round hidden class="text-[11px] text-muted-foreground">Depth / height
                    <span class="mt-1 flex"><input data-mp-b type="number" step="any" min="0" class="h-10 min-w-0 flex-1 rounded-l-lg border border-border bg-muted/30 px-2 font-mono text-sm text-foreground"><select data-mp-b-unit class="h-10 rounded-r-lg border border-l-0 border-border bg-muted px-2 text-xs"><option>ft</option><option>in</option><option>yd</option><option>m</option><option>cm</option><option>mm</option></select></span>
                  </label>

                  <label data-mp-known hidden class="text-[11px] text-muted-foreground">Known volume
                    <span class="mt-1 flex"><input data-mp-a type="number" step="any" min="0" class="h-10 min-w-0 flex-1 rounded-l-lg border border-border bg-muted/30 px-2 font-mono text-sm text-foreground"><select data-mp-a-unit class="h-10 rounded-r-lg border border-l-0 border-border bg-muted px-2 text-xs"><option value="yd3">yd³</option><option value="ft3">ft³</option><option value="m3">m³</option></select></span>
                  </label>

                  <label class="text-[11px] text-muted-foreground">Quantity
                    <input data-mp-qty type="number" step="1" min="1" max="1000000" class="mt-1 h-10 w-full rounded-lg border border-border bg-muted/30 px-2 font-mono text-sm text-foreground">
                  </label>
                </div>
              `;

              const kind = card.querySelector<HTMLSelectElement>("[data-mp-kind]");
              if (kind) kind.value = data.kind;

              const assignVisibleGroup = (selector: string, key: "a" | "b" | "c", unitKey: "aUnit" | "bUnit" | "cUnit") => {
                const groups = [...card.querySelectorAll<HTMLElement>(selector)];
                groups.forEach(group => {
                  const input = group.querySelector<HTMLInputElement>(`[data-mp-${key}]`);
                  const unit = group.querySelector<HTMLSelectElement>(`[data-mp-${key}-unit]`);
                  if (input) input.value = data[key];
                  if (unit && [...unit.options].some(opt => opt.value === data[unitKey])) unit.value = data[unitKey];
                });
              };
              assignVisibleGroup("[data-mp-rect]", "a", "aUnit");
              assignVisibleGroup("[data-mp-rect]", "b", "bUnit");
              assignVisibleGroup("[data-mp-rect]", "c", "cUnit");
              assignVisibleGroup("[data-mp-round]", "a", "aUnit");
              assignVisibleGroup("[data-mp-round]", "b", "bUnit");
              assignVisibleGroup("[data-mp-known]", "a", "aUnit");
              const qty = card.querySelector<HTMLInputElement>("[data-mp-qty]");
              if (qty) qty.value = data.qty;

              card.addEventListener("input", () => syncMultiPourSchedule());
              card.addEventListener("change", () => {
                updateMultiPourCard(card);
                syncMultiPourSchedule();
              });
              card.querySelector<HTMLButtonElement>("[data-mp-remove]")?.addEventListener("click", () => {
                const count = multiPourRows.querySelectorAll("[data-mp-row]").length;
                if (count <= 1) return;
                card.remove();
                syncMultiPourSchedule();
              });

              multiPourRows.appendChild(card);
              updateMultiPourCard(card);
            }

            function resetMultiPourSchedule(dispatch = false) {
              if (!multiPourRows) return;
              multiPourRows.replaceChildren();
              createMultiPourCard(defaultMultiPour());
              syncMultiPourSchedule(dispatch);
            }

            function hydrateMultiPourSchedule() {
              if (!multiPourRows) return;
              const params = new URLSearchParams(window.location.search);
              if (params.get("cs_calc") !== slug) return;
              const encoded = params.get("cs_pours");
              if (!encoded) return;
              try {
                const parsed = JSON.parse(encoded);
                if (!Array.isArray(parsed) || parsed.length < 1 || parsed.length > 20) return;
                const clean = parsed
                  .filter((item): item is MultiPourState => item && ["rect", "round", "known"].includes(item.kind))
                  .map(item => ({
                    kind: item.kind,
                    a: String(item.a ?? ""),
                    aUnit: String(item.aUnit ?? (item.kind === "known" ? "yd3" : "ft")),
                    b: String(item.b ?? ""),
                    bUnit: String(item.bUnit ?? "ft"),
                    c: String(item.c ?? ""),
                    cUnit: String(item.cUnit ?? "in"),
                    qty: String(item.qty ?? "1"),
                  }));
                if (!clean.length) return;
                multiPourRows.replaceChildren();
                clean.forEach(createMultiPourCard);
                syncMultiPourSchedule(false);
              } catch {
                // Ignore malformed shared schedules; the normal calculator validation remains authoritative.
              }
            }

            function multiPourInputLines() {
              if (!multiPourRows) return [] as string[];
              return [...multiPourRows.querySelectorAll<HTMLElement>("[data-mp-row]")].map((card, index) => {
                const d = multiPourStateFromCard(card);
                const subtotal = multiPourFt3(d);
                if (d.kind === "known") return `Pour ${index + 1}: known ${d.a} ${d.aUnit} × ${d.qty} = ${fmt(subtotal / 27)} yd³`;
                if (d.kind === "round") return `Pour ${index + 1}: round Ø ${d.a} ${d.aUnit} × ${d.b} ${d.bUnit} × ${d.qty} = ${fmt(subtotal / 27)} yd³`;
                return `Pour ${index + 1}: ${d.a} ${d.aUnit} × ${d.b} ${d.bUnit} × ${d.c} ${d.cUnit} × ${d.qty} = ${fmt(subtotal / 27)} yd³`;
              });
            }

            multiPourAdd?.addEventListener("click", () => {
              if (!multiPourRows || multiPourRows.querySelectorAll("[data-mp-row]").length >= 20) return;
              createMultiPourCard(defaultMultiPour());
              syncMultiPourSchedule();
            });

            // Mode-gated field visibility: fields hidden by visibleWhen resolve to
            // their default value so calculations stay valid in every mode.
            function readControlValues() {
              const state: Record<string, number> = {};
              model.fields.forEach((f) => {
                const el = form?.querySelector<HTMLInputElement>(`#${slug}-${f.id}`);
                const raw = el?.value ?? String(f.value ?? '');
                state[f.id] = raw === '' ? Number.NaN : Number(raw);
              });
              return state;
            }
            function fieldVisible(f: Field, state: Record<string, number>) {
              if (!f.visibleWhen) return true;
              const ctrl = state[f.visibleWhen.field];
              if (f.visibleWhen.equals !== undefined) return ctrl === f.visibleWhen.equals;
              return (f.visibleWhen.in ?? []).includes(ctrl);
            }
            function updateVisibility() {
              const state = readControlValues();
              model.fields.forEach((f) => {
                if (!f.visibleWhen) return;
                const wrap = root.querySelector<HTMLElement>(`#${slug}-field-${f.id}`);
                if (wrap) wrap.hidden = !fieldVisible(f, state);
              });
              if (multiPourPanel) multiPourPanel.hidden = Math.round(state.wasteMode) !== 4;
            }

            function hasCompleteVisibleRequiredInputs() {
              const state = readControlValues();
              return model.fields.every((field) => {
                if (field.optional || !fieldVisible(field, state)) return true;
                const control = form?.querySelector<HTMLInputElement | HTMLSelectElement>(`#${slug}-${field.id}`);
                return Boolean(control && control.value.trim() !== "");
              });
            }

            function showAwaitingInput() {
              delete root.dataset.lastCalculated;
              if (copyBtn) copyBtn.disabled = true;
              if (pdfBtn) pdfBtn.disabled = true;
              targetPrimaryValEl.textContent = '--';
              if (primaryUnitEl) primaryUnitEl.textContent = '';
              if (secondaryEl) secondaryEl.textContent = 'Enter the required values above to calculate';
              targetRowsGridEl.replaceChildren();
              targetStepsListEl.replaceChildren();
              const li = document.createElement('li');
              li.textContent = 'Complete the required fields to see the calculation breakdown.';
              targetStepsListEl.appendChild(li);
              notesList?.replaceChildren();
              worksheetBody?.replaceChildren();
              if (status) status.textContent = '';
            }

            function recalculateIfReady() {
              updateVisibility();
              if (hasCompleteVisibleRequiredInputs()) calculate();
              else showAwaitingInput();
            }

            const sharedParam = (id: string) => `cs_${id}`;
            function hydrateSharedState() {
              const params = new URLSearchParams(window.location.search);
              if (params.get("cs_calc") !== slug) return;
              model.fields.forEach((field) => {
                const raw = params.get(sharedParam(field.id));
                const control = form?.querySelector<HTMLInputElement | HTMLSelectElement>(`#${slug}-${field.id}`);
                if (raw !== null && control) {
                  const numeric = Number(raw);
                  const matchesOption = !field.options || field.options.some(opt => opt.value === numeric);
                  const inRange = Number.isFinite(numeric)
                    && (field.min === undefined || numeric >= field.min)
                    && (field.max === undefined || numeric <= field.max)
                    && (!field.integer || Number.isInteger(numeric));
                  if (matchesOption && inRange) control.value = raw;
                }
                const unit = params.get(sharedParam(`${field.id}_unit`));
                const unitSelect = form?.querySelector<HTMLSelectElement>(`#${slug}-${field.id}-unit`);
                if (unit && unitSelect && field.units?.includes(unit)) unitSelect.value = unit;
              });
            }

            function buildShareUrl() {
              const url = new URL(window.location.href);
              url.search = "";
              url.searchParams.set("cs_calc", calculatorSlug);
              model.fields.forEach((field) => {
                const control = form?.querySelector<HTMLInputElement | HTMLSelectElement>(`#${slug}-${field.id}`);
                if (control && control.value !== "") url.searchParams.set(sharedParam(field.id), control.value);
                const unitSelect = form?.querySelector<HTMLSelectElement>(`#${slug}-${field.id}-unit`);
                if (unitSelect?.value) url.searchParams.set(sharedParam(`${field.id}_unit`), unitSelect.value);
              });
              const mode = Number(form?.querySelector<HTMLSelectElement>(`#${slug}-wasteMode`)?.value);
              if (calculatorSlug === "concrete-waste-calculator" && mode === 4 && root.dataset.multiPourSchedule) {
                url.searchParams.set("cs_pours", root.dataset.multiPourSchedule);
              }
              return url;
            }

            function clearSharedStateFromUrl() {
              const url = new URL(window.location.href);
              if (url.searchParams.get("cs_calc") !== slug) return;
              [...url.searchParams.keys()].filter(key => key === "cs_calc" || key.startsWith("cs_")).forEach(key => url.searchParams.delete(key));
              history.replaceState(history.state, "", url.pathname + (url.search ? url.search : "") + url.hash);
            }

            function calculate(focusError = false) {
              const rawInputs: Record<string, string> = {};
              const rawUnits: Record<string, string> = {};

              // Clear previous field errors
              root.querySelectorAll<HTMLElement>("[role='alert']").forEach((el) => {
                el.classList.add("hidden");
                el.textContent = "";
              });
              form?.querySelectorAll('[aria-invalid]').forEach(el => el.removeAttribute('aria-invalid'));

              const state = readControlValues();

              // Collect all inputs
              model.fields.forEach((field) => {
                const inputEl = form?.querySelector<HTMLInputElement>(`#${slug}-${field.id}`);
                if (inputEl) {
                                  if (field.visibleWhen && !fieldVisible(field, state)) {
                                    // Hidden in the current mode: use the field default so the
                                    // calculation is identical to leaving it untouched.
                                    rawInputs[field.id] = field.optional ? '' : (field.value !== undefined ? String(field.value) : String(field.min ?? 0));
                                  } else {
                                    rawInputs[field.id] = inputEl.value;
                                  }
                                }
                const unitSelect = form?.querySelector<HTMLSelectElement>(`#${slug}-${field.id}-unit`);
                if (unitSelect) {
                  rawUnits[field.id] = unitSelect.value;
                } else if (field.unit) {
                  rawUnits[field.id] = field.unit;
                }
              });

        try {
          const parsed = readInputs(model.fields, rawInputs, rawUnits);
          const result = model.calculate(parsed, rawUnits);
          if (status) status.textContent = 'Results updated.';
          if (copyBtn) copyBtn.disabled = false;
          if (pdfBtn) pdfBtn.disabled = false;
          if (notesList) {
            notesList.replaceChildren(...result.notes.map(note => {
              const li = document.createElement('li');
              li.textContent = note;
              return li;
            }));
          }

          if (!result.rows || result.rows.length === 0) return;

          const primaryRow = result.rows[0];
          const remainingRows = result.rows.slice(1);

          // Keep ratio-style results visually atomic (for example 6:12 rather than 6 :12).
          const primaryUnit = unitLabels[primaryRow.unit] ?? primaryRow.unit;
          if (primaryRow.unit === ':12') {
            targetPrimaryValEl.textContent = `${fmt(primaryRow.value)}:12`;
            if (primaryUnitEl) primaryUnitEl.textContent = '';
          } else {
            targetPrimaryValEl.textContent = fmt(primaryRow.value);
            if (primaryUnitEl) primaryUnitEl.textContent = primaryUnit;
          }
          if (secondaryEl) {
            secondaryEl.textContent = primaryRow.label;
          }

          // Update secondary rows grid
          targetRowsGridEl.innerHTML = "";
          remainingRows.forEach((r) => {
            const card = document.createElement("div");
            card.className = "rounded-lg border border-border bg-card p-3 shadow-xs";
            card.innerHTML = `
              <p class="text-[11px] font-mono text-muted-foreground break-words">${r.label}</p>
              <p class="text-lg font-bold font-mono text-foreground mt-0.5">${fmt(r.value)} <span class="text-xs font-normal text-muted-foreground">${unitLabels[r.unit] ?? r.unit}</span></p>
            `;
            targetRowsGridEl.appendChild(card);
          });

          // Update steps
          targetStepsListEl.innerHTML = "";
          result.steps.forEach((s) => {
            const li = document.createElement("li");
            li.textContent = s;
            targetStepsListEl.appendChild(li);
          });

          let inputLines = model.fields
            .filter((field) => !["multiPourVolume", "multiPourCount"].includes(field.id))
            .filter((field) => !field.visibleWhen || fieldVisible(field, state))
            .map((field) => {
              const control = form?.querySelector<HTMLInputElement | HTMLSelectElement>(`#${slug}-${field.id}`);
              if (!control || control.value === "") return null;
              const numericValue = Number(control.value);
              const optionLabel = field.options?.find((option) => option.value === numericValue)?.label;
              const unitSelect = form?.querySelector<HTMLSelectElement>(`#${slug}-${field.id}-unit`);
              const displayUnit = optionLabel ? "" : (unitLabels[unitSelect?.value ?? field.unit ?? ""] ?? unitSelect?.value ?? field.unit ?? "");
              return `${field.label}: ${optionLabel ?? control.value}${displayUnit ? ` ${displayUnit}` : ""}`;
            })
            .filter((line): line is string => Boolean(line));
          if (calculatorSlug === "concrete-waste-calculator" && Math.round(state.wasteMode) === 4) {
            inputLines = [...inputLines, ...multiPourInputLines()];
          }

          if (worksheetBody) {
            worksheetBody.replaceChildren(...result.rows.map((row) => {
              const tr = document.createElement("tr");
              const label = document.createElement("th");
              label.scope = "row";
              label.className = "py-2 pr-4 font-normal text-muted-foreground";
              label.textContent = row.label;
              const qty = document.createElement("td");
              qty.className = "py-2 pr-4 font-mono font-medium text-foreground tabular-nums";
              qty.textContent = fmt(row.value);
              const unit = document.createElement("td");
              unit.className = "py-2 font-mono text-muted-foreground";
              unit.textContent = unitLabels[row.unit] ?? row.unit;
              tr.append(label, qty, unit);
              return tr;
            }));
          }

          // Copy produces a self-contained estimate rather than a bare result list.
          root.dataset.lastCalculated = [
            document.querySelector("h1")?.textContent?.trim() ?? "Construction estimate",
            "",
            "Inputs",
            ...inputLines,
            "",
            "Results",
            ...result.rows.map(r => `${r.label}: ${fmt(r.value)} ${unitLabels[r.unit] ?? r.unit}`),
          ].join('\n');

          if (printInputs) {
            printInputs.replaceChildren(...inputLines.map((line) => {
              const [label, ...valueParts] = line.split(": ");
              const wrap = document.createElement("div");
              wrap.className = "contents";
              const dt = document.createElement("dt");
              dt.className = "text-muted-foreground";
              dt.textContent = label;
              const dd = document.createElement("dd");
              dd.className = "font-medium text-foreground";
              dd.textContent = valueParts.join(": ");
              wrap.append(dt, dd);
              return wrap;
            }));
          }
        } catch (err: any) {
          delete root.dataset.lastCalculated;
          if (copyBtn) copyBtn.disabled = true;
          if (pdfBtn) pdfBtn.disabled = true;
          targetPrimaryValEl.textContent = '—';
          if (primaryUnitEl) primaryUnitEl.textContent = '';
          if (secondaryEl) secondaryEl.textContent = 'Check the inputs to calculate a new result.';
          targetRowsGridEl.replaceChildren();
          targetStepsListEl.replaceChildren();
          notesList?.replaceChildren();
          if (status) status.textContent = err.message || 'Unable to calculate. Check your inputs.';
          if (err.field) {
            const input = form?.querySelector<HTMLInputElement>(`#${slug}-${err.field}`);
            input?.setAttribute('aria-invalid', 'true');
            if (focusError) input?.focus();
            const errEl = root.querySelector<HTMLElement>(`#${slug}-${err.field}-err`);
            if (errEl) {
              errEl.textContent = err.message;
              errEl.classList.remove("hidden");
            }
          }
        }
      }

      // Live calculation on input change
            form.addEventListener("input", recalculateIfReady);
            form.addEventListener("change", recalculateIfReady);
            form.addEventListener('submit', event => { event.preventDefault(); updateVisibility(); calculate(true); });

            // Reset handler
            resetBtn?.addEventListener("click", () => {
              model.fields.forEach((field) => {
                const inputEl = form.querySelector<HTMLInputElement>(`#${slug}-${field.id}`);
                if (inputEl) {
                  inputEl.value = field.value !== undefined ? String(field.value) : "";
                }
                const unitSelect = form.querySelector<HTMLSelectElement>(`#${slug}-${field.id}-unit`);
                if (unitSelect && field.unit) {
                  unitSelect.value = field.unit;
                }
              });
              clearSharedStateFromUrl();
              resetMultiPourSchedule(false);
              recalculateIfReady();
              // Programmatic reset does not emit native input/change events.
              // Reuse the state-restored event so live diagrams immediately
              // re-read the reset defaults instead of showing stale geometry.
              root.dispatchEvent(new CustomEvent("calculator-state-restored"));
            });

      // Copy handler
      copyBtn?.addEventListener("click", async () => {
        const textToCopy = root.dataset.lastCalculated;
        if (!textToCopy) return;
        try {
          await navigator.clipboard.writeText(textToCopy);
          if (copyStatus) {
            copyStatus.textContent = "Copied!";
            setTimeout(() => {
              copyStatus.textContent = "Copy Result";
            }, 2000);
          }
        } catch {
          if (copyStatus) copyStatus.textContent = 'Copy unavailable';
          if (status) status.textContent = 'Clipboard access was unavailable. Select and copy the displayed results manually.';
        }
      });

      shareBtn?.addEventListener("click", async () => {
        const url = buildShareUrl();
        try {
          if (navigator.share) {
            await navigator.share({ title: document.title, url: url.toString() });
            if (shareStatus) shareStatus.textContent = "Shared";
          } else {
            await navigator.clipboard.writeText(url.toString());
            if (shareStatus) shareStatus.textContent = "Link copied";
          }
          setTimeout(() => { if (shareStatus) shareStatus.textContent = "Share"; }, 2000);
        } catch (err: any) {
          if (err?.name !== "AbortError") {
            if (shareStatus) shareStatus.textContent = "Share unavailable";
            if (status) status.textContent = "Sharing was unavailable. You can still copy the displayed result.";
          }
        }
      });

      function pdfSafeText(value: string) {
        return value
          .replaceAll("³", "^3")
          .replaceAll("²", "^2")
          .replaceAll("×", "x")
          .replaceAll("÷", "/")
          .replace(/[–—]/g, "-")
          .replace(/[“”]/g, '"')
          .replace(/[‘’]/g, "'")
          .normalize("NFKD")
          .replace(/[^\x20-\x7E\n]/g, "");
      }

      function wrapPdfText(text: string, width = 88) {
        const output: string[] = [];
        pdfSafeText(text).split("\n").forEach(raw => {
          if (!raw) { output.push(""); return; }
          const words = raw.split(/\s+/);
          let line = "";
          words.forEach(word => {
            const next = line ? `${line} ${word}` : word;
            if (next.length > width && line) {
              output.push(line);
              line = word;
            } else {
              line = next;
            }
          });
          if (line) output.push(line);
        });
        return output;
      }

      function buildSimplePdf(text: string) {
        const lines = wrapPdfText(text);
        const perPage = 48;
        const pages = Array.from({ length: Math.max(1, Math.ceil(lines.length / perPage)) }, (_, index) =>
          lines.slice(index * perPage, (index + 1) * perPage)
        );
        const objectCount = 3 + pages.length * 2;
        const objects: string[] = Array(objectCount + 1).fill("");
        const pageIds = pages.map((_, index) => 4 + index * 2);
        objects[1] = "<< /Type /Catalog /Pages 2 0 R >>";
        objects[2] = `<< /Type /Pages /Count ${pages.length} /Kids [${pageIds.map(id => `${id} 0 R`).join(" ")}] >>`;
        objects[3] = "<< /Type /Font /Subtype /Type1 /BaseFont /Helvetica >>";

        const escapePdf = (line: string) => line.replace(/\\/g, "\\\\").replace(/\(/g, "\\(").replace(/\)/g, "\\)");
        pages.forEach((pageLines, index) => {
          const pageId = 4 + index * 2;
          const contentId = pageId + 1;
          objects[pageId] = `<< /Type /Page /Parent 2 0 R /MediaBox [0 0 612 792] /Resources << /Font << /F1 3 0 R >> >> /Contents ${contentId} 0 R >>`;
          const body = [
            "BT",
            "/F1 10 Tf",
            "48 744 Td",
            "13 TL",
            ...pageLines.flatMap((line, lineIndex) => lineIndex === 0 ? [`(${escapePdf(line)}) Tj`] : ["T*", `(${escapePdf(line)}) Tj`]),
            "ET",
          ].join("\n");
          objects[contentId] = `<< /Length ${body.length} >>\nstream\n${body}\nendstream`;
        });

        let pdf = "%PDF-1.4\n";
        const offsets: number[] = Array(objectCount + 1).fill(0);
        for (let id = 1; id <= objectCount; id += 1) {
          offsets[id] = pdf.length;
          pdf += `${id} 0 obj\n${objects[id]}\nendobj\n`;
        }
        const xref = pdf.length;
        pdf += `xref\n0 ${objectCount + 1}\n0000000000 65535 f \n`;
        for (let id = 1; id <= objectCount; id += 1) {
          pdf += `${String(offsets[id]).padStart(10, "0")} 00000 n \n`;
        }
        pdf += `trailer\n<< /Size ${objectCount + 1} /Root 1 0 R >>\nstartxref\n${xref}\n%%EOF`;
        return new Blob([pdf], { type: "application/pdf" });
      }

      pdfBtn?.addEventListener("click", () => {
        const estimate = root.dataset.lastCalculated;
        if (!estimate) {
          if (status) status.textContent = "Complete the required inputs before downloading a PDF.";
          return;
        }
        const generated = new Intl.DateTimeFormat(undefined, { dateStyle: "medium", timeStyle: "short" }).format(new Date());
        const blob = buildSimplePdf(`${estimate}\n\nGenerated: ${generated}\nCalculatorSt planning estimate - confirm supplier quote and project requirements before ordering.`);
        const href = URL.createObjectURL(blob);
        const link = document.createElement("a");
        link.href = href;
        link.download = "calculatorst-concrete-waste-order-plan.pdf";
        document.body.appendChild(link);
        link.click();
        link.remove();
        setTimeout(() => URL.revokeObjectURL(href), 1000);
        if (status) status.textContent = "PDF order plan downloaded.";
      });

            printBtn?.addEventListener("click", () => {
        if (!root.dataset.lastCalculated) {
          if (status) status.textContent = "Complete the required inputs before printing an estimate.";
          return;
        }
        if (printGenerated) {
          printGenerated.textContent = `Generated ${new Intl.DateTimeFormat(undefined, { dateStyle: "medium", timeStyle: "short" }).format(new Date())}`;
        }
        root.dataset.printing = "true";
        document.body.classList.add("calc-print-mode");
        window.print();
        document.body.classList.remove("calc-print-mode");
        delete root.dataset.printing;
      });

      // Restore a calculation from a shared URL before the first render.
            resetMultiPourSchedule(false);
            hydrateSharedState();
            hydrateMultiPourSchedule();
            recalculateIfReady();
            root.dispatchEvent(new CustomEvent("calculator-state-restored"));
    });
  }

  // Initialize on load and on Astro page transitions
  initCalculators();
  document.addEventListener("astro:page-load", initCalculators);
</script>


<style is:global>
  @media print {
    body.calc-print-mode * {
      visibility: hidden !important;
    }

    body.calc-print-mode [data-calculator-slug][data-printing="true"],
    body.calc-print-mode [data-calculator-slug][data-printing="true"] * {
      visibility: visible !important;
    }

    body.calc-print-mode [data-calculator-slug][data-printing="true"] {
      position: absolute !important;
      inset: 0 auto auto 0 !important;
      width: 100% !important;
      border: 0 !important;
      box-shadow: none !important;
      padding: 0 !important;
    }

    body.calc-print-mode [data-calculator-slug][data-printing="true"] form,
    body.calc-print-mode [data-calculator-slug][data-printing="true"] .calc-status {
      display: none !important;
    }

    body.calc-print-mode [data-calculator-slug][data-printing="true"] .calc-print-summary {
      display: block !important;
      margin-bottom: 1.25rem !important;
    }

    body.calc-print-mode [data-calculator-slug][data-printing="true"] .calc-estimate-worksheet {
      display: block !important;
    }

    body.calc-print-mode [data-calculator-slug][data-printing="true"] .calc-estimate-worksheet > summary {
      display: none !important;
    }

    body.calc-print-mode [data-calculator-slug][data-printing="true"] .calc-results-panel {
      border: 0 !important;
      background: white !important;
      padding: 0 !important;
      break-inside: avoid;
    }
  }
</style>
