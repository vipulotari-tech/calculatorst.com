---
import { getModelForSlug } from "../../lib/calculator-registry";
import { unitLabels } from "../../lib/calculator-math";
import type { Field } from "../../lib/calculator-types";
import ProjectDiagram from "./ProjectDiagram.astro";

interface Props {
  id: string; // The slug, e.g. "concrete-calculator"
  resultTitle?: string;
  wasteDefault?: number;
}

const { id, resultTitle } = Astro.props;
const slug = id;
const model = getModelForSlug(slug);
const fields = model.fields;

// Server-render the initial visibility of mode-gated fields so hidden inputs
// do not flash before the client script applies the same rules.
function fieldVisible(f: Field, all: Field[]): boolean {
  const vw = f.visibleWhen;
  if (!vw || !vw.field) return true;
  const ctrl = all.find((x) => x.id === vw.field);
  const ctrlValue = ctrl?.value ?? ctrl?.min ?? 0;
  if (vw.equals !== undefined) return ctrlValue === vw.equals;
  return (vw.in ?? []).includes(ctrlValue);
}

const measurements = fields.filter((f) => !f.group || f.group === "Measurements");
const assumptions = fields.filter((f) => f.group === "Material & assumptions");
const costs = fields.filter((f) => f.group === "Cost");
const diagramFields = fields
  .filter((field) =>
    !field.options
    && (
      field.dimension === "length"
      || (slug === "concrete-weight-calculator" && field.dimension === "area")
      || ["pitch", "rise", "run", "spacing"].includes(field.id)
    )
  )
  .map((field) => ({ id: field.id, label: field.label, unit: field.unit }));
---

<div
  id={slug}
  data-calculator-slug={slug}
  class="rounded-xl border border-border bg-card p-5 shadow-card sm:p-7"
>
  <form id={`${slug}-form`} novalidate class="space-y-6">
    <!-- Section 1: Dimensions & Measurements -->
    <div class="space-y-3">
      <h3 class="text-xs font-mono font-semibold uppercase tracking-wider text-muted-foreground">
        1. Measurements & Dimensions
      </h3>
      <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
        {measurements.map((field) => (
                  <div class="calc-field" id={`${slug}-field-${field.id}`} hidden={!fieldVisible(field, model.fields)}>
                  <label class="block space-y-1.5" for={`${slug}-${field.id}`}>
            <span class="text-[13px] font-medium text-foreground flex items-center justify-between">
              <span>{field.label} {field.optional && <span class="text-xs text-muted-foreground font-normal">(optional)</span>}</span>
            </span>
            <div class="flex rounded-lg shadow-sm">
              {field.options ? (
                <select
                  id={`${slug}-${field.id}`}
                  name={field.id}
                  required={!field.optional}
                  aria-describedby={`${slug}-${field.id}-err${field.help ? ` ${slug}-${field.id}-help` : ""}`}
                  class="calc-input h-11 w-full rounded-lg border border-border bg-muted/40 px-3.5 text-[14px] text-foreground focus:border-ring focus:bg-background focus:outline-none focus:ring-2 focus:ring-ring/20 transition-all font-mono cursor-pointer"
                >
                  {field.options.map((opt) => (
                    <option value={opt.value} selected={opt.value === field.value}>
                      {opt.label}
                    </option>
                  ))}
                </select>
              ) : (
                <>
              <input
                id={`${slug}-${field.id}`}
                name={field.id}
                type="number"
                inputmode="decimal"
                step={field.integer ? "1" : "any"}
                min={field.min ?? 0}
                max={field.max}
                value={field.value ?? ""}
                placeholder={field.help ? field.label : ""}
                required={!field.optional}
                aria-describedby={`${slug}-${field.id}-err${field.help ? ` ${slug}-${field.id}-help` : ""}`}
                class="calc-input h-11 w-full rounded-l-lg border border-border bg-muted/40 px-3.5 text-[14px] text-foreground placeholder:text-muted-foreground/50 focus:border-ring focus:bg-background focus:outline-none focus:ring-2 focus:ring-ring/20 transition-all font-mono"
              />
              {field.units && field.units.length > 1 ? (
                <select
                  id={`${slug}-${field.id}-unit`}
                  aria-label={`${field.label} unit`}
                  name={`${field.id}_unit`}
                  class="calc-unit-select h-11 shrink-0 rounded-r-lg border border-l-0 border-border bg-muted px-3 text-[13px] font-medium text-foreground focus:outline-none focus:ring-2 focus:ring-ring/20 cursor-pointer"
                >
                  {field.units.map((u) => (
                    <option value={u} selected={u === field.unit}>
                      {unitLabels[u] ?? u}
                    </option>
                  ))}
                </select>
              ) : field.unit ? (
                <span class="flex h-11 shrink-0 items-center rounded-r-lg border border-l-0 border-border bg-muted px-3.5 text-[13px] font-medium text-muted-foreground select-none">
                  {unitLabels[field.unit] ?? field.unit}
                </span>
              ) : null}
                </>
              )}
            </div>
            {field.help && (
              <p id={`${slug}-${field.id}-help`} class="text-[11px] text-muted-foreground leading-normal">{field.help}</p>
            )}
            <span id={`${slug}-${field.id}-err`} class="hidden text-xs text-destructive font-medium" role="alert"></span>
          </label>
                    </div>
                  ))}
      </div>
    </div>

    <!-- Section 2: Material & Assumptions (if any) -->
    {assumptions.length > 0 && (
      <details class="group rounded-lg border border-border bg-muted/20">
        <summary class="flex min-h-11 cursor-pointer list-none items-center justify-between gap-3 px-4 py-3 text-left focus:outline-none focus-visible:ring-2 focus-visible:ring-ring">
          <span>
            <span class="block text-xs font-mono font-semibold uppercase tracking-wider text-foreground">Advanced material assumptions</span>
            <span class="mt-0.5 block text-[11px] leading-4 text-muted-foreground">Waste, density, package yield and other editable material assumptions.</span>
          </span>
          <span aria-hidden="true" class="text-muted-foreground transition-transform group-open:rotate-180">⌄</span>
        </summary>
        <div class="grid gap-4 border-t border-border px-4 py-4 sm:grid-cols-2 lg:grid-cols-3">
          {assumptions.map((field) => (
                    <div class="calc-field" id={`${slug}-field-${field.id}`} hidden={!fieldVisible(field, model.fields)}>
                    <label class="block space-y-1.5" for={`${slug}-${field.id}`}>
              <span class="text-[13px] font-medium text-foreground flex items-center justify-between">
                <span>{field.label} {field.optional && <span class="text-xs text-muted-foreground font-normal">(optional)</span>}</span>
              </span>
              <div class="flex rounded-lg shadow-sm">
                {field.options ? (
                  <select
                    id={`${slug}-${field.id}`}
                    name={field.id}
                    required={!field.optional}
                    aria-describedby={`${slug}-${field.id}-err${field.help ? ` ${slug}-${field.id}-help` : ""}`}
                    class="calc-input h-11 w-full rounded-lg border border-border bg-muted/40 px-3.5 text-[14px] text-foreground focus:border-ring focus:bg-background focus:outline-none focus:ring-2 focus:ring-ring/20 transition-all font-mono cursor-pointer"
                  >
                    {field.options.map((opt) => (
                      <option value={opt.value} selected={opt.value === field.value}>
                        {opt.label}
                      </option>
                    ))}
                  </select>
                ) : (
                  <>
                <input
                  id={`${slug}-${field.id}`}
                  name={field.id}
                  type="number"
                  inputmode="decimal"
                  step={field.integer ? "1" : "any"}
                  min={field.min ?? 0}
                  max={field.max}
                  value={field.value ?? ""}
                  placeholder={field.label}
                  required={!field.optional}
                  aria-describedby={`${slug}-${field.id}-err${field.help ? ` ${slug}-${field.id}-help` : ""}`}
                  class="calc-input h-11 w-full rounded-l-lg border border-border bg-muted/40 px-3.5 text-[14px] text-foreground placeholder:text-muted-foreground/50 focus:border-ring focus:bg-background focus:outline-none focus:ring-2 focus:ring-ring/20 transition-all font-mono"
                />
                {field.units && field.units.length > 1 ? (
                  <select
                    id={`${slug}-${field.id}-unit`}
                    aria-label={`${field.label} unit`}
                    name={`${field.id}_unit`}
                    class="calc-unit-select h-11 shrink-0 rounded-r-lg border border-l-0 border-border bg-muted px-3 text-[13px] font-medium text-foreground focus:outline-none focus:ring-2 focus:ring-ring/20 cursor-pointer"
                  >
                    {field.units.map((u) => (
                      <option value={u} selected={u === field.unit}>
                        {unitLabels[u] ?? u}
                      </option>
                    ))}
                  </select>
                ) : field.unit ? (
                  <span class="flex h-11 shrink-0 items-center rounded-r-lg border border-l-0 border-border bg-muted px-3.5 text-[13px] font-medium text-muted-foreground select-none">
                    {unitLabels[field.unit] ?? field.unit}
                  </span>
                ) : null}
                  </>
                )}
              </div>
              {field.help && (
                <p id={`${slug}-${field.id}-help`} class="text-[11px] text-muted-foreground leading-normal">{field.help}</p>
              )}
              <span id={`${slug}-${field.id}-err`} class="hidden text-xs text-destructive font-medium" role="alert"></span>
            </label>
                      </div>
                    ))}
        </div>
      </details>
    )}

    <!-- Section 3: Cost Estimation (if any) -->
    {costs.length > 0 && (
      <details class="group rounded-lg border border-border bg-muted/20">
        <summary class="flex min-h-11 cursor-pointer list-none items-center justify-between gap-3 px-4 py-3 text-left focus:outline-none focus-visible:ring-2 focus-visible:ring-ring">
          <span>
            <span class="block text-xs font-mono font-semibold uppercase tracking-wider text-foreground">Cost & project extras</span>
            <span class="mt-0.5 block text-[11px] leading-4 text-muted-foreground">Optional pricing and project-cost inputs. Leave defaults unchanged for a quantity-only estimate.</span>
          </span>
          <span aria-hidden="true" class="text-muted-foreground transition-transform group-open:rotate-180">⌄</span>
        </summary>
        <div class="grid gap-4 border-t border-border px-4 py-4 sm:grid-cols-2 lg:grid-cols-3">
          {costs.map((field) => (
                    <div class="calc-field" id={`${slug}-field-${field.id}`} hidden={!fieldVisible(field, model.fields)}>
                    <label class="block space-y-1.5" for={`${slug}-${field.id}`}>
              <span class="text-[13px] font-medium text-foreground flex items-center justify-between">
                <span>{field.label} {field.optional && <span class="text-xs text-muted-foreground font-normal">(optional)</span>}</span>
              </span>
              <div class="flex rounded-lg shadow-sm">
                {field.options ? (
                  <select
                    id={`${slug}-${field.id}`}
                    name={field.id}
                    required={!field.optional}
                    aria-describedby={`${slug}-${field.id}-err${field.help ? ` ${slug}-${field.id}-help` : ""}`}
                    class="calc-input h-11 w-full rounded-lg border border-border bg-muted/40 px-3.5 text-[14px] text-foreground focus:border-ring focus:bg-background focus:outline-none focus:ring-2 focus:ring-ring/20 transition-all font-mono cursor-pointer"
                  >
                    {field.options.map((opt) => (
                      <option value={opt.value} selected={opt.value === field.value}>
                        {opt.label}
                      </option>
                    ))}
                  </select>
                ) : (
                  <>
                <input
                  id={`${slug}-${field.id}`}
                  name={field.id}
                  type="number"
                  inputmode="decimal"
                  step="any"
                  min={field.min ?? 0}
                  max={field.max}
                  value={field.value ?? ""}
                  placeholder="0.00"
                  required={!field.optional}
                  aria-describedby={`${slug}-${field.id}-err${field.help ? ` ${slug}-${field.id}-help` : ""}`}
                  class="calc-input h-11 w-full rounded-l-lg border border-border bg-muted/40 px-3.5 text-[14px] text-foreground placeholder:text-muted-foreground/50 focus:border-ring focus:bg-background focus:outline-none focus:ring-2 focus:ring-ring/20 transition-all font-mono"
                />
                {field.units && field.units.length > 1 ? (
                  <select
                    id={`${slug}-${field.id}-unit`}
                    aria-label={`${field.label} unit`}
                    name={`${field.id}_unit`}
                    class="calc-unit-select h-11 shrink-0 rounded-r-lg border border-l-0 border-border bg-muted px-3 text-[13px] font-medium text-foreground focus:outline-none focus:ring-2 focus:ring-ring/20 cursor-pointer"
                  >
                    {field.units.map((u) => (
                      <option value={u} selected={u === field.unit}>
                        {unitLabels[u] ?? u}
                      </option>
                    ))}
                  </select>
                ) : field.unit ? (
                  <span class="flex h-11 shrink-0 items-center rounded-r-lg border border-l-0 border-border bg-muted px-3.5 text-[13px] font-medium text-muted-foreground select-none">
                    {unitLabels[field.unit] ?? field.unit}
                  </span>
                ) : null}
                  </>
                )}
              </div>
              {field.help && (
                <p id={`${slug}-${field.id}-help`} class="text-[11px] text-muted-foreground leading-normal">{field.help}</p>
              )}
              <span id={`${slug}-${field.id}-err`} class="hidden text-xs text-destructive font-medium" role="alert"></span>
            </label>
                      </div>
                    ))}
        </div>
      </details>
    )}

    <!-- Form Actions -->
    <div class="flex flex-wrap items-center justify-between gap-3 pt-4 border-t border-border">
      <div class="flex items-center gap-2">
        <button
          type="submit"
          class="calc-calc-btn inline-flex h-11 items-center justify-center rounded-lg bg-foreground px-5 text-[13px] font-medium text-background transition-opacity hover:opacity-90 focus:outline-none focus-visible:ring-2 focus-visible:ring-ring cursor-pointer"
        >
          Calculate
        </button>
        <button
          type="button"
          class="calc-reset-btn inline-flex h-11 items-center justify-center rounded-lg border border-border bg-background px-4 text-[13px] font-medium text-muted-foreground hover:bg-muted/60 hover:text-foreground transition-colors focus:outline-none focus-visible:ring-2 focus-visible:ring-ring cursor-pointer"
        >
          Reset
        </button>
      </div>
      <div class="flex items-center gap-2">
        <button
          type="button"
          aria-label="Copy Result"
          class="calc-copy-btn inline-flex h-11 items-center justify-center rounded-lg border border-border bg-background px-3.5 text-[13px] font-medium text-foreground hover:bg-muted/50 transition-colors gap-1.5 focus:outline-none focus-visible:ring-2 focus-visible:ring-ring cursor-pointer"
        >
          <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-copy shrink-0"><rect width="14" height="14" x="8" y="8" rx="2" ry="2"/><path d="M4 16c-1.1 0-2-.9-2-2V4c0-1.1.9-2 2-2h10c1.1 0 2 .9 2 2"/></svg>
          <span class="copy-status" role="status">Copy Result</span>
        </button>
        <button
          type="button"
          aria-label="Share this calculation"
          class="calc-share-btn inline-flex h-11 items-center justify-center rounded-lg border border-border bg-background px-3.5 text-[13px] font-medium text-foreground hover:bg-muted/50 transition-colors gap-1.5 focus:outline-none focus-visible:ring-2 focus-visible:ring-ring cursor-pointer"
        >
          <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="shrink-0"><circle cx="18" cy="5" r="3"/><circle cx="6" cy="12" r="3"/><circle cx="18" cy="19" r="3"/><path d="m8.6 13.5 6.8 4"/><path d="m15.4 6.5-6.8 4"/></svg>
          <span class="share-status" role="status">Share</span>
        </button>
        <button
          type="button"
          aria-label="Print calculation results"
          class="calc-print-btn inline-flex h-11 items-center justify-center rounded-lg border border-border bg-background px-3.5 text-[13px] font-medium text-foreground hover:bg-muted/50 transition-colors gap-1.5 focus:outline-none focus-visible:ring-2 focus-visible:ring-ring cursor-pointer"
        >
          <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="shrink-0"><path d="M6 9V2h12v7"/><path d="M6 18H4a2 2 0 0 1-2-2v-5a2 2 0 0 1 2-2h16a2 2 0 0 1 2 2v5a2 2 0 0 1-2 2h-2"/><rect x="6" y="14" width="12" height="8"/></svg>
          <span>Print</span>
        </button>
      </div>
    </div>
  </form>

  {diagramFields.length >= 2 && (
    <div class="mt-6">
      <ProjectDiagram slug={slug} fields={diagramFields} />
    </div>
  )}

  <section class="calc-print-summary hidden" aria-label="Printable estimate summary">
    <div class="border-b border-border pb-4">
      <p class="font-mono text-[11px] font-semibold uppercase tracking-wider text-muted-foreground">Calculator Street — Project Estimate</p>
      <h2 class="mt-1 text-xl font-semibold text-foreground">{resultTitle || "Construction estimate"}</h2>
      <p class="calc-print-generated mt-1 text-xs text-muted-foreground"></p>
    </div>
    <div class="mt-4">
      <h3 class="text-sm font-semibold text-foreground">Project inputs</h3>
      <dl class="calc-print-inputs mt-2 grid grid-cols-2 gap-x-6 gap-y-1 text-xs"></dl>
    </div>
    <p class="mt-4 border-t border-border pt-3 text-[11px] leading-5 text-muted-foreground">
      Planning estimate only. Confirm field measurements, supplier yields and prices before ordering. Structural requirements, code compliance and project-specific design remain outside this material estimate.
    </p>
  </section>

  <!-- Output Results Panel -->
  <p class="calc-status mt-4 text-sm text-muted-foreground" role="status" aria-live="polite"></p>
  <div class="calc-results-panel mt-6 space-y-5 rounded-xl border border-border/80 bg-muted/20 p-5 sm:p-6">
    <!-- Primary Output Hero Card -->
    <div class="rounded-xl border border-border bg-card p-5 shadow-xs">
      <span class="text-xs font-mono font-medium uppercase tracking-wider text-muted-foreground block result-hero-title">
        {resultTitle || "ESTIMATED QUANTITY"}
      </span>
      <div class="mt-2 flex flex-wrap items-baseline gap-2.5">
        <span class="result-primary text-3xl sm:text-4xl font-bold font-mono tracking-tight text-foreground">
          --
        </span>
        <span class="result-primary-unit text-base sm:text-lg font-medium text-muted-foreground font-mono">
        </span>
      </div>
      <p class="result-secondary mt-1.5 text-xs sm:text-sm text-muted-foreground font-mono">
        Enter dimensions above to calculate
      </p>
    </div>

    <!-- Secondary Result Metrics Grid -->
    <div class="result-rows-grid grid gap-3 sm:grid-cols-2 lg:grid-cols-3">
    </div>

    <details class="calc-estimate-worksheet rounded-lg border border-border bg-card p-4">
      <summary class="cursor-pointer select-none text-xs font-mono font-semibold uppercase tracking-wider text-foreground focus:outline-none focus-visible:ring-2 focus-visible:ring-ring">
        Quantity &amp; cost worksheet
      </summary>
      <p class="mt-2 text-xs leading-5 text-muted-foreground">
        A compact estimate table using only outputs this calculator actually computes. Whole-item rows stay rounded as shown above.
      </p>
      <div class="mt-3 overflow-x-auto" role="region" aria-label="Estimate worksheet" tabindex="0">
        <table class="w-full min-w-[420px] text-left text-xs">
          <thead class="border-b border-border text-muted-foreground">
            <tr><th scope="col" class="py-2 pr-4 font-medium">Item</th><th scope="col" class="py-2 pr-4 font-medium">Quantity</th><th scope="col" class="py-2 font-medium">Unit</th></tr>
          </thead>
          <tbody class="calc-estimate-worksheet-body divide-y divide-border"></tbody>
        </table>
      </div>
    </details>

    <!-- Step-by-Step Mathematical Derivation Card -->
    <div class="rounded-lg border border-border bg-card p-4 space-y-2.5">
      <div class="flex flex-col gap-2 sm:flex-row sm:items-start sm:justify-between">
        <span class="text-xs font-mono font-semibold uppercase tracking-wider text-foreground">
          Calculation Breakdown & Steps
        </span>
        <span class="text-[11px] font-mono text-muted-foreground">Formula: {model.formula}</span>
      </div>
      <ol class="result-steps-list list-decimal pl-5 space-y-1 text-xs text-muted-foreground font-mono leading-relaxed">
        <li>Enter values to see step-by-step substitution.</li>
      </ol>
      <ul class="result-notes-list list-disc pl-4 text-sm text-muted-foreground"></ul>
      {model.assumptions.length > 0 && (
        <div class="pt-2 border-t border-border/60 text-[11px] text-muted-foreground space-y-1">
          <p class="font-medium text-foreground">Engineering Assumptions:</p>
          <ul class="list-disc pl-4 space-y-0.5">
            {model.assumptions.map((a) => <li>{a}</li>)}
          </ul>
        </div>
      )}
    </div>
  </div>
</div>

<script>
  import { getModelForSlug } from "../../lib/calculator-registry";
  import { readInputs, fmt, unitLabels } from "../../lib/calculator-math";
  import type { Field } from "../../lib/calculator-types";

  function initCalculators() {
    const calcElements = document.querySelectorAll<HTMLElement>("[data-calculator-slug]");

    calcElements.forEach((root) => {
      const slug = root.dataset.calculatorSlug;
      if (!slug || root.dataset.initialized) return;
      const calculatorSlug = slug;
      root.dataset.initialized = 'true';

      const model = getModelForSlug(calculatorSlug);
      const form = root.querySelector<HTMLFormElement>(`#${slug}-form`);
      const primaryValEl = root.querySelector<HTMLElement>(".result-primary");
      const primaryUnitEl = root.querySelector<HTMLElement>(".result-primary-unit");
      const secondaryEl = root.querySelector<HTMLElement>(".result-secondary");
      const rowsGridEl = root.querySelector<HTMLElement>(".result-rows-grid");
      const stepsListEl = root.querySelector<HTMLElement>(".result-steps-list");
      const copyBtn = root.querySelector<HTMLButtonElement>(".calc-copy-btn");
      const copyStatus = root.querySelector<HTMLElement>(".copy-status");
      const shareBtn = root.querySelector<HTMLButtonElement>(".calc-share-btn");
      const shareStatus = root.querySelector<HTMLElement>(".share-status");
      const printBtn = root.querySelector<HTMLButtonElement>(".calc-print-btn");
      const resetBtn = root.querySelector<HTMLButtonElement>(".calc-reset-btn");
      const status = root.querySelector<HTMLElement>('.calc-status');
      const notesList = root.querySelector<HTMLElement>('.result-notes-list');
      const printInputs = root.querySelector<HTMLElement>('.calc-print-inputs');
      const printGenerated = root.querySelector<HTMLElement>('.calc-print-generated');
      const worksheetBody = root.querySelector<HTMLTableSectionElement>('.calc-estimate-worksheet-body');

      if (!form || !primaryValEl || !rowsGridEl || !stepsListEl) return;
            const targetPrimaryValEl = primaryValEl;
            const targetRowsGridEl = rowsGridEl;
            const targetStepsListEl = stepsListEl;

            // Mode-gated field visibility: fields hidden by visibleWhen resolve to
            // their default value so calculations stay valid in every mode.
            function readControlValues() {
              const state: Record<string, number> = {};
              model.fields.forEach((f) => {
                const el = form?.querySelector<HTMLInputElement>(`#${slug}-${f.id}`);
                const raw = el?.value ?? String(f.value ?? '');
                state[f.id] = raw === '' ? Number.NaN : Number(raw);
              });
              return state;
            }
            function fieldVisible(f: Field, state: Record<string, number>) {
              if (!f.visibleWhen) return true;
              const ctrl = state[f.visibleWhen.field];
              if (f.visibleWhen.equals !== undefined) return ctrl === f.visibleWhen.equals;
              return (f.visibleWhen.in ?? []).includes(ctrl);
            }
            function updateVisibility() {
              const state = readControlValues();
              model.fields.forEach((f) => {
                if (!f.visibleWhen) return;
                const wrap = root.querySelector<HTMLElement>(`#${slug}-field-${f.id}`);
                if (wrap) wrap.hidden = !fieldVisible(f, state);
              });
            }

            function hasCompleteVisibleRequiredInputs() {
              const state = readControlValues();
              return model.fields.every((field) => {
                if (field.optional || !fieldVisible(field, state)) return true;
                const control = form?.querySelector<HTMLInputElement | HTMLSelectElement>(`#${slug}-${field.id}`);
                return Boolean(control && control.value.trim() !== "");
              });
            }

            function showAwaitingInput() {
              delete root.dataset.lastCalculated;
              if (copyBtn) copyBtn.disabled = true;
              targetPrimaryValEl.textContent = '--';
              if (primaryUnitEl) primaryUnitEl.textContent = '';
              if (secondaryEl) secondaryEl.textContent = 'Enter the required values above to calculate';
              targetRowsGridEl.replaceChildren();
              targetStepsListEl.replaceChildren();
              const li = document.createElement('li');
              li.textContent = 'Complete the required fields to see the calculation breakdown.';
              targetStepsListEl.appendChild(li);
              notesList?.replaceChildren();
              worksheetBody?.replaceChildren();
              if (status) status.textContent = '';
            }

            function recalculateIfReady() {
              updateVisibility();
              if (hasCompleteVisibleRequiredInputs()) calculate();
              else showAwaitingInput();
            }

            const sharedParam = (id: string) => `cs_${id}`;
            function hydrateSharedState() {
              const params = new URLSearchParams(window.location.search);
              if (params.get("cs_calc") !== slug) return;
              model.fields.forEach((field) => {
                const raw = params.get(sharedParam(field.id));
                const control = form?.querySelector<HTMLInputElement | HTMLSelectElement>(`#${slug}-${field.id}`);
                if (raw !== null && control) {
                  const numeric = Number(raw);
                  const matchesOption = !field.options || field.options.some(opt => opt.value === numeric);
                  const inRange = Number.isFinite(numeric)
                    && (field.min === undefined || numeric >= field.min)
                    && (field.max === undefined || numeric <= field.max)
                    && (!field.integer || Number.isInteger(numeric));
                  if (matchesOption && inRange) control.value = raw;
                }
                const unit = params.get(sharedParam(`${field.id}_unit`));
                const unitSelect = form?.querySelector<HTMLSelectElement>(`#${slug}-${field.id}-unit`);
                if (unit && unitSelect && field.units?.includes(unit)) unitSelect.value = unit;
              });
            }

            function buildShareUrl() {
              const url = new URL(window.location.href);
              url.search = "";
              url.searchParams.set("cs_calc", calculatorSlug);
              model.fields.forEach((field) => {
                const control = form?.querySelector<HTMLInputElement | HTMLSelectElement>(`#${slug}-${field.id}`);
                if (control && control.value !== "") url.searchParams.set(sharedParam(field.id), control.value);
                const unitSelect = form?.querySelector<HTMLSelectElement>(`#${slug}-${field.id}-unit`);
                if (unitSelect?.value) url.searchParams.set(sharedParam(`${field.id}_unit`), unitSelect.value);
              });
              return url;
            }

            function clearSharedStateFromUrl() {
              const url = new URL(window.location.href);
              if (url.searchParams.get("cs_calc") !== slug) return;
              [...url.searchParams.keys()].filter(key => key === "cs_calc" || key.startsWith("cs_")).forEach(key => url.searchParams.delete(key));
              history.replaceState(history.state, "", url.pathname + (url.search ? url.search : "") + url.hash);
            }

            function calculate(focusError = false) {
              const rawInputs: Record<string, string> = {};
              const rawUnits: Record<string, string> = {};

              // Clear previous field errors
              root.querySelectorAll<HTMLElement>("[role='alert']").forEach((el) => {
                el.classList.add("hidden");
                el.textContent = "";
              });
              form?.querySelectorAll('[aria-invalid]').forEach(el => el.removeAttribute('aria-invalid'));

              const state = readControlValues();

              // Collect all inputs
              model.fields.forEach((field) => {
                const inputEl = form?.querySelector<HTMLInputElement>(`#${slug}-${field.id}`);
                if (inputEl) {
                                  if (field.visibleWhen && !fieldVisible(field, state)) {
                                    // Hidden in the current mode: use the field default so the
                                    // calculation is identical to leaving it untouched.
                                    rawInputs[field.id] = field.optional ? '' : (field.value !== undefined ? String(field.value) : String(field.min ?? 0));
                                  } else {
                                    rawInputs[field.id] = inputEl.value;
                                  }
                                }
                const unitSelect = form?.querySelector<HTMLSelectElement>(`#${slug}-${field.id}-unit`);
                if (unitSelect) {
                  rawUnits[field.id] = unitSelect.value;
                } else if (field.unit) {
                  rawUnits[field.id] = field.unit;
                }
              });

        try {
          const parsed = readInputs(model.fields, rawInputs, rawUnits);
          const result = model.calculate(parsed, rawUnits);
          if (status) status.textContent = 'Results updated.';
          if (copyBtn) copyBtn.disabled = false;
          if (notesList) {
            notesList.replaceChildren(...result.notes.map(note => {
              const li = document.createElement('li');
              li.textContent = note;
              return li;
            }));
          }

          if (!result.rows || result.rows.length === 0) return;

          const primaryRow = result.rows[0];
          const remainingRows = result.rows.slice(1);

          // Keep ratio-style results visually atomic (for example 6:12 rather than 6 :12).
          const primaryUnit = unitLabels[primaryRow.unit] ?? primaryRow.unit;
          if (primaryRow.unit === ':12') {
            targetPrimaryValEl.textContent = `${fmt(primaryRow.value)}:12`;
            if (primaryUnitEl) primaryUnitEl.textContent = '';
          } else {
            targetPrimaryValEl.textContent = fmt(primaryRow.value);
            if (primaryUnitEl) primaryUnitEl.textContent = primaryUnit;
          }
          if (secondaryEl) {
            secondaryEl.textContent = primaryRow.label;
          }

          // Update secondary rows grid
          targetRowsGridEl.innerHTML = "";
          remainingRows.forEach((r) => {
            const card = document.createElement("div");
            card.className = "rounded-lg border border-border bg-card p-3 shadow-xs";
            card.innerHTML = `
              <p class="text-[11px] font-mono text-muted-foreground break-words">${r.label}</p>
              <p class="text-lg font-bold font-mono text-foreground mt-0.5">${fmt(r.value)} <span class="text-xs font-normal text-muted-foreground">${unitLabels[r.unit] ?? r.unit}</span></p>
            `;
            targetRowsGridEl.appendChild(card);
          });

          // Update steps
          targetStepsListEl.innerHTML = "";
          result.steps.forEach((s) => {
            const li = document.createElement("li");
            li.textContent = s;
            targetStepsListEl.appendChild(li);
          });

          const inputLines = model.fields
            .filter((field) => !field.visibleWhen || fieldVisible(field, state))
            .map((field) => {
              const control = form?.querySelector<HTMLInputElement | HTMLSelectElement>(`#${slug}-${field.id}`);
              if (!control || control.value === "") return null;
              const numericValue = Number(control.value);
              const optionLabel = field.options?.find((option) => option.value === numericValue)?.label;
              const unitSelect = form?.querySelector<HTMLSelectElement>(`#${slug}-${field.id}-unit`);
              const displayUnit = optionLabel ? "" : (unitLabels[unitSelect?.value ?? field.unit ?? ""] ?? unitSelect?.value ?? field.unit ?? "");
              return `${field.label}: ${optionLabel ?? control.value}${displayUnit ? ` ${displayUnit}` : ""}`;
            })
            .filter((line): line is string => Boolean(line));

          if (worksheetBody) {
            worksheetBody.replaceChildren(...result.rows.map((row) => {
              const tr = document.createElement("tr");
              const label = document.createElement("th");
              label.scope = "row";
              label.className = "py-2 pr-4 font-normal text-muted-foreground";
              label.textContent = row.label;
              const qty = document.createElement("td");
              qty.className = "py-2 pr-4 font-mono font-medium text-foreground tabular-nums";
              qty.textContent = fmt(row.value);
              const unit = document.createElement("td");
              unit.className = "py-2 font-mono text-muted-foreground";
              unit.textContent = unitLabels[row.unit] ?? row.unit;
              tr.append(label, qty, unit);
              return tr;
            }));
          }

          // Copy produces a self-contained estimate rather than a bare result list.
          root.dataset.lastCalculated = [
            document.querySelector("h1")?.textContent?.trim() ?? "Construction estimate",
            "",
            "Inputs",
            ...inputLines,
            "",
            "Results",
            ...result.rows.map(r => `${r.label}: ${fmt(r.value)} ${unitLabels[r.unit] ?? r.unit}`),
          ].join('\n');

          if (printInputs) {
            printInputs.replaceChildren(...inputLines.map((line) => {
              const [label, ...valueParts] = line.split(": ");
              const wrap = document.createElement("div");
              wrap.className = "contents";
              const dt = document.createElement("dt");
              dt.className = "text-muted-foreground";
              dt.textContent = label;
              const dd = document.createElement("dd");
              dd.className = "font-medium text-foreground";
              dd.textContent = valueParts.join(": ");
              wrap.append(dt, dd);
              return wrap;
            }));
          }
        } catch (err: any) {
          delete root.dataset.lastCalculated;
          if (copyBtn) copyBtn.disabled = true;
          targetPrimaryValEl.textContent = '—';
          if (primaryUnitEl) primaryUnitEl.textContent = '';
          if (secondaryEl) secondaryEl.textContent = 'Check the inputs to calculate a new result.';
          targetRowsGridEl.replaceChildren();
          targetStepsListEl.replaceChildren();
          notesList?.replaceChildren();
          if (status) status.textContent = err.message || 'Unable to calculate. Check your inputs.';
          if (err.field) {
            const input = form?.querySelector<HTMLInputElement>(`#${slug}-${err.field}`);
            input?.setAttribute('aria-invalid', 'true');
            if (focusError) input?.focus();
            const errEl = root.querySelector<HTMLElement>(`#${slug}-${err.field}-err`);
            if (errEl) {
              errEl.textContent = err.message;
              errEl.classList.remove("hidden");
            }
          }
        }
      }

      // Live calculation on input change
            form.addEventListener("input", recalculateIfReady);
            form.addEventListener("change", recalculateIfReady);
            form.addEventListener('submit', event => { event.preventDefault(); updateVisibility(); calculate(true); });

            // Reset handler
            resetBtn?.addEventListener("click", () => {
              model.fields.forEach((field) => {
                const inputEl = form.querySelector<HTMLInputElement>(`#${slug}-${field.id}`);
                if (inputEl) {
                  inputEl.value = field.value !== undefined ? String(field.value) : "";
                }
                const unitSelect = form.querySelector<HTMLSelectElement>(`#${slug}-${field.id}-unit`);
                if (unitSelect && field.unit) {
                  unitSelect.value = field.unit;
                }
              });
              clearSharedStateFromUrl();
              recalculateIfReady();
            });

      // Copy handler
      copyBtn?.addEventListener("click", async () => {
        const textToCopy = root.dataset.lastCalculated;
        if (!textToCopy) return;
        try {
          await navigator.clipboard.writeText(textToCopy);
          if (copyStatus) {
            copyStatus.textContent = "Copied!";
            setTimeout(() => {
              copyStatus.textContent = "Copy Result";
            }, 2000);
          }
        } catch {
          if (copyStatus) copyStatus.textContent = 'Copy unavailable';
          if (status) status.textContent = 'Clipboard access was unavailable. Select and copy the displayed results manually.';
        }
      });

      shareBtn?.addEventListener("click", async () => {
        const url = buildShareUrl();
        try {
          if (navigator.share) {
            await navigator.share({ title: document.title, url: url.toString() });
            if (shareStatus) shareStatus.textContent = "Shared";
          } else {
            await navigator.clipboard.writeText(url.toString());
            if (shareStatus) shareStatus.textContent = "Link copied";
          }
          setTimeout(() => { if (shareStatus) shareStatus.textContent = "Share"; }, 2000);
        } catch (err: any) {
          if (err?.name !== "AbortError") {
            if (shareStatus) shareStatus.textContent = "Share unavailable";
            if (status) status.textContent = "Sharing was unavailable. You can still copy the displayed result.";
          }
        }
      });

      printBtn?.addEventListener("click", () => {
        if (!root.dataset.lastCalculated) {
          if (status) status.textContent = "Complete the required inputs before printing an estimate.";
          return;
        }
        if (printGenerated) {
          printGenerated.textContent = `Generated ${new Intl.DateTimeFormat(undefined, { dateStyle: "medium", timeStyle: "short" }).format(new Date())}`;
        }
        root.dataset.printing = "true";
        document.body.classList.add("calc-print-mode");
        window.print();
        document.body.classList.remove("calc-print-mode");
        delete root.dataset.printing;
      });

      // Restore a calculation from a shared URL before the first render.
            hydrateSharedState();
            recalculateIfReady();
            root.dispatchEvent(new CustomEvent("calculator-state-restored"));
    });
  }

  // Initialize on load and on Astro page transitions
  initCalculators();
  document.addEventListener("astro:page-load", initCalculators);
</script>


<style is:global>
  @media print {
    body.calc-print-mode * {
      visibility: hidden !important;
    }

    body.calc-print-mode [data-calculator-slug][data-printing="true"],
    body.calc-print-mode [data-calculator-slug][data-printing="true"] * {
      visibility: visible !important;
    }

    body.calc-print-mode [data-calculator-slug][data-printing="true"] {
      position: absolute !important;
      inset: 0 auto auto 0 !important;
      width: 100% !important;
      border: 0 !important;
      box-shadow: none !important;
      padding: 0 !important;
    }

    body.calc-print-mode [data-calculator-slug][data-printing="true"] form,
    body.calc-print-mode [data-calculator-slug][data-printing="true"] .calc-status {
      display: none !important;
    }

    body.calc-print-mode [data-calculator-slug][data-printing="true"] .calc-print-summary {
      display: block !important;
      margin-bottom: 1.25rem !important;
    }

    body.calc-print-mode [data-calculator-slug][data-printing="true"] .calc-estimate-worksheet {
      display: block !important;
    }

    body.calc-print-mode [data-calculator-slug][data-printing="true"] .calc-estimate-worksheet > summary {
      display: none !important;
    }

    body.calc-print-mode [data-calculator-slug][data-printing="true"] .calc-results-panel {
      border: 0 !important;
      background: white !important;
      padding: 0 !important;
      break-inside: avoid;
    }
  }
</style>
