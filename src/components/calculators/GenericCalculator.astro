---
import { getModelForSlug } from "../../lib/calculator-registry";
import { unitLabels } from "../../lib/calculator-math";
import type { Field } from "../../lib/calculator-types";

interface Props {
  id: string; // The slug, e.g. "concrete-calculator"
  resultTitle?: string;
  wasteDefault?: number;
}

const { id, resultTitle } = Astro.props;
const slug = id;
const model = getModelForSlug(slug);
const fields = model.fields;

// Server-render the initial visibility of mode-gated fields so hidden inputs
// do not flash before the client script applies the same rules.
function fieldVisible(f: Field, all: Field[]): boolean {
  const vw = f.visibleWhen;
  if (!vw || !vw.field) return true;
  const ctrl = all.find((x) => x.id === vw.field);
  const ctrlValue = ctrl?.value ?? ctrl?.min ?? 0;
  if (vw.equals !== undefined) return ctrlValue === vw.equals;
  return (vw.in ?? []).includes(ctrlValue);
}

const measurements = fields.filter((f) => !f.group || f.group === "Measurements");
const assumptions = fields.filter((f) => f.group === "Material & assumptions");
const costs = fields.filter((f) => f.group === "Cost");
---

<div
  id={slug}
  data-calculator-slug={slug}
  class="rounded-xl border border-border bg-card p-5 shadow-card sm:p-7"
>
  <form id={`${slug}-form`} novalidate class="space-y-6">
    <!-- Section 1: Dimensions & Measurements -->
    <div class="space-y-3">
      <h3 class="text-xs font-mono font-semibold uppercase tracking-wider text-muted-foreground">
        1. Measurements & Dimensions
      </h3>
      <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
        {measurements.map((field) => (
                  <div class="calc-field" id={`${slug}-field-${field.id}`} hidden={!fieldVisible(field, model.fields)}>
                  <label class="block space-y-1.5" for={`${slug}-${field.id}`}>
            <span class="text-[13px] font-medium text-foreground flex items-center justify-between">
              <span>{field.label} {field.optional && <span class="text-xs text-muted-foreground font-normal">(optional)</span>}</span>
            </span>
            <div class="flex rounded-lg shadow-sm">
              {field.options ? (
                <select
                  id={`${slug}-${field.id}`}
                  name={field.id}
                  required={!field.optional}
                  aria-describedby={`${slug}-${field.id}-err`}
                  class="calc-input h-11 w-full rounded-lg border border-border bg-muted/40 px-3.5 text-[14px] text-foreground focus:border-ring focus:bg-background focus:outline-none focus:ring-2 focus:ring-ring/20 transition-all font-mono cursor-pointer"
                >
                  {field.options.map((opt) => (
                    <option value={opt.value} selected={opt.value === field.value}>
                      {opt.label}
                    </option>
                  ))}
                </select>
              ) : (
                <>
              <input
                id={`${slug}-${field.id}`}
                name={field.id}
                type="number"
                inputmode="decimal"
                step={field.integer ? "1" : "any"}
                min={field.min ?? 0}
                max={field.max}
                value={field.value ?? ""}
                placeholder={field.help ? field.label : ""}
                required={!field.optional}
                aria-describedby={`${slug}-${field.id}-err`}
                class="calc-input h-11 w-full rounded-l-lg border border-border bg-muted/40 px-3.5 text-[14px] text-foreground placeholder:text-muted-foreground/50 focus:border-ring focus:bg-background focus:outline-none focus:ring-2 focus:ring-ring/20 transition-all font-mono"
              />
              {field.units && field.units.length > 1 ? (
                <select
                  id={`${slug}-${field.id}-unit`}
                  aria-label={`${field.label} unit`}
                  name={`${field.id}_unit`}
                  class="calc-unit-select h-11 shrink-0 rounded-r-lg border border-l-0 border-border bg-muted px-3 text-[13px] font-medium text-foreground focus:outline-none focus:ring-2 focus:ring-ring/20 cursor-pointer"
                >
                  {field.units.map((u) => (
                    <option value={u} selected={u === field.unit}>
                      {unitLabels[u] ?? u}
                    </option>
                  ))}
                </select>
              ) : field.unit ? (
                <span class="flex h-11 shrink-0 items-center rounded-r-lg border border-l-0 border-border bg-muted px-3.5 text-[13px] font-medium text-muted-foreground select-none">
                  {unitLabels[field.unit] ?? field.unit}
                </span>
              ) : null}
                </>
              )}
            </div>
            {field.help && (
              <p class="text-[11px] text-muted-foreground leading-normal">{field.help}</p>
            )}
            <span id={`${slug}-${field.id}-err`} class="hidden text-xs text-destructive font-medium" role="alert"></span>
          </label>
                    </div>
                  ))}
      </div>
    </div>

    <!-- Section 2: Material & Assumptions (if any) -->
    {assumptions.length > 0 && (
      <div class="space-y-3 pt-2 border-t border-border/60">
        <h3 class="text-xs font-mono font-semibold uppercase tracking-wider text-muted-foreground">
          2. Material Properties & Waste Allowance
        </h3>
        <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
          {assumptions.map((field) => (
                    <div class="calc-field" id={`${slug}-field-${field.id}`} hidden={!fieldVisible(field, model.fields)}>
                    <label class="block space-y-1.5" for={`${slug}-${field.id}`}>
              <span class="text-[13px] font-medium text-foreground flex items-center justify-between">
                <span>{field.label} {field.optional && <span class="text-xs text-muted-foreground font-normal">(optional)</span>}</span>
              </span>
              <div class="flex rounded-lg shadow-sm">
                {field.options ? (
                  <select
                    id={`${slug}-${field.id}`}
                    name={field.id}
                    required={!field.optional}
                    aria-describedby={`${slug}-${field.id}-err`}
                    class="calc-input h-11 w-full rounded-lg border border-border bg-muted/40 px-3.5 text-[14px] text-foreground focus:border-ring focus:bg-background focus:outline-none focus:ring-2 focus:ring-ring/20 transition-all font-mono cursor-pointer"
                  >
                    {field.options.map((opt) => (
                      <option value={opt.value} selected={opt.value === field.value}>
                        {opt.label}
                      </option>
                    ))}
                  </select>
                ) : (
                  <>
                <input
                  id={`${slug}-${field.id}`}
                  name={field.id}
                  type="number"
                  inputmode="decimal"
                  step={field.integer ? "1" : "any"}
                  min={field.min ?? 0}
                  max={field.max}
                  value={field.value ?? ""}
                  placeholder={field.label}
                  required={!field.optional}
                  aria-describedby={`${slug}-${field.id}-err`}
                  class="calc-input h-11 w-full rounded-l-lg border border-border bg-muted/40 px-3.5 text-[14px] text-foreground placeholder:text-muted-foreground/50 focus:border-ring focus:bg-background focus:outline-none focus:ring-2 focus:ring-ring/20 transition-all font-mono"
                />
                {field.units && field.units.length > 1 ? (
                  <select
                    id={`${slug}-${field.id}-unit`}
                    aria-label={`${field.label} unit`}
                    name={`${field.id}_unit`}
                    class="calc-unit-select h-11 shrink-0 rounded-r-lg border border-l-0 border-border bg-muted px-3 text-[13px] font-medium text-foreground focus:outline-none focus:ring-2 focus:ring-ring/20 cursor-pointer"
                  >
                    {field.units.map((u) => (
                      <option value={u} selected={u === field.unit}>
                        {unitLabels[u] ?? u}
                      </option>
                    ))}
                  </select>
                ) : field.unit ? (
                  <span class="flex h-11 shrink-0 items-center rounded-r-lg border border-l-0 border-border bg-muted px-3.5 text-[13px] font-medium text-muted-foreground select-none">
                    {unitLabels[field.unit] ?? field.unit}
                  </span>
                ) : null}
                  </>
                )}
              </div>
              {field.help && (
                <p class="text-[11px] text-muted-foreground leading-normal">{field.help}</p>
              )}
              <span id={`${slug}-${field.id}-err`} class="hidden text-xs text-destructive font-medium" role="alert"></span>
            </label>
                      </div>
                    ))}
        </div>
      </div>
    )}

    <!-- Section 3: Cost Estimation (if any) -->
    {costs.length > 0 && (
      <div class="space-y-3 pt-2 border-t border-border/60">
        <h3 class="text-xs font-mono font-semibold uppercase tracking-wider text-muted-foreground">
          3. Material Cost
        </h3>
        <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
          {costs.map((field) => (
                    <div class="calc-field" id={`${slug}-field-${field.id}`} hidden={!fieldVisible(field, model.fields)}>
                    <label class="block space-y-1.5" for={`${slug}-${field.id}`}>
              <span class="text-[13px] font-medium text-foreground flex items-center justify-between">
                <span>{field.label} {field.optional && <span class="text-xs text-muted-foreground font-normal">(optional)</span>}</span>
              </span>
              <div class="flex rounded-lg shadow-sm">
                {field.options ? (
                  <select
                    id={`${slug}-${field.id}`}
                    name={field.id}
                    required={!field.optional}
                    aria-describedby={`${slug}-${field.id}-err`}
                    class="calc-input h-11 w-full rounded-lg border border-border bg-muted/40 px-3.5 text-[14px] text-foreground focus:border-ring focus:bg-background focus:outline-none focus:ring-2 focus:ring-ring/20 transition-all font-mono cursor-pointer"
                  >
                    {field.options.map((opt) => (
                      <option value={opt.value} selected={opt.value === field.value}>
                        {opt.label}
                      </option>
                    ))}
                  </select>
                ) : (
                  <>
                <input
                  id={`${slug}-${field.id}`}
                  name={field.id}
                  type="number"
                  inputmode="decimal"
                  step="any"
                  min={field.min ?? 0}
                  max={field.max}
                  value={field.value ?? ""}
                  placeholder="0.00"
                  required={!field.optional}
                  aria-describedby={`${slug}-${field.id}-err`}
                  class="calc-input h-11 w-full rounded-l-lg border border-border bg-muted/40 px-3.5 text-[14px] text-foreground placeholder:text-muted-foreground/50 focus:border-ring focus:bg-background focus:outline-none focus:ring-2 focus:ring-ring/20 transition-all font-mono"
                />
                {field.units && field.units.length > 1 ? (
                  <select
                    id={`${slug}-${field.id}-unit`}
                    aria-label={`${field.label} unit`}
                    name={`${field.id}_unit`}
                    class="calc-unit-select h-11 shrink-0 rounded-r-lg border border-l-0 border-border bg-muted px-3 text-[13px] font-medium text-foreground focus:outline-none focus:ring-2 focus:ring-ring/20 cursor-pointer"
                  >
                    {field.units.map((u) => (
                      <option value={u} selected={u === field.unit}>
                        {unitLabels[u] ?? u}
                      </option>
                    ))}
                  </select>
                ) : field.unit ? (
                  <span class="flex h-11 shrink-0 items-center rounded-r-lg border border-l-0 border-border bg-muted px-3.5 text-[13px] font-medium text-muted-foreground select-none">
                    {unitLabels[field.unit] ?? field.unit}
                  </span>
                ) : null}
                  </>
                )}
              </div>
              {field.help && (
                <p class="text-[11px] text-muted-foreground leading-normal">{field.help}</p>
              )}
              <span id={`${slug}-${field.id}-err`} class="hidden text-xs text-destructive font-medium" role="alert"></span>
            </label>
                      </div>
                    ))}
        </div>
      </div>
    )}

    <!-- Form Actions -->
    <div class="flex flex-wrap items-center justify-between gap-3 pt-4 border-t border-border">
      <div class="flex items-center gap-2">
        <button
          type="submit"
          class="calc-calc-btn inline-flex h-10 items-center justify-center rounded-lg bg-foreground px-5 text-[13px] font-medium text-background transition-opacity hover:opacity-90 focus:outline-none focus-visible:ring-2 focus-visible:ring-ring cursor-pointer"
        >
          Calculate
        </button>
        <button
          type="button"
          class="calc-reset-btn inline-flex h-10 items-center justify-center rounded-lg border border-border bg-background px-4 text-[13px] font-medium text-muted-foreground hover:bg-muted/60 hover:text-foreground transition-colors focus:outline-none focus-visible:ring-2 focus-visible:ring-ring cursor-pointer"
        >
          Reset
        </button>
      </div>
      <div class="flex items-center gap-2">
        <button
          type="button"
          aria-label="Copy Result"
          class="calc-copy-btn inline-flex h-10 items-center justify-center rounded-lg border border-border bg-background px-3.5 text-[13px] font-medium text-foreground hover:bg-muted/50 transition-colors gap-1.5 focus:outline-none focus-visible:ring-2 focus-visible:ring-ring cursor-pointer"
        >
          <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-copy shrink-0"><rect width="14" height="14" x="8" y="8" rx="2" ry="2"/><path d="M4 16c-1.1 0-2-.9-2-2V4c0-1.1.9-2 2-2h10c1.1 0 2 .9 2 2"/></svg>
          <span class="copy-status" role="status">Copy Result</span>
        </button>
      </div>
    </div>
  </form>

  <!-- Output Results Panel -->
  <p class="calc-status mt-4 text-sm text-muted-foreground" role="status" aria-live="polite"></p>
  <div class="calc-results-panel mt-6 space-y-5 rounded-xl border border-border/80 bg-muted/20 p-5 sm:p-6">
    <!-- Primary Output Hero Card -->
    <div class="rounded-xl border border-border bg-card p-5 shadow-xs">
      <span class="text-xs font-mono font-medium uppercase tracking-wider text-muted-foreground block result-hero-title">
        {resultTitle || "ESTIMATED QUANTITY"}
      </span>
      <div class="mt-2 flex flex-wrap items-baseline gap-2.5">
        <span class="result-primary text-3xl sm:text-4xl font-bold font-mono tracking-tight text-foreground">
          --
        </span>
        <span class="result-primary-unit text-base sm:text-lg font-medium text-muted-foreground font-mono">
        </span>
      </div>
      <p class="result-secondary mt-1.5 text-xs sm:text-sm text-muted-foreground font-mono">
        Enter dimensions above to calculate
      </p>
    </div>

    <!-- Secondary Result Metrics Grid -->
    <div class="result-rows-grid grid gap-3 sm:grid-cols-2 lg:grid-cols-3">
    </div>

    <!-- Step-by-Step Mathematical Derivation Card -->
    <div class="rounded-lg border border-border bg-card p-4 space-y-2.5">
      <div class="flex flex-col gap-2 sm:flex-row sm:items-start sm:justify-between">
        <span class="text-xs font-mono font-semibold uppercase tracking-wider text-foreground">
          Calculation Breakdown & Steps
        </span>
        <span class="text-[11px] font-mono text-muted-foreground">Formula: {model.formula}</span>
      </div>
      <ol class="result-steps-list list-decimal pl-5 space-y-1 text-xs text-muted-foreground font-mono leading-relaxed">
        <li>Enter values to see step-by-step substitution.</li>
      </ol>
      <ul class="result-notes-list list-disc pl-4 text-sm text-muted-foreground"></ul>
      {model.assumptions.length > 0 && (
        <div class="pt-2 border-t border-border/60 text-[11px] text-muted-foreground space-y-1">
          <p class="font-medium text-foreground">Engineering Assumptions:</p>
          <ul class="list-disc pl-4 space-y-0.5">
            {model.assumptions.map((a) => <li>{a}</li>)}
          </ul>
        </div>
      )}
    </div>
  </div>
</div>

<script>
  import { getModelForSlug } from "../../lib/calculator-registry";
  import { readInputs, fmt, unitLabels } from "../../lib/calculator-math";
  import type { Field } from "../../lib/calculator-types";

  function initCalculators() {
    const calcElements = document.querySelectorAll<HTMLElement>("[data-calculator-slug]");

    calcElements.forEach((root) => {
      const slug = root.dataset.calculatorSlug;
      if (!slug || root.dataset.initialized) return;
      root.dataset.initialized = 'true';

      const model = getModelForSlug(slug);
      const form = root.querySelector<HTMLFormElement>(`#${slug}-form`);
      const primaryValEl = root.querySelector<HTMLElement>(".result-primary");
      const primaryUnitEl = root.querySelector<HTMLElement>(".result-primary-unit");
      const secondaryEl = root.querySelector<HTMLElement>(".result-secondary");
      const rowsGridEl = root.querySelector<HTMLElement>(".result-rows-grid");
      const stepsListEl = root.querySelector<HTMLElement>(".result-steps-list");
      const copyBtn = root.querySelector<HTMLButtonElement>(".calc-copy-btn");
      const copyStatus = root.querySelector<HTMLElement>(".copy-status");
      const resetBtn = root.querySelector<HTMLButtonElement>(".calc-reset-btn");
      const status = root.querySelector<HTMLElement>('.calc-status');
      const notesList = root.querySelector<HTMLElement>('.result-notes-list');

      if (!form || !primaryValEl || !rowsGridEl || !stepsListEl) return;
            const targetPrimaryValEl = primaryValEl;
            const targetRowsGridEl = rowsGridEl;
            const targetStepsListEl = stepsListEl;

            // Mode-gated field visibility: fields hidden by visibleWhen resolve to
            // their default value so calculations stay valid in every mode.
            function readControlValues() {
              const state: Record<string, number> = {};
              model.fields.forEach((f) => {
                const el = form?.querySelector<HTMLInputElement>(`#${slug}-${f.id}`);
                const raw = el?.value ?? String(f.value ?? '');
                state[f.id] = raw === '' ? Number.NaN : Number(raw);
              });
              return state;
            }
            function fieldVisible(f: Field, state: Record<string, number>) {
              if (!f.visibleWhen) return true;
              const ctrl = state[f.visibleWhen.field];
              if (f.visibleWhen.equals !== undefined) return ctrl === f.visibleWhen.equals;
              return (f.visibleWhen.in ?? []).includes(ctrl);
            }
            function updateVisibility() {
              const state = readControlValues();
              model.fields.forEach((f) => {
                if (!f.visibleWhen) return;
                const wrap = root.querySelector<HTMLElement>(`#${slug}-field-${f.id}`);
                if (wrap) wrap.hidden = !fieldVisible(f, state);
              });
            }

            function calculate(focusError = false) {
              const rawInputs: Record<string, string> = {};
              const rawUnits: Record<string, string> = {};

              // Clear previous field errors
              root.querySelectorAll<HTMLElement>("[role='alert']").forEach((el) => {
                el.classList.add("hidden");
                el.textContent = "";
              });
              form?.querySelectorAll('[aria-invalid]').forEach(el => el.removeAttribute('aria-invalid'));

              const state = readControlValues();

              // Collect all inputs
              model.fields.forEach((field) => {
                const inputEl = form?.querySelector<HTMLInputElement>(`#${slug}-${field.id}`);
                if (inputEl) {
                                  if (field.visibleWhen && !fieldVisible(field, state)) {
                                    // Hidden in the current mode: use the field default so the
                                    // calculation is identical to leaving it untouched.
                                    rawInputs[field.id] = field.optional ? '' : (field.value !== undefined ? String(field.value) : String(field.min ?? 0));
                                  } else {
                                    rawInputs[field.id] = inputEl.value;
                                  }
                                }
                const unitSelect = form?.querySelector<HTMLSelectElement>(`#${slug}-${field.id}-unit`);
                if (unitSelect) {
                  rawUnits[field.id] = unitSelect.value;
                } else if (field.unit) {
                  rawUnits[field.id] = field.unit;
                }
              });

        try {
          const parsed = readInputs(model.fields, rawInputs, rawUnits);
          const result = model.calculate(parsed, rawUnits);
          if (status) status.textContent = 'Results updated.';
          if (copyBtn) copyBtn.disabled = false;
          if (notesList) {
            notesList.replaceChildren(...result.notes.map(note => {
              const li = document.createElement('li');
              li.textContent = note;
              return li;
            }));
          }

          if (!result.rows || result.rows.length === 0) return;

          const primaryRow = result.rows[0];
          const remainingRows = result.rows.slice(1);

          // Update primary hero badge
          targetPrimaryValEl.textContent = fmt(primaryRow.value);
          if (primaryUnitEl) {
            primaryUnitEl.textContent = unitLabels[primaryRow.unit] ?? primaryRow.unit;
          }
          if (secondaryEl) {
            secondaryEl.textContent = primaryRow.label;
          }

          // Update secondary rows grid
          targetRowsGridEl.innerHTML = "";
          remainingRows.forEach((r) => {
            const card = document.createElement("div");
            card.className = "rounded-lg border border-border bg-card p-3 shadow-xs";
            card.innerHTML = `
              <p class="text-[11px] font-mono text-muted-foreground break-words">${r.label}</p>
              <p class="text-lg font-bold font-mono text-foreground mt-0.5">${fmt(r.value)} <span class="text-xs font-normal text-muted-foreground">${unitLabels[r.unit] ?? r.unit}</span></p>
            `;
            targetRowsGridEl.appendChild(card);
          });

          // Update steps
          targetStepsListEl.innerHTML = "";
          result.steps.forEach((s) => {
            const li = document.createElement("li");
            li.textContent = s;
            targetStepsListEl.appendChild(li);
          });

          // Store for copying
          root.dataset.lastCalculated = result.rows.map(r => `${r.label}: ${fmt(r.value)} ${unitLabels[r.unit] ?? r.unit}`).join('\n');
        } catch (err: any) {
          delete root.dataset.lastCalculated;
          if (copyBtn) copyBtn.disabled = true;
          targetPrimaryValEl.textContent = '—';
          if (primaryUnitEl) primaryUnitEl.textContent = '';
          if (secondaryEl) secondaryEl.textContent = 'Check the inputs to calculate a new result.';
          targetRowsGridEl.replaceChildren();
          targetStepsListEl.replaceChildren();
          notesList?.replaceChildren();
          if (status) status.textContent = err.message || 'Unable to calculate. Check your inputs.';
          if (err.field) {
            const input = form?.querySelector<HTMLInputElement>(`#${slug}-${err.field}`);
            input?.setAttribute('aria-invalid', 'true');
            if (focusError) input?.focus();
            const errEl = root.querySelector<HTMLElement>(`#${slug}-${err.field}-err`);
            if (errEl) {
              errEl.textContent = err.message;
              errEl.classList.remove("hidden");
            }
          }
        }
      }

      // Live calculation on input change
            form.addEventListener("input", () => { updateVisibility(); calculate(); });
            form.addEventListener("change", () => { updateVisibility(); calculate(); });
            form.addEventListener('submit', event => { event.preventDefault(); updateVisibility(); calculate(true); });

            // Reset handler
            resetBtn?.addEventListener("click", () => {
              model.fields.forEach((field) => {
                const inputEl = form.querySelector<HTMLInputElement>(`#${slug}-${field.id}`);
                if (inputEl) {
                  inputEl.value = field.value !== undefined ? String(field.value) : "";
                }
                const unitSelect = form.querySelector<HTMLSelectElement>(`#${slug}-${field.id}-unit`);
                if (unitSelect && field.unit) {
                  unitSelect.value = field.unit;
                }
              });
              updateVisibility();
              calculate();
            });

      // Copy handler
      copyBtn?.addEventListener("click", async () => {
        const textToCopy = root.dataset.lastCalculated;
        if (!textToCopy) return;
        try {
          await navigator.clipboard.writeText(textToCopy);
          if (copyStatus) {
            copyStatus.textContent = "Copied!";
            setTimeout(() => {
              copyStatus.textContent = "Copy Result";
            }, 2000);
          }
        } catch {
          if (copyStatus) copyStatus.textContent = 'Copy unavailable';
          if (status) status.textContent = 'Clipboard access was unavailable. Select and copy the displayed results manually.';
        }
      });

      // Run initial calculation immediately on page mount
            updateVisibility();
            calculate();
    });
  }

  // Initialize on load and on Astro page transitions
  initCalculators();
  document.addEventListener("astro:page-load", initCalculators);
</script>
