          if(isFinite(price)&&price>0) costText=`${fmtCurrency(areaW*price)} at ${fmt(price)}/ft²`;
        } else if (formulaKey==="quantity") {
          const area = (()=>{ const Ls=inputs.filter(i=> i.id==="length"||i.id==="width").map(inp=> toFeet(vals[inp.id], getUnit(inp.id))); return Ls.slice(0,2).reduce((a,b)=>a*b,1); })();
          const areaW=area*wasteF, qty=Math.ceil(areaW);
          primary=`${fmt(qty,0)} units`;
          secondary=`${fmt(area,1)} ft² + ${waste}% → ${fmt(qty,0)}`;
          breakdown=`<div><p class="font-mono text-[11px] text-muted-foreground">Area</p><p class="font-semibold">${fmt(area,1)} ft²</p></div><div><p class="font-mono text-[11px] text-muted-foreground">With waste</p><p class="font-semibold">${fmt(areaW,1)} ft²</p></div><div><p class="font-mono text-[11px] text-muted-foreground">Quantity</p><p class="font-semibold">${qty}</p></div>`;
          if(isFinite(price)&&price>0) costText=`${fmtCurrency(qty*price)} at ${fmt(price)}/unit`;
        } else {
          // default volume: product of all length inputs
          let cuFt=1, cnt=0;
          inputs.forEach(inp=>{
            const v=vals[inp.id], u=getUnit(inp.id);
            // skip non-length like count, steps, joint etc.
            if (inp.id==="count"||inp.id==="steps"||inp.id==="joint"||inp.id==="brick_length"||inp.id==="brick_height"||inp.id==="unit_weight"||inp.id==="unit_price"||inp.id==="coats"||inp.id==="coverage"||inp.id==="quantity"||inp.id==="spacing"||inp.id==="size"||inp.id==="density") return;
            if (!isFinite(v)) return;
            // volume-like? if unit is yd3, treat as cuFt directly
            let f=toFeet(v,u);
            // if input is thickness/depth in ft etc, already toFeet
            // For generic, assume all are lengths in ft → multiply.
            // But if unit is yd3/m3, we need volToCuFt
            if (u==="yd3"||u==="yd³"||u==="m3"||u==="ft3") f=volToCuFt(v,u); // but then multiplying length*volume is wrong; for fallback we treat all as linear
            // To avoid double, for generic we assume ft
            if (!isFinite(f)) return;
            cuFt*=f; cnt++;
          });
          if(cnt===0) cuFt=0;
          // if only 2 inputs, treat as area * 1? But we treat as volume of 1 ft thick? Better fallback to product
          // For generic volume with 3 inputs, cuFt is correct; with 2 inputs, we have area not volume
          // Detect: if cnt===2, then we had L*W only, so cuFt is area; we need to interpret as area
          // We'll check: if inputs length ===2 and no depth, then we actually have area, not volume
          // So for cnt===2, set cuFt as area, and cuYd = cuFt/27 is misleading but follow previous generic behavior: cuFt = L*W*D where D is missing → we already multiplied only 2, so cuFt is area; but we display as yd³? Need to decide.
          // For now follow original: cuFt = product(all toFeet). So if 2 inputs, it's area (ft²) but we still treat as cuFt for backward compat? Instead we should treat as area.
          // We'll detect and show area if cnt===2
          if (cnt===2) {
            const area=cuFt, areaW=area*wasteF;
            primary=`${fmt(areaW,1)} ft²`;
            secondary=`${fmt(area,1)} ft² + ${waste}%`;
            breakdown=`<div><p class="font-mono text-[11px] text-muted-foreground">Area</p><p class="font-semibold">${fmt(area,1)} ft²</p></div><div><p class="font-mono text-[11px] text-muted-foreground">With waste</p><p class="font-semibold">${fmt(areaW,1)} ft²</p></div>`;
          } else {
            const cuYd=cuFt/27, cuYdW=cuYd*wasteF, cuFtW=cuFt*wasteF;
            // Handle quantity modifier for slab count etc if present
            const qty=vals["count"]||vals["quantity"]||1;
            const adjCuFt=cuFt*(qty||1), adjYd=adjCuFt/27, adjFtW=adjCuFt*wasteF, adjYdW=adjYd*wasteF;
            // If qty present and not already counted, use adj
            const finalCuFt= (qty&& qty!==1 && !inputs.some(i=>i.id==="length"&& i.id==="width"))? adjCuFt : cuFt;
            // Simpler: if we used cnt to count all length inputs, qty duplication is not handled; we used all inputs product, so if count was included as numeric without unit, it would have been skipped above. So we need to multiply by qty manually if present.
            const finalYd= finalCuFt/27, finalYdW=finalYd*wasteF, finalFtW=finalCuFt*wasteF;
            // Use qty if original product didn't include it
            const useQty = (vals["count"]||vals["quantity"]) && !inputs.some(i=> i.id.includes("count") && toFeet(vals[i.id], getUnit(i.id))===vals[i.id]);
            // Actually we skipped count, so finalCuFt is without qty; apply qty
            const qtyVal = vals["count"]||vals["quantity"]||1;
            const dispCuFt = cuFt * (qtyVal||1), dispYd=dispCuFt/27, dispW=dispCuFt*wasteF, dispYdW=dispYd*wasteF;
            primary=`${fmt(dispYdW,2)} yd³`;
            secondary=`${fmt(dispW,2)} ft³ with ${waste}% waste${qtyVal>1?` × ${qtyVal} units`:""}`;
            breakdown=`<div><p class="font-mono text-[11px] text-muted-foreground">Cubic yards</p><p class="font-semibold tabular-nums">${fmt(dispYd,2)} → ${fmt(dispYdW,2)} w/ waste</p></div><div><p class="font-mono text-[11px] text-muted-foreground">Cubic feet</p><p class="font-semibold tabular-nums">${fmt(dispCuFt,2)} → ${fmt(dispW,2)}</p></div><div><p class="font-mono text-[11px] text-muted-foreground">Waste</p><p class="font-semibold">${waste}%</p></div>`;
            if(isFinite(price)&&price>0){
              let c, lbl="/yd³";
              if(priceUnit==="ton"){ c=dispYdW*2.025*price; lbl="/ton"; }
              else if(priceUnit==="unit"){ c=dispYdW*price; }
              else { c=dispYdW*price; lbl=priceUnit==="yd"?"/yd³":`/${priceUnit}`; }
              costText=`${fmtCurrency(c)} at ${fmt(price)}${lbl} incl. waste`;
            }
          }
        }
      }
    } catch (err) {
      primary = "Error — check inputs";
      console.error(err);
    }

    $(`${id}-primary`).textContent = primary;
    $(`${id}-secondary`).textContent = secondary;
    $(`${id}-breakdown`).innerHTML = breakdown;
    $(`${id}-cost`).textContent = costText;
    results.classList.remove("hidden");
    results.scrollIntoView({behavior:"smooth", block:"nearest"});
  });

  $(`${id}-reset`)?.addEventListener("click", () => {
    clearErrors();
    results.classList.add("hidden");
  });

})();
</script>
