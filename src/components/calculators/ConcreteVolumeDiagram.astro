---
const slug = "concrete-volume-calculator";
---

<figure
  class="calc-project-diagram rounded-xl border border-border bg-card p-4 sm:p-5"
  data-project-diagram
  data-concrete-volume-rich-diagram
  data-kind="concreteVolume"
>
  <div class="flex flex-wrap items-start justify-between gap-2">
    <div>
      <h3 class="text-xs font-mono font-semibold uppercase tracking-wider text-foreground">Live concrete volume diagram</h3>
      <p class="mt-1 max-w-[650px] text-[11px] leading-5 text-muted-foreground">
        Technical plan, elevation and section views update for all nine supported concrete shapes. Schematic only — not to scale.
      </p>
    </div>
    <span class="rounded-full border border-border bg-muted px-2 py-1 font-mono text-[10px] text-muted-foreground">LIVE INPUT GUIDE</span>
  </div>

  <div class="mt-4 overflow-hidden rounded-xl border border-border bg-background">
    <svg viewBox="0 0 760 450" class="h-auto w-full" role="img" aria-labelledby={`${slug}-rich-title ${slug}-rich-desc`}>
      <title id={`${slug}-rich-title`}>Live concrete volume geometry diagram</title>
      <desc id={`${slug}-rich-desc`}>
        Technical drawings for rectangular slabs, cylinders, hollow tubes, curb and gutter, stairs, wedges, walls, strip footings and rectangular columns. Labels update from calculator inputs.
      </desc>
      <defs>
        <marker id="cv-arrow-start" markerWidth="8" markerHeight="8" refX="1" refY="4" orient="auto"><path d="M8 0 L0 4 L8 8 Z" fill="#2563eb" /></marker>
        <marker id="cv-arrow-end" markerWidth="8" markerHeight="8" refX="7" refY="4" orient="auto"><path d="M0 0 L8 4 L0 8 Z" fill="#2563eb" /></marker>
        <pattern id="cv-concrete" width="18" height="18" patternUnits="userSpaceOnUse">
          <rect width="18" height="18" fill="var(--color-muted)" opacity="0.7"/>
          <circle cx="4" cy="5" r="1.1" fill="var(--color-muted-foreground)" opacity="0.28"/>
          <circle cx="14" cy="11" r="0.9" fill="var(--color-muted-foreground)" opacity="0.24"/>
          <circle cx="8" cy="16" r="0.7" fill="var(--color-muted-foreground)" opacity="0.2"/>
        </pattern>
        <pattern id="cv-soil" width="14" height="14" patternUnits="userSpaceOnUse" patternTransform="rotate(22)">
          <rect width="14" height="14" fill="var(--color-muted)" opacity="0.18"/>
          <line x1="0" y1="0" x2="0" y2="14" stroke="var(--color-muted-foreground)" stroke-width="1" opacity="0.24"/>
        </pattern>
      </defs>

      <rect width="760" height="450" fill="var(--color-background)"/>
      <text x="28" y="30" font-size="13" font-weight="700" fill="var(--color-foreground)" data-concrete-volume-shape-name>Rectangular slab / prism</text>
      <text x="732" y="30" text-anchor="end" font-size="11" fill="var(--color-muted-foreground)">Dimensions follow calculator inputs</text>

      <!-- 0: Rectangular slab / prism -->
      <g data-concrete-volume-shape="0">
        <text x="42" y="62" font-size="11" font-weight="700" fill="var(--color-foreground)">TOP VIEW (PLAN)</text>
        <rect x="90" y="106" width="360" height="155" rx="3" fill="url(#cv-concrete)" stroke="var(--color-foreground)" stroke-width="2"/>
        <line x1="90" y1="86" x2="450" y2="86" stroke="#2563eb" stroke-width="1.7" marker-start="url(#cv-arrow-start)" marker-end="url(#cv-arrow-end)"/>
        <text x="270" y="76" text-anchor="middle" font-size="13" font-weight="700" fill="#1d4ed8" data-cv-length>Length = 20 ft</text>
        <line x1="69" y1="106" x2="69" y2="261" stroke="#2563eb" stroke-width="1.7" marker-start="url(#cv-arrow-start)" marker-end="url(#cv-arrow-end)"/>
        <text x="51" y="184" text-anchor="middle" font-size="13" font-weight="700" fill="#1d4ed8" transform="rotate(-90 51 184)" data-cv-width>Width = 10 ft</text>

        <text x="512" y="62" font-size="11" font-weight="700" fill="var(--color-foreground)">SIDE VIEW (SECTION)</text>
        <rect x="520" y="135" width="190" height="45" fill="url(#cv-concrete)" stroke="var(--color-foreground)" stroke-width="2"/>
        <rect x="520" y="180" width="190" height="48" fill="url(#cv-soil)"/>
        <line x1="730" y1="135" x2="730" y2="180" stroke="#2563eb" stroke-width="1.7" marker-start="url(#cv-arrow-start)" marker-end="url(#cv-arrow-end)"/>
        <text x="716" y="202" text-anchor="end" font-size="12" font-weight="700" fill="#1d4ed8" data-cv-depth>Thickness = 4 in</text>
      </g>

      <!-- 1: Round slab / cylinder -->
      <g data-concrete-volume-shape="1" style="display:none">
        <text x="42" y="62" font-size="11" font-weight="700" fill="var(--color-foreground)">TOP VIEW (PLAN)</text>
        <circle cx="260" cy="175" r="95" fill="url(#cv-concrete)" stroke="var(--color-foreground)" stroke-width="2"/>
        <line x1="165" y1="175" x2="355" y2="175" stroke="#2563eb" stroke-width="1.7" marker-start="url(#cv-arrow-start)" marker-end="url(#cv-arrow-end)"/>
        <text x="260" y="155" text-anchor="middle" font-size="13" font-weight="700" fill="#1d4ed8" data-cv-diameter>Diameter = 12 in</text>

        <text x="505" y="62" font-size="11" font-weight="700" fill="var(--color-foreground)">SIDE ELEVATION</text>
        <ellipse cx="610" cy="112" rx="72" ry="22" fill="url(#cv-concrete)" stroke="var(--color-foreground)" stroke-width="2"/>
        <rect x="538" y="112" width="144" height="128" fill="url(#cv-concrete)"/>
        <line x1="538" y1="112" x2="538" y2="240" stroke="var(--color-foreground)" stroke-width="2"/>
        <line x1="682" y1="112" x2="682" y2="240" stroke="var(--color-foreground)" stroke-width="2"/>
        <ellipse cx="610" cy="240" rx="72" ry="22" fill="url(#cv-concrete)" stroke="var(--color-foreground)" stroke-width="2"/>
        <line x1="708" y1="112" x2="708" y2="240" stroke="#2563eb" stroke-width="1.7" marker-start="url(#cv-arrow-start)" marker-end="url(#cv-arrow-end)"/>
        <text x="698" y="102" text-anchor="end" font-size="12" font-weight="700" fill="#1d4ed8" data-cv-height>Height = 8 ft</text>
      </g>

      <!-- 2: Hollow tube -->
      <g data-concrete-volume-shape="2" style="display:none">
        <text x="42" y="62" font-size="11" font-weight="700" fill="var(--color-foreground)">TOP VIEW (ANNULUS)</text>
        <circle cx="260" cy="175" r="98" fill="url(#cv-concrete)" stroke="var(--color-foreground)" stroke-width="2"/>
        <circle cx="260" cy="175" r="48" fill="var(--color-background)" stroke="var(--color-foreground)" stroke-width="1.7"/>
        <line x1="162" y1="175" x2="358" y2="175" stroke="#2563eb" stroke-width="1.7" marker-start="url(#cv-arrow-start)" marker-end="url(#cv-arrow-end)"/>
        <text x="260" y="145" text-anchor="middle" font-size="12.5" font-weight="700" fill="#1d4ed8" data-cv-diameter>OD = 12 in</text>
        <line x1="212" y1="193" x2="308" y2="193" stroke="#2563eb" stroke-width="1.5" marker-start="url(#cv-arrow-start)" marker-end="url(#cv-arrow-end)"/>
        <text x="260" y="215" text-anchor="middle" font-size="12" font-weight="700" fill="#1d4ed8" data-cv-inner>ID = 6 in</text>

        <text x="505" y="62" font-size="11" font-weight="700" fill="var(--color-foreground)">SIDE ELEVATION</text>
        <path d="M548 108 H672 V240 H548 Z" fill="url(#cv-concrete)" stroke="var(--color-foreground)" stroke-width="2"/>
        <rect x="580" y="108" width="60" height="132" fill="var(--color-background)" stroke="var(--color-muted-foreground)" stroke-width="1.5" stroke-dasharray="5 4"/>
        <line x1="704" y1="108" x2="704" y2="240" stroke="#2563eb" stroke-width="1.7" marker-start="url(#cv-arrow-start)" marker-end="url(#cv-arrow-end)"/>
        <text x="694" y="98" text-anchor="end" font-size="12" font-weight="700" fill="#1d4ed8" data-cv-height>Height = 8 ft</text>
      </g>

      <!-- 3: Curb + gutter -->
      <g data-concrete-volume-shape="3" style="display:none">
        <text x="42" y="62" font-size="11" font-weight="700" fill="var(--color-foreground)">PLAN / RUN LENGTH</text>
        <rect x="80" y="138" width="395" height="64" fill="url(#cv-concrete)" stroke="var(--color-foreground)" stroke-width="2"/>
        <line x1="80" y1="112" x2="475" y2="112" stroke="#2563eb" stroke-width="1.7" marker-start="url(#cv-arrow-start)" marker-end="url(#cv-arrow-end)"/>
        <text x="278" y="102" text-anchor="middle" font-size="13" font-weight="700" fill="#1d4ed8" data-cv-length>Length = 20 ft</text>

        <text x="515" y="62" font-size="11" font-weight="700" fill="var(--color-foreground)">CURB + GUTTER SECTION</text>
        <path d="M520 228 H710 V183 H606 V118 H555 V183 H520 Z" fill="url(#cv-concrete)" stroke="var(--color-foreground)" stroke-width="2"/>
        <line x1="555" y1="100" x2="606" y2="100" stroke="#2563eb" stroke-width="1.5" marker-start="url(#cv-arrow-start)" marker-end="url(#cv-arrow-end)"/>
        <text x="580" y="90" text-anchor="middle" font-size="11.5" font-weight="700" fill="#1d4ed8" data-cv-curb-width>Curb width = 6 in</text>
        <line x1="725" y1="118" x2="725" y2="228" stroke="#2563eb" stroke-width="1.5" marker-start="url(#cv-arrow-start)" marker-end="url(#cv-arrow-end)"/>
        <text x="714" y="110" text-anchor="end" font-size="11.5" font-weight="700" fill="#1d4ed8" data-cv-curb-height>Height = 12 in</text>
        <text x="615" y="252" text-anchor="middle" font-size="10.5" fill="var(--color-muted-foreground)" data-cv-gutter>Gutter: 18 in × 6 in</text>
      </g>

      <!-- 4: Solid stairs -->
      <g data-concrete-volume-shape="4" style="display:none">
        <text x="42" y="62" font-size="11" font-weight="700" fill="var(--color-foreground)">SIDE SECTION</text>
        <path d="M82 250 H452 V214 H382 V178 H312 V142 H242 V106 H172 V250 Z" fill="url(#cv-concrete)" stroke="var(--color-foreground)" stroke-width="2"/>
        <line x1="172" y1="88" x2="242" y2="88" stroke="#2563eb" stroke-width="1.5" marker-start="url(#cv-arrow-start)" marker-end="url(#cv-arrow-end)"/>
        <text x="207" y="78" text-anchor="middle" font-size="11.5" font-weight="700" fill="#1d4ed8" data-cv-run>Run = 11 in</text>
        <line x1="154" y1="106" x2="154" y2="142" stroke="#2563eb" stroke-width="1.5" marker-start="url(#cv-arrow-start)" marker-end="url(#cv-arrow-end)"/>
        <text x="143" y="99" text-anchor="end" font-size="11.5" font-weight="700" fill="#1d4ed8" data-cv-rise>Rise = 7 in</text>
        <text x="290" y="276" text-anchor="middle" font-size="11" fill="var(--color-muted-foreground)" data-cv-steps>4 steps</text>

        <text x="515" y="62" font-size="11" font-weight="700" fill="var(--color-foreground)">PLAN WIDTH</text>
        <rect x="555" y="120" width="120" height="132" fill="url(#cv-concrete)" stroke="var(--color-foreground)" stroke-width="2"/>
        <line x1="537" y1="120" x2="537" y2="252" stroke="#2563eb" stroke-width="1.5" marker-start="url(#cv-arrow-start)" marker-end="url(#cv-arrow-end)"/>
        <text x="525" y="186" text-anchor="middle" font-size="12" font-weight="700" fill="#1d4ed8" transform="rotate(-90 525 186)" data-cv-stair-width>Width = 4 ft</text>
        <text x="615" y="276" text-anchor="middle" font-size="10.5" fill="var(--color-muted-foreground)" data-cv-landing>Top landing = 0 ft</text>
      </g>

      <!-- 5: Triangular wedge -->
      <g data-concrete-volume-shape="5" style="display:none">
        <text x="42" y="62" font-size="11" font-weight="700" fill="var(--color-foreground)">TRIANGULAR CROSS SECTION</text>
        <path d="M95 250 H440 L440 105 Z" fill="url(#cv-concrete)" stroke="var(--color-foreground)" stroke-width="2"/>
        <line x1="95" y1="272" x2="440" y2="272" stroke="#2563eb" stroke-width="1.6" marker-start="url(#cv-arrow-start)" marker-end="url(#cv-arrow-end)"/>
        <text x="268" y="294" text-anchor="middle" font-size="12.5" font-weight="700" fill="#1d4ed8" data-cv-base>Base = 36 in</text>
        <line x1="462" y1="105" x2="462" y2="250" stroke="#2563eb" stroke-width="1.6" marker-start="url(#cv-arrow-start)" marker-end="url(#cv-arrow-end)"/>
        <text x="450" y="98" text-anchor="end" font-size="12.5" font-weight="700" fill="#1d4ed8" data-cv-tri-height>Rise = 12 in</text>

        <text x="520" y="62" font-size="11" font-weight="700" fill="var(--color-foreground)">PRISM LENGTH</text>
        <polygon points="535,150 642,108 704,145 598,188" fill="url(#cv-concrete)" stroke="var(--color-foreground)" stroke-width="2"/>
        <line x1="548" y1="218" x2="690" y2="165" stroke="#2563eb" stroke-width="1.5" marker-start="url(#cv-arrow-start)" marker-end="url(#cv-arrow-end)"/>
        <text x="620" y="232" text-anchor="middle" font-size="12" font-weight="700" fill="#1d4ed8" data-cv-wedge-length>Length = 10 ft</text>
      </g>

      <!-- 6: Concrete wall -->
      <g data-concrete-volume-shape="6" style="display:none">
        <text x="42" y="62" font-size="11" font-weight="700" fill="var(--color-foreground)">FRONT ELEVATION</text>
        <rect x="88" y="100" width="390" height="160" fill="url(#cv-concrete)" stroke="var(--color-foreground)" stroke-width="2"/>
        <line x1="88" y1="81" x2="478" y2="81" stroke="#2563eb" stroke-width="1.6" marker-start="url(#cv-arrow-start)" marker-end="url(#cv-arrow-end)"/>
        <text x="283" y="71" text-anchor="middle" font-size="13" font-weight="700" fill="#1d4ed8" data-cv-length>Length = 20 ft</text>
        <line x1="67" y1="100" x2="67" y2="260" stroke="#2563eb" stroke-width="1.6" marker-start="url(#cv-arrow-start)" marker-end="url(#cv-arrow-end)"/>
        <text x="49" y="180" text-anchor="middle" font-size="13" font-weight="700" fill="#1d4ed8" transform="rotate(-90 49 180)" data-cv-height>Height = 8 ft</text>

        <text x="525" y="62" font-size="11" font-weight="700" fill="var(--color-foreground)">TOP SECTION</text>
        <rect x="555" y="125" width="120" height="120" fill="url(#cv-concrete)" stroke="var(--color-foreground)" stroke-width="2"/>
        <line x1="535" y1="125" x2="535" y2="245" stroke="#2563eb" stroke-width="1.6" marker-start="url(#cv-arrow-start)" marker-end="url(#cv-arrow-end)"/>
        <text x="523" y="185" text-anchor="middle" font-size="12" font-weight="700" fill="#1d4ed8" transform="rotate(-90 523 185)" data-cv-thickness>Thickness = 8 in</text>
      </g>

      <!-- 7: Strip footing -->
      <g data-concrete-volume-shape="7" style="display:none">
        <text x="42" y="62" font-size="11" font-weight="700" fill="var(--color-foreground)">TOP VIEW (PLAN)</text>
        <rect x="86" y="135" width="390" height="88" fill="url(#cv-concrete)" stroke="var(--color-foreground)" stroke-width="2"/>
        <line x1="86" y1="112" x2="476" y2="112" stroke="#2563eb" stroke-width="1.6" marker-start="url(#cv-arrow-start)" marker-end="url(#cv-arrow-end)"/>
        <text x="281" y="102" text-anchor="middle" font-size="13" font-weight="700" fill="#1d4ed8" data-cv-length>Length = 20 ft</text>
        <line x1="64" y1="135" x2="64" y2="223" stroke="#2563eb" stroke-width="1.6" marker-start="url(#cv-arrow-start)" marker-end="url(#cv-arrow-end)"/>
        <text x="46" y="179" text-anchor="middle" font-size="12.5" font-weight="700" fill="#1d4ed8" transform="rotate(-90 46 179)" data-cv-width>Width = 10 ft</text>

        <text x="520" y="62" font-size="11" font-weight="700" fill="var(--color-foreground)">FOOTING SECTION</text>
        <rect x="520" y="100" width="190" height="170" fill="url(#cv-soil)"/>
        <rect x="552" y="150" width="126" height="72" fill="url(#cv-concrete)" stroke="var(--color-foreground)" stroke-width="2"/>
        <line x1="700" y1="150" x2="700" y2="222" stroke="#2563eb" stroke-width="1.6" marker-start="url(#cv-arrow-start)" marker-end="url(#cv-arrow-end)"/>
        <text x="690" y="140" text-anchor="end" font-size="12" font-weight="700" fill="#1d4ed8" data-cv-depth>Depth = 4 in</text>
      </g>

      <!-- 8: Rectangular column -->
      <g data-concrete-volume-shape="8" style="display:none">
        <text x="42" y="62" font-size="11" font-weight="700" fill="var(--color-foreground)">TOP VIEW (PLAN)</text>
        <rect x="145" y="105" width="250" height="160" fill="url(#cv-concrete)" stroke="var(--color-foreground)" stroke-width="2"/>
        <line x1="145" y1="85" x2="395" y2="85" stroke="#2563eb" stroke-width="1.6" marker-start="url(#cv-arrow-start)" marker-end="url(#cv-arrow-end)"/>
        <text x="270" y="75" text-anchor="middle" font-size="12.5" font-weight="700" fill="#1d4ed8" data-cv-length>Length = 20 ft</text>
        <line x1="125" y1="105" x2="125" y2="265" stroke="#2563eb" stroke-width="1.6" marker-start="url(#cv-arrow-start)" marker-end="url(#cv-arrow-end)"/>
        <text x="107" y="185" text-anchor="middle" font-size="12.5" font-weight="700" fill="#1d4ed8" transform="rotate(-90 107 185)" data-cv-width>Width = 10 ft</text>

        <text x="520" y="62" font-size="11" font-weight="700" fill="var(--color-foreground)">SIDE ELEVATION</text>
        <rect x="565" y="98" width="112" height="170" fill="url(#cv-concrete)" stroke="var(--color-foreground)" stroke-width="2"/>
        <line x1="704" y1="98" x2="704" y2="268" stroke="#2563eb" stroke-width="1.6" marker-start="url(#cv-arrow-start)" marker-end="url(#cv-arrow-end)"/>
        <text x="694" y="88" text-anchor="end" font-size="12" font-weight="700" fill="#1d4ed8" data-cv-height>Height = 8 ft</text>
      </g>

      <!-- Shared formula + current input panel -->
      <rect x="28" y="320" width="704" height="101" rx="12" fill="var(--color-muted)" opacity="0.23" stroke="var(--color-border)"/>
      <text x="46" y="345" font-size="11" font-weight="700" fill="var(--color-foreground)">ACTIVE FORMULA</text>
      <text x="46" y="374" font-size="18" font-weight="700" fill="var(--color-foreground)" data-cv-formula>V = L × W × T × Q</text>
      <text x="46" y="399" font-size="11.2" fill="var(--color-muted-foreground)" data-cv-note>Rectangular-prism volume.</text>
      <line x1="425" y1="337" x2="425" y2="407" stroke="var(--color-border)"/>
      <text x="448" y="345" font-size="11" font-weight="700" fill="var(--color-foreground)">CURRENT INPUTS</text>
      <text x="448" y="375" font-size="14" font-weight="700" fill="#1d4ed8" data-cv-summary>20 ft × 10 ft × 4 in</text>
      <text x="448" y="399" font-size="11.2" fill="var(--color-muted-foreground)" data-cv-quantity>Identical sections: 1</text>
    </svg>
  </div>

  <dl class="mt-3 grid gap-2 text-xs sm:grid-cols-3">
    <div class="rounded-md border border-border bg-muted/30 px-3 py-2"><dt class="text-muted-foreground">Shape</dt><dd class="mt-0.5 font-mono font-medium text-foreground" data-cv-card-shape>Rectangular slab / prism</dd></div>
    <div class="rounded-md border border-border bg-muted/30 px-3 py-2"><dt class="text-muted-foreground">Primary dimensions</dt><dd class="mt-0.5 font-mono font-medium text-foreground tabular-nums" data-cv-card-summary>20 ft × 10 ft × 4 in</dd></div>
    <div class="rounded-md border border-border bg-muted/30 px-3 py-2"><dt class="text-muted-foreground">Quantity</dt><dd class="mt-0.5 font-mono font-medium text-foreground tabular-nums" data-cv-card-quantity>1 section</dd></div>
  </dl>
</figure>

<script>
  function initConcreteVolumeRichDiagrams() {
    document.querySelectorAll<HTMLElement>("[data-concrete-volume-rich-diagram]").forEach((figure) => {
      if (figure.dataset.initialized) return;
      figure.dataset.initialized = "true";
      const root = figure.closest<HTMLElement>('[data-calculator-slug="concrete-volume-calculator"]');
      if (!root) return;

      const form = root.querySelector<HTMLFormElement>("#concrete-volume-calculator-form");
      const shape = root.querySelector<HTMLSelectElement>("#concrete-volume-calculator-shape");
      if (!shape) return;

      const input = (id: string) => root.querySelector<HTMLInputElement>(`#concrete-volume-calculator-${id}`);
      const unit = (id: string) => root.querySelector<HTMLSelectElement>(`#concrete-volume-calculator-${id}-unit`);
      const val = (id: string) => {
        const raw = input(id)?.value?.trim() ?? "";
        if (!raw) return "—";
        const n = Number(raw);
        const shown = Number.isFinite(n) ? String(Number(n.toFixed(4))) : raw;
        const u = unit(id)?.value ?? "";
        return u ? `${shown} ${u}` : shown;
      };
      const num = (id: string, fallback = 1) => {
        const n = Number(input(id)?.value);
        return Number.isFinite(n) ? n : fallback;
      };
      const set = (selector: string, text: string) => {
        figure.querySelectorAll<SVGTextElement | HTMLElement>(selector).forEach((el) => { el.textContent = text; });
      };

      const names = [
        "Rectangular slab / prism",
        "Round slab / cylinder / column",
        "Hollow tube / annular cylinder",
        "Curb + gutter",
        "Solid stairs (mass fill)",
        "Triangle prism / wedge",
        "Concrete wall",
        "Strip footing",
        "Square / rectangular column",
      ];
      const formulas = [
        "V = L × W × T × Q",
        "V = π × (D ÷ 2)² × H × Q",
        "V = π/4 × (Dₒ² − Dᵢ²) × H × Q",
        "V = L × (Wc × Hc + Wg × Tg) × Q",
        "V = W × R × Run × n(n+1)/2 + landing",
        "V = ½ × B × H × L × Q",
        "V = L × H × T × Q",
        "V = L × W × D × Q",
        "V = L × W × H × Q",
      ];
      const notes = [
        "Rectangular-prism volume.",
        "Circular-prism volume from diameter and height.",
        "Outer cylinder minus the inner cylinder.",
        "Two non-overlapping rectangular cross-sections multiplied by length.",
        "Solid stepped mass plus any full-height top landing.",
        "Right-triangle cross-section multiplied by prism length.",
        "Wall face length × wall height × wall thickness.",
        "Continuous strip-footing volume.",
        "Rectangular-column volume.",
      ];

      const update = () => {
        const mode = Math.max(0, Math.min(8, Math.round(Number(shape.value) || 0)));
        const name = names[mode];
        figure.querySelectorAll<SVGGElement>("[data-concrete-volume-shape]").forEach((g) => {
          g.style.display = g.dataset.concreteVolumeShape === String(mode) ? "" : "none";
        });

        set("[data-concrete-volume-shape-name]", name);
        set("[data-cv-card-shape]", name);
        set("[data-cv-formula]", formulas[mode]);
        set("[data-cv-note]", notes[mode]);

        const q = Math.max(0, num("quantity", 1));
        set("[data-cv-quantity]", `Identical sections: ${q}`);
        set("[data-cv-card-quantity]", `${q} ${q === 1 ? "section" : "sections"}`);

        // Shared labels used by multiple shapes.
        set("[data-cv-length]", `Length = ${val("length")}`);
        set("[data-cv-width]", `Width = ${val("width")}`);
        set("[data-cv-depth]", `${mode === 0 ? "Thickness" : "Depth"} = ${val("depth")}`);
        set("[data-cv-height]", `Height = ${val("height")}`);
        set("[data-cv-thickness]", `Thickness = ${val("thickness")}`);
        set("[data-cv-diameter]", mode === 2 ? `OD = ${val("diameter")}` : `Diameter = ${val("diameter")}`);
        set("[data-cv-inner]", `ID = ${val("innerDiameter")}`);
        set("[data-cv-curb-width]", `Curb width = ${val("curbWidth")}`);
        set("[data-cv-curb-height]", `Height = ${val("curbHeight")}`);
        set("[data-cv-gutter]", `Gutter: ${val("gutterWidth")} × ${val("gutterDepth")}`);
        set("[data-cv-stair-width]", `Width = ${val("stairWidth")}`);
        set("[data-cv-rise]", `Rise = ${val("rise")}`);
        set("[data-cv-run]", `Run = ${val("run")}`);
        set("[data-cv-steps]", `${num("steps", 1)} steps`);
        set("[data-cv-landing]", `Top landing = ${val("landing")}`);
        set("[data-cv-base]", `Base = ${val("base")}`);
        set("[data-cv-tri-height]", `Rise = ${val("triHeight")}`);
        set("[data-cv-wedge-length]", `Length = ${val("wedgeLength")}`);

        let summary = "";
        if (mode === 0 || mode === 7) summary = `${val("length")} × ${val("width")} × ${val("depth")}`;
        else if (mode === 1) summary = `Ø ${val("diameter")} × ${val("height")}`;
        else if (mode === 2) summary = `OD ${val("diameter")} · ID ${val("innerDiameter")} · H ${val("height")}`;
        else if (mode === 3) summary = `${val("length")} · curb ${val("curbWidth")}×${val("curbHeight")} · gutter ${val("gutterWidth")}×${val("gutterDepth")}`;
        else if (mode === 4) summary = `${val("stairWidth")} wide · ${val("rise")} rise · ${val("run")} run · ${num("steps",1)} steps`;
        else if (mode === 5) summary = `${val("base")} base × ${val("triHeight")} rise × ${val("wedgeLength")} length`;
        else if (mode === 6) summary = `${val("length")} × ${val("height")} × ${val("thickness")}`;
        else summary = `${val("length")} × ${val("width")} × ${val("height")}`;

        set("[data-cv-summary]", summary);
        set("[data-cv-card-summary]", summary);
      };

      root.addEventListener("input", update);
      root.addEventListener("change", update);
      form?.addEventListener("reset", () => setTimeout(update, 0));
      update();
      setTimeout(update, 0);
    });
  }

  initConcreteVolumeRichDiagrams();
  document.addEventListener("astro:page-load", initConcreteVolumeRichDiagrams);
</script>
