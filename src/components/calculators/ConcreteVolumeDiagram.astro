<script>
  function initConcreteVolumeRichDiagrams() {
    document.querySelectorAll<HTMLElement>("[data-concrete-volume-rich-diagram]").forEach((figure) => {
      if (figure.dataset.initialized) return;
      figure.dataset.initialized = "true";

      const root = figure.closest<HTMLElement>('[data-calculator-slug="concrete-volume-calculator"]');
      if (!root) return;

      const form = root.querySelector<HTMLFormElement>("#concrete-volume-calculator-form");
      const shape = root.querySelector<HTMLSelectElement>("#concrete-volume-calculator-shape");
      if (!shape) return;

      const input = (id: string) => root.querySelector<HTMLInputElement>(`#concrete-volume-calculator-${id}`);
      const unit = (id: string) => root.querySelector<HTMLSelectElement>(`#concrete-volume-calculator-${id}-unit`);

      const displayUnit = (raw: string | undefined) => {
        const labels: Record<string, string> = { ft: "ft", in: "in", yd: "yd", m: "m", cm: "cm", mm: "mm" };
        return raw ? (labels[raw] ?? raw) : "";
      };

      const value = (id: string) => {
        const raw = input(id)?.value?.trim() ?? "";
        if (!raw) return "—";
        const n = Number(raw);
        const shown = Number.isFinite(n) ? String(Number(n.toFixed(4))) : raw;
        const u = displayUnit(unit(id)?.value);
        return u ? `${shown} ${u}` : shown;
      };

      const numberValue = (id: string, fallback = 0) => {
        const n = Number(input(id)?.value);
        return Number.isFinite(n) ? n : fallback;
      };

      const setText = (selector: string, text: string) => {
        figure.querySelectorAll<SVGTextElement | HTMLElement>(selector).forEach((el) => { el.textContent = text; });
      };

      const names = [
        "Rectangular slab / prism",
        "Round slab / cylinder / column",
        "Hollow tube / annular cylinder",
        "Curb + gutter",
        "Solid stairs (mass fill)",
        "Triangle prism / wedge",
        "Concrete wall",
        "Strip footing",
        "Square / rectangular column",
      ];

      const formulas = [
        "V = L × W × T × Q",
        "V = π × (D ÷ 2)² × H × Q",
        "V = π/4 × (Dₒ² − Dᵢ²) × H × Q",
        "V = L × (Wc × Hc + Wg × Tg) × Q",
        "V = W × R × T × n(n+1)/2 + landing",
        "V = ½ × B × H × L × Q",
        "V = L × H × T × Q",
        "V = L × W × D × Q",
        "V = L × W × H × Q",
      ];

      const notes = [
        "Rectangular prism volume from normalized dimensions.",
        "Circular-prism volume using radius = diameter ÷ 2.",
        "Outer cylinder volume minus the inner void.",
        "Two non-overlapping curb and gutter rectangles multiplied by length.",
        "Solid stepped mass uses the n(n+1)/2 height summation.",
        "Right-triangle cross-section multiplied by prism length.",
        "Wall face length × height × wall thickness.",
        "Continuous footing length × width × depth.",
        "Rectangular column footprint × height.",
      ];

      const update = () => {
        const mode = Math.max(0, Math.min(8, Math.round(Number(shape.value) || 0)));
        const name = names[mode] ?? names[0];

        figure.querySelectorAll<SVGGElement>("[data-cv-shape]").forEach((group) => {
          group.style.display = group.dataset.cvShape === String(mode) ? "" : "none";
        });

        setText("[data-concrete-volume-shape-name]", name);
        setText("[data-cv-card-shape]", name);
        setText("[data-cv-formula]", formulas[mode] ?? formulas[0]);
        setText("[data-cv-note]", notes[mode] ?? notes[0]);

        const qty = Math.max(0, numberValue("quantity", 1));
        const qtyLabel = `${qty} ${qty === 1 ? "section" : "sections"}`;
        setText("[data-cv-quantity]", `Identical sections: ${qty}`);
        setText("[data-cv-card-quantity]", qtyLabel);

        const l = value("length");
        const w = value("width");
        const d = value("depth");
        const t = value("thickness");
        const od = value("diameter");
        const id = value("innerDiameter");
        const h = value("height");

        setText("[data-cv-length]", `Length = ${l}`);
        setText("[data-cv-width]", `Width = ${w}`);
        setText("[data-cv-depth]", `${mode === 0 ? "Thickness" : "Depth"} = ${d}`);
        setText("[data-cv-diameter]", mode === 2 ? `OD = ${od}` : `Diameter = ${od}`);
        setText("[data-cv-inner]", `ID = ${id}`);
        setText("[data-cv-height]", `Height = ${h}`);
        setText("[data-cv-thickness]", `Thickness = ${t}`);

        setText("[data-cv-curb-width]", `Curb width = ${value("curbWidth")}`);
        setText("[data-cv-curb-height]", `Curb height = ${value("curbHeight")}`);
        setText("[data-cv-gutter-width]", `Gutter = ${value("gutterWidth")}`);
        setText("[data-cv-gutter-depth]", `Thickness = ${value("gutterDepth")}`);

        setText("[data-cv-stair-width]", `Width = ${value("stairWidth")}`);
        setText("[data-cv-rise]", `Rise = ${value("rise")}`);
        setText("[data-cv-run]", `Run = ${value("run")}`);
        const steps = Math.max(0, numberValue("steps", 0));
        setText("[data-cv-steps]", `${steps} ${steps === 1 ? "step" : "steps"}`);
        setText("[data-cv-landing]", `Landing = ${value("landing")}`);

        setText("[data-cv-base]", `Base = ${value("base")}`);
        setText("[data-cv-tri-height]", `Height = ${value("triHeight")}`);
        setText("[data-cv-wedge-length]", `Length = ${value("wedgeLength")}`);

        let summary = "";
        if (mode === 0) summary = `${l} × ${w} × ${d}`;
        else if (mode === 1) summary = `Ø ${od} × ${h}`;
        else if (mode === 2) summary = `OD ${od} · ID ${id} · H ${h}`;
        else if (mode === 3) summary = `${l} · curb ${value("curbWidth")}×${value("curbHeight")} · gutter ${value("gutterWidth")}×${value("gutterDepth")}`;
        else if (mode === 4) summary = `${value("stairWidth")} wide · ${steps} steps · ${value("rise")} rise · ${value("run")} run`;
        else if (mode === 5) summary = `${value("base")} base × ${value("triHeight")} high × ${value("wedgeLength")} long`;
        else if (mode === 6) summary = `${l} × ${h} × ${t}`;
        else if (mode === 7) summary = `${l} × ${w} × ${d}`;
        else summary = `${l} × ${w} × ${h}`;

        setText("[data-cv-summary]", summary);
        setText("[data-cv-card-summary]", summary);
      };

      root.addEventListener("input", update);
      root.addEventListener("change", update);
      form?.addEventListener("reset", () => setTimeout(update, 0));
      update();
      setTimeout(update, 0);
    });
  }

  initConcreteVolumeRichDiagrams();
  document.addEventListener("astro:page-load", initConcreteVolumeRichDiagrams);
</script>
