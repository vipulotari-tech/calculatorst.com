---
const slug = "brick-calculator";
---

<figure
  class="calc-project-diagram rounded-xl border border-border bg-card p-4 sm:p-5"
  data-project-diagram
  data-brick-rich-diagram
  data-kind="brick"
>
  <div class="flex flex-wrap items-start justify-between gap-2">
    <div>
      <h3 class="text-xs font-mono font-semibold uppercase tracking-wider text-foreground">Live brick wall takeoff</h3>
      <p class="mt-1 max-w-[720px] text-[11px] leading-5 text-muted-foreground">
        Wall area, excluded openings, actual brick face, mortar joint, wythes, allowance, installed bricks, and final order quantity update from the calculator inputs.
      </p>
    </div>
    <span class="rounded-full border border-border bg-muted px-2 py-1 font-mono text-[10px] text-muted-foreground">AREA-BASED TAKEOFF</span>
  </div>

  <div class="mt-4 overflow-hidden rounded-xl border border-border bg-background">
    <svg viewBox="0 0 760 500" class="h-auto w-full" role="img" aria-labelledby="brick-diagram-title brick-diagram-desc">
      <title id="brick-diagram-title">Live brick wall takeoff diagram</title>
      <desc id="brick-diagram-desc">
        Brick wall elevation showing wall dimensions, an excluded opening area, installed brick modules, mortar joints, net wall area, wythes, allowance, installed brick count, and brick order quantity.
      </desc>

      <defs>
        <marker id="brick-arrow-start" markerWidth="8" markerHeight="8" refX="1" refY="4" orient="auto">
          <path d="M8 0 L0 4 L8 8 Z" fill="#2563eb"/>
        </marker>
        <marker id="brick-arrow-end" markerWidth="8" markerHeight="8" refX="7" refY="4" orient="auto">
          <path d="M0 0 L8 4 L0 8 Z" fill="#2563eb"/>
        </marker>
      </defs>

      <text x="30" y="30" font-size="13" font-weight="700" fill="var(--color-foreground)">Wall elevation</text>
      <text x="730" y="30" text-anchor="end" font-size="11" fill="var(--color-muted-foreground)" data-brick-wall-label>20 ft × 8 ft</text>

      <line x1="70" y1="65" x2="520" y2="65" stroke="#2563eb" stroke-width="1.5" marker-start="url(#brick-arrow-start)" marker-end="url(#brick-arrow-end)"/>
      <text x="295" y="52" text-anchor="middle" font-size="12" font-weight="700" fill="#1d4ed8" data-brick-length-label>Length = 20 ft</text>

      <line x1="48" y1="90" x2="48" y2="305" stroke="#2563eb" stroke-width="1.5" marker-start="url(#brick-arrow-start)" marker-end="url(#brick-arrow-end)"/>
      <text x="31" y="198" text-anchor="middle" font-size="12" font-weight="700" fill="#1d4ed8" transform="rotate(-90 31 198)" data-brick-height-label>Height = 8 ft</text>

      <rect x="70" y="90" width="450" height="215" rx="3" fill="var(--color-muted)" opacity=".13" stroke="var(--color-foreground)" stroke-width="1.5"/>
      <g data-brick-grid aria-hidden="true"></g>

      <g data-brick-opening>
        <rect x="257" y="165" width="76" height="140" rx="2" fill="var(--color-background)" stroke="#b45309" stroke-width="1.6" stroke-dasharray="5 4"/>
        <text x="295" y="230" text-anchor="middle" font-size="10.5" font-weight="700" fill="#92400e">EXCLUDED</text>
        <text x="295" y="246" text-anchor="middle" font-size="10" fill="#92400e" data-brick-opening-label>0 ft²</text>
      </g>

      <text x="70" y="330" font-size="10.5" fill="var(--color-muted-foreground)" data-brick-module-label>Installed module = 8 in × 2.625 in</text>
      <text x="520" y="330" text-anchor="end" font-size="10.5" fill="var(--color-muted-foreground)" data-brick-joint-label>Mortar joint = 0.375 in</text>

      <g transform="translate(548 86)">
        <rect x="0" y="0" width="182" height="219" rx="12" fill="var(--color-muted)" opacity=".20" stroke="var(--color-border)"/>
        <text x="16" y="24" font-size="10.5" font-weight="700" fill="var(--color-foreground)">CURRENT TAKEOFF</text>
        <text x="16" y="54" font-size="12" fill="var(--color-muted-foreground)">Net wall area</text>
        <text x="16" y="75" font-size="18" font-weight="700" fill="var(--color-foreground)" data-brick-net-area>160 ft²</text>

        <text x="16" y="105" font-size="12" fill="var(--color-muted-foreground)">Installed bricks</text>
        <text x="16" y="126" font-size="18" font-weight="700" fill="var(--color-foreground)" data-brick-installed>1,098</text>

        <text x="16" y="156" font-size="12" fill="var(--color-muted-foreground)">Order with allowance</text>
        <text x="16" y="178" font-size="20" font-weight="700" fill="#1d4ed8" data-brick-order>1,208 bricks</text>

        <text x="16" y="205" font-size="10.5" fill="var(--color-muted-foreground)" data-brick-wythes>1 wythe · 10% allowance</text>
      </g>

      <rect x="30" y="360" width="700" height="54" rx="10" fill="var(--color-muted)" opacity=".22" stroke="var(--color-border)"/>
      <text x="48" y="382" font-size="10.5" font-weight="700" fill="var(--color-foreground)">TAKEOFF FORMULA</text>
      <text x="48" y="402" font-size="12.5" font-weight="700" fill="var(--color-foreground)">Bricks = net wall area ÷ installed brick module face × wythes</text>
      <text x="712" y="392" text-anchor="end" font-size="12.5" font-weight="700" fill="#1d4ed8" data-brick-formula-live>160 ÷ 0.1458 × 1 = 1,097.14</text>

      <g transform="translate(30 432)">
        <rect x="0" y="0" width="216" height="48" rx="10" fill="var(--color-muted)" opacity=".18" stroke="var(--color-border)"/>
        <text x="14" y="19" font-size="10" fill="var(--color-muted-foreground)">Gross layout check</text>
        <text x="14" y="37" font-size="12" font-weight="700" fill="var(--color-foreground)" data-brick-layout-check>37 courses × 30 bricks/course</text>
      </g>
      <g transform="translate(272 432)">
        <rect x="0" y="0" width="216" height="48" rx="10" fill="var(--color-muted)" opacity=".18" stroke="var(--color-border)"/>
        <text x="14" y="19" font-size="10" fill="var(--color-muted-foreground)">Bricks / ft² / wythe</text>
        <text x="14" y="37" font-size="12" font-weight="700" fill="var(--color-foreground)" data-brick-per-area>6.86</text>
      </g>
      <g transform="translate(514 432)">
        <rect x="0" y="0" width="216" height="48" rx="10" fill="var(--color-muted)" opacity=".18" stroke="var(--color-border)"/>
        <text x="14" y="19" font-size="10" fill="var(--color-muted-foreground)">Spare / allowance bricks</text>
        <text x="14" y="37" font-size="12" font-weight="700" fill="var(--color-foreground)" data-brick-spares>110 bricks</text>
      </g>
    </svg>
  </div>
</figure>

<script>
  function initBrickRichDiagrams() {
    document.querySelectorAll<HTMLElement>("[data-brick-rich-diagram]").forEach((figure) => {
      if (figure.dataset.initialized) return;
      figure.dataset.initialized = "true";

      const root = figure.closest<HTMLElement>('[data-calculator-slug="brick-calculator"]');
      if (!root) return;
      const form = root.querySelector<HTMLFormElement>("#brick-calculator-form");
      const grid = figure.querySelector<SVGGElement>("[data-brick-grid]");
      if (!form || !grid) return;

      const input = (id: string) => root.querySelector<HTMLInputElement>("#brick-calculator-" + id);
      const select = (id: string) => root.querySelector<HTMLSelectElement>("#brick-calculator-" + id);
      const unit = (id: string) => root.querySelector<HTMLSelectElement>("#brick-calculator-" + id + "-unit");

      const unitText = (id: string) => {
        const u = unit(id);
        return u ? (u.options[u.selectedIndex]?.text?.trim() || u.value) : "";
      };

      const displayValue = (id: string) => {
        const raw = input(id)?.value?.trim() ?? "";
        if (!raw) return "—";
        const n = Number(raw);
        const shown = Number.isFinite(n) ? String(Number(n.toFixed(4))) : raw;
        const label = unitText(id);
        return label ? shown + " " + label : shown;
      };

      const feet = (id: string) => {
        const n = Number(input(id)?.value);
        if (!Number.isFinite(n)) return Number.NaN;
        const factors: Record<string, number> = { ft: 1, in: 1 / 12, yd: 3, m: 1 / 0.3048, cm: 1 / 30.48, mm: 1 / 304.8 };
        return n * (factors[unit(id)?.value ?? "ft"] ?? 1);
      };

      const areaFt2 = (id: string) => {
        const n = Number(input(id)?.value);
        if (!Number.isFinite(n)) return Number.NaN;
        const factors: Record<string, number> = {
          ft2: 1, "ft²": 1,
          in2: 1 / 144, "in²": 1 / 144,
          yd2: 9, "yd²": 9,
          m2: 10.7639104167, "m²": 10.7639104167,
          cm2: 0.00107639104167, "cm²": 0.00107639104167,
          mm2: 0.0000107639104167, "mm²": 0.0000107639104167
        };
        return n * (factors[unit(id)?.value ?? "ft2"] ?? 1);
      };

      const num = (id: string, fallback = 0) => {
        const n = Number(input(id)?.value);
        return Number.isFinite(n) ? n : fallback;
      };

      const fmt = (value: number, digits = 2) =>
        Number.isFinite(value) ? String(Number(value.toFixed(digits))) : "—";
      const intText = (value: number) =>
        Number.isFinite(value) ? Math.round(value).toLocaleString("en-US") : "—";

      const setText = (selector: string, text: string) => {
        figure.querySelectorAll<SVGTextElement | HTMLElement>(selector).forEach((el) => {
          el.textContent = text;
        });
      };

      const svgEl = <K extends keyof SVGElementTagNameMap>(name: K, attrs: Record<string, string>) => {
        const el = document.createElementNS("http://www.w3.org/2000/svg", name);
        Object.entries(attrs).forEach(([key, value]) => el.setAttribute(key, value));
        return el;
      };

      const renderGrid = (courses: number, perCourse: number) => {
        while (grid.firstChild) grid.removeChild(grid.firstChild);
        const x0 = 70, x1 = 520, y0 = 90, y1 = 305;
        const shownRows = Math.max(1, Math.min(courses, 20));
        const shownCols = Math.max(1, Math.min(perCourse, 30));
        const rowH = (y1 - y0) / shownRows;
        const colW = (x1 - x0) / shownCols;

        for (let r = 0; r < shownRows; r++) {
          const offset = r % 2 ? colW / 2 : 0;
          for (let c = -1; c <= shownCols; c++) {
            const x = x0 + c * colW + offset;
            const left = Math.max(x0, x);
            const right = Math.min(x1, x + colW);
            if (right <= left) continue;
            grid.appendChild(svgEl("rect", {
              x: String(left + 0.45),
              y: String(y0 + r * rowH + 0.45),
              width: String(Math.max(1, right - left - 0.9)),
              height: String(Math.max(1, rowH - 0.9)),
              fill: (r + c) % 2 === 0 ? "var(--color-muted)" : "var(--color-background)",
              stroke: "var(--color-border)",
              "stroke-width": "0.7"
            }));
          }
        }
      };

      const update = () => {
        const mode = Math.round(Number(select("mode")?.value ?? "0"));
        const knownMode = mode === 1;
        const lengthFt = feet("length");
        const heightFt = feet("height");
        const knownArea = areaFt2("knownArea");
        const openings = Math.max(0, areaFt2("openings"));
        const brickLengthFt = feet("brickLength");
        const brickHeightFt = feet("brickHeight");
        const jointFt = Math.max(0, feet("joint"));
        const wythes = Math.max(1, Math.round(num("wythes", 1)));
        const allowance = Math.max(0, num("waste", 0));

        const grossArea = Number.isFinite(lengthFt) && lengthFt > 0 && Number.isFinite(heightFt) && heightFt > 0
          ? lengthFt * heightFt : 0;
        const netArea = knownMode
          ? (Number.isFinite(knownArea) && knownArea > 0 ? knownArea : 0)
          : Math.max(0, grossArea - (Number.isFinite(openings) ? openings : 0));

        const moduleL = brickLengthFt + jointFt;
        const moduleH = brickHeightFt + jointFt;
        const moduleFace = moduleL > 0 && moduleH > 0 ? moduleL * moduleH : 0;
        const raw = moduleFace > 0 ? netArea / moduleFace * wythes : 0;
        const installed = raw > 0 ? Math.ceil(raw - 1e-12) : 0;
        const order = raw > 0 ? Math.ceil(raw * (1 + allowance / 100) - 1e-12) : 0;
        const spares = Math.max(0, order - installed);
        const courses = !knownMode && moduleH > 0 && heightFt > 0 ? Math.ceil(heightFt / moduleH) : Math.max(1, Math.ceil(Math.sqrt(Math.max(installed, 1))));
        const perCourse = !knownMode && moduleL > 0 && lengthFt > 0 ? Math.ceil(lengthFt / moduleL) : Math.max(1, Math.ceil(Math.max(installed, 1) / courses));
        const perArea = moduleFace > 0 ? 1 / moduleFace : 0;

        renderGrid(courses, perCourse);

        setText("[data-brick-wall-label]", knownMode ? "Known net area mode" : displayValue("length") + " × " + displayValue("height"));
        setText("[data-brick-length-label]", knownMode ? "Known net wall area" : "Length = " + displayValue("length"));
        setText("[data-brick-height-label]", knownMode ? "Area-based layout schematic" : "Height = " + displayValue("height"));
        setText("[data-brick-opening-label]", knownMode ? "already deducted" : fmt(openings) + " ft²");
        setText("[data-brick-module-label]", "Installed module = " + fmt(moduleL * 12, 3) + " in × " + fmt(moduleH * 12, 3) + " in");
        setText("[data-brick-joint-label]", "Mortar joint = " + displayValue("joint"));
        setText("[data-brick-net-area]", fmt(netArea) + " ft²");
        setText("[data-brick-installed]", intText(installed));
        setText("[data-brick-order]", intText(order) + " bricks");
        setText("[data-brick-wythes]", wythes + " " + (wythes === 1 ? "wythe" : "wythes") + " · " + fmt(allowance) + "% allowance");
        setText("[data-brick-formula-live]", fmt(netArea) + " ÷ " + fmt(moduleFace, 4) + " × " + wythes + " = " + fmt(raw));
        setText("[data-brick-layout-check]", courses + " courses × " + perCourse + " bricks/course");
        setText("[data-brick-per-area]", fmt(perArea));
        setText("[data-brick-spares]", intText(spares) + " bricks");

        const opening = figure.querySelector<SVGGElement>("[data-brick-opening]");
        if (opening) opening.style.display = !knownMode && openings > 0 ? "" : "none";
      };

      root.addEventListener("input", update);
      root.addEventListener("change", update);
      root.addEventListener("calculator-state-restored", update);
      form.addEventListener("reset", () => setTimeout(update, 0));
      update();
      queueMicrotask(update);
      requestAnimationFrame(update);
      setTimeout(update, 0);
    });
  }

  initBrickRichDiagrams();
  document.addEventListener("astro:page-load", initBrickRichDiagrams);
</script>
