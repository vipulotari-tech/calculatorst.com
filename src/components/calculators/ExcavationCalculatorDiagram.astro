---
const slug = "excavation-calculator";
---

<figure
  class="calc-project-diagram rounded-xl border border-border bg-card p-4 sm:p-5"
  data-project-diagram
  data-excavation-rich-diagram
  data-kind="excavation"
>
  <div class="flex flex-wrap items-start justify-between gap-2">
    <div>
      <h3 class="text-xs font-mono font-semibold uppercase tracking-wider text-foreground">Live excavation quantity diagram</h3>
      <p class="mt-1 max-w-[720px] text-[11px] leading-5 text-muted-foreground">
        Bottom dimensions, excavation depth, side slope, identical excavations, bank volume, swell, top opening, and loose haul volume update directly from the calculator inputs.
      </p>
    </div>
    <span class="rounded-full border border-border bg-muted px-2 py-1 font-mono text-[10px] text-muted-foreground">BANK → LOOSE</span>
  </div>

  <div class="mt-4 overflow-hidden rounded-xl border border-border bg-background">
    <svg viewBox="0 0 760 500" class="h-auto w-full" role="img" aria-labelledby="exc-diagram-title exc-diagram-desc">
      <title id="exc-diagram-title">Live excavation bank and loose-volume diagram</title>
      <desc id="exc-diagram-desc">
        Plan and cross-section views of an excavation showing bottom length and width, top opening created by side slopes, depth, bank volume, swell percentage, quantity, and loose haul volume.
      </desc>

      <defs>
        <marker id="exc-arrow-start" markerWidth="8" markerHeight="8" refX="1" refY="4" orient="auto">
          <path d="M8 0 L0 4 L8 8 Z" fill="#2563eb"/>
        </marker>
        <marker id="exc-arrow-end" markerWidth="8" markerHeight="8" refX="7" refY="4" orient="auto">
          <path d="M0 0 L8 4 L0 8 Z" fill="#2563eb"/>
        </marker>
        <pattern id="exc-earth" width="20" height="16" patternUnits="userSpaceOnUse">
          <path d="M0 12 L5 8 L9 12 L14 6 L20 11" fill="none" stroke="var(--color-muted-foreground)" stroke-width="1" opacity=".35"/>
        </pattern>
      </defs>

      <text x="30" y="30" font-size="13" font-weight="700" fill="var(--color-foreground)">Excavation plan</text>
      <text x="730" y="30" text-anchor="end" font-size="11" fill="var(--color-muted-foreground)" data-exc-quantity-label>1 excavation</text>

      <rect x="72" y="92" width="360" height="190" rx="4" fill="none" stroke="var(--color-muted-foreground)" stroke-width="1.2" stroke-dasharray="7 5" opacity=".55"/>
      <rect x="96" y="113" width="312" height="148" rx="3" fill="url(#exc-earth)" stroke="var(--color-foreground)" stroke-width="1.8"/>

      <line x1="96" y1="82" x2="408" y2="82" stroke="#2563eb" stroke-width="1.5" marker-start="url(#exc-arrow-start)" marker-end="url(#exc-arrow-end)"/>
      <text x="252" y="68" text-anchor="middle" font-size="12" font-weight="700" fill="#1d4ed8" data-exc-bottom-length>Bottom length = 20 ft</text>

      <line x1="55" y1="113" x2="55" y2="261" stroke="#2563eb" stroke-width="1.5" marker-start="url(#exc-arrow-start)" marker-end="url(#exc-arrow-end)"/>
      <text x="37" y="187" text-anchor="middle" font-size="12" font-weight="700" fill="#1d4ed8" transform="rotate(-90 37 187)" data-exc-bottom-width>Bottom width = 10 ft</text>

      <text x="252" y="303" text-anchor="middle" font-size="10.5" fill="var(--color-muted-foreground)" data-exc-top-plan>Top opening = 20 ft × 10 ft</text>

      <text x="485" y="60" font-size="11" font-weight="700" fill="var(--color-foreground)">CROSS SECTION</text>
      <path d="M505 112 L705 112 L661 268 L549 268 Z" fill="url(#exc-earth)" stroke="var(--color-foreground)" stroke-width="1.7"/>
      <line x1="549" y1="268" x2="661" y2="268" stroke="#2563eb" stroke-width="1.5"/>
      <text x="605" y="286" text-anchor="middle" font-size="10.5" fill="#1d4ed8" data-exc-section-bottom>Bottom width = 10 ft</text>

      <line x1="725" y1="112" x2="725" y2="268" stroke="#2563eb" stroke-width="1.5" marker-start="url(#exc-arrow-start)" marker-end="url(#exc-arrow-end)"/>
      <text x="710" y="190" text-anchor="middle" font-size="11.5" font-weight="700" fill="#1d4ed8" transform="rotate(-90 710 190)" data-exc-depth>Depth = 4 ft</text>

      <text x="605" y="148" text-anchor="middle" font-size="11" fill="var(--color-muted-foreground)" data-exc-slope>Side slope = 0H:1V</text>
      <text x="605" y="168" text-anchor="middle" font-size="10.5" fill="var(--color-muted-foreground)">Slope input is geometry only, not a safety recommendation</text>

      <rect x="30" y="338" width="700" height="66" rx="10" fill="var(--color-muted)" opacity=".22" stroke="var(--color-border)"/>
      <text x="48" y="361" font-size="10.5" font-weight="700" fill="var(--color-foreground)">BANK VOLUME</text>
      <text x="48" y="384" font-size="12.5" font-weight="700" fill="var(--color-foreground)">Integrate expanding rectangle from bottom to top</text>
      <text x="712" y="374" text-anchor="end" font-size="13" font-weight="700" fill="#1d4ed8" data-exc-bank>29.63 bank yd³</text>
      <text x="712" y="394" text-anchor="end" font-size="10.5" fill="var(--color-muted-foreground)" data-exc-bank-ft3>800 ft³ in-place</text>

      <g transform="translate(30 428)">
        <rect x="0" y="0" width="216" height="50" rx="10" fill="var(--color-muted)" opacity=".18" stroke="var(--color-border)"/>
        <text x="14" y="19" font-size="10" fill="var(--color-muted-foreground)">Top excavation size</text>
        <text x="14" y="38" font-size="12" font-weight="700" fill="var(--color-foreground)" data-exc-top-card>20 ft × 10 ft</text>
      </g>

      <g transform="translate(272 428)">
        <rect x="0" y="0" width="216" height="50" rx="10" fill="var(--color-muted)" opacity=".18" stroke="var(--color-border)"/>
        <text x="14" y="19" font-size="10" fill="var(--color-muted-foreground)">Swell</text>
        <text x="14" y="38" font-size="12" font-weight="700" fill="var(--color-foreground)" data-exc-swell>20%</text>
      </g>

      <g transform="translate(514 428)">
        <rect x="0" y="0" width="216" height="50" rx="10" fill="var(--color-muted)" opacity=".18" stroke="var(--color-border)"/>
        <text x="14" y="19" font-size="10" fill="var(--color-muted-foreground)">Loose haul volume</text>
        <text x="14" y="38" font-size="12" font-weight="700" fill="#1d4ed8" data-exc-loose>35.56 yd³</text>
      </g>
    </svg>
  </div>
</figure>

<script>
  function initExcavationRichDiagrams() {
    document.querySelectorAll<HTMLElement>("[data-excavation-rich-diagram]").forEach((figure) => {
      if (figure.dataset.initialized) return;
      figure.dataset.initialized = "true";

      const root = figure.closest<HTMLElement>('[data-calculator-slug="excavation-calculator"]');
      if (!root) return;
      const form = root.querySelector<HTMLFormElement>("#excavation-calculator-form");
      if (!form) return;

      const input = (id: string) => root.querySelector<HTMLInputElement>("#excavation-calculator-" + id);
      const unit = (id: string) => root.querySelector<HTMLSelectElement>("#excavation-calculator-" + id + "-unit");

      const unitText = (id: string) => {
        const u = unit(id);
        return u ? (u.options[u.selectedIndex]?.text?.trim() || u.value) : "";
      };

      const displayValue = (id: string) => {
        const raw = input(id)?.value?.trim() ?? "";
        if (!raw) return "—";
        const n = Number(raw);
        const shown = Number.isFinite(n) ? String(Number(n.toFixed(4))) : raw;
        const label = unitText(id);
        return label ? shown + " " + label : shown;
      };

      const feet = (id: string) => {
        const n = Number(input(id)?.value);
        if (!Number.isFinite(n)) return Number.NaN;
        const factors: Record<string, number> = { ft: 1, in: 1 / 12, yd: 3, m: 1 / 0.3048, cm: 1 / 30.48, mm: 1 / 304.8 };
        return n * (factors[unit(id)?.value ?? "ft"] ?? 1);
      };

      const num = (id: string, fallback = 0) => {
        const n = Number(input(id)?.value);
        return Number.isFinite(n) ? n : fallback;
      };

      const fmt = (value: number, digits = 2) =>
        Number.isFinite(value) ? String(Number(value.toFixed(digits))) : "—";

      const setText = (selector: string, text: string) => {
        figure.querySelectorAll<SVGTextElement | HTMLElement>(selector).forEach((el) => {
          el.textContent = text;
        });
      };

      const update = () => {
        const L = feet("length");
        const W = feet("width");
        const H = feet("depth");
        const slope = Math.max(0, num("sideSlope", 0));
        const quantity = Math.max(0, Math.round(num("quantity", 1)));
        const swell = Math.max(0, num("swell", 0));

        const valid = [L, W, H].every(v => Number.isFinite(v) && v > 0) && quantity > 0;
        const topL = valid ? L + 2 * slope * H : 0;
        const topW = valid ? W + 2 * slope * H : 0;

        const singleBankFt3 = valid
          ? L * W * H + slope * (L + W) * H ** 2 + (4 / 3) * slope ** 2 * H ** 3
          : 0;
        const bankFt3 = singleBankFt3 * quantity;
        const bankYd3 = bankFt3 / 27;
        const looseYd3 = bankYd3 * (1 + swell / 100);

        setText("[data-exc-quantity-label]", quantity + " " + (quantity === 1 ? "excavation" : "excavations"));
        setText("[data-exc-bottom-length]", "Bottom length = " + displayValue("length"));
        setText("[data-exc-bottom-width]", "Bottom width = " + displayValue("width"));
        setText("[data-exc-section-bottom]", "Bottom width = " + displayValue("width"));
        setText("[data-exc-depth]", "Depth = " + displayValue("depth"));
        setText("[data-exc-slope]", "Side slope = " + fmt(slope) + "H:1V");
        setText("[data-exc-top-plan]", "Top opening = " + fmt(topL) + " ft × " + fmt(topW) + " ft");
        setText("[data-exc-bank]", fmt(bankYd3) + " bank yd³");
        setText("[data-exc-bank-ft3]", fmt(bankFt3) + " ft³ in-place");
        setText("[data-exc-top-card]", fmt(topL) + " ft × " + fmt(topW) + " ft");
        setText("[data-exc-swell]", fmt(swell) + "%");
        setText("[data-exc-loose]", fmt(looseYd3) + " yd³");
      };

      root.addEventListener("input", update);
      root.addEventListener("change", update);
      root.addEventListener("calculator-state-restored", update);
      form.addEventListener("reset", () => setTimeout(update, 0));

      update();
      queueMicrotask(update);
      requestAnimationFrame(update);
      setTimeout(update, 0);
    });
  }

  initExcavationRichDiagrams();
  document.addEventListener("astro:page-load", initExcavationRichDiagrams);
</script>
