<script>
  function initProjectDiagrams() {
    document.querySelectorAll<HTMLElement>("[data-project-diagram]").forEach((figure) => {
      if (figure.dataset.initialized) return;
      figure.dataset.initialized = "true";

      const root = figure.closest<HTMLElement>("[data-calculator-slug]");
      if (!root) return;
      const slug = root.dataset.calculatorSlug;
      if (!slug) return;

      let fields: Array<{ id: string; label: string; unit?: string }> = [];
      try {
        fields = JSON.parse(figure.dataset.fields ?? "[]");
      } catch {
        return;
      }

      const valueEls = Array.from(figure.querySelectorAll<SVGTextElement>("[data-diagram-value]"));
      const list = figure.querySelector<HTMLElement>(".calc-project-diagram-values");

      const readField = (field: { id: string; label: string; unit?: string }) => {
        const wrapper = root.querySelector<HTMLElement>(`#${slug}-field-${field.id}`);
        if (wrapper?.hidden) return null;
        const control = root.querySelector<HTMLInputElement | HTMLSelectElement>(`#${slug}-${field.id}`);
        if (!control || control.value === "") return null;

        const unitSelect = root.querySelector<HTMLSelectElement>(`#${slug}-${field.id}-unit`);
        const unit = unitSelect?.selectedOptions[0]?.textContent?.trim() || field.unit || "";
        return { label: field.label, value: control.value, unit };
      };

      const toFeet = (value: number, unit: string) => {
        if (!Number.isFinite(value)) return Number.NaN;
        if (unit === "in") return value / 12;
        if (unit === "yd") return value * 3;
        if (unit === "m") return value * 3.280839895;
        if (unit === "cm") return value / 30.48;
        if (unit === "mm") return value / 304.8;
        return value;
      };

      const numericControl = (id: string) => {
        const control = root.querySelector<HTMLInputElement | HTMLSelectElement>(`#${slug}-${id}`);
        return control && control.value !== "" ? Number(control.value) : Number.NaN;
      };

      const unitControl = (id: string) => {
        const select = root.querySelector<HTMLSelectElement>(`#${slug}-${id}-unit`);
        return select?.value ?? "ft";
      };

      const updateConcreteWeightDiagram = () => {
        if (figure.dataset.kind !== "concreteWeight") return;
        const mode = Math.round(numericControl("weightMode"));
        figure.hidden = mode === 0;
        figure.querySelectorAll<SVGGElement>("[data-concrete-weight-shape]").forEach((group) => {
          group.style.display = group.dataset.concreteWeightShape === String(mode) ? "" : "none";
        });
        const name = figure.querySelector<SVGTextElement>("[data-concrete-weight-mode-name]");
        if (name) {
          name.textContent = mode === 2
            ? "Round slab / cylinder dimensions"
            : mode === 3
              ? "Surface area × thickness"
              : "Length × width × thickness";
        }
      };

      const toSquareFeet = (value: number, unit: string) => {
        if (!Number.isFinite(value)) return Number.NaN;
        if (unit === "yd2") return value * 9;
        if (unit === "m2") return value * 10.7639104167;
        if (unit === "cm2") return value / 929.0304;
        if (unit === "mm2") return value / 92903.04;
        return value;
      };

      const toCubicFeet = (value: number, unit: string) => {
        if (!Number.isFinite(value)) return Number.NaN;
        if (unit === "yd3") return value * 27;
        if (unit === "m3") return value * 35.3146667215;
        if (unit === "L") return value / 28.316846592;
        return value;
      };

      const updateConcretePourDiagram = () => {
        if (figure.dataset.kind !== "concretePour") return false;

        const mode = Math.round(numericControl("pourInputMode"));
        let netFt3 = Number.NaN;
        if (mode === 1) {
          netFt3 = toCubicFeet(numericControl("volume"), unitControl("volume"));
        } else if (mode === 2) {
          const area = toSquareFeet(numericControl("area"), unitControl("area"));
          const thickness = toFeet(numericControl("areaThickness"), unitControl("areaThickness"));
          const quantity = Math.max(1, numericControl("quantity") || 1);
          netFt3 = area * thickness * quantity;
        } else {
          const length = toFeet(numericControl("length"), unitControl("length"));
          const width = toFeet(numericControl("width"), unitControl("width"));
          const depth = toFeet(numericControl("depth"), unitControl("depth"));
          const quantity = Math.max(1, numericControl("quantity") || 1);
          netFt3 = length * width * depth * quantity;
        }

        const allowance = Math.max(0, numericControl("waste") || 0);
        const capacity = Math.max(0, numericControl("truckCapacity") || 0);
        const threshold = Math.max(0, numericControl("minOrder") || 0);
        const rate = Math.max(0, numericControl("pumpRate") || 0);
        const orderYd3 = Number.isFinite(netFt3) ? netFt3 * (1 + allowance / 100) / 27 : Number.NaN;
        const loads = capacity > 0 && Number.isFinite(orderYd3) ? Math.max(1, Math.ceil(orderYd3 / capacity)) : Number.NaN;
        const finalLoad = capacity > 0 && Number.isFinite(loads) ? Math.max(0, orderYd3 - (loads - 1) * capacity) : Number.NaN;
        const utilization = capacity > 0 && Number.isFinite(finalLoad) ? Math.max(0, Math.min(100, finalLoad / capacity * 100)) : 0;
        const thresholdPct = capacity > 0 ? Math.max(0, Math.min(100, threshold / capacity * 100)) : 0;
        const durationMin = rate > 0 && Number.isFinite(orderYd3) ? orderYd3 / rate * 60 : Number.NaN;

        const fill = figure.querySelector<SVGRectElement>("[data-pour-final-fill]");
        if (fill) fill.setAttribute("width", String(500 * utilization / 100));
        const thresholdLine = figure.querySelector<SVGLineElement>("[data-pour-threshold-line]");
        if (thresholdLine) {
