---
interface DiagramField {
  id: string;
  label: string;
  unit?: string;
}

interface Props {
  slug: string;
  fields: DiagramField[];
}

const { slug, fields } = Astro.props;
const lower = slug.toLowerCase();
const kind =
  lower === "concrete-pour-calculator" ? "concretePour" :
  lower === "concrete-mix-calculator" ? "concreteMix" :
  lower === "concrete-cost-calculator" ? "concreteCost" :
  lower === "concrete-weight-calculator" ? "concreteWeight" :
  lower === "concrete-volume-calculator" ? "concreteVolume" :
  lower === "concrete-slab-calculator" ? "concreteSlab" :
  lower === "concrete-waste-calculator" ? "concreteWaste" :
  lower === "brick-joint-calculator" ? "brickJoint" :
  lower === "concrete-curb-calculator" ? "concreteCurb" :
  lower === "concrete-stair-calculator" ? "concreteStair" :
  lower === "concrete-footing-calculator" ? "concreteFooting" :
  lower === "concrete-calculator" ? "concrete" :
  lower === "roof-pitch-calculator" ? "roofPitch" :
  /roof|pitch|rafter/.test(lower) ? "roof" :
  /rebar|mesh/.test(lower) ? "grid" :
  /fence|gate|deck/.test(lower) ? "line" :
  /column|tube|pier|post-hole/.test(lower) ? "cylinder" :
  "rect";

const excluded = /(?:cost|weight|waste|price|bag|mix-ratio|board-foot|material-cost)/.test(lower);
const show = (kind === "concreteWeight" || kind === "concreteCost" || kind === "concretePour" || kind === "concreteWaste" || !excluded) && fields.length >= 2;
---

{show && (
  <figure
    class="calc-project-diagram rounded-xl border border-border bg-card p-4 sm:p-5"
    data-project-diagram
    data-kind={kind}
    hidden={kind === "concreteWeight"}
    data-fields={JSON.stringify(fields)}
  >
    <div class="flex flex-wrap items-start justify-between gap-2">
      <div>
        <h3 class="text-xs font-mono font-semibold uppercase tracking-wider text-foreground">{kind === "concreteMix" ? "Live mix proportion guide" : kind === "concretePour" ? "Live ready-mix load plan" : kind === "concreteWaste" ? "Live concrete order buildup" : kind === "concreteStair" ? "Live stair section guide" : kind === "brickJoint" ? "Live brick course layout" : "Visual project measurements"}</h3>
        <p class="mt-1 text-[11px] leading-5 text-muted-foreground">{kind === "concreteMix" ? "Updates from the selected cement : sand : coarse-aggregate ratio. Proportion guide only — not a mix-design approval." : kind === "concretePour" ? "Updates from order inputs, truck capacity, short-load threshold and placement rate. Scheduling aid only." : kind === "concreteWaste" ? "Separates net volume, requested allowance and supplier-rounding overage so the final order buildup stays visible." : kind === "concreteStair" ? "Switches between solid mass-fill and waist-slab stair sections and updates from the entered geometry. Schematic only — not to scale." : kind === "brickJoint" ? "Shows the repeating brick module and N−1 internal-joint relationship for the selected layout mode. Schematic only — not to scale." : "Updates from the visible measurement inputs. Schematic only — not to scale."}</p>
      </div>
      <span class="rounded-full border border-border bg-muted px-2 py-1 font-mono text-[10px] text-muted-foreground">LIVE INPUT GUIDE</span>
    </div>

    <svg
      viewBox="0 0 640 240"
      class="mt-4 h-auto w-full"
      role="img"
      aria-labelledby={`${slug}-diagram-title ${slug}-diagram-desc`}
    >
      <title id={`${slug}-diagram-title`}>Live measurement schematic for this calculator</title>
      <desc id={`${slug}-diagram-desc`}>A not-to-scale construction sketch whose measurement labels update from the calculator inputs.</desc>
      <rect x="1" y="1" width="638" height="238" rx="14" fill="var(--color-background)" stroke="var(--color-border)" />

      {kind === "concretePour" && (
        <>
          <text x="34" y="40" font-size="13" font-weight="600" fill="var(--color-foreground)" data-pour-load-count>Ready-mix load plan</text>
          <text x="34" y="72" font-size="11" fill="var(--color-muted-foreground)">Final truck utilization</text>

          <rect x="34" y="90" width="500" height="42" rx="9" fill="var(--color-muted)" opacity="0.32" />
          <rect x="34" y="90" width="250" height="42" rx="9" fill="var(--color-foreground)" opacity="0.58" data-pour-final-fill />
          <line x1="284" y1="82" x2="284" y2="142" stroke="var(--color-muted-foreground)" stroke-width="1.5" stroke-dasharray="5 4" data-pour-threshold-line />
          <text x="548" y="116" text-anchor="end" font-size="12" fill="var(--color-foreground)" data-pour-final-label>Final load</text>

          <text x="34" y="166" font-size="11" fill="var(--color-muted-foreground)">Placement-rate planning</text>
          <line x1="34" y1="188" x2="534" y2="188" stroke="var(--color-border)" stroke-width="4" stroke-linecap="round" />
          <circle cx="34" cy="188" r="7" fill="var(--color-foreground)" />
          <circle cx="534" cy="188" r="7" fill="var(--color-foreground)" opacity="0.5" />
          <text x="34" y="214" font-size="11" fill="var(--color-muted-foreground)">Start</text>
          <text x="534" y="214" text-anchor="end" font-size="11" fill="var(--color-muted-foreground)" data-pour-duration-label>Pour duration</text>
        </>
      )}

      {kind === "concreteWaste" && (
        <>
          <text x="34" y="38" font-size="13" font-weight="600" fill="var(--color-foreground)" data-waste-source>Slab / patio / driveway</text>

          <g data-waste-geometry="0">
            <polygon points="500,25 548,25 562,35 514,35" fill="var(--color-card)" stroke="var(--color-foreground)" stroke-width="1.5" />
            <polygon points="514,35 562,35 562,47 514,47" fill="var(--color-card)" stroke="var(--color-foreground)" stroke-width="1.5" />
          </g>
          <g data-waste-geometry="1" style="display:none">
            <rect x="510" y="22" width="42" height="28" rx="4" fill="var(--color-card)" stroke="var(--color-foreground)" stroke-width="1.5" />
            <text x="531" y="40" text-anchor="middle" font-size="10" fill="var(--color-foreground)">yd³</text>
          </g>
          <g data-waste-geometry="2" style="display:none">
            <ellipse cx="532" cy="26" rx="21" ry="7" fill="var(--color-card)" stroke="var(--color-foreground)" stroke-width="1.5" />
            <rect x="511" y="26" width="42" height="20" fill="var(--color-card)" stroke="none" />
            <line x1="511" y1="26" x2="511" y2="46" stroke="var(--color-foreground)" stroke-width="1.5" />
            <line x1="553" y1="26" x2="553" y2="46" stroke="var(--color-foreground)" stroke-width="1.5" />
            <ellipse cx="532" cy="46" rx="21" ry="7" fill="var(--color-card)" stroke="var(--color-foreground)" stroke-width="1.5" />
          </g>
          <g data-waste-geometry="3" style="display:none">
            <rect x="505" y="19" width="54" height="34" fill="var(--color-card)" stroke="var(--color-foreground)" stroke-width="1.5" />
            <line x1="515" y1="53" x2="515" y2="60" stroke="var(--color-foreground)" stroke-width="1.5" />
            <line x1="549" y1="53" x2="549" y2="60" stroke="var(--color-foreground)" stroke-width="1.5" />
            <rect x="499" y="60" width="66" height="7" fill="var(--color-card)" stroke="var(--color-foreground)" stroke-width="1.5" />
