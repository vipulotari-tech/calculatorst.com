            { label: mode === 2 ? "Course / joints" : "Bricks / joints", value: mode === 2 && Number.isFinite(displayCourse) ? `${(displayCourse * 12).toFixed(3)} in · ${Math.max(0, quantity - 1)} joints` : `${displayCount} bricks · ${Math.max(0, displayCount - 1)} joints` },
          ];
          list.replaceChildren(...metrics.map((item) => {
            const wrap = document.createElement("div");
            wrap.className = "rounded-md border border-border bg-muted/30 px-3 py-2";
            const dt = document.createElement("dt");
            dt.className = "text-muted-foreground";
