          const depth = toFeet(numericControl("pierDepth"), unitControl("pierDepth"));
          const quantity = Math.max(1, numericControl("pierQuantity") || 1);
          netFt3 = Math.PI * Math.pow(diameter / 2, 2) * depth * quantity;
        } else if (mode === 3) {
          const length = toFeet(numericControl("sectionLength"), unitControl("sectionLength"));
          const height = toFeet(numericControl("sectionHeight"), unitControl("sectionHeight"));
          const thickness = toFeet(numericControl("sectionThickness"), unitControl("sectionThickness"));
          const quantity = Math.max(1, numericControl("sectionQuantity") || 1);
          netFt3 = length * height * thickness * quantity;
        } else {
          const length = toFeet(numericControl("length"), unitControl("length"));
          const width = toFeet(numericControl("width"), unitControl("width"));
          const depth = toFeet(numericControl("depth"), unitControl("depth"));
          const quantity = Math.max(1, numericControl("quantity") || 1);
          netFt3 = length * width * depth * quantity;
