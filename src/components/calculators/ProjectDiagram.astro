      const updateBrickJointDiagram = () => {
        if (figure.dataset.kind !== "brickJoint") return false;

        const mode = Math.round(numericControl("layoutMode"));
        const lengthValue = numericControl("length");
        const lengthUnit = unitControl("length");
        const brickValue = numericControl("brickLength");
        const brickUnit = unitControl("brickLength");
        const quantity = Math.max(1, Math.round(numericControl("quantity") || 1));
        const targetValue = numericControl("targetJoint");
        const targetUnit = unitControl("targetJoint");

        const L = toFeet(lengthValue, lengthUnit);
        const B = toFeet(brickValue, brickUnit);
        const J = toFeet(targetValue, targetUnit);

        const modeName = figure.querySelector<SVGTextElement>("[data-brick-joint-mode]");
        const courseLabel = figure.querySelector<SVGTextElement>("[data-brick-course-length]");
        const brickLabel = figure.querySelector<SVGTextElement>("[data-brick-length-label]");
        const jointLabel = figure.querySelector<SVGTextElement>("[data-brick-joint-label]");
        const countLabel = figure.querySelector<SVGTextElement>("[data-brick-count-label]");
        const summary = figure.querySelector<SVGTextElement>("[data-brick-joint-summary]");

        if (brickLabel) brickLabel.textContent = Number.isFinite(brickValue) ? `Brick: ${brickValue} ${brickUnit}` : "Actual brick length";

        let displayJoint = Number.NaN;
        let displayCount = quantity;
        let displayCourse = L;
        let summaryText = "Course-fit geometry";

        if (mode === 0) {
          if (modeName) modeName.textContent = "Solve equal joint width";
          if (Number.isFinite(L) && Number.isFinite(B) && quantity >= 2) {
            displayJoint = (L - quantity * B) / (quantity - 1);
            summaryText = Number.isFinite(displayJoint) && displayJoint >= 0
              ? `Solved joint: ${(displayJoint * 12).toFixed(4)} in`
              : "Entered bricks exceed the course";
          }
        } else if (mode === 1) {
          if (modeName) modeName.textContent = "Find whole bricks at target joint";
          displayJoint = J;
          if (Number.isFinite(L) && Number.isFinite(B) && Number.isFinite(J) && B + J > 0) {
            displayCount = Math.max(0, Math.floor((L + J) / (B + J) + 1e-12));
            const used = displayCount > 0 ? displayCount * B + Math.max(0, displayCount - 1) * J : 0;
            const leftover = Math.max(0, L - used);
            summaryText = `${displayCount} whole bricks · ${(leftover * 12).toFixed(3)} in unfilled`;
          }
        } else {
          if (modeName) modeName.textContent = "Find required course length";
          displayJoint = J;
          if (Number.isFinite(B) && Number.isFinite(J)) {
            displayCourse = quantity * B + Math.max(0, quantity - 1) * J;
            summaryText = `Required course: ${(displayCourse * 12).toFixed(3)} in`;
