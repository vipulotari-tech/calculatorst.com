        const roundingBar = figure.querySelector<SVGRectElement>("[data-waste-rounding-bar]");
        netBar?.setAttribute("width", String(netWidth));
        allowanceBar?.setAttribute("x", String(34 + netWidth));
        allowanceBar?.setAttribute("width", String(allowanceWidth));
        roundingBar?.setAttribute("x", String(34 + netWidth + allowanceWidth));
        roundingBar?.setAttribute("width", String(roundingWidth));

        const source = figure.querySelector<SVGTextElement>("[data-waste-source]");
        const netLabel = figure.querySelector<SVGTextElement>("[data-waste-net-label]");
        const targetLabel = figure.querySelector<SVGTextElement>("[data-waste-target-label]");
        const orderLabel = figure.querySelector<SVGTextElement>("[data-waste-order-label]");
        const allowanceLabel = figure.querySelector<SVGTextElement>("[data-waste-allowance-label]");
        const roundingLabel = figure.querySelector<SVGTextElement>("[data-waste-rounding-label]");
        const effectiveLabel = figure.querySelector<SVGTextElement>("[data-waste-effective-label]");
        const truckPlanLabel = figure.querySelector<SVGTextElement>("[data-waste-truck-plan]");

        if (source) {
          source.textContent = mode === 1
            ? "Known net concrete volume"
