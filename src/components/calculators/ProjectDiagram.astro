            <ellipse cx="320" cy="170" rx="55" ry="17" fill="none" stroke="var(--color-muted-foreground)" stroke-width="1.5" stroke-dasharray="5 4" />
          </g>

          <g data-concrete-volume-shape="3" style="display:none">
            <path d="M100 175 H540 V145 H285 V82 H195 V145 H100 Z" fill="var(--color-card)" stroke="var(--color-foreground)" stroke-width="2" />
            <line x1="100" y1="145" x2="540" y2="145" stroke="var(--color-muted-foreground)" stroke-width="1.5" stroke-dasharray="6 5" />
          </g>

          <g data-concrete-volume-shape="4" style="display:none">
            <path d="M145 185 H495 V145 H425 V115 H355 V85 H285 V55 H215 V185 Z" fill="var(--color-card)" stroke="var(--color-foreground)" stroke-width="2" />
          </g>

          <g data-concrete-volume-shape="5" style="display:none">
            <polygon points="145,175 355,175 355,80" fill="var(--color-card)" stroke="var(--color-foreground)" stroke-width="2" />
            <polygon points="355,80 500,120 500,175 355,175" fill="var(--color-card)" stroke="var(--color-foreground)" stroke-width="2" />
            <line x1="145" y1="175" x2="500" y2="175" stroke="var(--color-muted-foreground)" stroke-width="1.5" />
