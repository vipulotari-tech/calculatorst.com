        const truckCapacity = Math.max(0, numericControl("truckCapacity") || 0);
        const netYd3 = Number.isFinite(netFt3) ? netFt3 / 27 : Number.NaN;
        const targetYd3 = Number.isFinite(netYd3) ? netYd3 * (1 + allowance / 100) : Number.NaN;
        const orderedYd3 = Number.isFinite(targetYd3)
          ? (increment > 0 ? Math.ceil((targetYd3 - 1e-12) / increment) * increment : targetYd3)
          : Number.NaN;
        const roundingYd3 = Number.isFinite(orderedYd3) && Number.isFinite(targetYd3) ? Math.max(0, orderedYd3 - targetYd3) : Number.NaN;
        const effectivePct = Number.isFinite(orderedYd3) && Number.isFinite(netYd3) && netYd3 > 0
          ? (orderedYd3 - netYd3) / netYd3 * 100
          : Number.NaN;
        const loads = truckCapacity > 0 && Number.isFinite(orderedYd3) ? Math.max(1, Math.ceil(orderedYd3 / truckCapacity)) : Number.NaN;
        const finalLoad = Number.isFinite(loads) ? Math.max(0, orderedYd3 - (loads - 1) * truckCapacity) : Number.NaN;

        const scale = Number.isFinite(orderedYd3) && orderedYd3 > 0 ? 500 / orderedYd3 : 0;
        const netWidth = Number.isFinite(netYd3) ? Math.max(0, Math.min(500, netYd3 * scale)) : 0;
        const allowanceWidth = Number.isFinite(targetYd3) && Number.isFinite(netYd3) ? Math.max(0, Math.min(500 - netWidth, (targetYd3 - netYd3) * scale)) : 0;
        const roundingWidth = Number.isFinite(roundingYd3) ? Math.max(0, Math.min(500 - netWidth - allowanceWidth, roundingYd3 * scale)) : 0;

        const netBar = figure.querySelector<SVGRectElement>("[data-waste-net-bar]");
