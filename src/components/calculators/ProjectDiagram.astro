      {kind === "concreteSlab" && (
        <>
          <text x="34" y="34" font-size="12" font-weight="600" fill="var(--color-muted-foreground)" data-concrete-slab-shape-name>Rectangular slab</text>

          <g data-concrete-slab-shape="0">
            <g data-concrete-slab-subbase style="display:none">
              <polygon points="130,122 438,122 520,166 212,166" fill="var(--color-muted)" opacity="0.28" stroke="var(--color-muted-foreground)" stroke-width="1.2" stroke-dasharray="5 4" />
              <polygon points="212,166 520,166 520,194 212,194" fill="var(--color-muted)" opacity="0.22" stroke="var(--color-muted-foreground)" stroke-width="1.2" stroke-dasharray="5 4" />
            </g>
            <polygon points="145,88 430,88 510,130 225,130" fill="var(--color-card)" stroke="var(--color-foreground)" stroke-width="2" />
            <polygon points="225,130 510,130 510,162 225,162" fill="var(--color-card)" stroke="var(--color-foreground)" stroke-width="2" />
            <polygon points="430,88 510,130 510,162 430,120" fill="var(--color-card)" stroke="var(--color-foreground)" stroke-width="2" />
            <g data-concrete-slab-edge style="display:none">
              <path d="M225 148 H510 V174 H225 Z" fill="var(--color-foreground)" opacity="0.12" stroke="var(--color-foreground)" stroke-width="1.4" />
