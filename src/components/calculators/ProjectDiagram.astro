        }
        if (countLabel) countLabel.textContent = `${displayCount} brick${displayCount === 1 ? "" : "s"} · ${Math.max(0, displayCount - 1)} internal joint${displayCount === 2 ? "" : "s"}`;
        if (summary) summary.textContent = summaryText;

        const gapPx = Number.isFinite(displayJoint) && Number.isFinite(B) && B > 0
