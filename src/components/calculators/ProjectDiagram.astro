---
interface DiagramField {
  id: string;
  label: string;
  unit?: string;
}

interface Props {
  slug: string;
  fields: DiagramField[];
}

const { slug, fields } = Astro.props;
const lower = slug.toLowerCase();
const kind =
  lower === "concrete-calculator" ? "concrete" :
  lower === "roof-pitch-calculator" ? "roofPitch" :
  /roof|pitch|rafter/.test(lower) ? "roof" :
  /rebar|mesh/.test(lower) ? "grid" :
  /fence|gate|deck/.test(lower) ? "line" :
  /column|tube|pier|post-hole/.test(lower) ? "cylinder" :
  "rect";

const excluded = /(?:cost|weight|waste|price|bag|mix-ratio|board-foot|material-cost)/.test(lower);
const show = !excluded && fields.length >= 2;
---

{show && (
  <figure
    class="calc-project-diagram rounded-xl border border-border bg-card p-4 sm:p-5"
    data-project-diagram
    data-kind={kind}
    data-fields={JSON.stringify(fields)}
  >
    <div class="flex flex-wrap items-start justify-between gap-2">
      <div>
        <h3 class="text-xs font-mono font-semibold uppercase tracking-wider text-foreground">Visual project measurements</h3>
        <p class="mt-1 text-[11px] leading-5 text-muted-foreground">Updates from the visible measurement inputs. Schematic only — not to scale.</p>
      </div>
      <span class="rounded-full border border-border bg-muted px-2 py-1 font-mono text-[10px] text-muted-foreground">LIVE INPUT GUIDE</span>
    </div>

    <svg
      viewBox="0 0 640 240"
      class="mt-4 h-auto w-full"
      role="img"
      aria-labelledby={`${slug}-diagram-title ${slug}-diagram-desc`}
    >
      <title id={`${slug}-diagram-title`}>Live measurement schematic for this calculator</title>
      <desc id={`${slug}-diagram-desc`}>A not-to-scale construction sketch whose measurement labels update from the calculator inputs.</desc>
      <rect x="1" y="1" width="638" height="238" rx="14" fill="var(--color-background)" stroke="var(--color-border)" />

      {kind === "concrete" && (
        <>
          <text x="34" y="34" font-size="12" font-weight="600" fill="var(--color-muted-foreground)" data-concrete-shape-name>Rectangular slab</text>

          <g data-concrete-shape="0">
            <polygon points="145,105 430,105 510,145 225,145" fill="var(--color-card)" stroke="var(--color-foreground)" stroke-width="2" />
            <polygon points="225,145 510,145 510,172 225,172" fill="var(--color-card)" stroke="var(--color-foreground)" stroke-width="2" />
            <polygon points="430,105 510,145 510,172 430,132" fill="var(--color-card)" stroke="var(--color-foreground)" stroke-width="2" />
          </g>

          <g data-concrete-shape="1" style="display:none">
            <polygon points="105,105 470,105 535,135 170,135" fill="var(--color-card)" stroke="var(--color-foreground)" stroke-width="2" />
            <polygon points="170,135 535,135 535,180 170,180" fill="var(--color-card)" stroke="var(--color-foreground)" stroke-width="2" />
            <polygon points="470,105 535,135 535,180 470,150" fill="var(--color-card)" stroke="var(--color-foreground)" stroke-width="2" />
          </g>

          <g data-concrete-shape="2" style="display:none">
            <polygon points="165,65 450,65 505,92 220,92" fill="var(--color-card)" stroke="var(--color-foreground)" stroke-width="2" />
            <polygon points="220,92 505,92 505,188 220,188" fill="var(--color-card)" stroke="var(--color-foreground)" stroke-width="2" />
            <polygon points="450,65 505,92 505,188 450,161" fill="var(--color-card)" stroke="var(--color-foreground)" stroke-width="2" />
          </g>

          <g data-concrete-shape="3" style="display:none">
            <ellipse cx="320" cy="78" rx="105" ry="30" fill="var(--color-card)" stroke="var(--color-foreground)" stroke-width="2" />
            <path d="M215 78 V172 C215 190 262 204 320 204 C378 204 425 190 425 172 V78" fill="var(--color-card)" stroke="var(--color-foreground)" stroke-width="2" />
            <ellipse cx="320" cy="172" rx="105" ry="30" fill="none" stroke="var(--color-muted-foreground)" stroke-width="1.5" />
          </g>

          <text x="320" y="224" text-anchor="middle" font-size="13" fill="var(--color-foreground)" data-diagram-value="0">Measurement 1</text>
          <text x="92" y="138" text-anchor="middle" font-size="13" fill="var(--color-foreground)" transform="rotate(-90 92 138)" data-diagram-value="1">Measurement 2</text>
          <text x="470" y="52" text-anchor="middle" font-size="13" fill="var(--color-muted-foreground)" data-diagram-value="2">Measurement 3</text>
        </>
      )}

      {kind === "roofPitch" && (
        <>
          <line x1="120" y1="185" x2="520" y2="185" stroke="var(--color-muted-foreground)" stroke-width="2" />
          <line data-roof-pitch-rise x1="520" y1="185" x2="520" y2="105" stroke="var(--color-muted-foreground)" stroke-width="2" stroke-dasharray="6 5" />
          <line data-roof-pitch-rafter x1="120" y1="185" x2="520" y2="105" stroke="var(--color-foreground)" stroke-width="3" stroke-linecap="round" />
          <path data-roof-pitch-angle-arc d="M165 185 A45 45 0 0 0 164 176" fill="none" stroke="var(--color-muted-foreground)" stroke-width="1.5" />
          <text x="320" y="214" text-anchor="middle" font-size="13" fill="var(--color-foreground)" data-roof-pitch-run-label>Horizontal run</text>
          <text x="535" y="145" font-size="13" fill="var(--color-foreground)" data-roof-pitch-rise-label>Rise</text>
          <text x="315" y="118" text-anchor="middle" font-size="13" fill="var(--color-foreground)" data-roof-pitch-rafter-label>Rafter</text>
          <text x="172" y="170" font-size="12" fill="var(--color-muted-foreground)" data-roof-pitch-angle-label>Angle</text>
        </>
      )}

      {kind === "roof" && (
        <>
          <path d="M115 175 L320 70 L525 175 Z" fill="var(--color-card)" stroke="var(--color-foreground)" stroke-width="2" />
          <line x1="115" y1="195" x2="525" y2="195" stroke="var(--color-muted-foreground)" stroke-width="1.5" />
          <line x1="320" y1="70" x2="320" y2="175" stroke="var(--color-muted-foreground)" stroke-width="1.5" stroke-dasharray="6 5" />
          <text x="320" y="218" text-anchor="middle" font-size="13" fill="var(--color-foreground)" data-diagram-value="0">Measurement 1</text>
          <text x="335" y="125" font-size="13" fill="var(--color-foreground)" data-diagram-value="1">Measurement 2</text>
          <text x="430" y="118" font-size="13" fill="var(--color-muted-foreground)" data-diagram-value="2">Measurement 3</text>
        </>
      )}

      {kind === "grid" && (
        <>
          <rect x="115" y="45" width="410" height="150" rx="6" fill="var(--color-card)" stroke="var(--color-foreground)" stroke-width="2" />
          {[165,215,265,315,365,415,465].map((x) => <line x1={x} y1="45" x2={x} y2="195" stroke="var(--color-muted-foreground)" stroke-width="1" />)}
          {[82,120,158].map((y) => <line x1="115" y1={y} x2="525" y2={y} stroke="var(--color-muted-foreground)" stroke-width="1" />)}
          <text x="320" y="220" text-anchor="middle" font-size="13" fill="var(--color-foreground)" data-diagram-value="0">Measurement 1</text>
          <text x="72" y="124" text-anchor="middle" font-size="13" fill="var(--color-foreground)" transform="rotate(-90 72 124)" data-diagram-value="1">Measurement 2</text>
          <text x="430" y="34" font-size="13" fill="var(--color-muted-foreground)" data-diagram-value="2">Measurement 3</text>
        </>
      )}

      {kind === "line" && (
        <>
          <line x1="90" y1="185" x2="550" y2="185" stroke="var(--color-muted-foreground)" stroke-width="2" />
          {[120,220,320,420,520].map((x) => <rect x={x} y="70" width="10" height="115" rx="2" fill="var(--color-foreground)" />)}
          <line x1="125" y1="52" x2="225" y2="52" stroke="var(--color-muted-foreground)" stroke-width="1.5" />
          <text x="320" y="215" text-anchor="middle" font-size="13" fill="var(--color-foreground)" data-diagram-value="0">Measurement 1</text>
          <text x="175" y="42" text-anchor="middle" font-size="13" fill="var(--color-foreground)" data-diagram-value="1">Measurement 2</text>
          <text x="438" y="60" font-size="13" fill="var(--color-muted-foreground)" data-diagram-value="2">Measurement 3</text>
        </>
      )}

      {kind === "cylinder" && (
        <>
          <ellipse cx="320" cy="65" rx="110" ry="32" fill="var(--color-card)" stroke="var(--color-foreground)" stroke-width="2" />
          <path d="M210 65 V175 C210 193 259 208 320 208 C381 208 430 193 430 175 V65" fill="var(--color-card)" stroke="var(--color-foreground)" stroke-width="2" />
          <ellipse cx="320" cy="175" rx="110" ry="32" fill="none" stroke="var(--color-muted-foreground)" stroke-width="1.5" />
          <line x1="210" y1="32" x2="430" y2="32" stroke="var(--color-muted-foreground)" stroke-width="1.5" />
          <text x="320" y="23" text-anchor="middle" font-size="13" fill="var(--color-foreground)" data-diagram-value="0">Measurement 1</text>
          <text x="452" y="125" font-size="13" fill="var(--color-foreground)" data-diagram-value="1">Measurement 2</text>
          <text x="320" y="132" text-anchor="middle" font-size="13" fill="var(--color-muted-foreground)" data-diagram-value="2">Measurement 3</text>
        </>
      )}

      {kind === "rect" && (
        <>
          <polygon points="145,75 445,75 520,125 220,125" fill="var(--color-card)" stroke="var(--color-foreground)" stroke-width="2" />
          <polygon points="220,125 520,125 520,180 220,180" fill="var(--color-card)" stroke="var(--color-foreground)" stroke-width="2" />
          <polygon points="445,75 520,125 520,180 445,130" fill="var(--color-card)" stroke="var(--color-foreground)" stroke-width="2" />
          <text x="370" y="210" text-anchor="middle" font-size="13" fill="var(--color-foreground)" data-diagram-value="0">Measurement 1</text>
          <text x="145" y="115" text-anchor="middle" font-size="13" fill="var(--color-foreground)" transform="rotate(-34 145 115)" data-diagram-value="1">Measurement 2</text>
          <text x="535" y="160" font-size="13" fill="var(--color-muted-foreground)" data-diagram-value="2">Measurement 3</text>
        </>
      )}
    </svg>

    <dl class="calc-project-diagram-values mt-3 grid gap-2 text-xs sm:grid-cols-3"></dl>
  </figure>
)}

<script>
  function initProjectDiagrams() {
    document.querySelectorAll<HTMLElement>("[data-project-diagram]").forEach((figure) => {
      if (figure.dataset.initialized) return;
      figure.dataset.initialized = "true";

      const root = figure.closest<HTMLElement>("[data-calculator-slug]");
      if (!root) return;
      const slug = root.dataset.calculatorSlug;
      if (!slug) return;

      let fields: Array<{ id: string; label: string; unit?: string }> = [];
      try {
        fields = JSON.parse(figure.dataset.fields ?? "[]");
      } catch {
        return;
      }

      const valueEls = Array.from(figure.querySelectorAll<SVGTextElement>("[data-diagram-value]"));
      const list = figure.querySelector<HTMLElement>(".calc-project-diagram-values");

      const readField = (field: { id: string; label: string; unit?: string }) => {
        const wrapper = root.querySelector<HTMLElement>(`#${slug}-field-${field.id}`);
        if (wrapper?.hidden) return null;
        const control = root.querySelector<HTMLInputElement | HTMLSelectElement>(`#${slug}-${field.id}`);
        if (!control || control.value === "") return null;

        const unitSelect = root.querySelector<HTMLSelectElement>(`#${slug}-${field.id}-unit`);
        const unit = unitSelect?.selectedOptions[0]?.textContent?.trim() || field.unit || "";
        return { label: field.label, value: control.value, unit };
      };

      const toFeet = (value: number, unit: string) => {
        if (!Number.isFinite(value)) return Number.NaN;
        if (unit === "in") return value / 12;
        if (unit === "yd") return value * 3;
        if (unit === "m") return value * 3.280839895;
        if (unit === "cm") return value / 30.48;
        if (unit === "mm") return value / 304.8;
        return value;
      };

      const numericControl = (id: string) => {
        const control = root.querySelector<HTMLInputElement | HTMLSelectElement>(`#${slug}-${id}`);
        return control && control.value !== "" ? Number(control.value) : Number.NaN;
      };

      const unitControl = (id: string) => {
        const select = root.querySelector<HTMLSelectElement>(`#${slug}-${id}-unit`);
        return select?.value ?? "ft";
      };

      const updateConcreteDiagram = () => {
        if (figure.dataset.kind !== "concrete") return;
        const shape = Math.round(numericControl("shape"));
        const names = ["Rectangular slab", "Strip footing", "Wall", "Cylinder / column"];
        figure.querySelectorAll<SVGGElement>("[data-concrete-shape]").forEach((group) => {
          group.style.display = group.dataset.concreteShape === String(shape) ? "" : "none";
        });
        const name = figure.querySelector<SVGTextElement>("[data-concrete-shape-name]");
        if (name) name.textContent = names[shape] ?? "Concrete shape";
      };

      const updateRoofPitchDiagram = () => {
        if (figure.dataset.kind !== "roofPitch") return false;

        const mode = Math.round(numericControl("mode"));
        let slope = 0;
        let runFt = Number.NaN;
        let riseFt = Number.NaN;
        let rafterFt = Number.NaN;

        if (mode === 1) {
          const angle = numericControl("angleInput");
          slope = Math.tan(angle * Math.PI / 180);
          const ref = numericControl("referenceRun");
          if (Number.isFinite(ref)) {
            runFt = toFeet(ref, unitControl("referenceRun"));
            riseFt = runFt * slope;
            rafterFt = Math.hypot(runFt, riseFt);
          }
        } else if (mode === 2) {
          slope = numericControl("pitchInput") / 12;
          const ref = numericControl("referenceRun");
          if (Number.isFinite(ref)) {
            runFt = toFeet(ref, unitControl("referenceRun"));
            riseFt = runFt * slope;
            rafterFt = Math.hypot(runFt, riseFt);
          }
        } else if (mode === 3) {
          runFt = toFeet(numericControl("run"), unitControl("run"));
          rafterFt = toFeet(numericControl("rafterLength"), unitControl("rafterLength"));
          if (Number.isFinite(runFt) && Number.isFinite(rafterFt) && rafterFt >= runFt && runFt > 0) {
            riseFt = Math.sqrt(Math.max(0, rafterFt * rafterFt - runFt * runFt));
            slope = riseFt / runFt;
          }
        } else {
          runFt = toFeet(numericControl("run"), unitControl("run"));
          riseFt = toFeet(numericControl("rise"), unitControl("rise"));
          if (Number.isFinite(runFt) && runFt > 0 && Number.isFinite(riseFt)) {
            slope = riseFt / runFt;
            rafterFt = Math.hypot(runFt, riseFt);
          }
        }

        if (!Number.isFinite(slope) || slope < 0) slope = 0;
        const angle = Math.atan(slope) * 180 / Math.PI;
        const pitch = slope * 12;
        const multiplier = Math.hypot(1, slope);

        const baseY = 185;
        const topY = Math.max(38, baseY - Math.min(147, slope * 150));
        const riseLine = figure.querySelector<SVGLineElement>("[data-roof-pitch-rise]");
        const rafterLine = figure.querySelector<SVGLineElement>("[data-roof-pitch-rafter]");
        riseLine?.setAttribute("y2", String(topY));
        rafterLine?.setAttribute("y2", String(topY));

        const riseLabel = figure.querySelector<SVGTextElement>("[data-roof-pitch-rise-label]");
        const rafterLabel = figure.querySelector<SVGTextElement>("[data-roof-pitch-rafter-label]");
        const runLabel = figure.querySelector<SVGTextElement>("[data-roof-pitch-run-label]");
        const angleLabel = figure.querySelector<SVGTextElement>("[data-roof-pitch-angle-label]");

        if (riseLabel) {
          riseLabel.setAttribute("y", String((baseY + topY) / 2));
          riseLabel.textContent = Number.isFinite(riseFt) ? `Rise: ${riseFt.toFixed(3)} ft` : `Pitch: ${pitch.toFixed(2)}:12`;
        }
        if (rafterLabel) {
          rafterLabel.setAttribute("y", String(Math.max(32, topY - 10)));
          rafterLabel.textContent = Number.isFinite(rafterFt) ? `Rafter: ${rafterFt.toFixed(3)} ft` : `Multiplier: ${multiplier.toFixed(4)}×`;
        }
        if (runLabel) runLabel.textContent = Number.isFinite(runFt) ? `Horizontal run: ${runFt.toFixed(3)} ft` : "Horizontal run";
        if (angleLabel) angleLabel.textContent = `${angle.toFixed(2)}° · ${pitch.toFixed(2)}:12`;

        if (list) {
          const metrics = [
            { label: "Pitch", value: `${pitch.toFixed(2)}:12` },
            { label: "Angle", value: `${angle.toFixed(2)}°` },
            { label: "Surface multiplier", value: `${multiplier.toFixed(4)}×` },
          ];
          list.replaceChildren(...metrics.map((item) => {
            const wrap = document.createElement("div");
            wrap.className = "rounded-md border border-border bg-muted/30 px-3 py-2";
            const dt = document.createElement("dt");
            dt.className = "text-muted-foreground";
            dt.textContent = item.label;
            const dd = document.createElement("dd");
            dd.className = "mt-0.5 font-mono font-medium text-foreground tabular-nums";
            dd.textContent = item.value;
            wrap.append(dt, dd);
            return wrap;
          }));
        }
        return true;
      };

      const update = () => {
        updateConcreteDiagram();
        if (updateRoofPitchDiagram()) return;
        const values = fields.map(readField).filter((item): item is { label: string; value: string; unit: string } => Boolean(item)).slice(0, 3);

        valueEls.forEach((el, index) => {
          const item = values[index];
          el.textContent = item ? `${item.label}: ${item.value}${item.unit ? ` ${item.unit}` : ""}` : "";
        });

        if (list) {
          list.replaceChildren(...values.map((item) => {
            const wrap = document.createElement("div");
            wrap.className = "rounded-md border border-border bg-muted/30 px-3 py-2";
            const dt = document.createElement("dt");
            dt.className = "text-muted-foreground";
            dt.textContent = item.label;
            const dd = document.createElement("dd");
            dd.className = "mt-0.5 font-mono font-medium text-foreground tabular-nums";
            dd.textContent = `${item.value}${item.unit ? ` ${item.unit}` : ""}`;
            wrap.append(dt, dd);
            return wrap;
          }));
        }
      };

      root.addEventListener("input", update);
      root.addEventListener("change", update);
      root.addEventListener("calculator-state-restored", update);
      update();
      // GenericCalculator may hydrate a shared URL in a sibling module during the
      // same page-load turn. Re-read once after hydration order settles so the
      // schematic always matches the restored project type on first paint.
      queueMicrotask(update);
      requestAnimationFrame(update);
      setTimeout(update, 0);
    });
  }

  document.addEventListener("astro:page-load", initProjectDiagrams);
  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", initProjectDiagrams, { once: true });
  } else {
    initProjectDiagrams();
  }
</script>
