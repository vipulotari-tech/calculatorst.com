            <polygon points="430,105 510,145 510,172 430,132" fill="var(--color-card)" stroke="var(--color-foreground)" stroke-width="2" />
          </g>

          <g data-concrete-volume-shape="1" style="display:none">
            <ellipse cx="320" cy="78" rx="105" ry="30" fill="var(--color-card)" stroke="var(--color-foreground)" stroke-width="2" />
            <path d="M215 78 V172 C215 190 262 204 320 204 C378 204 425 190 425 172 V78" fill="var(--color-card)" stroke="var(--color-foreground)" stroke-width="2" />
            <ellipse cx="320" cy="172" rx="105" ry="30" fill="none" stroke="var(--color-muted-foreground)" stroke-width="1.5" />
          </g>

          <g data-concrete-volume-shape="2" style="display:none">
            <ellipse cx="320" cy="75" rx="112" ry="33" fill="var(--color-card)" stroke="var(--color-foreground)" stroke-width="2" />
            <ellipse cx="320" cy="75" rx="55" ry="17" fill="var(--color-background)" stroke="var(--color-muted-foreground)" stroke-width="1.5" />
            <path d="M208 75 V170 C208 190 258 205 320 205 C382 205 432 190 432 170 V75" fill="none" stroke="var(--color-foreground)" stroke-width="2" />
