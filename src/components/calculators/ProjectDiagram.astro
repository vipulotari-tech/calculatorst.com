        const gutterGroup = figure.querySelector<SVGGElement>("[data-concrete-curb-gutter]");
        if (gutterGroup) gutterGroup.style.display = style === 0 ? "" : "none";

        const fieldById = (id: string) => fields.find((field) => field.id === id);
        const readById = (id: string) => {
          const field = fieldById(id);
          return field ? readField(field) : null;
        };
        const printable = (item: { value: string; unit: string } | null) =>
          item ? `${item.value}${item.unit ? ` ${item.unit}` : ""}` : "—";

        const top = readById("curbWidth");
        const base = profile === 1 ? readById("curbBaseWidth") : top;
        const height = readById("curbHeight");
        const gutterWidth = readById("gutterWidth");
        const gutterThickness = readById("gutterThickness");
        const runLength = readById("length");
        const volume = readById("volume");

        const title = figure.querySelector<SVGTextElement>("[data-concrete-curb-title]");
        const topLabel = figure.querySelector<SVGTextElement>("[data-concrete-curb-top]");
        const baseLabel = figure.querySelector<SVGTextElement>("[data-concrete-curb-base]");
        const heightLabel = figure.querySelector<SVGTextElement>("[data-concrete-curb-height]");
        const gutterWidthLabel = figure.querySelector<SVGTextElement>("[data-concrete-curb-gutter-width]");
        const gutterThicknessLabel = figure.querySelector<SVGTextElement>("[data-concrete-curb-gutter-thickness]");
        const modeLabel = figure.querySelector<SVGTextElement>("[data-concrete-curb-mode]");
        const summary = figure.querySelector<SVGTextElement>("[data-concrete-curb-summary]");

        if (title) title.textContent = `${style === 0 ? "Curb + gutter" : "Curb only"} · ${profile === 1 ? "tapered curb" : "rectangular curb"}`;
        if (topLabel) topLabel.textContent = `Top: ${printable(top)}`;
        if (baseLabel) baseLabel.textContent = `Base: ${printable(base)}`;
        if (heightLabel) heightLabel.textContent = `Height: ${printable(height)}`;
        if (gutterWidthLabel) gutterWidthLabel.textContent = style === 0 ? `Gutter: ${printable(gutterWidth)}` : "";
        if (gutterThicknessLabel) gutterThicknessLabel.textContent = style === 0 ? `T: ${printable(gutterThickness)}` : "";
        if (modeLabel) modeLabel.textContent = mode === 1 ? `Reverse · available ${printable(volume)}` : `Forward · run ${printable(runLength)}`;
        if (summary) summary.textContent = style === 0 ? "Non-overlapping curb + gutter section" : "Curb section only";

        const topFt = toFeet(numericControl("curbWidth"), unitControl("curbWidth"));
        const baseFt = profile === 1 ? toFeet(numericControl("curbBaseWidth"), unitControl("curbBaseWidth")) : topFt;
        const heightFt = toFeet(numericControl("curbHeight"), unitControl("curbHeight"));
        const gutterWFt = style === 0 ? toFeet(numericControl("gutterWidth"), unitControl("gutterWidth")) : 0;
        const gutterTFt = style === 0 ? toFeet(numericControl("gutterThickness"), unitControl("gutterThickness")) : 0;
        const curbArea = Number.isFinite(topFt) && Number.isFinite(baseFt) && Number.isFinite(heightFt)
          ? (profile === 1 ? (topFt + baseFt) / 2 * heightFt : topFt * heightFt)
          : Number.NaN;
        const gutterArea = Number.isFinite(gutterWFt) && Number.isFinite(gutterTFt) ? gutterWFt * gutterTFt : 0;
        const totalArea = curbArea + gutterArea;

        if (list) {
          const metrics = [
            { label: "Curb profile", value: profile === 1 ? `${printable(top)} top · ${printable(base)} base` : `${printable(top)} wide` },
            { label: "Section height", value: printable(height) },
            { label: "Cross-section", value: Number.isFinite(totalArea) ? `${totalArea.toFixed(4)} ft²` : "—" },
          ];
          list.replaceChildren(...metrics.map((item) => {
            const wrap = document.createElement("div");
            wrap.className = "rounded-md border border-border bg-muted/30 px-3 py-2";
            const dt = document.createElement("dt");
            dt.className = "text-muted-foreground";
            dt.textContent = item.label;
            const dd = document.createElement("dd");
            dd.className = "mt-0.5 font-mono font-medium text-foreground tabular-nums";
            dd.textContent = item.value;
            wrap.append(dt, dd);
            return wrap;
          }));
        }

        return true;
      };

      const updateConcreteStairDiagram = () => {
        if (figure.dataset.kind !== "concreteStair") return false;

        const model = Math.round(numericControl("stairModel"));
        figure.querySelectorAll<SVGGElement>("[data-concrete-stair-model]").forEach((group) => {
          group.style.display = group.dataset.concreteStairModel === String(model) ? "" : "none";
        });

        const fieldById = (id: string) => fields.find((field) => field.id === id);
        const readById = (id: string) => {
          const field = fieldById(id);
          return field ? readField(field) : null;
        };
        const printable = (item: { value: string; unit: string } | null) =>
          item ? `${item.value}${item.unit ? ` ${item.unit}` : ""}` : "—";

        const width = readById("width");
        const rise = readById("rise");
        const run = readById("run");
        const waist = readById("waistThickness");
        const landingLength = readById("landingLength");
        const landingWidth = readById("landingWidth");
        const landingThickness = readById("landingThickness");
        const steps = Math.max(1, Math.round(numericControl("steps") || 1));
        const landingActive = (numericControl("landingLength") || 0) > 0;

        figure.querySelectorAll<SVGGElement>("[data-concrete-stair-landing]").forEach((group) => {
          const target = group.dataset.concreteStairLanding;
          const visible = landingActive && ((model === 0 && target === "solid") || (model === 1 && target === "waist"));
          group.style.display = visible ? "" : "none";
        });

        const name = figure.querySelector<SVGTextElement>("[data-concrete-stair-model-name]");
        const stepLabel = figure.querySelector<SVGTextElement>("[data-concrete-stair-step]");
        const totalLabel = figure.querySelector<SVGTextElement>("[data-concrete-stair-total]");
        const detail = figure.querySelector<SVGTextElement>("[data-concrete-stair-detail]");

        if (name) name.textContent = model === 1 ? "Waist-slab RCC" : "Solid / mass concrete";
        if (stepLabel) stepLabel.textContent = `${steps} steps · rise ${printable(rise)} · tread ${printable(run)}`;

        const riseValue = numericControl("rise");
        const runValue = numericControl("run");
        const riseUnit = unitControl("rise");
        const runUnit = unitControl("run");
        const totalRiseDisplay = Number.isFinite(riseValue) ? `${(riseValue * steps).toFixed(2)} ${riseUnit}` : "—";
        const totalRunDisplay = Number.isFinite(runValue) ? `${(runValue * steps).toFixed(2)} ${runUnit}` : "—";
        if (totalLabel) totalLabel.textContent = `Total rise ${totalRiseDisplay} · total run ${totalRunDisplay}`;

        const landingWValue = (numericControl("landingWidth") || 0) > 0 ? printable(landingWidth) : printable(width);
        const detailParts = [`width ${printable(width)}`];
        if (model === 1) detailParts.push(`waist ${printable(waist)}`);
        if (landingActive) {
          detailParts.push(model === 1
            ? `landing ${printable(landingLength)} × ${landingWValue} × ${(numericControl("landingThickness") || 0) > 0 ? printable(landingThickness) : printable(waist)}`
            : `platform ${printable(landingLength)} × ${landingWValue} full height`);
        }
        if (detail) detail.textContent = detailParts.join(" · ");

        const riseFt = toFeet(riseValue, riseUnit);
        const runFt = toFeet(runValue, runUnit);
        const angle = Number.isFinite(riseFt) && Number.isFinite(runFt) && runFt > 0
          ? Math.atan(riseFt / runFt) * 180 / Math.PI
          : Number.NaN;

        if (list) {
          const metrics = [
            { label: "Step geometry", value: `${printable(rise)} rise × ${printable(run)} tread × ${steps}` },
            { label: "Flight totals", value: `${totalRiseDisplay} rise · ${totalRunDisplay} run` },
            {
              label: model === 1 ? "Waist / slope" : "Model / slope",
              value: model === 1
                ? `${printable(waist)} waist · ${Number.isFinite(angle) ? angle.toFixed(2) + "°" : "—"}`
                : `Mass fill · ${Number.isFinite(angle) ? angle.toFixed(2) + "°" : "—"}`,
            },
          ];
          list.replaceChildren(...metrics.map((item) => {
            const wrap = document.createElement("div");
            wrap.className = "rounded-md border border-border bg-muted/30 px-3 py-2";
            const dt = document.createElement("dt");
            dt.className = "text-muted-foreground";
            dt.textContent = item.label;
            const dd = document.createElement("dd");
            dd.className = "mt-0.5 font-mono font-medium text-foreground tabular-nums";
            dd.textContent = item.value;
            wrap.append(dt, dd);
            return wrap;
          }));
        }

        return true;
      };

      const updateConcreteFootingDiagram = () => {
        if (figure.dataset.kind !== "concreteFooting") return;
        const shape = Math.round(numericControl("footingShape"));
        const names = [
          "Strip / continuous footing",
          "Square isolated pad",
          "Rectangular isolated pad",
          "Round / circular footing",
        ];
        figure.querySelectorAll<SVGGElement>("[data-concrete-footing-shape]").forEach((group) => {
          group.style.display = group.dataset.concreteFootingShape === String(shape) ? "" : "none";
        });
        const name = figure.querySelector<SVGTextElement>("[data-concrete-footing-shape-name]");
        if (name) name.textContent = names[shape] ?? "Concrete footing geometry";
      };

      const updateConcreteDiagram = () => {
        if (figure.dataset.kind !== "concrete") return;
        const shape = Math.round(numericControl("shape"));
        const names = ["Rectangular slab", "Strip footing", "Wall", "Cylinder / column"];
        figure.querySelectorAll<SVGGElement>("[data-concrete-shape]").forEach((group) => {
          group.style.display = group.dataset.concreteShape === String(shape) ? "" : "none";
        });
        const name = figure.querySelector<SVGTextElement>("[data-concrete-shape-name]");
        if (name) name.textContent = names[shape] ?? "Concrete shape";
      };

      const updateRoofPitchDiagram = () => {
        if (figure.dataset.kind !== "roofPitch") return false;

        const mode = Math.round(numericControl("mode"));
        let slope = 0;
        let runFt = Number.NaN;
        let riseFt = Number.NaN;
        let rafterFt = Number.NaN;

        if (mode === 1) {
          const angle = numericControl("angleInput");
          slope = Math.tan(angle * Math.PI / 180);
          const ref = numericControl("referenceRun");
          if (Number.isFinite(ref)) {
            runFt = toFeet(ref, unitControl("referenceRun"));
            riseFt = runFt * slope;
            rafterFt = Math.hypot(runFt, riseFt);
          }
        } else if (mode === 2) {
          slope = numericControl("pitchInput") / 12;
          const ref = numericControl("referenceRun");
          if (Number.isFinite(ref)) {
            runFt = toFeet(ref, unitControl("referenceRun"));
            riseFt = runFt * slope;
            rafterFt = Math.hypot(runFt, riseFt);
          }
        } else if (mode === 3) {
          runFt = toFeet(numericControl("run"), unitControl("run"));
          rafterFt = toFeet(numericControl("rafterLength"), unitControl("rafterLength"));
          if (Number.isFinite(runFt) && Number.isFinite(rafterFt) && rafterFt >= runFt && runFt > 0) {
            riseFt = Math.sqrt(Math.max(0, rafterFt * rafterFt - runFt * runFt));
            slope = riseFt / runFt;
          }
        } else {
          runFt = toFeet(numericControl("run"), unitControl("run"));
          riseFt = toFeet(numericControl("rise"), unitControl("rise"));
          if (Number.isFinite(runFt) && runFt > 0 && Number.isFinite(riseFt)) {
            slope = riseFt / runFt;
            rafterFt = Math.hypot(runFt, riseFt);
          }
        }

        if (!Number.isFinite(slope) || slope < 0) slope = 0;
        const angle = Math.atan(slope) * 180 / Math.PI;
        const pitch = slope * 12;
        const multiplier = Math.hypot(1, slope);

        const baseY = 185;
        const topY = Math.max(38, baseY - Math.min(147, slope * 150));
        const riseLine = figure.querySelector<SVGLineElement>("[data-roof-pitch-rise]");
        const rafterLine = figure.querySelector<SVGLineElement>("[data-roof-pitch-rafter]");
        riseLine?.setAttribute("y2", String(topY));
        rafterLine?.setAttribute("y2", String(topY));

        const riseLabel = figure.querySelector<SVGTextElement>("[data-roof-pitch-rise-label]");
        const rafterLabel = figure.querySelector<SVGTextElement>("[data-roof-pitch-rafter-label]");
        const runLabel = figure.querySelector<SVGTextElement>("[data-roof-pitch-run-label]");
        const angleLabel = figure.querySelector<SVGTextElement>("[data-roof-pitch-angle-label]");

        if (riseLabel) {
          riseLabel.setAttribute("y", String((baseY + topY) / 2));
          riseLabel.textContent = Number.isFinite(riseFt) ? `Rise: ${riseFt.toFixed(3)} ft` : `Pitch: ${pitch.toFixed(2)}:12`;
        }
        if (rafterLabel) {
          rafterLabel.setAttribute("y", String(Math.max(32, topY - 10)));
          rafterLabel.textContent = Number.isFinite(rafterFt) ? `Rafter: ${rafterFt.toFixed(3)} ft` : `Multiplier: ${multiplier.toFixed(4)}×`;
        }
        if (runLabel) runLabel.textContent = Number.isFinite(runFt) ? `Horizontal run: ${runFt.toFixed(3)} ft` : "Horizontal run";
        if (angleLabel) angleLabel.textContent = `${angle.toFixed(2)}° · ${pitch.toFixed(2)}:12`;

        if (list) {
          const metrics = [
            { label: "Pitch", value: `${pitch.toFixed(2)}:12` },
            { label: "Angle", value: `${angle.toFixed(2)}°` },
            { label: "Surface multiplier", value: `${multiplier.toFixed(4)}×` },
          ];
          list.replaceChildren(...metrics.map((item) => {
            const wrap = document.createElement("div");
            wrap.className = "rounded-md border border-border bg-muted/30 px-3 py-2";
            const dt = document.createElement("dt");
            dt.className = "text-muted-foreground";
            dt.textContent = item.label;
            const dd = document.createElement("dd");
            dd.className = "mt-0.5 font-mono font-medium text-foreground tabular-nums";
            dd.textContent = item.value;
            wrap.append(dt, dd);
            return wrap;
          }));
        }
        return true;
      };

      const update = () => {
        if (updateConcretePourDiagram()) return;
        if (updateConcreteWasteDiagram()) return;
        if (updateConcreteMixDiagram()) return;
        updateConcreteCostDiagram();
        updateConcreteWeightDiagram();
        updateConcreteVolumeDiagram();
        if (updateConcreteSlabDiagram()) return;
        if (updateBrickJointDiagram()) return;
        if (updateConcreteCurbDiagram()) return;
        if (updateConcreteStairDiagram()) return;
        updateConcreteFootingDiagram();
        updateConcreteDiagram();
        if (updateRoofPitchDiagram()) return;
        const values = fields.map(readField).filter((item): item is { label: string; value: string; unit: string } => Boolean(item)).slice(0, 3);

        valueEls.forEach((el, index) => {
          const item = values[index];
          el.textContent = item ? `${item.label}: ${item.value}${item.unit ? ` ${item.unit}` : ""}` : "";
        });

        if (list) {
          list.replaceChildren(...values.map((item) => {
            const wrap = document.createElement("div");
            wrap.className = "rounded-md border border-border bg-muted/30 px-3 py-2";
            const dt = document.createElement("dt");
            dt.className = "text-muted-foreground";
            dt.textContent = item.label;
            const dd = document.createElement("dd");
            dd.className = "mt-0.5 font-mono font-medium text-foreground tabular-nums";
            dd.textContent = `${item.value}${item.unit ? ` ${item.unit}` : ""}`;
            wrap.append(dt, dd);
            return wrap;
          }));
        }
      };

      root.addEventListener("input", update);
      root.addEventListener("change", update);
      root.addEventListener("calculator-state-restored", update);
      update();
      // GenericCalculator may hydrate a shared URL in a sibling module during the
      // same page-load turn. Re-read once after hydration order settles so the
      // schematic always matches the restored project type on first paint.
      queueMicrotask(update);
      requestAnimationFrame(update);
      setTimeout(update, 0);
    });
  }

  document.addEventListener("astro:page-load", initProjectDiagrams);
  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", initProjectDiagrams, { once: true });
  } else {
    initProjectDiagrams();
  }
</script>
