              : mode === 3
                ? "Wall / rectangular footing"
                : "Slab / patio / driveway";
        }
        if (truckPlanLabel) {
          truckPlanLabel.textContent = Number.isFinite(loads)
            ? `Final order buildup · ${loads} truck load${loads === 1 ? "" : "s"}`
            : "Final order buildup";
        }
        if (netLabel) netLabel.textContent = Number.isFinite(netYd3) ? `Net ${netYd3.toFixed(3)} yd³` : "Net";
        if (targetLabel) targetLabel.textContent = Number.isFinite(targetYd3) ? `Target ${targetYd3.toFixed(3)} yd³` : "Target + allowance";
        if (orderLabel) orderLabel.textContent = Number.isFinite(orderedYd3) ? `Order ${orderedYd3.toFixed(3)} yd³` : "Supplier-rounded order";
        if (allowanceLabel) allowanceLabel.textContent = `Allowance ${allowance.toFixed(2)}%`;
        if (roundingLabel) roundingLabel.textContent = Number.isFinite(roundingYd3) ? `Rounding +${roundingYd3.toFixed(3)} yd³` : "Supplier rounding";
        if (effectiveLabel) effectiveLabel.textContent = Number.isFinite(effectivePct) ? `Effective +${effectivePct.toFixed(2)}%` : "Effective overage";

        if (list) {
          const metrics = [
            { label: "Net volume", value: Number.isFinite(netYd3) ? `${netYd3.toFixed(3)} yd³` : "—" },
            { label: "Rounded order", value: Number.isFinite(orderedYd3) ? `${orderedYd3.toFixed(3)} yd³` : "—" },
            {
              label: "Truck plan",
              value: Number.isFinite(loads)
