      )}

      {kind === "line" && (
        <>
          <line x1="90" y1="185" x2="550" y2="185" stroke="var(--color-muted-foreground)" stroke-width="2" />
          {[120,220,320,420,520].map((x) => <rect x={x} y="70" width="10" height="115" rx="2" fill="var(--color-foreground)" />)}
