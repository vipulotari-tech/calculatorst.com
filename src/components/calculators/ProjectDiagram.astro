          <text x="320" y="23" text-anchor="middle" font-size="13" fill="var(--color-foreground)" data-diagram-value="0">Measurement 1</text>
          <text x="452" y="125" font-size="13" fill="var(--color-foreground)" data-diagram-value="1">Measurement 2</text>
          <text x="320" y="132" text-anchor="middle" font-size="13" fill="var(--color-muted-foreground)" data-diagram-value="2">Measurement 3</text>
        </>
      )}

      {kind === "rect" && (
        <>
          <polygon points="145,75 445,75 520,125 220,125" fill="var(--color-card)" stroke="var(--color-foreground)" stroke-width="2" />
          <polygon points="220,125 520,125 520,180 220,180" fill="var(--color-card)" stroke="var(--color-foreground)" stroke-width="2" />
          <polygon points="445,75 520,125 520,180 445,130" fill="var(--color-card)" stroke="var(--color-foreground)" stroke-width="2" />
          <text x="370" y="210" text-anchor="middle" font-size="13" fill="var(--color-foreground)" data-diagram-value="0">Measurement 1</text>
          <text x="145" y="115" text-anchor="middle" font-size="13" fill="var(--color-foreground)" transform="rotate(-34 145 115)" data-diagram-value="1">Measurement 2</text>
          <text x="535" y="160" font-size="13" fill="var(--color-muted-foreground)" data-diagram-value="2">Measurement 3</text>
        </>
      )}
    </svg>

    <dl class="calc-project-diagram-values mt-3 grid gap-2 text-xs sm:grid-cols-3"></dl>
  </figure>
)}

<script>
  function initProjectDiagrams() {
    document.querySelectorAll<HTMLElement>("[data-project-diagram]").forEach((figure) => {
      if (figure.dataset.initialized) return;
      figure.dataset.initialized = "true";

      const root = figure.closest<HTMLElement>("[data-calculator-slug]");
      if (!root) return;
      const slug = root.dataset.calculatorSlug;
      if (!slug) return;

      let fields: Array<{ id: string; label: string; unit?: string }> = [];
      try {
        fields = JSON.parse(figure.dataset.fields ?? "[]");
      } catch {
        return;
      }

      const valueEls = Array.from(figure.querySelectorAll<SVGTextElement>("[data-diagram-value]"));
      const list = figure.querySelector<HTMLElement>(".calc-project-diagram-values");

      const readField = (field: { id: string; label: string; unit?: string }) => {
        const wrapper = root.querySelector<HTMLElement>(`#${slug}-field-${field.id}`);
        if (wrapper?.hidden) return null;
        const control = root.querySelector<HTMLInputElement | HTMLSelectElement>(`#${slug}-${field.id}`);
        if (!control || control.value === "") return null;

        const unitSelect = root.querySelector<HTMLSelectElement>(`#${slug}-${field.id}-unit`);
        const unit = unitSelect?.selectedOptions[0]?.textContent?.trim() || field.unit || "";
        return { label: field.label, value: control.value, unit };
      };

      const toFeet = (value: number, unit: string) => {
        if (!Number.isFinite(value)) return Number.NaN;
        if (unit === "in") return value / 12;
        if (unit === "yd") return value * 3;
        if (unit === "m") return value * 3.280839895;
        if (unit === "cm") return value / 30.48;
        if (unit === "mm") return value / 304.8;
        return value;
      };

      const numericControl = (id: string) => {
        const control = root.querySelector<HTMLInputElement | HTMLSelectElement>(`#${slug}-${id}`);
        return control && control.value !== "" ? Number(control.value) : Number.NaN;
      };

      const unitControl = (id: string) => {
        const select = root.querySelector<HTMLSelectElement>(`#${slug}-${id}-unit`);
        return select?.value ?? "ft";
      };

      const updateConcreteWeightDiagram = () => {
        if (figure.dataset.kind !== "concreteWeight") return;
        const mode = Math.round(numericControl("weightMode"));
        figure.hidden = mode === 0;
        figure.querySelectorAll<SVGGElement>("[data-concrete-weight-shape]").forEach((group) => {
          group.style.display = group.dataset.concreteWeightShape === String(mode) ? "" : "none";
        });
        const name = figure.querySelector<SVGTextElement>("[data-concrete-weight-mode-name]");
        if (name) {
          name.textContent = mode === 2
            ? "Round slab / cylinder dimensions"
            : mode === 3
              ? "Surface area × thickness"
              : "Length × width × thickness";
        }
      };

      const toSquareFeet = (value: number, unit: string) => {
        if (!Number.isFinite(value)) return Number.NaN;
        if (unit === "yd2") return value * 9;
        if (unit === "m2") return value * 10.7639104167;
        if (unit === "cm2") return value / 929.0304;
        if (unit === "mm2") return value / 92903.04;
        return value;
      };

      const toCubicFeet = (value: number, unit: string) => {
        if (!Number.isFinite(value)) return Number.NaN;
        if (unit === "yd3") return value * 27;
        if (unit === "m3") return value * 35.3146667215;
        if (unit === "L") return value / 28.316846592;
        return value;
      };

      const updateConcretePourDiagram = () => {
        if (figure.dataset.kind !== "concretePour") return false;

        const mode = Math.round(numericControl("pourInputMode"));
        let netFt3 = Number.NaN;
        if (mode === 1) {
          netFt3 = toCubicFeet(numericControl("volume"), unitControl("volume"));
        } else if (mode === 2) {
          const area = toSquareFeet(numericControl("area"), unitControl("area"));
          const thickness = toFeet(numericControl("areaThickness"), unitControl("areaThickness"));
          const quantity = Math.max(1, numericControl("quantity") || 1);
          netFt3 = area * thickness * quantity;
        } else {
          const length = toFeet(numericControl("length"), unitControl("length"));
          const width = toFeet(numericControl("width"), unitControl("width"));
          const depth = toFeet(numericControl("depth"), unitControl("depth"));
          const quantity = Math.max(1, numericControl("quantity") || 1);
          netFt3 = length * width * depth * quantity;
        }

        const allowance = Math.max(0, numericControl("waste") || 0);
        const capacity = Math.max(0, numericControl("truckCapacity") || 0);
        const threshold = Math.max(0, numericControl("minOrder") || 0);
        const rate = Math.max(0, numericControl("pumpRate") || 0);
        const orderYd3 = Number.isFinite(netFt3) ? netFt3 * (1 + allowance / 100) / 27 : Number.NaN;
        const loads = capacity > 0 && Number.isFinite(orderYd3) ? Math.max(1, Math.ceil(orderYd3 / capacity)) : Number.NaN;
        const finalLoad = capacity > 0 && Number.isFinite(loads) ? Math.max(0, orderYd3 - (loads - 1) * capacity) : Number.NaN;
        const utilization = capacity > 0 && Number.isFinite(finalLoad) ? Math.max(0, Math.min(100, finalLoad / capacity * 100)) : 0;
        const thresholdPct = capacity > 0 ? Math.max(0, Math.min(100, threshold / capacity * 100)) : 0;
        const durationMin = rate > 0 && Number.isFinite(orderYd3) ? orderYd3 / rate * 60 : Number.NaN;

        const fill = figure.querySelector<SVGRectElement>("[data-pour-final-fill]");
        if (fill) fill.setAttribute("width", String(500 * utilization / 100));
        const thresholdLine = figure.querySelector<SVGLineElement>("[data-pour-threshold-line]");
        if (thresholdLine) {
          const x = 34 + 500 * thresholdPct / 100;
          thresholdLine.setAttribute("x1", String(x));
          thresholdLine.setAttribute("x2", String(x));
        }

        const countText = figure.querySelector<SVGTextElement>("[data-pour-load-count]");
        const finalText = figure.querySelector<SVGTextElement>("[data-pour-final-label]");
        const durationText = figure.querySelector<SVGTextElement>("[data-pour-duration-label]");
        if (countText) countText.textContent = Number.isFinite(loads) ? `${loads} ready-mix load${loads === 1 ? "" : "s"} · ${orderYd3.toFixed(2)} yd³ scheduled` : "Ready-mix load plan";
        if (finalText) finalText.textContent = Number.isFinite(finalLoad) ? `${finalLoad.toFixed(2)} / ${capacity.toFixed(2)} yd³ · ${utilization.toFixed(1)}%` : "Final load";
        if (durationText) durationText.textContent = Number.isFinite(durationMin) ? `${durationMin.toFixed(1)} min active pour` : "Pour duration";

        if (list) {
          const metrics = [
            { label: "Truck loads", value: Number.isFinite(loads) ? String(loads) : "—" },
            { label: "Final load", value: Number.isFinite(finalLoad) ? `${finalLoad.toFixed(2)} yd³` : "—" },
            { label: "Short-load threshold", value: capacity > 0 ? `${threshold.toFixed(2)} yd³` : "—" },
          ];
          list.replaceChildren(...metrics.map((item) => {
            const wrap = document.createElement("div");
            wrap.className = "rounded-md border border-border bg-muted/30 px-3 py-2";
            const dt = document.createElement("dt");
            dt.className = "text-muted-foreground";
            dt.textContent = item.label;
            const dd = document.createElement("dd");
            dd.className = "mt-0.5 font-mono font-medium text-foreground tabular-nums";
            dd.textContent = item.value;
            wrap.append(dt, dd);
            return wrap;
          }));
        }
        return true;
      };

      const updateConcreteMixDiagram = () => {
        if (figure.dataset.kind !== "concreteMix") return false;

        const preset = Math.round(numericControl("mixPreset"));
        const presets: Record<number, [number, number, number]> = {
          1: [1, 2, 3],
          2: [1, 1.5, 3],
          3: [1, 2, 4],
          4: [1, 3, 6],
          5: [1, 4, 8],
          6: [1, 5, 10],
        };
        const custom: [number, number, number] = [
          Math.max(0, numericControl("cementParts") || 0),
          Math.max(0, numericControl("sandParts") || 0),
          Math.max(0, numericControl("aggregateParts") || 0),
        ];
        const [cement, sand, aggregate] = presets[preset] ?? custom;
        const maxPart = Math.max(1, cement, sand, aggregate);

        const setBar = (selector: string, value: number) => {
          const bar = figure.querySelector<SVGRectElement>(selector);
          bar?.setAttribute("width", String(360 * value / maxPart));
        };
        setBar("[data-concrete-mix-cement-bar]", cement);
        setBar("[data-concrete-mix-sand-bar]", sand);
        setBar("[data-concrete-mix-aggregate-bar]", aggregate);

        const ratio = figure.querySelector<SVGTextElement>("[data-concrete-mix-ratio]");
        const cementText = figure.querySelector<SVGTextElement>("[data-concrete-mix-cement]");
        const sandText = figure.querySelector<SVGTextElement>("[data-concrete-mix-sand]");
        const aggregateText = figure.querySelector<SVGTextElement>("[data-concrete-mix-aggregate]");
        if (ratio) ratio.textContent = `Ratio ${cement} : ${sand} : ${aggregate}`;
        if (cementText) cementText.textContent = `${cement} part${cement === 1 ? "" : "s"}`;
        if (sandText) sandText.textContent = `${sand} part${sand === 1 ? "" : "s"}`;
        if (aggregateText) aggregateText.textContent = `${aggregate} part${aggregate === 1 ? "" : "s"}`;

        if (list) {
          const metrics = [
            { label: "Ratio", value: `${cement} : ${sand} : ${aggregate}` },
            { label: "Dry-volume factor", value: String(numericControl("dryFactor")) },
            { label: "Water/cement ratio", value: String(numericControl("waterRatio")) },
          ];
          list.replaceChildren(...metrics.map((item) => {
            const wrap = document.createElement("div");
            wrap.className = "rounded-md border border-border bg-muted/30 px-3 py-2";
            const dt = document.createElement("dt");
            dt.className = "text-muted-foreground";
            dt.textContent = item.label;
            const dd = document.createElement("dd");
            dd.className = "mt-0.5 font-mono font-medium text-foreground tabular-nums";
            dd.textContent = item.value;
            wrap.append(dt, dd);
            return wrap;
          }));
        }
        return true;
      };

      const updateConcreteCostDiagram = () => {
        if (figure.dataset.kind !== "concreteCost") return;
        const mode = Math.round(numericControl("costMode"));
        figure.hidden = mode === 1;
        figure.querySelectorAll<SVGGElement>("[data-concrete-cost-shape]").forEach((group) => {
          group.style.display = group.dataset.concreteCostShape === String(mode) ? "" : "none";
        });
        const name = figure.querySelector<SVGTextElement>("[data-concrete-cost-mode-name]");
        if (name) {
          name.textContent = mode === 2
            ? "Surface area × thickness"
            : mode === 3
              ? "Round slab / cylinder dimensions"
              : "Length × width × thickness";
        }
      };

      const updateConcreteVolumeDiagram = () => {
        if (figure.dataset.kind !== "concreteVolume") return;
        const shape = Math.round(numericControl("shape"));
        const names = [
          "Rectangular slab / prism",
          "Round slab / cylinder / column",
          "Hollow tube / annular cylinder",
          "Curb + gutter",
          "Solid stairs (mass fill)",
          "Triangle prism / wedge",
          "Concrete wall",
          "Strip footing",
          "Square / rectangular column",
        ];
        figure.querySelectorAll<SVGGElement>("[data-concrete-volume-shape]").forEach((group) => {
          group.style.display = group.dataset.concreteVolumeShape === String(shape) ? "" : "none";
        });
        const name = figure.querySelector<SVGTextElement>("[data-concrete-volume-shape-name]");
        if (name) name.textContent = names[shape] ?? "Concrete volume shape";
      };

      const updateConcreteDiagram = () => {
        if (figure.dataset.kind !== "concrete") return;
        const shape = Math.round(numericControl("shape"));
        const names = ["Rectangular slab", "Strip footing", "Wall", "Cylinder / column"];
        figure.querySelectorAll<SVGGElement>("[data-concrete-shape]").forEach((group) => {
          group.style.display = group.dataset.concreteShape === String(shape) ? "" : "none";
        });
        const name = figure.querySelector<SVGTextElement>("[data-concrete-shape-name]");
        if (name) name.textContent = names[shape] ?? "Concrete shape";
      };

      const updateRoofPitchDiagram = () => {
        if (figure.dataset.kind !== "roofPitch") return false;

        const mode = Math.round(numericControl("mode"));
        let slope = 0;
        let runFt = Number.NaN;
        let riseFt = Number.NaN;
        let rafterFt = Number.NaN;

        if (mode === 1) {
          const angle = numericControl("angleInput");
          slope = Math.tan(angle * Math.PI / 180);
          const ref = numericControl("referenceRun");
          if (Number.isFinite(ref)) {
            runFt = toFeet(ref, unitControl("referenceRun"));
            riseFt = runFt * slope;
            rafterFt = Math.hypot(runFt, riseFt);
          }
        } else if (mode === 2) {
          slope = numericControl("pitchInput") / 12;
          const ref = numericControl("referenceRun");
          if (Number.isFinite(ref)) {
            runFt = toFeet(ref, unitControl("referenceRun"));
            riseFt = runFt * slope;
            rafterFt = Math.hypot(runFt, riseFt);
          }
        } else if (mode === 3) {
          runFt = toFeet(numericControl("run"), unitControl("run"));
          rafterFt = toFeet(numericControl("rafterLength"), unitControl("rafterLength"));
          if (Number.isFinite(runFt) && Number.isFinite(rafterFt) && rafterFt >= runFt && runFt > 0) {
            riseFt = Math.sqrt(Math.max(0, rafterFt * rafterFt - runFt * runFt));
            slope = riseFt / runFt;
          }
        } else {
          runFt = toFeet(numericControl("run"), unitControl("run"));
          riseFt = toFeet(numericControl("rise"), unitControl("rise"));
          if (Number.isFinite(runFt) && runFt > 0 && Number.isFinite(riseFt)) {
            slope = riseFt / runFt;
            rafterFt = Math.hypot(runFt, riseFt);
          }
        }

        if (!Number.isFinite(slope) || slope < 0) slope = 0;
        const angle = Math.atan(slope) * 180 / Math.PI;
        const pitch = slope * 12;
        const multiplier = Math.hypot(1, slope);

        const baseY = 185;
        const topY = Math.max(38, baseY - Math.min(147, slope * 150));
        const riseLine = figure.querySelector<SVGLineElement>("[data-roof-pitch-rise]");
        const rafterLine = figure.querySelector<SVGLineElement>("[data-roof-pitch-rafter]");
        riseLine?.setAttribute("y2", String(topY));
        rafterLine?.setAttribute("y2", String(topY));

        const riseLabel = figure.querySelector<SVGTextElement>("[data-roof-pitch-rise-label]");
        const rafterLabel = figure.querySelector<SVGTextElement>("[data-roof-pitch-rafter-label]");
        const runLabel = figure.querySelector<SVGTextElement>("[data-roof-pitch-run-label]");
        const angleLabel = figure.querySelector<SVGTextElement>("[data-roof-pitch-angle-label]");

        if (riseLabel) {
          riseLabel.setAttribute("y", String((baseY + topY) / 2));
          riseLabel.textContent = Number.isFinite(riseFt) ? `Rise: ${riseFt.toFixed(3)} ft` : `Pitch: ${pitch.toFixed(2)}:12`;
        }
        if (rafterLabel) {
          rafterLabel.setAttribute("y", String(Math.max(32, topY - 10)));
          rafterLabel.textContent = Number.isFinite(rafterFt) ? `Rafter: ${rafterFt.toFixed(3)} ft` : `Multiplier: ${multiplier.toFixed(4)}×`;
        }
        if (runLabel) runLabel.textContent = Number.isFinite(runFt) ? `Horizontal run: ${runFt.toFixed(3)} ft` : "Horizontal run";
        if (angleLabel) angleLabel.textContent = `${angle.toFixed(2)}° · ${pitch.toFixed(2)}:12`;

        if (list) {
          const metrics = [
            { label: "Pitch", value: `${pitch.toFixed(2)}:12` },
            { label: "Angle", value: `${angle.toFixed(2)}°` },
            { label: "Surface multiplier", value: `${multiplier.toFixed(4)}×` },
          ];
          list.replaceChildren(...metrics.map((item) => {
            const wrap = document.createElement("div");
            wrap.className = "rounded-md border border-border bg-muted/30 px-3 py-2";
            const dt = document.createElement("dt");
            dt.className = "text-muted-foreground";
            dt.textContent = item.label;
            const dd = document.createElement("dd");
            dd.className = "mt-0.5 font-mono font-medium text-foreground tabular-nums";
            dd.textContent = item.value;
            wrap.append(dt, dd);
            return wrap;
          }));
        }
        return true;
      };

      const update = () => {
        if (updateConcretePourDiagram()) return;
        if (updateConcreteMixDiagram()) return;
        updateConcreteCostDiagram();
        updateConcreteWeightDiagram();
        updateConcreteVolumeDiagram();
        updateConcreteDiagram();
        if (updateRoofPitchDiagram()) return;
        const values = fields.map(readField).filter((item): item is { label: string; value: string; unit: string } => Boolean(item)).slice(0, 3);

        valueEls.forEach((el, index) => {
          const item = values[index];
          el.textContent = item ? `${item.label}: ${item.value}${item.unit ? ` ${item.unit}` : ""}` : "";
        });

        if (list) {
          list.replaceChildren(...values.map((item) => {
            const wrap = document.createElement("div");
            wrap.className = "rounded-md border border-border bg-muted/30 px-3 py-2";
            const dt = document.createElement("dt");
            dt.className = "text-muted-foreground";
            dt.textContent = item.label;
            const dd = document.createElement("dd");
            dd.className = "mt-0.5 font-mono font-medium text-foreground tabular-nums";
            dd.textContent = `${item.value}${item.unit ? ` ${item.unit}` : ""}`;
            wrap.append(dt, dd);
            return wrap;
          }));
        }
      };

      root.addEventListener("input", update);
      root.addEventListener("change", update);
      root.addEventListener("calculator-state-restored", update);
      update();
      // GenericCalculator may hydrate a shared URL in a sibling module during the
      // same page-load turn. Re-read once after hydration order settles so the
      // schematic always matches the restored project type on first paint.
      queueMicrotask(update);
      requestAnimationFrame(update);
      setTimeout(update, 0);
    });
  }

  document.addEventListener("astro:page-load", initProjectDiagrams);
  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", initProjectDiagrams, { once: true });
  } else {
    initProjectDiagrams();
  }
</script>
