          <text x="34" y="82" font-size="11" fill="var(--color-muted-foreground)" data-waste-truck-plan>Final order buildup</text>
          <rect x="34" y="96" width="500" height="44" rx="8" fill="var(--color-muted)" opacity="0.24" />
          <rect x="34" y="96" width="350" height="44" rx="8" fill="var(--color-foreground)" opacity="0.62" data-waste-net-bar />
          <rect x="384" y="96" width="80" height="44" fill="var(--color-foreground)" opacity="0.36" data-waste-allowance-bar />
          <rect x="464" y="96" width="70" height="44" rx="0 8 8 0" fill="var(--color-foreground)" opacity="0.18" data-waste-rounding-bar />

          <text x="34" y="161" font-size="11" fill="var(--color-foreground)" data-waste-net-label>Net</text>
          <text x="250" y="161" text-anchor="middle" font-size="11" fill="var(--color-foreground)" data-waste-target-label>Target + allowance</text>
          <text x="534" y="161" text-anchor="end" font-size="11" fill="var(--color-foreground)" data-waste-order-label>Supplier-rounded order</text>

          <line x1="34" y1="186" x2="534" y2="186" stroke="var(--color-border)" stroke-width="2" />
          <text x="34" y="209" font-size="11" fill="var(--color-muted-foreground)" data-waste-allowance-label>Allowance</text>
          <text x="320" y="209" text-anchor="middle" font-size="11" fill="var(--color-muted-foreground)" data-waste-rounding-label>Supplier rounding</text>
          <text x="606" y="209" text-anchor="end" font-size="11" fill="var(--color-foreground)" data-waste-effective-label>Effective overage</text>
        </>
      )}

      {kind === "concreteMix" && (
        <>
