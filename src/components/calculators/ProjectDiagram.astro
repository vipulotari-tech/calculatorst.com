          <text x="535" y="134" font-size="12" text-anchor="end" fill="var(--color-foreground)" data-concrete-mix-sand>2 parts</text>

          <text x="34" y="184" font-size="12" fill="var(--color-muted-foreground)">Coarse aggregate</text>
          <rect x="150" y="166" width="360" height="24" rx="6" fill="var(--color-muted)" opacity="0.35" />
          <rect x="150" y="166" width="360" height="24" rx="6" fill="var(--color-foreground)" opacity="0.38" data-concrete-mix-aggregate-bar />
