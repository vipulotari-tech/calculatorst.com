            </g>
            <ellipse cx="320" cy="94" rx="112" ry="33" fill="var(--color-card)" stroke="var(--color-foreground)" stroke-width="2" />
            <path d="M208 94 V151 C208 169 258 184 320 184 C382 184 432 169 432 151 V94" fill="var(--color-card)" stroke="var(--color-foreground)" stroke-width="2" />
            <ellipse cx="320" cy="151" rx="112" ry="33" fill="none" stroke="var(--color-muted-foreground)" stroke-width="1.4" />
