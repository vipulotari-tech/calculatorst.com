            <polygon points="225,145 510,145 510,172 225,172" fill="var(--color-card)" stroke="var(--color-foreground)" stroke-width="2" />
            <polygon points="430,105 510,145 510,172 430,132" fill="var(--color-card)" stroke="var(--color-foreground)" stroke-width="2" />
            <text x="320" y="92" text-anchor="middle" font-size="12" fill="var(--color-muted-foreground)">Entered surface area</text>
          </g>

          <text x="320" y="216" text-anchor="middle" font-size="13" fill="var(--color-foreground)" data-diagram-value="0">Measurement 1</text>
          <text x="118" y="124" text-anchor="middle" font-size="13" fill="var(--color-foreground)" transform="rotate(-32 118 124)" data-diagram-value="1">Measurement 2</text>
          <text x="523" y="157" font-size="13" fill="var(--color-muted-foreground)" data-diagram-value="2">Measurement 3</text>
        </>
      )}

      {kind === "concreteCost" && (
        <>
          <text x="34" y="34" font-size="12" font-weight="600" fill="var(--color-muted-foreground)" data-concrete-cost-mode-name>Length × width × thickness</text>

          <g data-concrete-cost-shape="0">
            <polygon points="145,82 430,82 510,130 225,130" fill="var(--color-card)" stroke="var(--color-foreground)" stroke-width="2" />
            <polygon points="225,130 510,130 510,180 225,180" fill="var(--color-card)" stroke="var(--color-foreground)" stroke-width="2" />
            <polygon points="430,82 510,130 510,180 430,132" fill="var(--color-card)" stroke="var(--color-foreground)" stroke-width="2" />
          </g>

          <g data-concrete-cost-shape="2" style="display:none">
            <polygon points="145,105 430,105 510,145 225,145" fill="var(--color-card)" stroke="var(--color-foreground)" stroke-width="2" />
            <polygon points="225,145 510,145 510,172 225,172" fill="var(--color-card)" stroke="var(--color-foreground)" stroke-width="2" />
            <polygon points="430,105 510,145 510,172 430,132" fill="var(--color-card)" stroke="var(--color-foreground)" stroke-width="2" />
            <text x="320" y="92" text-anchor="middle" font-size="12" fill="var(--color-muted-foreground)">Entered surface area</text>
          </g>

          <g data-concrete-cost-shape="3" style="display:none">
            <ellipse cx="320" cy="78" rx="105" ry="30" fill="var(--color-card)" stroke="var(--color-foreground)" stroke-width="2" />
            <path d="M215 78 V172 C215 190 262 204 320 204 C378 204 425 190 425 172 V78" fill="var(--color-card)" stroke="var(--color-foreground)" stroke-width="2" />
            <ellipse cx="320" cy="172" rx="105" ry="30" fill="none" stroke="var(--color-muted-foreground)" stroke-width="1.5" />
          </g>

          <text x="320" y="216" text-anchor="middle" font-size="13" fill="var(--color-foreground)" data-diagram-value="0">Measurement 1</text>
          <text x="118" y="124" text-anchor="middle" font-size="13" fill="var(--color-foreground)" transform="rotate(-32 118 124)" data-diagram-value="1">Measurement 2</text>
          <text x="523" y="157" font-size="13" fill="var(--color-muted-foreground)" data-diagram-value="2">Measurement 3</text>
        </>
      )}

      {kind === "concreteVolume" && (
        <>
          <text x="34" y="34" font-size="12" font-weight="600" fill="var(--color-muted-foreground)" data-concrete-volume-shape-name>Rectangular slab / prism</text>

          <g data-concrete-volume-shape="0">
            <polygon points="145,105 430,105 510,145 225,145" fill="var(--color-card)" stroke="var(--color-foreground)" stroke-width="2" />
