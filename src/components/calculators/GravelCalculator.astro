---
---

<div id="gravel-calculator" data-calculator-slug="gravel-calculator" class="rounded-lg border border-hairline bg-canvas p-5 shadow-card sm:p-6">
  <form id="gravel-form" novalidate class="space-y-5">
    <div class="grid gap-4 sm:grid-cols-3">
      <label class="block">
        <span class="text-sm font-medium text-ink">Length</span>
        <div class="mt-1.5 flex">
          <input id="g-length" name="length" type="number" inputmode="decimal" min="0" step="any" placeholder="e.g. 20" class="h-11 w-full rounded-l-lg border border-hairline bg-canvas px-3 text-sm focus:border-link focus:outline-none focus:ring-2 focus:ring-link/20" required aria-describedby="g-length-error" />
          <select id="g-length-unit" class="h-11 shrink-0 rounded-r-lg border border-l-0 border-hairline bg-canvas-soft px-2 text-sm focus:outline-none">
            <option value="ft">ft</option>
            <option value="in">in</option>
            <option value="yd">yd</option>
            <option value="m">m</option>
          </select>
        </div>
        <span id="g-length-error" class="mt-1 hidden text-xs text-error" role="alert"></span>
      </label>
      <label class="block">
        <span class="text-sm font-medium text-ink">Width</span>
        <div class="mt-1.5 flex">
          <input id="g-width" name="width" type="number" inputmode="decimal" min="0" step="any" placeholder="e.g. 10" class="h-11 w-full rounded-l-lg border border-hairline bg-canvas px-3 text-sm focus:border-link focus:outline-none focus:ring-2 focus:ring-link/20" required aria-describedby="g-width-error" />
          <select id="g-width-unit" class="h-11 shrink-0 rounded-r-lg border border-l-0 border-hairline bg-canvas-soft px-2 text-sm">
            <option value="ft">ft</option>
            <option value="in">in</option>
            <option value="yd">yd</option>
            <option value="m">m</option>
          </select>
        </div>
        <span id="g-width-error" class="mt-1 hidden text-xs text-error" role="alert"></span>
      </label>
      <label class="block">
        <span class="text-sm font-medium text-ink">Depth / Thickness</span>
        <div class="mt-1.5 flex">
          <input id="g-depth" name="depth" type="number" inputmode="decimal" min="0" step="any" placeholder="e.g. 4" class="h-11 w-full rounded-l-lg border border-hairline bg-canvas px-3 text-sm focus:border-link focus:outline-none focus:ring-2 focus:ring-link/20" required aria-describedby="g-depth-error" />
          <select id="g-depth-unit" class="h-11 shrink-0 rounded-r-lg border border-l-0 border-hairline bg-canvas-soft px-2 text-sm">
            <option value="in" selected>in</option>
            <option value="ft">ft</option>
            <option value="cm">cm</option>
            <option value="m">m</option>
          </select>
        </div>
        <span id="g-depth-error" class="mt-1 hidden text-xs text-error" role="alert"></span>
      </label>
    </div>

    <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
      <label class="block">
        <span class="text-sm font-medium text-ink">Material</span>
        <select id="g-material" class="mt-1.5 h-11 w-full rounded-lg border border-hairline bg-canvas px-3 text-sm focus:border-link focus:outline-none focus:ring-2 focus:ring-link/20">
          <option value="pea">Pea Gravel — 1.35 tons/yd³</option>
          <option value="crushed">Crushed Stone — 1.40 tons/yd³</option>
          <option value="river">River Rock — 1.33 tons/yd³</option>
          <option value="limestone">Limestone — 1.60 tons/yd³</option>
          <option value="granite">Granite — 1.42 tons/yd³</option>
          <option value="custom">Custom — enter density below</option>
        </select>
        <div id="g-custom-density-wrap" class="hidden mt-2">
          <div class="flex">
            <input id="g-custom-density" type="number" inputmode="decimal" min="0.5" max="3" step="0.01" placeholder="e.g. 1.42" class="h-11 w-full rounded-l-lg border border-hairline bg-canvas px-3 text-sm focus:border-link focus:outline-none" aria-describedby="g-custom-density-error" />
            <span class="flex h-11 items-center rounded-r-lg border border-l-0 border-hairline bg-canvas-soft px-3 text-sm text-mute">tons/yd³</span>
          </div>
          <span id="g-custom-density-error" class="mt-1 hidden text-xs text-error" role="alert"></span>
          <span class="mt-1 block font-mono text-[11px] text-mute">FHWA range 1.28–1.60 tons/yd³. Check supplier scale ticket — wet adds 5–10%.</span>
        </div>
        <span class="mt-1 block font-mono text-[11px] text-mute">Density varies by supplier. Adjust price for accuracy.</span>
      </label>
      <label class="block">
        <span class="text-sm font-medium text-ink">Compaction allowance</span>
        <div class="mt-1.5 flex">
          <input id="g-compaction" type="number" inputmode="decimal" min="0" max="50" step="1" value="0" class="h-11 w-full rounded-l-lg border border-hairline bg-canvas px-3 text-sm focus:border-link focus:outline-none focus:ring-2 focus:ring-link/20" />
          <span class="flex h-11 items-center rounded-r-lg border border-l-0 border-hairline bg-canvas-soft px-3 text-sm text-mute">%</span>
        </div>
        <span class="mt-1 block font-mono text-[11px] text-mute">Optional extra loose material before waste. Use supplier/project guidance.</span>
      </label>
      <label class="block">
        <span class="text-sm font-medium text-ink">Waste / Overage</span>
        <div class="mt-1.5 flex">
          <input id="g-waste" type="number" inputmode="decimal" min="0" max="50" step="1" value="10" class="h-11 w-full rounded-l-lg border border-hairline bg-canvas px-3 text-sm focus:border-link focus:outline-none focus:ring-2 focus:ring-link/20" />
          <span class="flex h-11 items-center rounded-r-lg border border-l-0 border-hairline bg-canvas-soft px-3 text-sm text-mute">%</span>
        </div>
      </label>
      <label class="block">
        <span class="text-sm font-medium text-ink">Price (optional)</span>
        <div class="mt-1.5 flex">
          <span class="flex h-11 items-center rounded-l-lg border border-hairline bg-canvas-soft px-2 text-sm text-mute">$</span>
          <input id="g-price" type="number" inputmode="decimal" min="0" step="any" placeholder="e.g. 45" class="h-11 w-full border-y border-hairline bg-canvas px-3 text-sm focus:outline-none" />
          <select id="g-price-unit" class="h-11 shrink-0 rounded-r-lg border border-hairline bg-canvas-soft px-2 text-[12px]">
            <option value="yd">/ yd³</option>
            <option value="m3">/ m³</option>
            <option value="ton">/ ton</option>
          </select>
        </div>
      </label>
    </div>

    <div class="flex flex-wrap gap-2">
      <button type="submit" class="inline-flex h-11 items-center justify-center rounded-lg bg-primary px-6 text-sm font-medium text-on-primary transition hover:bg-primary focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-link ">Calculate</button>
      <button type="reset" id="g-reset" class="inline-flex h-11 items-center justify-center rounded-lg border border-hairline bg-canvas px-6 text-sm font-medium text-ink transition hover:bg-canvas-soft focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-link">Reset</button>
      <span class="inline-flex items-center font-mono text-xs text-mute">Enter dimensions → Calculate. Waste included in totals.</span>
    </div>
  </form>

  <!-- Results -->
  <div id="g-results" class="mt-6 hidden" aria-live="polite">
    <div class="rounded-lg border border-hairline bg-canvas-soft-2 p-5 ">
      <p class="font-mono text-[11px] font-medium tracking-widest text-mute">YOUR GRAVEL ESTIMATE</p>
      <div class="mt-2 flex flex-wrap items-baseline gap-2">
        <p class="text-3xl font-semibold tracking-[-0.03em] text-ink"><span id="g-yd3" class="tabular-nums">—</span> <span class="text-lg font-medium text-body">yd³</span></p>
        <span class="text-body">·</span>
        <p class="text-lg font-semibold tabular-nums text-ink"><span id="g-tons">—</span> tons</p>
        <button type="button" id="g-copy" class="ml-auto hidden rounded-full border border-hairline bg-canvas px-3 py-1 font-mono text-xs hover:bg-canvas-soft focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-link sm:inline-flex">Copy</button>
      </div>
      <p class="mt-1 font-mono text-xs tabular-nums text-body"><span id="g-ft3">—</span> ft³ · <span id="g-lb">—</span> lb</p>

      <div class="mt-4 grid gap-3 rounded-md border border-hairline bg-canvas p-3 sm:grid-cols-3">
        <div>
          <p class="font-mono text-[11px] tracking-wide text-mute">Order quantity</p>
          <p class="mt-0.5 text-sm font-semibold tabular-nums text-ink"><span id="g-yd3-w">—</span> yd³</p>
          <p class="font-mono text-xs tabular-nums text-body"><span id="g-tons-w">—</span> tons</p>
        </div>
        <div>
          <p class="font-mono text-[11px] tracking-wide text-mute">Weight</p>
          <p class="mt-0.5 text-sm font-semibold tabular-nums text-ink"><span id="g-tonsw">—</span> tons</p>
          <p class="font-mono text-xs tabular-nums text-body"><span id="g-lbw">—</span> lb waste incl.</p>
        </div>
        <div>
          <p class="font-mono text-[11px] tracking-wide text-mute">Est. cost</p>
          <p class="mt-0.5 text-sm font-semibold text-ink" id="g-cost">—</p>
          <p class="font-mono text-xs text-mute" id="g-cost-note">Add price for cost</p>
        </div>
      </div>
      <p class="mt-3 font-mono text-[11px] leading-4 text-mute"><span id="g-m3-w">—</span> m³ · <span id="g-tonnes-w">—</span> metric tonnes · <span id="g-order-note">—</span></p>
      <p class="mt-1 font-mono text-[11px] leading-4 text-mute">Assumes rectangular area. Density: <span id="g-density-note">—</span>. Verify density and loose/compacted state with supplier.</p>
    </div>
  </div>
</div>

<script>
  import { gravelVolume, gravelCost } from "../../lib/calculations/gravel";

  const $ = (id: string) => document.getElementById(id) as HTMLInputElement | HTMLSelectElement | HTMLElement | null;
  const root = $("gravel-calculator") as HTMLElement | null;
  const form = $("gravel-form") as HTMLFormElement | null;
  const results = $("g-results") as HTMLElement | null;

  if (form && results && root) {
    const densityMap: Record<string, number> = { pea: 1.35, crushed: 1.40, river: 1.33, limestone: 1.60, granite: 1.42 };
    const densityLabel: Record<string, string> = { pea: "Pea Gravel 1.35 t/yd³", crushed: "Crushed 1.40", river: "River Rock 1.33", limestone: "Limestone 1.60", granite: "Granite 1.42" };
    const matSelect = $("g-material") as HTMLSelectElement | null;
    const customWrap = $("g-custom-density-wrap") as HTMLElement | null;
    const customInput = $("g-custom-density") as HTMLInputElement | null;

    matSelect?.addEventListener("change", () => {
      if (!customWrap) return;
      if (matSelect.value === "custom") {
        customWrap.classList.remove("hidden");
        customInput?.focus();
      } else {
        customWrap.classList.add("hidden");
      }
    });

    const fmt = (n: number, dec = 2) =>
      Number.isFinite(n)
        ? new Intl.NumberFormat("en-US", { maximumFractionDigits: dec, minimumFractionDigits: dec === 0 ? 0 : dec === 2 ? 2 : 0 }).format(n)
        : "—";

    const showError = (id: string, msg: string) => {
      const el = $(id) as HTMLElement | null;
      if (!el) return;
      el.textContent = msg;
      el.classList.remove("hidden");
    };
    const clearErrors = () => {
      ["g-length-error","g-width-error","g-depth-error","g-custom-density-error"].forEach((id) => {
        const e = $(id) as HTMLElement | null;
        if (e) { e.textContent = ""; e.classList.add("hidden"); }
      });
    };

    form.addEventListener("submit", (e) => {
      e.preventDefault();
      clearErrors();

      const L = Number.parseFloat(($("g-length") as HTMLInputElement).value);
      const W = Number.parseFloat(($("g-width") as HTMLInputElement).value);
      const D = Number.parseFloat(($("g-depth") as HTMLInputElement).value);
      const wastePercent = Number.parseFloat(($("g-waste") as HTMLInputElement).value) || 0;
      const compactionPercent = Number.parseFloat(($("g-compaction") as HTMLInputElement).value) || 0;
      const price = Number.parseFloat(($("g-price") as HTMLInputElement).value);
      let valid = true;

      if (!(L > 0)) { showError("g-length-error", "Please enter a valid length."); valid = false; }
      if (!(W > 0)) { showError("g-width-error", "Please enter a valid width."); valid = false; }
      if (!(D > 0)) { showError("g-depth-error", "Depth must be greater than 0."); valid = false; }

      const mat = matSelect?.value ?? "crushed";
      let tonsPerYd = densityMap[mat] ?? 1.4;
      let labelForNote = densityLabel[mat] ?? "Custom";
      if (mat === "custom") {
        const customVal = Number.parseFloat(customInput?.value ?? "");
        if (Number.isFinite(customVal) && customVal >= 0.5 && customVal <= 3) {
          tonsPerYd = customVal;
          labelForNote = `Custom ${customVal.toFixed(2)} t/yd³`;
        } else {
          showError("g-custom-density-error", "Enter custom density 0.5–3 tons/yd³.");
          valid = false;
        }
      }
      if (!valid) return;

      const r = gravelVolume({
        length: L,
        lengthUnit: ($("g-length-unit") as HTMLSelectElement).value,
        width: W,
        widthUnit: ($("g-width-unit") as HTMLSelectElement).value,
        depth: D,
        depthUnit: ($("g-depth-unit") as HTMLSelectElement).value,
        wastePercent,
        compactionPercent,
        densityTonsPerYd: tonsPerYd,
      });

      const m3W = r.cuYdW * 0.764554857984;
      const metricTonnes = r.tonsW * 0.90718474;

      ($("g-ft3") as HTMLElement).textContent = fmt(r.cuFt);
      ($("g-yd3") as HTMLElement).textContent = fmt(r.cuYd);
      ($("g-tons") as HTMLElement).textContent = fmt(r.tons);
      ($("g-lb") as HTMLElement).textContent = fmt(r.lb, 0);
      ($("g-yd3-w") as HTMLElement).textContent = fmt(r.cuYdW);
      ($("g-tons-w") as HTMLElement).textContent = fmt(r.tonsW);
      ($("g-tonsw") as HTMLElement).textContent = fmt(r.tonsW);
      ($("g-lbw") as HTMLElement).textContent = fmt(r.lbW, 0);
      ($("g-m3-w") as HTMLElement).textContent = fmt(m3W);
      ($("g-tonnes-w") as HTMLElement).textContent = fmt(metricTonnes);
      ($("g-order-note") as HTMLElement).textContent = `compaction ${fmt(compactionPercent,0)}% · waste ${fmt(wastePercent,0)}%`;
      ($("g-density-note") as HTMLElement).textContent = labelForNote;

      const priceUnit = ($("g-price-unit") as HTMLSelectElement).value as "yd" | "m3" | "ton";
      let costText = "—";
      let note = "Add price for cost";
      if (Number.isFinite(price) && price >= 0) {
        const { cost } = gravelCost({ tonsW: r.tonsW, cuYdW: r.cuYdW, m3W, price, priceUnit });
        costText = new Intl.NumberFormat("en-US", { style: "currency", currency: "USD" }).format(cost);
        note = `at $${fmt(price)} per ${priceUnit === "yd" ? "yd³" : priceUnit === "m3" ? "m³" : "ton"} incl. compaction + waste`;
      }
      ($("g-cost") as HTMLElement).textContent = costText;
      ($("g-cost-note") as HTMLElement).textContent = note;

      root.dataset.lastCalculated = [
        `Measured volume: ${fmt(r.cuYd,4)} yd³`,
        `Order volume: ${fmt(r.cuYdW,4)} yd³`,
        `Order weight: ${fmt(r.tonsW,4)} US tons`,
        `Order metric volume: ${fmt(m3W,4)} m³`,
        `Order metric weight: ${fmt(metricTonnes,4)} metric tonnes`,
        `Estimated cost: ${costText}`,
      ].join("\n");

      results.classList.remove("hidden");
      const copyBtn = $("g-copy") as HTMLButtonElement | null;
      if (copyBtn) {
        copyBtn.classList.remove("hidden");
        copyBtn.textContent = "Copy";
        copyBtn.onclick = async () => {
          const text = `Gravel: ${fmt(r.cuYdW)} yd³ (${fmt(r.tonsW)} tons) incl. ${compactionPercent}% compaction allowance + ${wastePercent}% waste`;
          try { await navigator.clipboard.writeText(text); copyBtn.textContent = "Copied!"; setTimeout(() => copyBtn.textContent = "Copy", 1500); } catch {}
        };
      }
      results.scrollIntoView({ behavior: "smooth", block: "nearest" });
    });

    ($("g-reset") as HTMLButtonElement | null)?.addEventListener("click", () => {
      clearErrors();
      results.classList.add("hidden");
      root.dataset.lastCalculated = "";
      customWrap?.classList.add("hidden");
      if (customInput) customInput.value = "";
    });
  }
</script>
