<figure
  class="calc-project-diagram rounded-xl border border-border bg-card p-4 sm:p-5"
  data-project-diagram
  data-concrete-slab-rich-diagram
>
  <div class="flex flex-wrap items-start justify-between gap-2">
    <div>
      <h3 class="text-xs font-mono font-semibold uppercase tracking-wider text-foreground">Live concrete slab section</h3>
      <p class="mt-1 max-w-[700px] text-[11px] leading-5 text-muted-foreground">
        Plan geometry, slab thickness, thickened perimeter, gravel subbase, allowance, and supplier rounding update from the calculator inputs. Schematic only — not a structural detail.
      </p>
    </div>
    <span class="rounded-full border border-border bg-muted px-2 py-1 font-mono text-[10px] text-muted-foreground">LIVE INPUT GUIDE</span>
  </div>

  <div class="mt-4 overflow-hidden rounded-xl border border-border bg-background">
    <svg viewBox="0 0 760 500" class="h-auto w-full" role="img" aria-labelledby="concrete-slab-diagram-title concrete-slab-diagram-desc">
      <title id="concrete-slab-diagram-title">Live concrete slab plan and cross-section</title>
      <desc id="concrete-slab-diagram-desc">
        A slab plan and cross-section showing rectangular or circular footprint, slab thickness, optional thickened perimeter, optional gravel subbase, quantity, concrete order volume, and supplier rounding.
      </desc>

      <defs>
        <marker id="cs-arrow-start" markerWidth="8" markerHeight="8" refX="1" refY="4" orient="auto">
          <path d="M8 0 L0 4 L8 8 Z" fill="#2563eb"/>
        </marker>
        <marker id="cs-arrow-end" markerWidth="8" markerHeight="8" refX="7" refY="4" orient="auto">
          <path d="M0 0 L8 4 L0 8 Z" fill="#2563eb"/>
        </marker>
        <pattern id="cs-concrete" width="20" height="20" patternUnits="userSpaceOnUse">
          <rect width="20" height="20" fill="#64748b" opacity=".14"/>
          <circle cx="5" cy="6" r="1.4" fill="#64748b" opacity=".45"/>
          <circle cx="15" cy="13" r="1.2" fill="#64748b" opacity=".38"/>
          <path d="M1 17 L8 14 M12 4 L18 2" stroke="#64748b" stroke-width="1" opacity=".35"/>
        </pattern>
        <pattern id="cs-gravel" width="18" height="14" patternUnits="userSpaceOnUse">
          <rect width="18" height="14" fill="#a16207" opacity=".08"/>
          <circle cx="4" cy="5" r="2" fill="#a16207" opacity=".3"/>
          <circle cx="12" cy="9" r="2.4" fill="#a16207" opacity=".24"/>
          <circle cx="17" cy="3" r="1.5" fill="#a16207" opacity=".25"/>
        </pattern>
      </defs>

      <rect width="760" height="500" fill="var(--color-background)"/>
      <text x="28" y="31" font-size="13" font-weight="700" fill="var(--color-foreground)">Concrete slab takeoff</text>
      <text x="732" y="31" text-anchor="end" font-size="11" fill="var(--color-muted-foreground)" data-cs-shape-label>Rectangle slab</text>

      <text x="42" y="64" font-size="11" font-weight="700" fill="var(--color-foreground)">TOP VIEW (PLAN)</text>

      <g data-cs-rect-plan>
        <rect x="94" y="112" width="344" height="180" rx="3" fill="url(#cs-concrete)" stroke="var(--color-foreground)" stroke-width="2"/>
        <rect x="108" y="126" width="316" height="152" rx="2" fill="none" stroke="#0f766e" stroke-width="1.4" stroke-dasharray="7 5" data-cs-edge-plan/>
        <line x1="94" y1="91" x2="438" y2="91" stroke="#2563eb" stroke-width="1.7" marker-start="url(#cs-arrow-start)" marker-end="url(#cs-arrow-end)"/>
        <text x="266" y="81" text-anchor="middle" font-size="13" font-weight="700" fill="#1d4ed8" data-cs-length>Length = 10 ft</text>
        <line x1="72" y1="112" x2="72" y2="292" stroke="#2563eb" stroke-width="1.7" marker-start="url(#cs-arrow-start)" marker-end="url(#cs-arrow-end)"/>
        <text x="53" y="202" text-anchor="middle" font-size="13" font-weight="700" fill="#1d4ed8" transform="rotate(-90 53 202)" data-cs-width>Width = 10 ft</text>
      </g>

      <g data-cs-circle-plan style="display:none">
        <circle cx="266" cy="202" r="90" fill="url(#cs-concrete)" stroke="var(--color-foreground)" stroke-width="2"/>
        <circle cx="266" cy="202" r="76" fill="none" stroke="#0f766e" stroke-width="1.4" stroke-dasharray="7 5" data-cs-edge-plan/>
        <line x1="176" y1="202" x2="356" y2="202" stroke="#2563eb" stroke-width="1.7" marker-start="url(#cs-arrow-start)" marker-end="url(#cs-arrow-end)"/>
        <text x="266" y="188" text-anchor="middle" font-size="13" font-weight="700" fill="#1d4ed8" data-cs-diameter>Diameter = 10 ft</text>
      </g>

      <text x="266" y="318" text-anchor="middle" font-size="11" fill="var(--color-muted-foreground)" data-cs-plan-summary>100 ft² per slab · 40 ft perimeter</text>

      <text x="505" y="64" font-size="11" font-weight="700" fill="var(--color-foreground)">CROSS SECTION</text>
      <g transform="translate(505 102)">
        <rect x="16" y="114" width="205" height="38" fill="url(#cs-gravel)" stroke="#a16207" stroke-width="1.2" data-cs-subbase-layer/>
        <rect x="16" y="68" width="205" height="46" fill="url(#cs-concrete)" stroke="var(--color-foreground)" stroke-width="2"/>
        <path d="M16 68 H48 V136 H72 V114 H165 V136 H189 V68 H221 V152 H16 Z" fill="url(#cs-concrete)" stroke="var(--color-foreground)" stroke-width="2" data-cs-edge-section/>

        <line x1="236" y1="68" x2="236" y2="114" stroke="#2563eb" stroke-width="1.5" marker-start="url(#cs-arrow-start)" marker-end="url(#cs-arrow-end)"/>
        <text x="224" y="60" text-anchor="end" font-size="11.5" font-weight="700" fill="#1d4ed8" data-cs-thickness>Slab = 4 in</text>

        <line x1="2" y1="68" x2="2" y2="152" stroke="#0f766e" stroke-width="1.4" marker-start="url(#cs-arrow-start)" marker-end="url(#cs-arrow-end)" data-cs-edge-depth-line/>
        <text x="14" y="172" font-size="10.5" fill="#0f766e" data-cs-edge-depth>Edge depth = none</text>

        <line x1="16" y1="166" x2="48" y2="166" stroke="#0f766e" stroke-width="1.4" marker-start="url(#cs-arrow-start)" marker-end="url(#cs-arrow-end)" data-cs-edge-width-line/>
        <text x="118" y="190" text-anchor="middle" font-size="10.5" fill="var(--color-muted-foreground)" data-cs-section-note>No thickened edge · no subbase</text>
      </g>

      <rect x="28" y="350" width="704" height="120" rx="12" fill="var(--color-muted)" opacity=".23" stroke="var(--color-border)"/>
      <text x="46" y="375" font-size="11" font-weight="700" fill="var(--color-foreground)">ACTIVE GEOMETRY</text>
      <text x="46" y="402" font-size="15.5" font-weight="700" fill="var(--color-foreground)" data-cs-formula>V = L × W × T × Q</text>
      <text x="46" y="427" font-size="11" fill="var(--color-muted-foreground)" data-cs-edge-formula>Optional edge adds perimeter × edge width × extra depth.</text>
      <text x="46" y="449" font-size="11" fill="var(--color-muted-foreground)" data-cs-subbase>Subbase: none</text>

      <line x1="430" y1="366" x2="430" y2="456" stroke="var(--color-border)"/>
      <text x="452" y="375" font-size="11" font-weight="700" fill="var(--color-foreground)">CURRENT ORDER</text>
      <text x="452" y="402" font-size="15" font-weight="700" fill="#1d4ed8" data-cs-order>1.36 yd³ with allowance</text>
      <text x="452" y="426" font-size="11" fill="var(--color-muted-foreground)" data-cs-rounded>Supplier rounding: off</text>
      <text x="452" y="449" font-size="11" fill="var(--color-muted-foreground)" data-cs-quantity>1 identical slab</text>
    </svg>
  </div>

  <dl class="mt-3 grid gap-2 text-xs sm:grid-cols-4">
    <div class="rounded-md border border-border bg-muted/30 px-3 py-2">
      <dt class="text-muted-foreground">Footprint</dt>
      <dd class="mt-0.5 font-mono font-medium text-foreground tabular-nums" data-cs-card-footprint>10 ft × 10 ft</dd>
    </div>
    <div class="rounded-md border border-border bg-muted/30 px-3 py-2">
      <dt class="text-muted-foreground">Thickness</dt>
      <dd class="mt-0.5 font-mono font-medium text-foreground tabular-nums" data-cs-card-thickness>4 in</dd>
    </div>
    <div class="rounded-md border border-border bg-muted/30 px-3 py-2">
      <dt class="text-muted-foreground">Net concrete</dt>
      <dd class="mt-0.5 font-mono font-medium text-foreground tabular-nums" data-cs-card-net>1.23 yd³</dd>
    </div>
    <div class="rounded-md border border-border bg-muted/30 px-3 py-2">
      <dt class="text-muted-foreground">Order target</dt>
      <dd class="mt-0.5 font-mono font-medium text-foreground tabular-nums" data-cs-card-order>1.36 yd³</dd>
    </div>
  </dl>
</figure>

<script>
  function initConcreteSlabRichDiagrams() {
    document.querySelectorAll<HTMLElement>("[data-concrete-slab-rich-diagram]").forEach((figure) => {
      if (figure.dataset.initialized) return;
      figure.dataset.initialized = "true";

      const root = figure.closest<HTMLElement>('[data-calculator-slug="concrete-slab-calculator"]');
      if (!root) return;
      const form = root.querySelector<HTMLFormElement>("#concrete-slab-calculator-form");
      if (!form) return;

      const input = (id: string) => root.querySelector<HTMLInputElement>("#concrete-slab-calculator-" + id);
      const select = (id: string) => root.querySelector<HTMLSelectElement>("#concrete-slab-calculator-" + id);
      const unit = (id: string) => root.querySelector<HTMLSelectElement>("#concrete-slab-calculator-" + id + "-unit");

      const unitText = (id: string) => {
        const u = unit(id);
        if (u) return u.options[u.selectedIndex]?.text?.trim() || u.value;
        return input(id)?.parentElement?.querySelector("span")?.textContent?.trim() || "";
      };

      const displayValue = (id: string) => {
        const raw = input(id)?.value?.trim() ?? "";
        if (!raw) return "—";
        const n = Number(raw);
        const shown = Number.isFinite(n) ? String(Number(n.toFixed(4))) : raw;
        const u = unitText(id);
        return u ? shown + " " + u : shown;
      };

      const numberValue = (id: string, fallback = 0) => {
        const n = Number(input(id)?.value);
        return Number.isFinite(n) ? n : fallback;
      };

      const lengthFeet = (id: string) => {
        const n = Number(input(id)?.value);
        if (!Number.isFinite(n)) return Number.NaN;
        const factors: Record<string, number> = { ft: 1, in: 1 / 12, yd: 3, m: 1 / 0.3048, cm: 1 / 30.48, mm: 1 / 304.8 };
        return n * (factors[unit(id)?.value ?? "ft"] ?? 1);
      };

      const fmt = (n: number, digits = 2) =>
        Number.isFinite(n) ? new Intl.NumberFormat("en-US", { maximumFractionDigits: digits }).format(n) : "—";

      const setText = (selector: string, text: string) => {
        figure.querySelectorAll<SVGTextElement | HTMLElement>(selector).forEach((el) => { el.textContent = text; });
      };

      const setVisible = (selector: string, visible: boolean) => {
        figure.querySelectorAll<SVGElement | HTMLElement>(selector).forEach((el) => {
          (el as HTMLElement).style.display = visible ? "" : "none";
        });
      };

      const update = () => {
        const circle = Math.round(Number(select("slabShape")?.value ?? "0")) === 1;
        const lengthFt = lengthFeet("length");
        const widthFt = lengthFeet("width");
        const diameterFt = lengthFeet("diameter");
        const thicknessFt = lengthFeet("thickness");
        const quantity = Math.max(1, Math.round(numberValue("quantity", 1)));
        const edgeDepthFt = lengthFeet("thickenedEdgeDepth");
        const edgeWidthFt = lengthFeet("thickenedEdgeWidth");
        const subbaseFt = lengthFeet("subbaseDepth");
        const waste = Math.max(0, numberValue("waste", 0));
        const increment = Math.max(0, numberValue("orderIncrement", 0));

        const shapeValid = circle
          ? Number.isFinite(diameterFt) && diameterFt > 0
          : Number.isFinite(lengthFt) && lengthFt > 0 && Number.isFinite(widthFt) && widthFt > 0;
        const area = shapeValid ? (circle ? Math.PI * Math.pow(diameterFt / 2, 2) : lengthFt * widthFt) : Number.NaN;
        const perimeter = shapeValid ? (circle ? Math.PI * diameterFt : 2 * (lengthFt + widthFt)) : Number.NaN;
        const slabFt3 = shapeValid && thicknessFt > 0 ? area * thicknessFt * quantity : Number.NaN;

        const edgeActive = Number.isFinite(edgeDepthFt) && Number.isFinite(edgeWidthFt)
          && edgeDepthFt > thicknessFt && edgeWidthFt > 0;
        const edgeAddedFt3 = edgeActive ? perimeter * edgeWidthFt * (edgeDepthFt - thicknessFt) * quantity : 0;
        const netFt3 = Number.isFinite(slabFt3) ? slabFt3 + edgeAddedFt3 : Number.NaN;
        const orderYd3 = Number.isFinite(netFt3) ? netFt3 * (1 + waste / 100) / 27 : Number.NaN;
        const roundedYd3 = Number.isFinite(orderYd3) && increment > 0
          ? Math.ceil((orderYd3 - 1e-12) / increment) * increment
          : Number.NaN;
        const subbaseYd3 = Number.isFinite(area) && Number.isFinite(subbaseFt) && subbaseFt > 0
          ? area * subbaseFt * quantity / 27
          : 0;

        setVisible("[data-cs-rect-plan]", !circle);
        setVisible("[data-cs-circle-plan]", circle);
        setVisible("[data-cs-edge-plan]", edgeActive);
        setVisible("[data-cs-edge-section]", edgeActive);
        setVisible("[data-cs-edge-depth-line]", edgeActive);
        setVisible("[data-cs-edge-width-line]", edgeActive);
        setVisible("[data-cs-subbase-layer]", subbaseYd3 > 0);

        setText("[data-cs-shape-label]", circle ? "Circle slab" : "Rectangle slab");
        setText("[data-cs-length]", "Length = " + displayValue("length"));
        setText("[data-cs-width]", "Width = " + displayValue("width"));
        setText("[data-cs-diameter]", "Diameter = " + displayValue("diameter"));
        setText("[data-cs-thickness]", "Slab = " + displayValue("thickness"));
        setText("[data-cs-plan-summary]", fmt(area) + " ft² per slab · " + fmt(perimeter) + " ft perimeter");

        if (edgeActive) {
          setText("[data-cs-edge-depth]", "Edge depth = " + displayValue("thickenedEdgeDepth") + " · width = " + displayValue("thickenedEdgeWidth"));
        } else {
          setText("[data-cs-edge-depth]", "Edge depth = none");
        }

        const sectionParts = [];
        sectionParts.push(edgeActive ? "thickened edge on" : "no thickened edge");
        sectionParts.push(subbaseYd3 > 0 ? displayValue("subbaseDepth") + " gravel base" : "no subbase");
        setText("[data-cs-section-note]", sectionParts.join(" · "));

        setText("[data-cs-formula]", circle ? "V = π × (D ÷ 2)² × T × Q" : "V = L × W × T × Q");
        setText("[data-cs-edge-formula]", edgeActive
          ? "Edge adds perimeter × " + displayValue("thickenedEdgeWidth") + " × extra depth."
          : "Optional edge adds perimeter × edge width × extra depth.");
        setText("[data-cs-subbase]", subbaseYd3 > 0 ? "Subbase: " + fmt(subbaseYd3) + " yd³ compacted" : "Subbase: none");
        setText("[data-cs-order]", fmt(orderYd3) + " yd³ with allowance");
        setText("[data-cs-rounded]", increment > 0 && Number.isFinite(roundedYd3)
          ? "Supplier rounded: " + fmt(roundedYd3) + " yd³ @ " + fmt(increment) + " yd³ increments"
          : "Supplier rounding: off");
        setText("[data-cs-quantity]", quantity + " identical " + (quantity === 1 ? "slab" : "slabs"));

        setText("[data-cs-card-footprint]", circle ? "Ø " + displayValue("diameter") : displayValue("length") + " × " + displayValue("width"));
        setText("[data-cs-card-thickness]", displayValue("thickness"));
        setText("[data-cs-card-net]", fmt(netFt3 / 27) + " yd³");
        setText("[data-cs-card-order]", increment > 0 && Number.isFinite(roundedYd3) ? fmt(roundedYd3) + " yd³ rounded" : fmt(orderYd3) + " yd³");
      };

      root.addEventListener("input", update);
      root.addEventListener("change", update);
      form.addEventListener("reset", () => setTimeout(update, 0));
      update();
      setTimeout(update, 0);
    });
  }

  initConcreteSlabRichDiagrams();
  document.addEventListener("astro:page-load", initConcreteSlabRichDiagrams);
</script>
