---
const slug = "road-base-calculator";
---

<figure
  class="calc-project-diagram rounded-xl border border-border bg-card p-4 sm:p-5"
  data-project-diagram
  data-road-base-rich-diagram
>
  <div class="flex flex-wrap items-start justify-between gap-2">
    <div>
      <h3 class="text-xs font-mono font-semibold uppercase tracking-wider text-foreground">Live road-base quantity diagram</h3>
      <p class="mt-1 max-w-[720px] text-[11px] leading-5 text-muted-foreground">
        Road footprint, placed base thickness, identical sections, material density, allowance, order volume, estimated weight, and optional bulk cost update from the calculator inputs.
      </p>
    </div>
    <span class="rounded-full border border-border bg-muted px-2 py-1 font-mono text-[10px] text-muted-foreground">LIVE BASE-COURSE TAKEOFF</span>
  </div>

  <div class="mt-4 overflow-hidden rounded-xl border border-border bg-background">
    <svg viewBox="0 0 760 515" class="h-auto w-full" role="img" aria-labelledby={`${slug}-road-base-title ${slug}-road-base-desc`}>
      <title id={`${slug}-road-base-title`}>Live road-base quantity and weight diagram</title>
      <desc id={`${slug}-road-base-desc`}>
        Road plan and aggregate base cross-section showing length, width, placed road-base thickness, identical sections, density, allowance, cubic yards, cubic metres, estimated US tons, and optional material cost.
      </desc>

      <defs>
        <marker id="road-base-arrow-start" markerWidth="8" markerHeight="8" refX="1" refY="4" orient="auto">
          <path d="M8 0 L0 4 L8 8 Z" fill="#2563eb" />
        </marker>
        <marker id="road-base-arrow-end" markerWidth="8" markerHeight="8" refX="7" refY="4" orient="auto">
          <path d="M0 0 L8 4 L0 8 Z" fill="#2563eb" />
        </marker>
        <pattern id="road-base-aggregate" width="24" height="18" patternUnits="userSpaceOnUse">
          <rect width="24" height="18" fill="var(--color-muted)" opacity=".60" />
          <circle cx="5" cy="9" r="3.2" fill="none" stroke="var(--color-muted-foreground)" stroke-width="1.1" opacity=".50" />
          <circle cx="15" cy="5" r="2.4" fill="none" stroke="var(--color-muted-foreground)" stroke-width="1" opacity=".42" />
          <circle cx="21" cy="14" r="2.8" fill="none" stroke="var(--color-muted-foreground)" stroke-width="1" opacity=".40" />
          <circle cx="10" cy="16" r="1.6" fill="none" stroke="var(--color-muted-foreground)" stroke-width=".9" opacity=".34" />
        </pattern>
        <pattern id="road-base-subgrade" width="26" height="16" patternUnits="userSpaceOnUse">
          <path d="M0 11 C6 6 11 16 17 10 S25 8 26 12" fill="none" stroke="var(--color-muted-foreground)" stroke-width="1" opacity=".28" />
        </pattern>
      </defs>

      <rect width="760" height="515" fill="var(--color-background)" />
      <text x="28" y="30" font-size="13" font-weight="700" fill="var(--color-foreground)">Road-base material takeoff</text>
      <text x="732" y="30" text-anchor="end" font-size="11" fill="var(--color-muted-foreground)" data-road-base-size>20 ft × 10 ft · 1 section</text>

      <text x="42" y="63" font-size="11" font-weight="700" fill="var(--color-foreground)">ROAD / BASE FOOTPRINT</text>
      <rect x="88" y="107" width="338" height="160" rx="5" fill="url(#road-base-aggregate)" stroke="var(--color-foreground)" stroke-width="2" />
      <path d="M112 187 H402" stroke="var(--color-muted-foreground)" stroke-width="1.2" stroke-dasharray="10 10" opacity=".45" />

      <line x1="88" y1="84" x2="426" y2="84" stroke="#2563eb" stroke-width="1.7" marker-start="url(#road-base-arrow-start)" marker-end="url(#road-base-arrow-end)" />
      <line x1="88" y1="91" x2="88" y2="107" stroke="#2563eb" stroke-width="1.05" stroke-dasharray="4 4" />
      <line x1="426" y1="91" x2="426" y2="107" stroke="#2563eb" stroke-width="1.05" stroke-dasharray="4 4" />
      <text x="257" y="73" text-anchor="middle" font-size="12.5" font-weight="700" fill="#1d4ed8" data-road-base-length>Length = 20 ft</text>

      <line x1="65" y1="107" x2="65" y2="267" stroke="#2563eb" stroke-width="1.7" marker-start="url(#road-base-arrow-start)" marker-end="url(#road-base-arrow-end)" />
      <line x1="72" y1="107" x2="88" y2="107" stroke="#2563eb" stroke-width="1.05" stroke-dasharray="4 4" />
      <line x1="72" y1="267" x2="88" y2="267" stroke="#2563eb" stroke-width="1.05" stroke-dasharray="4 4" />
      <text x="47" y="187" text-anchor="middle" font-size="12.5" font-weight="700" fill="#1d4ed8" transform="rotate(-90 47 187)" data-road-base-width>Width = 10 ft</text>

      <text x="257" y="290" text-anchor="middle" font-size="11" fill="var(--color-muted-foreground)" data-road-base-area>200 ft² total base area</text>

      <text x="492" y="63" font-size="11" font-weight="700" fill="var(--color-foreground)">PLACED BASE CROSS SECTION</text>
      <rect x="507" y="211" width="201" height="46" fill="url(#road-base-subgrade)" stroke="var(--color-border)" stroke-width="1.1" />
      <rect x="507" y="160" width="201" height="51" fill="url(#road-base-aggregate)" stroke="var(--color-foreground)" stroke-width="2" data-road-base-layer />
      <text x="607" y="190" text-anchor="middle" font-size="11.5" font-weight="700" fill="var(--color-foreground)">ROAD BASE / AGGREGATE</text>
      <text x="607" y="239" text-anchor="middle" font-size="10.5" fill="var(--color-muted-foreground)">Prepared subgrade</text>

      <line x1="724" y1="160" x2="724" y2="211" stroke="#2563eb" stroke-width="1.7" marker-start="url(#road-base-arrow-start)" marker-end="url(#road-base-arrow-end)" data-road-base-depth-arrow />
      <line x1="710" y1="160" x2="731" y2="160" stroke="#2563eb" stroke-width="1.05" stroke-dasharray="4 4" data-road-base-depth-top />
      <line x1="710" y1="211" x2="731" y2="211" stroke="#2563eb" stroke-width="1.05" stroke-dasharray="4 4" />
      <text x="707" y="147" text-anchor="end" font-size="12.5" font-weight="700" fill="#1d4ed8" data-road-base-depth>Placed depth = 4 in</text>

      <text x="607" y="279" text-anchor="middle" font-size="10.8" fill="var(--color-muted-foreground)" data-road-base-density>Density = 1.4 US ton/yd³</text>
      <text x="607" y="298" text-anchor="middle" font-size="11.8" font-weight="700" fill="#1d4ed8" data-road-base-order-summary>2.72 yd³ · 3.8 US tons</text>

      <rect x="28" y="321" width="704" height="57" rx="10" fill="var(--color-muted)" opacity=".23" stroke="var(--color-border)" />
      <text x="45" y="342" font-size="10.8" font-weight="700" fill="var(--color-foreground)">QUANTITY FORMULA</text>
      <text x="45" y="364" font-size="12.2" font-weight="700" fill="var(--color-foreground)">Volume = length × width × placed depth × sections</text>
      <text x="712" y="355" text-anchor="end" font-size="11.8" font-weight="700" fill="#1d4ed8" data-road-base-formula>20 × 10 × 0.333 × 1 = 66.67 ft³</text>

      <g transform="translate(28 402)">
        <rect width="164" height="78" rx="11" fill="var(--color-muted)" opacity=".23" stroke="var(--color-border)" />
        <text x="14" y="22" font-size="10" font-weight="700" fill="var(--color-foreground)">NET PLACED VOLUME</text>
        <text x="14" y="49" font-size="18" font-weight="700" fill="var(--color-foreground)" data-road-base-net>2.47 yd³</text>
        <text x="14" y="67" font-size="10.5" fill="var(--color-muted-foreground)" data-road-base-net-ft3>66.67 ft³</text>
      </g>

      <g transform="translate(207 402)">
        <rect width="164" height="78" rx="11" fill="var(--color-muted)" opacity=".23" stroke="var(--color-border)" />
        <text x="14" y="22" font-size="10" font-weight="700" fill="var(--color-foreground)">ORDER + ALLOWANCE</text>
        <text x="14" y="49" font-size="18" font-weight="700" fill="#1d4ed8" data-road-base-order>2.72 yd³</text>
        <text x="14" y="67" font-size="10.5" fill="var(--color-muted-foreground)" data-road-base-allowance>10% allowance</text>
      </g>

      <g transform="translate(386 402)">
        <rect width="164" height="78" rx="11" fill="var(--color-muted)" opacity=".23" stroke="var(--color-border)" />
        <text x="14" y="22" font-size="10" font-weight="700" fill="var(--color-foreground)">EST. ORDER WEIGHT</text>
        <text x="14" y="49" font-size="18" font-weight="700" fill="#1d4ed8" data-road-base-tons>3.8 US tons</text>
        <text x="14" y="67" font-size="10.5" fill="var(--color-muted-foreground)" data-road-base-kg>3,449.54 kg</text>
      </g>

      <g transform="translate(565 402)">
        <rect width="167" height="78" rx="11" fill="var(--color-muted)" opacity=".23" stroke="var(--color-border)" />
        <text x="14" y="22" font-size="10" font-weight="700" fill="var(--color-foreground)">OPTIONAL MATERIAL COST</text>
        <text x="14" y="49" font-size="18" font-weight="700" fill="#1d4ed8" data-road-base-cost>—</text>
        <text x="14" y="67" font-size="10.5" fill="var(--color-muted-foreground)" data-road-base-price-basis>Enter supplier price</text>
      </g>
    </svg>
  </div>

  <dl class="mt-3 grid gap-2 text-xs sm:grid-cols-6">
    <div class="rounded-md border border-border bg-muted/30 px-3 py-2">
      <dt class="text-muted-foreground">Base area</dt>
      <dd class="mt-0.5 font-mono font-medium text-foreground tabular-nums" data-road-base-card-area>200 ft²</dd>
    </div>
    <div class="rounded-md border border-border bg-muted/30 px-3 py-2">
      <dt class="text-muted-foreground">Placed depth</dt>
      <dd class="mt-0.5 font-mono font-medium text-foreground tabular-nums" data-road-base-card-depth>4 in</dd>
    </div>
    <div class="rounded-md border border-border bg-muted/30 px-3 py-2">
      <dt class="text-muted-foreground">Order volume</dt>
      <dd class="mt-0.5 font-mono font-medium text-foreground tabular-nums" data-road-base-card-order>2.72 yd³</dd>
    </div>
    <div class="rounded-md border border-border bg-muted/30 px-3 py-2">
      <dt class="text-muted-foreground">Metric volume</dt>
      <dd class="mt-0.5 font-mono font-medium text-foreground tabular-nums" data-road-base-card-m3>2.08 m³</dd>
    </div>
    <div class="rounded-md border border-border bg-muted/30 px-3 py-2">
      <dt class="text-muted-foreground">Estimated weight</dt>
      <dd class="mt-0.5 font-mono font-medium text-foreground tabular-nums" data-road-base-card-tons>3.8 US tons</dd>
    </div>
    <div class="rounded-md border border-border bg-muted/30 px-3 py-2">
      <dt class="text-muted-foreground">Optional cost</dt>
      <dd class="mt-0.5 font-mono font-medium text-foreground tabular-nums" data-road-base-card-cost>—</dd>
    </div>
  </dl>
</figure>

<script>
  function initRoadBaseRichDiagrams() {
    document.querySelectorAll<HTMLElement>("[data-road-base-rich-diagram]").forEach((figure) => {
      if (figure.dataset.initialized) return;
      figure.dataset.initialized = "true";

      const root = figure.closest<HTMLElement>('[data-calculator-slug="road-base-calculator"]');
      if (!root) return;
      const form = root.querySelector<HTMLFormElement>("#road-base-calculator-form");
      if (!form) return;

      const input = (id: string) => root.querySelector<HTMLInputElement>("#road-base-calculator-" + id);
      const unit = (id: string) => root.querySelector<HTMLSelectElement>("#road-base-calculator-" + id + "-unit");

      const unitText = (id: string) => {
        const select = unit(id);
        if (select) return select.options[select.selectedIndex]?.text?.trim() || select.value;
        const el = input(id);
        const staticUnit = el?.parentElement?.querySelector("span");
        return staticUnit?.textContent?.trim() || "";
      };

      const displayValue = (id: string) => {
        const raw = input(id)?.value?.trim() ?? "";
        if (!raw) return "—";
        const n = Number(raw);
        const shown = Number.isFinite(n) ? String(Number(n.toFixed(4))) : raw;
        const label = unitText(id);
        return label ? shown + " " + label : shown;
      };

      const lengthToFeet = (id: string) => {
        const n = Number(input(id)?.value);
        if (!Number.isFinite(n)) return Number.NaN;
        const factors: Record<string, number> = {
          ft: 1,
          in: 1 / 12,
          yd: 3,
          m: 1 / 0.3048,
          cm: 1 / 30.48,
          mm: 1 / 304.8,
        };
        return n * (factors[unit(id)?.value ?? "ft"] ?? 1);
      };

      const densityToLbFt3 = () => {
        const n = Number(input("density")?.value);
        if (!Number.isFinite(n)) return Number.NaN;
        const densityUnit = unit("density")?.value ?? "ton/yd3";
        if (densityUnit === "kg/m3") return n * 2.20462262185 / 35.3146667215;
        if (densityUnit === "ton/yd3") return n * 2000 / 27;
        return n;
      };

      const numberValue = (id: string, fallback = 0) => {
        const n = Number(input(id)?.value);
        return Number.isFinite(n) ? n : fallback;
      };

      const fmt = (n: number, digits = 2) =>
        Number.isFinite(n)
          ? new Intl.NumberFormat("en-US", { maximumFractionDigits: digits }).format(n)
          : "—";

      const money = (n: number) =>
        Number.isFinite(n)
          ? new Intl.NumberFormat("en-US", { style: "currency", currency: "USD", maximumFractionDigits: 2 }).format(n)
          : "—";

      const setText = (selector: string, text: string) => {
        figure.querySelectorAll<SVGTextElement | HTMLElement>(selector).forEach((el) => {
          el.textContent = text;
        });
      };

      const updateLayer = (depthFt: number) => {
        const baseY = 211;
        const height = Number.isFinite(depthFt) && depthFt > 0
          ? Math.max(20, Math.min(82, depthFt * 115))
          : 34;
        const topY = baseY - height;

        const layer = figure.querySelector<SVGRectElement>("[data-road-base-layer]");
        layer?.setAttribute("y", String(topY));
        layer?.setAttribute("height", String(height));

        const arrow = figure.querySelector<SVGLineElement>("[data-road-base-depth-arrow]");
        arrow?.setAttribute("y1", String(topY));

        const guide = figure.querySelector<SVGLineElement>("[data-road-base-depth-top]");
        guide?.setAttribute("y1", String(topY));
        guide?.setAttribute("y2", String(topY));

        const label = figure.querySelector<SVGTextElement>("[data-road-base-depth]");
        label?.setAttribute("y", String(Math.max(101, topY - 12)));
      };

      const update = () => {
        const lengthFt = lengthToFeet("length");
        const widthFt = lengthToFeet("width");
        const depthFt = lengthToFeet("depth");
        const sections = Math.max(0, Math.round(numberValue("quantity", 1)));
        const allowance = Math.max(0, numberValue("waste", 0));
        const densityLbFt3 = densityToLbFt3();
        const price = numberValue("price", Number.NaN);
        const priceUnit = unit("price")?.value ?? "USD/yd3";

        const valid = [lengthFt, widthFt, depthFt, densityLbFt3].every((v) => Number.isFinite(v) && v > 0) && sections > 0;
        const areaFt2 = valid ? lengthFt * widthFt * sections : Number.NaN;
        const netFt3 = valid ? lengthFt * widthFt * depthFt * sections : Number.NaN;
        const orderFt3 = Number.isFinite(netFt3) ? netFt3 * (1 + allowance / 100) : Number.NaN;
        const netYd3 = netFt3 / 27;
        const orderYd3 = orderFt3 / 27;
        const orderM3 = orderFt3 * Math.pow(0.3048, 3);
        const pounds = orderFt3 * densityLbFt3;
        const tons = pounds / 2000;
        const kg = pounds * 0.45359237;

        let cost = Number.NaN;
        if (Number.isFinite(price) && price >= 0) {
          if (priceUnit === "USD/ton") cost = tons * price;
          else if (priceUnit === "USD/m3") cost = orderM3 * price;
          else cost = orderYd3 * price;
        }

        updateLayer(depthFt);

        setText("[data-road-base-size]", displayValue("length") + " × " + displayValue("width") + " · " + sections + " " + (sections === 1 ? "section" : "sections"));
        setText("[data-road-base-length]", "Length = " + displayValue("length"));
        setText("[data-road-base-width]", "Width = " + displayValue("width"));
        setText("[data-road-base-area]", fmt(areaFt2) + " ft² total base area");
        setText("[data-road-base-depth]", "Placed depth = " + displayValue("depth"));
        setText("[data-road-base-density]", "Density = " + displayValue("density"));
        setText("[data-road-base-order-summary]", fmt(orderYd3) + " yd³ · " + fmt(tons) + " US tons");

        setText(
          "[data-road-base-formula]",
          valid
            ? fmt(lengthFt) + " × " + fmt(widthFt) + " × " + fmt(depthFt, 3) + " × " + sections + " = " + fmt(netFt3) + " ft³"
            : "Enter valid road-base dimensions"
        );

        setText("[data-road-base-net]", fmt(netYd3) + " yd³");
        setText("[data-road-base-net-ft3]", fmt(netFt3) + " ft³");
        setText("[data-road-base-order]", fmt(orderYd3) + " yd³");
        setText("[data-road-base-allowance]", fmt(allowance) + "% allowance");
        setText("[data-road-base-tons]", fmt(tons) + " US tons");
        setText("[data-road-base-kg]", fmt(kg) + " kg");

        if (Number.isFinite(cost)) {
          const basis = priceUnit === "USD/ton" ? "US ton" : priceUnit === "USD/m3" ? "m³" : "yd³";
          setText("[data-road-base-cost]", money(cost));
          setText("[data-road-base-price-basis]", money(price) + " / " + basis);
        } else {
          setText("[data-road-base-cost]", "—");
          setText("[data-road-base-price-basis]", "Enter supplier price");
        }

        setText("[data-road-base-card-area]", fmt(areaFt2) + " ft²");
        setText("[data-road-base-card-depth]", displayValue("depth"));
        setText("[data-road-base-card-order]", fmt(orderYd3) + " yd³");
        setText("[data-road-base-card-m3]", fmt(orderM3) + " m³");
        setText("[data-road-base-card-tons]", fmt(tons) + " US tons");
        setText("[data-road-base-card-cost]", Number.isFinite(cost) ? money(cost) : "—");
      };

      root.addEventListener("input", update);
      root.addEventListener("change", update);
      root.addEventListener("calculator-state-restored", update);
      form.addEventListener("reset", () => setTimeout(update, 0));

      update();
      queueMicrotask(update);
      requestAnimationFrame(update);
      setTimeout(update, 0);
    });
  }

  initRoadBaseRichDiagrams();
  document.addEventListener("astro:page-load", initRoadBaseRichDiagrams);
</script>
