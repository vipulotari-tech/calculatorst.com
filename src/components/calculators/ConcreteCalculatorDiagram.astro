---
const slug = "concrete-calculator";
---

<figure
  class="calc-project-diagram rounded-xl border border-border bg-card p-4 sm:p-5"
  data-project-diagram
  data-concrete-rich-diagram
  data-kind="concrete"
>
  <div class="flex flex-wrap items-start justify-between gap-2">
    <div>
      <h3 class="text-xs font-mono font-semibold uppercase tracking-wider text-foreground">Live concrete project diagram</h3>
      <p class="mt-1 max-w-[640px] text-[11px] leading-5 text-muted-foreground">
        Plan/elevation and cross-section views update from the active project type and measurements. Schematic only — not to scale.
      </p>
    </div>
    <span class="rounded-full border border-border bg-muted px-2 py-1 font-mono text-[10px] text-muted-foreground">LIVE INPUT GUIDE</span>
  </div>

  <div class="mt-4 overflow-hidden rounded-xl border border-border bg-background">
    <svg
      viewBox="0 0 760 430"
      class="h-auto w-full"
      role="img"
      aria-labelledby={`${slug}-rich-diagram-title ${slug}-rich-diagram-desc`}
    >
      <title id={`${slug}-rich-diagram-title`}>Live concrete calculator project diagram</title>
      <desc id={`${slug}-rich-diagram-desc`}>
        Technical plan, elevation, and cross-section drawings for slab, strip footing, wall, and cylinder project types. Dimension labels update from calculator inputs.
      </desc>

      <defs>
        <marker id="concrete-arrow-start" markerWidth="8" markerHeight="8" refX="1" refY="4" orient="auto">
          <path d="M8 0 L0 4 L8 8 Z" fill="#2563eb" />
        </marker>
        <marker id="concrete-arrow-end" markerWidth="8" markerHeight="8" refX="7" refY="4" orient="auto">
          <path d="M0 0 L8 4 L0 8 Z" fill="#2563eb" />
        </marker>
        <pattern id="concrete-speckle" width="18" height="18" patternUnits="userSpaceOnUse">
          <rect width="18" height="18" fill="var(--color-muted)" opacity="0.7" />
          <circle cx="4" cy="5" r="1.2" fill="var(--color-muted-foreground)" opacity="0.3" />
          <circle cx="14" cy="11" r="0.9" fill="var(--color-muted-foreground)" opacity="0.24" />
          <circle cx="8" cy="16" r="0.7" fill="var(--color-muted-foreground)" opacity="0.2" />
        </pattern>
        <pattern id="aggregate-stones" width="22" height="16" patternUnits="userSpaceOnUse">
          <rect width="22" height="16" fill="var(--color-muted)" opacity="0.45" />
          <circle cx="4" cy="7" r="3.2" fill="none" stroke="var(--color-muted-foreground)" stroke-width="1" opacity="0.45" />
          <circle cx="12" cy="5" r="2.8" fill="none" stroke="var(--color-muted-foreground)" stroke-width="1" opacity="0.4" />
          <circle cx="18" cy="10" r="3.5" fill="none" stroke="var(--color-muted-foreground)" stroke-width="1" opacity="0.38" />
        </pattern>
        <pattern id="soil-hatch" width="14" height="14" patternUnits="userSpaceOnUse" patternTransform="rotate(20)">
          <rect width="14" height="14" fill="var(--color-muted)" opacity="0.22" />
          <line x1="0" y1="0" x2="0" y2="14" stroke="var(--color-muted-foreground)" stroke-width="1" opacity="0.25" />
        </pattern>
      </defs>

      <rect x="0" y="0" width="760" height="430" fill="var(--color-background)" />
      <text x="28" y="30" font-size="13" font-weight="700" fill="var(--color-foreground)" data-concrete-shape-name>Rectangular slab</text>
      <text x="732" y="30" text-anchor="end" font-size="11" fill="var(--color-muted-foreground)">Dimensions follow calculator inputs</text>

      <!-- RECTANGULAR SLAB -->
      <g data-concrete-shape="0">
        <text x="42" y="62" font-size="11" font-weight="700" fill="var(--color-foreground)">TOP VIEW (PLAN)</text>

        <rect x="92" y="105" width="360" height="160" rx="3" fill="url(#concrete-speckle)" stroke="var(--color-foreground)" stroke-width="2" />
        <line x1="92" y1="86" x2="452" y2="86" stroke="#2563eb" stroke-width="1.7" marker-start="url(#concrete-arrow-start)" marker-end="url(#concrete-arrow-end)" />
        <line x1="92" y1="92" x2="92" y2="105" stroke="#2563eb" stroke-width="1.2" stroke-dasharray="4 4" />
        <line x1="452" y1="92" x2="452" y2="105" stroke="#2563eb" stroke-width="1.2" stroke-dasharray="4 4" />
        <text x="272" y="76" text-anchor="middle" font-size="13" font-weight="700" fill="#1d4ed8" data-slab-length>Length = 12 ft</text>

        <line x1="70" y1="105" x2="70" y2="265" stroke="#2563eb" stroke-width="1.7" marker-start="url(#concrete-arrow-start)" marker-end="url(#concrete-arrow-end)" />
        <line x1="76" y1="105" x2="92" y2="105" stroke="#2563eb" stroke-width="1.2" stroke-dasharray="4 4" />
        <line x1="76" y1="265" x2="92" y2="265" stroke="#2563eb" stroke-width="1.2" stroke-dasharray="4 4" />
        <text x="52" y="185" text-anchor="middle" font-size="13" font-weight="700" fill="#1d4ed8" transform="rotate(-90 52 185)" data-slab-width>Width = 10 ft</text>

        <text x="505" y="62" font-size="11" font-weight="700" fill="var(--color-foreground)">SIDE VIEW (CROSS SECTION)</text>
        <rect x="520" y="128" width="190" height="42" fill="url(#concrete-speckle)" stroke="var(--color-foreground)" stroke-width="2" />
        <rect x="520" y="170" width="190" height="33" fill="url(#aggregate-stones)" stroke="var(--color-muted-foreground)" stroke-width="1.2" />
        <rect x="520" y="203" width="190" height="36" fill="url(#soil-hatch)" />
        <text x="536" y="154" font-size="11" font-weight="600" fill="var(--color-foreground)">Concrete slab</text>
        <text x="536" y="191" font-size="10.5" fill="var(--color-muted-foreground)">Subbase context only</text>
        <text x="536" y="226" font-size="10.5" fill="var(--color-muted-foreground)">Compacted soil</text>

        <line x1="728" y1="128" x2="728" y2="170" stroke="#2563eb" stroke-width="1.7" marker-start="url(#concrete-arrow-start)" marker-end="url(#concrete-arrow-end)" />
        <line x1="710" y1="128" x2="734" y2="128" stroke="#2563eb" stroke-width="1.1" stroke-dasharray="4 4" />
        <line x1="710" y1="170" x2="734" y2="170" stroke="#2563eb" stroke-width="1.1" stroke-dasharray="4 4" />
        <text x="720" y="190" text-anchor="end" font-size="12" font-weight="700" fill="#1d4ed8" data-slab-depth>Thickness = 4 in</text>

        <rect x="28" y="298" width="704" height="103" rx="12" fill="var(--color-muted)" opacity="0.23" stroke="var(--color-border)" />
        <text x="46" y="324" font-size="11" font-weight="700" fill="var(--color-foreground)">VOLUME FORMULA</text>
        <text x="46" y="351" font-size="19" font-weight="700" fill="var(--color-foreground)">V = L × W × T × Q</text>
        <text x="46" y="378" font-size="11.5" fill="var(--color-muted-foreground)">Convert all dimensions to consistent units before volume is calculated.</text>
        <line x1="425" y1="316" x2="425" y2="386" stroke="var(--color-border)" />
        <text x="449" y="324" font-size="11" font-weight="700" fill="var(--color-foreground)">CURRENT INPUTS</text>
        <text x="449" y="354" font-size="15" font-weight="700" fill="#1d4ed8" data-concrete-input-summary>12 ft × 10 ft × 4 in</text>
        <text x="449" y="379" font-size="11.5" fill="var(--color-muted-foreground)" data-concrete-quantity-summary>Identical sections: 1</text>
      </g>

      <!-- STRIP FOOTING -->
      <g data-concrete-shape="1" style="display:none">
        <text x="42" y="62" font-size="11" font-weight="700" fill="var(--color-foreground)">TOP VIEW (PLAN)</text>
        <rect x="86" y="134" width="390" height="88" rx="2" fill="url(#concrete-speckle)" stroke="var(--color-foreground)" stroke-width="2" />
        <line x1="86" y1="112" x2="476" y2="112" stroke="#2563eb" stroke-width="1.7" marker-start="url(#concrete-arrow-start)" marker-end="url(#concrete-arrow-end)" />
        <line x1="86" y1="118" x2="86" y2="134" stroke="#2563eb" stroke-width="1.1" stroke-dasharray="4 4" />
        <line x1="476" y1="118" x2="476" y2="134" stroke="#2563eb" stroke-width="1.1" stroke-dasharray="4 4" />
        <text x="281" y="102" text-anchor="middle" font-size="13" font-weight="700" fill="#1d4ed8" data-footing-length>Length = 12 ft</text>

        <line x1="62" y1="134" x2="62" y2="222" stroke="#2563eb" stroke-width="1.7" marker-start="url(#concrete-arrow-start)" marker-end="url(#concrete-arrow-end)" />
        <text x="44" y="178" text-anchor="middle" font-size="13" font-weight="700" fill="#1d4ed8" transform="rotate(-90 44 178)" data-footing-width>Width = 10 ft</text>

        <text x="520" y="62" font-size="11" font-weight="700" fill="var(--color-foreground)">FOOTING SECTION</text>
        <path d="M520 105 H710 V244 H520 Z" fill="url(#soil-hatch)" opacity="0.8" />
        <rect x="548" y="142" width="134" height="70" fill="url(#concrete-speckle)" stroke="var(--color-foreground)" stroke-width="2" />
        <line x1="548" y1="229" x2="682" y2="229" stroke="#2563eb" stroke-width="1.7" marker-start="url(#concrete-arrow-start)" marker-end="url(#concrete-arrow-end)" />
        <text x="615" y="247" text-anchor="middle" font-size="12" font-weight="700" fill="#1d4ed8" data-footing-width-2>Width = 10 ft</text>
        <line x1="704" y1="142" x2="704" y2="212" stroke="#2563eb" stroke-width="1.7" marker-start="url(#concrete-arrow-start)" marker-end="url(#concrete-arrow-end)" />
        <text x="694" y="132" text-anchor="end" font-size="12" font-weight="700" fill="#1d4ed8" data-footing-depth>Depth = 4 in</text>

        <rect x="28" y="298" width="704" height="103" rx="12" fill="var(--color-muted)" opacity="0.23" stroke="var(--color-border)" />
        <text x="46" y="324" font-size="11" font-weight="700" fill="var(--color-foreground)">VOLUME FORMULA</text>
        <text x="46" y="351" font-size="19" font-weight="700" fill="var(--color-foreground)">V = L × W × D × Q</text>
        <text x="46" y="378" font-size="11.5" fill="var(--color-muted-foreground)">Use the formed footing width and depth from the project requirements.</text>
        <line x1="425" y1="316" x2="425" y2="386" stroke="var(--color-border)" />
        <text x="449" y="324" font-size="11" font-weight="700" fill="var(--color-foreground)">CURRENT INPUTS</text>
        <text x="449" y="354" font-size="15" font-weight="700" fill="#1d4ed8" data-concrete-input-summary>12 ft × 10 ft × 4 in</text>
        <text x="449" y="379" font-size="11.5" fill="var(--color-muted-foreground)" data-concrete-quantity-summary>Identical sections: 1</text>
      </g>

      <!-- WALL -->
      <g data-concrete-shape="2" style="display:none">
        <text x="42" y="62" font-size="11" font-weight="700" fill="var(--color-foreground)">FRONT ELEVATION</text>
        <rect x="88" y="102" width="388" height="160" fill="url(#concrete-speckle)" stroke="var(--color-foreground)" stroke-width="2" />
        <line x1="88" y1="82" x2="476" y2="82" stroke="#2563eb" stroke-width="1.7" marker-start="url(#concrete-arrow-start)" marker-end="url(#concrete-arrow-end)" />
        <text x="282" y="72" text-anchor="middle" font-size="13" font-weight="700" fill="#1d4ed8" data-wall-length>Length = 12 ft</text>
        <line x1="66" y1="102" x2="66" y2="262" stroke="#2563eb" stroke-width="1.7" marker-start="url(#concrete-arrow-start)" marker-end="url(#concrete-arrow-end)" />
        <text x="48" y="182" text-anchor="middle" font-size="13" font-weight="700" fill="#1d4ed8" transform="rotate(-90 48 182)" data-wall-height>Height = 8 ft</text>

        <text x="525" y="62" font-size="11" font-weight="700" fill="var(--color-foreground)">TOP SECTION</text>
        <rect x="545" y="116" width="125" height="122" fill="url(#concrete-speckle)" stroke="var(--color-foreground)" stroke-width="2" />
        <line x1="526" y1="116" x2="526" y2="238" stroke="#2563eb" stroke-width="1.7" marker-start="url(#concrete-arrow-start)" marker-end="url(#concrete-arrow-end)" />
        <text x="514" y="177" text-anchor="middle" font-size="12" font-weight="700" fill="#1d4ed8" transform="rotate(-90 514 177)" data-wall-thickness>Thickness = 8 in</text>
        <text x="607" y="254" text-anchor="middle" font-size="10.5" fill="var(--color-muted-foreground)">Wall section</text>

        <rect x="28" y="298" width="704" height="103" rx="12" fill="var(--color-muted)" opacity="0.23" stroke="var(--color-border)" />
        <text x="46" y="324" font-size="11" font-weight="700" fill="var(--color-foreground)">VOLUME FORMULA</text>
        <text x="46" y="351" font-size="19" font-weight="700" fill="var(--color-foreground)">V = L × H × T × Q</text>
        <text x="46" y="378" font-size="11.5" fill="var(--color-muted-foreground)">Wall thickness is measured perpendicular to the wall face.</text>
        <line x1="425" y1="316" x2="425" y2="386" stroke="var(--color-border)" />
        <text x="449" y="324" font-size="11" font-weight="700" fill="var(--color-foreground)">CURRENT INPUTS</text>
        <text x="449" y="354" font-size="15" font-weight="700" fill="#1d4ed8" data-concrete-input-summary>12 ft × 8 ft × 8 in</text>
        <text x="449" y="379" font-size="11.5" fill="var(--color-muted-foreground)" data-concrete-quantity-summary>Identical sections: 1</text>
      </g>

      <!-- CYLINDER / COLUMN -->
      <g data-concrete-shape="3" style="display:none">
        <text x="42" y="62" font-size="11" font-weight="700" fill="var(--color-foreground)">TOP VIEW (PLAN)</text>
        <circle cx="260" cy="170" r="92" fill="url(#concrete-speckle)" stroke="var(--color-foreground)" stroke-width="2" />
        <line x1="168" y1="170" x2="352" y2="170" stroke="#2563eb" stroke-width="1.7" marker-start="url(#concrete-arrow-start)" marker-end="url(#concrete-arrow-end)" />
        <text x="260" y="151" text-anchor="middle" font-size="13" font-weight="700" fill="#1d4ed8" data-cylinder-diameter>Diameter = 12 in</text>
        <circle cx="260" cy="170" r="3" fill="var(--color-foreground)" />

        <text x="505" y="62" font-size="11" font-weight="700" fill="var(--color-foreground)">SIDE ELEVATION</text>
        <ellipse cx="610" cy="110" rx="72" ry="22" fill="url(#concrete-speckle)" stroke="var(--color-foreground)" stroke-width="2" />
        <rect x="538" y="110" width="144" height="126" fill="url(#concrete-speckle)" stroke="none" />
        <line x1="538" y1="110" x2="538" y2="236" stroke="var(--color-foreground)" stroke-width="2" />
        <line x1="682" y1="110" x2="682" y2="236" stroke="var(--color-foreground)" stroke-width="2" />
        <ellipse cx="610" cy="236" rx="72" ry="22" fill="url(#concrete-speckle)" stroke="var(--color-foreground)" stroke-width="2" />
        <line x1="708" y1="110" x2="708" y2="236" stroke="#2563eb" stroke-width="1.7" marker-start="url(#concrete-arrow-start)" marker-end="url(#concrete-arrow-end)" />
        <text x="696" y="102" text-anchor="end" font-size="12" font-weight="700" fill="#1d4ed8" data-cylinder-height>Height = 8 ft</text>

        <rect x="28" y="298" width="704" height="103" rx="12" fill="var(--color-muted)" opacity="0.23" stroke="var(--color-border)" />
        <text x="46" y="324" font-size="11" font-weight="700" fill="var(--color-foreground)">VOLUME FORMULA</text>
        <text x="46" y="351" font-size="19" font-weight="700" fill="var(--color-foreground)">V = π × (D ÷ 2)² × H × Q</text>
        <text x="46" y="378" font-size="11.5" fill="var(--color-muted-foreground)">Diameter is converted to radius before the circular area is multiplied by height.</text>
        <line x1="425" y1="316" x2="425" y2="386" stroke="var(--color-border)" />
        <text x="449" y="324" font-size="11" font-weight="700" fill="var(--color-foreground)">CURRENT INPUTS</text>
        <text x="449" y="354" font-size="15" font-weight="700" fill="#1d4ed8" data-concrete-input-summary>Ø 12 in × 8 ft</text>
        <text x="449" y="379" font-size="11.5" fill="var(--color-muted-foreground)" data-concrete-quantity-summary>Identical sections: 1</text>
      </g>
    </svg>
  </div>

  <dl class="mt-3 grid gap-2 text-xs sm:grid-cols-3" data-concrete-diagram-values>
    <div class="rounded-md border border-border bg-muted/30 px-3 py-2">
      <dt class="text-muted-foreground">Project type</dt>
      <dd class="mt-0.5 font-mono font-medium text-foreground" data-diagram-project>Rectangular slab</dd>
    </div>
    <div class="rounded-md border border-border bg-muted/30 px-3 py-2">
      <dt class="text-muted-foreground">Primary dimensions</dt>
      <dd class="mt-0.5 font-mono font-medium text-foreground tabular-nums" data-diagram-dimensions>12 ft × 10 ft × 4 in</dd>
    </div>
    <div class="rounded-md border border-border bg-muted/30 px-3 py-2">
      <dt class="text-muted-foreground">Quantity</dt>
      <dd class="mt-0.5 font-mono font-medium text-foreground tabular-nums" data-diagram-quantity>1 section</dd>
    </div>
  </dl>
</figure>

<script>
  function initConcreteRichDiagrams() {
    document.querySelectorAll<HTMLElement>("[data-concrete-rich-diagram]").forEach((figure) => {
      if (figure.dataset.initialized) return;
      figure.dataset.initialized = "true";

      const root = figure.closest<HTMLElement>('[data-calculator-slug="concrete-calculator"]');
      if (!root) return;

      const form = root.querySelector<HTMLFormElement>("#concrete-calculator-form");
      const shape = root.querySelector<HTMLSelectElement>("#concrete-calculator-shape");
      if (!shape) return;

      const input = (id: string) => root.querySelector<HTMLInputElement>(`#concrete-calculator-${id}`);
      const unit = (id: string) => root.querySelector<HTMLSelectElement>(`#concrete-calculator-${id}-unit`);

      const displayUnit = (raw: string | undefined) => {
        const map: Record<string, string> = {
          ft: "ft", in: "in", yd: "yd", m: "m", cm: "cm", mm: "mm",
        };
        return raw ? (map[raw] ?? raw) : "";
      };

      const value = (id: string) => {
        const el = input(id);
        const raw = el?.value?.trim() ?? "";
        if (!raw) return "—";
        const numeric = Number(raw);
        const shown = Number.isFinite(numeric) ? String(Number(numeric.toFixed(4))) : raw;
        const u = displayUnit(unit(id)?.value);
        return u ? `${shown} ${u}` : shown;
      };

      const numeric = (id: string, fallback = 1) => {
        const n = Number(input(id)?.value);
        return Number.isFinite(n) ? n : fallback;
      };

      const setText = (selector: string, text: string) => {
        figure.querySelectorAll<SVGTextElement | HTMLElement>(selector).forEach((el) => {
          el.textContent = text;
        });
      };

      const names = ["Rectangular slab", "Strip footing", "Wall", "Cylinder / column"];

      const update = () => {
        const mode = Math.max(0, Math.min(3, Math.round(Number(shape.value) || 0)));
        const name = names[mode] ?? names[0];

        figure.querySelectorAll<SVGGElement>("[data-concrete-shape]").forEach((group) => {
          group.style.display = group.dataset.concreteShape === String(mode) ? "" : "none";
        });

        setText("[data-concrete-shape-name]", name);
        setText("[data-diagram-project]", name);

        const qty = Math.max(0, numeric("quantity", 1));
        const qtyText = `${qty} ${qty === 1 ? "section" : "sections"}`;
        setText("[data-concrete-quantity-summary]", `Identical sections: ${qty}`);
        setText("[data-diagram-quantity]", qtyText);

        let summary = "";

        if (mode === 0) {
          const l = value("length");
          const w = value("width");
          const d = value("depth");
          setText("[data-slab-length]", `Length = ${l}`);
          setText("[data-slab-width]", `Width = ${w}`);
          setText("[data-slab-depth]", `Thickness = ${d}`);
          summary = `${l} × ${w} × ${d}`;
        } else if (mode === 1) {
          const l = value("length");
          const w = value("width");
          const d = value("depth");
          setText("[data-footing-length]", `Length = ${l}`);
          setText("[data-footing-width]", `Width = ${w}`);
          setText("[data-footing-width-2]", `Width = ${w}`);
          setText("[data-footing-depth]", `Depth = ${d}`);
          summary = `${l} × ${w} × ${d}`;
        } else if (mode === 2) {
          const l = value("length");
          const h = value("height");
          const t = value("thickness");
          setText("[data-wall-length]", `Length = ${l}`);
          setText("[data-wall-height]", `Height = ${h}`);
          setText("[data-wall-thickness]", `Thickness = ${t}`);
          summary = `${l} × ${h} × ${t}`;
        } else {
          const d = value("diameter");
          const h = value("height");
          setText("[data-cylinder-diameter]", `Diameter = ${d}`);
          setText("[data-cylinder-height]", `Height = ${h}`);
          summary = `Ø ${d} × ${h}`;
        }

        setText("[data-concrete-input-summary]", summary);
        setText("[data-diagram-dimensions]", summary);
      };

      root.addEventListener("input", update);
      root.addEventListener("change", update);
      root.addEventListener("calculator-state-restored", update);
      form?.addEventListener("reset", () => setTimeout(update, 0));

      update();
      // Shared-link hydration runs in GenericCalculator. Re-read after sibling
      // scripts settle so the first paint cannot remain on the default shape.
      queueMicrotask(update);
      requestAnimationFrame(update);
      setTimeout(update, 0);
    });
  }

  initConcreteRichDiagrams();
  document.addEventListener("astro:page-load", initConcreteRichDiagrams);
</script>
