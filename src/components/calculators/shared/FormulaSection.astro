---
interface Props {
  title?: string;
  formula: string;
  variables?: { symbol: string; meaning: string }[];
}
const { title = "Formula", formula, variables = [] } = Astro.props;
---
<div class="rounded-lg border border-hairline bg-canvas p-6 dark:bg-canvas">
  <h2 class="text-display-sm font-semibold tracking-[-0.03em] text-ink">{title}</h2>
  <div class="mt-3 rounded-md border border-hairline bg-canvas-soft-2 p-4 font-mono text-sm leading-6 dark:bg-[#171717]">
    <p class="font-semibold text-ink">{formula}</p>
    {variables.length > 0 && (
      <ul class="mt-2 list-disc pl-5 text-xs text-body">
        {variables.map((v) => <li><span class="font-semibold text-ink">{v.symbol}</span> — {v.meaning}</li>)}
      </ul>
    )}
  </div>
  <slot />
</div>
