---
interface Props {
  title?: string;
  id?: string;
}
const { title = "RESULT", id = "calc-results" } = Astro.props;
---
<div id={id} class="mt-6 hidden" aria-live="polite">
  <div class="rounded-xl border border-border bg-muted/30 p-5">
    <p class="font-mono text-[11px] font-medium tracking-[0.1em] uppercase text-muted-foreground">{title}</p>
    <slot />
  </div>
</div>
