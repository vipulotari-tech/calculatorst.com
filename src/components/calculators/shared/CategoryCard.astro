---
interface Props {
  title: string;
  href: string;
  description: string;
  count?: number;
}
const { title, href, description, count } = Astro.props;
---
<a href={href} class="group flex h-full flex-col rounded-xl border border-border bg-card p-5 shadow-card transition-all duration-150 hover:shadow-card-hover hover:-translate-y-0.5 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring">
  <h3 class="text-[15px] font-semibold tracking-[-0.02em] text-foreground group-hover:text-foreground">{title}</h3>
  {count && <p class="mt-1 font-mono text-[11px] text-muted-foreground">{count} calculators</p>}
  <p class="mt-2 flex-1 text-[13px] leading-[18px] text-muted-foreground">{description}</p>
  <span class="mt-4 inline-flex items-center gap-1 font-mono text-[11px] font-medium text-muted-foreground group-hover:text-foreground transition-colors">Explore <svg width="12" height="12" viewBox="0 0 16 16" fill="none" aria-hidden="true" class="transition-transform group-hover:translate-x-0.5"><path d="M6 3l5 5-5 5" stroke="currentColor" stroke-width="1.3" stroke-linecap="round"/></svg></span>
</a>
