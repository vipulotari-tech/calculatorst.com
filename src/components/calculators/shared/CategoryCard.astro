---
interface Props {
  title: string;
  href: string;
  description: string;
  count?: number;
}
const { title, href, description, count } = Astro.props;
---
<a href={href} class="group flex h-full flex-col rounded-lg border border-hairline bg-canvas p-6 shadow-card transition hover:shadow-card-hover focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-link dark:bg-canvas">
  <h3 class="text-display-sm font-semibold tracking-[-0.03em] text-ink group-hover:text-link">{title}</h3>
  {count && <p class="mt-1 font-mono text-xs tracking-wide text-mute">{count} calculators</p>}
  <p class="mt-2 flex-1 text-sm leading-5 text-body">{description}</p>
  <span class="mt-4 inline-flex items-center gap-1 text-sm font-medium text-ink group-hover:text-link">Explore <svg width="12" height="12" viewBox="0 0 16 16" fill="none" aria-hidden="true" class="transition group-hover:translate-x-0.5"><path d="M6 3l5 5-5 5" stroke="currentColor" stroke-width="1.3" stroke-linecap="round"/></svg></span>
</a>
