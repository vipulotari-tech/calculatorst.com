---
const slug = "surface-area-calculator";
---

<figure
  class="calc-project-diagram rounded-xl border border-border bg-card p-4 sm:p-5"
  data-project-diagram
  data-surface-area-rich-diagram
>
  <div class="flex flex-wrap items-start justify-between gap-2">
    <div>
      <h3 class="text-xs font-mono font-semibold uppercase tracking-wider text-foreground">Live net surface-area diagram</h3>
      <p class="mt-1 max-w-[720px] text-[11px] leading-5 text-muted-foreground">
        Gross rectangular area, excluded area, and net usable surface update from the calculator inputs. Use separate non-overlapping rectangles for irregular shapes.
      </p>
    </div>
    <span class="rounded-full border border-border bg-muted px-2 py-1 font-mono text-[10px] text-muted-foreground">GROSS − EXCLUDED = NET</span>
  </div>

  <div class="mt-4 overflow-hidden rounded-xl border border-border bg-background">
    <svg viewBox="0 0 760 500" class="h-auto w-full" role="img" aria-labelledby={`${slug}-surface-title ${slug}-surface-desc`}>
      <title id={`${slug}-surface-title`}>Live rectangular net surface area diagram</title>
      <desc id={`${slug}-surface-desc`}>
        Rectangular plan showing length, width, gross area, excluded area, and resulting net area in square feet, square metres, and square yards.
      </desc>

      <defs>
        <marker id="surface-arrow-start" markerWidth="8" markerHeight="8" refX="1" refY="4" orient="auto">
          <path d="M8 0 L0 4 L8 8 Z" fill="#2563eb" />
        </marker>
        <marker id="surface-arrow-end" markerWidth="8" markerHeight="8" refX="7" refY="4" orient="auto">
          <path d="M0 0 L8 4 L0 8 Z" fill="#2563eb" />
        </marker>
        <pattern id="surface-grid" width="26" height="26" patternUnits="userSpaceOnUse">
          <path d="M26 0H0V26" fill="none" stroke="var(--color-muted-foreground)" stroke-width=".8" opacity=".16" />
        </pattern>
      </defs>

      <rect width="760" height="500" fill="var(--color-background)" />
      <text x="28" y="30" font-size="13" font-weight="700" fill="var(--color-foreground)">Surface-area plan</text>
      <text x="732" y="30" text-anchor="end" font-size="11" fill="var(--color-muted-foreground)" data-surface-size>20 ft × 10 ft</text>

      <text x="42" y="64" font-size="11" font-weight="700" fill="var(--color-foreground)">RECTANGULAR FOOTPRINT</text>
      <rect x="86" y="110" width="390" height="210" rx="5" fill="url(#surface-grid)" stroke="var(--color-foreground)" stroke-width="2" />
      <rect x="86" y="110" width="390" height="210" rx="5" fill="var(--color-muted)" opacity=".18" />

      <line x1="86" y1="84" x2="476" y2="84" stroke="#2563eb" stroke-width="1.7" marker-start="url(#surface-arrow-start)" marker-end="url(#surface-arrow-end)" />
      <line x1="86" y1="92" x2="86" y2="110" stroke="#2563eb" stroke-width="1" stroke-dasharray="4 4" />
      <line x1="476" y1="92" x2="476" y2="110" stroke="#2563eb" stroke-width="1" stroke-dasharray="4 4" />
      <text x="281" y="72" text-anchor="middle" font-size="12.5" font-weight="700" fill="#1d4ed8" data-surface-length>Length = 20 ft</text>

      <line x1="62" y1="110" x2="62" y2="320" stroke="#2563eb" stroke-width="1.7" marker-start="url(#surface-arrow-start)" marker-end="url(#surface-arrow-end)" />
      <line x1="69" y1="110" x2="86" y2="110" stroke="#2563eb" stroke-width="1" stroke-dasharray="4 4" />
      <line x1="69" y1="320" x2="86" y2="320" stroke="#2563eb" stroke-width="1" stroke-dasharray="4 4" />
      <text x="43" y="215" text-anchor="middle" font-size="12.5" font-weight="700" fill="#1d4ed8" transform="rotate(-90 43 215)" data-surface-width>Width = 10 ft</text>

      <text x="106" y="142" font-size="11" font-weight="700" fill="var(--color-foreground)">GROSS AREA</text>
      <text x="106" y="164" font-size="18" font-weight="700" fill="var(--color-foreground)" data-surface-gross>200 ft²</text>

      <g data-surface-cutout>
        <rect x="330" y="214" width="116" height="76" rx="5" fill="var(--color-background)" stroke="var(--color-muted-foreground)" stroke-width="1.6" stroke-dasharray="6 5" />
        <path d="M342 226L434 278M434 226L342 278" stroke="var(--color-muted-foreground)" stroke-width="1.2" opacity=".5" />
        <text x="388" y="247" text-anchor="middle" font-size="10" font-weight="700" fill="var(--color-muted-foreground)">EXCLUDED</text>
        <text x="388" y="265" text-anchor="middle" font-size="12" font-weight="700" fill="var(--color-foreground)" data-surface-cutout-label>0 ft²</text>
      </g>

      <text x="281" y="344" text-anchor="middle" font-size="10.8" fill="var(--color-muted-foreground)">
        Excluded area is subtracted once from the rectangular footprint.
      </text>

      <text x="525" y="64" font-size="11" font-weight="700" fill="var(--color-foreground)">AREA BALANCE</text>

      <g transform="translate(520 92)">
        <rect width="188" height="69" rx="10" fill="var(--color-muted)" opacity=".22" stroke="var(--color-border)" />
        <text x="14" y="22" font-size="10" font-weight="700" fill="var(--color-foreground)">GROSS RECTANGLE</text>
        <text x="14" y="49" font-size="19" font-weight="700" fill="var(--color-foreground)" data-surface-balance-gross>200 ft²</text>
      </g>

      <text x="614" y="184" text-anchor="middle" font-size="22" font-weight="700" fill="var(--color-muted-foreground)">−</text>

      <g transform="translate(520 199)">
        <rect width="188" height="69" rx="10" fill="var(--color-muted)" opacity=".22" stroke="var(--color-border)" />
        <text x="14" y="22" font-size="10" font-weight="700" fill="var(--color-foreground)">EXCLUDED AREA</text>
        <text x="14" y="49" font-size="19" font-weight="700" fill="var(--color-foreground)" data-surface-balance-excluded>0 ft²</text>
      </g>

      <text x="614" y="291" text-anchor="middle" font-size="22" font-weight="700" fill="var(--color-muted-foreground)">=</text>

      <g transform="translate(520 306)">
        <rect width="188" height="78" rx="10" fill="var(--color-muted)" opacity=".22" stroke="var(--color-border)" />
        <text x="14" y="22" font-size="10" font-weight="700" fill="var(--color-foreground)">NET USABLE AREA</text>
        <text x="14" y="51" font-size="21" font-weight="700" fill="#1d4ed8" data-surface-net>200 ft²</text>
        <text x="14" y="68" font-size="10.5" fill="var(--color-muted-foreground)" data-surface-net-alt>18.58 m² · 22.22 yd²</text>
      </g>

      <rect x="28" y="408" width="704" height="55" rx="10" fill="var(--color-muted)" opacity=".22" stroke="var(--color-border)" />
      <text x="45" y="429" font-size="10.5" font-weight="700" fill="var(--color-foreground)">FORMULA</text>
      <text x="45" y="451" font-size="12.5" font-weight="700" fill="var(--color-foreground)">Net area = length × width − excluded area</text>
      <text x="712" y="442" text-anchor="end" font-size="12" font-weight="700" fill="#1d4ed8" data-surface-formula>20 × 10 − 0 = 200 ft²</text>
    </svg>
  </div>

  <dl class="mt-3 grid gap-2 text-xs sm:grid-cols-5">
    <div class="rounded-md border border-border bg-muted/30 px-3 py-2">
      <dt class="text-muted-foreground">Gross area</dt>
      <dd class="mt-0.5 font-mono font-medium text-foreground tabular-nums" data-surface-card-gross>200 ft²</dd>
    </div>
    <div class="rounded-md border border-border bg-muted/30 px-3 py-2">
      <dt class="text-muted-foreground">Excluded area</dt>
      <dd class="mt-0.5 font-mono font-medium text-foreground tabular-nums" data-surface-card-excluded>0 ft²</dd>
    </div>
    <div class="rounded-md border border-border bg-muted/30 px-3 py-2">
      <dt class="text-muted-foreground">Net ft²</dt>
      <dd class="mt-0.5 font-mono font-medium text-foreground tabular-nums" data-surface-card-ft2>200 ft²</dd>
    </div>
    <div class="rounded-md border border-border bg-muted/30 px-3 py-2">
      <dt class="text-muted-foreground">Net m²</dt>
      <dd class="mt-0.5 font-mono font-medium text-foreground tabular-nums" data-surface-card-m2>18.58 m²</dd>
    </div>
    <div class="rounded-md border border-border bg-muted/30 px-3 py-2">
      <dt class="text-muted-foreground">Net yd²</dt>
      <dd class="mt-0.5 font-mono font-medium text-foreground tabular-nums" data-surface-card-yd2>22.22 yd²</dd>
    </div>
  </dl>

  <p class="mt-3 hidden rounded-md border border-border bg-muted/30 px-3 py-2 text-xs text-muted-foreground" data-surface-warning>
    Excluded area cannot exceed the gross rectangular area.
  </p>
</figure>

<script>
  function initSurfaceAreaRichDiagrams() {
    document.querySelectorAll<HTMLElement>("[data-surface-area-rich-diagram]").forEach((figure) => {
      if (figure.dataset.initialized) return;
      figure.dataset.initialized = "true";

      const root = figure.closest<HTMLElement>('[data-calculator-slug="surface-area-calculator"]');
      if (!root) return;
      const form = root.querySelector<HTMLFormElement>("#surface-area-calculator-form");
      if (!form) return;

      const input = (id: string) => root.querySelector<HTMLInputElement>("#surface-area-calculator-" + id);
      const unit = (id: string) => root.querySelector<HTMLSelectElement>("#surface-area-calculator-" + id + "-unit");

      const unitText = (id: string) => {
        const select = unit(id);
        return select ? (select.options[select.selectedIndex]?.text?.trim() || select.value) : "";
      };

      const displayValue = (id: string) => {
        const raw = input(id)?.value?.trim() ?? "";
        if (!raw) return "—";
        const n = Number(raw);
        const shown = Number.isFinite(n) ? String(Number(n.toFixed(4))) : raw;
        const label = unitText(id);
        return label ? shown + " " + label : shown;
      };

      const lengthToFeet = (id: string) => {
        const n = Number(input(id)?.value);
        if (!Number.isFinite(n)) return Number.NaN;
        const factors: Record<string, number> = {
          ft: 1,
          in: 1 / 12,
          yd: 3,
          m: 1 / 0.3048,
          cm: 1 / 30.48,
          mm: 1 / 304.8,
        };
        return n * (factors[unit(id)?.value ?? "ft"] ?? 1);
      };

      const areaToFt2 = (id: string) => {
        const n = Number(input(id)?.value);
        if (!Number.isFinite(n)) return Number.NaN;
        const ftPerM = 1 / 0.3048;
        const factors: Record<string, number> = {
          ft2: 1,
          yd2: 9,
          m2: ftPerM * ftPerM,
          in2: 1 / 144,
        };
        return n * (factors[unit(id)?.value ?? "ft2"] ?? 1);
      };

      const fmt = (n: number, digits = 2) =>
        Number.isFinite(n)
          ? new Intl.NumberFormat("en-US", { maximumFractionDigits: digits }).format(n)
          : "—";

      const setText = (selector: string, text: string) => {
        figure.querySelectorAll<SVGTextElement | HTMLElement>(selector).forEach((el) => {
          el.textContent = text;
        });
      };

      const updateCutout = (gross: number, excluded: number) => {
        const group = figure.querySelector<SVGGElement>("[data-surface-cutout]");
        if (!group) return;
        const ratio = gross > 0 ? Math.max(0, Math.min(.72, excluded / gross)) : 0;
        group.style.opacity = excluded > 0 ? "1" : ".38";
        const rect = group.querySelector("rect");
        if (!rect) return;
        const width = Math.max(70, 116 + ratio * 105);
        const height = Math.max(54, 76 + ratio * 60);
        const x = 446 - width;
        const y = 290 - height;
        rect.setAttribute("x", String(x));
        rect.setAttribute("y", String(y));
        rect.setAttribute("width", String(width));
        rect.setAttribute("height", String(height));
      };

      const update = () => {
        const lengthFt = lengthToFeet("length");
        const widthFt = lengthToFeet("width");
        const excludedFt2 = areaToFt2("openings");
        const validDimensions = [lengthFt, widthFt].every((v) => Number.isFinite(v) && v > 0);
        const gross = validDimensions ? lengthFt * widthFt : Number.NaN;
        const excluded = Number.isFinite(excludedFt2) && excludedFt2 >= 0 ? excludedFt2 : 0;
        const invalidExcluded = Number.isFinite(gross) && excluded > gross;
        const net = Number.isFinite(gross) ? Math.max(0, gross - excluded) : Number.NaN;
        const m2 = net * Math.pow(0.3048, 2);
        const yd2 = net / 9;

        setText("[data-surface-size]", displayValue("length") + " × " + displayValue("width"));
        setText("[data-surface-length]", "Length = " + displayValue("length"));
        setText("[data-surface-width]", "Width = " + displayValue("width"));
        setText("[data-surface-gross]", fmt(gross) + " ft²");
        setText("[data-surface-cutout-label]", fmt(excluded) + " ft²");
        setText("[data-surface-balance-gross]", fmt(gross) + " ft²");
        setText("[data-surface-balance-excluded]", fmt(excluded) + " ft²");
        setText("[data-surface-net]", invalidExcluded ? "Check excluded area" : fmt(net) + " ft²");
        setText("[data-surface-net-alt]", invalidExcluded ? "Excluded area exceeds gross footprint" : fmt(m2) + " m² · " + fmt(yd2) + " yd²");
        setText(
          "[data-surface-formula]",
          validDimensions
            ? fmt(lengthFt) + " × " + fmt(widthFt) + " − " + fmt(excluded) + " = " + (invalidExcluded ? "invalid" : fmt(net) + " ft²")
            : "Enter valid surface dimensions"
        );

        setText("[data-surface-card-gross]", fmt(gross) + " ft²");
        setText("[data-surface-card-excluded]", fmt(excluded) + " ft²");
        setText("[data-surface-card-ft2]", invalidExcluded ? "—" : fmt(net) + " ft²");
        setText("[data-surface-card-m2]", invalidExcluded ? "—" : fmt(m2) + " m²");
        setText("[data-surface-card-yd2]", invalidExcluded ? "—" : fmt(yd2) + " yd²");

        updateCutout(gross, excluded);

        const warning = figure.querySelector<HTMLElement>("[data-surface-warning]");
        warning?.classList.toggle("hidden", !invalidExcluded);
      };

      root.addEventListener("input", update);
      root.addEventListener("change", update);
      root.addEventListener("calculator-state-restored", update);
      form.addEventListener("reset", () => setTimeout(update, 0));

      update();
      queueMicrotask(update);
      requestAnimationFrame(update);
      setTimeout(update, 0);
    });
  }

  initSurfaceAreaRichDiagrams();
  document.addEventListener("astro:page-load", initSurfaceAreaRichDiagrams);
</script>
