---
const slug = "carpet-calculator";
---

<figure
  class="calc-project-diagram rounded-xl border border-border bg-card p-4 sm:p-5"
  data-project-diagram
  data-carpet-rich-diagram
>
  <div class="flex flex-wrap items-start justify-between gap-2">
    <div>
      <h3 class="text-xs font-mono font-semibold uppercase tracking-wider text-foreground">Live carpet roll layout</h3>
      <p class="mt-1 max-w-[680px] text-[11px] leading-5 text-muted-foreground">
        Room plan, full-width strip layout, roll usage, and purchasing allowance update from the calculator inputs. Schematic only — not to scale.
      </p>
    </div>
    <span class="rounded-full border border-border bg-muted px-2 py-1 font-mono text-[10px] text-muted-foreground">LIVE INPUT GUIDE</span>
  </div>

  <div class="mt-4 overflow-hidden rounded-xl border border-border bg-background">
    <svg viewBox="0 0 760 455" class="h-auto w-full" role="img" aria-labelledby={`${slug}-carpet-title ${slug}-carpet-desc`}>
      <title id={`${slug}-carpet-title`}>Live carpet calculator roll-strip diagram</title>
      <desc id={`${slug}-carpet-desc`}>
        A rectangular room divided into full-width carpet strips running along the room length, with live room dimensions, roll width, strip count, allowance, linear roll length, and purchased roll area.
      </desc>

      <defs>
        <marker id="carpet-arrow-start" markerWidth="8" markerHeight="8" refX="1" refY="4" orient="auto">
          <path d="M8 0 L0 4 L8 8 Z" fill="#2563eb"/>
        </marker>
        <marker id="carpet-arrow-end" markerWidth="8" markerHeight="8" refX="7" refY="4" orient="auto">
          <path d="M0 0 L8 4 L0 8 Z" fill="#2563eb"/>
        </marker>
        <pattern id="carpet-fiber" width="18" height="18" patternUnits="userSpaceOnUse">
          <rect width="18" height="18" fill="#7c3aed" opacity=".08"/>
          <path d="M2 15 Q5 6 8 15 M8 15 Q11 5 14 15" fill="none" stroke="#7c3aed" stroke-width="1" opacity=".28"/>
        </pattern>
      </defs>

      <rect width="760" height="455" fill="var(--color-background)"/>
      <text x="28" y="30" font-size="13" font-weight="700" fill="var(--color-foreground)">Carpet strip takeoff</text>
      <text x="732" y="30" text-anchor="end" font-size="11" fill="var(--color-muted-foreground)">Strips run along entered room length</text>

      <text x="42" y="62" font-size="11" font-weight="700" fill="var(--color-foreground)">ROOM PLAN / FULL-WIDTH STRIPS</text>
      <rect x="86" y="104" width="390" height="170" rx="4" fill="url(#carpet-fiber)" stroke="var(--color-foreground)" stroke-width="2"/>
      <g data-carpet-strip-lines></g>

      <line x1="86" y1="84" x2="476" y2="84" stroke="#2563eb" stroke-width="1.7" marker-start="url(#carpet-arrow-start)" marker-end="url(#carpet-arrow-end)"/>
      <line x1="86" y1="90" x2="86" y2="104" stroke="#2563eb" stroke-width="1.1" stroke-dasharray="4 4"/>
      <line x1="476" y1="90" x2="476" y2="104" stroke="#2563eb" stroke-width="1.1" stroke-dasharray="4 4"/>
      <text x="281" y="74" text-anchor="middle" font-size="13" font-weight="700" fill="#1d4ed8" data-carpet-length>Room length = 20 ft</text>

      <line x1="64" y1="104" x2="64" y2="274" stroke="#2563eb" stroke-width="1.7" marker-start="url(#carpet-arrow-start)" marker-end="url(#carpet-arrow-end)"/>
      <line x1="70" y1="104" x2="86" y2="104" stroke="#2563eb" stroke-width="1.1" stroke-dasharray="4 4"/>
      <line x1="70" y1="274" x2="86" y2="274" stroke="#2563eb" stroke-width="1.1" stroke-dasharray="4 4"/>
      <text x="46" y="189" text-anchor="middle" font-size="13" font-weight="700" fill="#1d4ed8" transform="rotate(-90 46 189)" data-carpet-width>Room width = 12 ft</text>

      <text x="281" y="298" text-anchor="middle" font-size="11" fill="var(--color-muted-foreground)" data-carpet-strip-note>1 full-width strip · no width trim</text>

      <text x="520" y="62" font-size="11" font-weight="700" fill="var(--color-foreground)">ROLL / PURCHASE VIEW</text>
      <g transform="translate(522 95)">
        <ellipse cx="52" cy="45" rx="38" ry="23" fill="var(--color-muted)" stroke="var(--color-foreground)" stroke-width="2"/>
        <rect x="52" y="22" width="93" height="46" fill="url(#carpet-fiber)" stroke="var(--color-foreground)" stroke-width="2"/>
        <ellipse cx="145" cy="45" rx="15" ry="23" fill="var(--color-background)" stroke="var(--color-foreground)" stroke-width="2"/>
        <circle cx="145" cy="45" r="5" fill="var(--color-muted-foreground)" opacity=".5"/>
        <line x1="14" y1="89" x2="145" y2="89" stroke="#2563eb" stroke-width="1.5" marker-start="url(#carpet-arrow-start)" marker-end="url(#carpet-arrow-end)"/>
        <text x="80" y="108" text-anchor="middle" font-size="11.5" font-weight="700" fill="#1d4ed8" data-carpet-roll-width>Roll width = 12 ft</text>
      </g>

      <g transform="translate(515 225)">
        <rect width="205" height="75" rx="10" fill="var(--color-muted)" opacity=".23" stroke="var(--color-border)"/>
        <text x="14" y="22" font-size="10.5" fill="var(--color-muted-foreground)">Calculated roll usage</text>
        <text x="14" y="43" font-size="13" font-weight="700" fill="#1d4ed8" data-carpet-linear>20 linear ft</text>
        <text x="14" y="62" font-size="11" fill="var(--color-muted-foreground)" data-carpet-order-area>26.67 yd² purchased</text>
      </g>

      <rect x="28" y="326" width="704" height="102" rx="12" fill="var(--color-muted)" opacity=".23" stroke="var(--color-border)"/>
      <text x="46" y="351" font-size="11" font-weight="700" fill="var(--color-foreground)">ROLL LAYOUT FORMULA</text>
      <text x="46" y="376" font-size="15.5" font-weight="700" fill="var(--color-foreground)">Strips = ceil(room width ÷ roll width)</text>
      <text x="46" y="400" font-size="11" fill="var(--color-muted-foreground)">Purchased length = strips × room length × allowance · Purchased area = purchased length × roll width</text>

      <line x1="432" y1="342" x2="432" y2="416" stroke="var(--color-border)"/>
      <text x="455" y="351" font-size="11" font-weight="700" fill="var(--color-foreground)">CURRENT LAYOUT</text>
      <text x="455" y="375" font-size="13" font-weight="700" fill="#1d4ed8" data-carpet-layout>1 strip · 10% allowance</text>
      <text x="455" y="399" font-size="11.5" fill="var(--color-muted-foreground)" data-carpet-offcuts>0 ft² above room area</text>
    </svg>
  </div>

  <dl class="mt-3 grid gap-2 text-xs sm:grid-cols-4">
    <div class="rounded-md border border-border bg-muted/30 px-3 py-2">
      <dt class="text-muted-foreground">Room</dt>
      <dd class="mt-0.5 font-mono font-medium text-foreground tabular-nums" data-carpet-card-room>20 ft × 12 ft</dd>
    </div>
    <div class="rounded-md border border-border bg-muted/30 px-3 py-2">
      <dt class="text-muted-foreground">Roll width</dt>
      <dd class="mt-0.5 font-mono font-medium text-foreground tabular-nums" data-carpet-card-roll>12 ft</dd>
    </div>
    <div class="rounded-md border border-border bg-muted/30 px-3 py-2">
      <dt class="text-muted-foreground">Full-width strips</dt>
      <dd class="mt-0.5 font-mono font-medium text-foreground tabular-nums" data-carpet-card-strips>1</dd>
    </div>
    <div class="rounded-md border border-border bg-muted/30 px-3 py-2">
      <dt class="text-muted-foreground">Allowance</dt>
      <dd class="mt-0.5 font-mono font-medium text-foreground tabular-nums" data-carpet-card-waste>10%</dd>
    </div>
  </dl>
</figure>

<script>
  function initCarpetRichDiagrams() {
    document.querySelectorAll<HTMLElement>("[data-carpet-rich-diagram]").forEach((figure) => {
      if (figure.dataset.initialized) return;
      figure.dataset.initialized = "true";

      const root = figure.closest<HTMLElement>('[data-calculator-slug="carpet-calculator"]');
      if (!root) return;
      const form = root.querySelector<HTMLFormElement>("#carpet-calculator-form");
      if (!form) return;

      const input = (id: string) => root.querySelector<HTMLInputElement>(`#carpet-calculator-${id}`);
      const unit = (id: string) => root.querySelector<HTMLSelectElement>(`#carpet-calculator-${id}-unit`);

      const unitLabel = (id: string) => {
        const select = unit(id);
        if (select) return select.options[select.selectedIndex]?.text?.trim() || select.value;
        const el = input(id);
        const staticUnit = el?.parentElement?.querySelector("span");
        return staticUnit?.textContent?.trim() || "";
      };

      const displayValue = (id: string) => {
        const raw = input(id)?.value?.trim() ?? "";
        if (!raw) return "—";
        const n = Number(raw);
        const shown = Number.isFinite(n) ? String(Number(n.toFixed(4))) : raw;
        const u = unitLabel(id);
        return u ? `${shown} ${u}` : shown;
      };

      const lengthToFeet = (id: string) => {
        const raw = Number(input(id)?.value);
        if (!Number.isFinite(raw)) return Number.NaN;
        const u = unit(id)?.value ?? "ft";
        const factors: Record<string, number> = {
          ft: 1,
          in: 1 / 12,
          yd: 3,
          m: 1 / 0.3048,
          cm: 1 / 30.48,
          mm: 1 / 304.8,
        };
        return raw * (factors[u] ?? 1);
      };

      const numberValue = (id: string, fallback = 0) => {
        const n = Number(input(id)?.value);
        return Number.isFinite(n) ? n : fallback;
      };

      const fmt = (n: number, digits = 2) =>
        Number.isFinite(n)
          ? new Intl.NumberFormat("en-US", { maximumFractionDigits: digits }).format(n)
          : "—";

      const setText = (selector: string, text: string) => {
        figure.querySelectorAll<SVGTextElement | HTMLElement>(selector).forEach((el) => { el.textContent = text; });
      };

      const drawStrips = (count: number) => {
        const group = figure.querySelector<SVGGElement>("[data-carpet-strip-lines]");
        if (!group) return;
        while (group.firstChild) group.removeChild(group.firstChild);

        const shown = Math.max(1, Math.min(12, count));
        const x1 = 86;
        const x2 = 476;
        const y0 = 104;
        const h = 170;
        for (let i = 1; i < shown; i++) {
          const y = y0 + h * i / shown;
          const line = document.createElementNS("http://www.w3.org/2000/svg", "line");
          line.setAttribute("x1", String(x1));
          line.setAttribute("x2", String(x2));
          line.setAttribute("y1", String(y));
          line.setAttribute("y2", String(y));
          line.setAttribute("stroke", "#7c3aed");
          line.setAttribute("stroke-width", "1.5");
          line.setAttribute("stroke-dasharray", "7 4");
          line.setAttribute("opacity", "0.72");
          group.appendChild(line);
        }
      };

      const update = () => {
        const length = displayValue("length");
        const width = displayValue("width");
        const rollWidth = displayValue("rollWidth");
        const waste = Math.max(0, numberValue("waste", 0));

        const lengthFt = lengthToFeet("length");
        const widthFt = lengthToFeet("width");
        const rollWidthFt = lengthToFeet("rollWidth");

        const valid = Number.isFinite(lengthFt) && Number.isFinite(widthFt) && Number.isFinite(rollWidthFt)
          && lengthFt > 0 && widthFt > 0 && rollWidthFt > 0;

        const strips = valid ? Math.ceil(widthFt / rollWidthFt) : 0;
        const factor = 1 + waste / 100;
        const linearFt = valid ? strips * lengthFt * factor : Number.NaN;
        const purchasedFt2 = valid ? linearFt * rollWidthFt : Number.NaN;
        const roomFt2 = valid ? lengthFt * widthFt : Number.NaN;
        const offcutsFt2 = valid ? Math.max(0, purchasedFt2 - roomFt2) : Number.NaN;
        const widthTrimFt = valid ? Math.max(0, strips * rollWidthFt - widthFt) : Number.NaN;

        drawStrips(strips || 1);

        setText("[data-carpet-length]", `Room length = ${length}`);
        setText("[data-carpet-width]", `Room width = ${width}`);
        setText("[data-carpet-roll-width]", `Roll width = ${rollWidth}`);
        setText("[data-carpet-linear]", `${fmt(linearFt)} linear ft`);
        setText("[data-carpet-order-area]", `${fmt(purchasedFt2 / 9)} yd² purchased`);
        setText("[data-carpet-layout]", `${strips} ${strips === 1 ? "strip" : "strips"} · ${waste}% allowance`);
        setText("[data-carpet-offcuts]", `${fmt(offcutsFt2)} ft² above room area`);

        const stripNote = strips > 12
          ? `${strips} full-width strips · diagram condenses to 12 bands`
          : widthTrimFt > 0.001
            ? `${strips} full-width ${strips === 1 ? "strip" : "strips"} · last strip trims ${fmt(widthTrimFt)} ft across width`
            : `${strips} full-width ${strips === 1 ? "strip" : "strips"} · no width trim`;
        setText("[data-carpet-strip-note]", stripNote);

        setText("[data-carpet-card-room]", `${length} × ${width}`);
        setText("[data-carpet-card-roll]", rollWidth);
        setText("[data-carpet-card-strips]", String(strips));
        setText("[data-carpet-card-waste]", `${waste}%`);
      };

      root.addEventListener("input", update);
      root.addEventListener("change", update);\n      root.addEventListener("calculator-state-restored", update);
      form.addEventListener("reset", () => setTimeout(update, 0));
      update();
      setTimeout(update, 0);
    });
  }

  initCarpetRichDiagrams();
  document.addEventListener("astro:page-load", initCarpetRichDiagrams);
</script>
