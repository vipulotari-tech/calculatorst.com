---
const slug = "paint-calculator";
---

<figure
  class="calc-project-diagram rounded-xl border border-border bg-card p-4 sm:p-5"
  data-project-diagram
  data-paint-rich-diagram
>
  <div class="flex flex-wrap items-start justify-between gap-2">
    <div>
      <h3 class="text-xs font-mono font-semibold uppercase tracking-wider text-foreground">Live paint room diagram</h3>
      <p class="mt-1 max-w-[650px] text-[11px] leading-5 text-muted-foreground">
        Room plan and wall elevation update from the active calculator measurements. Schematic only — not to scale.
      </p>
    </div>
    <span class="rounded-full border border-border bg-muted px-2 py-1 font-mono text-[10px] text-muted-foreground">LIVE INPUT GUIDE</span>
  </div>

  <div class="mt-4 overflow-hidden rounded-xl border border-border bg-background">
    <svg viewBox="0 0 760 430" class="h-auto w-full" role="img" aria-labelledby={`${slug}-paint-title ${slug}-paint-desc`}>
      <title id={`${slug}-paint-title`}>Live paint calculator room diagram</title>
      <desc id={`${slug}-paint-desc`}>
        A room plan and wall elevation showing room length, width, wall height, excluded openings, coats, coverage and the wall-area formula used by the Paint Calculator.
      </desc>
      <defs>
        <marker id="paint-arrow-start" markerWidth="8" markerHeight="8" refX="1" refY="4" orient="auto">
          <path d="M8 0 L0 4 L8 8 Z" fill="#2563eb"/>
        </marker>
        <marker id="paint-arrow-end" markerWidth="8" markerHeight="8" refX="7" refY="4" orient="auto">
          <path d="M0 0 L8 4 L0 8 Z" fill="#2563eb"/>
        </marker>
        <pattern id="paint-fill" width="18" height="18" patternUnits="userSpaceOnUse">
          <rect width="18" height="18" fill="var(--color-muted)" opacity=".5"/>
          <circle cx="4" cy="5" r=".9" fill="var(--color-muted-foreground)" opacity=".18"/>
          <circle cx="13" cy="12" r=".7" fill="var(--color-muted-foreground)" opacity=".16"/>
        </pattern>
      </defs>

      <rect width="760" height="430" fill="var(--color-background)"/>
      <text x="28" y="30" font-size="13" font-weight="700" fill="var(--color-foreground)">Paint Calculator</text>
      <text x="732" y="30" text-anchor="end" font-size="11" fill="var(--color-muted-foreground)">Four-wall room model</text>

      <text x="42" y="62" font-size="11" font-weight="700" fill="var(--color-foreground)">ROOM PLAN</text>
      <rect x="84" y="102" width="330" height="160" rx="4" fill="var(--color-card)" stroke="var(--color-foreground)" stroke-width="2"/>
      <line x1="84" y1="82" x2="414" y2="82" stroke="#2563eb" stroke-width="1.7" marker-start="url(#paint-arrow-start)" marker-end="url(#paint-arrow-end)"/>
      <line x1="84" y1="88" x2="84" y2="102" stroke="#2563eb" stroke-width="1.1" stroke-dasharray="4 4"/>
      <line x1="414" y1="88" x2="414" y2="102" stroke="#2563eb" stroke-width="1.1" stroke-dasharray="4 4"/>
      <text x="249" y="72" text-anchor="middle" font-size="13" font-weight="700" fill="#1d4ed8" data-paint-length>Length = 12 ft</text>

      <line x1="62" y1="102" x2="62" y2="262" stroke="#2563eb" stroke-width="1.7" marker-start="url(#paint-arrow-start)" marker-end="url(#paint-arrow-end)"/>
      <line x1="68" y1="102" x2="84" y2="102" stroke="#2563eb" stroke-width="1.1" stroke-dasharray="4 4"/>
      <line x1="68" y1="262" x2="84" y2="262" stroke="#2563eb" stroke-width="1.1" stroke-dasharray="4 4"/>
      <text x="44" y="182" text-anchor="middle" font-size="13" font-weight="700" fill="#1d4ed8" transform="rotate(-90 44 182)" data-paint-width>Width = 10 ft</text>

      <text x="492" y="62" font-size="11" font-weight="700" fill="var(--color-foreground)">WALL ELEVATION</text>
      <rect x="500" y="102" width="205" height="160" fill="url(#paint-fill)" stroke="var(--color-foreground)" stroke-width="2"/>
      <rect x="525" y="170" width="52" height="92" fill="var(--color-background)" stroke="var(--color-muted-foreground)" stroke-width="1.5"/>
      <rect x="610" y="135" width="66" height="52" fill="var(--color-background)" stroke="var(--color-muted-foreground)" stroke-width="1.5"/>
      <text x="551" y="217" text-anchor="middle" font-size="9.5" fill="var(--color-muted-foreground)">opening</text>
      <text x="643" y="165" text-anchor="middle" font-size="9.5" fill="var(--color-muted-foreground)">opening</text>

      <line x1="724" y1="102" x2="724" y2="262" stroke="#2563eb" stroke-width="1.7" marker-start="url(#paint-arrow-start)" marker-end="url(#paint-arrow-end)"/>
      <line x1="705" y1="102" x2="730" y2="102" stroke="#2563eb" stroke-width="1.1" stroke-dasharray="4 4"/>
      <line x1="705" y1="262" x2="730" y2="262" stroke="#2563eb" stroke-width="1.1" stroke-dasharray="4 4"/>
      <text x="714" y="92" text-anchor="end" font-size="12" font-weight="700" fill="#1d4ed8" data-paint-height>Height = 8 ft</text>

      <text x="603" y="287" text-anchor="middle" font-size="11" fill="var(--color-muted-foreground)" data-paint-openings>Excluded openings = 20 ft²</text>

      <rect x="28" y="310" width="704" height="94" rx="12" fill="var(--color-muted)" opacity=".23" stroke="var(--color-border)"/>
      <text x="46" y="335" font-size="11" font-weight="700" fill="var(--color-foreground)">AREA & PAINT FORMULA</text>
      <text x="46" y="360" font-size="16" font-weight="700" fill="var(--color-foreground)">Wall area = 2 × (L + W) × H − openings</text>
      <text x="46" y="384" font-size="11" fill="var(--color-muted-foreground)">Paint = wall area × coats × allowance ÷ coverage</text>

      <line x1="435" y1="326" x2="435" y2="392" stroke="var(--color-border)"/>
      <text x="458" y="335" font-size="11" font-weight="700" fill="var(--color-foreground)">CURRENT PAINT ASSUMPTIONS</text>
      <text x="458" y="359" font-size="13" font-weight="700" fill="#1d4ed8" data-paint-coats>2 coats</text>
      <text x="458" y="381" font-size="11.5" fill="var(--color-muted-foreground)" data-paint-coverage>350 ft²/US gal · 1 US gal container</text>
    </svg>
  </div>

  <dl class="mt-3 grid gap-2 text-xs sm:grid-cols-3">
    <div class="rounded-md border border-border bg-muted/30 px-3 py-2">
      <dt class="text-muted-foreground">Room</dt>
      <dd class="mt-0.5 font-mono font-medium text-foreground tabular-nums" data-paint-room>12 ft × 10 ft × 8 ft</dd>
    </div>
    <div class="rounded-md border border-border bg-muted/30 px-3 py-2">
      <dt class="text-muted-foreground">Excluded openings</dt>
      <dd class="mt-0.5 font-mono font-medium text-foreground tabular-nums" data-paint-openings-card>20 ft²</dd>
    </div>
    <div class="rounded-md border border-border bg-muted/30 px-3 py-2">
      <dt class="text-muted-foreground">Application</dt>
      <dd class="mt-0.5 font-mono font-medium text-foreground tabular-nums" data-paint-application>2 coats · 350 ft²/gal</dd>
    </div>
  </dl>
</figure>

<script>
  function initPaintRichDiagrams() {
    document.querySelectorAll<HTMLElement>("[data-paint-rich-diagram]").forEach((figure) => {
      if (figure.dataset.initialized) return;
      figure.dataset.initialized = "true";

      const root = figure.closest<HTMLElement>('[data-calculator-slug="paint-calculator"]');
      if (!root) return;
      const form = root.querySelector<HTMLFormElement>("#paint-calculator-form");
      if (!form) return;

      const input = (id: string) => root.querySelector<HTMLInputElement>(`#paint-calculator-${id}`);
      const unit = (id: string) => root.querySelector<HTMLSelectElement>(`#paint-calculator-${id}-unit`);

      const unitLabel = (id: string) => {
        const select = unit(id);
        return select ? (select.options[select.selectedIndex]?.text?.trim() || select.value) : "";
      };

      const value = (id: string) => {
        const raw = input(id)?.value?.trim() ?? "";
        if (!raw) return "—";
        const n = Number(raw);
        const shown = Number.isFinite(n) ? String(Number(n.toFixed(4))) : raw;
        const u = unitLabel(id);
        return u ? `${shown} ${u}` : shown;
      };

      const numberValue = (id: string, fallback = 0) => {
        const n = Number(input(id)?.value);
        return Number.isFinite(n) ? n : fallback;
      };

      const setText = (selector: string, text: string) => {
        figure.querySelectorAll<SVGTextElement | HTMLElement>(selector).forEach((el) => { el.textContent = text; });
      };

      const update = () => {
        const length = value("length");
        const width = value("width");
        const height = value("height");
        const openings = numberValue("openings", 0);
        const openingsUnit = unitLabel("openings") || "ft²";
        const coats = Math.max(0, numberValue("coats", 0));
        const coverage = Math.max(0, numberValue("coverage", 0));
        const container = Math.max(0, numberValue("container", 0));

        setText("[data-paint-length]", `Length = ${length}`);
        setText("[data-paint-width]", `Width = ${width}`);
        setText("[data-paint-height]", `Height = ${height}`);
        setText("[data-paint-openings]", `Excluded openings = ${openings} ${openingsUnit}`);
        setText("[data-paint-coats]", `${coats} ${coats === 1 ? "coat" : "coats"}`);
        setText("[data-paint-coverage]", `${coverage} ft²/US gal · ${container} US gal container`);

        setText("[data-paint-room]", `${length} × ${width} × ${height}`);
        setText("[data-paint-openings-card]", `${openings} ${openingsUnit}`);
        setText("[data-paint-application]", `${coats} ${coats === 1 ? "coat" : "coats"} · ${coverage} ft²/gal`);
      };

      root.addEventListener("input", update);
      root.addEventListener("change", update);
      form.addEventListener("reset", () => setTimeout(update, 0));
      update();
      setTimeout(update, 0);
    });
  }

  initPaintRichDiagrams();
  document.addEventListener("astro:page-load", initPaintRichDiagrams);
</script>
