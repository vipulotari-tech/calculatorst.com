---
interface Props {
  src: string;
  poster: string;
  alt: string;
  caption?: string;
}
const { src, poster, alt, caption } = Astro.props;
---
<div class="overflow-hidden rounded-lg border border-hairline bg-canvas shadow-card">
  <div class="bg-canvas-soft-2 px-4 py-2 border-b border-hairline flex items-center justify-between">
    <span class="font-mono text-[11px] tracking-widest text-mute">3D MODEL — INTERACTIVE</span>
    <span class="font-mono text-[11px] text-mute">Drag to rotate · Scroll to zoom</span>
  </div>
  <div class="relative bg-[#fafafa] dark:bg-[#0a0a0a]">
    <model-viewer
      src={src}
      poster={poster}
      alt={alt}
      ar
      ar-modes="webxr scene-viewer quick-look"
      camera-controls
      touch-action="pan-y"
      auto-rotate
      rotation-per-second="12deg"
      shadow-intensity="0.7"
      environment-image="neutral"
      loading="lazy"
      reveal="interaction"
      style="width:100%; height:320px; background:#fafafa;"
    >
      <div slot="poster" class="flex h-full w-full items-center justify-center bg-canvas-soft p-4">
        <img src={poster} alt={alt} class="h-full w-full object-cover rounded-md border border-hairline" loading="lazy" />
      </div>
      <button slot="ar-button" class="absolute bottom-3 right-3 rounded-full bg-primary px-4 py-1.5 text-xs font-medium text-on-primary shadow-card">View in AR</button>
    </model-viewer>
    <div class="absolute top-3 left-3 rounded-full bg-canvas px-3 py-1 text-[11px] font-mono tracking-wide text-mute shadow-card border border-hairline">3D · Real scale</div>
  </div>
  {caption && <div class="px-4 py-2 bg-canvas-soft border-t border-hairline font-mono text-[11px] leading-4 text-mute">{caption}</div>}
</div>

<script is:inline type="module" src="https://ajax.googleapis.com/ajax/libs/model-viewer/4.0.0/model-viewer.min.js"></script>
