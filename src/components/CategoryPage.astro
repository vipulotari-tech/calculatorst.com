---
import Layout from "../layouts/Layout.astro";
import Header from "./Header.astro";
import Footer from "./Footer.astro";
import Breadcrumbs from "./Breadcrumbs.astro";
import { hubCalculators } from "../data/hubCalculators";
import { calculators as legacyCalculators } from "../data/calculators";
import { clusterGroups } from "../data/subcategories";
import { categoryContent, slugToCluster } from "../data/categoryContent";

interface Props {
  cluster: string;
  slug: string;
}

const { slug, cluster: clusterProp } = Astro.props as Props;
const cluster = clusterProp ?? slugToCluster[slug] ?? slug;

const categoryNames: Record<string, string> = {
  concrete: "Concrete Calculators",
  slab: "Slab, Patio & Driveway Calculators",
  foundation: "Foundation & Footing Calculators",
  rebar: "Rebar & Reinforcement Calculators",
  brick: "Brick & Masonry Calculators",
  cmu: "Concrete Block & CMU Calculators",
  mortar: "Mortar, Grout & Cement Calculators",
  gravel: "Gravel, Aggregate & Dirt Calculators",
  excavation: "Excavation & Earthwork Calculators",
  framing: "Framing & Lumber Calculators",
  roofing: "Roofing Calculators",
  flooring: "Flooring & Tile Calculators",
  drywall: "Drywall, Paint & Insulation Calculators",
  "deck-fence": "Deck, Fence & Outdoor Calculators",
  "decking": "Decking Calculators",
  "fencing": "Fencing Calculators",
  landscaping: "Paver & Landscaping Calculators",
  asphalt: "Asphalt & Surface Calculators",
};

const calculatorCatalog = [...new Map([...hubCalculators, ...legacyCalculators].map((c) => [c.slug, c])).values()];
const calculators = calculatorCatalog.filter((c) => c.cluster === cluster);
const groups = clusterGroups[cluster] || [];
const displayName = categoryNames[cluster] || calculators[0]?.category || slug.replace(/-/g, " ").replace(/\b\w/g, (l) => l.toUpperCase());
const content = categoryContent[slug] ?? categoryContent[cluster];
const canonicalPath = `/construction/${slug}/`;
const primaryByCluster: Record<string, string> = {
  concrete: "concrete-calculator",
  slab: "slab-thickness-calculator",
  foundation: "footing-concrete-calculator",
  rebar: "rebar-calculator",
  brick: "brick-calculator",
  cmu: "concrete-block-calculator",
  mortar: "mortar-calculator",
  gravel: "gravel-calculator",
  excavation: "excavation-calculator",
  framing: "wall-framing-calculator",
  roofing: "roofing-calculator",
  flooring: "flooring-calculator",
  drywall: "drywall-calculator",
  "deck-fence": "deck-calculator",
  landscaping: "paver-calculator",
  asphalt: "asphalt-calculator",
};
const primaryCalculator = calculators.find((c) => c.slug === primaryByCluster[cluster]);
const categorySeoOverrides: Record<string, { title: string; description: string }> = {
  concrete: {
    title: "Concrete Calculators — Yards, Bags, Cost & Project Tools",
    description: "Use 17 concrete calculators for volume, slabs, footings, foundations, walls, columns, curbs, stairs, ramps, mix, weight, waste, cost and crack repair.",
  },
  slab: {
    title: "Slab, Patio & Driveway Calculators — Concrete & Cost Tools",
    description: "Use 10 calculators for slab thickness, cost and rebar plus patio, driveway, garage-slab and shed-foundation concrete, base, bags, trucks and project cost.",
  },
  foundation: {
    title: "Foundation & Footing Calculators — Concrete, Excavation & Cost",
    description: "Use 10 foundation calculators for strip, pad and pier footings, footing volume, concrete, walls, basements, crawl spaces, excavation and project cost.",
  },
  rebar: {
    title: "Rebar & Reinforcement Calculators — Grid, Weight, Spacing & Cost",
    description: "Use 10 rebar calculators for grid layout, quantity, stock bars, weight, cost, spacing, total length, lap steel, reinforcement mesh and chair supports.",
  },
  brick: {
    title: "Brick & Masonry Calculators — Quantity, Mortar, Weight & Cost",
    description: "Use 15 brick and masonry calculators for wall quantity, courses, cost, mortar, veneer, patios, pavers, generic masonry units, weight, waste and joint spacing.",
  },
  cmu: {
    title: "Concrete Block & CMU Calculators — Blocks, Mortar, Grout & Rebar",
    description: "Use 10 concrete-block and CMU calculators for block quantity, walls, cost, shipment weight, mortar, grout core fill and vertical/horizontal reinforcement takeoff.",
  },
  mortar: {
    title: "Mortar, Grout & Cement Calculators — Bags, Mixes, Cost & Stucco",
    description: "Use 12 calculators for mortar bags, mix ratios, wall mortar, grout joints, grout/cement cost, cement bags, cement-sand ratios, deck mud and stucco.",
  },
  gravel: {
    title: "Gravel, Aggregate & Dirt Calculators — Yards, Tons, Depth & Cost",
    description: "Use 15 calculators for gravel, crushed stone, aggregate, sand, fill dirt and topsoil volume, weight, coverage depth and quote-based project cost.",
  },
  excavation: {
    title: "Excavation & Earthwork Calculators — Bank, Loose, Fill & Hauling",
    description: "Use 10 excavation calculators for bank and loose volume, sloped cuts, trenches, backfill, cut/fill balance, truck trips, soil volume, weight and cost.",
  },
  framing: {
    title: "Framing & Lumber Calculators — Studs, Joists, Board Feet & Beams",
    description: "Use 15 framing calculators for wall studs and plates, lumber count and cost, board feet, joist count and spacing, plus header and beam analysis.",
  },
  roofing: {
    title: "Roofing Calculators — Area, Pitch, Shingles, Rafters & Materials",
    description: "Use 15 roofing calculators for roof area and pitch, shingles, underlayment, sheathing, rafters, trusses, flashing, waste and material cost.",
  },
  flooring: {
    title: "Flooring & Tile Calculators — Coverage, Boxes, Carpet & Cost",
    description: "Use 15 flooring calculators for hardwood, laminate, vinyl, carpet and tile coverage, boxes, cost, grout, adhesive, underlayment and waste.",
  },
  drywall: {
    title: "Drywall, Paint & Insulation Calculators — Sheets, Gallons & Cost",
    description: "Use 15 calculators for drywall sheets, mud, screws and tape plus paint, primer, insulation packages and spray-foam board feet, quantities and cost.",
  },
  "deck-fence": {
    title: "Deck & Fence Calculators — Boards, Posts, Footings & Cost",
    description: "Use 15 deck, fence and gate calculators for boards, joists, post-hole concrete, stairs, railings, posts, panels, pickets, gate layout and material cost.",
  },
  landscaping: {
    title: "Paver & Landscaping Calculators — Pavers, Base, Sand, Mulch & Cost",
    description: "Use 10 paver and landscaping calculators for paver layout, base, bedding and joint sand, landscape material, mulch, retaining-wall blocks and cost.",
  },
  asphalt: {
    title: "Asphalt Calculators — Tons, Thickness, Parking Lots & Cost",
    description: "Use 10 asphalt and surface calculators for tons, volume, weight, reverse thickness, driveways, parking lots, road base, surface area and quote-based cost.",
  },
};
const categorySeo = categorySeoOverrides[cluster];
const categoryTitle = categorySeo?.title ?? `${displayName} — Construction Calculators | Calculator Street`;
const categoryDescription = categorySeo?.description ?? `${displayName} — ${calculators.length} tools. ${content ? content.intro.split(".")[0].toLowerCase() + "." : (calculators[0]?.category || "").toLowerCase() + "."} Browse by project group.`;

const taskLinks = cluster === "concrete" ? [
  { label: "General estimate", href: "/concrete-calculator/", text: "Cubic yards, bags, weight and optional cost for common pour shapes." },
  { label: "Geometry only", href: "/concrete-volume-calculator/", text: "Volume conversions for rectangles, cylinders, tubes, curbs, stairs and wedges." },
  { label: "Ready-mix delivery", href: "/concrete-pour-calculator/", text: "Truck loads, final-load size, short-load fee and pump-time planning." },
  { label: "Slab project", href: "/concrete-slab-calculator/", text: "Square feet, slab yards and 40/50/60/80-lb bag counts." },
  { label: "Foundation takeoff", href: "/concrete-foundation-calculator/", text: "Combine walls, footings, slab and piers into one foundation order." },
  { label: "Cost estimate", href: "/concrete-cost-calculator/", text: "Price ready-mix or bags with tax and quoted delivery/project charges." },
] : cluster === "slab" ? [
  { label: "Slab depth & quantity", href: "/slab-thickness-calculator/", text: "Convert volume to average depth or compare concrete quantity for chosen thicknesses." },
  { label: "Slab cost", href: "/slab-cost-calculator/", text: "Quote-based concrete and project cost with delivery, reinforcement, forms and labor." },
  { label: "Rebar grid", href: "/slab-reinforcement-calculator/", text: "Bar count, grid size, spacing, cut length and weight from specified layout inputs." },
  { label: "Patio concrete", href: "/patio-concrete-calculator/", text: "Rectangle or circle yards, bags, base, forms and truck-load planning." },
  { label: "Driveway concrete", href: "/driveway-concrete-calculator/", text: "Rectangle, apron or tapered driveway yards, base and truck-load planning." },
  { label: "Garage slab", href: "/garage-slab-calculator/", text: "Slab plus thickened edge, compacted base, vapor barrier, forms and trucks." },
  { label: "Shed foundation", href: "/shed-foundation-calculator/", text: "Concrete for shed slabs, strip footings, or piers with manual count or plan-spacing takeoff." },
] : cluster === "foundation" ? [
  { label: "All footing concrete", href: "/footing-concrete-calculator/", text: "Broad strip, rectangular, square and round footing material estimate with bags, weight and cost." },
  { label: "Strip footing", href: "/strip-footing-calculator/", text: "Continuous centerline run, cross-section area, yards, bags and cost." },
  { label: "Pad footing", href: "/pad-footing-calculator/", text: "Rectangular, square or round isolated pads with per-pad and total concrete." },
  { label: "Pier footing", href: "/pier-footing-calculator/", text: "Cylindrical shafts plus optional enlarged bell-base concrete." },
  { label: "Excavation", href: "/foundation-excavation-calculator/", text: "Working room, bank yards, overbreak, swell, loose haul volume and quote-based cost." },
  { label: "Foundation walls", href: "/foundation-wall-calculator/", text: "Centerline wall concrete, opening deductions and form-contact area." },
  { label: "Basement walls", href: "/basement-wall-calculator/", text: "Rectangle perimeter, extra wall runs, openings, forms and concrete." },
  { label: "Foundation cost", href: "/foundation-cost-calculator/", text: "Concrete material plus entered excavation, forms, reinforcement, waterproofing and labor costs." },
] : cluster === "rebar" ? [
  { label: "Full rebar takeoff", href: "/rebar-calculator/", text: "Grid dimensions, bars, equal spacing, total footage, stock bars, weight and cost." },
  { label: "Purchasing quantity", href: "/rebar-quantity-calculator/", text: "Convert a specified grid into installed bars, order footage and equivalent stock bars." },
  { label: "Weight", href: "/rebar-weight-calculator/", text: "Nominal lb/ft, pounds, kilograms, US tons and metric tonnes for #3–#18 bars." },
  { label: "Cost", href: "/rebar-cost-calculator/", text: "Price by foot, stock bar, pound or ton with tax and delivery." },
  { label: "Spacing", href: "/rebar-spacing-calculator/", text: "Solve equal center spacing from bar count or bar count from a maximum spacing." },
  { label: "Grid layout", href: "/rebar-grid-calculator/", text: "Rows, columns, usable grid dimensions, equalized spacing and total linear footage." },
  { label: "Lap steel", href: "/rebar-lap-length-calculator/", text: "Total only a lap length already specified on the drawings, plus weight and cost." },
  { label: "Mesh & supports", href: "/reinforcement-mesh-calculator/", text: "Mesh sheet orientation, overlap, purchasing quantity and cost; pair with chair supports." },
] : cluster === "brick" ? [
  { label: "General brick takeoff", href: "/brick-calculator/", text: "Bricks, wythes, waste, order weight and optional unit cost." },
  { label: "Brick wall layout", href: "/brick-wall-calculator/", text: "Courses, bricks per course, openings and area-adjusted quantity." },
  { label: "Quantity only", href: "/brick-quantity-calculator/", text: "Installed versus order bricks with waste and bricks per square foot." },
  { label: "Brick + mortar cost", href: "/brick-cost-calculator/", text: "Brick and mortar materials plus tax, delivery and entered labor/equipment." },
  { label: "Mortar bags", href: "/brick-mortar-calculator/", text: "Geometric joint volume, mixed-yield bag count and optional bag cost." },
  { label: "Brick veneer", href: "/brick-veneer-calculator/", text: "Single-wythe veneer bricks plus a planning tie grid from entered spacing." },
  { label: "Patio & pavers", href: "/brick-paver-calculator/", text: "Pavers, compacted base, bedding sand, perimeter and optional paver cost." },
  { label: "Weight & logistics", href: "/brick-weight-calculator/", text: "Brick count × unit weight with tons, metric tonnes and optional pallets." },
] : cluster === "cmu" ? [
  { label: "Concrete block takeoff", href: "/concrete-block-calculator/", text: "Blocks, courses, blocks per course, weight and optional cost." },
  { label: "CMU presets/custom", href: "/cmu-calculator/", text: "Standard nominal modules or custom specified block faces." },
  { label: "Wall layout", href: "/cmu-wall-calculator/", text: "Courses, openings, block count and opening displacement." },
  { label: "Quantity only", href: "/cmu-quantity-calculator/", text: "Installed versus order CMU count with waste and blocks per square foot." },
  { label: "Block + mortar cost", href: "/cmu-cost-calculator/", text: "Block and mortar material cost plus tax, delivery and entered labor." },
  { label: "Mortar", href: "/concrete-block-mortar-calculator/", text: "Mortar bags from installed blocks or wall geometry and entered product yield." },
  { label: "Grout core fill", href: "/cmu-grout-calculator/", text: "Vertical cells plus bond-beam/lintel grout, bags and pricing." },
  { label: "CMU reinforcement", href: "/cmu-reinforcement-calculator/", text: "Vertical locations, horizontal runs, rebar length, weight and cost." },
] : cluster === "mortar" ? [
  { label: "Mortar bags", href: "/mortar-calculator/", text: "Estimate from installed brick/block coverage or a known mixed mortar volume." },
  { label: "Mortar wall quantity", href: "/mortar-quantity-calculator/", text: "Wall geometry, openings, joint fraction, mixed volume and whole bags." },
  { label: "Mortar mix ratio", href: "/mortar-mix-calculator/", text: "Split a user-entered cement : lime : sand dry ratio without selecting a mortar type." },
  { label: "Mortar cost", href: "/mortar-cost-calculator/", text: "Known bag count plus quoted price, tax, delivery and entered labor/equipment." },
  { label: "Tile grout quantity", href: "/grout-quantity-calculator/", text: "Tile dimensions, joint width/depth, grout volume, allowance and whole bags." },
  { label: "Known grout volume", href: "/grout-calculator/", text: "Convert an already-known mixed grout volume into bags, liters and weight." },
  { label: "Cement bags", href: "/cement-bag-calculator/", text: "Use a known dry batch or placed/wet volume with an editable dry-volume factor and cement:sand:aggregate ratio." },
  { label: "Cement + sand", href: "/cement-sand-ratio-calculator/", text: "Cement bags, sand yards/tons and combined material cost for a dry ratio." },
  { label: "Deck mud / stucco", href: "/deck-mud-calculator/", text: "Floor-mud bed volume and product yield; use Stucco Calculator for wall coats." },
] : cluster === "gravel" ? [
  { label: "General gravel", href: "/gravel-calculator/", text: "Dimensions + material density preset → yards, tons, metric volume and cost with separate compaction and waste allowances." },
  { label: "Gravel cost", href: "/gravel-cost-calculator/", text: "Quote by yard, cubic meter or ton with tax, delivery and spreading/labor." },
  { label: "Gravel weight", href: "/gravel-weight-calculator/", text: "Measured volume to pounds, US tons, kilograms and metric tonnes without hidden overage." },
  { label: "Coverage depth", href: "/gravel-depth-calculator/", text: "Available volume or weight → average depth over a measured coverage area." },
  { label: "Crushed stone", href: "/crushed-stone-calculator/", text: "Crushed stone, crusher run or crushed concrete volume, tons and cost." },
  { label: "Sand", href: "/sand-calculator/", text: "Sand volume, editable density, order weight and optional material cost." },
  { label: "Fill dirt", href: "/fill-dirt-calculator/", text: "Fill volume and weight for grading/backfill using editable supplier density." },
  { label: "Topsoil", href: "/topsoil-calculator/", text: "Topsoil yards, metric volume, weight and optional material cost." },
] : cluster === "excavation" ? [
  { label: "Excavation volume", href: "/excavation-calculator/", text: "Bank volume for vertical or entered sloped sides plus swell-adjusted loose haul volume." },
  { label: "Excavation cost", href: "/excavation-cost-calculator/", text: "Bank excavation rate, loose haul/disposal rate, truck trips and fixed costs." },
  { label: "Trench excavation", href: "/trench-calculator/", text: "Bottom width, depth, side slope, cross-section, bank volume and loose yards." },
  { label: "Trench backfill", href: "/trench-backfill-calculator/", text: "Deduct pipe and bedding displacement, then convert placed backfill to loose order material." },
  { label: "Earthwork state conversion", href: "/earthwork-calculator/", text: "Bank volume with separate loose and compacted equivalents from entered factors." },
  { label: "Cut / fill balance", href: "/cut-and-fill-calculator/", text: "Convert compacted fill to bank basis and show explicit export/import plus loose haul equivalent." },
  { label: "Dirt removal", href: "/dirt-removal-calculator/", text: "Bank and loose dirt volume, truck trips and entered haul/disposal cost." },
  { label: "Soil volume / weight", href: "/soil-volume-calculator/", text: "Area/depth or known volume for bank/loose soil; pair with Soil Weight for mass." },
] : cluster === "framing" ? [
  { label: "Framing member layout", href: "/framing-calculator/", text: "Count evenly spaced framing members from a specified maximum on-center spacing, with detail pieces and purchasing allowance." },
  { label: "Wall studs & plates", href: "/wall-framing-calculator/", text: "Wall-specific takeoff for studs, top/bottom plates, total lumber footage and allowance." },
  { label: "Stud count", href: "/stud-calculator/", text: "Count installed studs from wall layout distance and specified maximum spacing, plus detail studs and spares." },
  { label: "Stud spacing", href: "/stud-spacing-calculator/", text: "Solve equal center spacing from the distance between end-stud centers and an installed stud count." },
  { label: "General lumber layout", href: "/lumber-calculator/", text: "Estimate evenly spaced lumber pieces, detail pieces, purchasing allowance and optional unit cost." },
  { label: "Lumber cost", href: "/lumber-cost-calculator/", text: "Price known lumber quantity or footage using a supplier quote, allowance, tax, delivery and entered labor/handling." },
  { label: "Board feet", href: "/board-foot-calculator/", text: "Convert thickness, width, length and quantity into board feet, volume and optional material cost." },
  { label: "Board-foot cost", href: "/board-foot-cost-calculator/", text: "Price a known board-foot quantity with the lumber rate you enter and keep volume pricing separate from piece pricing." },
  { label: "Joist count", href: "/joist-calculator/", text: "Count joists across a layout from specified maximum on-center spacing, including end members and optional extras." },
  { label: "Joist spacing", href: "/joist-spacing-calculator/", text: "Solve equal joist center spacing from a known layout distance and installed joist count." },
  { label: "Floor joists", href: "/floor-joist-calculator/", text: "Floor-specific joist quantity from layout width and specified spacing; this is a takeoff, not a span-sizing tool." },
  { label: "Ceiling joists", href: "/ceiling-joist-calculator/", text: "Ceiling-joist quantity from layout distance and specified spacing, with allowance and optional cost." },
  { label: "Header bending", href: "/header-size-calculator/", text: "Bending-only section-modulus check from span, load, allowable bending stress and section breadth; not member selection." },
  { label: "Beam analysis", href: "/beam-calculator/", text: "Reactions, shear, bending moment and elastic deflection for supported or cantilever beam load cases." },
  { label: "Beam line load", href: "/beam-load-calculator/", text: "Convert tributary area, dead/live or snow load and beam self-weight into total applied load and uniform line load." },
] : cluster === "roofing" ? [
  { label: "Roof surface & squares", href: "/roofing-calculator/", text: "Convert footprint, overhang and pitch into measured sloped roof area, allowance-adjusted area and roofing squares." },
  { label: "Roof area only", href: "/roof-area-calculator/", text: "Use the dedicated area workflow when you need sloped surface area and squares without a package-coverage input." },
  { label: "Roof pitch", href: "/roof-pitch-calculator/", text: "Convert rise/run or the supported pitch input into pitch per 12, angle, percent slope and surface multiplier." },
  { label: "Roof slope", href: "/roof-slope-calculator/", text: "Solve slope geometry from vertical rise and horizontal run, including angle and roof-surface multiplier." },
  { label: "Shingle packages", href: "/roofing-shingle-calculator/", text: "Estimate whole shingle packages and squares from footprint plus pitch or known roof area using exact product coverage." },
  { label: "Known-area shingles", href: "/shingle-quantity-calculator/", text: "Start from a known sloped roof area, enter effective package coverage and allowance, then round up whole packages." },
  { label: "Shingle cost", href: "/shingle-cost-calculator/", text: "Price rounded shingle packages from roof area, exact package coverage, allowance, tax and delivery." },
  { label: "Other roofing material", href: "/roofing-material-calculator/", text: "Estimate whole packages for one roofing material using its manufacturer effective coverage and optional price." },
  { label: "Underlayment", href: "/roofing-underlayment-calculator/", text: "Calculate whole rolls from sloped roof area, allowance and manufacturer net roll coverage after overlaps." },
  { label: "Roof sheathing", href: "/roof-sheathing-calculator/", text: "Estimate whole plywood or OSB panels from roof area, actual panel coverage and project allowance." },
  { label: "Common rafter length", href: "/roof-rafter-calculator/", text: "Find common-rafter line length and rise for a symmetric gable from full span, pitch and horizontal overhang." },
  { label: "Rafter length", href: "/rafter-length-calculator/", text: "Use the focused rafter-geometry page for common-rafter line length; it does not size or approve the rafter." },
  { label: "Roof trusses", href: "/roof-truss-calculator/", text: "Count trusses from layout distance and specified maximum on-center spacing, with allowance and optional unit cost." },
  { label: "Flashing", href: "/roof-flashing-calculator/", text: "Convert a continuous flashing run, stock-piece length and overlap into installed and purchased piece counts." },
  { label: "Waste allowance", href: "/roof-waste-calculator/", text: "Apply a chosen allowance to an already-known net roofing area and show extra area, total order area, roofing squares and metric area." },
] : cluster === "flooring" ? [
  { label: "General flooring", href: "/flooring-calculator/", text: "Net room area, package coverage, allowance, whole packages, purchased area and optional material cost." },
  { label: "Project cost", href: "/flooring-cost-calculator/", text: "Price flooring material with its allowance while keeping underlayment/pad cost on net installed area, plus tax, delivery and entered labor." },
  { label: "Hardwood quantity", href: "/hardwood-flooring-calculator/", text: "Estimate hardwood coverage and whole packages from measured area, product coverage and project allowance." },
  { label: "Hardwood cost", href: "/hardwood-flooring-cost-calculator/", text: "Price a hardwood material quantity from your quote, with allowance, tax, delivery and entered labor." },
  { label: "Laminate", href: "/laminate-flooring-calculator/", text: "Estimate laminate packages from room area and exact package coverage, with allowance and optional price." },
  { label: "Vinyl", href: "/vinyl-flooring-calculator/", text: "Estimate vinyl flooring packages or coverage from room dimensions, product coverage and allowance." },
  { label: "Carpet layout", href: "/carpet-calculator/", text: "Use room dimensions and roll width to estimate purchased roll area, linear roll length, offcuts and optional cost." },
  { label: "Carpet cost", href: "/carpet-cost-calculator/", text: "Price carpet purchased from room dimensions and roll width using the selected area price basis." },
  { label: "Tile layout", href: "/tile-calculator/", text: "Calculate straight-layout rows, columns and tile count from area dimensions, tile size, joint width and allowance." },
  { label: "Tile quantity", href: "/tile-quantity-calculator/", text: "Focused whole-tile and box/order quantity workflow using tile dimensions, grout joint and purchasing allowance." },
  { label: "Tile cost", href: "/tile-cost-calculator/", text: "Price whole-box tile purchasing quantity from a box or area quote, with allowance, material tax, delivery and entered labor." },
  { label: "Tile grout", href: "/tile-grout-calculator/", text: "Estimate grout joint-fill volume and whole bags from tile dimensions, joint geometry, product yield and allowance." },
  { label: "Tile adhesive", href: "/tile-adhesive-calculator/", text: "Estimate thinset or adhesive containers from tiled area and manufacturer coverage, with allowance and optional cost." },
  { label: "Flooring waste", href: "/flooring-waste-calculator/", text: "Apply a chosen allowance to a known net flooring quantity and keep extra material separate from the net requirement." },
  { label: "Underlayment", href: "/underlayment-calculator/", text: "Estimate whole rolls or packages from floor area, effective net coverage/overlap and purchasing allowance." },
] : cluster === "drywall" ? [
  { label: "Room drywall", href: "/drywall-calculator/", text: "Room walls plus optional ceiling → whole drywall sheets from entered sheet coverage and allowance." },
  { label: "Known-area sheets", href: "/drywall-sheet-calculator/", text: "Known finished area → whole sheets from actual sheet length and width, allowance and optional sheet price." },
  { label: "Drywall material cost", href: "/drywall-cost-calculator/", text: "Price one known drywall material line with allowance, tax, delivery and entered labor." },
  { label: "Joint compound / mud", href: "/drywall-joint-compound-calculator/", text: "Finished drywall area ÷ manufacturer coverage → whole compound containers." },
  { label: "Drywall screws", href: "/drywall-screw-calculator/", text: "Installed sheets × fastening-plan screws per sheet → screw count and whole boxes." },
  { label: "Drywall tape", href: "/drywall-tape-calculator/", text: "Measured seams and taped corners → tape length and whole rolls." },
  { label: "Wall paint", href: "/paint-calculator/", text: "Room-wall area, openings, coats and product coverage → gallons and whole containers." },
  { label: "Paint coverage", href: "/paint-coverage-calculator/", text: "Known paint quantity and coat count → surface area that can receive all coats." },
  { label: "Paint cost", href: "/paint-cost-calculator/", text: "Wall-paint quantity plus optional per-container material cost." },
  { label: "Primer", href: "/primer-calculator/", text: "Primer gallons and containers from wall geometry, coats, coverage and allowance." },
  { label: "Ceiling paint", href: "/ceiling-paint-calculator/", text: "Flat ceiling area → gallons and containers from coats and product coverage." },
  { label: "Wall-only paint", href: "/wall-paint-calculator/", text: "Four-wall paint quantity from room perimeter, height, openings, coats and coverage." },
  { label: "Insulation packages", href: "/insulation-calculator/", text: "Measured area and exact package coverage → whole insulation packages." },
  { label: "Insulation cost", href: "/insulation-cost-calculator/", text: "Price one known insulation material line with allowance, tax, delivery and entered labor." },
  { label: "Spray foam", href: "/spray-foam-calculator/", text: "Area × installed thickness → board feet and whole kits from usable field yield." },
] : cluster === "deck-fence" ? [
  { label: "General deck takeoff", href: "/deck-calculator/", text: "Deck surface → stock boards, rows, joist lines, fasteners, purchased length and optional board cost." },
  { label: "Deck material cost", href: "/deck-cost-calculator/", text: "Price one known deck material line with allowance, tax, delivery and entered labor." },
  { label: "Deck boards", href: "/deck-board-calculator/", text: "Focus on decking rows, stock-board quantity and purchased linear footage." },
  { label: "Deck joists", href: "/deck-joist-calculator/", text: "Layout distance + specified maximum on-center spacing → joist count and spares." },
  { label: "Deck footing concrete", href: "/deck-footing-calculator/", text: "Post-hole diameter, fill depth and post width → net concrete volume and whole bags." },
  { label: "Deck stairs", href: "/deck-stair-calculator/", text: "Total rise and chosen layout limits → equal risers, treads, total run and diagonal." },
  { label: "Deck railing", href: "/deck-railing-calculator/", text: "Clear rail length, baluster width and chosen maximum gap → baluster count and equal gap." },
  { label: "General fence", href: "/fence-calculator/", text: "Continuous run + specified maximum post spacing → posts, sections/panels, spares and equalized spacing." },
  { label: "Fence material cost", href: "/fence-cost-calculator/", text: "Price one known fence material line with allowance, tax, delivery and entered labor." },
  { label: "Fence posts", href: "/fence-post-calculator/", text: "Focused post count, equalized spacing and spare-post purchasing from a measured run." },
  { label: "Fence panels", href: "/fence-panel-calculator/", text: "Run length + installed panel coverage → whole panels, supporting posts and nominal extra coverage." },
  { label: "Fence pickets", href: "/fence-picket-calculator/", text: "Clear run, picket face width and gap → installed and spare pickets." },
  { label: "Fence concrete", href: "/fence-concrete-calculator/", text: "Round post-hole geometry minus square post displacement → concrete volume and bags." },
  { label: "Gate size", href: "/gate-calculator/", text: "Clear opening and hinge/latch clearances → equal gate-leaf width and face area." },
  { label: "Gate material cost", href: "/gate-cost-calculator/", text: "Price one known gate material line with allowance, tax, delivery and entered labor." },
] : cluster === "landscaping" ? [
  { label: "Paver layout", href: "/paver-calculator/", text: "Area dimensions, paver face size and joint width → rows, columns, installed pavers and order quantity." },
  { label: "Paver material cost", href: "/paver-cost-calculator/", text: "Price one known paver material line with allowance, tax, delivery and entered labor." },
  { label: "Bedding sand", href: "/paver-sand-calculator/", text: "Paved area + bedding depth and density → sand volume, tons and optional bulk cost." },
  { label: "Paver base", href: "/paver-base-calculator/", text: "Area + compacted base depth and density → base volume, tons and optional bulk cost." },
  { label: "Joint sand", href: "/paver-joint-sand-calculator/", text: "Paver and joint geometry → filled joint volume, estimated weight and whole bags." },
  { label: "General landscape material", href: "/landscaping-calculator/", text: "Area × placed depth → bulk yards or whole bags for a generic landscape material." },
  { label: "Landscape material cost", href: "/landscaping-cost-calculator/", text: "Price one known landscaping material line with allowance, tax, delivery and entered labor." },
  { label: "Mulch quantity", href: "/mulch-calculator/", text: "Bed dimensions and placed depth → bulk mulch yards and whole bags." },
  { label: "Mulch cost", href: "/mulch-cost-calculator/", text: "Price one known mulch material line with allowance, tax, delivery and entered labor." },
  { label: "Retaining-wall blocks", href: "/retaining-wall-calculator/", text: "Wall face and actual block face dimensions → block count, estimated order weight and optional unit cost." },
] : cluster === "asphalt" ? [
  { label: "General asphalt quantity", href: "/asphalt-calculator/", text: "Area × compacted thickness with editable mix density → volume, tons and optional material cost." },
  { label: "Asphalt material cost", href: "/asphalt-cost-calculator/", text: "Asphalt volume and tons plus a matching per-yard, per-meter or per-ton material quote." },
  { label: "Asphalt driveway", href: "/asphalt-driveway-calculator/", text: "Driveway area × compacted thickness → asphalt yards and tons using editable density." },
  { label: "Asphalt weight", href: "/asphalt-weight-calculator/", text: "Known asphalt volume × editable compacted density → pounds, US tons and metric tonnes." },
  { label: "Reverse thickness", href: "/asphalt-thickness-calculator/", text: "Known asphalt mass + paved area + density → average compacted thickness; this is not pavement design." },
  { label: "Parking-lot quantity", href: "/parking-lot-calculator/", text: "Parking-lot area × compacted thickness → asphalt volume and tons without project-cost scope." },
  { label: "Parking-lot cost", href: "/parking-lot-cost-calculator/", text: "Parking-lot tons plus quoted material rate, tax, trucking and entered fixed paving cost." },
  { label: "Road base", href: "/road-base-calculator/", text: "Base area, placed depth and density → aggregate volume, weight and optional material cost." },
  { label: "Surface area", href: "/surface-area-calculator/", text: "Net rectangular surface area after excluded area, with US and metric area outputs." },
  { label: "Generic material cost", href: "/construction-material-cost-calculator/", text: "Price a known construction material quantity with allowance, tax, delivery and entered labor." },
] : [];
---

<Layout
  title={categoryTitle}
  description={categoryDescription}
  canonical={canonicalPath}
>
  <Header slot="header" />
  <main id="main" tabindex="-1" class="w-full">
    <div class="mx-auto max-w-[1400px] px-6 py-4 max-md:px-4">
      <Breadcrumbs items={[{ label: "Home", href: "/" }, { label: "Construction", href: "/construction/" }, { label: displayName }]} />
    </div>

    <section class="mx-auto max-w-[1400px] px-6 pb-12 max-md:px-4">
      <div class="mx-auto max-w-[900px]">
        <h1 class="text-[28px] font-semibold tracking-[-0.03em] text-ink sm:text-[30px]">{displayName}</h1>
        <p class="mt-3 text-[14px] leading-6 text-body [text-wrap:pretty]">{content?.intro ?? `Browse ${calculators.length} calculators in this category — organized by project group.`}</p>
        <p class="mt-2 font-mono text-xs tracking-wide text-mute">{calculators.length} calculators · {groups.length} groups</p>
        {primaryCalculator && (
          <a href={`/${primaryCalculator.slug}/`} class="mt-5 block rounded-xl border border-hairline bg-white p-4 shadow-card transition hover:border-hairline-strong/30 hover:shadow-card-hover">
            <p class="font-mono text-[10px] font-medium uppercase tracking-[0.10em] text-mute">Start here</p>
            <h2 class="mt-1 text-[15px] font-semibold text-ink">{primaryCalculator.h1}</h2>
            <p class="mt-1 text-xs leading-5 text-body">{primaryCalculator.description}</p>
          </a>
        )}

        {content?.beforeYouCalculate && (
          <aside class="mt-6 rounded-xl border border-hairline bg-[#fcfcfc] p-5">
            <p class="font-mono text-[11px] font-medium tracking-[0.10em] uppercase text-mute">Before you calculate</p>
            <p class="mt-2 text-[13.5px] leading-6 text-body [text-wrap:pretty]">{content.beforeYouCalculate}</p>
          </aside>
        )}

        {taskLinks.length > 0 && (
          <section class="mt-6 rounded-xl border border-hairline bg-canvas p-5" aria-labelledby="choose-category-calculator">
            <h2 id="choose-category-calculator" class="text-sm font-semibold text-ink">Choose the right {cluster === "concrete" ? "concrete" : cluster === "slab" ? "slab, patio or driveway" : cluster === "foundation" ? "foundation or footing" : cluster === "rebar" ? "rebar or reinforcement" : cluster === "brick" ? "brick or masonry" : cluster === "cmu" ? "concrete block or CMU" : cluster === "mortar" ? "mortar, grout or cement" : cluster === "gravel" ? "gravel, aggregate or dirt" : cluster === "excavation" ? "excavation or earthwork" : cluster === "framing" ? "framing or lumber" : cluster === "roofing" ? "roofing" : cluster === "flooring" ? "flooring or tile" : cluster === "drywall" ? "drywall, paint or insulation" : cluster === "deck-fence" ? "deck, fence or gate" : cluster === "landscaping" ? "paver, mulch or landscaping" : cluster === "asphalt" ? "asphalt, parking-lot or road-base" : "construction"} calculator</h2>
            <p class="mt-2 text-[13px] leading-5 text-body">These pages target different estimating tasks. Pick the one that matches the decision you are making instead of repeating the same inputs across several calculators.</p>
            <div class="mt-4 grid gap-3 sm:grid-cols-2">
              {taskLinks.map((item) => (
                <a href={item.href} class="rounded-lg border border-hairline bg-white p-3 transition hover:border-hairline-strong/30 hover:shadow-card">
                  <span class="text-[13px] font-semibold text-link">{item.label}</span>
                  <span class="mt-1 block text-xs leading-5 text-body">{item.text}</span>
                </a>
              ))}
            </div>
          </section>
        )}

        <div class="mt-8 space-y-8">
          {groups.map((group) => {
            const calcs = group.slugs
              .map((s) => calculators.find((c) => c.slug === s))
              .filter(Boolean) as typeof calculators;
            if (!calcs.length) return null;
            return (
              <div>
                <h2 class="font-mono text-[11px] font-medium tracking-[0.10em] uppercase text-mute">{group.name}</h2>
                <div class="mt-3 grid gap-3 sm:grid-cols-2">
                  {calcs.map((c) => (
                    <a
                      href={`/${c.slug}/`}
                      class="group flex h-full flex-col rounded-xl border border-hairline bg-white p-4 shadow-card transition hover:border-hairline-strong/30 hover:shadow-card-hover hover:-translate-y-[1px] focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-link"
                    >
                      <h3 class="line-clamp-1 text-[14px] font-semibold tracking-[-0.01em] text-ink group-hover:text-link">{c.h1}</h3>
                      <p class="mt-1 line-clamp-2 flex-1 text-xs leading-5 text-body">{c.description}</p>
                      <span class="mt-3 inline-flex items-center gap-1 font-mono text-[11px] tracking-wide text-mute group-hover:text-ink">Open <span aria-hidden="true">→</span></span>
                    </a>
                  ))}
                </div>
              </div>
            );
          })}
        </div>

        {content?.tips && content.tips.length > 0 && (
          <div class="mt-10 rounded-xl border border-hairline bg-canvas p-5">
            <p class="font-mono text-[11px] font-medium tracking-[0.10em] uppercase text-mute">Tips & common mistakes</p>
            <ul class="mt-3 list-disc space-y-2 pl-5 text-[13.5px] leading-6 text-body [text-wrap:pretty]">
              {content.tips.map((tip) => (
                <li>{tip}</li>
              ))}
            </ul>
          </div>
        )}

        {content?.relatedCategories && content.relatedCategories.length > 0 && (
          <div class="mt-10 rounded-xl border border-hairline bg-[#fcfcfc] p-5">
            <p class="font-mono text-[11px] font-medium tracking-[0.10em] uppercase text-mute">Related categories</p>
            <ul class="mt-3 space-y-2 text-[13.5px]">
              {content.relatedCategories.map((rel) => (
                <li>
                  <a href={rel.href} class="font-medium text-link underline-offset-2 hover:underline">{rel.name}</a>
                  <span class="text-mute"> — {rel.reason}</span>
                </li>
              ))}
            </ul>
          </div>
        )}

        <div class="mt-10 rounded-xl border border-hairline bg-canvas p-5">
          <h2 class="text-sm font-semibold text-ink">More ways to browse</h2>
          <div class="mt-3 flex flex-wrap gap-2">
            <a href="/construction/" class="rounded-full border border-hairline bg-white px-3 py-1.5 font-mono text-xs text-mute hover:text-ink">All categories</a>
            <a href="/calculators/" class="rounded-full border border-hairline bg-white px-3 py-1.5 font-mono text-xs text-mute hover:text-ink">All calculators</a>
          </div>
        </div>
      </div>
    </section>
  </main>
  <Footer slot="footer" />
</Layout>
