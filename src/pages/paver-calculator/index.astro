---
import CalculatorLayout from "../../components/CalculatorLayout.astro";
import Header from "../../components/Header.astro";
import Footer from "../../components/Footer.astro";
import GenericCalculator from "../../components/calculators/GenericCalculator.astro";

const related = [
  { title: "Paver Base Calculator", href: "/paver-base-calculator/", desc: "Base aggregate yards & tons" },
  { title: "Paver Sand Calculator", href: "/paver-sand-calculator/", desc: "Bedding sand volume & weight" },
  { title: "Paver Joint Sand Calculator", href: "/paver-joint-sand-calculator/", desc: "Joint fill volume & bags" },
  { title: "Paver Cost Calculator", href: "/paver-cost-calculator/", desc: "Price a known paver material quantity" },
];

const faq = [
  {
    q: "How does the paver count work?",
    a: "The calculator lays a straight rectangular grid across the entered length and width. It divides by the paver face dimensions plus the entered joint width, rounds rows and columns up to whole pavers, then applies the purchasing allowance and rounds once more."
  },
  {
    q: "Does the paver calculator include base gravel and bedding sand?",
    a: "No. This page is intentionally focused on surface paver layout and purchasing quantity. Use the dedicated Paver Base and Paver Sand calculators so each layer can use its own specified depth, material density and price."
  },
  {
    q: "Does it optimize cuts or laying patterns?",
    a: "No. The model assumes one paver orientation in a straight rectangular grid. Curves, borders, herringbone patterns, soldier courses and offcut reuse can change the real quantity."
  },
  {
    q: "What paver size and joint width should I enter?",
    a: "Use the actual face dimensions and intended installed joint width for the selected paver system. Manufacturer dimensions and project specifications are more reliable than a generic nominal size."
  }
];
---

<CalculatorLayout
  title="Paver Calculator — Paver Count, Rows, Columns & Cost"
  description="Estimate straight-layout paver rows, columns, installed pavers and order quantity from area dimensions, paver size, joint width and purchasing allowance."
  h1="Paver Calculator"
  intro="Calculate a straight rectangular paver layout from the measured area, actual paver face size and intended joint width. See installed rows and columns, whole pavers to order, spare quantity and optional per-paver material cost."
  breadcrumbs={[
    { label: "Home", href: "/" },
    { label: "Construction", href: "/construction/" },
    { label: "Paver & Landscaping Calculators", href: "/construction/landscaping/" },
    { label: "Paver Calculator" },
  ]}
  related={related}
  faq={faq}
  canonical="/paver-calculator/"
  ogImage="/og-paver.png"
  datePublished="2026-08-27"
  dateModified="2026-09-25"
>
  <Header slot="header" />
  <GenericCalculator id="paver-calculator" resultTitle="Paver Estimate" slot="calculator" />

  <section class="space-y-6">
    <div class="rounded-lg border border-hairline bg-canvas p-6">
      <h2 class="text-display-sm font-semibold tracking-[-0.03em] text-ink">How it works</h2>
      <ol class="mt-3 list-decimal space-y-2 pl-5 text-sm leading-6 text-body">
        <li>Normalize area length, area width, paver face dimensions and joint width to consistent units.</li>
        <li><span class="font-mono text-xs">Rows = ceil((area width + joint) ÷ (paver width + joint))</span></li>
        <li><span class="font-mono text-xs">Columns = ceil((area length + joint) ÷ (paver length + joint))</span></li>
        <li><span class="font-mono text-xs">Installed pavers = rows × columns</span></li>
        <li>Apply the entered purchasing allowance to the installed count and round up to whole pavers.</li>
      </ol>
    </div>

    <div class="rounded-lg border border-hairline bg-canvas p-6">
      <h2 class="text-display-sm font-semibold tracking-[-0.03em] text-ink">What this page intentionally keeps separate</h2>
      <p class="mt-2 text-sm leading-6 text-body">
        Base aggregate, bedding sand and joint sand are separate materials with different depths, densities and product coverage. Use their dedicated calculators rather than applying one shared paver allowance or density to every layer.
      </p>
    </div>

    <div class="rounded-lg border border-hairline bg-canvas p-6">
      <h2 class="text-display-sm font-semibold tracking-[-0.03em] text-ink">Example</h2>
      <p class="mt-2 text-sm leading-6 text-body">
        A 20 × 10 ft rectangle using 12 × 12 in pavers with a zero-width layout joint has 20 columns × 10 rows = 200 installed pavers. A 10% purchasing allowance gives 220 pavers to order.
      </p>
    </div>
  </section>
  <Footer slot="footer" />
</CalculatorLayout>
