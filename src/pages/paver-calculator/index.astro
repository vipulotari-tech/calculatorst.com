---
import CalculatorLayout from "../../components/CalculatorLayout.astro";
import Header from "../../components/Header.astro";
import Footer from "../../components/Footer.astro";
import PaverCalculator from "../../components/calculators/PaverCalculator.astro";

const related = [
  { title: "Gravel Calculator", href: "/gravel-calculator/", desc: "Base gravel details" },
  { title: "Concrete Slab Calculator", href: "/concrete-slab-calculator/", desc: "Poured alternative" },
  { title: "Mulch Calculator", href: "/mulch-calculator/", desc: "For adjacent beds" },
  { title: "Deck Calculator", href: "/deck-calculator/", desc: "Raised vs paver" },
];
const faq = [
  {
    "q": "How many pavers do I need?",
    "a": "The base count is ceil(patio area ÷ paver area). The order count is ceil((patio area ÷ paver area) × (1 + waste ÷ 100)); waste is applied before rounding. For 200 ft² and 12 × 12 inch pavers, 10% waste gives 220 pavers."
  },
  {
    "q": "How are base and sand calculated?",
    "a": "Each layer volume is patio area × entered depth, converted to cubic yards and multiplied by the waste factor. Enter zero depth to omit a layer. The calculator does not select a required depth or apply a separate compaction factor."
  },
  {
    "q": "Does this calculate a laying pattern?",
    "a": "No. It is an area-based takeoff for rectangular pavers, without joint spacing or cut optimization. Curves and patterns require a separate layout. Split irregular shapes into measured sections; a circle's bounding square is not its actual area."
  },
  {
    "q": "Does this include patio cost?",
    "a": "This form calculates quantities only. Multiply the paver order count by your supplier's unit quote and price base, sand, edging, delivery and labor separately."
  }
];
---

<CalculatorLayout
  title="Paver Calculator — Pavers, Base & Sand (2026)"
  description="Calculate pavers for patios & walkways. Enter area & paver size to get paver count, base gravel & sand in cubic yards with waste."
  h1="Paver Calculator"
  intro="Calculate pavers for patios and walkways — get paver count, base gravel and bedding sand with waste. Enter area, paver size, base & sand depth — instant cubic yards."
  breadcrumbs={[{ label: "Home", href: "/" }, { label: "Construction", href: "/construction/" }, { label: "Landscaping Calculators", href: "/construction/landscaping/" }, { label: "Paver Calculator" }]}
  related={related}
  faq={faq}
  canonical="/paver-calculator/"
  ogImage="/og-paver.png"
  datePublished="2026-08-27"
  dateModified="2026-09-24"
>
  <Header slot="header" />
  <PaverCalculator slot="calculator" />
  <section class="space-y-6">
    <div class="rounded-lg border border-hairline bg-canvas p-6">
      <h2 class="text-display-sm font-semibold tracking-[-0.03em] text-ink">How it works</h2>
      <ol class="mt-3 list-decimal space-y-1 pl-5 text-sm leading-6 text-body">
        <li>Area = Length × Width</li>
        <li>Order pavers = ceil(area ÷ (paver length × paver width) × (1 + waste ÷ 100))</li>
        <li>Base gravel yd³ = area × base depth ÷ 27</li>
        <li>Sand yd³ = area × sand depth ÷ 27 (both × waste)</li>
      </ol>
    </div>
    <div class="rounded-lg border border-hairline bg-canvas p-6">
      <h2 class="text-display-sm font-semibold tracking-[-0.03em] text-ink">Example</h2>
      <p class="mt-2 text-sm leading-6 text-body">Patio 20×10 ft, 12×12 in pavers, 4 in base, 1 in sand, 10% waste:</p>
      <div class="mt-3 overflow-x-auto rounded-md border border-hairline"><table class="w-full text-left text-sm"><thead class="bg-canvas-soft font-mono text-[11px] text-mute"><tr><th class="px-3 py-2">OUTPUT</th><th class="px-3 py-2">VALUE</th></tr></thead><tbody class="divide-y divide-hairline font-mono tabular-nums"><tr><td class="px-3 py-2">Area</td><td class="px-3 py-2">200 ft²</td></tr><tr><td class="px-3 py-2">Pavers</td><td class="px-3 py-2">200 → 220 w/ waste</td></tr><tr><td class="px-3 py-2">Base</td><td class="px-3 py-2">2.47 yd³ → 2.72 w/ waste</td></tr><tr><td class="px-3 py-2">Sand</td><td class="px-3 py-2">0.62 → 0.68 yd³</td></tr></tbody></table></div>
    </div>
    <div class="rounded-lg border border-hairline bg-canvas p-6">
      <h2 class="text-display-sm font-semibold tracking-[-0.03em] text-ink">Assumptions</h2>
      <ul class="mt-3 list-disc space-y-2 pl-5 text-sm leading-6 text-body"><li>Rectangular area; cuts add waste.</li><li>Entered layer depths; no separate compaction factor is applied.</li><li>Paver area excludes joints; laying pattern and cuts are not optimized.</li></ul>
    </div>
  </section>
  <Footer slot="footer" />
</CalculatorLayout>
