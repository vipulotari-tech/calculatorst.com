---
import CalculatorLayout from "../../components/CalculatorLayout.astro";
import Header from "../../components/Header.astro";
import Footer from "../../components/Footer.astro";
import GravelCalculator from "../../components/calculators/GravelCalculator.astro";

const related = [
  { title: "Crushed Stone Calculator", href: "/crushed-stone-calculator/", desc: "Crushed stone for patios & paths" },
  { title: "Gravel Depth Calculator", href: "/gravel-depth-calculator/", desc: "Depth for paths and driveways" },
  { title: "Paver Calculator", href: "/paver-calculator/", desc: "Pavers + base & sand" },
  { title: "Mulch Calculator", href: "/mulch-calculator/", desc: "Bulk yards & bags" },
];

const faq = [
  {
    "q": "How is gravel quantity calculated?",
    "a": "Length × width × depth gives cubic feet after unit conversion. Divide by 27 for cubic yards, then multiply by the selected density in US short tons per cubic yard. One short ton is 2,000 lb."
  },
  {
    "q": "Which density should I use?",
    "a": "The material choices are estimate presets: pea gravel 1.35, crushed stone 1.40, river rock 1.33, limestone 1.60 and granite 1.42 short tons/yd³. Choose Custom for a supplier-provided density; actual material can differ."
  },
  {
    "q": "How is cost calculated?",
    "a": "The calculator prices the final order quantity after the separate compaction allowance and waste allowance. You can price by cubic yard, cubic meter or US ton; displayed values are rounded, so the internal unrounded result is used for cost."
  },
  {
    "q": "How should I measure an irregular area?",
    "a": "Split it into non-overlapping measured shapes and calculate their volumes separately. A bounding rectangle overestimates a curved area; increasing waste cannot correct that geometry."
  },
  {
    "q": "How are compaction and waste handled?",
    "a": "They are separate inputs. Compaction allowance adds extra loose material for the placed layer, then waste/overrun is applied to that adjusted quantity. Use supplier or project guidance rather than assuming one universal compaction percentage."
  }
];
---

<CalculatorLayout
  title="Gravel Calculator — Yards, Tons, Metric Volume & Cost"
  description="Calculate gravel in cubic yards, cubic meters, US tons and metric tonnes with material density presets, separate compaction and waste allowances, plus optional cost."
  h1="Gravel Calculator"
  intro="Calculate gravel for any rectangular area with material density presets, separate compaction and waste allowances, metric and US outputs, and optional pricing by cubic yard, cubic meter or ton."
  breadcrumbs={[
    { label: "Home", href: "/" },
    { label: "Construction", href: "/construction/" },
    { label: "Gravel Calculators", href: "/construction/gravel/" },
    { label: "Gravel Calculator" },
  ]}
  related={related}
  faq={faq}
  canonical="/gravel-calculator/"
  ogImage="/og-gravel.png"
  datePublished="2026-08-27"
  dateModified="2026-09-24"
>
  <Header slot="header" />
  <GravelCalculator slot="calculator" />

  <section class="space-y-6">
    <div class="rounded-lg border border-hairline bg-canvas p-6 ">
      <h2 class="text-display-sm font-semibold tracking-[-0.03em] text-ink">How it works</h2>
      <p class="mt-2 text-sm leading-6 text-body [text-wrap:pretty]">We compute the rectangular volume and convert units to feet before any math. Then we convert to cubic yards and weight using the selected or custom density. Compaction allowance is applied separately before waste so the purchasing assumptions remain transparent.</p>
      <ol class="mt-4 list-decimal space-y-1 pl-5 text-sm leading-6 text-body" role="list">
        <li>Convert length, width and depth to <span class="font-medium text-ink">feet</span> (inches ÷ 12, yards × 3, meters ÷ 0.3048).</li>
        <li><span class="font-mono text-xs">Cubic Feet = Length × Width × Depth</span></li>
        <li><span class="font-mono text-xs">Cubic Yards = Cubic Feet ÷ 27</span></li>
        <li><span class="font-mono text-xs">Weight = Cubic Yards × Tons per yd³ × 2000</span> (lb)</li>
        <li>Apply compaction allowance, then waste: <span class="font-mono text-xs">× (1 + compaction%) × (1 + waste%)</span>. Cost can use price per yd³, m³ or US ton.</li>
      </ol>
    </div>

    <div class="rounded-lg border border-hairline bg-canvas p-6 ">
      <h2 class="text-display-sm font-semibold tracking-[-0.03em] text-ink">Formula</h2>
      <div class="mt-3 rounded-md border border-hairline bg-canvas-soft-2 p-4 font-mono text-sm leading-6 ">
        <p>Cubic Feet = L(ft) × W(ft) × D(ft)</p>
        <p>Cubic Yards = Cubic Feet ÷ 27</p>
        <p>Tons = Cubic Yards × Density (tons/yd³)</p>
        <p>Pounds = Tons × 2000</p>
      </div>
      <p class="mt-3 text-sm leading-6 text-body">Densities used: Pea Gravel 1.35, Crushed Stone 1.40, River Rock 1.33, Limestone 1.60, Granite 1.42 tons/yd³. Ask your supplier — actual bulk density varies.</p>
    </div>

    <div class="rounded-lg border border-hairline bg-canvas p-6 ">
      <h2 class="text-display-sm font-semibold tracking-[-0.03em] text-ink">Example calculation</h2>
      <p class="mt-2 text-sm leading-6 text-body">Patio 20 ft × 10 ft × 4 in pea gravel, 10% waste, $48/yd³:</p>
      <div class="mt-3 overflow-x-auto rounded-md border border-hairline">
        <table class="w-full text-left text-sm">
          <thead class="bg-canvas-soft font-mono text-[11px] tracking-widest text-mute"><tr><th class="px-3 py-2">STEP</th><th class="px-3 py-2">VALUE</th></tr></thead>
          <tbody class="divide-y divide-hairline">
            <tr><td class="px-3 py-2 text-body">Depth in feet</td><td class="px-3 py-2 font-mono tabular-nums text-ink">4 in ÷ 12 = 0.333 ft</td></tr>
            <tr><td class="px-3 py-2 text-body">Cubic feet</td><td class="px-3 py-2 font-mono tabular-nums text-ink">20 × 10 × (4 ÷ 12) ≈ 66.67 ft³</td></tr>
            <tr><td class="px-3 py-2 text-body">Cubic yards</td><td class="px-3 py-2 font-mono tabular-nums text-ink">66.67 ÷ 27 = 2.47 yd³</td></tr>
            <tr><td class="px-3 py-2 text-body">Tons</td><td class="px-3 py-2 font-mono tabular-nums text-ink">2.47 × 1.35 = 3.33 tons</td></tr>
            <tr><td class="px-3 py-2 text-body">With 10% waste</td><td class="px-3 py-2 font-mono tabular-nums text-ink">2.72 yd³ · 3.67 tons</td></tr>
            <tr><td class="px-3 py-2 text-body">Cost</td><td class="px-3 py-2 font-mono tabular-nums text-ink">(66.666… ÷ 27 × 1.10) × $48 = $130.37</td></tr>
          </tbody>
        </table>
      </div>
    </div>

    <div class="rounded-lg border border-hairline bg-canvas p-6 ">
      <h2 class="text-display-sm font-semibold tracking-[-0.03em] text-ink">Reference — coverage per ton (approx.)</h2>
      <div class="mt-3 overflow-x-auto rounded-md border border-hairline">
        <table class="w-full text-left text-sm">
          <thead class="bg-canvas-soft font-mono text-[11px] tracking-widest text-mute"><tr><th class="px-3 py-2">MATERIAL</th><th class="px-3 py-2">TONS/YD³</th><th class="px-3 py-2">LB/FT³</th><th class="px-3 py-2">COVERAGE @ 3" (ft²/ton)</th></tr></thead>
          <tbody class="divide-y divide-hairline font-mono tabular-nums">
            <tr><td class="px-3 py-2 text-ink">Pea Gravel</td><td class="px-3 py-2">1.35</td><td class="px-3 py-2">100</td><td class="px-3 py-2">80</td></tr>
            <tr><td class="px-3 py-2 text-ink">Crushed Stone</td><td class="px-3 py-2">1.40</td><td class="px-3 py-2">104</td><td class="px-3 py-2">77</td></tr>
            <tr><td class="px-3 py-2 text-ink">River Rock</td><td class="px-3 py-2">1.33</td><td class="px-3 py-2">99</td><td class="px-3 py-2">81</td></tr>
            <tr><td class="px-3 py-2 text-ink">Limestone</td><td class="px-3 py-2">1.60</td><td class="px-3 py-2">119</td><td class="px-3 py-2">67</td></tr>
            <tr><td class="px-3 py-2 text-ink">Granite</td><td class="px-3 py-2">1.42</td><td class="px-3 py-2">105</td><td class="px-3 py-2">76</td></tr>
          </tbody>
        </table>
      </div>
      <p class="mt-2 font-mono text-[11px] leading-4 text-mute">Coverage = 2000 ÷ (lb/ft³ × depth in feet). Confirm with scale house.</p>
    </div>

    <div class="rounded-lg border border-hairline bg-canvas p-6 ">
      <h2 class="text-display-sm font-semibold tracking-[-0.03em] text-ink">Assumptions & limits</h2>
      <ul class="mt-3 list-disc space-y-2 pl-5 text-sm leading-6 text-body">
        <li>Rectangular area; calculate irregular shapes as separate measured sections.</li>
        <li>Uniform depth — add base layer separately if needed.</li>
        <li>Compaction allowance and waste are separate purchasing assumptions. Use supplier/project information for the loose-to-placed relationship.</li>
        <li>US units default — metric converts to feet; final tons use short tons (2000 lb). For metric tonnes, multiply tons × 0.907.</li>
      </ul>
    </div>
  </section>

  <Footer slot="footer" />
</CalculatorLayout>
