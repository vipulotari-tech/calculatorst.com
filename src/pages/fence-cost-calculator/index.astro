---
import CalculatorLayout from "../../components/CalculatorLayout.astro";
import Header from "../../components/Header.astro";
import Footer from "../../components/Footer.astro";
import FenceCostCalculator from "../../components/calculators/FenceCostCalculator.astro";

const related = [
  { title: "Paver Calculator", href: "/paver-calculator/", desc: "For paver patios & edges" },
  { title: "Gravel Calculator", href: "/gravel-calculator/", desc: "Drainage gravel for posts" },
  { title: "Concrete Slab Calculator", href: "/concrete-slab-calculator/", desc: "Footings & posts" },
  { title: "Deck Calculator", href: "/deck-calculator/", desc: "Decks vs fences" },
];
const faq = [
  { q: "How are posts and panels counted?", a: "Gates divide the remaining fence into equal-length runs. Each run needs ceil(run length ÷ spacing) panels and one more post than panels; shared gate-end posts are counted once, so total installed posts = runs × (panels per run + 1) − gates. For unequal runs, calculate each separately with zero gates and count shared posts only once." },
  { q: "What does the cost estimate include?", a: "Only the selected material at your entered quote: fence length, panels, or posts, including the entered waste. Gates, hardware, concrete, labor and other materials are separate. Obtain current supplier quotes for your project." },
  { q: "How is concrete calculated?", a: "Concrete equals installed posts × filled hole depth × (circular hole area − square post area). Waste is then added and the total is divided by your bag yield, rounded up. Spare posts do not create additional holes. Hole dimensions are example inputs; confirm your actual footing requirements." },
  { q: "How do I use chain link mode?", a: "Chain link reports fabric length and one top rail. Per-panel pricing does not apply. Enter the relevant fabric price per foot or a post price to estimate that selected material." },
  { q: "What does waste cover?", a: "The entered percentage increases ordering quantities. It does not replace a layout, supplier specification, footing design or itemized installation quote." },
];
---

<CalculatorLayout
  title="Fence Cost Calculator — Posts, Panels & Gates"
  description="Calculate fence cost — posts, panels & gate openings. Enter length, height, spacing & rails to get posts, panels, area & cost for wood, vinyl & chain link."
  h1="Fence Cost Calculator"
  intro="Calculate fence cost — get posts, panels, gate openings & concrete with waste & cost. Enter length, height, material, spacing & gates — instant posts, panels & price."
  breadcrumbs={[{ label: "Home", href: "/" }, { label: "Construction", href: "/construction/" }, { label: "Deck & Fence Calculators", href: "/construction/deck-fence/" }, { label: "Fence Cost Calculator" }]}
  related={related}
  faq={faq}
  canonical="/fence-cost-calculator/"
  ogImage="/og-fence.png"
  datePublished="2026-08-27"
  dateModified="2026-09-24"
>
  <Header slot="header" />
  <FenceCostCalculator slot="calculator" />
  <section class="space-y-6">
    <div class="rounded-lg border border-hairline bg-canvas p-6">
      <h2 class="text-display-sm font-semibold tracking-[-0.03em] text-ink">How it works</h2>
      <ol class="mt-3 list-decimal space-y-1 pl-5 text-sm leading-6 text-body">
        <li>Effective length = total length − gates × gate width</li>
        <li>Runs = gates + 1; panels per run = ceil(effective ÷ runs ÷ spacing); panels = runs × panels per run; installed posts = runs × (panels per run + 1) − gates</li>
        <li>Panels = sections, using panels compatible with the entered spacing</li>
        <li>Linear rails = effective × rails per bay (one top rail for chain link)</li>
        <li>Area = effective length × height. Concrete uses the entered hole diameter, fill depth, post width and bag yield.</li>
      </ol>
    </div>
    <div class="rounded-lg border border-hairline bg-canvas p-6">
      <h2 class="text-display-sm font-semibold tracking-[-0.03em] text-ink">Example</h2>
      <p class="mt-2 text-sm leading-6 text-body">100 ft wood fence, 6 ft high, 8 ft spacing, one centered 4 ft gate (two equal 48 ft runs), 2 rails, 10% waste:</p>
      <div class="mt-3 overflow-x-auto rounded-md border border-hairline"><table class="w-full text-left text-sm"><thead class="bg-canvas-soft font-mono text-[11px] text-mute"><tr><th class="px-3 py-2">OUTPUT</th><th class="px-3 py-2">VALUE</th></tr></thead><tbody class="divide-y divide-hairline font-mono tabular-nums"><tr><td class="px-3 py-2">Effective</td><td class="px-3 py-2">96 ft</td></tr><tr><td class="px-3 py-2">Posts</td><td class="px-3 py-2">13 → 15 w/ waste</td></tr><tr><td class="px-3 py-2">Panels (8 ft)</td><td class="px-3 py-2">12 → 14 w/ waste</td></tr><tr><td class="px-3 py-2">Rails</td><td class="px-3 py-2">192 lin ft → 211.2 w/ waste</td></tr><tr><td class="px-3 py-2">Area</td><td class="px-3 py-2">576 ft²</td></tr></tbody></table></div>
    </div>
    <div class="rounded-lg border border-hairline bg-canvas p-6">
      <h2 class="text-display-sm font-semibold tracking-[-0.03em] text-ink">Assumptions</h2>
      <ul class="mt-3 list-disc space-y-2 pl-5 text-sm leading-6 text-body"><li>Flat terrain. Slopes add posts.</li><li>Gates are pre-hung; hardware extra.</li><li>Enter spacing compatible with your panel width; waste does not correct incompatible panels.</li><li>Price per foot/panel/post as entered — we multiply by waste-adjusted count.</li></ul>
    </div>
  </section>
  <Footer slot="footer" />
</CalculatorLayout>
