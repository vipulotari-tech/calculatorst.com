---
import CalculatorLayout from "../../components/CalculatorLayout.astro";
import Header from "../../components/Header.astro";
import Footer from "../../components/Footer.astro";
import DeckMaterialCalculator from "../../components/calculators/DeckMaterialCalculator.astro";

const related = [
  { title: "Deck Calculator", href: "/deck-calculator/", desc: "Boards, joists & cost" },
  { title: "Deck Board Calculator", href: "/deck-board-calculator/", desc: "Boards per area" },
  { title: "Deck Joist Calculator", href: "/deck-joist-calculator/", desc: "Joist spacing & count" },
  { title: "Paver Calculator", href: "/paver-calculator/", desc: "Paver alternative" },
];
const faq = [
  {
    "q": "How are deck boards counted?",
    "a": "Rows = ceil((deck width + gap) ÷ (board width + gap)). Boards per row = ceil(deck length ÷ stock board length). Multiply these counts, apply the entered waste percentage and round up. Dimensions must use the same unit."
  },
  {
    "q": "How are joists and fasteners estimated?",
    "a": "Joists = ceil(deck length ÷ joist spacing) + 1. Fasteners = rows × 2 × (joists + boards per row − 1), allowing two fasteners at intersections and both ends at butt joints. This quantity estimate assumes supported joints; it does not design the framing."
  },
  {
    "q": "Which gap and spacing should I enter?",
    "a": "Use the decking manufacturer's requirements for your material and layout. A zero gap is accepted. The calculator does not select structural spans or installation requirements."
  },
  {
    "q": "What does the cost include?",
    "a": "Deck boards only. Per-board pricing uses the rounded order count; per-linear-foot pricing uses that count × stock board length. Joists, hardware, labor and delivery are separate."
  }
];
---

<CalculatorLayout
  title="Deck Material Calculator — Boards, Joists & Cost (2026)"
  description="Calculate deck boards, joists, fasteners & cost. Enter deck size, board dimensions, gap & joist spacing — get boards, linear feet & price with waste."
  h1="Deck Material Calculator"
  intro="Calculate deck materials — get board count, linear feet, joists & cost with waste. Enter length, width, board size, gap & spacing — instant estimate."
  breadcrumbs={[{ label: "Home", href: "/" }, { label: "Construction", href: "/construction/" }, { label: "Deck & Fence", href: "/construction/deck-fence/" }, { label: "Deck Material Calculator" }]}
  related={related}
  faq={faq}
  canonical="/deck-material-calculator/"
  ogImage="/og-deck.png"
  datePublished="2026-08-27"
  dateModified="2026-09-15"
>
  <Header slot="header" />
  <DeckMaterialCalculator slot="calculator" />
  <section class="space-y-6">
    <div class="rounded-lg border border-hairline bg-canvas p-6">
      <h2 class="text-display-sm font-semibold tracking-[-0.03em] text-ink">How it works</h2>
      <ol class="mt-3 list-decimal space-y-1 pl-5 text-sm leading-6 text-body">
        <li>Effective board width = board width + gap</li>
        <li>Rows = ceil((deck width + gap) ÷ effective width)</li>
        <li>Boards per row = ceil(deck length ÷ board length)</li>
        <li>Boards = rows × boards per row, Joists = ceil(length ÷ spacing) + 1</li>
        <li>Waste boards = ceil(boards × (1 + waste%))</li>
      </ol>
    </div>
    <div class="rounded-lg border border-hairline bg-canvas p-6">
      <h2 class="text-display-sm font-semibold tracking-[-0.03em] text-ink">Example</h2>
      <p class="mt-2 text-sm leading-6 text-body">Deck 16×12 ft, 5.5 in boards, 16 ft long, 1/8 in gap, 16 in joists, 10% waste:</p>
      <div class="mt-3 overflow-x-auto rounded-md border border-hairline"><table class="w-full text-left text-sm"><thead class="bg-canvas-soft font-mono text-[11px] text-mute"><tr><th class="px-3 py-2">OUTPUT</th><th class="px-3 py-2">VALUE</th></tr></thead><tbody class="divide-y divide-hairline font-mono tabular-nums"><tr><td class="px-3 py-2">Effective width</td><td class="px-3 py-2">5.625 in</td></tr><tr><td class="px-3 py-2">Boards</td><td class="px-3 py-2">26 → 29 w/ waste</td></tr><tr><td class="px-3 py-2">Linear feet</td><td class="px-3 py-2">416 ft</td></tr><tr><td class="px-3 py-2">Joists</td><td class="px-3 py-2">13</td></tr></tbody></table></div>
    </div>
    <div class="rounded-lg border border-hairline bg-canvas p-6">
      <h2 class="text-display-sm font-semibold tracking-[-0.03em] text-ink">Assumptions</h2>
      <ul class="mt-3 list-disc space-y-2 pl-5 text-sm leading-6 text-body"><li>Rectangular deck, boards run along length.</li><li>Gap uniform, joists perpendicular to boards.</li><li>Fasteners = rows × 2 × (joists + boards per row − 1); joints must be supported.</li></ul>
    </div>
  </section>
  <Footer slot="footer" />
</CalculatorLayout>
