---
import CalculatorLayout from "../../components/CalculatorLayout.astro";
import Header from "../../components/Header.astro";
import Footer from "../../components/Footer.astro";
import GenericCalculator from "../../components/calculators/GenericCalculator.astro";

const related = [
  { title: "Concrete Calculator", href: "/concrete-calculator/", desc: "Broad concrete volume, bags, weight and cost estimate" },
  { title: "Slab Reinforcement Calculator", href: "/slab-reinforcement-calculator/", desc: "Estimate reinforcement layout after slab dimensions are known" },
  { title: "Gravel Calculator", href: "/gravel-calculator/", desc: "Estimate compacted base material below the slab" },
  { title: "Slab Cost Calculator", href: "/slab-cost-calculator/", desc: "Estimate slab material cost from order quantity and quoted price" },
  { title: "Driveway Concrete Calculator", href: "/driveway-concrete-calculator/", desc: "Dedicated driveway concrete quantity estimate" },
  { title: "Patio Concrete Calculator", href: "/patio-concrete-calculator/", desc: "Dedicated patio concrete quantity estimate" },
];
const faq = [
  {
    "q": "How is slab volume calculated?",
    "a": "Convert dimensions to feet, then multiply length × width × thickness × number of identical slabs. Divide cubic feet by 27 for cubic yards. Apply the entered waste percentage to the unrounded volume."
  },
  {
    "q": "How are concrete bags counted?",
    "a": "The calculator uses comparison yields of 0.60 ft³ for an 80-lb bag, 0.45 ft³ for a 60-lb bag, 0.375 ft³ for a 50-lb bag and 0.30 ft³ for a 40-lb bag. Divide waste-adjusted volume by the selected yield and round up. Verify the yield on your actual product."
  },
  {
    "q": "How does material pricing work?",
    "a": "A per-yard quote uses waste-adjusted cubic yards. A per-bag quote uses the rounded count for the selected bag size. Delivery, reinforcement, formwork and labor are separate."
  },
  {
    "q": "How much concrete does a 12 × 10 ft slab at 4 inches need?",
    "a": "The geometric volume is 40 ft³, or about 1.48 yd³. With a 10% allowance the calculator shows about 1.63 yd³, before any supplier-specific order rounding."
  },
  {
    "q": "Should I use this slab calculator or the general Concrete Calculator?",
    "a": "Use this page when the project is specifically a slab and you want square feet, bag counts and slab-focused ordering output. Use the general Concrete Calculator when the pour shape may be a wall, footing or cylinder."
  },
  {
    "q": "How are thickened slab edges estimated?",
    "a": "Enter both the total edge depth and edge width. The calculator adds a perimeter-band volume based on the extra depth below the field slab. This is a planning approximation; use the actual structural edge or footing detail when its shape extends beyond the slab footprint."
  },
  {
    "q": "Can I include a gravel subbase?",
    "a": "Yes. Enter an optional gravel subbase depth to estimate compacted in-place cubic yards below the slab. Delivered loose aggregate can be higher, so apply the supplier's compaction or swell factor separately."
  },
  {
    "q": "How does supplier order rounding work?",
    "a": "Enter the supplier's ready-mix order increment, such as 0.25 yd³, and the calculator rounds the waste-adjusted order up to that increment. Leave the field at 0 when your supplier does not require an increment or you do not know it yet."
  },
  {
    "q": "Can this design a slab?",
    "a": "No. This is a quantity estimate. Slab thickness, reinforcement, joints, vapor control and subbase requirements must be determined from the project requirements or a qualified designer."
  }
];
---

<CalculatorLayout
  title="Concrete Slab Calculator — Yards, Bags, Cost & Thickened Edges"
  description="Calculate rectangular or circular slab concrete, 40/50/60/80-lb bags, waste, weight, thickened edges, gravel base and supplier-rounded ready-mix quantity."
  h1="Concrete Slab Calculator"
  intro="Estimate rectangular or circular concrete slabs from finished dimensions and thickness. Get area, form perimeter, cubic feet, cubic yards, 40/50/60/80-lb bags, waste-adjusted order quantity, weight, optional thickened edges, gravel subbase and material cost."
  breadcrumbs={[{ label: "Home", href: "/" }, { label: "Construction", href: "/construction/" }, { label: "Concrete Calculators", href: "/construction/concrete/" }, { label: "Concrete Slab Calculator" }]}
  related={related}
  faq={faq}
  canonical="/concrete-slab-calculator/"
  ogImage="/og-concrete.png"
  datePublished="2026-08-27"
  dateModified="2026-09-27"
>
  <Header slot="header" />
  <GenericCalculator slot="calculator" id="concrete-slab-calculator" resultTitle="CONCRETE SLAB ESTIMATE" />
  <section class="space-y-6">
    <div class="rounded-lg border border-hairline bg-canvas p-6">
      <h2 class="text-display-sm font-semibold tracking-[-0.03em] text-ink">How it works</h2>
      <ol class="mt-3 list-decimal space-y-1 pl-5 text-sm leading-6 text-body">
        <li>Rectangle area = length × width; circle area = π × (diameter ÷ 2)².</li>
        <li>Field concrete = footprint area × slab thickness × number of identical slabs.</li>
        <li>Optional thickened edge adds perimeter × edge width × extra depth below the field slab.</li>
        <li>Waste/material allowance is applied once to the geometric concrete volume.</li>
        <li>Bags = ceil(waste-adjusted cubic feet ÷ mixed yield per bag).</li>
        <li>Optional supplier rounding rounds the waste-adjusted ready-mix order up to the increment you enter.</li>
      </ol>
      <div class="mt-3 rounded-md bg-canvas-soft-2 p-4 font-mono text-sm "><p>Comparison yields: 80-lb = 0.60 ft³, 60-lb = 0.45 ft³, 50-lb = 0.375 ft³, 40-lb = 0.30 ft³. Verify the yield printed on your product.</p></div>
    </div>
    <div class="rounded-lg border border-hairline bg-canvas p-6">
      <h2 class="text-display-sm font-semibold tracking-[-0.03em] text-ink">Slab-specific planning outputs</h2>
      <div class="mt-3 grid gap-3 sm:grid-cols-2">
        <div class="rounded-md border border-hairline bg-canvas-soft p-4"><p class="font-medium text-ink">Area & form perimeter</p><p class="mt-1 text-sm leading-6 text-body">Use the footprint area to cross-check measurements and the total perimeter as a planning quantity for edge forms.</p></div>
        <div class="rounded-md border border-hairline bg-canvas-soft p-4"><p class="font-medium text-ink">40/50/60/80-lb bags</p><p class="mt-1 text-sm leading-6 text-body">Compare standard bag counts alongside the editable mixed-yield result. Whole bags are always rounded up.</p></div>
        <div class="rounded-md border border-hairline bg-canvas-soft p-4"><p class="font-medium text-ink">Thickened edge & gravel base</p><p class="mt-1 text-sm leading-6 text-body">Optionally include a perimeter thickening and compacted subbase volume without mixing those quantities into the field-slab geometry.</p></div>
        <div class="rounded-md border border-hairline bg-canvas-soft p-4"><p class="font-medium text-ink">Supplier order rounding</p><p class="mt-1 text-sm leading-6 text-body">Enter the actual ready-mix increment from your supplier to see the rounded order and how much that rounding adds above the calculated quantity.</p></div>
      </div>
    </div>
    <div class="rounded-lg border border-hairline bg-canvas p-6">
      <h2 class="text-display-sm font-semibold tracking-[-0.03em] text-ink">When to Use This Slab Calculator</h2>
      <ul class="mt-3 list-disc space-y-2 pl-5 text-sm leading-6 text-body">
        <li>Use it for rectangular or circular slabs such as patios, equipment pads, garage floors, sheds and similar uniform field pours.</li>
        <li>Measure the finished concrete dimensions, not the excavation or gravel footprint, unless those dimensions are intentionally the same.</li>
        <li>Use the optional thickened-edge inputs only when you know the edge width and total depth from the project detail. Split more complex stepped or irregular slabs into non-overlapping sections.</li>
        <li>Use the product yield printed on the bag and the actual ready-mix supplier increment when purchasing; displayed defaults are comparison and planning values.</li>
      </ul>
    </div>
    <div class="rounded-lg border border-hairline bg-canvas p-6">
      <h2 class="text-display-sm font-semibold tracking-[-0.03em] text-ink">Example</h2>
      <p class="mt-2 text-sm leading-6 text-body">Patio 12 ft × 10 ft × 4 in, 1 slab, 10% waste:</p>
      <div class="mt-3 overflow-x-auto rounded-md border border-hairline" tabindex="0" role="region" aria-label="Concrete slab worked example results table"><table class="w-full text-left text-sm"><thead class="bg-canvas-soft font-mono text-[11px] text-mute"><tr><th class="px-3 py-2">OUTPUT</th><th class="px-3 py-2">VALUE</th></tr></thead><tbody class="divide-y divide-hairline font-mono tabular-nums"><tr><td class="px-3 py-2">Sq ft</td><td class="px-3 py-2">120</td></tr><tr><td class="px-3 py-2">Cubic ft</td><td class="px-3 py-2">40.00</td></tr><tr><td class="px-3 py-2">Cubic yd</td><td class="px-3 py-2">1.48</td></tr><tr><td class="px-3 py-2">With waste</td><td class="px-3 py-2">1.63 yd³ (44 ft³)</td></tr><tr><td class="px-3 py-2">80-lb bags</td><td class="px-3 py-2">74</td></tr></tbody></table></div>
    </div>
    <div class="rounded-lg border border-hairline bg-canvas p-6">
      <h2 class="text-display-sm font-semibold tracking-[-0.03em] text-ink">Assumptions</h2>
      <ul class="mt-3 list-disc space-y-2 pl-5 text-sm leading-6 text-body"><li>Rectangular and circular slabs are supported directly. Split L-shapes and other irregular footprints into non-overlapping simple sections.</li><li>Optional subbase output is compacted in-place volume; loose delivery quantity depends on the material and supplier compaction factor.</li><li>The thickened-edge calculation is a perimeter-band planning approximation, not a structural design.</li><li>Verify bag yield, ready-mix ordering increment and project dimensions with the product label, supplier and project documents. The entered waste allowance is applied once.</li></ul>
    </div>
  </section>
  <Footer slot="footer" />
</CalculatorLayout>
