---
import CalculatorLayout from "../../components/CalculatorLayout.astro";
import Header from "../../components/Header.astro";
import Footer from "../../components/Footer.astro";
import GenericCalculator from "../../components/calculators/GenericCalculator.astro";

const related = [
  { title: "Landscaping Material Calculator", href: "/landscaping-calculator/", desc: "Generic bagged or bulk landscape material" },
  { title: "Mulch Cost Calculator", href: "/mulch-cost-calculator/", desc: "Price a known mulch material quantity" },
  { title: "Topsoil Calculator", href: "/topsoil-calculator/", desc: "Topsoil volume, weight & cost" },
  { title: "Paver Calculator", href: "/paver-calculator/", desc: "Surface paver layout & count" },
];

const faq = [
  {
    q: "How much mulch is needed?",
    a: "Net volume is length × width × placed depth × identical beds. The calculator converts that volume to cubic yards, applies the purchasing allowance once, and also shows cubic feet and cubic meters."
  },
  {
    q: "How are whole mulch bags calculated?",
    a: "Enter the labeled volume per bag. The allowance-adjusted order volume is divided by that bag volume and rounded up once to a whole-bag count."
  },
  {
    q: "Can I use a bulk-yard price or a bag price?",
    a: "Yes. Choose the matching price basis. Bulk pricing uses the allowance-adjusted cubic-yard quantity; bag pricing uses the rounded whole-bag order."
  },
  {
    q: "Does the calculator choose the correct mulch depth?",
    a: "No. Placed depth is an input because plant, soil, drainage and material needs vary. Use the depth appropriate to the actual project rather than treating a calculator default as a recommendation."
  }
];
---

<CalculatorLayout
  title="Mulch Calculator — Cubic Yards, Bags & Cost"
  description="Estimate mulch in cubic yards and whole bags from bed dimensions, placed depth, identical areas, bag volume, purchasing allowance and optional bulk or bag price."
  h1="Mulch Calculator"
  intro="Calculate mulch for rectangular beds using the placed depth you choose. See net and order volume, whole bags, metric volume and optional cost from either a bulk-yard or per-bag quote."
  breadcrumbs={[
    { label: "Home", href: "/" },
    { label: "Construction", href: "/construction/" },
    { label: "Paver & Landscaping Calculators", href: "/construction/landscaping/" },
    { label: "Mulch Calculator" },
  ]}
  related={related}
  faq={faq}
  canonical="/mulch-calculator/"
  ogImage="/og-mulch.png"
  datePublished="2026-08-27"
  dateModified="2026-09-25"
>
  <Header slot="header" />
  <GenericCalculator id="mulch-calculator" resultTitle="Mulch Estimate" slot="calculator" />

  <section class="space-y-6">
    <div class="rounded-lg border border-hairline bg-canvas p-6">
      <h2 class="text-display-sm font-semibold tracking-[-0.03em] text-ink">How it works</h2>
      <ol class="mt-3 list-decimal space-y-2 pl-5 text-sm leading-6 text-body">
        <li><span class="font-mono text-xs">Net volume = length × width × placed depth × identical beds</span></li>
        <li>Apply the entered purchasing allowance once to the unrounded net volume.</li>
        <li><span class="font-mono text-xs">Whole bags = ceil(order ft³ ÷ labeled bag ft³)</span></li>
        <li>For cost, use either the allowance-adjusted cubic yards or the rounded whole-bag count according to the supplier quote.</li>
      </ol>
    </div>

    <div class="rounded-lg border border-hairline bg-canvas p-6">
      <h2 class="text-display-sm font-semibold tracking-[-0.03em] text-ink">Measurement guidance</h2>
      <p class="mt-2 text-sm leading-6 text-body">
        Split irregular beds into non-overlapping measured rectangles and add the results. The calculator does not automatically add a settling factor or choose a horticultural depth; any extra material should be represented explicitly by the allowance you enter.
      </p>
    </div>
  </section>
  <Footer slot="footer" />
</CalculatorLayout>
