---
import CalculatorLayout from "../../components/CalculatorLayout.astro";
import Header from "../../components/Header.astro";
import Footer from "../../components/Footer.astro";
import RoofSquareFootageCalculator from "../../components/calculators/RoofSquareFootageCalculator.astro";

const related = [
  { title: "Roof Pitch Calculator", href: "/roof-pitch-calculator/", desc: "Pitch ratio & angle" },
  { title: "Roof Area Calculator", href: "/roof-area-calculator/", desc: "True roof area & squares" },
  { title: "Roofing Calculator", href: "/roofing-calculator/", desc: "Shingles & materials" },
  { title: "Gravel Calculator", href: "/gravel-calculator/", desc: "Ground works" },
];
const faq = [
  {
    "q": "How is roof area calculated?",
    "a": "Footprint = (length + 2 × overhang) × (width + 2 × overhang) × identical sections. Multiply by sqrt(1 + (pitch ÷ 12)²) for sloped area. Overhang is a horizontal distance."
  },
  {
    "q": "What is a roofing square?",
    "a": "One roofing square equals 100 ft². The calculator reports area and squares before and after the entered waste allowance; it does not round these into product bundles."
  },
  {
    "q": "How should I enter a complex roof?",
    "a": "The estimate assumes one pitch and rectangular, non-overlapping footprints. Calculate sections with different pitches or overhangs separately. Hips and valleys do not change the multiplier when pitch is unchanged."
  },
  {
    "q": "What does waste include?",
    "a": "Only an increase in area by the percentage you enter. Starter strips, ridge caps, flashing and other components need separate takeoffs; a percentage is not a complete materials list."
  }
];
---

<CalculatorLayout
  title="Roof Square Footage Calculator — Area & Squares (2026)"
  description="Calculate roof square footage and roofing squares. Enter building size, pitch, overhang & waste — get footprint, true area, squares & waste-adjusted total."
  h1="Roof Square Footage Calculator"
  intro="Calculate roof square footage — get true roof area, pitch multiplier, squares & waste. Enter length, width, pitch, overhang & sections — instant roofing estimate."
  breadcrumbs={[{ label: "Home", href: "/" }, { label: "Construction", href: "/construction/" }, { label: "Roofing", href: "/construction/roofing/" }, { label: "Roof Square Footage Calculator" }]}
  related={related}
  faq={faq}
  canonical="/roof-square-footage-calculator/"
  ogImage="/og-roof-pitch.png"
  datePublished="2026-08-27"
  dateModified="2026-09-15"
>
  <Header slot="header" />
  <RoofSquareFootageCalculator slot="calculator" />
  <section class="space-y-6">
    <div class="rounded-lg border border-hairline bg-canvas p-6">
      <h2 class="text-display-sm font-semibold tracking-[-0.03em] text-ink">How it works</h2>
      <ol class="mt-3 list-decimal space-y-1 pl-5 text-sm leading-6 text-body">
        <li>Footprint = (L + 2×overhang) × (W + 2×overhang) × sections</li>
        <li>Multiplier = √(pitch² +144)/12</li>
        <li>Roof area = footprint × multiplier</li>
        <li>Squares = area ÷100, Waste area = area ×(1 + waste%)</li>
      </ol>
    </div>
    <div class="rounded-lg border border-hairline bg-canvas p-6">
      <h2 class="text-display-sm font-semibold tracking-[-0.03em] text-ink">Example</h2>
      <p class="mt-2 text-sm leading-6 text-body">Building 40×30 ft, 6:12 pitch, 1.5 ft overhang, 1 section, 10% waste:</p>
      <div class="mt-3 overflow-x-auto rounded-md border border-hairline"><table class="w-full text-left text-sm"><thead class="bg-canvas-soft font-mono text-[11px] text-mute"><tr><th class="px-3 py-2">OUTPUT</th><th class="px-3 py-2">VALUE</th></tr></thead><tbody class="divide-y divide-hairline font-mono tabular-nums"><tr><td class="px-3 py-2">Footprint</td><td class="px-3 py-2">1,419 ft²</td></tr><tr><td class="px-3 py-2">Multiplier</td><td class="px-3 py-2">1.118</td></tr><tr><td class="px-3 py-2">Roof area</td><td class="px-3 py-2">1,586.5 ft² (15.865 sq)</td></tr><tr><td class="px-3 py-2">With waste</td><td class="px-3 py-2">1,745.1 ft² (17.451 sq)</td></tr></tbody></table></div>
    </div>
    <div class="rounded-lg border border-hairline bg-canvas p-6">
      <h2 class="text-display-sm font-semibold tracking-[-0.03em] text-ink">Assumptions</h2>
      <ul class="mt-3 list-disc space-y-2 pl-5 text-sm leading-6 text-body"><li>Uniform pitch over the measured footprint; different pitches require separate calculations.</li><li>Overhang included on all sides; for gable ends adjust manually.</li><li>1 square =100 ft², waste applied last.</li></ul>
    </div>
  </section>
  <Footer slot="footer" />
</CalculatorLayout>
