---
import Layout from "../../../layouts/Layout.astro";
import Header from "../../../components/Header.astro";
import Footer from "../../../components/Footer.astro";
import Breadcrumbs from "../../../components/Breadcrumbs.astro";
import { hubCalculators } from "../../../data/hubCalculators";
import { clusterGroups } from "../../../data/subcategories";

const cluster = "excavation";
const calculators = hubCalculators.filter(c => c.cluster === cluster);
const groups = clusterGroups[cluster] || [];
const categoryNames: Record<string,string> = {
  concrete: "Concrete Calculators",
  slab: "Slab, Patio & Driveway Calculators",
  foundation: "Foundation & Footing Calculators",
  rebar: "Rebar & Reinforcement Calculators",
  brick: "Brick & Masonry Calculators",
  cmu: "Concrete Block & CMU Calculators",
  mortar: "Mortar, Grout & Cement Calculators",
  gravel: "Gravel, Aggregate & Dirt Calculators",
  excavation: "Excavation & Earthwork Calculators",
  framing: "Framing & Lumber Calculators",
  roofing: "Roofing Calculators",
  flooring: "Flooring & Tile Calculators",
  drywall: "Drywall, Paint & Insulation Calculators",
  "deck-fence": "Deck, Fence & Outdoor Calculators",
  landscaping: "Paver & Landscaping Calculators",
  asphalt: "Asphalt & Surface Calculators",
};
const displayName = categoryNames[cluster] || calculators[0]?.category || "excavation";
---

<Layout title={`${displayName} — Construction Calculators | Calculator Street`} description={`${displayName} — ${calculators.length} tools. ${calculators[0]?.category || ""} calculators with waste and cost. Browse by project group.`} canonical={`/construction/excavation/`}>
  <Header slot="header" />
  <main id="main" tabindex="-1" class="w-full">
    <div class="mx-auto max-w-[1400px] px-6 py-4 max-md:px-4">
      <Breadcrumbs items={[{ label: "Home", href: "/" }, { label: "Construction", href: "/construction/" }, { label: displayName }]} />
    </div>
    <section class="mx-auto max-w-[1400px] px-6 pb-12 max-md:px-4">
      <div class="mx-auto max-w-[900px]">
        <h1 class="text-[28px] font-semibold tracking-[-0.03em] text-ink sm:text-[30px]">{displayName}</h1>
        <p class="mt-3 text-[13.5px] leading-6 text-body [text-wrap:pretty]">Browse ${calculators.length} calculators in this category — organized by project group, with each tool featuring its own formula, worked example and technical diagram. All calculators run 100% in your browser — no backend, no tracking. US customary default with metric where useful.</p>
        <p class="mt-2 font-mono text-xs tracking-wide text-mute">${calculators.length} calculators · ${groups.length} groups</p>

        <div class="mt-8 space-y-8">
          {groups.map(group => {
            const calcs = group.slugs.map(s => calculators.find(c => c.slug === s)).filter(Boolean) as typeof calculators;
            if (!calcs.length) return null;
            return (
              <div>
                <h2 class="font-mono text-[11px] font-medium tracking-[0.10em] uppercase text-mute">{group.name}</h2>
                <div class="mt-3 grid gap-3 sm:grid-cols-2">
                  {calcs.map((c) => (
                    <a href={`/${c.slug}/`} class="group flex h-full flex-col rounded-xl border border-hairline bg-white p-4 shadow-card transition hover:border-hairline-strong/30 hover:shadow-card-hover hover:-translate-y-[1px] focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-link dark:bg-canvas dark:border-white/10">
                      <h3 class="line-clamp-1 text-[14px] font-semibold tracking-[-0.01em] text-ink group-hover:text-link">{c.h1}</h3>
                      <p class="mt-1 line-clamp-2 flex-1 text-xs leading-5 text-body">{c.description.slice(0,110)}</p>
                      <span class="mt-3 inline-flex items-center gap-1 font-mono text-[11px] tracking-wide text-mute group-hover:text-ink">Open <span aria-hidden="true">→</span></span>
                    </a>
                  ))}
                </div>
              </div>
            );
          })}
        </div>

        <div class="mt-10 rounded-xl border border-hairline bg-[#fcfcfc] p-5 dark:bg-white/[0.03]">
          <h2 class="text-sm font-semibold text-ink">Related categories</h2>
          <div class="mt-3 flex flex-wrap gap-2">
            <a href="/construction/" class="rounded-full border border-hairline bg-white px-3 py-1.5 font-mono text-xs text-mute hover:text-ink dark:bg-canvas">All categories</a>
            <a href="/calculators/" class="rounded-full border border-hairline bg-white px-3 py-1.5 font-mono text-xs text-mute hover:text-ink dark:bg-canvas">All calculators</a>
          </div>
        </div>
      </div>
    </section>
  </main>
  <Footer slot="footer" />
</Layout>
