---
import Layout from "../../../layouts/Layout.astro";
import Header from "../../../components/Header.astro";
import Footer from "../../../components/Footer.astro";
import Breadcrumbs from "../../../components/Breadcrumbs.astro";
---

<Layout title="Roofing Calculators — Calculator Street" description="Roofing calculators for pitch, square footage and roofing squares.">
  <Header />
  <main id="main" tabindex="-1" class="mx-auto max-w-[1400px] px-6 py-6 max-md:px-4">
    <Breadcrumbs items={[{ label: "Home", href: "/" }, { label: "Construction", href: "/construction/" }, { label: "Roofing Calculators" }]} />
    <div class="mx-auto max-w-[900px] pt-4">
      <h1 class="text-display-lg font-semibold tracking-[-0.04em] text-ink">Roofing Calculators</h1>
      <p class="mt-2 text-sm leading-6 text-body">Pitch, area, squares and shingles for gable and hip roofs.</p>
      <ul class="mt-6 grid gap-4 sm:grid-cols-2" role="list">
        <li><a href="/roof-pitch-calculator/" class="flex h-full flex-col rounded-md border border-hairline bg-canvas p-5 shadow-card hover:shadow-card-hover dark:bg-canvas"><h2 class="text-sm font-semibold text-ink">Roof Pitch Calculator</h2><p class="mt-1 text-sm leading-5 text-body">Ratio, angle & slope</p><span class="mt-3 text-sm font-medium text-ink">Open →</span></a></li>
        <li><a href="/roof-square-footage-calculator/" class="flex h-full flex-col rounded-md border border-hairline bg-canvas p-5 shadow-card hover:shadow-card-hover dark:bg-canvas"><h2 class="text-sm font-semibold text-ink">Roof Square Footage Calculator</h2><p class="mt-1 text-sm leading-5 text-body">Area & squares with waste</p><span class="mt-3 text-sm font-medium text-ink">Open →</span></a></li>
      </ul>
      <div class="mt-8 rounded-lg border border-hairline bg-canvas p-6 dark:bg-canvas"><h2 class="text-display-sm font-semibold text-ink">Planned</h2><p class="mt-2 text-sm leading-6 text-body">Roof shingle, roofing squares, area & cost calculators.</p></div>
    </div>
  </main>
  <Footer />
</Layout>
