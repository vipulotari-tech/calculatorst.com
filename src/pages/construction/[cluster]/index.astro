---
import CategoryPage from "../../../components/CategoryPage.astro";
import { slugToCluster } from "../../../data/categoryContent";
import { hubCategories } from "../../../data/hubCalculators";

export async function getStaticPaths() {
  return hubCategories.map(({ slug }) => ({
    params: { cluster: slug },
    props: { slug },
  }));
}

const { slug } = Astro.props;
const cluster = slugToCluster[slug] ?? slug;
---

<CategoryPage cluster={cluster} slug={slug} />
