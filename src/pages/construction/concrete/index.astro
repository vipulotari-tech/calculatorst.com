---
import Layout from "../../../layouts/Layout.astro";
import Header from "../../../components/Header.astro";
import Footer from "../../../components/Footer.astro";
import Breadcrumbs from "../../../components/Breadcrumbs.astro";
---

<Layout title="Concrete Calculators — Calculator Street" description="Concrete calculators for slabs, driveways and patios — yards, bags & cost.">
  <Header />
  <main id="main" tabindex="-1" class="mx-auto max-w-[1400px] px-6 py-6 max-md:px-4">
    <Breadcrumbs items={[{ label: "Home", href: "/" }, { label: "Construction", href: "/construction/" }, { label: "Concrete Calculators" }]} />
    <div class="mx-auto max-w-[900px] pt-4">
      <h1 class="text-display-lg font-semibold tracking-[-0.04em] text-ink">Concrete Calculators</h1>
      <p class="mt-2 text-sm leading-6 text-body">Slabs, footings and bag counts for 40/60/80 lb mixes with waste.</p>
      <ul class="mt-6 grid gap-4 sm:grid-cols-2" role="list">
        <li><a href="/concrete-slab-calculator/" class="flex h-full flex-col rounded-md border border-hairline bg-canvas p-5 shadow-card hover:shadow-card-hover dark:bg-canvas"><h2 class="text-sm font-semibold text-ink">Concrete Slab Calculator</h2><p class="mt-1 text-sm leading-5 text-body">Sq ft, yd³ & bags with waste & cost.</p><span class="mt-3 text-sm font-medium text-ink">Open →</span></a></li>
      </ul>
      <div class="mt-8 rounded-lg border border-hairline bg-canvas p-6 dark:bg-canvas"><h2 class="text-display-sm font-semibold text-ink">Planned</h2><p class="mt-2 text-sm leading-6 text-body">Concrete calculator hub, driveway, patio, footing, steps, bag & cost pages.</p></div>
    </div>
  </main>
  <Footer />
</Layout>
