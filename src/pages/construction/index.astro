---
import Layout from "../../layouts/Layout.astro";
import Header from "../../components/Header.astro";
import Footer from "../../components/Footer.astro";
import Breadcrumbs from "../../components/Breadcrumbs.astro";

const clusters = [
  { title: "Gravel Calculators", href: "/construction/gravel/", desc: "Gravel, pea gravel & driveway volume, tons & cost", count: "3 calculators", items: ["Gravel Calculator", "Pea Gravel", "Driveway Gravel"] },
  { title: "Fence Calculators", href: "/construction/fencing/", desc: "Posts, panels, rails & cost for wood, vinyl & chain link", count: "1 calculator", items: ["Fence Cost Calculator"] },
  { title: "Concrete Calculators", href: "/construction/concrete/", desc: "Slabs, bags & ready-mix estimates", count: "1 calculator", items: ["Concrete Slab"] },
  { title: "Roofing Calculators", href: "/construction/roofing/", desc: "Pitch, square footage & roofing squares", count: "2 calculators", items: ["Roof Pitch", "Roof Square Footage"] },
  { title: "Decking Calculators", href: "/construction/decking/", desc: "Boards, joists & fasteners", count: "1 calculator", items: ["Deck Material"] },
  { title: "Landscaping Calculators", href: "/construction/landscaping/", desc: "Pavers, mulch, topsoil — bulk & bags", count: "2 calculators", items: ["Paver", "Mulch"] },
];
---

<Layout title="Construction Calculators — Calculator Street" description="Construction calculators for gravel, concrete, fencing, roofing and decking. Fast, US-focused, mobile-friendly and free.">
  <Header />
  <main id="main" tabindex="-1" class="mx-auto max-w-[1400px] px-6 py-6 max-md:px-4">
    <Breadcrumbs items={[{ label: "Home", href: "/" }, { label: "Construction Calculators" }]} />
    <div class="mx-auto max-w-[900px] pt-4">
      <h1 class="text-display-lg font-semibold tracking-[-0.04em] text-ink [text-wrap:balance]">Construction Calculators</h1>
      <p class="mt-3 max-w-[640px] text-sm leading-6 text-body [text-wrap:pretty]">A focused cluster for builders and DIY homeowners — estimate materials, quantities and costs for gravel, concrete, fences, roofs and decks. Every tool is static, private and built for US units.</p>
      <div class="mt-8 grid gap-4 sm:grid-cols-2">
        {clusters.map((c) => (
          <a href={c.href} class="rounded-lg border border-hairline bg-canvas p-6 shadow-card transition hover:shadow-card-hover dark:bg-canvas">
            <p class="font-mono text-[11px] tracking-widest text-mute">{c.count.toUpperCase()}</p>
            <h2 class="mt-1 text-display-sm font-semibold tracking-[-0.03em] text-ink">{c.title}</h2>
            <p class="mt-1 text-sm leading-5 text-body">{c.desc}</p>
            <p class="mt-3 font-mono text-xs text-mute">{c.items.join(" · ")}</p>
            <span class="mt-3 inline-flex text-sm font-medium text-ink">Explore →</span>
          </a>
        ))}
      </div>
      <div class="mt-10 rounded-lg border border-hairline bg-canvas p-6 dark:bg-canvas">
        <h2 class="text-display-sm font-semibold tracking-[-0.03em] text-ink">How we cluster for SEO</h2>
        <p class="mt-2 text-sm leading-6 text-body">Each cluster interlinks tightly (e.g., Gravel ↔ Pea Gravel ↔ Driveway Gravel) and links up to Construction. This builds topical authority for 10 → 30 → 100+ pages without thin content.</p>
        <a href="/calculators/" class="mt-4 inline-flex text-sm font-medium text-link hover:text-link-deep">View all calculators →</a>
      </div>
    </div>
  </main>
  <Footer />
</Layout>
