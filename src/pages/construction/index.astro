---
import Layout from "../../layouts/Layout.astro";
import Header from "../../components/Header.astro";
import Footer from "../../components/Footer.astro";
import Breadcrumbs from "../../components/Breadcrumbs.astro";
import { hubCategories, hubCalculators } from "../../data/hubCalculators";

const total = hubCalculators.length;
const prioritySlugs = [
  "concrete-calculator",
  "roofing-shingle-calculator",
  "crushed-stone-calculator",
  "gravel-weight-calculator",
  "wall-framing-calculator",
  "drywall-calculator",
  "excavation-calculator",
  "rebar-chair-calculator",
];
const priorityCalculators = prioritySlugs.map((slug) => hubCalculators.find((c) => c.slug === slug)).filter(Boolean) as typeof hubCalculators;
---

<Layout title="Construction Calculators | Calculator Street"
   description={`${total} construction calculators for concrete, roofing, gravel, rebar, framing, drywall, excavation, flooring, deck, fence and asphalt projects.`}
   canonical="/construction/">
  <Header />
  <main id="main" tabindex="-1" class="mx-auto max-w-[1400px] px-6 py-6 max-md:px-4">
    <Breadcrumbs items={[{ label: "Home", href: "/" }, { label: "Construction Calculators" }]} />
    <div class="mx-auto max-w-[900px] pt-4">
      <h1 class="text-display-lg font-semibold tracking-[-0.04em] text-ink [text-wrap:balance]">Construction Calculators</h1>
      <p class="mt-3 max-w-[640px] text-sm leading-6 text-body [text-wrap:pretty]">Browse {total} construction calculators for concrete, roofing, gravel, rebar, framing, drywall, excavation, flooring, deck, fence and asphalt projects. Each calculator documents its formula, assumptions and worked example.</p>
      <section class="mt-8" aria-labelledby="priority-calculators-heading">
        <h2 id="priority-calculators-heading" class="text-display-sm font-semibold tracking-[-0.03em] text-ink">Start with these construction calculators</h2>
        <p class="mt-2 text-sm leading-6 text-body">Direct links to commonly useful material, quantity and estimating tools.</p>
        <div class="mt-4 grid gap-3 sm:grid-cols-2">
          {priorityCalculators.map((c) => (
            <a href={`/${c.slug}/`} class="rounded-lg border border-hairline bg-canvas p-4 shadow-card transition hover:shadow-card-hover">
              <h3 class="text-sm font-semibold text-ink">{c.h1}</h3>
              <p class="mt-1 line-clamp-2 text-xs leading-5 text-body">{c.description}</p>
            </a>
          ))}
        </div>
      </section>

      <div class="mt-8 grid gap-4 sm:grid-cols-2">
        {hubCategories.map((c) => (
          <a href={`/construction/${c.slug}/`} class="group rounded-lg border border-hairline bg-canvas p-6 shadow-card transition hover:shadow-card-hover ">
            <p class="font-mono text-[11px] tracking-widest text-mute">{c.count} CALCULATORS</p>
            <h2 class="mt-1 text-display-sm font-semibold tracking-[-0.03em] text-ink group-hover:text-link">{c.name}</h2>
            <p class="mt-1 text-sm leading-5 text-body">{c.desc}</p>
            <span class="mt-3 inline-flex text-sm font-medium text-ink group-hover:text-link">Explore {c.name} →</span>
          </a>
        ))}
      </div>
      <div class="mt-10 rounded-lg border border-hairline bg-canvas p-6 ">
        <h2 class="text-display-sm font-semibold tracking-[-0.03em] text-ink">Why Calculators Matter</h2>
        <p class="mt-2 text-sm leading-6 text-body">From a single slab to a full build, accurate quantities start with measured dimensions, product data and the right formula. These tools run in your browser and show the calculation method, assumptions and worked examples.</p>
        <a href="/calculators/" class="mt-4 inline-flex text-sm font-medium text-link hover:text-link-deep">View all calculators →</a>
      </div>
    </div>
  </main>
  <Footer />
</Layout>
