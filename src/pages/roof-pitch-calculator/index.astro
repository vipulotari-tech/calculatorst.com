---
import CalculatorLayout from "../../components/CalculatorLayout.astro";
import Header from "../../components/Header.astro";
import Footer from "../../components/Footer.astro";
import GenericCalculator from "../../components/calculators/GenericCalculator.astro";

const related = [
  { title: "Roof Area Calculator", href: "/roof-area-calculator/", desc: "Sloped surface area & roofing squares" },
  { title: "Rafter Length Calculator", href: "/rafter-length-calculator/", desc: "Common-rafter geometry from span and pitch" },
  { title: "Roofing Calculator", href: "/roofing-calculator/", desc: "Roof area, squares and material packages" },
];
const faq = [
  {
    "q": "How is roof pitch calculated?",
    "a": "Divide vertical rise by horizontal run using matching units. Pitch per 12 = slope × 12; percent slope = slope × 100; angle = arctan(slope) in degrees."
  },
  {
    "q": "Can the rise be zero?",
    "a": "Yes. Zero rise gives zero pitch, zero degrees and zero percent slope. The horizontal run must be greater than zero."
  },
  {
    "q": "Is run the rafter length?",
    "a": "No. Run is the horizontal distance, while the rafter follows the slope. Using the sloped length as run gives the wrong pitch."
  },
  {
    "q": "Does pitch determine roofing requirements?",
    "a": "This tool converts geometry only. It does not choose a roofing system, structural span or installation specification."
  }
];
---

<CalculatorLayout
  title="Roof Pitch Calculator — Ratio, Angle & Slope"
  description="Convert rise and horizontal run or a roof angle into pitch per 12, degrees, percent slope, radians and roof-surface multiplier with US and metric units."
  h1="Roof Pitch Calculator"
  intro="Convert roof rise and horizontal run—or enter an angle directly—to pitch per 12, degrees, percent slope and surface multiplier. Measurements can use US or metric units."
  breadcrumbs={[{ label: "Home", href: "/" }, { label: "Construction", href: "/construction/" }, { label: "Roofing Calculators", href: "/construction/roofing/" }, { label: "Roof Pitch Calculator" }]}
  related={related}
  faq={faq}
  canonical="/roof-pitch-calculator/"
  ogImage="/og-roof-pitch.png"
  datePublished="2026-08-27"
  dateModified="2026-09-25"
>
  <Header slot="header" />
  <GenericCalculator slot="calculator" id="roof-pitch-calculator" resultTitle="ROOF PITCH RESULT" />
  <section class="space-y-6">
    <div class="rounded-lg border border-hairline bg-canvas p-6">
      <h2 class="text-display-sm font-semibold tracking-[-0.03em] text-ink">How it works</h2>
      <div class="mt-3 rounded-md bg-canvas-soft-2 p-4 font-mono text-sm "><p>Angle = arctan(rise ÷ run) × 180/π</p><p>Decimal slope = rise ÷ run</p><p>Pitch per 12 = slope × 12 : 12</p></div>
      <p class="mt-3 text-sm leading-6 text-body">Rise and run are normalized before division, so equivalent US or metric measurements return the same slope. Angle mode uses slope = tan(angle).</p>
    </div>
    <div class="rounded-lg border border-hairline bg-canvas p-6">
      <h2 class="text-display-sm font-semibold tracking-[-0.03em] text-ink">Example</h2>
      <p class="mt-2 text-sm leading-6 text-body">Rise 6 in, run 12 in:</p>
      <div class="mt-3 overflow-x-auto rounded-md border border-hairline"><table class="w-full text-left text-sm"><thead class="bg-canvas-soft font-mono text-[11px] text-mute"><tr><th class="px-3 py-2">OUTPUT</th><th class="px-3 py-2">VALUE</th></tr></thead><tbody class="divide-y divide-hairline font-mono tabular-nums"><tr><td class="px-3 py-2">Slope</td><td class="px-3 py-2">0.50</td></tr><tr><td class="px-3 py-2">Angle</td><td class="px-3 py-2">26.6°</td></tr><tr><td class="px-3 py-2">Per 12</td><td class="px-3 py-2">6.00 : 12</td></tr></tbody></table></div>
    </div>
    <div class="rounded-lg border border-hairline bg-canvas p-6">
      <h2 class="text-display-sm font-semibold tracking-[-0.03em] text-ink">Assumptions</h2>
      <ul class="mt-3 list-disc space-y-2 pl-5 text-sm leading-6 text-body"><li>Pitch describes the slope of a roof plane; it does not determine allowable rafter span or select a roofing product.</li><li>Run is horizontal projection, not sloped rafter length. Use the Roof Area Calculator for surface area and the Rafter Length Calculator for common-rafter geometry.</li></ul>
    </div>
  </section>
  <Footer slot="footer" />
</CalculatorLayout>
