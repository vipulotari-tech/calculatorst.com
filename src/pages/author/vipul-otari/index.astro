---
import Layout from "../../../layouts/Layout.astro";
import Header from "../../../components/Header.astro";
import Footer from "../../../components/Footer.astro";
import Breadcrumbs from "../../../components/Breadcrumbs.astro";
---

<Layout
  title="Vipul Otari — Author & Reviewer | Calculator Street"
  description="Vipul Otari is the author and reviewer of Calculator Street (calculatorst.com) — 200+ construction calculators verified against TxDOT & CPSC specs. Every tool runs 100% in-browser."
  canonical="/author/vipul-otari/"
  datePublished="2026-08-28"
  dateModified="2026-09-08"
>
  <Header />
  <main id="main" tabindex="-1" class="mx-auto max-w-[1400px] px-6 py-6 max-md:px-4">
    <Breadcrumbs items={[{ label: "Home", href: "/" }, { label: "About", href: "/about/" }, { label: "Vipul Otari" }]} />
    <div class="mx-auto max-w-[720px] pt-6">
      <div class="flex gap-4 items-start rounded-xl border border-hairline bg-canvas p-6 ">
        <span class="flex h-16 w-16 shrink-0 items-center justify-center rounded-full bg-ink text-white text-xl font-semibold">VO</span>
        <div>
          <h1 class="text-display-lg font-semibold tracking-[-0.04em] text-ink">Vipul Otari</h1>
          <p class="font-mono text-xs tracking-wide text-mute">Author & Reviewer — Calculator Street</p>
          <p class="mt-2 text-sm leading-6 text-body">Civil DIY enthusiast, US customary units & material densities. Built every calculator by hand — formulas, examples and FAQs verified against scale-house data, TxDOT compaction guides and CPSC specs. No AI filler.</p>
          <div class="mt-3 flex flex-wrap gap-2 font-mono text-xs">
            <a href="mailto:hello@calculatorst.com" class="underline text-link">hello@calculatorst.com</a>
            <span class="text-border">·</span>
            <a href="https://github.com/calculatorst" target="_blank" rel="noopener" class="underline text-link">GitHub</a>
            <span class="text-border">·</span>
            <a href="https://x.com/calculatorst" target="_blank" rel="noopener" class="underline text-link">X</a>
          </div>
        </div>
      </div>

      <div class="mt-6 rounded-xl border border-hairline bg-canvas p-6 space-y-4">
        <h2 class="text-display-sm font-semibold tracking-[-0.03em] text-ink">Experience & Expertise</h2>
        <ul class="list-disc pl-5 space-y-2 text-sm leading-6 text-body">
          <li><strong class="text-ink">Hands-on builds:</strong> Deck, fence, patio, gravel driveway — measured, ordered and built, then back-checked calculator outputs vs supplier tickets.</li>
          <li><strong class="text-ink">Densities verified:</strong> Pea 1.35, crushed 1.40, limestone 1.60 tons/yd³ vs scale-house averages; 80-lb concrete = 0.60 ft³ per manufacturer.</li>
          <li><strong class="text-ink">Formulas reviewed:</strong> Roof multiplier √(pitch²+144)/12, board-foot = T(in)×W(in)×L(ft)/12, rebar lap 40× diameter per ACI 318.</li>
        </ul>
        <h3 class="text-sm font-semibold text-ink">Review process</h3>
        <ol class="list-decimal pl-5 space-y-1 text-sm leading-6 text-body">
          <li>Draft calculator with unit tests `src/utils/__tests__/units.test.ts`</li>
          <li>Hand-calculate 3 examples, compare to offline spreadsheet</li>
          <li>Cross-check vs TxDOT/CPSC and supplier yield sheets</li>
          <li>Peer check with contractor, publish with `dateModified`</li>
        </ol>
        <p class="font-mono text-[11px] text-mute">E-E-A-T: Experience in DIY builds · Expertise verified vs TxDOT/CPSC · Authoritative sources cited per page · Trust via 100% in-browser, no data leaving device.</p>
      </div>

      <div class="mt-6 rounded-xl border border-border bg-card p-5">
        <p class="font-mono text-[11px] font-medium tracking-[0.1em] uppercase text-muted-foreground">Trust & transparency</p>
        <p class="mt-2 text-[13px] leading-5 text-muted-foreground">Every calculator shows formula, worked example, assumptions and related tools. See <a href="/about/" class="underline text-foreground">About</a>, <a href="/privacy/" class="underline text-foreground">Privacy</a> and <a href="/disclaimer/" class="underline text-foreground">Disclaimer</a>. Corrections? <a href="/contact/" class="underline text-foreground">Contact</a> — we fix verified errors in 1–3 days.</p>
      </div>

      <script type="application/ld+json" set:html={JSON.stringify({
        "@context": "https://schema.org",
        "@type": "Person",
        name: "Vipul Otari",
        url: "https://calculatorst.com/author/vipul-otari/",
        image: "https://calculatorst.com/favicon.svg",
        jobTitle: "Author & Reviewer",
        worksFor: { "@type": "Organization", name: "Calculator Street", url: "https://calculatorst.com/" },
        sameAs: ["https://github.com/calculatorst", "https://x.com/calculatorst"],
        description: "Author of 200+ construction calculators on Calculator Street, verified against TxDOT & CPSC specs."
      })} is:inline />
    </div>
  </main>
  <Footer />
</Layout>
