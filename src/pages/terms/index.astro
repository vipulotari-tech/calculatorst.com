---
import Layout from "../../layouts/Layout.astro";
import Header from "../../components/Header.astro";
import Footer from "../../components/Footer.astro";
import Breadcrumbs from "../../components/Breadcrumbs.astro";
---

<Layout title="Terms — Calculator Street" description="Terms of use for Calculator Street calculators.">
  <Header />
  <main id="main" tabindex="-1" class="mx-auto max-w-[1400px] px-6 py-6 max-md:px-4">
    <Breadcrumbs items={[{ label: "Home", href: "/" }, { label: "Terms" }]} />
    <div class="mx-auto max-w-[720px] pt-6">
      <h1 class="text-display-lg font-semibold tracking-[-0.04em] text-ink">Terms</h1>
      <div class="mt-6 space-y-4 rounded-lg border border-hairline bg-canvas p-6 text-sm leading-6 text-body dark:bg-canvas">
        <p>By using Calculator Street, you agree that calculations are estimates based on the inputs you provide. Actual material needs, costs and structural requirements vary by supplier, region, site conditions and code.</p>
        <p>Verify critical measurements and orders with a qualified professional or supplier. We are not responsible for over- or under-ordering.</p>
        <p>Content is provided as-is without warranty. You may share links and cite our calculators with attribution.</p>
      </div>
    </div>
  </main>
  <Footer />
</Layout>
