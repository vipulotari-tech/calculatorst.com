---
import CalculatorLayout from "../../components/CalculatorLayout.astro";
import Header from "../../components/Header.astro";
import Footer from "../../components/Footer.astro";
import GenericCalculator from "../../components/calculators/GenericCalculator.astro";
import CalculatorDiagram from "../../components/CalculatorDiagram.astro";
import { hubCalculators } from "../../data/hubCalculators";
import { calculatorDetails } from "../../data/calculatorDetails";
import { calculators } from "../../data/calculators";

export async function getStaticPaths() {
  const existingSlugs = new Set(calculators.map(c => c.slug));
  const filtered = hubCalculators.filter(c => !existingSlugs.has(c.slug));
  return filtered.map((calc) => ({
    params: { slug: calc.slug },
    props: { calc },
  }));
}

const { calc } = Astro.props;
const details = calculatorDetails[calc.slug] || {};

function getInputsForCalc(calc) {
  const name = calc.h1.toLowerCase();
  if (name.includes("rebar") || name.includes("reinforcement")) {
    return [
      { id: "length", label: "Length", placeholder: "20", required: true, units: ["ft","m"], unit: "ft" },
      { id: "width", label: "Width / Spacing", placeholder: "12", required: true, units: ["in","ft","cm"], unit: "in" },
      { id: "depth", label: "Depth / Diameter", placeholder: "0.5", units: ["in","mm"], unit: "in" },
    ];
  }
  if (name.includes("brick") || name.includes("masonry") || name.includes("cmu") || name.includes("block")) {
    return [
      { id: "wall_length", label: "Wall Length", placeholder: "20", required: true, units: ["ft","m"], unit: "ft" },
      { id: "wall_height", label: "Wall Height", placeholder: "8", required: true, units: ["ft","m"], unit: "ft" },
      { id: "brick_length", label: "Brick Length", placeholder: "7.5", units: ["in","cm"], unit: "in" },
    ];
  }
  if (name.includes("roof") || name.includes("rafter") || name.includes("truss") || name.includes("shingle") || name.includes("pitch") || name.includes("slope")) {
    return [
      { id: "length", label: "Roof Length", placeholder: "40", required: true, units: ["ft","m"], unit: "ft" },
      { id: "width", label: "Roof Width", placeholder: "30", required: true, units: ["ft","m"], unit: "ft" },
      { id: "pitch", label: "Pitch (rise/12)", placeholder: "6", units: ["in"], unit: "in" },
    ];
  }
  if (name.includes("paint") || name.includes("drywall") || name.includes("flooring") || name.includes("tile") || name.includes("carpet") || name.includes("insulation")) {
    return [
      { id: "length", label: "Room Length", placeholder: "12", required: true, units: ["ft","m"], unit: "ft" },
      { id: "width", label: "Room Width", placeholder: "10", required: true, units: ["ft","m"], unit: "ft" },
      { id: "height", label: "Height / Coverage", placeholder: "8", units: ["ft","sqft"], unit: "ft" },
    ];
  }
  if (name.includes("trench") || name.includes("excavation") || name.includes("earthwork") || name.includes("soil") || name.includes("dirt") || name.includes("gravel") || name.includes("sand") || name.includes("topsoil") || name.includes("aggregate")) {
    return [
      { id: "length", label: "Length", placeholder: "20", required: true, units: ["ft","m","yd"], unit: "ft" },
      { id: "width", label: "Width", placeholder: "10", required: true, units: ["ft","m"], unit: "ft" },
      { id: "depth", label: "Depth", placeholder: "4", required: true, units: ["in","ft","cm"], unit: "in" },
    ];
  }
  if (name.includes("fence") || name.includes("gate") || name.includes("deck") || name.includes("paver") || name.includes("asphalt") || name.includes("parking") || name.includes("road")) {
    return [
      { id: "length", label: "Length", placeholder: "100", required: true, units: ["ft","m"], unit: "ft" },
      { id: "width", label: "Width / Spacing", placeholder: "8", required: true, units: ["ft","m","in"], unit: "ft" },
      { id: "depth", label: "Depth / Height", placeholder: "4", units: ["in","ft"], unit: "in" },
    ];
  }
  return [
    { id: "length", label: "Length", placeholder: "20", required: true, units: ["ft","m","yd"], unit: "ft" },
    { id: "width", label: "Width", placeholder: "10", required: true, units: ["ft","m"], unit: "ft" },
    { id: "depth", label: "Depth / Thickness", placeholder: "4", required: true, units: ["in","ft","cm","m"], unit: "in" },
  ];
}
function getFormulaKey(calc) {
  const n = calc.h1.toLowerCase();
  if (n.includes("cost")) return "volume";
  if (n.includes("weight")) return "volume";
  if (n.includes("quantity") || n.includes("amount") || n.includes("number")) return "quantity";
  if (n.includes("area") || n.includes("square")) return "area";
  return "volume";
}
function getVisualVariant(calc) {
  const cluster = calc.cluster;
  if (cluster === "concrete") return "concrete";
  if (cluster === "slab") return "concrete";
  if (cluster === "foundation") return "excavation";
  if (cluster === "rebar") return "concrete";
  if (cluster === "brick") return "brick";
  if (cluster === "cmu") return "brick";
  if (cluster === "mortar") return "mortar";
  if (cluster === "gravel") return "gravel";
  if (cluster === "excavation") return "excavation";
  if (cluster === "framing") return "framing";
  if (cluster === "roofing") return "roof-pitch";
  if (cluster === "flooring") return "flooring";
  if (cluster === "drywall") return "drywall";
  if (cluster === "deck-fence") return "deck";
  if (cluster === "landscaping") return "paver";
  if (cluster === "asphalt") return "paver";
  return "gravel";
}
const inputs = getInputsForCalc(calc);
const formulaKey = getFormulaKey(calc);
const visualVariant = getVisualVariant(calc);
const clusterToSlug: Record<string,string> = {
  concrete: "concrete",
  slab: "slab-patio-driveway",
  foundation: "foundation",
  rebar: "rebar",
  brick: "brick-masonry",
  cmu: "concrete-block",
  mortar: "mortar-grout-cement",
  gravel: "gravel",
  excavation: "excavation",
  framing: "framing",
  roofing: "roofing",
  flooring: "flooring",
  drywall: "drywall-paint",
  "deck-fence": "deck-fence",
  landscaping: "landscaping",
  asphalt: "asphalt",
};
const categorySlug = clusterToSlug[calc.cluster] || calc.cluster;
const related = hubCalculators.filter(c => c.cluster === calc.cluster && c.slug !== calc.slug).slice(0,6).map(c=>({title:c.h1, href:`/${c.slug}/`, desc:c.description.slice(0,60)+"..."}));
if (related.length < 4) {
  const extra = hubCalculators.filter(c => c.category === calc.category && c.slug !== calc.slug && !related.find(r=>r.href.includes(c.slug))).slice(0,8-related.length);
  extra.forEach(c=>related.push({title:c.h1, href:`/${c.slug}/`, desc:c.description.slice(0,60)+"..."}));
}
const breadcrumbs = [
  { label: "Home", href: "/" },
  { label: "Construction", href: "/construction/" },
  { label: calc.category, href: `/construction/${categorySlug}/` },
  { label: calc.h1 },
];
const d = details || {};
const faq = d.faq || [
  { q: `What does the ${calc.h1} calculate?`, a: `The ${calc.h1} estimates quantity for US construction. Enter dimensions, choose units, add waste and price — get results instantly.` },
];
---

<CalculatorLayout
  title={calc.title}
  description={calc.description}
  h1={calc.h1}
  intro={calc.description}
  breadcrumbs={breadcrumbs}
  related={related}
  faq={faq}
  canonical={`/${calc.slug}/`}
  ogImage={`/og-${calc.slug}.png`}
  datePublished="2026-08-29"
  dateModified="2026-08-29"
>
  <Header slot="header" />
  <GenericCalculator slot="calculator" id={calc.slug} inputs={inputs} formulaKey={formulaKey} resultTitle={`${calc.h1.toUpperCase()} ESTIMATE`} />
  <section class="space-y-6">
    <CalculatorDiagram slug={calc.slug} cluster={calc.cluster} h1={calc.h1} inputs={inputs} formula={d.formula} />

    <div class="rounded-lg border border-hairline bg-canvas p-6 dark:bg-canvas">
      <h2 class="text-display-sm font-semibold tracking-[-0.03em] text-ink">What Is This Calculator?</h2>
      <p class="mt-2 text-sm leading-6 text-body [text-wrap:pretty]" set:html={d.whatIs || `The ${calc.h1} helps you estimate ${calc.h1.toLowerCase().replace(' calculator','')} for US construction.`}></p>
    </div>

    <div class="rounded-lg border border-hairline bg-canvas p-6 dark:bg-canvas">
      <h2 class="text-display-sm font-semibold tracking-[-0.03em] text-ink">What Does It Calculate?</h2>
      <ul class="mt-3 list-disc space-y-2 pl-5 text-sm leading-6 text-body">
        {(d.whatCalculates || ["Primary quantity in US units","Waste-adjusted total","Cost with waste"]).map((item) => <li>{item}</li>)}
      </ul>
    </div>

    <div class="rounded-lg border border-hairline bg-canvas p-6 dark:bg-canvas">
      <h2 class="text-display-sm font-semibold tracking-[-0.03em] text-ink">How to Use the Calculator</h2>
      <ol class="mt-3 list-decimal space-y-1 pl-5 text-sm leading-6 text-body">
        {(d.howToUse || ["Measure on site","Enter values and units","Adjust waste and price","Calculate and Reset"]).map((step) => <li>{step}</li>)}
      </ol>
    </div>

    <div class="rounded-lg border border-hairline bg-canvas p-6 dark:bg-canvas">
      <h2 class="text-display-sm font-semibold tracking-[-0.03em] text-ink">Formula</h2>
      <div class="mt-3 rounded-md border border-hairline bg-canvas-soft-2 dark:bg-white/[0.04] p-4 font-mono text-sm leading-6 dark:bg-white/[0.03]">
        <p class="font-semibold text-ink">{d.formula || "Quantity = Product of dimensions × (1 + waste%)"}</p>
        {d.variables && d.variables.length > 0 && (
          <ul class="mt-2 list-disc pl-5 text-xs text-body">
            {d.variables.map((v) => <li><span class="font-semibold text-ink">{v.symbol}</span> — {v.meaning}</li>)}
          </ul>
        )}
      </div>
      <p class="mt-3 text-sm leading-6 text-body">All units convert to feet before math: inches /12, yards ×3, meters ×3.28084. This keeps US and metric consistent.</p>
    </div>

    <div class="rounded-lg border border-hairline bg-canvas p-6 dark:bg-canvas">
      <h2 class="text-display-sm font-semibold tracking-[-0.03em] text-ink">Worked Example</h2>
      <p class="mt-2 text-sm leading-6 text-body">Example: {d.example?.inputs || "Length 20 ft × Width 10 ft × Depth 4 in, 10% waste"}</p>
      <div class="mt-3 overflow-x-auto rounded-md border border-hairline">
        <table class="w-full text-left text-sm">
          <thead class="bg-canvas-soft font-mono text-[11px] tracking-widest text-mute"><tr><th class="px-3 py-2">STEP</th><th class="px-3 py-2">VALUE</th></tr></thead>
          <tbody class="divide-y divide-hairline font-mono tabular-nums">
            {(d.example?.steps || [{label:"Convert",value:"4 in /12 = 0.333 ft"},{label:"Result",value:"66.67"}]).map((r) => <tr><td class="px-3 py-2 text-body">{r.label}</td><td class="px-3 py-2 text-ink font-medium">{r.value}</td></tr>)}
          </tbody>
        </table>
      </div>
    </div>

    <div class="rounded-lg border border-hairline bg-canvas p-6 dark:bg-canvas">
      <h2 class="text-display-sm font-semibold tracking-[-0.03em] text-ink">Construction Information</h2>
      <div class="mt-2 text-sm leading-6 text-body [text-wrap:pretty]" set:html={d.constructionInfo || "Measure longest × widest; split L-shapes and add. Verify structural sizing with a professional."}></div>
    </div>

    {d.materialInfo && (
      <div class="rounded-lg border border-hairline bg-canvas p-6 dark:bg-canvas">
        <h2 class="text-display-sm font-semibold tracking-[-0.03em] text-ink">Material Information</h2>
        <p class="mt-2 text-sm leading-6 text-body [text-wrap:pretty]" set:html={d.materialInfo}></p>
      </div>
    )}

    <div class="rounded-lg border border-hairline bg-canvas p-6 dark:bg-canvas">
      <h2 class="text-display-sm font-semibold tracking-[-0.03em] text-ink">Waste & Overages</h2>
      <p class="mt-2 text-sm leading-6 text-body" set:html={d.wasteInfo || "Add 5–10% waste for rectangular, 10–15% for irregular. Waste is applied last: ×(1+waste%)."}></p>
    </div>

    <div class="rounded-lg border border-hairline bg-canvas p-6 dark:bg-canvas">
      <h2 class="text-display-sm font-semibold tracking-[-0.03em] text-ink">Practical Tips</h2>
      <ul class="mt-3 list-disc space-y-2 pl-5 text-sm leading-6 text-body">
        {(d.tips || ["Double-check units","Order in supplier units","Photo your measurements"]).map((t) => <li>{t}</li>)}
      </ul>
    </div>

    <div class="rounded-lg border border-hairline bg-canvas p-6 dark:bg-canvas">
      <h2 class="text-display-sm font-semibold tracking-[-0.03em] text-ink">Common Mistakes</h2>
      <ul class="mt-3 list-disc space-y-2 pl-5 text-sm leading-6 text-body">
        {(d.mistakes || ["Forgetting waste","Wrong density","Not converting metric"]).map((m) => <li>{m}</li>)}
      </ul>
    </div>

    <div class="rounded-lg border border-hairline bg-canvas p-6 dark:bg-canvas">
      <h2 class="text-display-sm font-semibold tracking-[-0.03em] text-ink">Assumptions</h2>
      <p class="mt-2 text-sm leading-6 text-body" set:html={d.assumptions || "Estimate based on your inputs. Actual needs vary by site and material. For code-regulated work, consult a professional."}></p>
      <p class="mt-2 text-sm leading-6 text-body">Calculations run 100% in your browser — no data leaves your device.</p>
    </div>
  </section>
  <Footer slot="footer" />
</CalculatorLayout>
