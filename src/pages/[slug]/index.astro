    ]
  },
  "concrete-mix-calculator": {
    title: "Concrete Mix Calculator — Cement, Sand & Aggregate Ratio",
    description: "Calculate cement, sand, coarse aggregate, water and whole cement bags from concrete volume and a custom mix ratio, dry-volume factor and water-cement ratio.",
    guidance: [
      "Enter the specified volumetric mix parts for cement, sand and coarse aggregate instead of assuming one ratio fits every application.",
      "The dry-volume factor and bulk densities are estimating assumptions; actual batching by mass should follow the approved mix design.",
      "The water result is an approximation from the entered water-cement ratio and does not account for aggregate moisture or admixtures."
