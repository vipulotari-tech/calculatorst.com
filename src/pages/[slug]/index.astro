---
// @ts-nocheck
import CalculatorLayout from "../../components/CalculatorLayout.astro";
import Header from "../../components/Header.astro";
import Footer from "../../components/Footer.astro";
import GenericCalculator from "../../components/calculators/GenericCalculator.astro";
import CalculatorDiagram from "../../components/CalculatorDiagram.astro";
import { hubCalculators } from "../../data/hubCalculators";
import { calculatorDetails } from "../../data/calculatorDetails";
import { calculators } from "../../data/calculators";
import { getModelForSlug } from "../../lib/calculator-registry";

export async function getStaticPaths() {
  const existingSlugs = new Set(calculators.map(c => c.slug));
  const filtered = hubCalculators.filter(c => !existingSlugs.has(c.slug));
  return filtered.map((calc) => ({
    params: { slug: calc.slug },
    props: { calc },
  }));
}

const { calc } = Astro.props;
const model = getModelForSlug(calc.slug);
const inputs = model.fields;
const details = calculatorDetails[calc.slug] || {};

const clusterToSlug: Record<string, string> = {
  concrete: "concrete",
  slab: "slab-patio-driveway",
  foundation: "foundation",
  rebar: "rebar",
  brick: "brick-masonry",
  cmu: "concrete-block",
  mortar: "mortar-grout-cement",
  gravel: "gravel",
  excavation: "excavation",
  framing: "framing",
  roofing: "roofing",
  flooring: "flooring",
  drywall: "drywall-paint",
  "deck-fence": "deck-fence",
  landscaping: "landscaping",
  asphalt: "asphalt",
};

const categorySlug = clusterToSlug[calc.cluster] || calc.cluster;
const related = hubCalculators.filter(c => c.cluster === calc.cluster && c.slug !== calc.slug).slice(0, 6).map(c => ({
  title: c.h1,
  href: `/${c.slug}/`,
  desc: c.description.slice(0, 60) + "..."
}));

if (related.length < 4) {
  const extra = hubCalculators.filter(c => c.category === calc.category && c.slug !== calc.slug && !related.find(r => r.href.includes(c.slug))).slice(0, 8 - related.length);
  extra.forEach(c => related.push({ title: c.h1, href: `/${c.slug}/`, desc: c.description.slice(0, 60) + "..." }));
}

const breadcrumbs = [
  { label: "Home", href: "/" },
  { label: "Construction", href: "/construction/" },
  { label: calc.category, href: `/construction/${categorySlug}/` },
  { label: calc.h1 },
];

const ogClusterMap: Record<string, string> = {
  concrete: "/og-concrete.png",
  slab: "/og-concrete.png",
  foundation: "/og-concrete.png",
  rebar: "/og.png",
  brick: "/og.png",
  cmu: "/og.png",
  mortar: "/og.png",
  gravel: "/og-gravel.png",
  excavation: "/og-gravel.png",
  framing: "/og-deck.png",
  roofing: "/og-roof-pitch.png",
  flooring: "/og-paver.png",
  drywall: "/og-paver.png",
  "deck-fence": "/og-deck.png",
  landscaping: "/og-paver.png",
  asphalt: "/og-paver.png",
};

const ogImage = ogClusterMap[calc.cluster] ?? "/og.png";
const d = details || {};
const faq = d.faq || [
  { q: `What does the ${calc.h1} calculate?`, a: `The ${calc.h1} estimates quantity for US construction. Enter dimensions, choose units, add waste and price — get results instantly.` },
];
---

<CalculatorLayout
  title={calc.title}
  description={calc.description}
  h1={calc.h1}
  intro={`${calc.description} Enter dimensions, select units and add waste to get instant, supplier-ready numbers.`}
  breadcrumbs={breadcrumbs}
  related={related}
  faq={faq}
  canonical={`/${calc.slug}/`}
  ogImage={ogImage}
  datePublished="2026-08-29"
  dateModified="2026-09-11"
  noindex={false}
>
  <Header slot="header" />
  <GenericCalculator slot="calculator" id={calc.slug} resultTitle={`${calc.h1.toUpperCase()} ESTIMATE`} />
  <section class="space-y-6">
    <CalculatorDiagram slug={calc.slug} cluster={calc.cluster} h1={calc.h1} inputs={inputs} formula={model.formula || d.formula} />

    <div class="rounded-lg border border-hairline bg-canvas p-6 dark:bg-canvas">
      <h2 class="text-display-sm font-semibold tracking-[-0.03em] text-ink">What Is This Calculator?</h2>
      <p class="mt-2 text-sm leading-6 text-body [text-wrap:pretty]" set:html={d.whatIs || `The ${calc.h1} helps you estimate ${calc.h1.toLowerCase().replace(' calculator','')} for US construction.`}></p>
    </div>

    <div class="rounded-lg border border-hairline bg-canvas p-6 dark:bg-canvas">
      <h2 class="text-display-sm font-semibold tracking-[-0.03em] text-ink">What Does It Calculate?</h2>
      <ul class="mt-3 list-disc space-y-2 pl-5 text-sm leading-6 text-body">
        {(d.whatCalculates || ["Primary quantity in US units","Waste-adjusted total","Cost with waste"]).map((item) => <li>{item}</li>)}
      </ul>
    </div>

    <div class="rounded-lg border border-hairline bg-canvas p-6 dark:bg-canvas">
      <h2 class="text-display-sm font-semibold tracking-[-0.03em] text-ink">How to Use the Calculator</h2>
      <ol class="mt-3 list-decimal space-y-1 pl-5 text-sm leading-6 text-body">
        {(d.howToUse || ["Measure on site","Enter values and units","Adjust waste and price","Calculate and Reset"]).map((step) => <li>{step}</li>)}
      </ol>
    </div>

    <div class="rounded-lg border border-hairline bg-canvas p-6 dark:bg-canvas">
      <h2 class="text-display-sm font-semibold tracking-[-0.03em] text-ink">Formula & Engineering Methodology</h2>
      <div class="mt-3 rounded-md border border-hairline bg-canvas-soft-2 dark:bg-white/[0.04] p-4 font-mono text-sm leading-6 dark:bg-[#171717]">
        <p class="font-semibold text-ink">{model.formula || d.formula || "Quantity = Product of dimensions × (1 + waste%)"}</p>
        {d.variables && d.variables.length > 0 && (
          <ul class="mt-2 list-disc pl-5 text-xs text-body">
            {d.variables.map((v) => <li><span class="font-semibold text-ink">{v.symbol}</span> — {v.meaning}</li>)}
          </ul>
        )}
      </div>
      <p class="mt-3 text-sm leading-6 text-body">All units convert to exact standard engineering dimensions (NIST SP 811) before calculation to ensure consistency between US Customary and Metric measurements.</p>
    </div>

    <div class="rounded-lg border border-hairline bg-canvas p-6 dark:bg-canvas">
      <h2 class="text-display-sm font-semibold tracking-[-0.03em] text-ink">Worked Example</h2>
      <p class="mt-2 text-sm leading-6 text-body">Example: {d.example?.inputs || "Length 20 ft × Width 10 ft × Depth 4 in, 10% waste"}</p>
      <div class="mt-3 overflow-x-auto rounded-md border border-hairline">
        <table class="w-full text-left text-sm">
          <thead class="bg-canvas-soft font-mono text-[11px] tracking-widest text-mute"><tr><th class="px-3 py-2">STEP</th><th class="px-3 py-2">VALUE</th></tr></thead>
          <tbody class="divide-y divide-hairline font-mono tabular-nums">
            {(d.example?.steps || [{label:"Convert",value:"4 in /12 = 0.333 ft"},{label:"Result",value:"66.67"}]).map((r) => <tr><td class="px-3 py-2 text-body">{r.label}</td><td class="px-3 py-2 text-ink font-medium">{r.value}</td></tr>)}
          </tbody>
        </table>
      </div>
    </div>

    <div class="rounded-lg border border-hairline bg-canvas p-6 dark:bg-canvas">
      <h2 class="text-display-sm font-semibold tracking-[-0.03em] text-ink">Construction Information</h2>
      <div class="mt-2 text-sm leading-6 text-body [text-wrap:pretty]" set:html={d.constructionInfo || "Measure longest × widest; split L-shapes and add. Verify structural sizing with a professional."}></div>
    </div>

    {d.materialInfo && (
      <div class="rounded-lg border border-hairline bg-canvas p-6 dark:bg-canvas">
        <h2 class="text-display-sm font-semibold tracking-[-0.03em] text-ink">Material Information</h2>
        <p class="mt-2 text-sm leading-6 text-body [text-wrap:pretty]" set:html={d.materialInfo}></p>
      </div>
    )}

    <div class="rounded-lg border border-hairline bg-canvas p-6 dark:bg-canvas">
      <h2 class="text-display-sm font-semibold tracking-[-0.03em] text-ink">Waste & Overages</h2>
      <p class="mt-2 text-sm leading-6 text-body" set:html={d.wasteInfo || "Add 5–10% waste for rectangular, 10–15% for irregular. Waste is applied last: ×(1+waste%)."}></p>
    </div>

    <div class="rounded-lg border border-hairline bg-canvas p-6 dark:bg-canvas">
      <h2 class="text-display-sm font-semibold tracking-[-0.03em] text-ink">Practical Tips</h2>
      <ul class="mt-3 list-disc space-y-2 pl-5 text-sm leading-6 text-body">
        {(d.tips || ["Double-check units","Order in supplier units","Photo your measurements"]).map((t) => <li>{t}</li>)}
      </ul>
    </div>

    <div class="rounded-lg border border-hairline bg-canvas p-6 dark:bg-canvas">
      <h2 class="text-display-sm font-semibold tracking-[-0.03em] text-ink">Common Mistakes</h2>
      <ul class="mt-3 list-disc space-y-2 pl-5 text-sm leading-6 text-body">
        {(d.mistakes || ["Forgetting waste","Wrong density","Not converting metric"]).map((m) => <li>{m}</li>)}
      </ul>
    </div>

    <div class="rounded-lg border border-hairline bg-canvas p-6 dark:bg-canvas">
      <h2 class="text-display-sm font-semibold tracking-[-0.03em] text-ink">Assumptions & Engineering References</h2>
      {model.assumptions.length > 0 && (
        <ul class="list-disc pl-5 space-y-1 text-sm leading-6 text-body mt-2">
          {model.assumptions.map((a) => <li>{a}</li>)}
        </ul>
      )}
      <p class="mt-2 text-sm leading-6 text-body" set:html={d.assumptions || "Estimate based on your inputs. Actual needs vary by site and material. For code-regulated work, consult a professional."}></p>
      <p class="mt-2 text-xs text-muted-foreground font-mono">Calculations run 100% in your browser — zero tracking of your dimensions or input data.</p>
    </div>
  </section>
  <Footer slot="footer" />
</CalculatorLayout>
