---
import CalculatorLayout from "../../components/CalculatorLayout.astro";
import Header from "../../components/Header.astro";
import Footer from "../../components/Footer.astro";
import GenericCalculator from "../../components/calculators/GenericCalculator.astro";
import { hubCalculators } from "../../data/hubCalculators";
import { getCalculatorContent } from "../../lib/calculator-content";
import { fmt, unitLabels } from "../../lib/calculator-math";
import { calculators, type CalculatorMeta } from "../../data/calculators";
import { getModelForSlug } from "../../lib/calculator-registry";
import { getWorkflowRelated } from "../../lib/workflow-adjacency";

export async function getStaticPaths() {
  const existingSlugs = new Set(calculators.map(c => c.slug));
  const filtered = hubCalculators.filter(c => !existingSlugs.has(c.slug));
  return filtered.map((calc) => ({
    params: { slug: calc.slug },
    props: { calc },
  }));
}

const { calc } = Astro.props;
const model = getModelForSlug(calc.slug);
const content = getCalculatorContent(calc.h1, model);

const clusterToSlug: Record<string, string> = {
  concrete: "concrete",
  slab: "slab-patio-driveway",
  foundation: "foundation",
  rebar: "rebar",
  brick: "brick-masonry",
  cmu: "concrete-block",
  mortar: "mortar-grout-cement",
  gravel: "gravel",
  excavation: "excavation",
  framing: "framing",
  roofing: "roofing",
  flooring: "flooring",
  drywall: "drywall-paint",
  "deck-fence": "deck-fence",
  landscaping: "landscaping",
  asphalt: "asphalt",
};

const categorySlug = clusterToSlug[calc.cluster] || calc.cluster;
const workflowSlugs = getWorkflowRelated(calc.slug);
const hubBySlug = new Map(hubCalculators.map(c => [c.slug, c]));
const related = workflowSlugs
  .map(slug => hubBySlug.get(slug))
  .filter((c): c is (CalculatorMeta & { cluster: string; category: string }) => c !== undefined)
  .slice(0, 6)
  .map(c => ({
    title: c.h1,
    href: `/${c.slug}/`,
    desc: c.description.slice(0, 60) + "..."
  }));

const breadcrumbs = [
  { label: "Home", href: "/" },
  { label: "Construction", href: "/construction/" },
  { label: calc.category, href: `/construction/${categorySlug}/` },
  { label: calc.h1 },
];

const ogClusterMap: Record<string, string> = {
  concrete: "/og-concrete.png",
  slab: "/og-concrete.png",
  foundation: "/og-concrete.png",
  rebar: "/og.png",
  brick: "/og.png",
  cmu: "/og.png",
  mortar: "/og.png",
  gravel: "/og-gravel.png",
  excavation: "/og-gravel.png",
  framing: "/og-deck.png",
  roofing: "/og-roof-pitch.png",
  flooring: "/og-paver.png",
  drywall: "/og-paver.png",
  "deck-fence": "/og-deck.png",
  landscaping: "/og-paver.png",
  asphalt: "/og-paver.png",
};

const ogImage = ogClusterMap[calc.cluster] ?? "/og.png";
const faqEnhancements: Record<string, { q: string; a: string }[]> = {
  "roofing-shingle-calculator": [
    { q: "How does the roofing shingle calculator estimate bundles?", a: "It calculates sloped roof surface from the measured footprint, overhang and pitch, applies the entered material allowance, then divides by your effective coverage per bundle or package and rounds up." },
    { q: "Is a roofing square the same as a bundle of shingles?", a: "No. A roofing square is 100 square feet of roof surface. Bundle coverage varies by product, so enter the manufacturer’s effective package coverage rather than assuming a fixed number of bundles per square." },
  ],
  "rebar-chair-calculator": [
    { q: "How is the rebar chair count calculated?", a: "The calculator lays out a rectangular support grid using the maximum spacing you enter, counts support positions along both slab dimensions, multiplies the grid counts, then adds the purchasing allowance." },
    { q: "Does this calculator choose the correct rebar chair spacing or height?", a: "No. Spacing, chair height, support type, edge setbacks and load capacity must come from the reinforcement support plan or project specification. This tool converts an already selected layout into a quantity." },
  ],
  "beam-calculator": [
    { q: "Which beam load cases are included?", a: "The calculator includes a simply supported beam with a full-span uniform load, a simply supported beam with one center point load, a cantilever with a full-span uniform load, and a cantilever with one point load at the free end." },
    { q: "Does the beam calculator tell me what beam size is safe?", a: "No. It calculates idealized elastic reactions, bending moment, shear and deflection from the inputs. It does not select a member or check allowable capacity, bearing, buckling, connections or code load combinations." },
  ],
  "concrete-wall-calculator": [
    { q: "Can I subtract doors and windows from a concrete wall?", a: "Yes. Enter the opening area once so the calculator deducts it from the gross wall face before converting the remaining wall volume to concrete quantity." },
    { q: "Does the concrete wall calculator choose wall thickness or reinforcement?", a: "No. Enter the wall thickness from your project requirements. The calculator estimates material quantity; structural thickness and reinforcement must be determined separately." },
  ],
};
const faq = [...content.faq, ...(faqEnhancements[calc.slug] ?? [])];
const seoDescriptionOverrides: Record<string, string> = {
  "crushed-stone-calculator": calc.description,
  "concrete-cost-calculator": calc.description,
  "slab-cost-calculator": calc.description,
  "drywall-joint-compound-calculator": calc.description,
  "roofing-shingle-calculator": calc.description,
  "rebar-chair-calculator": calc.description,
  "beam-calculator": calc.description,
  "concrete-wall-calculator": calc.description,
  "parking-lot-calculator": calc.description,
  "parking-lot-cost-calculator": calc.description,
  "wall-framing-calculator": calc.description,
  "mortar-calculator": calc.description,
  "drywall-sheet-calculator": calc.description,
  "drywall-calculator": calc.description,
  "concrete-crack-repair-calculator": calc.description,
  "deck-mud-calculator": calc.description,
  "stucco-calculator": calc.description,
};
const seoDescription = seoDescriptionOverrides[calc.slug] ?? content.description;
---

<CalculatorLayout
  title={calc.title}
  description={seoDescription}
  h1={calc.h1}
  intro={seoDescription}
  breadcrumbs={breadcrumbs}
  related={related}
  faq={faq}
  canonical={`/${calc.slug}/`}
  ogImage={ogImage}
  datePublished="2026-08-29"
  dateModified="2026-09-24"
  noindex={false}
>
  <Header slot="header" />
  <GenericCalculator slot="calculator" id={calc.slug} resultTitle={`${calc.h1.toUpperCase()} ESTIMATE`} />
  <section class="space-y-6">
    <div class="rounded-lg border border-hairline bg-canvas p-6">
      <h2 class="text-display-sm font-semibold tracking-[-0.03em] text-ink">What Does It Calculate?</h2>
      <ul class="mt-3 list-disc space-y-2 pl-5 text-sm leading-6 text-body">
        {content.outputs.map(item => <li>{item}</li>)}
      </ul>
      {model.fields.some(f => f.id === 'price' && f.optional) && <p class="mt-3 text-sm text-body">A cost estimate appears when you enter a price. The price unit and assumptions define which material is included.</p>}
    </div>
    <div class="rounded-lg border border-hairline bg-canvas p-6">
      <h2 class="text-display-sm font-semibold tracking-[-0.03em] text-ink">How to Use the Calculator</h2>
      <ol class="mt-3 list-decimal space-y-2 pl-5 text-sm leading-6 text-body">
        {content.instructions.map(step => <li>{step}</li>)}
      </ol>
    </div>
    <div class="rounded-lg border border-hairline bg-canvas p-6">
      <h2 class="text-display-sm font-semibold tracking-[-0.03em] text-ink">Formula &amp; Method</h2>
      <p class="mt-3 rounded-md bg-canvas-soft-2 p-4 font-mono text-sm leading-6 text-ink break-words">{model.formula}</p>
      <dl class="mt-4 space-y-3 text-sm leading-6 text-body">
        {content.fields.map(field => <div><dt class="font-semibold text-ink">{field.label}</dt><dd>{field.help || (field.unit ? `Select the unit matching your measurement. Initial unit: ${unitLabels[field.unit] ?? field.unit}.` : 'Enter this quantity as a number.')}</dd></div>)}
      </dl>
    </div>
    <div class="rounded-lg border border-hairline bg-canvas p-6">
      <h2 class="text-display-sm font-semibold tracking-[-0.03em] text-ink">Worked Example</h2>
      <p class="mt-2 text-sm leading-6 text-body">{content.exampleNote}</p>
      <ul class="mt-3 list-disc pl-5 space-y-1 text-sm text-body">{content.inputs.map(input => <li>{input}</li>)}</ul>
      <ol class="mt-4 list-decimal pl-5 space-y-2 text-sm leading-6 text-body">{content.example.steps.map(step => <li>{step}</li>)}</ol>
      <div class="mt-4 overflow-x-auto rounded-md border border-hairline" role="region" aria-label="Worked example results" tabindex="0">
        <table class="w-full text-left text-sm">
          <caption class="sr-only">{calc.h1} worked example results</caption>
          <thead class="bg-canvas-soft"><tr><th scope="col" class="px-3 py-2">Result</th><th scope="col" class="px-3 py-2">Value</th></tr></thead>
          <tbody class="divide-y divide-hairline">
            {content.example.rows.map(r => <tr><th scope="row" class="px-3 py-2 text-body font-normal">{r.label}</th><td class="px-3 py-2 font-mono text-ink">{fmt(r.value)} {unitLabels[r.unit] ?? r.unit}</td></tr>)}
          </tbody>
        </table>
      </div>
    </div>
    <div class="rounded-lg border border-hairline bg-canvas p-6">
      <h2 class="text-display-sm font-semibold tracking-[-0.03em] text-ink">Assumptions &amp; Limitations</h2>
      <ul class="mt-3 list-disc pl-5 space-y-2 text-sm leading-6 text-body">{model.assumptions.map(a => <li>{a}</li>)}</ul>
      {model.sources.length > 0 && <div class="mt-4"><h3 class="font-semibold text-ink">References</h3><ul class="mt-2 list-disc pl-5 text-sm space-y-2">{model.sources.map(url => <li><a class="text-primary underline break-words" href={url}>{new URL(url).hostname.replace(/^www\./, '')} — reference</a></li>)}</ul></div>}
      <p class="mt-4 text-sm leading-6 text-body">Use your product specifications and project measurements when ordering. These estimates do not select structural sizes or establish code compliance.</p>
    </div>
  </section>
  <Footer slot="footer" />
</CalculatorLayout>
