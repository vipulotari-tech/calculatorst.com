    faq: [
      { q: "What does a 1:2:3 concrete mix ratio mean?", a: "It represents relative parts of cement, sand and coarse aggregate by the chosen volumetric basis. This calculator divides the dry material volume according to those entered parts." },
      { q: "Why is a dry-volume factor used?", a: "Loose dry ingredients occupy a different volume than finished concrete. The factor expands the target mixed volume before the ingredient proportions are calculated." },
      { q: "How are cement bags calculated?", a: "The calculator estimates cement volume, converts it to mass using the entered bulk density, divides by bag mass and rounds up to whole bags." },
      { q: "Is this a structural concrete mix-design tool?", a: "No. It is a material-estimating calculator. Structural mix design must account for strength, durability, aggregate grading, moisture, admixtures and project specifications." }
    ]
  },
  "concrete-pour-calculator": {
