      "q": "Can I use package pricing and square-foot pricing interchangeably?",
      "a": "Only after converting them to one consistent basis using the actual package coverage."
    }
  ],
  "laminate-flooring-calculator": [
    {
      "q": "How are laminate packages rounded?",
      "a": "The allowance-adjusted coverage is divided by the actual package coverage, then rounded up to a whole package count."
    },
    {
      "q": "Should attached pad be counted as separate underlayment?",
      "a": "Not automatically. Check the product system so integrated underlayment is not duplicated in the takeoff."
    }
  ],
  "vinyl-flooring-calculator": [
    {
      "q": "Can I use this for both vinyl plank and sheet vinyl?",
      "a": "Use the workflow and coverage unit that matches the product shown in the form. Sheet layouts may require seam and pattern-repeat planning beyond simple area."
    },
    {
      "q": "Why can purchased vinyl exceed net room area?",
      "a": "Package rounding, pattern repeat, seams, room shape and the selected allowance can all increase the purchased quantity."
    }
  ],
  "carpet-calculator": [
    {
      "q": "Why does carpet need roll width?",
      "a": "Carpet is cut from a fixed-width roll, so strip layout and seam direction can create offcut area that a simple square-foot calculation misses."
    },
    {
      "q": "Is carpet pad included?",
      "a": "Only when the calculator explicitly provides pad inputs or outputs. Treat pad, stairs, transitions and installation as separate scope otherwise."
    }
  ],
  "carpet-cost-calculator": [
    {
      "q": "Should carpet cost use net room area or purchased roll area?",
      "a": "Use the purchased quantity based on roll layout because offcuts are still part of the material bought."
    },
    {
      "q": "How do I handle a quote per square yard?",
      "a": "Use the matching price unit or convert the purchase area consistently; one square yard equals nine square feet."
    }
  ],
  "tile-calculator": [
    {
      "q": "Does grout-joint width change tile count?",
      "a": "Yes. The tile plus joint creates the installed module used for row and column layout, so joint width can affect whole edge-piece counts."
    },
    {
      "q": "Does the calculator optimize reusable tile offcuts?",
      "a": "No. Straight-grid counting is conservative at edges and does not perform a cutting-layout optimization."
    }
  ],
  "tile-quantity-calculator": [
    {
      "q": "When should I use Tile Quantity instead of Tile Calculator?",
      "a": "Use Tile Quantity when the main goal is whole-tile purchasing count from surface and tile dimensions; use the broader Tile Calculator when you want the fuller layout outputs."
    },
    {
      "q": "Can it model diagonal or patterned tile layouts?",
      "a": "Not directly. Those layouts usually need a project-specific allowance and a separate layout plan."
    }
  ],
  "tile-cost-calculator": [
    {
      "q": "Does tile cost include grout and adhesive?",
      "a": "Not unless those items are explicitly entered. Tile, grout, adhesive, membrane, trim and labor are separate scopes on many projects."
    },
    {
      "q": "Should material cost use whole boxes?",
      "a": "When the supplier sells only whole boxes, base cost on the rounded purchasing quantity rather than an unpurchasable fractional box."
    }
  ],
  "tile-grout-calculator": [
    {
      "q": "What measurements affect grout quantity?",
      "a": "Tile length and width, joint width, joint depth, tiled area and the product yield or density basis all influence the result."
    },
    {
      "q": "Should I rely on a generic grout coverage number?",
      "a": "Manufacturer coverage for the exact grout product is preferable because formulation, joint geometry and installation loss vary."
    }
  ],
  "tile-adhesive-calculator": [
    {
      "q": "Why does thinset coverage vary so much?",
      "a": "Trowel notch, tile size, substrate flatness, mortar consistency and back-buttering can change coverage significantly."
    },
    {
      "q": "What coverage should I enter?",
      "a": "Use the manufacturer's coverage for the selected product and installation method when available."
    }
  ],
  "flooring-waste-calculator": [
    {
      "q": "What is the difference between net flooring and waste allowance?",
      "a": "Net quantity is the measured requirement before overage. The allowance is the extra material added for cuts, damage, pattern matching or spare stock."
    },
    {
      "q": "Can I use this after another calculator already added waste?",
      "a": "Only after removing that prior allowance. Otherwise the same overage would be applied twice."
    }
  ],
  "underlayment-calculator": [
    {
      "q": "How are underlayment rolls or packages estimated?",
      "a": "The floor area plus allowance is divided by effective net package coverage and rounded up to whole packages."
    },
    {
      "q": "Should overlap be included in the coverage value?",
      "a": "Use manufacturer net coverage after required overlap when available so overlap is not deducted twice."
    }
  ]
};

const masonrySeo = masonrySeoEnhancements[calc.slug]
  ? { title: calc.title, description: calc.description, ...masonrySeoEnhancements[calc.slug] }
  : undefined;
const pageSeo = concreteSeo[calc.slug] ?? slabSeo[calc.slug] ?? foundationSeo[calc.slug] ?? rebarSeo[calc.slug] ?? masonrySeo;
const enhancedTradeCluster = new Set(["framing", "roofing", "flooring", "drywall", "deck-fence", "landscaping", "asphalt"]);
const faq = pageSeo?.faq ?? [...content.faq, ...(faqEnhancements[calc.slug] ?? []), ...(tradeFaqEnhancements[calc.slug] ?? [])];
const seoDescriptionOverrides: Record<string, string> = {
  "crushed-stone-calculator": calc.description,
  "gravel-weight-calculator": calc.description,
  "concrete-cost-calculator": calc.description,
  "slab-cost-calculator": calc.description,
  "drywall-joint-compound-calculator": calc.description,
  "roofing-shingle-calculator": calc.description,
  "shingle-quantity-calculator": calc.description,
  "shingle-cost-calculator": calc.description,
  "rebar-chair-calculator": calc.description,
  "beam-calculator": calc.description,
  "concrete-wall-calculator": calc.description,
  "earthwork-calculator": calc.description,
  "parking-lot-calculator": calc.description,
  "parking-lot-cost-calculator": calc.description,
  "wall-framing-calculator": calc.description,
  "mortar-calculator": calc.description,
  "drywall-sheet-calculator": calc.description,
  "drywall-calculator": calc.description,
  "concrete-crack-repair-calculator": calc.description,
  "deck-mud-calculator": calc.description,
  "stucco-calculator": calc.description,
  "foundation-cost-calculator": calc.description,
  "masonry-cost-calculator": calc.description,
  "brick-cost-calculator": calc.description,
  "cmu-cost-calculator": calc.description,
};
const seoDescription = pageSeo?.description ?? (enhancedTradeCluster.has(calc.cluster) ? calc.description : (seoDescriptionOverrides[calc.slug] ?? content.description));
const seoTitle = pageSeo?.title ?? calc.title;
const pageGuidance = pageSeo?.guidance ?? tradeGuidance[calc.slug] ?? [];
const newCalculatorSlugs = new Set([
  "deck-mud-calculator",
  "stucco-calculator",
  "concrete-crack-repair-calculator",
]);
const datePublished = newCalculatorSlugs.has(calc.slug) ? "2026-09-24" : "2026-08-29";
const pageDateModified = enhancedTradeCluster.has(calc.cluster) ? "2026-09-25" : "2026-09-24";
---

<CalculatorLayout
  title={seoTitle}
  description={seoDescription}
  h1={calc.h1}
  intro={seoDescription}
  breadcrumbs={breadcrumbs}
  related={related}
  faq={faq}
  canonical={`/${calc.slug}/`}
  ogImage={ogImage}
  datePublished={datePublished}
  dateModified={pageDateModified}
  noindex={false}
>
  <Header slot="header" />
  <GenericCalculator slot="calculator" id={calc.slug} resultTitle={`${calc.h1.toUpperCase()} ESTIMATE`} />
  <section class="space-y-6">
    <div class="rounded-lg border border-hairline bg-canvas p-6">
      <h2 class="text-display-sm font-semibold tracking-[-0.03em] text-ink">What Does It Calculate?</h2>
      <ul class="mt-3 list-disc space-y-2 pl-5 text-sm leading-6 text-body">
        {content.outputs.map(item => <li>{item}</li>)}
      </ul>
      {model.fields.some(f => f.id === 'price' && f.optional) && <p class="mt-3 text-sm text-body">A cost estimate appears when you enter a price. The price unit and assumptions define which material is included.</p>}
    </div>
    <div class="rounded-lg border border-hairline bg-canvas p-6">
      <h2 class="text-display-sm font-semibold tracking-[-0.03em] text-ink">How to Use the Calculator</h2>
      <ol class="mt-3 list-decimal space-y-2 pl-5 text-sm leading-6 text-body">
        {content.instructions.map(step => <li>{step}</li>)}
      </ol>
    </div>
    {pageGuidance.length > 0 && (
      <div class="rounded-lg border border-hairline bg-canvas p-6">
        <h2 class="text-display-sm font-semibold tracking-[-0.03em] text-ink">When to Use This Calculator</h2>
        <ul class="mt-3 list-disc space-y-2 pl-5 text-sm leading-6 text-body">
          {pageGuidance.map(item => <li>{item}</li>)}
        </ul>
      </div>
    )}
    <div class="rounded-lg border border-hairline bg-canvas p-6">
      <h2 class="text-display-sm font-semibold tracking-[-0.03em] text-ink">Formula &amp; Method</h2>
      <p class="mt-3 rounded-md bg-canvas-soft-2 p-4 font-mono text-sm leading-6 text-ink break-words">{model.formula}</p>
      <dl class="mt-4 space-y-3 text-sm leading-6 text-body">
        {content.fields.map(field => <div><dt class="font-semibold text-ink">{field.label}</dt><dd>{field.help || (field.unit ? `Select the unit matching your measurement. Initial unit: ${unitLabels[field.unit] ?? field.unit}.` : 'Enter this quantity as a number.')}</dd></div>)}
      </dl>
    </div>
    <div class="rounded-lg border border-hairline bg-canvas p-6">
      <h2 class="text-display-sm font-semibold tracking-[-0.03em] text-ink">Worked Example</h2>
      <p class="mt-2 text-sm leading-6 text-body">{content.exampleNote}</p>
      <ul class="mt-3 list-disc pl-5 space-y-1 text-sm text-body">{content.inputs.map(input => <li>{input}</li>)}</ul>
      <ol class="mt-4 list-decimal pl-5 space-y-2 text-sm leading-6 text-body">{content.example.steps.map(step => <li>{step}</li>)}</ol>
      <div class="mt-4 overflow-x-auto rounded-md border border-hairline" role="region" aria-label="Worked example results" tabindex="0">
        <table class="w-full text-left text-sm">
          <caption class="sr-only">{calc.h1} worked example results</caption>
          <thead class="bg-canvas-soft"><tr><th scope="col" class="px-3 py-2">Result</th><th scope="col" class="px-3 py-2">Value</th></tr></thead>
          <tbody class="divide-y divide-hairline">
            {content.example.rows.map(r => <tr><th scope="row" class="px-3 py-2 text-body font-normal">{r.label}</th><td class="px-3 py-2 font-mono text-ink">{fmt(r.value)} {unitLabels[r.unit] ?? r.unit}</td></tr>)}
          </tbody>
        </table>
      </div>
    </div>
    <div class="rounded-lg border border-hairline bg-canvas p-6">
      <h2 class="text-display-sm font-semibold tracking-[-0.03em] text-ink">Assumptions &amp; Limitations</h2>
      <ul class="mt-3 list-disc pl-5 space-y-2 text-sm leading-6 text-body">{model.assumptions.map(a => <li>{a}</li>)}</ul>
      {technicalSources.length > 0 && <div class="mt-4"><h3 class="font-semibold text-ink">Technical references</h3><ul class="mt-2 list-disc pl-5 text-sm space-y-2">{technicalSources.map(url => <li><a class="text-primary underline break-words" href={url} rel="noopener">{sourceLabel(url)}</a></li>)}</ul></div>}
      {benchmarkSourceCount > 0 && <p class="mt-3 text-xs leading-5 text-mute">Competitor calculators were reviewed only for product/UX benchmarking and are not presented here as technical authorities.</p>}
      <p class="mt-4 text-sm leading-6 text-body">Use your product specifications and project measurements when ordering. These estimates do not select structural sizes or establish code compliance.</p>
    </div>
  </section>
  <Footer slot="footer" />
</CalculatorLayout>
