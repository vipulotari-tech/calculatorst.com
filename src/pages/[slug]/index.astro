import { hubCalculators } from "../../data/hubCalculators";
import { calculatorDetails } from "../../data/calculatorDetails";
import { calculators } from "../../data/calculators";
import { getWasteDefault, getCalcCategory } from "../../lib/registry";

export async function getStaticPaths() {
  const existingSlugs = new Set(calculators.map(c => c.slug));
  const filtered = hubCalculators.filter(c => !existingSlugs.has(c.slug));
  return filtered.map((calc) => ({
    params: { slug: calc.slug },
    props: { calc },
  }));
}

const { calc } = Astro.props;
const details = calculatorDetails[calc.slug] || {};

function getInputsForCalc(calc) {
  const slug = calc.slug;
  const name = calc.h1.toLowerCase();
  // Concrete specials
  if (slug === "concrete-column-calculator") {
    return [
      { id: "diameter", label: "Diameter", placeholder: "12", required: true, units: ["in","ft","cm","mm"], unit: "in" },
      { id: "height", label: "Height", placeholder: "8", required: true, units: ["ft","m","in","yd"], unit: "ft" },
      { id: "count", label: "Number of columns", placeholder: "1", required: false, units: undefined, unit: undefined },
