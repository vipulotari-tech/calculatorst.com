    guidance: [
      "Use this broad calculator when you need one concrete estimator for common rectangular and cylindrical pours.",
      "Choose the project shape first, then enter actual field dimensions. The calculator converts mixed US or metric units before applying quantity and waste.",
      "For truck scheduling, mix proportions, wall openings or stair geometry, use the dedicated calculator linked below because those pages expose project-specific inputs."
    ],
    faq: [
      { q: "How many cubic yards of concrete do I need?", a: "Select the shape and enter its dimensions. The calculator converts the geometric volume to cubic feet and cubic yards, then applies the waste allowance you enter." },
      { q: "How many bags of concrete equal one cubic yard?", a: "Bag count depends on the product yield. This calculator uses the entered yield and also shows standard comparison counts. Always verify the yield printed on the exact bag you plan to buy." },
      { q: "Should I use the Concrete Calculator or Concrete Volume Calculator?", a: "Use this page for a broad order estimate including bags, weight and optional cost. Use the Concrete Volume Calculator when you mainly want geometry and cubic-volume conversions across several shapes." },
      { q: "Does this calculator choose slab thickness or reinforcement?", a: "No. Thickness, reinforcement, subbase and structural requirements must come from the project plans, local requirements or a qualified designer. This tool converts those inputs into material quantity." }
    ]
  },
  "concrete-volume-calculator": {
    title: "Concrete Volume Calculator — Cubic Yards for 6 Shapes",
    description: "Find concrete volume in cubic feet, cubic yards and cubic meters for rectangles, cylinders, tubes, curbs, stairs and wedges, with waste allowance.",
    guidance: [
      "Use this page when geometry is the main question and you need volume conversions rather than truck logistics or a detailed cost breakdown.",
      "The shape selector changes the required dimensions, so only measurements for the active geometry are used.",
      "Break irregular pours into non-overlapping simple shapes, calculate each section separately, then add the order quantities."
    ],
    faq: [
      { q: "What shapes can the concrete volume calculator handle?", a: "It supports rectangular prisms, solid cylinders, hollow tubes, curb-and-gutter sections, solid stair geometry and triangular wedges." },
      { q: "How do I convert cubic feet of concrete to cubic yards?", a: "Divide cubic feet by 27. The calculator performs this conversion before applying your selected waste allowance." },
      { q: "Can I mix inches, feet and metric units?", a: "Yes. Select the unit beside each measurement. The calculator normalizes the dimensions before evaluating the shape formula." },
      { q: "How should I calculate an L-shaped or irregular slab?", a: "Split the pour into rectangles or other non-overlapping shapes, calculate each piece, and add the volumes. Do not count overlapping areas twice." }
    ]
  },
  "concrete-weight-calculator": {
