  if (slug === "concrete-curb-calculator") {
    return [
      { id: "length", label: "Curb Length", placeholder: "20", required: true, units: ["ft","m","yd"], unit: "ft" },
      { id: "curb_width", label: "Curb Width", placeholder: "6", required: true, units: ["in","ft","cm"], unit: "in" },
