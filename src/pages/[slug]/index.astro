    guidance: [
      "Use this page after the pour dimensions are known and the next question is delivery logistics rather than geometry alone.",
      "Truck count is rounded up from order yards ÷ truck capacity, while the final-load size shows how much material remains on the last load.",
      "Short-load rules vary by supplier; enter the supplier minimum and surcharge from the actual quote."
    ],
    faq: [
      { q: "How many concrete trucks do I need?", a: "The calculator divides the waste-adjusted cubic yards by the truck capacity you enter and rounds up to a whole number of loads." },
      { q: "What is a short-load concrete fee?", a: "It is a supplier surcharge that may apply when a delivery is below a minimum load size. Enter your supplier's minimum order and quoted surcharge." },
      { q: "How is concrete pump time estimated?", a: "Estimated duration equals total cubic yards divided by the pumping rate you enter. Setup, cleanup, repositioning and delays are not included." },
      { q: "Can I price a pour by cubic foot, bag or ton?", a: "Yes. Select the matching price unit. The calculator converts the order quantity to that basis before adding any short-load surcharge." }
    ]
  },
  "concrete-footing-calculator": {
    title: "Concrete Footing Calculator — Strip, Pad & Round Footings",
