---
import CalculatorLayout from "../../components/CalculatorLayout.astro";
import Header from "../../components/Header.astro";
import Footer from "../../components/Footer.astro";
import GenericCalculator from "../../components/calculators/GenericCalculator.astro";
import { hubCalculators } from "../../data/hubCalculators";
import { getCalculatorContent } from "../../lib/calculator-content";
import { fmt, unitLabels } from "../../lib/calculator-math";
import { calculators, type CalculatorMeta } from "../../data/calculators";
import { getModelForSlug } from "../../lib/calculator-registry";
import { getWorkflowRelated } from "../../lib/workflow-adjacency";

export async function getStaticPaths() {
  const existingSlugs = new Set(calculators.map(c => c.slug));
  const filtered = hubCalculators.filter(c => !existingSlugs.has(c.slug));
  return filtered.map((calc) => ({
    params: { slug: calc.slug },
    props: { calc },
  }));
}

const { calc } = Astro.props;
const model = getModelForSlug(calc.slug);
const content = getCalculatorContent(calc.h1, model);

const clusterToSlug: Record<string, string> = {
  concrete: "concrete",
  slab: "slab-patio-driveway",
  foundation: "foundation",
  rebar: "rebar",
  brick: "brick-masonry",
  cmu: "concrete-block",
  mortar: "mortar-grout-cement",
  gravel: "gravel",
  excavation: "excavation",
  framing: "framing",
  roofing: "roofing",
  flooring: "flooring",
  drywall: "drywall-paint",
  "deck-fence": "deck-fence",
  landscaping: "landscaping",
  asphalt: "asphalt",
};

const categorySlug = clusterToSlug[calc.cluster] || calc.cluster;
const workflowSlugs = getWorkflowRelated(calc.slug);
const hubBySlug = new Map(hubCalculators.map(c => [c.slug, c]));
const related = workflowSlugs
  .map(slug => hubBySlug.get(slug))
  .filter((c): c is (CalculatorMeta & { cluster: string; category: string }) => c !== undefined)
  .slice(0, 6)
  .map(c => ({
    title: c.h1,
    href: `/${c.slug}/`,
    desc: c.description.slice(0, 60) + "..."
  }));

const breadcrumbs = [
  { label: "Home", href: "/" },
  { label: "Construction", href: "/construction/" },
  { label: calc.category, href: `/construction/${categorySlug}/` },
  { label: calc.h1 },
];

const ogClusterMap: Record<string, string> = {
  concrete: "/og-concrete.png",
  slab: "/og-concrete.png",
  foundation: "/og-concrete.png",
  rebar: "/og.png",
  brick: "/og.png",
  cmu: "/og.png",
  mortar: "/og.png",
  gravel: "/og-gravel.png",
  excavation: "/og-gravel.png",
  framing: "/og-deck.png",
  roofing: "/og-roof-pitch.png",
  flooring: "/og-paver.png",
  drywall: "/og-paver.png",
  "deck-fence": "/og-deck.png",
  landscaping: "/og-paver.png",
  asphalt: "/og-paver.png",
};

const ogImage = ogClusterMap[calc.cluster] ?? "/og.png";
const faqEnhancements: Record<string, { q: string; a: string }[]> = {
  "parking-lot-cost-calculator": [
    { q: "What does the asphalt parking lot cost estimate include?", a: "It calculates compacted asphalt volume and tons, then prices the asphalt from your selected per-ton or per-cubic-yard quote. You can also enter material tax, delivery/trucking and a fixed labor or equipment amount." },
    { q: "Does this include base, milling, striping or drainage?", a: "Not automatically. Those scope items vary by project. Add only costs that belong in the fixed labor/equipment amount, or estimate separate material layers with the related calculators." },
  ],
  "gravel-weight-calculator": [
    { q: "Can I calculate gravel weight from square feet instead of cubic yards?", a: "Yes. Choose known area plus depth, or enter length, width and depth. If you already know the volume, choose the known-volume mode." },
    { q: "Why does the gravel weight calculator ask for density?", a: "Weight per cubic yard changes with gravel type, grading, moisture and compaction. Enter a density that matches the material and condition you are estimating instead of relying on one universal value." },
  ],
  "crushed-stone-calculator": [
    { q: "Can I calculate crushed stone from square feet or an existing cubic-yard volume?", a: "Yes. Choose dimensions, known surface area plus depth, or known volume. The calculator normalizes the selected measurements before applying your allowance and density." },
    { q: "What density should I use for crusher run, crushed concrete or crushed stone?", a: "Use the bulk density supplied for the exact material and condition you are ordering. Grading, moisture and compaction can change weight per cubic yard, so the density is editable instead of being hard-coded." },
    { q: "How are tons calculated from cubic yards?", a: "The calculator multiplies waste-adjusted cubic yards by the bulk density you enter in US tons per cubic yard. The same result is also shown in pounds." },
  ],
  "roofing-shingle-calculator": [
    { q: "How does the roofing shingle calculator estimate bundles?", a: "Use either building footprint plus pitch or a known sloped roof area. The calculator applies the entered material allowance, divides by the product’s effective bundle or package coverage, and rounds up to a whole package count." },
    { q: "Is a roofing square the same as a bundle of shingles?", a: "No. A roofing square is 100 square feet of roof surface. Bundle coverage varies by product, so enter the manufacturer’s effective package coverage rather than assuming a fixed number of bundles per square." },
  ],
  "rebar-chair-calculator": [
    { q: "How is the rebar chair count calculated?", a: "The calculator lays out a rectangular support grid using the maximum spacing you enter, counts support positions along both slab dimensions, multiplies the grid counts, then adds the purchasing allowance." },
    { q: "Does this calculator choose the correct rebar chair spacing or height?", a: "No. Spacing, chair height, support type, edge setbacks and load capacity must come from the reinforcement support plan or project specification. This tool converts an already selected layout into a quantity." },
  ],
  "beam-calculator": [
    { q: "Which beam load cases are included?", a: "The calculator includes a simply supported beam with a full-span uniform load, a simply supported beam with one center point load, a cantilever with a full-span uniform load, and a cantilever with one point load at the free end." },
    { q: "Does the beam calculator tell me what beam size is safe?", a: "No. It calculates idealized elastic reactions, bending moment, shear and deflection from the inputs. It does not select a member or check allowable capacity, bearing, buckling, connections or code load combinations." },
  ],
  "cmu-cost-calculator": [
    { q: "How does the CMU cost calculator work?", a: "It calculates the net wall area, converts that area to whole CMU blocks using the entered block dimensions and mortar-joint width, applies the purchasing allowance, then prices the blocks using your unit price plus any tax, delivery and labor/equipment amounts you enter." },
    { q: "Does the CMU cost estimate include mortar, grout or rebar?", a: "No. Those are separate material takeoffs because wall reinforcement and grouting requirements vary by project. Use the related mortar, grout and reinforcement calculators when those items are required." },
  ],
  "slab-cost-calculator": [
    { q: "How is concrete pad or slab material cost calculated?", a: "The calculator converts the entered pad or slab dimensions and thickness to concrete volume, applies the purchasing allowance, then multiplies the order quantity by the material price you enter." },
    { q: "Does the slab cost estimate include rebar, base, forms or labor?", a: "Not unless the calculator explicitly provides and you enter those cost items. Use the related calculators for reinforcement, base and other project materials; contractor labor and site conditions can vary widely." },
  ],
  "drywall-sheet-calculator": [
    { q: "How many Sheetrock or drywall sheets do I need?", a: "Enter the total surface area you plan to cover and the actual sheet length and width. The calculator divides the area by sheet coverage, applies the purchasing allowance and rounds up to whole sheets." },
    { q: "Can I use 4×8, 4×10 or 4×12 drywall sheets?", a: "Yes. Enter the actual sheet dimensions you plan to buy. The sheet count changes with the selected sheet area and the waste allowance." },
  ],
  "foundation-cost-calculator": [
    { q: "What costs are included in the foundation estimate?", a: "The calculator prices the concrete quantity from your quoted cost per cubic yard, then adds the material tax, delivery or short-load fees and any labor/equipment allowance you enter. Excavation, forms, reinforcement, waterproofing, drainage, engineering and permits are not automatically included." },
    { q: "Can it estimate slab, pier and strip-footing foundations?", a: "Yes. Select a slab or pad, concrete piers, or a continuous strip footing and enter the dimensions from your project requirements. The calculator converts that geometry to concrete yards before applying your cost inputs." },
  ],
  "concrete-wall-calculator": [
    { q: "Can I subtract doors and windows from a concrete wall?", a: "Yes. Enter the opening area once so the calculator deducts it from the gross wall face before converting the remaining wall volume to concrete quantity." },
    { q: "Does the concrete wall calculator choose wall thickness or reinforcement?", a: "No. Enter the wall thickness from your project requirements. The calculator estimates material quantity; structural thickness and reinforcement must be determined separately." },
  ],
  "earthwork-calculator": [
    { q: "What is the difference between bank volume and loose volume?", a: "Bank volume is the material in place before excavation. Loose volume applies the swell percentage you enter to estimate the excavated haul volume after the soil is disturbed." },
    { q: "Does the earthwork calculator add a waste or compaction factor?", a: "No. It applies only the swell factor shown in the form. Overbreak, working room, shrinkage, compaction and unsuitable material must be measured or handled separately for the project." },
  ],
};
const concreteSeo: Record<string, {
  title: string;
  description: string;
  guidance: string[];
  faq: { q: string; a: string }[];
}> = {
  "concrete-calculator": {
