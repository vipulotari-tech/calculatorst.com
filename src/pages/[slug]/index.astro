  },
  "concrete-ramp-calculator": {
    title: "Concrete Ramp Calculator — Slope, Yards & Landing Volume",
    description: "Calculate concrete ramp volume from run, width and high/low thickness, plus landing volume, slope ratio, percent and angle, with yards, bags, weight and cost.",
    guidance: [
      "The ramp body is treated as a trapezoidal prism using the average of the low- and high-end thicknesses.",
      "Slope is calculated from the absolute thickness/elevation change divided by horizontal run.",
      "The displayed 1:12 comparison is a slope screening aid only; accessibility compliance includes many other dimensional and site requirements."
    ],
    faq: [
