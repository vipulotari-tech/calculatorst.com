      { q: "How is a round footing calculated?", a: "The calculator uses cylinder volume: π × radius² × depth × quantity." },
      { q: "Does the calculator size the footing for soil bearing capacity?", a: "No. It converts already-selected footing dimensions to concrete quantity. Footing width, depth and reinforcement are design inputs." }
    ]
  },
  "concrete-foundation-calculator": {
    title: "Concrete Foundation Calculator — Walls, Footings, Slab & Piers",
    description: "Estimate total foundation concrete by combining wall, continuous footing, slab and round pier volumes, with wall-opening deductions, waste, bags and weight.",
    guidance: [
      "Enter zero for any foundation component that is not part of the project; the calculator sums only the components you include.",
      "Wall openings are entered as area and converted to deducted volume using the wall thickness.",
      "Use this page for a combined takeoff. Use the dedicated wall, footing or column calculators when you need more component-specific outputs."
    ],
    faq: [
      { q: "What foundation components can I combine?", a: "The calculator can combine foundation walls, continuous footings, a slab and round concrete piers into one total concrete order." },
      { q: "How are door and window openings deducted from a foundation wall?", a: "Enter the total opening area. The calculator multiplies that area by wall thickness to convert it to opening volume before subtracting it." },
      { q: "Can I calculate a pier-only or footing-only foundation?", a: "Yes. Set unused component dimensions to zero and enter only the component that applies." },
      { q: "Does this calculator design the foundation?", a: "No. Wall thickness, footing size, slab thickness, pier dimensions and reinforcement must come from the project requirements or a qualified designer." }
    ]
  },
  "concrete-wall-calculator": {
    title: "Concrete Wall Calculator — Yards with Opening Deductions",
    description: "Calculate concrete wall volume from length, height and thickness, deduct total door and window opening area, then estimate yards, bags, weight, forms and cost.",
