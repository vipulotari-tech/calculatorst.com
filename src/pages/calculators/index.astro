---
import Layout from "../../layouts/Layout.astro";
import Header from "../../components/Header.astro";
import Footer from "../../components/Footer.astro";
import Breadcrumbs from "../../components/Breadcrumbs.astro";
import { calculators } from "../../data/calculators";
import { hubCalculators } from "../../data/hubCalculators";
const allCalculators = [...calculators];
const existing = new Set(calculators.map(c=>c.slug));
for (const h of hubCalculators) if (!existing.has(h.slug)) allCalculators.push(h as any);
---

<Layout title="All Calculators — Calculator Street" description="All Calculator Street construction calculators — concrete, gravel, rebar, roofing, flooring, decking & more. Fast, US-focused & free.">
  <Header />
  <main id="main" tabindex="-1" class="mx-auto max-w-[1400px] px-6 py-6 max-md:px-4">
    <Breadcrumbs items={[{ label: "Home", href: "/" }, { label: "All Calculators" }]} />
    <div class="mx-auto max-w-[900px] pt-4">
      <h1 class="text-display-lg font-semibold tracking-[-0.04em] text-ink">All Calculators</h1>
      <p class="mt-2 text-sm leading-6 text-body">Construction calculators — US-focused, static, private and mobile-first. Every tool runs 100% in your browser.</p>
      <div class="mt-6">
        <input id="calc-search" type="search" placeholder="Search calculators… try concrete slab, roof pitch, gravel..." class="h-11 w-full rounded-sm border border-hairline bg-canvas px-4 text-sm placeholder:text-mute focus:border-link focus:outline-none focus:ring-2 focus:ring-link/20" />
      </div>
      <div class="mt-4 flex flex-wrap gap-2" role="group" aria-label="Filter by category">
        <button type="button" data-filter="" class="filter-btn rounded-full bg-primary px-3 py-1.5 text-xs font-medium text-on-primary">All</button>
        <button type="button" data-filter="concrete" class="filter-btn rounded-full border border-hairline bg-canvas px-3 py-1.5 text-xs font-medium text-body hover:bg-canvas-soft">Concrete</button>
        <button type="button" data-filter="gravel" class="filter-btn rounded-full border border-hairline bg-canvas px-3 py-1.5 text-xs font-medium text-body hover:bg-canvas-soft">Gravel & Aggregate</button>
        <button type="button" data-filter="rebar" class="filter-btn rounded-full border border-hairline bg-canvas px-3 py-1.5 text-xs font-medium text-body hover:bg-canvas-soft">Rebar</button>
        <button type="button" data-filter="roofing" class="filter-btn rounded-full border border-hairline bg-canvas px-3 py-1.5 text-xs font-medium text-body hover:bg-canvas-soft">Roofing</button>
        <button type="button" data-filter="flooring" class="filter-btn rounded-full border border-hairline bg-canvas px-3 py-1.5 text-xs font-medium text-body hover:bg-canvas-soft">Flooring & Tile</button>
        <button type="button" data-filter="framing" class="filter-btn rounded-full border border-hairline bg-canvas px-3 py-1.5 text-xs font-medium text-body hover:bg-canvas-soft">Framing & Lumber</button>
        <button type="button" data-filter="deck-fence" class="filter-btn rounded-full border border-hairline bg-canvas px-3 py-1.5 text-xs font-medium text-body hover:bg-canvas-soft">Deck & Fence</button>
      </div>
      <ul id="calc-list" class="mt-6 grid gap-4 sm:grid-cols-2" role="list">
        {allCalculators.map(c => (
          <li data-title={c.title.toLowerCase()} data-desc={c.description.toLowerCase()} data-category={c.category.toLowerCase()} data-cluster={c.cluster.toLowerCase()}>
            <a href={`/${c.slug}/`} class="flex h-full flex-col rounded-md border border-hairline bg-canvas p-5 shadow-card transition hover:shadow-card-hover dark:bg-canvas">
              <h2 class="text-sm font-semibold text-ink">{c.title.split(" —")[0]}</h2>
              <p class="mt-1 line-clamp-2 text-sm leading-5 text-body">{c.description}</p>
              <span class="mt-3 text-xs font-mono tracking-wide text-mute">{c.category.toUpperCase()}</span>
            </a>
          </li>
        ))}
      </ul>
    </div>
  </main>
  <Footer />
  <script is:inline>
    const input = document.getElementById("calc-search");
    const list = document.getElementById("calc-list");
    const filterBtns = document.querySelectorAll(".filter-btn");
    let activeFilter = "";
    function applyFilter() {
      const q = (input?.value || "").toLowerCase().trim();
      const items = list ? Array.from(list.children) : [];
      items.forEach(li => {
        const title = li.getAttribute("data-title") || "";
        const desc = li.getAttribute("data-desc") || "";
        const cat = li.getAttribute("data-category") || "";
        const cluster = li.getAttribute("data-cluster") || "";
        const matchesSearch = !q || title.includes(q) || desc.includes(q);
        const matchesFilter = !activeFilter || cat.includes(activeFilter) || cluster.includes(activeFilter);
        li.style.display = (matchesSearch && matchesFilter) ? "" : "none";
      });
    }
    if (input && list) {
      input.addEventListener("input", applyFilter);
      filterBtns.forEach(btn => {
        btn.addEventListener("click", () => {
          activeFilter = btn.getAttribute("data-filter") || "";
          filterBtns.forEach(b => {
            const isActive = b.getAttribute("data-filter") === activeFilter;
            b.className = isActive ? "filter-btn rounded-full bg-primary px-3 py-1.5 text-xs font-medium text-on-primary" : "filter-btn rounded-full border border-hairline bg-canvas px-3 py-1.5 text-xs font-medium text-body hover:bg-canvas-soft";
          });
          applyFilter();
        });
      });
    }
  </script>
</Layout>
