---
import { searchCatalog as hubCalculators } from "../../lib/search";
import Layout from "../../layouts/Layout.astro";
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
---

<Layout
  title="Calculators — Calculator Street"
  description="Browse the complete library of construction calculators — concrete, gravel, roofing, flooring, deck, fence and more. Every tool is free, private, and mobile-friendly."
  canonical="/calculators/"
>
  <Header />
  <main id="main" tabindex="-1" class="mx-auto max-w-[1200px] px-4 sm:px-6 py-6">
    <h1 class="text-display-lg font-semibold tracking-[-0.04em] text-foreground sm:text-display-xl">Calculators</h1>
    <p class="mt-2 text-body-md leading-6 text-muted-foreground">{hubCalculators.length} calculators across construction categories. Search or browse by category.</p>

    <div class="mt-6">
      <label for="calc-search" class="sr-only">Search calculators</label>
      <div class="relative max-w-md">
        <span class="pointer-events-none absolute left-4 top-1/2 -translate-y-1/2 text-muted-foreground/50" aria-hidden="true">
          <svg width="16" height="16" viewBox="0 0 16 16" fill="none"><path d="M11.2 11.2L13.8 13.8M12.3 7.3a4.95 4.95 0 1 1-9.9 0 4.95 4.95 0 0 1 9.9 0Z" stroke="currentColor" stroke-width="1.35" stroke-linecap="round"/></svg>
        </span>
        <input id="calc-search" type="search" placeholder="Search calculators…" class="h-[48px] w-full rounded-xl border border-border bg-card pl-11 pr-4 text-[14px] shadow-sm placeholder:text-muted-foreground/50 focus:border-ring focus:shadow-[0_0_0_3px_rgba(100,140,255,0.08)] focus:outline-none transition-[border-color,box-shadow] duration-150" autocomplete="off" spellcheck="false" />
      </div>
    </div>

    <button id="calc-search-clear" type="button" class="mt-3 text-sm underline">Clear search</button>
    <p id="search-count" role="status" class="mt-3 text-sm text-muted-foreground"></p>
    <p id="search-empty" hidden class="mt-6">No calculators match. Try a material such as concrete, gravel, or lumber, or clear your search.</p>
    <ul class="mt-8 grid gap-4 sm:grid-cols-2 lg:grid-cols-3" role="list" id="calculator-list">
      {hubCalculators.map((c) => (
        <li data-slug={c.slug}>
          <a href={`/${c.slug}/`} class="group flex h-full flex-col rounded-xl border border-border bg-card p-6 shadow-card transition-all duration-150 hover:shadow-card-hover hover:-translate-y-0.5 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-link">
            <div class="flex items-start justify-between gap-3">
              <span class="inline-flex h-10 w-10 items-center justify-center rounded-lg border border-border bg-muted text-foreground transition-colors group-hover:bg-foreground group-hover:text-background" aria-hidden="true">
                <svg width="20" height="20" viewBox="0 0 16 16" fill="none"><path d={c.iconPath} stroke="currentColor" stroke-width="1.25" stroke-linecap="round" stroke-linejoin="round"/></svg>
              </span>
              <span class="font-mono text-[10px] tracking-wide text-muted-foreground">{c.category}</span>
            </div>
            <h2 class="mt-4 line-clamp-1 text-[17px] font-semibold tracking-[-0.02em] text-foreground">{c.h1}</h2>
            <p class="mt-2 line-clamp-2 flex-1 text-[14px] leading-6 text-muted-foreground">{c.description}</p>
            <span class="mt-4 inline-flex items-center gap-1 font-mono text-[12px] font-medium tracking-wide text-muted-foreground group-hover:text-foreground transition-colors">
              Calculate <span class="transition-transform group-hover:translate-x-0.5" aria-hidden="true">→</span>
            </span>
          </a>
        </li>
      ))}
    </ul>
  </main>
  <Footer />
</Layout>

<script>
  import { searchCalculators } from '../../lib/search';
  const input = document.querySelector<HTMLInputElement>("#calc-search");
  const list = document.getElementById("calculator-list");
  if (input && list) {
    const render = () => {
      const hits = searchCalculators(input.value);
      const ranks = new Map(hits.map((c,i) => [c.slug,i]));
      list.querySelectorAll<HTMLLIElement>('li').forEach(li => {
        li.hidden = !ranks.has(li.dataset.slug!);
        li.style.order = String(ranks.get(li.dataset.slug!) ?? 0);
      });
      document.getElementById('search-count')!.textContent = `${hits.length} calculator${hits.length === 1 ? '' : 's'} found`;
      document.getElementById('search-empty')!.hidden = hits.length > 0;
      const url = new URL(location.href);
      if (input.value) url.searchParams.set('q',input.value); else url.searchParams.delete('q');
      history.replaceState(null,'',url);
    };
    input.value = new URL(location.href).searchParams.get('q') ?? '';
    input.addEventListener('input',render);
    document.getElementById('calc-search-clear')?.addEventListener('click', () => { input.value = ''; render(); input.focus(); });
    render();
  }
</script>
