---
import { searchCatalog as hubCalculators } from "../../lib/search";
import Layout from "../../layouts/Layout.astro";
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
---

<Layout
  title="Calculators — Calculator Street"
  description="Browse the complete library of construction calculators — concrete, gravel, roofing, flooring, deck, fence and more. Every tool is free, private, and mobile-friendly."
  canonical="/calculators/"
>
  <Header />
  <main id="main" tabindex="-1" class="mx-auto max-w-[1200px] px-4 sm:px-6 py-6">
    <h1 class="text-display-lg font-semibold tracking-[-0.04em] text-foreground sm:text-display-xl">Calculators</h1>
    <p class="mt-2 text-body-md leading-6 text-muted-foreground">{hubCalculators.length} calculators across construction categories. Search or browse by category.</p>

    <div class="relative z-20 mt-7 w-full max-w-[680px]">
      <label for="calc-search" class="sr-only">Search calculators</label>
      <div id="calc-search-shell" class="relative flex h-16 items-center rounded-2xl border border-border bg-card shadow-search transition-[border-color,box-shadow] duration-200 focus-within:border-link/30 focus-within:shadow-search-focus">
        <span class="pointer-events-none ml-2.5 inline-flex h-11 w-11 shrink-0 items-center justify-center rounded-xl bg-foreground text-background" aria-hidden="true">
          <svg width="18" height="18" viewBox="0 0 16 16" fill="none"><path d="M11.2 11.2L13.8 13.8M12.3 7.3a4.95 4.95 0 1 1-9.9 0 4.95 4.95 0 0 1 9.9 0Z" stroke="currentColor" stroke-width="1.35" stroke-linecap="round"/></svg>
        </span>
        <input id="calc-search" type="search" role="combobox" aria-autocomplete="list" aria-controls="calc-search-suggestions" aria-expanded="false" placeholder="Try “concrete”, “roof pitch”, or “fence cost”" class="h-full min-w-0 flex-1 bg-transparent px-3 text-[15px] font-medium tracking-[-0.01em] text-foreground placeholder:font-normal placeholder:text-muted-foreground/60 focus:outline-none sm:px-4 sm:text-[16px]" autocomplete="off" spellcheck="false" />
        <button id="calc-search-clear" type="button" hidden class="mr-2.5 shrink-0 rounded-lg border border-border bg-muted px-2.5 py-1.5 font-mono text-[11px] text-muted-foreground transition-colors hover:border-foreground/15 hover:text-foreground focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring">Clear</button>
      </div>
      <div id="calc-search-suggestions" role="listbox" aria-label="Calculator suggestions" hidden class="absolute left-0 right-0 top-[72px] z-30 max-h-[min(480px,65vh)] overflow-auto rounded-2xl border border-border bg-card shadow-float"></div>
      <div class="mt-3 flex flex-wrap items-center gap-1.5" aria-label="Popular searches">
        <span class="mr-1 font-mono text-[10px] font-medium uppercase tracking-[0.1em] text-muted-foreground">Popular</span>
        {['Concrete', 'Roofing', 'Gravel', 'Flooring', 'Fence'].map((query) => (
          <button type="button" data-search-query={query} class="rounded-full border border-border bg-card px-3 py-1.5 font-mono text-[11px] text-muted-foreground shadow-sm transition-[border-color,color,transform] hover:-translate-y-px hover:border-foreground/20 hover:text-foreground focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring">{query}</button>
        ))}
      </div>
    </div>

    <p id="search-count" role="status" class="mt-3 text-sm text-muted-foreground"></p>
    <p id="search-empty" hidden class="mt-6">No calculators match. Try a material such as concrete, gravel, or lumber, or clear your search.</p>
    <ul class="mt-8 grid gap-4 sm:grid-cols-2 lg:grid-cols-3" role="list" id="calculator-list">
      {hubCalculators.map((c) => (
        <li data-slug={c.slug}>
          <a href={`/${c.slug}/`} class="group flex h-full flex-col rounded-xl border border-border bg-card p-6 shadow-card transition-all duration-150 hover:shadow-card-hover hover:-translate-y-0.5 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-link">
            <div class="flex items-start justify-between gap-3">
              <span class="inline-flex h-10 w-10 items-center justify-center rounded-lg border border-border bg-muted text-foreground transition-colors group-hover:bg-foreground group-hover:text-background" aria-hidden="true">
                <svg width="20" height="20" viewBox="0 0 16 16" fill="none"><path d={c.iconPath} stroke="currentColor" stroke-width="1.25" stroke-linecap="round" stroke-linejoin="round"/></svg>
              </span>
              <span class="font-mono text-[10px] tracking-wide text-muted-foreground">{c.category}</span>
            </div>
            <h2 class="mt-4 line-clamp-1 text-[17px] font-semibold tracking-[-0.02em] text-foreground">{c.h1}</h2>
            <p class="mt-2 line-clamp-2 flex-1 text-[14px] leading-6 text-muted-foreground">{c.description}</p>
            <span class="mt-4 inline-flex items-center gap-1 font-mono text-[12px] font-medium tracking-wide text-muted-foreground group-hover:text-foreground transition-colors">
              Calculate <span class="transition-transform group-hover:translate-x-0.5" aria-hidden="true">→</span>
            </span>
          </a>
        </li>
      ))}
    </ul>
  </main>
  <Footer />
</Layout>

<script>
  import { searchCalculators } from '../../lib/search';
  const input = document.querySelector<HTMLInputElement>("#calc-search");
  const list = document.getElementById("calculator-list");
  if (input && list) {
    const clearButton = document.getElementById('calc-search-clear');
    const searchCount = document.getElementById('search-count');
    const searchEmpty = document.getElementById('search-empty');
    const suggestions = document.getElementById('calc-search-suggestions');
    let activeSuggestion = -1;

    const escapeHtml = (text: string) => text.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;').replace(/"/g, '&quot;').replace(/'/g, '&#39;');
    const highlightName = (name: string, query: string) => {
      const terms = query.toLowerCase().match(/[a-z0-9]+/g)?.sort((a, b) => b.length - a.length) ?? [];
      if (!terms.length) return escapeHtml(name);
      const pattern = terms.map(term => term.replace(/[.*+?^${}()|[\]\\]/g, '\\$&')).join('|');
      return escapeHtml(name).replace(new RegExp(`(${pattern})`, 'ig'), '<mark class="rounded-sm bg-link-bg-soft px-0.5 text-foreground">$1</mark>');
    };
    const setSuggestionsOpen = (open: boolean) => {
      suggestions!.hidden = !open;
      input.setAttribute('aria-expanded', String(open));
      if (!open) {
        activeSuggestion = -1;
        input.removeAttribute('aria-activedescendant');
      }
    };
    const setActiveSuggestion = (index: number) => {
      const options = [...suggestions!.querySelectorAll<HTMLElement>('[role="option"]')];
      if (!options.length) return;
      activeSuggestion = (index + options.length) % options.length;
      options.forEach((option, i) => {
        option.dataset.active = String(i === activeSuggestion);
        option.setAttribute('aria-selected', String(i === activeSuggestion));
      });
      input.setAttribute('aria-activedescendant', options[activeSuggestion].id);
      options[activeSuggestion].scrollIntoView({ block: 'nearest' });
    };
    const renderSuggestions = (query: string, hits: ReturnType<typeof searchCalculators>) => {
      if (!query || document.activeElement !== input) {
        setSuggestionsOpen(false);
        return;
      }
      if (!hits.length) {
        suggestions!.innerHTML = `<div class="px-5 py-7 text-center"><p class="text-sm font-medium text-foreground">No calculator found for “${escapeHtml(query.slice(0, 40))}”</p><p class="mt-1 text-xs text-muted-foreground">Try a material, project, or measurement.</p></div>`;
        setSuggestionsOpen(true);
        return;
      }
      const topHits = hits.slice(0, 7);
      suggestions!.innerHTML = `<div class="flex items-center justify-between border-b border-border px-4 py-2.5"><span class="font-mono text-[10px] font-medium uppercase tracking-[0.1em] text-muted-foreground">Suggested calculators</span><span class="font-mono text-[10px] text-muted-foreground">${topHits.length} of ${hits.length}</span></div>${topHits.map((hit, index) => `<a id="calc-suggestion-${index}" href="/${encodeURIComponent(hit.slug)}/" role="option" aria-selected="false" data-active="false" class="group flex items-center gap-3 border-b border-border px-3 py-3 transition-colors last:border-0 hover:bg-muted data-[active=true]:bg-muted sm:px-4"><span class="inline-flex h-9 w-9 shrink-0 items-center justify-center rounded-xl border border-border bg-muted text-muted-foreground transition-colors group-hover:bg-foreground group-hover:text-background group-data-[active=true]:bg-foreground group-data-[active=true]:text-background" aria-hidden="true"><svg width="16" height="16" viewBox="0 0 16 16" fill="none"><path d="${escapeHtml(hit.iconPath)}" stroke="currentColor" stroke-width="1.25" stroke-linecap="round" stroke-linejoin="round"/></svg></span><span class="min-w-0 flex-1"><span class="block truncate text-[14px] font-semibold tracking-[-0.01em] text-foreground">${highlightName(hit.h1, query)}</span><span class="mt-0.5 block truncate font-mono text-[10px] uppercase tracking-[0.06em] text-muted-foreground">${escapeHtml(hit.category)}</span></span><span class="hidden max-w-[210px] truncate text-right text-[11px] text-muted-foreground sm:block">${escapeHtml(hit.description)}</span><span class="shrink-0 text-muted-foreground transition-transform group-hover:translate-x-0.5 group-hover:text-foreground" aria-hidden="true">→</span></a>`).join('')}${hits.length > topHits.length ? `<a href="#calculator-list" id="calc-view-all" class="flex items-center justify-between bg-muted/50 px-4 py-3 font-mono text-[11px] text-muted-foreground transition-colors hover:text-foreground"><span>View all ${hits.length} matching calculators</span><span aria-hidden="true">↓</span></a>` : ''}`;
      suggestions!.querySelectorAll<HTMLElement>('[role="option"]').forEach((option, index) => option.addEventListener('pointermove', () => setActiveSuggestion(index)));
      suggestions!.querySelector('#calc-view-all')?.addEventListener('click', () => setSuggestionsOpen(false));
      activeSuggestion = -1;
      setSuggestionsOpen(true);
    };
    const render = () => {
      const query = input.value.trim();
      const hits = searchCalculators(query);
      const ranks = new Map(hits.map((c,i) => [c.slug,i]));
      list.querySelectorAll<HTMLLIElement>('li').forEach(li => {
        li.hidden = !ranks.has(li.dataset.slug!);
        li.style.order = String(ranks.get(li.dataset.slug!) ?? 0);
      });
      clearButton!.hidden = !query;
      searchCount!.textContent = query ? `${hits.length} calculator${hits.length === 1 ? '' : 's'} found` : '';
      searchEmpty!.hidden = !query || hits.length > 0;
      renderSuggestions(query, hits);
      const url = new URL(location.href);
      if (query) url.searchParams.set('q',query); else url.searchParams.delete('q');
      history.replaceState(null,'',url);
    };
    input.value = new URL(location.href).searchParams.get('q') ?? '';
    input.addEventListener('input',render);
    input.addEventListener('focus', render);
    input.addEventListener('keydown', event => {
      const options = [...suggestions!.querySelectorAll<HTMLAnchorElement>('[role="option"]')];
      if (event.key === 'ArrowDown' || event.key === 'ArrowUp') {
        if (!options.length) return;
        event.preventDefault();
        setActiveSuggestion(activeSuggestion + (event.key === 'ArrowDown' ? 1 : -1));
      } else if (event.key === 'Enter' && options.length) {
        event.preventDefault();
        options[activeSuggestion >= 0 ? activeSuggestion : 0].click();
      } else if (event.key === 'Escape') {
        setSuggestionsOpen(false);
      }
    });
    clearButton?.addEventListener('click', () => { input.value = ''; render(); input.focus(); });
    document.querySelectorAll<HTMLButtonElement>('[data-search-query]').forEach(button => button.addEventListener('click', () => {
      input.value = button.dataset.searchQuery ?? '';
      input.focus();
      render();
    }));
    document.addEventListener('click', event => {
      if (!(event.target as Element).closest?.('#calc-search-shell, #calc-search-suggestions')) setSuggestionsOpen(false);
    });
    render();
  }
</script>

<style>
  #calc-search::-webkit-search-cancel-button { display: none; }
</style>
