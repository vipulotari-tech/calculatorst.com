---
import Layout from "../layouts/Layout.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import { hubCalculators, hubCategories } from "../data/hubCalculators";
import { clusterGroups, projectGroups } from "../data/subcategories";

const curatedPopularSlugs = [
  "fence-calculator",
  "concrete-calculator",
  "roof-pitch-calculator",
  "gravel-calculator",
  "deck-calculator",
  "brick-calculator",
  "rebar-calculator",
  "flooring-calculator",
  "paint-calculator",
  "excavation-calculator",
  "mortar-calculator",
  "asphalt-calculator",
];
const popular = curatedPopularSlugs.map(s => hubCalculators.find(c => c.slug === s)).filter(Boolean) as typeof hubCalculators;
const actualPopular = popular.length ? popular : hubCalculators.filter(c => c.featured).slice(0,12);
const getCalcs = (slugs: string[]) => slugs.map(s => hubCalculators.find(c => c.slug === s)).filter(Boolean) as typeof hubCalculators;
---

<Layout
  title={`Calculator Street — Free Construction & Home Improvement Calculators`}
  description={`Free construction & home improvement calculators — fast, private and mobile-friendly. Built with Astro + Tailwind CSS v4.`}
  canonical="/"
>
  <Header />
  <main id="main" tabindex="-1">
    <!-- Hero — Luxury AI / Premium Tech -->
    <section class="relative isolate overflow-hidden border-b border-hairline bg-[#FCFCF9] dark:bg-[#0A0A0B]" aria-labelledby="hero-heading">
      <!-- Premium ambient -->
      <div class="pointer-events-none absolute inset-0" aria-hidden="true">
        <div class="absolute inset-0 bg-[radial-gradient(60%_80%_at_20%_0%,rgba(120,119,198,0.08),transparent_60%),radial-gradient(50%_60%_at_80%_20%,rgba(255,119,98,0.06),transparent_60%)] dark:bg-[radial-gradient(60%_80%_at_20%_0%,rgba(120,119,198,0.15),transparent_60%),radial-gradient(50%_60%_at_80%_20%,rgba(255,119,98,0.08),transparent_60%)]"></div>
        <div class="absolute inset-0 bg-[linear-gradient(to_right,rgba(0,0,0,0.04)_1px,transparent_1px),linear-gradient(to_bottom,rgba(0,0,0,0.04)_1px,transparent_1px)] bg-[size:32px_32px] dark:bg-[linear-gradient(to_right,rgba(255,255,255,0.04)_1px,transparent_1px),linear-gradient(to_bottom,rgba(255,255,255,0.04)_1px,transparent_1px)] [mask-image:radial-gradient(ellipse_80%_50%_at_50%_0%,#000_70%,transparent_110%)]"></div>
        <div class="absolute -top-24 left-1/2 h-[600px] w-[1200px] -translate-x-1/2 bg-[radial-gradient(ellipse_at_center,rgba(120,119,198,0.10),transparent_70%)] blur-[40px] dark:bg-[radial-gradient(ellipse_at_center,rgba(120,119,198,0.18),transparent_70%)]"></div>
      </div>

      <div class="relative mx-auto max-w-[1120px] px-4 sm:px-6 py-[56px] sm:py-[72px] lg:py-[88px]">
        <!-- Eyebrow -->
        <div class="flex justify-center">
          <p class="inline-flex items-center gap-2.5 font-mono text-[11px] font-medium tracking-[0.22em] text-zinc-500 dark:text-zinc-400">
            <span class="h-px w-6 bg-zinc-300 dark:bg-zinc-700" aria-hidden="true"></span>
            CONSTRUCTION & HOME IMPROVEMENT
            <span class="h-px w-6 bg-zinc-300 dark:bg-zinc-700" aria-hidden="true"></span>
          </p>
        </div>

        <!-- Headline + Expanded Premium Subheadline -->
        <div class="mx-auto mt-6 max-w-[820px] text-center">
          <h1 id="hero-heading" class="text-[32px] font-[620] leading-[0.95] tracking-[-0.04em] sm:text-[48px] lg:text-[56px] [text-wrap:balance]">
            <span class="bg-gradient-to-b from-zinc-900 to-zinc-600 bg-clip-text text-transparent dark:from-white dark:to-zinc-400">Construction &amp; Home</span><br />
            <span class="bg-gradient-to-b from-zinc-900 to-zinc-600 bg-clip-text text-transparent dark:from-white dark:to-zinc-400">Improvement Calculators</span>
          </h1>
          <p class="mx-auto mt-5 max-w-[720px] text-[15px] leading-[1.7] font-[450] tracking-[-0.01em] text-zinc-600 dark:text-zinc-400 [text-wrap:pretty] sm:text-[17px] sm:leading-[1.7]">
            Precision-engineered intelligence for the built environment.<br class="hidden sm:block" />
            <span class="text-zinc-900 dark:text-zinc-200">201 professional-grade calculators</span> unifying material takeoffs, dimensional analysis, and cost forecasting
            — with <span class="font-medium text-zinc-900 dark:text-zinc-100">live, unit-aware computation</span>, waste optimization, and verified construction formulas for decisions you can build on.
          </p>
          <p class="mx-auto mt-3 hidden max-w-[680px] text-[13px] leading-5 text-zinc-500 dark:text-zinc-500 sm:block">
            Concrete &bull; Roofing &bull; Framing &bull; Gravel &bull; Excavation &bull; Flooring &bull; Decking &bull; Asphalt — every result validated for US customary &amp; metric.
          </p>
        </div>

        <!-- Glassmorphism Search (preserves existing search logic) -->
        <div class="mx-auto mt-9 max-w-[640px] relative">
          <label for="hero-search" class="sr-only">Search calculators</label>
          <form role="search" aria-label="Search calculators" class="group relative" onsubmit="return false">
            <div class="pointer-events-none absolute -inset-[1px] rounded-[16px] bg-gradient-to-b from-zinc-200 to-zinc-100 opacity-80 blur-[1px] group-focus-within:from-violet-200 group-focus-within:to-indigo-200 dark:from-zinc-800 dark:to-zinc-900 dark:group-focus-within:from-violet-900/40 dark:group-focus-within:to-indigo-900/40" aria-hidden="true"></div>
            <div class="relative flex items-center gap-3 rounded-[14px] border border-zinc-200/70 bg-white/80 px-4 py-3 shadow-[0_2px_16px_rgba(0,0,0,0.06),0_1px_2px_rgba(0,0,0,0.04)] backdrop-blur-xl transition-all group-focus-within:border-violet-300 group-focus-within:bg-white group-focus-within:shadow-[0_8px_32px_rgba(99,102,241,0.12)] dark:border-zinc-800 dark:bg-zinc-900/70 dark:group-focus-within:border-violet-800 dark:group-focus-within:bg-zinc-900">
              <span class="pointer-events-none shrink-0 text-zinc-400 dark:text-zinc-500" aria-hidden="true">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none"><path d="M21 21l-4.3-4.3m1.8-5.2a7.5 7.5 0 11-15 0 7.5 7.5 0 0115 0z" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/></svg>
              </span>
              <input
                id="hero-search"
                type="search"
                placeholder="Search for a calculator..."
                autocomplete="off"
                spellcheck="false"
                name="q"
                class="h-7 w-full bg-transparent text-[15px] font-[450] tracking-[-0.01em] text-zinc-900 placeholder:text-zinc-400 focus:outline-none dark:text-white dark:placeholder:text-zinc-600"
                aria-label="Search for a calculator"
              />
              <span class="hidden shrink-0 items-center gap-1 rounded-md border border-zinc-200 bg-zinc-50 px-1.5 py-1 font-mono text-[11px] font-medium leading-none tracking-wide text-zinc-500 dark:border-zinc-700 dark:bg-zinc-800 dark:text-zinc-400 sm:inline-flex" aria-hidden="true"><span class="text-[10px]">⌘</span>K</span>
            </div>
          </form>
          <div id="hero-search-results" class="absolute left-0 right-0 top-full z-20 mt-2 hidden max-h-[60vh] overflow-auto overflow-hidden rounded-xl border border-zinc-200 bg-white text-left shadow-[0_16px_40px_rgba(0,0,0,0.10)] dark:border-zinc-800 dark:bg-zinc-900" role="listbox" aria-label="Search results"></div>

          <!-- Tags -->
          <div class="mt-4 flex flex-wrap items-center justify-center gap-2">
            <span class="font-mono text-[11px] tracking-wide text-zinc-500 dark:text-zinc-500">Try —</span>
            <a href="/concrete-slab-calculator/" class="inline-flex items-center rounded-full border border-zinc-200 bg-white px-3 py-1.5 text-[13px] font-[500] tracking-[-0.01em] text-zinc-700 shadow-sm transition hover:border-zinc-300 hover:bg-zinc-50 hover:text-zinc-900 dark:border-zinc-800 dark:bg-zinc-900 dark:text-zinc-300 dark:hover:border-zinc-700 dark:hover:bg-zinc-800 dark:hover:text-white">Concrete Slab</a>
            <a href="/roof-pitch-calculator/" class="inline-flex items-center rounded-full border border-zinc-200 bg-white px-3 py-1.5 text-[13px] font-[500] tracking-[-0.01em] text-zinc-700 shadow-sm transition hover:border-zinc-300 hover:bg-zinc-50 hover:text-zinc-900 dark:border-zinc-800 dark:bg-zinc-900 dark:text-zinc-300 dark:hover:border-zinc-700 dark:hover:bg-zinc-800 dark:hover:text-white">Roof Pitch</a>
            <a href="/gravel-calculator/" class="inline-flex items-center rounded-full border border-zinc-200 bg-white px-3 py-1.5 text-[13px] font-[500] tracking-[-0.01em] text-zinc-700 shadow-sm transition hover:border-zinc-300 hover:bg-zinc-50 hover:text-zinc-900 dark:border-zinc-800 dark:bg-zinc-900 dark:text-zinc-300 dark:hover:border-zinc-700 dark:hover:bg-zinc-800 dark:hover:text-white">Gravel</a>
            <a href="/fence-cost-calculator/" class="inline-flex items-center rounded-full border border-zinc-200 bg-white px-3 py-1.5 text-[13px] font-[500] tracking-[-0.01em] text-zinc-700 shadow-sm transition hover:border-zinc-300 hover:bg-zinc-50 hover:text-zinc-900 dark:border-zinc-800 dark:bg-zinc-900 dark:text-zinc-300 dark:hover:border-zinc-700 dark:hover:bg-zinc-800 dark:hover:text-white">Fence</a>
            <a href="/deck-material-calculator/" class="inline-flex items-center rounded-full border border-zinc-200 bg-white px-3 py-1.5 text-[13px] font-[500] tracking-[-0.01em] text-zinc-700 shadow-sm transition hover:border-zinc-300 hover:bg-zinc-50 hover:text-zinc-900 dark:border-zinc-800 dark:bg-zinc-900 dark:text-zinc-300 dark:hover:border-zinc-700 dark:hover:bg-zinc-800 dark:hover:text-white">Deck</a>
          </div>

          <div class="mt-4 flex justify-center">
            <a href="/calculators/" class="group inline-flex items-center gap-1 font-mono text-[11px] font-medium tracking-wide text-zinc-500 hover:text-zinc-900 dark:text-zinc-500 dark:hover:text-zinc-300 transition-colors">Browse all calculators <span class="transition-transform group-hover:translate-x-0.5" aria-hidden="true">→</span></a>
          </div>
        </div>

        <!-- Bottom trust bar -->
        <div class="mt-7 flex justify-center">
          <p class="inline-flex flex-wrap items-center justify-center gap-x-3 gap-y-1 rounded-full border border-zinc-200/60 bg-white/60 px-4 py-2 font-mono text-[11px] tracking-wide text-zinc-500 shadow-sm backdrop-blur dark:border-zinc-800 dark:bg-zinc-900/60 dark:text-zinc-400">
            <span class="inline-flex items-center gap-1.5"><span class="h-1.5 w-1.5 rounded-full bg-emerald-500" aria-hidden="true"></span> Free</span>
            <span class="h-3 w-px bg-zinc-200 dark:bg-zinc-700" aria-hidden="true"></span>
            <span>No sign-up</span>
            <span class="h-3 w-px bg-zinc-200 dark:bg-zinc-700" aria-hidden="true"></span>
            <span>US units</span>
            <span class="h-3 w-px bg-zinc-200 dark:bg-zinc-700" aria-hidden="true"></span>
            <span class="inline-flex items-center gap-1">Works offline <span class="h-1 w-1 rounded-full bg-zinc-300 dark:bg-zinc-600" aria-hidden="true"></span> 201 tools</span>
          </p>
        </div>
      </div>
    </section>

    <!-- Popular -->
    <section id="popular" class="border-y border-border bg-background py-8 sm:py-10 lg:py-12" aria-labelledby="popular-heading">
      <div class="mx-auto max-w-[1200px] px-4 sm:px-6">
        <div class="flex flex-col gap-2 sm:flex-row sm:items-end sm:justify-between">
          <div>
            <p class="font-mono text-[10px] font-medium tracking-[0.12em] uppercase text-muted-foreground">Popular</p>
            <h2 id="popular-heading" class="mt-1.5 text-[18px] font-semibold tracking-[-0.02em] text-foreground sm:text-[20px]">Popular calculators</h2>
            <p class="mt-1 max-w-[520px] text-[13px] leading-5 text-muted-foreground">Most-used tools — a precise selection from the library.</p>
          </div>
          <a href="/calculators/" class="hidden shrink-0 items-center gap-1 font-mono text-[11px] font-medium tracking-wide text-muted-foreground transition-colors hover:text-foreground focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring sm:inline-flex">Browse all <span aria-hidden="true">→</span></a>
        </div>
        <ul class="mt-6 grid gap-2 sm:gap-3 sm:grid-cols-2 lg:grid-cols-3" role="list">
          {actualPopular.map((c) => (
            <li class="min-w-0">
              <a href={`/${c.slug}/`} class="group flex h-full flex-col rounded-xl border border-border bg-card p-4 shadow-card transition-all duration-150 hover:shadow-card-hover hover:-translate-y-0.5 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring">
                <div class="flex items-start justify-between gap-3">
                  <span class="inline-flex h-[32px] w-[32px] items-center justify-center rounded-lg border border-border bg-muted text-foreground" aria-hidden="true">
                    <svg width="16" height="16" viewBox="0 0 16 16" fill="none"><path d={c.iconPath} stroke="currentColor" stroke-width="1.25" stroke-linecap="round" stroke-linejoin="round"/></svg>
                  </span>
                  <span class="mt-1 font-mono text-[10px] tracking-wide text-muted-foreground">{c.category}</span>
                </div>
                <h3 class="mt-3 line-clamp-1 text-[15px] font-semibold tracking-[-0.02em] text-foreground">{c.h1}</h3>
                <p class="mt-1 line-clamp-2 flex-1 text-[13px] leading-[18px] text-muted-foreground">{c.description}</p>
                <span class="mt-3 inline-flex items-center gap-1 font-mono text-[11px] font-medium tracking-wide text-muted-foreground group-hover:text-foreground transition-colors">Calculate <span class="transition-transform group-hover:translate-x-0.5" aria-hidden="true">→</span></span>
              </a>
            </li>
          ))}
        </ul>
        <div class="mt-6 flex justify-center sm:hidden">
          <a href="/calculators/" class="inline-flex items-center gap-1.5 rounded-xl border border-border bg-card px-4 py-2 font-mono text-[11px] font-medium tracking-wide text-foreground shadow-card hover:bg-muted transition-colors focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring">Browse all calculators <span aria-hidden="true">→</span></a>
        </div>
      </div>
    </section>

    <!-- Categories -->
    <section class="bg-background py-8 sm:py-10 lg:py-12" aria-labelledby="cat-heading">
      <div class="mx-auto max-w-[1200px] px-4 sm:px-6">
        <div class="mx-auto max-w-[580px] text-center">
          <p class="font-mono text-[10px] font-medium tracking-[0.12em] uppercase text-muted-foreground">Library</p>
          <h2 id="cat-heading" class="mt-1.5 text-[18px] font-semibold tracking-[-0.02em] text-foreground sm:text-[20px] [text-wrap:balance]">Browse by category</h2>
          <p class="mx-auto mt-1.5 max-w-[480px] text-[13px] leading-5 text-muted-foreground">Sixteen focused groups — every category has live calculators, no placeholders.</p>
        </div>
        <div class="mt-6 grid gap-2 sm:gap-3 sm:grid-cols-2 lg:grid-cols-3">
          {hubCategories.map((cat) => (
            <a href={`/construction/${cat.slug}/`} class="group flex flex-col rounded-xl border border-border bg-card p-4 shadow-card transition-all duration-150 hover:shadow-card-hover hover:-translate-y-0.5 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring">
              <div class="flex items-start justify-between gap-3">
                <h3 class="text-[14px] font-semibold tracking-[-0.01em] text-foreground">{cat.name}</h3>
                <span class="shrink-0 rounded-full bg-muted px-2 py-0.5 font-mono text-[10px] tracking-wide text-muted-foreground ring-1 ring-border">{cat.count}</span>
              </div>
              <p class="mt-1.5 line-clamp-2 flex-1 text-[13px] leading-[18px] text-muted-foreground">{cat.desc}</p>
              <span class="mt-3 inline-flex items-center gap-1 font-mono text-[11px] font-medium tracking-wide text-muted-foreground transition-colors group-hover:text-foreground">View <span class="transition-transform group-hover:translate-x-0.5" aria-hidden="true">→</span></span>
            </a>
          ))}
        </div>
      </div>
    </section>

    <!-- Project Groups -->
    <section class="border-y border-border bg-background py-8 sm:py-10 lg:py-12" aria-labelledby="groups-heading">
      <div class="mx-auto max-w-[1200px] px-4 sm:px-6">
        <div class="mx-auto max-w-[580px] text-center">
          <p class="font-mono text-[10px] font-medium tracking-[0.12em] uppercase text-muted-foreground">Project groups</p>
          <h2 id="groups-heading" class="mt-1.5 text-[18px] font-semibold tracking-[-0.02em] text-foreground sm:text-[20px] [text-wrap:balance]">Popular project calculator groups</h2>
          <p class="mx-auto mt-1.5 max-w-[480px] text-[13px] leading-5 text-muted-foreground">Jump straight to the tools your project needs — grouped by real jobs, not just categories.</p>
        </div>
        <div class="mt-6 grid gap-3 sm:grid-cols-2 lg:grid-cols-4">
          {projectGroups.map((group) => {
            const calcs = getCalcs(group.slugs);
            return (
              <div class="rounded-xl border border-border bg-card p-4">
                <h3 class="text-[13px] font-semibold tracking-[-0.01em] text-foreground">{group.name}</h3>
                <p class="mt-1 text-[12px] leading-4 text-muted-foreground line-clamp-1">{group.desc}</p>
                <ul class="mt-3 space-y-1.5" role="list">
                  {calcs.slice(0,4).map(c => (
                    <li><a href={`/${c.slug}/`} class="flex items-center gap-1.5 text-[13px] leading-5 text-muted-foreground hover:text-foreground transition-colors"><span class="h-1 w-1 rounded-full bg-border"></span>{c.h1}</a></li>
                  ))}
                </ul>
                <a href={`/construction/${group.cluster}/`} class="mt-3 inline-flex items-center gap-1 font-mono text-[11px] font-medium tracking-wide text-muted-foreground hover:text-foreground transition-colors">View {group.name} <span aria-hidden="true">→</span></a>
              </div>
            );
          })}
        </div>
      </div>
    </section>

    <!-- Why -->
    <section class="bg-background py-8 sm:py-10 lg:py-12" aria-labelledby="why-heading">
      <div class="mx-auto max-w-[1200px] px-4 sm:px-6">
        <div class="mx-auto max-w-[680px] text-center">
          <p class="font-mono text-[10px] font-medium tracking-[0.12em] uppercase text-muted-foreground">Why Calculator Street</p>
          <h2 id="why-heading" class="mt-1.5 text-[18px] font-semibold tracking-[-0.02em] text-foreground sm:text-[20px]">Built for real projects</h2>
          <p class="mx-auto mt-2 max-w-[520px] text-[13px] leading-5 text-muted-foreground">Concrete, gravel, rebar, brick, roofing, flooring, drywall, deck, fence and more — each calculator has original formulas, worked examples and clear FAQs. No dark patterns.</p>
        </div>
        <div class="mx-auto mt-6 grid max-w-[760px] gap-2 sm:gap-3 sm:grid-cols-4">
          <div class="rounded-xl border border-border bg-card px-4 py-5 text-center"><p class="font-mono text-[11px] tracking-wide text-muted-foreground">Access</p><p class="mt-1 text-[13px] font-semibold tracking-[-0.01em] text-foreground">Free to use</p><p class="mt-1 text-[12px] leading-4 text-muted-foreground">No paywall. Static & fast.</p></div>
          <div class="rounded-xl border border-border bg-card px-4 py-5 text-center"><p class="font-mono text-[11px] tracking-wide text-muted-foreground">Clarity</p><p class="mt-1 text-[13px] font-semibold tracking-[-0.01em] text-foreground">Clear results</p><p class="mt-1 text-[12px] leading-4 text-muted-foreground">Units clear, no fake precision.</p></div>
          <div class="rounded-xl border border-border bg-card px-4 py-5 text-center"><p class="font-mono text-[11px] tracking-wide text-muted-foreground">Coverage</p><p class="mt-1 text-[13px] font-semibold tracking-[-0.01em] text-foreground">Broad library</p><p class="mt-1 text-[12px] leading-4 text-muted-foreground">Construction, every trade.</p></div>
          <div class="rounded-xl border border-border bg-card px-4 py-5 text-center"><p class="font-mono text-[11px] tracking-wide text-muted-foreground">Privacy</p><p class="mt-1 text-[13px] font-semibold tracking-[-0.01em] text-foreground">Private</p><p class="mt-1 text-[12px] leading-4 text-muted-foreground">Runs locally, no tracking.</p></div>
        </div>
        <div class="mx-auto mt-8 max-w-[680px] rounded-xl border border-border bg-card p-5 sm:p-6">
          <div class="flex flex-col gap-6 sm:flex-row sm:items-start sm:justify-between">
            <div class="flex-1">
              <h3 class="text-[15px] font-semibold tracking-[-0.02em] text-foreground">How it works</h3>
              <ol class="mt-4 space-y-3" role="list">
                <li class="flex gap-3 text-[13px] leading-5 text-muted-foreground"><span class="flex h-6 w-6 shrink-0 items-center justify-center rounded-full bg-muted text-[11px] font-semibold text-foreground ring-1 ring-border" aria-hidden="true">1</span><span><span class="font-medium text-foreground">Choose a calculator</span> — via search or category.</span></li>
                <li class="flex gap-3 text-[13px] leading-5 text-muted-foreground"><span class="flex h-6 w-6 shrink-0 items-center justify-center rounded-full bg-muted text-[11px] font-semibold text-foreground ring-1 ring-border" aria-hidden="true">2</span><span><span class="font-medium text-foreground">Enter your measurements</span> — dimensions, quantities.</span></li>
                <li class="flex gap-3 text-[13px] leading-5 text-muted-foreground"><span class="flex h-6 w-6 shrink-0 items-center justify-center rounded-full bg-muted text-[11px] font-semibold text-foreground ring-1 ring-border" aria-hidden="true">3</span><span><span class="font-medium text-foreground">Get your result</span> — instantly with units.</span></li>
              </ol>
            </div>
            <a href="/calculators/" class="inline-flex h-9 shrink-0 items-center justify-center rounded-lg bg-foreground px-5 font-mono text-[11px] font-medium tracking-wide text-background transition-opacity hover:opacity-90 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring">Explore all calculators</a>
          </div>
        </div>
      </div>
    </section>

    <!-- CTA -->
    <section class="border-t border-border bg-background py-8 sm:py-10" aria-labelledby="cta-heading">
      <div class="mx-auto max-w-[1200px] px-4 sm:px-6 text-center">
        <h2 id="cta-heading" class="text-[18px] font-semibold tracking-[-0.02em] text-foreground sm:text-[20px]">Find the right calculator for your project</h2>
        <p class="mx-auto mt-1.5 max-w-[480px] text-[13px] leading-5 text-muted-foreground">Search the full library — concrete, roofing, flooring, framing and more.</p>
        <a href="/calculators/" class="group mt-4 inline-flex items-center gap-1.5 font-mono text-[11px] font-medium tracking-wide text-foreground transition-colors hover:text-muted-foreground focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring">Browse all calculators <span class="transition-transform group-hover:translate-x-0.5" aria-hidden="true">→</span></a>
      </div>
    </section>
  </main>
  <Footer />

  <script is:inline define:vars={{ hubCalculators }}>
    const input = document.getElementById("hero-search");
    const box = document.getElementById("hero-search-results");
    const idx = hubCalculators.map(c => ({
      slug: c.slug,
      h1: c.h1,
      title: c.title,
      desc: c.description,
      cat: c.category,
      cluster: c.cluster,
      keywords: (c.keywords || []).join(" "),
      url: `/${c.slug}/`,
      hay: `${c.h1} ${c.title} ${c.description} ${c.category} ${c.cluster} ${c.slug} ${(c.keywords||[]).join(" ")}`.toLowerCase()
    }));
    function escapeHtml(str){
      return String(str).replace(/&/g,"&amp;").replace(/</g,"&lt;").replace(/>/g,"&gt;").replace(/"/g,"&quot;").replace(/'/g,"&#39;");
    }
    function score(query, hay){
      const terms = query.toLowerCase().trim().split(/\s+/).filter(Boolean);
      let ok = terms.every(t => hay.includes(t));
      if(!ok) return -1;
      let s=0;
      for(const t of terms){
        if(hay.includes(" "+t+" ")) s+=2;
        else s+=1;
      }
      if(hay.includes(query.toLowerCase())) s+=3;
      return s;
    }
    function render(q) {
      if (!q || !box) return;
      const hits = idx.map(x => ({...x, _s: score(q, x.hay)})).filter(x=>x._s>=0).sort((a,b)=>b._s-a._s).slice(0,6);
      if (!hits.length) { box.classList.add("hidden"); box.innerHTML=""; return; }
      box.innerHTML = hits.map(h => `<a href="${h.url}" class="group flex items-center gap-3 px-4 py-3.5 border-b last:border-0 border-border transition-colors hover:bg-muted" role="option"><span class="hidden h-8 w-8 shrink-0 items-center justify-center rounded-lg border border-border bg-muted text-muted-foreground group-hover:text-foreground sm:inline-flex" aria-hidden="true"><svg width="14" height="14" viewBox="0 0 16 16" fill="none"><path d="M11.2 11.2L13.8 13.8M12.3 7.3a4.95 4.95 0 1 1-9.9 0 4.95 4.95 0 0 1 9.9 0Z" stroke="currentColor" stroke-width="1.25" stroke-linecap="round"/></svg></span><div class="min-w-0 flex-1"><p class="truncate text-[13.5px] font-medium tracking-[-0.01em] text-foreground">${escapeHtml(h.h1)}</p><p class="mt-0.5 flex items-center gap-1.5 truncate font-mono text-[11px]"><span class="rounded bg-muted px-1.5 py-0.5 ring-1 ring-border text-muted-foreground">${escapeHtml(h.cat)}</span><span class="truncate text-muted-foreground hidden sm:inline">${escapeHtml(h.desc.slice(0,62))}</span></p></div><span class="shrink-0 font-mono text-[11px] text-muted-foreground transition-colors group-hover:text-foreground">→</span></a>`).join("") + `<a href="/calculators/?q=${encodeURIComponent(q)}" class="flex items-center justify-center gap-1.5 bg-muted px-4 py-2.5 font-mono text-[11px] tracking-wide text-muted-foreground hover:text-foreground transition-colors">View all results for "${escapeHtml(q.slice(0,24))}" <span aria-hidden="true">→</span></a>`;
      box.classList.remove("hidden");
    }
    if (input) {
      const wrap = input.closest(".group");
      input.addEventListener("focus", () => { if (wrap) wrap.classList.add("is-focused"); if (input.value.trim()) render(input.value.trim()); });
      input.addEventListener("blur", () => { if (wrap) wrap.classList.remove("is-focused"); });
      input.addEventListener("input", () => render(input.value.trim()));
      input.addEventListener("keydown", (e) => { if(e.key==="Escape"){ box?.classList.add("hidden"); input.blur(); }});
      document.addEventListener("click", (e) => { const t = e.target; if (!t.closest || (!t.closest("#hero-search") && !t.closest("#hero-search-results"))) box?.classList.add("hidden"); });
    }
  </script>
</Layout>
