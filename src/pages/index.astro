---
import Layout from "../layouts/Layout.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import { hubCalculators, hubCategories } from "../data/hubCalculators";

const totalCount = hubCalculators.length;
const popular = hubCalculators.filter(c => ["concrete-slab-calculator","gravel-calculator","rebar-calculator","brick-wall-calculator","roof-pitch-calculator","fence-cost-calculator","tile-calculator","paint-calculator","deck-calculator","paver-calculator","concrete-calculator","excavation-calculator"].includes(c.slug)).slice(0,12);
const actualPopular = popular.length ? popular : hubCalculators.slice(0,12);
---

<Layout
  title={`Calculator Street — Free Construction & Home Improvement Calculators`}
  description={`Free construction & home improvement calculators — fast, private and mobile-friendly. Built with Astro + Tailwind CSS v4.`}
>
  <Header />
  <main id="main" tabindex="-1">
    <!-- Hero -->
    <section class="relative isolate overflow-hidden border-b border-hairline bg-canvas dark:bg-canvas" aria-labelledby="hero-heading">
      <div class="pointer-events-none absolute inset-0 mesh-gradient opacity-90" aria-hidden="true"></div>
      <div class="pointer-events-none absolute inset-0 opacity-[0.03] dark:opacity-[0.05]" style="background-image: linear-gradient(#171717 1px, transparent 1px), linear-gradient(90deg,#171717 1px, transparent 1px); background-size:32px 32px;" aria-hidden="true"></div>
      <div class="relative mx-auto max-w-[1400px] px-6 py-12 sm:py-16 lg:py-20 max-md:px-4">
        <div class="mx-auto max-w-[760px] text-center">
          <p class="font-mono text-[11px] font-medium tracking-[0.16em] uppercase text-mute">Construction & Home Improvement Calculators</p>
          <h1 id="hero-heading" class="mt-3 text-display-xl font-semibold tracking-[-0.05em] text-ink [text-wrap:balance] sm:text-[48px] sm:leading-[48px]">
              Calculators for Construction, Remodeling & Home Projects.
            </h1>
          <p class="mx-auto mt-4 max-w-[640px] text-body-lg leading-7 text-body [text-wrap:pretty]">
            Quickly estimate materials, quantities, costs, dimensions, and project requirements with free, easy-to-use calculators.
          </p>
          <!-- Hero Search -->
          <div class="mx-auto mt-8 max-w-[640px]">
            <label for="hero-search" class="sr-only">Search calculators</label>
            <div class="relative flex items-center">
              <span class="pointer-events-none absolute left-4 text-mute"><svg width="18" height="18" viewBox="0 0 16 16" fill="none" aria-hidden="true"><path d="M11.5 11.5L14 14M12.5 7.5a5 5 0 1 1-10 0 5 5 0 0 1 10 0Z" stroke="currentColor" stroke-width="1.35" stroke-linecap="round"/></svg></span>
              <input id="hero-search" type="search" placeholder="What do you need to calculate? Try concrete slab, roof pitch, gravel..." class="h-14 w-full rounded-full border border-hairline bg-canvas-soft pl-14 pr-12 text-sm placeholder:text-mute/60 shadow-sm focus:border-primary focus-visible:outline-none focus-ring-primary/20 dark:bg-canvas" autocomplete="off" />
              <a href="/calculators/" class="absolute right-2 flex h-11 w-11 items-center justify-center rounded-full bg-primary text-[12px] font-medium text-on-primary hover:bg-[#242424] focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-link">Find a Calculator</a>
            </div>
            <div id="hero-search-results" class="mt-3 hidden max-h-[320px] overflow-auto rounded-lg border border-hairline bg-canvas text-left shadow-float dark:bg-canvas" role="listbox" aria-label="Search results"></div>
            <p class="mt-3 flex flex-wrap justify-center gap-2 font-mono text-[11px] text-mute">
              <span>Try:</span>
              <a href="/concrete-slab-calculator/" class="rounded-full border border-hairline bg-canvas px-2.5 py-1 hover:bg-canvas-soft hover:text-ink">Concrete slab</a>
              <a href="/roof-pitch-calculator/" class="rounded-full border border-hairline bg-canvas px-2.5 py-1 hover:bg-canvas-soft hover:text-ink">Roof pitch</a>
              <a href="/gravel-calculator/" class="rounded-full border border-hairline bg-canvas px-2.5 py-1 hover:bg-canvas-soft hover:text-ink">Gravel</a>
              <a href="/fence-calculator/" class="rounded-full border border-hairline bg-canvas px-2.5 py-1 hover:bg-canvas-soft hover:text-ink">Fence</a>
            </p>
          </div>
          <div class="mt-6 flex flex-col items-center justify-center gap-3 sm:flex-row">
            <a href="#popular" class="inline-flex h-11 items-center justify-center rounded-pill bg-primary px-6 text-sm font-medium text-on-primary shadow-card transition hover:bg-[#242424] focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-link">Find a Calculator</a>
            <a href="/calculators/" class="inline-flex h-11 items-center justify-center rounded-pill border border-hairline bg-canvas px-6 text-sm font-medium text-ink shadow-card transition hover:bg-canvas-soft focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-link">Browse All Calculators</a>
          </div>
          <p class="mt-3 font-mono text-caption tracking-wide text-mute">Free · Fast · No sign-up · US units · Works offline</p>
        </div>

        <div class="mx-auto mt-10 grid max-w-[920px] gap-3 sm:grid-cols-3">
          <div class="rounded-lg border border-hairline bg-canvas p-4 text-center shadow-card dark:bg-canvas"><p class="font-mono text-[11px] tracking-widest text-mute">CALCULATORS</p><p class="mt-1 text-2xl font-semibold tracking-[-0.03em] text-ink">{totalCount} live</p><p class="font-mono text-xs text-mute">All categories · No placeholders</p></div>
          <div class="rounded-lg border border-hairline bg-canvas p-4 text-center shadow-card dark:bg-canvas"><p class="font-mono text-[11px] tracking-widest text-mute">CATEGORIES</p><p class="mt-1 text-2xl font-semibold tracking-[-0.03em] text-ink">{hubCategories.length} focused</p><p class="font-mono text-xs text-mute">Concrete · Roofing · Flooring · More</p></div>
          <div class="rounded-lg border border-hairline bg-canvas p-4 text-center shadow-card dark:bg-canvas"><p class="font-mono text-[11px] tracking-widest text-mute">PERFORMANCE</p><p class="mt-1 text-2xl font-semibold tracking-[-0.03em] text-ink">&lt;100 ms</p><p class="font-mono text-xs text-mute">Static · No tracking · Private</p></div>
        </div>
      </div>
    </section>

    <!-- Popular -->
    <section id="popular" class="bg-canvas py-14 sm:py-16 lg:py-20" aria-labelledby="popular-heading">
      <div class="mx-auto max-w-[1400px] px-6 max-md:px-4">
        <div class="flex flex-col gap-2 sm:flex-row sm:items-end sm:justify-between">
          <div>
            <p class="font-mono text-caption font-medium tracking-widest text-mute">POPULAR</p>
            <h2 id="popular-heading" class="mt-1 text-display-lg font-semibold tracking-[-0.04em] text-ink">Popular calculators</h2>
            <p class="mt-1 max-w-[520px] text-sm leading-5 text-body">Most-used tools — curated selection.</p>
          </div>
          <a href="/calculators/" class="hidden shrink-0 items-center gap-1.5 rounded-full border border-hairline bg-canvas px-4 py-2 text-sm font-medium text-ink hover:bg-canvas-soft sm:inline-flex">Browse all →</a>
        </div>
        <ul class="mt-8 grid gap-4 sm:grid-cols-2 lg:grid-cols-3" role="list">
          {actualPopular.map((c) => (
            <li>
              <a href={`/${c.slug}/`} class="group flex h-full flex-col rounded-md border border-hairline bg-canvas p-4 shadow-card transition hover:shadow-card-hover focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-link dark:bg-canvas">
                <span class="inline-flex h-8 w-8 items-center justify-center rounded-sm border border-hairline bg-canvas-soft text-ink dark:bg-white/[0.06]" aria-hidden="true">
                  <svg width="16" height="16" viewBox="0 0 16 16" fill="none"><path d={c.iconPath} stroke="currentColor" stroke-width="1.25" stroke-linecap="round" stroke-linejoin="round"/></svg>
                </span>
                <p class="mt-1 font-mono text-[11px] tracking-wide text-mute">{c.category.toUpperCase()}</p>
                <h3 class="line-clamp-1 text-[15px] font-semibold tracking-[-0.02em] text-ink">{c.h1}</h3>
                <p class="mt-1 line-clamp-2 flex-1 text-sm leading-5 text-body">{c.description}</p>
                <span class="mt-3 inline-flex items-center gap-1 text-sm font-medium text-ink group-hover:text-link">Calculate →</span>
              </a>
            </li>
          ))}
        </ul>
      </div>
    </section>

    <!-- Browse by Category -->
    <section class="border-y border-hairline bg-canvas-soft py-14 sm:py-16 lg:py-20 dark:bg-canvas-soft" aria-labelledby="cat-heading">
      <div class="mx-auto max-w-[1400px] px-6 max-md:px-4">
        <div class="mx-auto max-w-[640px] text-center">
          <h2 id="cat-heading" class="text-display-lg font-semibold tracking-[-0.04em] text-ink">Browse calculators by category</h2>
          <p class="mt-2 text-sm leading-5 text-body">All categories — counts generated automatically from the registry. Every category has live calculators, no placeholders.</p>
        </div>
        <div class="mt-8 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
          {hubCategories.map((cat) => (
            <a href={`/construction/${cat.slug}/`} class="group rounded-lg border border-hairline bg-canvas p-6 shadow-card transition hover:shadow-card-hover dark:bg-canvas">
              <h3 class="text-display-sm font-semibold tracking-[-0.03em] text-ink group-hover:text-link">{cat.name}</h3>
              <p class="mt-1 font-mono text-xs tracking-wide text-mute">{cat.count} calculators</p>
              <p class="mt-2 text-sm leading-5 text-body">{cat.desc}</p>
              <span class="mt-3 inline-flex text-sm font-medium text-ink group-hover:text-link">View {cat.name} →</span>
            </a>
          ))}
        </div>
      </div>
    </section>

    <!-- Why -->
    <section class="bg-canvas py-14 sm:py-16" aria-labelledby="why-heading">
      <div class="mx-auto max-w-[1400px] px-6 max-md:px-4">
        <div class="grid gap-8 lg:grid-cols-2">
          <div>
            <p class="font-mono text-caption font-medium tracking-widest text-mute">WHY CALCULATOR STREET</p>
            <h2 id="why-heading" class="mt-2 text-display-lg font-semibold tracking-[-0.04em] text-ink">Built for real projects.</h2>
            <p class="mt-3 max-w-[560px] text-sm leading-6 text-body">Calculators covering concrete, gravel, rebar, brick, roofing, flooring, drywall, deck, fence, landscaping and more — each with original formulas, worked examples and FAQs. No dark patterns.</p>
            <ul class="mt-6 grid gap-3 sm:grid-cols-2" role="list">
              <li class="rounded-md border border-hairline bg-canvas p-4 dark:bg-canvas"><p class="text-sm font-semibold text-ink">Free to use</p><p class="text-sm leading-5 text-body">No paywall. Static & fast.</p></li>
              <li class="rounded-md border border-hairline bg-canvas p-4 dark:bg-canvas"><p class="text-sm font-semibold text-ink">Clear results</p><p class="text-sm leading-5 text-body">Units shown clearly, no fake precision.</p></li>
              <li class="rounded-md border border-hairline bg-canvas p-4 dark:bg-canvas"><p class="text-sm font-semibold text-ink">Broad library</p><p class="text-sm leading-5 text-body">Comprehensive tools for construction.</p></li>
              <li class="rounded-md border border-hairline bg-canvas p-4 dark:bg-canvas"><p class="text-sm font-semibold text-ink">Private</p><p class="text-sm leading-5 text-body">Runs in browser, no tracking by us.</p></li>
            </ul>
          </div>
          <div class="rounded-lg border border-hairline bg-canvas-soft p-6 dark:bg-white/[0.02]">
            <h3 class="text-display-sm font-semibold tracking-[-0.03em] text-ink">How it works</h3>
            <ol class="mt-4 space-y-3 text-sm leading-5 text-body" role="list">
              <li class="flex gap-3"><span class="flex h-6 w-6 shrink-0 items-center justify-center rounded-full bg-primary text-xs font-semibold text-on-primary">1</span><span><span class="font-semibold text-ink">Choose a calculator</span> — Find it from the library via search or categories.</span></li>
              <li class="flex gap-3"><span class="flex h-6 w-6 shrink-0 items-center justify-center rounded-full bg-primary text-xs font-semibold text-on-primary">2</span><span><span class="font-semibold text-ink">Enter your measurements</span> — Dimensions, quantities or project info.</span></li>
              <li class="flex gap-3"><span class="flex h-6 w-6 shrink-0 items-center justify-center rounded-full bg-primary text-xs font-semibold text-on-primary">3</span><span><span class="font-semibold text-ink">Get your result</span> — Instantly with units and explanation.</span></li>
            </ol>
            <a href="/calculators/" class="mt-6 inline-flex h-10 items-center justify-center rounded-sm bg-primary px-5 text-sm font-medium text-on-primary hover:bg-[#242424] focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-link">Explore all calculators</a>
          </div>
        </div>
      </div>
    </section>

    <!-- Final CTA -->
    <section class="border-y border-hairline bg-canvas-soft py-12 sm:py-16 dark:bg-canvas-soft" aria-labelledby="cta-heading">
      <div class="mx-auto max-w-[1400px] px-6 text-center max-md:px-4">
        <h2 id="cta-heading" class="text-display-lg font-semibold tracking-[-0.04em] text-ink">Find the right calculator for your project</h2>
        <p class="mx-auto mt-2 max-w-[560px] text-sm leading-5 text-body">Search all calculators and find the tool you need — concrete, roofing, flooring, framing and more.</p>
        <a href="/calculators/" class="mt-6 inline-flex h-11 items-center justify-center rounded-pill bg-primary px-8 text-sm font-medium text-on-primary shadow-card hover:bg-[#242424] focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-link">Find a calculator</a>
      </div>
    </section>
  </main>
  <Footer />

  <script is:inline define:vars={{ hubCalculators }}>
    const input = document.getElementById("hero-search");
    const box = document.getElementById("hero-search-results");
    const idx = hubCalculators.map(c => ({
      slug: c.slug,
      h1: c.h1,
      title: c.title,
      desc: c.description,
      cat: c.category,
      url: `/${c.slug}/`,
      hay: `${c.h1} ${c.title} ${c.description} ${c.category} ${c.slug}`.toLowerCase()
    }));
    function render(q) {
      if (!q || !box) return;
      const hits = idx.filter(x => x.hay.includes(q.toLowerCase())).slice(0,8);
      if (!hits.length) { box.classList.add("hidden"); box.innerHTML=""; return; }
      box.innerHTML = hits.map(h => `<a href="${h.url}" class="flex items-center justify-between gap-3 px-4 py-3 hover:bg-canvas-soft border-b last:border-0 border-hairline" role="option"><div><p class="text-sm font-semibold text-ink">${h.h1}</p><p class="text-xs text-body line-clamp-1">${h.desc.slice(0,80)} · ${h.cat}</p></div><span class="text-xs font-medium text-link">Open →</span></a>`).join("");
      box.classList.remove("hidden");
    }
    if (input) {
      input.addEventListener("input", () => render(input.value.trim()));
      input.addEventListener("keydown", (e) => { if(e.key==="Escape"){ box?.classList.add("hidden"); }});
      document.addEventListener("click", (e) => { if (!e.target.closest("#hero-search") && !e.target.closest("#hero-search-results")) box?.classList.add("hidden"); });
    }
  </script>
</Layout>
