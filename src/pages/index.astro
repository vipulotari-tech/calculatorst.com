---
import Layout from "../layouts/Layout.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import { calculators } from "../data/calculators";

const featured = calculators.filter(c => c.featured).slice(0, 10);
---

<Layout
  title="Calculator Street — Free Construction & Home Improvement Calculators"
  description="Calculate materials, quantities, measurements, and project costs with fast, easy-to-use calculators for gravel, concrete, fencing, roofing, decking and landscaping."
>
  <Header />
  <main id="main" tabindex="-1">
    <!-- Hero -->
    <section class="relative isolate overflow-hidden border-b border-hairline bg-canvas dark:bg-canvas" aria-labelledby="hero-heading">
      <div class="pointer-events-none absolute inset-0 mesh-gradient opacity-90" aria-hidden="true"></div>
      <div class="pointer-events-none absolute inset-0 opacity-[0.03] dark:opacity-[0.05]" style="background-image: linear-gradient(#171717 1px, transparent 1px), linear-gradient(90deg,#171717 1px, transparent 1px); background-size:32px 32px;" aria-hidden="true"></div>
      <div class="relative mx-auto max-w-[1400px] px-6 py-14 sm:py-16 lg:py-20 max-md:px-4">
        <div class="mx-auto max-w-[720px] text-center">
          <a href="/calculators/" class="inline-flex items-center gap-2 rounded-full border border-hairline bg-canvas-soft px-3 py-1 text-sm text-body shadow-card transition hover:bg-canvas dark:bg-canvas-soft-2">
            <span class="h-2 w-2 animate-pulse rounded-full bg-success" aria-hidden="true"></span>
            <span class="font-mono text-[11px] font-medium tracking-wide text-body">NEW</span>
            <span class="hidden h-3 w-px bg-hairline sm:block" aria-hidden="true"></span>
            <span class="text-sm">Gravel & fence clusters live — explore…</span>
          </a>
          <h1 id="hero-heading" class="mt-4 text-display-xl font-semibold tracking-[-0.05em] text-ink [text-wrap:balance] sm:text-[48px] sm:leading-[48px]">
            Free Construction & Home Improvement Calculators.
          </h1>
          <p class="mx-auto mt-4 max-w-[560px] text-body-lg leading-7 text-body [text-wrap:pretty]">
            Calculate materials, quantities, measurements, and project costs with fast, easy-to-use calculators.
          </p>
          <div class="mt-7 flex flex-col items-center justify-center gap-3 sm:flex-row">
            <a href="/calculators/" class="inline-flex h-11 items-center justify-center rounded-pill bg-primary px-6 text-sm font-medium text-on-primary shadow-card transition duration-200 hover:bg-[#242424] focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-link">Explore calculators</a>
            <a href="/construction/" class="inline-flex h-11 items-center justify-center rounded-pill border border-hairline bg-canvas px-6 text-sm font-medium text-ink shadow-card transition duration-200 hover:bg-canvas-soft focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-link">Browse categories</a>
          </div>
          <p class="mt-3 font-mono text-caption tracking-wide text-mute">Free · Fast · No sign-up · US units · Works offline</p>
        </div>

        <!-- Mini demo stats -->
        <div class="mx-auto mt-10 grid max-w-[920px] gap-3 sm:grid-cols-3">
          <div class="rounded-lg border border-hairline bg-canvas p-4 text-center shadow-card dark:bg-canvas"><p class="font-mono text-[11px] tracking-widest text-mute">CALCULATORS</p><p class="mt-1 text-2xl font-semibold tracking-[-0.03em] text-ink">10 live</p><p class="font-mono text-xs text-mute">→ 30 → 50 → 100+</p></div>
          <div class="rounded-lg border border-hairline bg-canvas p-4 text-center shadow-card dark:bg-canvas"><p class="font-mono text-[11px] tracking-widest text-mute">CLUSTERS</p><p class="mt-1 text-2xl font-semibold tracking-[-0.03em] text-ink">6 focused</p><p class="font-mono text-xs text-mute">Gravel · Concrete · Fence</p></div>
          <div class="rounded-lg border border-hairline bg-canvas p-4 text-center shadow-card dark:bg-canvas"><p class="font-mono text-[11px] tracking-widest text-mute">PERFORMANCE</p><p class="mt-1 text-2xl font-semibold tracking-[-0.03em] text-ink">&lt;100 ms</p><p class="font-mono text-xs text-mute">Static · No tracking</p></div>
        </div>
      </div>
    </section>

    <!-- Featured Calculators -->
    <section class="bg-canvas py-14 sm:py-16 lg:py-20" aria-labelledby="featured-heading">
      <div class="mx-auto max-w-[1400px] px-6 max-md:px-4">
        <div class="flex flex-col gap-2 sm:flex-row sm:items-end sm:justify-between">
          <div>
            <p class="font-mono text-caption font-medium tracking-widest text-mute">FEATURED</p>
            <h2 id="featured-heading" class="mt-1 text-display-lg font-semibold tracking-[-0.04em] text-ink">Featured calculators</h2>
            <p class="mt-1 max-w-[520px] text-sm leading-5 text-body">The initial 10 — built for depth, not just a number. Each is a full page with units, waste, cost and FAQs.</p>
          </div>
          <a href="/calculators/" class="hidden shrink-0 items-center gap-1.5 rounded-full border border-hairline bg-canvas px-4 py-2 text-sm font-medium text-ink hover:bg-canvas-soft focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-link sm:inline-flex">View all →</a>
        </div>
        <ul class="mt-8 grid gap-4 sm:grid-cols-2 lg:grid-cols-3" role="list">
          {featured.map((c) => (
            <li>
              <a href={`/${c.slug}/`} class="group flex h-full flex-col rounded-md border border-hairline bg-canvas p-4 shadow-card transition duration-200 hover:shadow-card-hover focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-link dark:bg-canvas">
                <span class="inline-flex h-8 w-8 items-center justify-center rounded-sm border border-hairline bg-canvas-soft text-ink dark:bg-white/[0.06]" aria-hidden="true">
                  <svg width="16" height="16" viewBox="0 0 16 16" fill="none"><path d={c.iconPath} stroke="currentColor" stroke-width="1.25" stroke-linecap="round" stroke-linejoin="round"/></svg>
                </span>
                <h3 class="mt-3 line-clamp-1 text-[15px] font-semibold tracking-[-0.02em] text-ink">{c.title.split(" —")[0]}</h3>
                <p class="mt-1 line-clamp-2 flex-1 text-sm leading-5 text-body">{c.description}</p>
                <span class="mt-3 inline-flex items-center gap-1 text-sm font-medium text-ink group-hover:text-link">Open <svg width="12" height="12" viewBox="0 0 16 16" fill="none" aria-hidden="true" class="transition group-hover:translate-x-0.5"><path d="M6 3l5 5-5 5" stroke="currentColor" stroke-width="1.3" stroke-linecap="round"/></svg></span>
              </a>
            </li>
          ))}
        </ul>
        <div class="mt-6 flex justify-center sm:hidden">
          <a href="/calculators/" class="rounded-full border border-hairline bg-canvas px-4 py-2 text-sm font-medium text-ink">View all calculators</a>
        </div>
      </div>
    </section>

    <!-- Categories -->
    <section class="border-y border-hairline bg-canvas-soft py-14 sm:py-16 lg:py-20 dark:bg-canvas-soft" aria-labelledby="cat-heading">
      <div class="mx-auto max-w-[1400px] px-6 max-md:px-4">
        <div class="mx-auto max-w-[640px] text-center">
          <h2 id="cat-heading" class="text-display-lg font-semibold tracking-[-0.04em] text-ink">Categories</h2>
          <p class="mt-2 text-sm leading-5 text-body [text-wrap:pretty]">Topical authority from day one — each cluster links its pages tightly for SEO.</p>
        </div>
        <div class="mt-8 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
          <a href="/construction/gravel/" class="rounded-lg border border-hairline bg-canvas p-6 shadow-card transition hover:shadow-card-hover dark:bg-canvas"><h3 class="text-display-sm font-semibold tracking-[-0.03em] text-ink">Gravel Calculators</h3><p class="mt-1 text-sm leading-5 text-body">Gravel, pea gravel, driveway, crushed stone — tons, yards & cost.</p><span class="mt-3 inline-flex text-sm font-medium text-ink">Explore →</span></a>
          <a href="/construction/concrete/" class="rounded-lg border border-hairline bg-canvas p-6 shadow-card transition hover:shadow-card-hover dark:bg-canvas"><h3 class="text-display-sm font-semibold tracking-[-0.03em] text-ink">Concrete Calculators</h3><p class="mt-1 text-sm leading-5 text-body">Slabs, bags, driveways & cost — US units with waste.</p><span class="mt-3 inline-flex text-sm font-medium text-ink">Explore →</span></a>
          <a href="/construction/fencing/" class="rounded-lg border border-hairline bg-canvas p-6 shadow-card transition hover:shadow-card-hover dark:bg-canvas"><h3 class="text-display-sm font-semibold tracking-[-0.03em] text-ink">Fence Calculators</h3><p class="mt-1 text-sm leading-5 text-body">Posts, panels, rails, gates & material cost.</p><span class="mt-3 inline-flex text-sm font-medium text-ink">Explore →</span></a>
          <a href="/construction/roofing/" class="rounded-lg border border-hairline bg-canvas p-6 shadow-card transition hover:shadow-card-hover dark:bg-canvas"><h3 class="text-display-sm font-semibold tracking-[-0.03em] text-ink">Roofing Calculators</h3><p class="mt-1 text-sm leading-5 text-body">Pitch, square footage, squares & shingles.</p><span class="mt-3 inline-flex text-sm font-medium text-ink">Explore →</span></a>
          <a href="/construction/decking/" class="rounded-lg border border-hairline bg-canvas p-6 shadow-card transition hover:shadow-card-hover dark:bg-canvas"><h3 class="text-display-sm font-semibold tracking-[-0.03em] text-ink">Deck Calculators</h3><p class="mt-1 text-sm leading-5 text-body">Boards, joists, fasteners & cost — with gap & waste.</p><span class="mt-3 inline-flex text-sm font-medium text-ink">Explore →</span></a>
          <a href="/construction/landscaping/" class="rounded-lg border border-hairline bg-canvas p-6 shadow-card transition hover:shadow-card-hover dark:bg-canvas"><h3 class="text-display-sm font-semibold tracking-[-0.03em] text-ink">Landscaping Calculators</h3><p class="mt-1 text-sm leading-5 text-body">Pavers, mulch, topsoil & sod — bulk & bags.</p><span class="mt-3 inline-flex text-sm font-medium text-ink">Explore →</span></a>
        </div>
      </div>
    </section>

    <!-- Trust -->
    <section class="bg-canvas py-14 sm:py-16" aria-labelledby="trust-heading">
      <div class="mx-auto max-w-[1400px] px-6 max-md:px-4">
        <div class="grid gap-8 lg:grid-cols-2">
          <div>
            <p class="font-mono text-caption font-medium tracking-widest text-mute">WHY CALCULATOR STREET</p>
            <h2 id="trust-heading" class="mt-2 text-display-lg font-semibold tracking-[-0.04em] text-ink">Serious calculators for real projects.</h2>
            <p class="mt-3 max-w-[560px] text-sm leading-6 text-body [text-wrap:pretty]">We build fewer calculators extremely well — clear inputs, honest outputs and no dark patterns. Every page is static, private and US-focused.</p>
            <ul class="mt-6 grid gap-3 sm:grid-cols-2" role="list">
              <li class="rounded-md border border-hairline bg-canvas p-4 dark:bg-canvas"><p class="text-sm font-semibold text-ink">Free & fast</p><p class="text-sm leading-5 text-body">No paywall. &lt;100 ms calc. Offline-ready.</p></li>
              <li class="rounded-md border border-hairline bg-canvas p-4 dark:bg-canvas"><p class="text-sm font-semibold text-ink">Transparent</p><p class="text-sm leading-5 text-body">Formulas, examples & assumptions on every page.</p></li>
              <li class="rounded-md border border-hairline bg-canvas p-4 dark:bg-canvas"><p class="text-sm font-semibold text-ink">Mobile-first</p><p class="text-sm leading-5 text-body">Large inputs, thumb-friendly — built for the job site.</p></li>
              <li class="rounded-md border border-hairline bg-canvas p-4 dark:bg-canvas"><p class="text-sm font-semibold text-ink">US-focused</p><p class="text-sm leading-5 text-body">Feet, inches, yards, tons — metric where useful.</p></li>
            </ul>
          </div>
          <div class="rounded-lg border border-hairline bg-canvas-soft p-6 dark:bg-white/[0.02]">
            <h3 class="text-display-sm font-semibold tracking-[-0.03em] text-ink">What you get on every page</h3>
            <ul class="mt-4 space-y-2 text-sm leading-5 text-body" role="list">
              <li class="flex gap-2"><span class="mt-1 h-1.5 w-1.5 shrink-0 rounded-full bg-primary dark:bg-white" aria-hidden="true"></span> H1 → short intro → calculator (above the fold)</li>
              <li class="flex gap-2"><span class="mt-1 h-1.5 w-1.5 shrink-0 rounded-full bg-violet" aria-hidden="true"></span> Results first, prominent — waste & cost clearly labeled</li>
              <li class="flex gap-2"><span class="mt-1 h-1.5 w-1.5 shrink-0 rounded-full bg-cyan" aria-hidden="true"></span> Formula, example, tables, assumptions — not AI filler</li>
              <li class="flex gap-2"><span class="mt-1 h-1.5 w-1.5 shrink-0 rounded-full bg-highlight-pink" aria-hidden="true"></span> Related calculators + FAQ + breadcrumbs + internal links</li>
            </ul>
            <a href="/construction/" class="mt-6 inline-flex h-10 items-center justify-center rounded-sm bg-primary px-5 text-sm font-medium text-on-primary hover:bg-[#242424] focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-link">Start with Construction</a>
          </div>
        </div>
      </div>
    </section>
  </main>
  <Footer />
</Layout>
