---
import Layout from "../layouts/Layout.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import { hubCalculators, hubCategories } from "../data/hubCalculators";
import { clusterGroups, projectGroups } from "../data/subcategories";

const curatedPopularSlugs = [
  "fence-calculator",
  "concrete-calculator",
  "roof-pitch-calculator",
  "gravel-calculator",
  "deck-calculator",
  "brick-calculator",
  "rebar-calculator",
  "flooring-calculator",
  "paint-calculator",
  "excavation-calculator",
  "mortar-calculator",
  "asphalt-calculator",
];
const popular = curatedPopularSlugs.map(s => hubCalculators.find(c => c.slug === s)).filter(Boolean) as typeof hubCalculators;
const actualPopular = popular.length ? popular : hubCalculators.filter(c => c.featured).slice(0,12);
const getCalcs = (slugs: string[]) => slugs.map(s => hubCalculators.find(c => c.slug === s)).filter(Boolean) as typeof hubCalculators;
---

<Layout
  title={`Calculator Street — Free Construction & Home Improvement Calculators`}
  description={`Free construction & home improvement calculators — fast, private and mobile-friendly. Built with Astro + Tailwind CSS v4.`}
  canonical="/"
>
  <Header />
  <main id="main" tabindex="-1">
<!-- Hero — premium, calm, editorial -->
    <section class="relative isolate overflow-hidden bg-[#fcfcfc] dark:bg-[#08080a]" aria-labelledby="hero-heading">
      <!-- Architectural grid — ultra subtle, mode-specific -->
      <div class="pointer-events-none absolute inset-0 opacity-[0.02] dark:hidden" style="background-image: linear-gradient(rgba(0,0,0,0.03) 1px, transparent 1px), linear-gradient(90deg, rgba(0,0,0,0.03) 1px, transparent 1px); background-size: 48px 48px;" aria-hidden="true"></div>
      <div class="pointer-events-none absolute inset-0 hidden dark:block opacity-[0.03]" style="background-image: linear-gradient(rgba(255,255,255,0.025) 1px, transparent 1px), linear-gradient(90deg, rgba(255,255,255,0.025) 1px, transparent 1px); background-size: 48px 48px;" aria-hidden="true"></div>
      <!-- Light soft accents -->
      <div class="pointer-events-none absolute inset-0 dark:hidden" style="background: radial-gradient(ellipse 600px 300px at 20% 10%, rgba(0,112,243,0.025), transparent 65%), radial-gradient(ellipse 500px 300px at 85% 20%, rgba(121,40,202,0.02), transparent 60%);" aria-hidden="true"></div>
      <!-- Dark premium depth -->
      <div class="pointer-events-none absolute inset-0 hidden dark:block" style="background: radial-gradient(ellipse 800px 400px at 50% -10%, rgba(59,130,246,0.035), transparent 68%), radial-gradient(ellipse 600px 350px at 85% 15%, rgba(99,102,241,0.03), transparent 62%), linear-gradient(180deg, rgba(255,255,255,0.006) 0%, transparent 40%, rgba(0,0,0,0.08) 100%);" aria-hidden="true"></div>
      <div class="relative mx-auto max-w-[1400px] px-4 sm:px-6 py-[28px] sm:py-[32px] lg:py-[40px]">
        <div class="mx-auto max-w-[640px] text-center">
          <!-- Eyebrow — small, refined -->
          <p class="inline-flex items-center justify-center gap-2 font-mono text-[10px] font-medium tracking-[0.14em] uppercase text-[#71717a] dark:text-[#9ca3af]">
            <span class="hidden h-px w-5 bg-[#e4e4e7] dark:bg-white/[0.07] sm:inline-block" aria-hidden="true"></span>
            Construction & Home Improvement
            <span class="hidden h-px w-5 bg-[#e4e4e7] dark:bg-white/[0.07] sm:inline-block" aria-hidden="true"></span>
          </p>
          <!-- Headline — controlled, professional -->
          <h1 id="hero-heading" class="mx-auto mt-3 max-w-[560px] text-[22px] font-[650] leading-[1.15] tracking-[-0.02em] text-[#0a0a0a] dark:text-[#f2f2f2] [text-wrap:balance] xs:text-[24px] sm:text-[26px] sm:leading-[1.12] lg:text-[30px] lg:tracking-[-0.025em]">
            Construction & Home Improvement Calculators
          </h1>
          <p class="mx-auto mt-3 max-w-[480px] text-[13px] leading-[20px] text-[#52525b] dark:text-[#a1a1aa] [text-wrap:pretty] sm:text-[13.5px] sm:leading-[21px]">
            Calculate materials, quantities, dimensions, costs, and project requirements with clear, practical tools.
          </p>

          <!-- Search — clean, compact -->
          <div class="mx-auto mt-5 max-w-[520px]">
            <label for="hero-search" class="sr-only">Search calculators</label>
            <div class="group relative">
              <span class="pointer-events-none absolute left-[14px] top-1/2 -translate-y-1/2 text-[#a1a1aa] dark:text-[#7a7a80] transition-colors group-focus-within:text-[#52525b] dark:group-focus-within:text-[#e4e4e7]" aria-hidden="true">
                <svg width="16" height="16" viewBox="0 0 16 16" fill="none"><path d="M11.2 11.2L13.8 13.8M12.3 7.3a4.95 4.95 0 1 1-9.9 0 4.95 4.95 0 0 1 9.9 0Z" stroke="currentColor" stroke-width="1.35" stroke-linecap="round"/></svg>
              </span>
              <input
                id="hero-search"
                type="search"
                placeholder="Search for a calculator…"
                autocomplete="off"
                spellcheck="false"
                name="q"
                class="h-[42px] sm:h-[44px] w-full rounded-lg border border-[#e4e4e7] dark:border-white/[0.06] bg-white dark:bg-[#151519] py-0 pl-[42px] sm:pl-[44px] pr-4 text-[14px] font-[450] tracking-[-0.01em] text-[#18181b] dark:text-[#f2f2f2] shadow-[0_1px_2px_rgba(0,0,0,0.04)] dark:shadow-[0_1px_2px_rgba(0,0,0,0.12)] placeholder:text-[#9ca3af] dark:placeholder:text-[#6b7280] placeholder:font-normal focus:border-[#d4d4d8] dark:focus:border-white/[0.10] focus:shadow-[0_0_0_3px_rgba(59,130,246,0.08)] dark:focus:shadow-[0_0_0_3px_rgba(59,130,246,0.10)] focus:outline-none focus-visible:outline-none transition-[border-color,box-shadow] duration-150"
              />
            </div>
            <div id="hero-search-results" class="mt-2 hidden overflow-hidden rounded-lg border border-[#e4e4e7] dark:border-white/[0.06] bg-white dark:bg-[#151519] text-left shadow-[0_4px_12px_rgba(0,0,0,0.06)] dark:shadow-[0_8px_20px_rgba(0,0,0,0.28)]" role="listbox" aria-label="Search results"></div>

            <!-- Suggestions — lightweight -->
            <div class="mt-3 flex flex-wrap items-center justify-center gap-1.5">
              <span class="font-mono text-[10px] tracking-wide text-[#71717a] dark:text-[#8a8a90]">Try —</span>
              <a href="/concrete-slab-calculator/" class="inline-flex items-center rounded-md border border-[#e4e4e7] dark:border-white/[0.06] bg-white dark:bg-[#1a1a1f] px-2.5 py-1 text-[11px] font-[450] tracking-wide text-[#52525b] dark:text-[#a1a1aa] hover:bg-[#fafafa] dark:hover:bg-[#23232a] hover:border-[#d4d4d8] dark:hover:border-white/[0.08] hover:text-[#18181b] dark:hover:text-[#e5e7eb] transition-colors duration-150 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-link">Concrete Slab</a>
              <a href="/roof-pitch-calculator/" class="inline-flex items-center rounded-md border border-[#e4e4e7] dark:border-white/[0.06] bg-white dark:bg-[#1a1a1f] px-2.5 py-1 text-[11px] font-[450] tracking-wide text-[#52525b] dark:text-[#a1a1aa] hover:bg-[#fafafa] dark:hover:bg-[#23232a] hover:border-[#d4d4d8] dark:hover:border-white/[0.08] hover:text-[#18181b] dark:hover:text-[#e5e7eb] transition-colors duration-150 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-link">Roof Pitch</a>
              <a href="/gravel-calculator/" class="inline-flex items-center rounded-md border border-[#e4e4e7] dark:border-white/[0.06] bg-white dark:bg-[#1a1a1f] px-2.5 py-1 text-[11px] font-[450] tracking-wide text-[#52525b] dark:text-[#a1a1aa] hover:bg-[#fafafa] dark:hover:bg-[#23232a] hover:border-[#d4d4d8] dark:hover:border-white/[0.08] hover:text-[#18181b] dark:hover:text-[#e5e7eb] transition-colors duration-150 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-link">Gravel</a>
              <a href="/fence-calculator/" class="inline-flex items-center rounded-md border border-[#e4e4e7] dark:border-white/[0.06] bg-white dark:bg-[#1a1a1f] px-2.5 py-1 text-[11px] font-[450] tracking-wide text-[#52525b] dark:text-[#a1a1aa] hover:bg-[#fafafa] dark:hover:bg-[#23232a] hover:border-[#d4d4d8] dark:hover:border-white/[0.08] hover:text-[#18181b] dark:hover:text-[#e5e7eb] transition-colors duration-150 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-link">Fence</a>
              <a href="/deck-calculator/" class="inline-flex items-center rounded-md border border-[#e4e4e7] dark:border-white/[0.06] bg-white dark:bg-[#1a1a1f] px-2.5 py-1 text-[11px] font-[450] tracking-wide text-[#52525b] dark:text-[#a1a1aa] hover:bg-[#fafafa] dark:hover:bg-[#23232a] hover:border-[#d4d4d8] dark:hover:border-white/[0.08] hover:text-[#18181b] dark:hover:text-[#e5e7eb] transition-colors duration-150 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-link">Deck</a>
            </div>

            <div class="mt-3 flex justify-center">
              <a href="/calculators/" class="group inline-flex items-center gap-1 font-mono text-[11px] font-medium tracking-wide text-[#71717a] dark:text-[#9ca3af] hover:text-[#18181b] dark:hover:text-white transition-colors duration-150 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-link rounded-sm px-1">
                Browse all calculators
                <span class="transition-transform duration-150 group-hover:translate-x-0.5" aria-hidden="true">→</span>
              </a>
            </div>
          </div>

          <p class="mt-4 font-mono text-[10px] tracking-wide text-[#71717a] dark:text-[#7a7a80]">
            Free <span class="text-[#d4d4d8] dark:text-white/15 mx-1" aria-hidden="true">·</span> No sign-up <span class="text-[#d4d4d8] dark:text-white/15 mx-1" aria-hidden="true">·</span> US units <span class="text-[#d4d4d8] dark:text-white/15 mx-1" aria-hidden="true">·</span> Works offline
          </p>
        </div>
</div>
      </section>

    <!-- Popular — compact utility -->
    <section id="popular" class="bg-white dark:bg-[#0f0f0f] py-8 sm:py-10 lg:py-12" aria-labelledby="popular-heading">
      <div class="mx-auto max-w-[1400px] px-4 sm:px-6">
        <div class="flex flex-col gap-2 sm:flex-row sm:items-end sm:justify-between">
          <div>
            <p class="font-mono text-[10px] font-medium tracking-[0.12em] uppercase text-mute">Popular</p>
            <h2 id="popular-heading" class="mt-1.5 text-[18px] font-semibold tracking-[-0.02em] text-ink sm:text-[20px]">Popular calculators</h2>
            <p class="mt-1 max-w-[520px] text-[13px] leading-5 text-body">Most-used tools — a precise selection from the library.</p>
          </div>
          <a href="/calculators/" class="hidden shrink-0 items-center gap-1 font-mono text-[11px] font-medium tracking-wide text-mute transition hover:text-ink focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-link sm:inline-flex">Browse all <span aria-hidden="true">→</span></a>
        </div>
        <ul class="mt-6 grid gap-2 sm:gap-3 sm:grid-cols-2 lg:grid-cols-3" role="list">
          {actualPopular.map((c) => (
            <li class="min-w-0">
              <a href={`/${c.slug}/`} class="group flex h-full flex-col rounded-lg border border-hairline dark:border-white/[0.06] bg-white dark:bg-[#171717] p-4 shadow-sm dark:shadow-none transition-[border-color,box-shadow] duration-150 hover:border-hairline-strong/30 dark:hover:border-white/[0.08] hover:shadow-sm focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-link">
                <div class="flex items-start justify-between gap-3">
                  <span class="inline-flex h-[32px] w-[32px] items-center justify-center rounded-lg border border-hairline bg-[#fcfcfc] text-ink dark:bg-white/[0.06]" aria-hidden="true">
                    <svg width="16" height="16" viewBox="0 0 16 16" fill="none"><path d={c.iconPath} stroke="currentColor" stroke-width="1.25" stroke-linecap="round" stroke-linejoin="round"/></svg>
                  </span>
                  <span class="mt-1 font-mono text-[10px] tracking-wide text-mute">{c.category}</span>
                </div>
                <h3 class="mt-3 line-clamp-1 text-[15.5px] font-semibold tracking-[-0.02em] text-ink">{c.h1}</h3>
                <p class="mt-1 line-clamp-2 flex-1 text-[13.5px] leading-[20px] text-body">{c.description}</p>
                <span class="mt-4 inline-flex items-center gap-1 font-mono text-[11px] font-medium tracking-wide text-mute transition group-hover:text-ink">Calculate <span class="transition-transform group-hover:translate-x-0.5" aria-hidden="true">→</span></span>
              </a>
            </li>
          ))}
        </ul>
        <div class="mt-6 flex justify-center sm:hidden">
          <a href="/calculators/" class="inline-flex items-center gap-1.5 rounded-full border border-hairline bg-white px-4 py-2 font-mono text-[11px] font-medium tracking-wide text-ink shadow-sm">Browse all calculators →</a>
        </div>
      </div>
    </section>

    <!-- Browse by Category — compact -->
    <section class="border-y border-hairline dark:border-white/[0.04] bg-[#fcfcfc] dark:bg-[#0c0c0e] py-8 sm:py-10 lg:py-12" aria-labelledby="cat-heading">
      <div class="mx-auto max-w-[1400px] px-4 sm:px-6">
        <div class="mx-auto max-w-[600px] text-center">
          <p class="font-mono text-[10px] font-medium tracking-[0.12em] uppercase text-mute">Library</p>
          <h2 id="cat-heading" class="mt-1.5 text-[18px] font-semibold tracking-[-0.02em] text-ink sm:text-[20px] [text-wrap:balance]">Browse by category</h2>
          <p class="mx-auto mt-1.5 max-w-[520px] text-[13px] leading-5 text-body">Sixteen focused groups — every category has live calculators, no placeholders.</p>
        </div>
        <div class="mt-6 grid gap-2 sm:gap-3 sm:grid-cols-2 lg:grid-cols-3">
          {hubCategories.map((cat) => (
            <a href={`/construction/${cat.slug}/`} class="group flex flex-col rounded-lg border border-hairline dark:border-white/[0.06] bg-white dark:bg-[#171717] p-4 shadow-sm dark:shadow-none transition-[border-color] duration-150 hover:border-hairline-strong/30 dark:hover:border-white/[0.08] focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-link">
              <div class="flex items-start justify-between gap-3">
                <h3 class="text-[14px] font-semibold tracking-[-0.01em] text-ink group-hover:text-ink">{cat.name}</h3>
                <span class="shrink-0 rounded-full bg-canvas-soft dark:bg-white/[0.04] px-2 py-1 font-mono text-[10px] tracking-wide text-mute dark:text-[#a1a1aa] ring-1 ring-hairline dark:ring-white/[0.06]">{cat.count}</span>
              </div>
              <p class="mt-1.5 line-clamp-2 flex-1 text-[13px] leading-[18px] text-body">{cat.desc}</p>
              <span class="mt-3 inline-flex items-center gap-1 font-mono text-[11px] font-medium tracking-wide text-mute transition group-hover:text-ink">View <span class="transition-transform group-hover:translate-x-0.5" aria-hidden="true">→</span></span>
            </a>
          ))}
        </div>
      </div>
    </section>

    <!-- Project Groups — compact -->
    <section class="bg-white dark:bg-[#0f0f0f] py-8 sm:py-10 lg:py-12" aria-labelledby="groups-heading">
      <div class="mx-auto max-w-[1400px] px-4 sm:px-6">
        <div class="mx-auto max-w-[600px] text-center">
          <p class="font-mono text-[10px] font-medium tracking-[0.12em] uppercase text-mute">Project groups</p>
          <h2 id="groups-heading" class="mt-1.5 text-[18px] font-semibold tracking-[-0.02em] text-ink sm:text-[20px] [text-wrap:balance]">Popular project calculator groups</h2>
          <p class="mx-auto mt-1.5 max-w-[520px] text-[13px] leading-5 text-body">Jump straight to the tools your project needs — grouped by real jobs, not just categories.</p>
        </div>
        <div class="mt-6 grid gap-3 sm:grid-cols-2 lg:grid-cols-4">
          {projectGroups.map((group) => {
            const calcs = getCalcs(group.slugs);
            return (
              <div class="rounded-lg border border-hairline dark:border-white/[0.06] bg-[#fcfcfc] dark:bg-[#171717] p-4">
                <h3 class="text-[13px] font-semibold tracking-[-0.01em] text-ink">{group.name}</h3>
                <p class="mt-1 text-xs leading-4 text-body line-clamp-1">{group.desc}</p>
                <ul class="mt-3 space-y-1.5" role="list">
                  {calcs.slice(0,4).map(c => (
                    <li><a href={`/${c.slug}/`} class="flex items-center gap-1.5 text-[13px] leading-5 text-ink hover:text-link"><span class="h-1 w-1 rounded-full bg-hairline-strong/40"></span>{c.h1}</a></li>
                  ))}
                </ul>
                <a href={`/construction/${group.cluster}/`} class="mt-3 inline-flex items-center gap-1 font-mono text-[11px] font-medium tracking-wide text-mute hover:text-ink">View {group.name} <span aria-hidden="true">→</span></a>
              </div>
            );
          })}
        </div>
      </div>
    </section>

    <!-- Why — compact -->
    <section class="bg-white dark:bg-[#0f0f0f] py-8 sm:py-10 lg:py-12" aria-labelledby="why-heading">
      <div class="mx-auto max-w-[1400px] px-4 sm:px-6">
        <div class="mx-auto max-w-[720px] text-center">
          <p class="font-mono text-[10px] font-medium tracking-[0.12em] uppercase text-mute">Why Calculator Street</p>
          <h2 id="why-heading" class="mt-1.5 text-[18px] font-semibold tracking-[-0.02em] text-ink sm:text-[20px]">Built for real projects</h2>
          <p class="mx-auto mt-2 max-w-[560px] text-[13px] leading-5 text-body">Concrete, gravel, rebar, brick, roofing, flooring, drywall, deck, fence and more — each calculator has original formulas, worked examples and clear FAQs. No dark patterns.</p>
        </div>
        <div class="mx-auto mt-6 grid max-w-[800px] gap-2 sm:gap-3 sm:grid-cols-4">
          <div class="rounded-xl border border-hairline dark:border-white/[0.06] bg-[#fcfcfc] dark:bg-[#171717] px-4 py-5 text-center"><p class="font-mono text-[11px] tracking-wide text-mute">Access</p><p class="mt-1 text-[13.5px] font-semibold tracking-[-0.01em] text-ink">Free to use</p><p class="mt-1 text-xs leading-4 text-body">No paywall. Static & fast.</p></div>
          <div class="rounded-xl border border-hairline dark:border-white/[0.06] bg-[#fcfcfc] dark:bg-[#171717] px-4 py-5 text-center"><p class="font-mono text-[11px] tracking-wide text-mute">Clarity</p><p class="mt-1 text-[13.5px] font-semibold tracking-[-0.01em] text-ink">Clear results</p><p class="mt-1 text-xs leading-4 text-body">Units clear, no fake precision.</p></div>
          <div class="rounded-xl border border-hairline dark:border-white/[0.06] bg-[#fcfcfc] dark:bg-[#171717] px-4 py-5 text-center"><p class="font-mono text-[11px] tracking-wide text-mute">Coverage</p><p class="mt-1 text-[13.5px] font-semibold tracking-[-0.01em] text-ink">Broad library</p><p class="mt-1 text-xs leading-4 text-body">Construction, every trade.</p></div>
          <div class="rounded-xl border border-hairline dark:border-white/[0.06] bg-[#fcfcfc] dark:bg-[#171717] px-4 py-5 text-center"><p class="font-mono text-[11px] tracking-wide text-mute">Privacy</p><p class="mt-1 text-[13.5px] font-semibold tracking-[-0.01em] text-ink">Private</p><p class="mt-1 text-xs leading-4 text-body">Runs locally, no tracking.</p></div>
        </div>
        <div class="mx-auto mt-8 max-w-[720px] rounded-xl border border-hairline dark:border-white/[0.06] bg-[#fcfcfc] dark:bg-[#171717] p-6 sm:p-7">
          <div class="flex flex-col gap-6 sm:flex-row sm:items-start sm:justify-between">
            <div class="flex-1">
              <h3 class="text-[15px] font-semibold tracking-[-0.02em] text-ink">How it works</h3>
              <ol class="mt-4 space-y-3" role="list">
                <li class="flex gap-3 text-[13.5px] leading-5 text-body"><span class="flex h-6 w-6 shrink-0 items-center justify-center rounded-full bg-white dark:bg-[#1e1e22] text-[11px] font-semibold text-ink ring-1 ring-hairline dark:ring-white/[0.08]" aria-hidden="true">1</span><span><span class="font-medium text-ink">Choose a calculator</span> — via search or category.</span></li>
                <li class="flex gap-3 text-[13.5px] leading-5 text-body"><span class="flex h-6 w-6 shrink-0 items-center justify-center rounded-full bg-white dark:bg-[#1e1e22] text-[11px] font-semibold text-ink ring-1 ring-hairline dark:ring-white/[0.08]" aria-hidden="true">2</span><span><span class="font-medium text-ink">Enter your measurements</span> — dimensions, quantities.</span></li>
                <li class="flex gap-3 text-[13.5px] leading-5 text-body"><span class="flex h-6 w-6 shrink-0 items-center justify-center rounded-full bg-white dark:bg-[#1e1e22] text-[11px] font-semibold text-ink ring-1 ring-hairline dark:ring-white/[0.08]" aria-hidden="true">3</span><span><span class="font-medium text-ink">Get your result</span> — instantly with units.</span></li>
              </ol>
            </div>
            <a href="/calculators/" class="inline-flex h-9 shrink-0 items-center justify-center rounded-full bg-ink px-5 font-mono text-[11px] font-medium tracking-wide text-white transition hover:bg-ink/90 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-link dark:bg-white dark:text-black">Explore all calculators</a>
          </div>
        </div>
      </div>
    </section>

    <!-- Final CTA — compact -->
    <section class="border-y border-hairline dark:border-white/[0.04] bg-[#fcfcfc] dark:bg-[#0c0c0e] py-8 sm:py-10" aria-labelledby="cta-heading">
      <div class="mx-auto max-w-[1400px] px-4 sm:px-6 text-center">
        <h2 id="cta-heading" class="text-[18px] font-semibold tracking-[-0.02em] text-ink sm:text-[20px]">Find the right calculator for your project</h2>
        <p class="mx-auto mt-1.5 max-w-[520px] text-[13px] leading-5 text-body">Search the full library — concrete, roofing, flooring, framing and more.</p>
        <a href="/calculators/" class="group mt-4 inline-flex items-center gap-1.5 font-mono text-[11px] font-medium tracking-wide text-ink transition hover:text-mute focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-link">Browse all calculators <span class="transition-transform group-hover:translate-x-0.5" aria-hidden="true">→</span></a>
      </div>
    </section>
  </main>
  <Footer />

  <script is:inline define:vars={{ hubCalculators }}>
    const input = document.getElementById("hero-search");
    const box = document.getElementById("hero-search-results");
    const idx = hubCalculators.map(c => ({
      slug: c.slug,
      h1: c.h1,
      title: c.title,
      desc: c.description,
      cat: c.category,
      cluster: c.cluster,
      keywords: (c.keywords || []).join(" "),
      url: `/${c.slug}/`,
      hay: `${c.h1} ${c.title} ${c.description} ${c.category} ${c.cluster} ${c.slug} ${(c.keywords||[]).join(" ")}`.toLowerCase()
    }));
    function escapeHtml(str){
      return String(str).replace(/&/g,"&amp;").replace(/</g,"&lt;").replace(/>/g,"&gt;").replace(/"/g,"&quot;").replace(/'/g,"&#39;");
    }
    function score(query, hay){
      const terms = query.toLowerCase().trim().split(/\s+/).filter(Boolean);
      // intent: all terms must be present somewhere in hay (AND), with bonus for h1/slug
      let ok = terms.every(t => hay.includes(t));
      if(!ok) return -1;
      let s=0;
      for(const t of terms){
        if(hay.includes(" "+t+" ")) s+=2;
        else s+=1;
      }
      // boost exact h1 match
      if(hay.includes(query.toLowerCase())) s+=3;
      return s;
    }
    function render(q) {
      if (!q || !box) return;
      const hits = idx.map(x => ({...x, _s: score(q, x.hay)})).filter(x=>x._s>=0).sort((a,b)=>b._s-a._s).slice(0,6);
      if (!hits.length) { box.classList.add("hidden"); box.innerHTML=""; return; }
      box.innerHTML = hits.map(h => `<a href="${h.url}" class="group flex items-center gap-3 px-4 py-3.5 border-b last:border-0 border-hairline transition hover:bg-[#fcfcfc] dark:hover:bg-white/[0.04]" role="option"><span class="hidden h-8 w-8 shrink-0 items-center justify-center rounded-lg border border-hairline bg-[#fcfcfc] text-mute group-hover:text-ink sm:inline-flex" aria-hidden="true"><svg width="14" height="14" viewBox="0 0 16 16" fill="none"><path d="M11.2 11.2L13.8 13.8M12.3 7.3a4.95 4.95 0 1 1-9.9 0 4.95 4.95 0 0 1 9.9 0Z" stroke="currentColor" stroke-width="1.25" stroke-linecap="round"/></svg></span><div class="min-w-0 flex-1"><p class="truncate text-[13.5px] font-medium tracking-[-0.01em] text-ink">${escapeHtml(h.h1)}</p><p class="mt-0.5 flex items-center gap-1.5 truncate font-mono text-[11px]"><span class="rounded bg-canvas-soft px-1.5 py-0.5 ring-1 ring-hairline text-mute">${escapeHtml(h.cat)}</span><span class="truncate text-body hidden sm:inline">${escapeHtml(h.desc.slice(0,62))}</span></p></div><span class="shrink-0 font-mono text-[11px] text-mute transition group-hover:text-ink">→</span></a>`).join("") + `<a href="/calculators/?q=${encodeURIComponent(q)}" class="flex items-center justify-center gap-1.5 bg-[#fcfcfc] px-4 py-2.5 font-mono text-[11px] tracking-wide text-mute hover:text-ink dark:bg-[#171717]">View all results for “${escapeHtml(q.slice(0,24))}” <span aria-hidden="true">→</span></a>`;
      box.classList.remove("hidden");
    }
    if (input) {
      const wrap = input.closest(".group");
      input.addEventListener("focus", () => { if (wrap) wrap.classList.add("is-focused"); if (input.value.trim()) render(input.value.trim()); });
      input.addEventListener("blur", () => { if (wrap) wrap.classList.remove("is-focused"); });
      input.addEventListener("input", () => render(input.value.trim()));
      input.addEventListener("keydown", (e) => { if(e.key==="Escape"){ box?.classList.add("hidden"); input.blur(); }});
      document.addEventListener("click", (e) => { const t = e.target; if (!t.closest || (!t.closest("#hero-search") && !t.closest("#hero-search-results"))) box?.classList.add("hidden"); });
    }
  </script>
</Layout>
