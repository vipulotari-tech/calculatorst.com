---
import Layout from "../../layouts/Layout.astro";
import Header from "../../components/Header.astro";
import Footer from "../../components/Footer.astro";
import Breadcrumbs from "../../components/Breadcrumbs.astro";
---

<Layout title="Contact Calculator Street — Corrections & Partnerships" description="Contact Calculator Street: hello@calculatorst.com — corrections, suggestions, partnerships. We respond in 1–3 business days.">
  <Header />
  <main id="main" tabindex="-1" class="mx-auto max-w-[1400px] px-6 py-6 max-md:px-4">
    <Breadcrumbs items={[{ label: "Home", href: "/" }, { label: "Contact" }]} />
    <div class="mx-auto max-w-[720px] pt-6">
      <h1 class="text-display-lg font-semibold tracking-[-0.04em] text-ink">Contact</h1>
      <p class="mt-3 text-sm leading-6 text-body">Have a correction, feature request, or want your resource cited? We read every message — we built every calculator by hand and fix verified errors quickly.</p>
      <div class="mt-6 space-y-6 rounded-lg border border-hairline bg-canvas p-6 dark:bg-canvas">
        <div>
          <h2 class="font-mono text-[11px] font-medium tracking-[0.12em] uppercase text-mute">Primary email (recommended)</h2>
          <a href="mailto:hello@calculatorst.com" class="mt-1 inline-flex font-mono text-sm font-medium text-ink hover:text-link transition">hello@calculatorst.com</a>
          <p class="mt-1 text-xs leading-5 text-mute">Preferred for AdSense, partnerships, and privacy requests. Monitored daily.</p>
        </div>
        <div class="rounded-md bg-muted/50 px-4 py-3">
          <h3 class="font-mono text-[11px] font-medium tracking-[0.12em] uppercase text-mute">Alternative</h3>
          <a href="mailto:vipulotari1718@gmail.com" class="font-mono text-sm text-body hover:text-ink transition">vipulotari1718@gmail.com</a>
          <p class="mt-1 text-xs text-mute">Backup if hello@ is unreachable.</p>
        </div>
        <div>
          <h2 class="font-mono text-[11px] font-medium tracking-[0.12em] uppercase text-mute">What to include</h2>
          <ul class="mt-2 list-disc pl-5 text-sm leading-6 text-body space-y-1">
            <li>Calculator URL and what you tried (dimensions, material, waste %)</li>
            <li>Expected vs actual result and your source (e.g., supplier sheet, TxDOT spec)</li>
            <li>For partnerships: site URL, audience, and how you’d like to collaborate</li>
          </ul>
        </div>
        <div class="border-t border-hairline pt-4">
          <h2 class="font-mono text-[11px] font-medium tracking-[0.12em] uppercase text-mute">Response time & address</h2>
          <p class="mt-1 text-sm leading-6 text-body">We respond within 1–3 business days. No login or account needed. We are a small team behind Calculator Street (CalculatorSt.com) — operated by Vipul Otari. For formal mail, use email; we do not publish a physical storefront as we operate online only. For legal notices, email with subject "Legal Notice".</p>
          <p class="mt-3 font-mono text-xs text-mute">Organization: Calculator Street — Site: https://calculatorst.com — Also see <a href="/about/" class="text-link underline">About</a> and <a href="/privacy/" class="text-link underline">Privacy</a>.</p>
        </div>
        <div class="rounded-md border border-hairline bg-canvas-soft p-4">
          <h3 class="text-sm font-semibold text-ink">Quick form (email us)</h3>
          <p class="mt-1 text-sm leading-6 text-body">Your email client will open with a template — just fill and send. No data leaves your device until you send.</p>
          <a href="mailto:hello@calculatorst.com?subject=Calculator%20Street%20—%20Correction%20or%20Feedback&body=Calculator%20URL:%20%0AInputs:%20%0AExpected:%20%0ASource:%20%0AMessage:%20" class="mt-3 inline-flex h-9 items-center justify-center rounded-lg bg-foreground px-5 text-[13px] font-medium text-background transition-opacity hover:opacity-90">Email template</a>
        </div>
      </div>
    </div>
  </main>
  <Footer />
</Layout>
