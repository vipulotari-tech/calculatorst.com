---
import Layout from "../../layouts/Layout.astro";
import Header from "../../components/Header.astro";
import Footer from "../../components/Footer.astro";
import Breadcrumbs from "../../components/Breadcrumbs.astro";
---

<Layout title="Contact — Calculator Street" description="Contact Calculator Street for corrections, suggestions or partnerships.">
  <Header />
  <main id="main" tabindex="-1" class="mx-auto max-w-[1400px] px-6 py-6 max-md:px-4">
    <Breadcrumbs items={[{ label: "Home", href: "/" }, { label: "Contact" }]} />
    <div class="mx-auto max-w-[720px] pt-6">
      <h1 class="text-display-lg font-semibold tracking-[-0.04em] text-ink">Contact</h1>
      <p class="mt-3 text-sm leading-6 text-body">Have a correction, feature request, or want your resource cited? Reach us at:</p>
      <div class="mt-6 rounded-lg border border-hairline bg-canvas p-6 dark:bg-canvas">
        <p class="font-mono text-xs tracking-wide text-mute uppercase">General</p>
        <a href="mailto:hello@calculatorst.com" class="font-mono text-sm text-ink hover:text-link transition">hello@calculatorst.com</a>
        <div class="mt-4 h-px bg-hairline"></div>
        <p class="mt-4 font-mono text-xs tracking-wide text-mute uppercase">Personal</p>
        <a href="mailto:vipulotari1718@gmail.com" class="font-mono text-sm font-medium text-ink hover:text-link transition">vipulotari1718@gmail.com</a>
        <p class="mt-4 text-sm leading-6 text-body">We read every message. For calculation help, include your dimensions, material and what you tried.</p>
        <p class="mt-4 font-mono text-xs text-mute">No login. No account. Response within 1–3 business days.</p>
      </div>
    </div>
  </main>
  <Footer />
</Layout>
